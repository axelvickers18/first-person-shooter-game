      seg(0, 0.075, -0.52, 0.05, 0.135, 0.94, blade, -0.1);              // long, blade-heavy blade
      seg(0.027, 0.075, -0.52, 0.009, 0.135, 0.94, steel, -0.1);         // honed bottom edge (catches light)
      seg(-0.01, 0.075, -0.5, 0.02, 0.05, 0.66, grip, -0.1);             // fuller / blood groove down the center
      seg(0, 0.17, -1.0, 0.036, 0.08, 0.22, steel, -0.55);               // pronounced clip-point tip (spine drops to the point)
      for (let i = 0; i < 9; i++) seg(0, 0.04 + i * 0.013, -0.12 - i * 0.052, 0.056, 0.04, 0.034, steel, -0.1);   // 9 prominent saw teeth on the spine
