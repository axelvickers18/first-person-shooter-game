  for (let i = 0; i < polePos.length - 1; i++) { const z0 = polePos[i], z1 = polePos[i + 1], len = z1 - z0; [-0.95, 0.95].forEach(off => { const c = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, len, 5), flatMat(0x111111)); c.rotation.x = Math.PI / 2; c.position.set(ppx + off, 7.6, (z0 + z1) / 2); scene.add(c); }); }

