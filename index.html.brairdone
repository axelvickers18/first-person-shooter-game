  gg10: { sy:0.12, rearZ:0.02,  frontZ:-0.42, ads:{ x:0, y:-0.12, z:-0.40 }, ladder:true },    // Crossbow (arc post)
  gg11: { sy:0.17, rearZ:0.08,  frontZ:-0.40, ads:{ x:0, y:-0.17, z:-0.40 }, ladder:true },    // Grenade launcher (arc)
  gg13: { sy:0.13, rearZ:0.08,  frontZ:-0.30, ads:{ x:0, y:-0.13, z:-0.40 } },                 // Machine pistol
  gg14: { sy:0.13, rearZ:0.12,  frontZ:-0.26, ads:{ x:0, y:-0.13, z:-0.44 } },                 // 9mm pistol
  gg15: { sy:0.14, rearZ:0.10,  frontZ:-0.28, ads:{ x:0, y:-0.14, z:-0.42 } },                 // Revolver
  gg16: { sy:0.15, rearZ:0.10,  frontZ:-0.32, ads:{ x:0, y:-0.15, z:-0.42 } },                 // Desert Eagle
  gg22: { sy:0.13, rearZ:0.08,  frontZ:-0.24, ads:{ x:0, y:-0.13, z:-0.42 } },                 // PDW / Micro SMG (iron)
  gg28: { sy:0.15, rearZ:0.06,  frontZ:-0.58, ads:{ x:0, y:-0.15, z:-0.40 } }                  // AK-47 (iron front post + rear notch)
};

