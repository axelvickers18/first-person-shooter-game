/* ============================================================================
   DAY / NIGHT CYCLE — one `timeOfDay` float (0 = midnight, 0.5 = noon, wraps at 1)
   drives sky/fog/sun/ambient tints + stars/moon + artificial night lights. The host
   advances it (full 0..1 cycle = 8-12 min, so a day->night transition is 4-6 min) and
   broadcasts it ~every 2s; clients lerp toward the last value. Cheap colour tints only
   (no extra shaders / per-pixel lights), per the existing flat-shaded lighting approach.
   ============================================================================ */
let timeOfDay = Math.random();                 // randomized start (noon / dusk / midnight / ...)
let dnFullCycle = 480 + Math.random() * 240;   // 8-12 min for a full cycle (half = day->night = 4-6 min)
let dnFrozen = false;                           // Part 6: day/night locked (off / force-day / force-night)
let dnTarget = timeOfDay, dnHasTarget = false; // clients lerp timeOfDay toward dnTarget
let dnLampF = 0, dnStarF = 0;                  // current lamp-on + star-visibility factors
// Keyframe stops: sky / fog / fogNear / fogFar / sunColor / sunInt / hemiSky / hemiGround / hemiInt / lamp / star
const DN_STOPS = [
  { t:0.00, sky:0x05080f, fog:0x05080f, fn:55, ff:200, sc:0x8a99cc, si:0.22, hs:0x223052, hg:0x0b0f17, hi:0.30, lamp:1.0, star:1.0 },  // midnight
  { t:0.22, sky:0x18223e, fog:0x1a2236, fn:60, ff:215, sc:0x9a88b4, si:0.30, hs:0x35406a, hg:0x12161d, hi:0.40, lamp:1.0, star:0.85 }, // pre-dawn
  { t:0.28, sky:0xffa362, fog:0xe09a66, fn:80, ff:250, sc:0xff8c46, si:0.72, hs:0xffc99a, hg:0x6a5446, hi:0.64, lamp:0.4, star:0.15 }, // sunrise
  { t:0.50, sky:0xbcd6e4, fog:0xcfd9cf, fn:95, ff:280, sc:0xfff1d4, si:1.00, hs:0xffffff, hg:0x6688aa, hi:0.85, lamp:0.0, star:0.0 },  // noon
  { t:0.72, sky:0xff8c42, fog:0xd98a5a, fn:82, ff:255, sc:0xff7a3a, si:0.66, hs:0xffc090, hg:0x6a5240, hi:0.60, lamp:0.4, star:0.15 }, // sunset
  { t:0.80, sky:0x2a2742, fog:0x241f33, fn:62, ff:222, sc:0x9a7a98, si:0.34, hs:0x3a3a60, hg:0x12131c, hi:0.42, lamp:1.0, star:0.8 },  // dusk
  { t:1.00, sky:0x05080f, fog:0x05080f, fn:55, ff:200, sc:0x8a99cc, si:0.22, hs:0x223052, hg:0x0b0f17, hi:0.30, lamp:1.0, star:1.0 }   // midnight (wrap)
];
const _dnA = new THREE.Color(), _dnB = new THREE.Color(), _dnLampDay = new THREE.Color(0x5a5648), _dnLampNight = new THREE.Color(0xffe6a8), _dnCamPos = new THREE.Vector3();
function _dnLerpCol(target, hexA, hexB, f) { _dnA.setHex(hexA); _dnB.setHex(hexB); target.copy(_dnA).lerp(_dnB, f); }

// Night sky: a star field + a moon (+ halo), parented to a group kept centred on the camera (= at infinity).
const skyGroup = new THREE.Group(); scene.add(skyGroup);
(function buildNightSky() {
  const N = 380, pos = new Float32Array(N * 3);
  for (let i = 0; i < N; i++) { const az = Math.random() * Math.PI * 2, el = 0.12 + Math.random() * 1.32, r = 360;
    pos[i*3] = Math.cos(el) * Math.cos(az) * r; pos[i*3+1] = Math.sin(el) * r; pos[i*3+2] = Math.cos(el) * Math.sin(az) * r; }
  const g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const stars = new THREE.Points(g, new THREE.PointsMaterial({ color: 0xffffff, size: 2.4, sizeAttenuation: false, transparent: true, opacity: 0, depthWrite: false, fog: false }));
  stars.frustumCulled = false; skyGroup.add(stars); skyGroup.userData.stars = stars;
  const moon = new THREE.Mesh(new THREE.SphereGeometry(15, 18, 14), new THREE.MeshBasicMaterial({ color: 0xeaf0ff, transparent: true, opacity: 0, depthWrite: false, fog: false }));
  moon.position.set(150, 230, -260); skyGroup.add(moon); skyGroup.userData.moon = moon;
  const halo = new THREE.Mesh(new THREE.SphereGeometry(23, 18, 14), new THREE.MeshBasicMaterial({ color: 0x9fb4ff, transparent: true, opacity: 0, depthWrite: false, fog: false }));
  halo.position.copy(moon.position); skyGroup.add(halo); skyGroup.userData.moonHalo = halo;
})();

// Artificial night lights: warm window/lamp/drum glows that fade in after dusk (opacity 0 in daylight).
const nightGlows = [];   // { mesh, max }
function addNightGlow(x, y, z, w, h, d, color, max) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0, depthWrite: false, fog: false }));
  m.position.set(x, y, z); scene.add(m); nightGlows.push({ mesh: m, max: max == null ? 0.85 : max }); return m;
}
streetLamps.forEach(l => addNightGlow(l.position.x, l.position.y, l.position.z, 0.72, 0.62, 0.72, 0xffd98a, 0.85));   // lamp halos
mapFlames.forEach(fl => addNightGlow(fl.pos.x, fl.pos.y + 0.4, fl.pos.z, 1.5, 1.6, 1.5, 0xff7a1a, 0.6));             // oil-drum fire glow
// Mansion interior warm glows (chandeliers / sconces / fireplaces) collected during the build, plus the
// house windows. The mansion is built before addNightGlow() exists, so it stashes glow specs on castle.glows.
if (castle.glows) castle.glows.forEach(g => addNightGlow(g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7]));
[SP(58), SP(-58)].forEach(cz => { const s = cz > 0 ? 1 : -1; [[-4.2, 2.7], [4.2, 2.7], [0, 7.2]].forEach(([x, y]) => addNightGlow(SP(x), y, cz - s * 4.9, 2.6, 1.8, 0.3, 0xffcf72, 0.75)); });
// Watchtower antenna: a slow-blinking RED beacon at the very top (helps locate the tower in the dark).
const towerBeacon = new THREE.Mesh(new THREE.SphereGeometry(0.32, 10, 8), new THREE.MeshBasicMaterial({ color: 0xff2020, transparent: true, opacity: 0, depthWrite: false }));
towerBeacon.position.set(watchtower.cx, watchtower.platY + 8.2, watchtower.cz); scene.add(towerBeacon);

// LIGHT TOWERS — tall floodlight poles that auto-switch on at night (driven by the day/night lamp factor).
const lightTowers = [];
function buildLightTower(x, z) {
  const poleH = 7.0;   // ~4 player heights
  addBox(x, 0, z, 0.32, poleH, 0.32, 0x6a6a72, { mat: 'metal' });                       // gray metal pole (thin vertical cover)
  [[0.55, 0], [-0.55, 0], [0, 0.55]].forEach(([dx, dz]) => addBox(x + dx, 0, z + dz, 0.12, 1.3, 0.12, 0x55555c, { noCollide: true, mat: 'metal' }));   // base struts
  const fix = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.7, 0.55), new THREE.MeshLambertMaterial({ color: 0x3a3a40, flatShading: true }));
  fix.position.set(x, poleH - 0.25, z); fix.rotation.x = 0.5; scene.add(fix);            // chunky angular floodlight housing
  const glass = new THREE.Mesh(new THREE.BoxGeometry(1.3, 0.52, 0.08), new THREE.MeshBasicMaterial({ color: 0xfff2c0, transparent: true, opacity: 0.18 }));
  glass.position.set(x, poleH - 0.5, z + 0.3); glass.rotation.x = 0.5; scene.add(glass); // emissive glass face (the lamp)
  const shaft = new THREE.Mesh(new THREE.ConeGeometry(11, poleH, 22, 1, true), new THREE.MeshBasicMaterial({ color: 0xffeec0, transparent: true, opacity: 0, side: THREE.DoubleSide, depthWrite: false, blending: THREE.AdditiveBlending, fog: false }));
  shaft.position.set(x, poleH / 2, z); scene.add(shaft);                                 // volumetric shaft (apex at fixture, base on ground)
  const disc = new THREE.Mesh(new THREE.CircleGeometry(11, 26), new THREE.MeshBasicMaterial({ color: 0xfff0c0, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending, fog: false }));
  disc.rotation.x = -Math.PI / 2; disc.position.set(x, 0.06, z); scene.add(disc);        // lit ground pool (~12u radius)
  const spot = new THREE.SpotLight(0xfff2d0, 0, 26, 0.62, 0.45, 1.2); spot.position.set(x, poleH - 0.4, z); spot.target.position.set(x, 0, z); spot.castShadow = false;
  scene.add(spot); scene.add(spot.target);                                               // real downward cone — actually lights players standing in it
  lightTowers.push({ glass, shaft, disc, spot });
}
// ([43,0] → ~(58,0): the estate's approach floodlight, sited at the courtyard mouth in front of the gate)
[[13, 48], [13, -48], [10, 8], [43, 0], [-58, 14]].forEach(([x, z]) => buildLightTower(SP(x), SP(z)));   // 2 house yards + central street + estate approach + watchtower

// THE NOODLE BOX — a giant Chinese-takeout box on the left flank you can WALK INSIDE to summon Mckayla.
let noodleBox = null;
// A generic Panda-Express-style panda face + "PANDA" wordmark drawn to a canvas texture (not the real logo).
function pandaLogoTexture() {
  const c = document.createElement('canvas'); c.width = 256; c.height = 256; const x = c.getContext('2d');
  x.fillStyle = '#1a1a1a';
  x.beginPath(); x.arc(86, 86, 28, 0, 7); x.arc(170, 86, 28, 0, 7); x.fill();                 // ears
  x.beginPath(); x.ellipse(99, 122, 21, 29, -0.3, 0, 7); x.ellipse(157, 122, 21, 29, 0.3, 0, 7); x.fill();   // eye patches
  x.fillStyle = '#2fff6a'; x.beginPath(); x.arc(101, 120, 8, 0, 7); x.arc(155, 120, 8, 0, 7); x.fill();       // green eyes
  x.fillStyle = '#1a1a1a'; x.beginPath(); x.ellipse(128, 150, 10, 7, 0, 0, 7); x.fill();        // nose
  x.lineWidth = 4; x.strokeStyle = '#1a1a1a'; x.beginPath(); x.moveTo(128, 157); x.lineTo(128, 168); x.lineTo(113, 178); x.moveTo(128, 168); x.lineTo(143, 178); x.stroke();   // mouth
  x.fillStyle = '#d11a1a'; x.font = 'bold 52px Arial, sans-serif'; x.textAlign = 'center'; x.fillText('PANDA', 128, 232);
  return new THREE.CanvasTexture(c);
}
// Philippine flag sticker: white hoist triangle (8-ray sun + 3 corner stars), blue over red field; faintly worn.
function philippineFlagTexture() {
  const c = document.createElement('canvas'); c.width = 256; c.height = 128; const x = c.getContext('2d');
  x.fillStyle = '#0038a8'; x.fillRect(0, 0, 256, 64);                          // blue top stripe
  x.fillStyle = '#ce1126'; x.fillRect(0, 64, 256, 64);                          // red bottom stripe
  x.fillStyle = '#ffffff'; x.beginPath(); x.moveTo(0, 0); x.lineTo(0, 128); x.lineTo(110, 64); x.closePath(); x.fill();   // white hoist triangle
  const sx = 37, sy = 64; x.fillStyle = '#fcd116';
  for (let i = 0; i < 8; i++) { const a = i / 8 * Math.PI * 2; x.save(); x.translate(sx, sy); x.rotate(a); x.beginPath(); x.moveTo(0, -4); x.lineTo(23, 0); x.lineTo(0, 4); x.closePath(); x.fill(); x.restore(); }   // 8 sun rays
  x.beginPath(); x.arc(sx, sy, 9, 0, 7); x.fill();                              // sun disc
  const star = (px, py, r) => { x.beginPath(); for (let i = 0; i < 5; i++) { const a = -Math.PI / 2 + i * 2 * Math.PI / 5; x.lineTo(px + Math.cos(a) * r, py + Math.sin(a) * r); const b = a + Math.PI / 5; x.lineTo(px + Math.cos(b) * r * 0.45, py + Math.sin(b) * r * 0.45); } x.closePath(); x.fill(); };
  star(13, 13, 7); star(13, 115, 7); star(101, 64, 7);                          // 3 corner stars
  x.fillStyle = 'rgba(110,110,110,0.12)'; for (let i = 0; i < 6; i++) x.fillRect(Math.random() * 256, Math.random() * 128, 28, 2);   // faint wrinkles / wear
  return new THREE.CanvasTexture(c);
}
(function buildNoodleBox() {
  const cx = SP(-40), cz = SP(30), W = 4.2, D = 4.2, H = 5.2, t = 0.18, hx = W / 2, hz = D / 2, doorW = 2.0;   // ~30% bigger, ~2.6 player-heights tall
  const paper = 0xf6f4ef, red = 0xd11a1a;                       // Panda Express white + red
  addBox(cx, 0, cz, W, 0.08, D, paper, { noCollide: true });    // interior floor (cosmetic)
  addBox(cx - hx, 0, cz, t, H, D, paper);                       // back wall (-X)
  addBox(cx, 0, cz - hz, W, H, t, paper);                       // side wall (-Z)
  addBox(cx, 0, cz + hz, W, H, t, paper);                       // side wall (+Z)
  const segD = (D - doorW) / 2;                                 // front wall (+X) split around a wider doorway gap
  addBox(cx + hx, 0, cz - hz + segD / 2, t, H, segD, paper);
  addBox(cx + hx, 0, cz + hz - segD / 2, t, H, segD, paper);
  addBox(cx + hx, H - 1.0, cz, t, 1.0, doorW, paper, { noCollide: true });   // lintel above the doorway
  // red rim band around the top edge (Panda Express red accent)
  [cz - hz, cz + hz].forEach(pz => addBox(cx, H - 0.2, pz, W + 0.06, 0.2, t + 0.05, red, { noCollide: true }));
  [cx - hx, cx + hx].forEach(px => addBox(px, H - 0.2, cz, t + 0.05, 0.2, D + 0.06, red, { noCollide: true }));
  for (let s = 0; s < 4; s++) {                                 // folded paper flaps with a red leading edge
    const ang = s * Math.PI / 2;
    const flap = new THREE.Mesh(new THREE.BoxGeometry(W * 0.92, 0.07, D * 0.46), new THREE.MeshLambertMaterial({ color: paper, flatShading: true }));
    flap.position.set(cx - Math.sin(ang) * D * 0.27, H + 0.2, cz + Math.cos(ang) * D * 0.27); flap.rotation.y = ang; flap.rotation.x = -0.6; scene.add(flap);
    const trim = new THREE.Mesh(new THREE.BoxGeometry(W * 0.92, 0.05, 0.09), new THREE.MeshBasicMaterial({ color: red }));
    trim.position.copy(flap.position); trim.rotation.copy(flap.rotation); trim.translateZ(D * 0.22); scene.add(trim);
  }
  addBox(cx - 0.72, H + 0.12, cz, 0.06, 0.8, 0.06, 0x9a9a9a, { noCollide: true });   // wire handle (two posts + a top bar)
  addBox(cx + 0.72, H + 0.12, cz, 0.06, 0.8, 0.06, 0x9a9a9a, { noCollide: true });
  addBox(cx, H + 0.82, cz, 1.55, 0.06, 0.06, 0x9a9a9a, { noCollide: true });
  const logoTex = pandaLogoTexture();                           // panda + PANDA wordmark on both wide faces
  [[cz - hz - 0.14, Math.PI], [cz + hz + 0.14, 0]].forEach(([pz, ry]) => {   // sit proud of the 0.18-thick wall (was buried inside it)
    const m = new THREE.Mesh(new THREE.PlaneGeometry(3.2, 3.2), new THREE.MeshBasicMaterial({ map: logoTex, transparent: true, depthWrite: false })); m.position.set(cx, H * 0.52, pz); m.rotation.y = ry; scene.add(m);
  });
  const banner = new THREE.Mesh(new THREE.PlaneGeometry(1.9, 1.0), new THREE.MeshBasicMaterial({ map: logoTex, transparent: true, depthWrite: false })); banner.position.set(cx + hx + 0.14, H - 0.5, cz); banner.rotation.y = Math.PI / 2; scene.add(banner);   // small banner over the doorway
  const flag = new THREE.Mesh(new THREE.PlaneGeometry(2.3, 1.15), new THREE.MeshBasicMaterial({ map: philippineFlagTexture(), transparent: true, opacity: 0.95, depthWrite: false }));
  flag.position.set(cx - hx - 0.14, H * 0.62, cz); flag.rotation.y = -Math.PI / 2; scene.add(flag);   // Philippine flag sticker proud of the back face (opposite the Panda branding)
  noodleBox = { cx, cz, minX: cx - hx, maxX: cx + hx, minZ: cz - hz, maxZ: cz + hz, H };
})();
function inNoodleBox() {
  if (!noodleBox || !player.alive) return false;
  const b = noodleBox, m = 0.35;
  return player.pos.x > b.minX + m && player.pos.x < b.maxX - m && player.pos.z > b.minZ + m && player.pos.z < b.maxZ - m && player.pos.y < b.H - 0.5;
}

// Apply the current time-of-day to the scene (interpolate the two surrounding stops).
function applyDayNight() {
  const t = ((timeOfDay % 1) + 1) % 1;
  let a = DN_STOPS[0], b = DN_STOPS[DN_STOPS.length - 1];
  for (let i = 0; i < DN_STOPS.length - 1; i++) { if (t >= DN_STOPS[i].t && t <= DN_STOPS[i + 1].t) { a = DN_STOPS[i]; b = DN_STOPS[i + 1]; break; } }
  const f = (b.t > a.t) ? (t - a.t) / (b.t - a.t) : 0, L = (p, q) => p + (q - p) * f;
  _dnLerpCol(scene.background, a.sky, b.sky, f);
  _dnLerpCol(scene.fog.color, a.fog, b.fog, f); scene.fog.near = L(a.fn, b.fn); scene.fog.far = L(a.ff, b.ff);
  _dnLerpCol(sun.color, a.sc, b.sc, f); sun.intensity = L(a.si, b.si);
  _dnLerpCol(hemi.color, a.hs, b.hs, f); _dnLerpCol(hemi.groundColor, a.hg, b.hg, f); hemi.intensity = L(a.hi, b.hi);
  dnLampF = L(a.lamp, b.lamp); dnStarF = L(a.star, b.star);
  skyGroup.userData.stars.material.opacity = dnStarF;
  skyGroup.userData.moon.material.opacity = 0.95 * dnStarF;
  skyGroup.userData.moonHalo.material.opacity = 0.22 * dnStarF;
  for (const g of nightGlows) g.mesh.material.opacity = g.max * dnLampF;
  for (const l of streetLamps) l.material.color.copy(_dnLampDay).lerp(_dnLampNight, dnLampF);   // bulbs: off in day, warm at night
  const fm = flatMat(0xF2C61F); fm.emissive.setHex(0xF2C61F); fm.emissiveIntensity = dnLampF * 0.42;   // hazard fence stays subtly visible
  for (const lt of lightTowers) { lt.glass.material.opacity = 0.18 + 0.75 * dnLampF; lt.shaft.material.opacity = 0.10 * dnLampF; lt.disc.material.opacity = 0.22 * dnLampF; lt.spot.intensity = 1.7 * dnLampF; }   // floodlights on at night
}
let _dnBeaconT = 0, _dnNetAcc = 0;
function updateDayNight(dt) {
  if ((!NET.active || NET.isHost) && !dnFrozen) timeOfDay = (timeOfDay + dt / dnFullCycle) % 1;   // frozen when host forces day/night/off
  else if (NET.active && !NET.isHost && dnHasTarget) { let d = dnTarget - timeOfDay; if (d > 0.5) d -= 1; else if (d < -0.5) d += 1; timeOfDay = (timeOfDay + d * Math.min(1, dt * 1.5) + 1) % 1; }
  applyDayNight();
  skyGroup.position.copy(camera.getWorldPosition(_dnCamPos));   // keep the sky centred on the camera (= at infinity)
  _dnBeaconT += dt; towerBeacon.material.opacity = dnLampF * ((Math.sin(_dnBeaconT * 2.4) > 0.4) ? 1 : 0.12);   // slow blink, night only
  if (NET.active && NET.isHost) { _dnNetAcc += dt; if (_dnNetAcc >= 2) { _dnNetAcc = 0; NET.broadcast({ t: 'daynight', tod: timeOfDay, cyc: dnFullCycle }); } }
}
applyDayNight();   // set the opening look immediately

// Per-frame map ambience: oil-drum flame flicker + fire crackle, flag wave + flap (distance-gated).
function updateMapFx(dt) {
  for (const f of mapFlames) {
    const s = 0.8 + Math.random() * 0.4;
    f.flame.scale.set(s, 0.9 + Math.random() * 0.3, s); f.inner.scale.set(s, 1, s);
    f.flame.material.opacity = 0.8 + Math.random() * 0.2;
    if (SND.lpos) {
      const d2 = f.pos.distanceToSquared(SND.lpos);
      f.t -= dt; if (f.t <= 0) { f.t = 0.35 + Math.random() * 0.3; if (d2 < 1600) sfxFireCrackle(f.pos); }
      f.smokeT -= dt; if (f.smokeT <= 0) { f.smokeT = 0.8 + Math.random() * 1.0; if (d2 < 900) spawnSmokePuff(f.pos.clone().setY(f.pos.y + 0.9), 0x3a3a3a, 0.12, 0.7); }
    }
  }
  if (mapFlag) {
    mapFlag.t += dt;
    mapFlag.segs.forEach((s, i) => { s.rotation.y = Math.sin(mapFlag.t * 2.2 + i * 0.9) * 0.35; });
    if (SND.lpos) { mapFlag._a = (mapFlag._a || 2) - dt; if (mapFlag._a <= 0) { mapFlag._a = 2 + Math.random() * 2; if (mapFlag.pos.distanceToSquared(SND.lpos) < 900) sfxFlagFlap(mapFlag.pos); } }
  }
}

// --- Cover positions bots hide behind (vehicles + flank props) ---
const cratePositions = [[-10, 8], [10, -9], [-48, 20], [48, 16], [-44, 0], [44, 0], [18, -42]];
// (Nuketown has no launch pads — `launchPads` declared above stays empty.)

// --- Ammo boxes: one in each house + on each flank ---
const pickups = [];
function addAmmoBox(x, z) {
  const y = groundHeightAt(x, z, 0.5);   // ground floor (not the roof above)
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.4, 1.4),
    new THREE.MeshLambertMaterial({ color: 0xffffff, emissive: 0x2a6fb0, emissiveIntensity: 0.5, flatShading: true }));
  mesh.position.set(x, y + 0.8, z); mesh.castShadow = true; scene.add(mesh);
  pickups.push({ mesh, pos: new THREE.Vector3(x, y + 0.8, z), active: true, respawn: 0 });
}
// ([56,0] → ~(75.6,0): ammo at the foot of the grand entrance stairs, drawing fights to the estate)
[[8, 60], [-8, -60], [-54, 0], [56, 0]].forEach(([x, z]) => addAmmoBox(SP(x), SP(z)));

// --- Spawn points: around each house (interior + yard) + the flanks; NONE in the street ---
[[-6, 62], [6, 62], [0, 54], [-9, 48], [9, 48],                  // yellow house + yard
 [-6, -62], [6, -62], [0, -54], [-9, -48], [9, -48],             // teal house + yard
 [-54, 30], [-54, -30], [50, 30], [50, -30], [-58, 0], [40, 0]   // flanks (clear of watchtower + estate)
].forEach(([sx, sz]) => spawnPoints.push(new THREE.Vector3(SP(sx), groundHeightAt(SP(sx), SP(sz), 0.5), SP(sz))));
// Estate spawns (absolute world coords) so players also drop in at the mansion: courtyard, ballroom, library, foyer.
[[68, 6], [68, -6], [72, 15], [72, -15], [86, 0]].forEach(([sx, sz]) => spawnPoints.push(new THREE.Vector3(sx, groundHeightAt(sx, sz, 0.5), sz)));

// --- Patrol waypoints (bots roam houses, yards, flanks, street, landmarks) ---
// ([52,±4] nudged off the wing inner walls into the open courtyard)
[[0, 58], [0, -58], [-8, 52], [8, -52], [0, 8], [0, -8],
 [-50, 22], [50, -22], [-50, -22], [50, 22], [-18, 0], [18, 0], [0, 32], [0, -32], [-62, 8], [-62, -8], [52, 4], [52, -4]
].forEach(([px, pz]) => patrolPoints.push(new THREE.Vector3(SP(px), groundHeightAt(SP(px), SP(pz), 0.5), SP(pz))));
// Estate patrols (absolute) so bots wander the courtyard + ground-floor rooms.
[[68, 0], [85, 0], [72, 15], [72, -15], [90, 12], [90, -12]].forEach(([px, pz]) => patrolPoints.push(new THREE.Vector3(px, groundHeightAt(px, pz, 0.5), pz)));

/* ============================================================================
   PARADISE ISLAND — Battle-Royale map. Built LAZILY (first BR start) in a far
   world region around (cx,cz)≈(1200,0) so its geometry/solids never overlap
   Nuketown's. ~5× the Nuketown footprint: one tropical landmass ringed by an
   out-of-bounds ocean, with beaches, jungle, mountains, clearings, dirt roads
   and 9 named POIs. Flat-shaded low-poly; reuses addBox/panelWall/cyl/addRamp/
   groundHeightAt + the global solids/colliders/ramps arrays. Returns an `island`
   descriptor (centre, radius, spawns, scooter spawns, patrol points, glows).
   ============================================================================ */
function buildParadiseIsland(cx, cz) {
  const R = 250;                         // dry-land radius; beyond this is ocean (out of bounds)
  // palette
  const sand = 0xe3d4a6, sandDk = 0xcab787, grass = 0x55934a, jungle = 0x2f5d2c, dirt = 0xb09766;
  const rockC = 0x8a8378, rockDk = 0x6d675d, wood = 0x6f5333, woodDk = 0x49371f, woodLt = 0x8c6a3c, thatch = 0xc2a35a;
  const water = 0x2f7fb0, waterLt = 0x5fb0d8, stone = 0xb8b09a, stoneLt = 0xcdc6b2, stoneDk = 0x7c7666;
  const concrete = 0x9a9a92, metal = 0x79828c, rust = 0x9c5a3c, gold = 0xc9a24a, glassC = 0xacc4d2;
  const pastel = [0xa9d3e0, 0xe9b7c6, 0xeede9e, 0xb8ddb0, 0xd9c2e6];   // beach-town house colours
  const spawns = [], scooterSpawns = [], patrol = [], pois = [], glows = [], peaks = [], caveSpots = [], lootSpots = [], secretSpots = [], fixedChests = [];   // fixedChests = explicit chest positions (incl. upper floors), placed at an exact Y
  brZiplines.length = 0;

  // --- local→world helpers (mirror the mansion builder) ---
  const iB   = (lx, y, lz, w, h, d, c, o) => addBox(cx + lx, y, cz + lz, w, h, d, c, o);                  // solid box
  const iD   = (lx, y, lz, w, h, d, c) => addBox(cx + lx, y, cz + lz, w, h, d, c, { noCollide: true });   // decorative box
  const iCyl = (lx, y, lz, r, h, c, rot) => cyl(cx + lx, y, cz + lz, r, h, c, rot);
  const iRamp = (lx, y, lz, w, d, lo, hi, axis, c) => addRamp(cx + lx, y, cz + lz, w, d, lo, hi, axis, c);
  const iGlow = (lx, y, lz, w, h, d, c, m) => glows.push([cx + lx, y, cz + lz, w, h, d, c, m == null ? 0.7 : m]);
  const iWallX = (lzf, lx0, lx1, y0, y1, t, c, holes) => panelWall('x', cz + lzf, cx + lx0, cx + lx1, y0, y1, t, c, (holes || []).map(h => ({ a0: cx + h.a0, a1: cx + h.a1, y0: h.y0, y1: h.y1 })));
  const iWallZ = (lxf, lz0, lz1, y0, y1, t, c, holes) => panelWall('z', cx + lxf, cz + lz0, cz + lz1, y0, y1, t, c, (holes || []).map(h => ({ a0: cz + h.a0, a1: cz + h.a1, y0: h.y0, y1: h.y1 })));
  function disc(lx, lz, r, y, c, seg) { const m = new THREE.Mesh(new THREE.CircleGeometry(r, seg || 44), flatMat(c)); m.rotation.x = -Math.PI / 2; m.position.set(cx + lx, y, cz + lz); m.receiveShadow = true; scene.add(m); return m; }
  // solid floor slab (walk-on top = `top`) with a rectangular stairwell hole cut out, so internal stairs
  // can climb up through it without the slab clipping/ejecting the player (matches how multi-floor works elsewhere)
  function floorHole(sx, sz, w, d, top, c, hx0, hx1, hz0, hz1) {
    const x0 = sx - w / 2, x1 = sx + w / 2, z0 = sz - d / 2, z1 = sz + d / 2, y = top - 0.4;
    if (hz0 > z0) iB(sx, y, (z0 + hz0) / 2, w, 0.4, hz0 - z0, c);
    if (z1 > hz1) iB(sx, y, (hz1 + z1) / 2, w, 0.4, z1 - hz1, c);
    if (hx0 > x0) iB((x0 + hx0) / 2, y, (hz0 + hz1) / 2, hx0 - x0, 0.4, hz1 - hz0, c);
    if (x1 > hx1) iB((hx1 + x1) / 2, y, (hz0 + hz1) / 2, x1 - hx1, 0.4, hz1 - hz0, c);
  }
  function iSpawn(lx, lz) { spawns.push(new THREE.Vector3(cx + lx, groundHeightAt(cx + lx, cz + lz, 0.5), cz + lz)); }
  function iPatrol(lx, lz) { patrol.push(new THREE.Vector3(cx + lx, groundHeightAt(cx + lx, cz + lz, 0.5), cz + lz)); }
  function dist2(lx, lz) { return Math.hypot(lx, lz); }

  // --- OCEAN (out-of-bounds) + tiered island ground ---
  const oc = new THREE.Mesh(new THREE.CircleGeometry(R + 260, 60), flatMat(water));
  oc.rotation.x = -Math.PI / 2; oc.position.set(cx, -0.4, cz); scene.add(oc);
  const surf = new THREE.Mesh(new THREE.RingGeometry(R - 10, R + 70, 60), new THREE.MeshLambertMaterial({ color: waterLt, flatShading: true, transparent: true, opacity: 0.45, depthWrite: false }));
  surf.rotation.x = -Math.PI / 2; surf.position.set(cx, -0.18, cz); scene.add(surf);
  disc(0, 0, R + 10, -0.03, sand, 60);          // sandy coastline (whole landmass base)
  disc(0, 0, R - 34, 0.0, grass, 56);           // grassy ring
  disc(0, 0, R - 110, 0.02, jungle, 50);        // dense jungle core (darker green)

  // --- scatter helpers ---
  function palm(lx, lz, h) {
    h = h || (7 + Math.random() * 4); const tilt = (Math.random() - 0.5) * 0.22;
    const tr = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.4, h, 6), flatMat(0x7a5a36));
    tr.position.set(cx + lx, h / 2, cz + lz); tr.rotation.z = tilt; tr.castShadow = true; scene.add(tr);
    const topX = cx + lx + tilt * h * 0.5;
    for (let a = 0; a < 6; a++) { const fr = new THREE.Mesh(new THREE.ConeGeometry(0.55, 3.6, 4), flatMat(a % 2 ? 0x3f8a3a : 0x327530)); fr.position.set(topX + Math.cos(a) * 1.4, h - 0.2, cz + lz + Math.sin(a) * 1.4); fr.rotation.z = Math.PI / 2 - 0.55; fr.rotation.y = a; scene.add(fr); }
    const co = new THREE.Mesh(new THREE.SphereGeometry(0.5, 5, 4), flatMat(0x6a4a2a)); co.position.set(topX, h - 0.7, cz + lz); scene.add(co);
  }
  function fern(lx, lz) { for (let a = 0; a < 5; a++) { const f = new THREE.Mesh(new THREE.ConeGeometry(0.32, 1.5, 4), flatMat(a % 2 ? 0x3c7a36 : 0x2f6a2c)); f.position.set(cx + lx + Math.cos(a) * 0.45, 0.72, cz + lz + Math.sin(a) * 0.45); f.rotation.z = (Math.random() - 0.5) * 0.9; scene.add(f); } }
  function bush(lx, lz, r) { const m = new THREE.Mesh(new THREE.IcosahedronGeometry(r || 1.1, 0), flatMat(0x3a7a36)); m.position.set(cx + lx, (r || 1.1) * 0.7, cz + lz); scene.add(m); }
  function rockDeco(lx, lz, r) { const m = new THREE.Mesh(new THREE.DodecahedronGeometry(r), flatMat(Math.random() > 0.5 ? rockC : rockDk)); m.position.set(cx + lx, r * 0.5, cz + lz); m.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3); m.castShadow = true; scene.add(m); }
  function rockSolid(lx, lz, w, h, d) { iB(lx, 0, lz, w, h, d, Math.random() > 0.5 ? rockC : rockDk); }   // boxy rock = cover
  function driftwood(lx, lz) { const m = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.35, 3.5, 6), flatMat(0x8a7a5a)); m.position.set(cx + lx, 0.3, cz + lz); m.rotation.set(Math.PI / 2, 0, Math.random() * 3); scene.add(m); }
  function road(lx0, lz0, lx1, lz1, w) {                              // dirt path strip (decorative)
    const dx = lx1 - lx0, dz = lz1 - lz0, len = Math.hypot(dx, dz);
    const m = new THREE.Mesh(new THREE.PlaneGeometry(w || 7, len), flatMat(dirt));
    m.rotation.x = -Math.PI / 2; m.rotation.z = -Math.atan2(dz, dx) + Math.PI / 2;
    m.position.set(cx + (lx0 + lx1) / 2, 0.04, cz + (lz0 + lz1) / 2); m.receiveShadow = true; scene.add(m);
  }
  // simple thatched hut (used for villages + minor structures); returns nothing, registers walls solid
  function hut(lx, lz, w, d, col, doorDir) {
    const h = 3.4, t = 0.3; iD(lx, 0.01, lz, w - 0.4, 0.06, d - 0.4, 0x6b5333);   // floor
    // 4 walls with a doorway on doorDir ('n'|'s'|'e'|'w')
    iWallX(lz + d / 2, lx - w / 2, lx + w / 2, 0, h, t, col, doorDir === 'n' ? [{ a0: lx - 0.9, a1: lx + 0.9, y0: 0, y1: 2.4 }] : []);
    iWallX(lz - d / 2, lx - w / 2, lx + w / 2, 0, h, t, col, doorDir === 's' ? [{ a0: lx - 0.9, a1: lx + 0.9, y0: 0, y1: 2.4 }] : []);
    iWallZ(lx + w / 2, lz - d / 2, lz + d / 2, 0, h, t, col, doorDir === 'e' ? [{ a0: lz - 0.9, a1: lz + 0.9, y0: 0, y1: 2.4 }] : []);
    iWallZ(lx - w / 2, lz - d / 2, lz + d / 2, 0, h, t, col, doorDir === 'w' ? [{ a0: lz - 0.9, a1: lz + 0.9, y0: 0, y1: 2.4 }] : []);
    // thatched pyramid roof (decorative) + solid flat ceiling cap so you can stand on it
    iB(lx, h, lz, w + 0.4, 0.3, d + 0.4, thatch);
    for (let i = 0; i < 3; i++) { const f = i / 3; iD(lx, h + 0.3 + f * 1.8, lz, (w + 0.4) * (1 - f * 0.7), 0.5, (d + 0.4) * (1 - f * 0.7), i % 2 ? thatch : 0xae9148); }
  }

  // --- MOUNTAINS (scenic rocky massifs; the west one hosts the Cliff Settlement) ---
  // A massif = a few stacked solid rock terraces; a switchback ramp climbs one face.
  function massif(lx, lz, baseR, tiers, tierH) {
    for (let i = 0; i < tiers; i++) { const r = baseR * (1 - i / (tiers + 0.6)); iB(lx, i * tierH, lz, r * 2, tierH + 0.2, r * 2, i % 2 ? rockC : rockDk); }
    return tiers * tierH;   // summit height
  }
  massif(-150, 70, 34, 4, 5);                      // west mountain (Cliff Settlement builds its own terraced climb on the south flank)

  // ============ PART 2 — VARIED TERRAIN around the POIs: 3 named peaks, ravines, cliffs, caves, hills ============
  function tLadder(lx, lz, top, outZ) { outZ = outZ == null ? -1 : outZ; for (let y = 0.5; y < top; y += 0.6) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.1, 0.1), flatMat(0x6a6a6a)); m.position.set(cx + lx, y, cz + lz); scene.add(m); } ladders.push({ x: cx + lx, z: cz + lz, bottom: 0, top: top, cx: cx + lx, cz: cz + lz + outZ * 1.3, outX: 0, outZ: outZ }); }
  function hill(lx, lz, r, h) { const steps = Math.max(2, Math.round(h / 0.65)); for (let i = 0; i < steps; i++) { const f = i / steps; iB(lx, i * (h / steps), lz, r * 2 * (1 - f * 0.8), (h / steps) + 0.12, r * 2 * (1 - f * 0.8), i % 2 ? 0x6f9d5a : 0x5f8d4e); } }   // climbable stepped mound (each step ≤ STEP)
  function caveRoom(lx, lz, w, d, h, dirs) { dirs = dirs || ['s']; const hole = (dir, a) => dirs.indexOf(dir) >= 0 ? [{ a0: a - 1.5, a1: a + 1.5, y0: 0, y1: 2.8 }] : [];
