function endMatch(won) {
  gameState.over = true;
  gameState.running = false;
  paused = false; if (el('pauseMenu')) el('pauseMenu').style.display = 'none';
  aiming = false; scopeBlend = 0; scopePunch = 0; adsBlend = 0; aimSensMult = 1; minigunSpin = 0; minigunSteady = false;   // clear scope so the end screen isn't dimmed
  document.exitPointerLock();
  Ambient.stop(); SaberHum.stop(); clearDogs(); clearKongs(); clearMckaylas(); (won ? sfxWin() : sfxLose());
  el('endTitle').textContent = won ? 'YOU WIN' : 'MATCH OVER';
  el('endSub').textContent = `Final: ${gameState.score} pts • ${gameState.kills} kills (target ${SCORE_TARGET}).`;
  el('endScreen').style.display = 'flex';
}

function startMatch() {
  gameState.running = true; gameState.over = false; gameState.kills = 0; gameState.score = 0;
  paused = false; if (el('pauseMenu')) el('pauseMenu').style.display = 'none';   // never start paused
  // --- Match settings lock + per-player stat reset (Part 6 / foundation) ---
  MATCH._sudden = false; MATCH._timeLeft = modeTimeLimitSec(); MATCH._hasTime = MATCH._timeLeft > 0; MATCH._ended = false; _mtimeAcc = 0;
  cancelKillcam(); _camRing.length = 0; _worldRing.length = 0; _kcSends.length = 0;   // fresh killcam buffers + send queue each match
  flashlightOn = false; liveCfg = {}; applyAllWeaponMags();      // (PART 2) reset flashlight + re-apply weapon configs (mags) for the match
  Object.assign(soloStat, freshStat('YOU'));
  if (gameMode === 'tdm') assignTeams(); else { myTeam = null; if (NET.active) NET.scores.forEach(s => s.team = null); }
  if (!NET.active || NET.isHost) { timeOfDay = Math.random(); dnFullCycle = 480 + Math.random() * 240; applyDayNightSetting(); }   // host/solo: randomize the day/night state each match (Part 6 can force it)
  mckaylaSummonedThisLife = false;   // fresh Mckayla summon available at match start
  rcResetMatch();   // RC launcher locks again each match (unlock is per-match, not permanent)
  // --- MAP SELECTION: Battle Royale plays on Paradise Island (lazy-built in its own far world region);
  // every other mode plays on Nuketown. activeMap drives the boundary clamp, spawns and OOB water. ---
  if (gameMode === 'br') { ensureParadiseIsland(); activeMap = 'paradise'; } else { activeMap = 'nuketown'; }
  // Everyone spawns on a real spawn point (team side in TDM), facing the centre of the map.
  const sp = spawnForPlayer(); player.pos.set(sp.x, groundHeightAt(sp.x, sp.z, 0.5), sp.z);
  player.vel.set(0, 0, 0);
  player.health = 100; player.alive = true; player.sliding = false; player.launchCd = 0;
  player.crouching = false; player.diving = false; player.diveAir = false; player.crouchBlend = 0; player.diveTilt = 0; player.eye = MOVE.eyeHeight;
  player.impulseT = 0; player.impulseGrace = 0;
  player.cigar = CIGAR.maxCarry; cigSmoking = false; cigCanceling = false; if (_cigVM) _cigVM.visible = false;   // fresh cigar; clear any prior smoke
  saberMode = false; saberBlocking = false; player.overheal = 0; SaberHum.stop(); if (_jdVM) _jdVM.visible = false; clearDogs(); clearKongs(); clearMckaylas(); streakReset(false);   // fresh scorestreak + no leftover dogs
  player.grenades = throwMaxCarry();
  yaw = Math.atan2(sp.x, sp.z); pitch = 0; recoilPitch = 0; recoilYaw = 0;   // look toward map centre
  aiming = false; scopeBlend = 0; scopePunch = 0; adsBlend = 0; aimSensMult = 1; minigunSpin = 0; minigunSteady = false; shakeTime = 0; shakeMag = 0;
  // Clear any leftover thrown grenades / tomahawks / explosion FX from a previous match
  liveGrenades.forEach(g => scene.remove(g.mesh)); liveGrenades.length = 0;
  liveTomahawks.forEach(t => { scene.remove(t.mesh); disposeGroup(t.mesh); }); liveTomahawks.length = 0;
  liveSmokeNades.forEach(s => { scene.remove(s.mesh); disposeGroup(s.mesh); }); liveSmokeNades.length = 0;
  smokeClouds.forEach(c => c.parts.forEach(p => { scene.remove(p.spr); p.spr.material.dispose(); })); smokeClouds.length = 0;
  explosions.forEach(e => scene.remove(e.mesh)); explosions.length = 0;
  bloodDecals.forEach(d => scene.remove(d.mesh)); bloodDecals.length = 0;
  debris.forEach(d => { scene.remove(d.obj); disposeGroup(d.obj); }); debris.length = 0;
  liveRockets.forEach(r => { scene.remove(r.grp); r.flameMat.dispose(); }); liveRockets.length = 0;
  ggProjectiles.forEach(p => { scene.remove(p.mesh); disposeGroup(p.mesh); }); ggProjectiles.length = 0;
  ggSmoke.forEach(s => { scene.remove(s.mesh); s.mesh.material.dispose(); }); ggSmoke.length = 0;   // projectile-trail puffs
  liveImpulses.forEach(c => { scene.remove(c.mesh); disposeGroup(c.mesh); }); liveImpulses.length = 0;
  impulseThrowT = 0;
  el('floatLayer').innerHTML = '';
  WEAPON_ORDER.forEach(k => { weaponState[k].ammo = WEAPONS[k].mag; weaponState[k].reloading = 0; weaponState[k].cooldown = 0; });
  // Reset special weapons + loot (improvements #2/#3)
  ownedSpecials.clear();
  SPECIAL_ORDER.forEach(k => { weaponState[k].ammo = 0; weaponState[k].reserve = 0; weaponState[k].reloading = 0; weaponState[k].cooldown = 0; });
  currentWeaponKey = 'pistol';
  lootActive = false; lootGroup.visible = false; el('pickupBanner').style.opacity = 0;
  maybeShowInvTip(30, true);   // FFA-only "PRESS I" inventory discoverability hint (first 30s of the match)
  chResetBanner(); showObjHint();   // control-hints new-player banner (60s) + brief objective reminder

  // --- Bots: host (or solo) simulates them; clients render host snapshots ---
  if (!NET.active || NET.isHost) {
    if (bots.length === 0) createBots(); else bots.forEach(spawnBot);
    applyBotCount();                                   // honor the Settings bot count
  } else {
    // client: drop any local bots; they'll be rebuilt from the host's snapshots
    bots.forEach(b => { if (b.group) { scene.remove(b.group); disposeGroup(b.group); } });
    bots.length = 0;
  }
  spawnScooters();   // Part 7: four mobility scooters on the map each match (state synced; host owns idle ones)
  el('scooterHud').style.display = 'none'; el('speedLines').style.opacity = 0; el('scooterPrompt').style.display = 'none';

  // --- Multiplayer score / lobby state ---
  if (NET.active) {
    player.lastAttacker = null; player.lastAttackerHead = false; player.lastAttackerName = null;
    player.lastAttackerWeapon = null; player.lastAttackerMelee = false;
    NET.ready = true;
    if (NET.isHost) { NET.scores.forEach(s => { const t = s.team; Object.assign(s, freshStat(s.name)); s.team = t; }); }   // reset all stats; keep team assignment
    el('lobbyTag').textContent = 'LOBBY ' + (NET.code || '');
  } else {
    el('lobbyTag').textContent = '';
  }

  // --- Loadout: both modes use the same gun-game arsenal + karambit/cigar/impulse/RC.
  // GUN GAME auto-progresses from level 1; FFA lets the player pick a main weapon (key I).
  if (MATCH.forceLoadout) { ffaMain = 'gg2'; meleeChoice = 'karambit'; lethalChoice = 'smoke'; }   // host forced everyone onto the preset default loadout
  ggKarambit = false;
  GUNGAME_LADDER.forEach(k => { weaponState[k].ammo = WEAPONS[k].mag; weaponState[k].reloading = 0; weaponState[k].cooldown = 0; });
  weaponState.gg17.ammoL = weaponState.gg17.ammoR = null;   // akimbo re-splits its mag on first shot
  weaponState[KARAMBIT_KEY].cooldown = 0; weaponState[KARAMBIT_KEY].reloading = 0;
  player.grenades = 0; player.impulses = IMPULSE.maxCarry; player.lethals = LETHAL_MAX;  // impulse grenades are the G equipment (both modes)
  if (gameMode === 'gungame') {
    ggLevel = 1;
    ggEquip('gg1');                                  // start on the level-1 gun
  } else {
    if (!WEAPONS[ffaMain]) ffaMain = 'gg2';
    ggEquip(ffaMain);                                // FFA: start on the chosen main weapon (default Assault Rifle)
  }
  if (NET.active && NET.isHost) NET.broadcastScores();
  if (NET.active) NET.applyScoresLocal();
  updateHUD();
  refreshScoreboard();
  invOpen = false; el('invMenu').classList.add('hidden');   // ensure the inventory menu is closed at match start
  showScreen('__none__');                 // hide every overlay
  el('endScreen').style.display = 'none';
  el('resultsScreen') && (el('resultsScreen').style.display = 'none');
  SND.init(); SND.resume(); Ambient.start(); sfxCountdown(3);   // start the audio engine + ambience + a "GO" chime
  // Brief intro banner with the locked match rules (Part 6).
  const introCol = gameMode === 'tdm' ? (myTeam ? TEAMS[myTeam].css : '#ffe600') : '#ffe600';
  showCenterBanner((gameMode === 'tdm' ? 'TEAM ' + (myTeam || 'red').toUpperCase() + '\n' : '') + matchSettingsSummary(), introCol, 3400);
  updateMatchTimerHUD();
  if (gameMode === 'br') brStart(); else brEnd();   // BATTLE ROYALE: single-life elimination on Paradise Island (melee start, loot for guns)
  lockPointer();
}

// --- Weapon picker (mounted on both the solo start screen and the lobby) ---
// (FFA starting-weapon picker removed — FFA players spawn with the Assault Rifle and press I in-match
//  to open the inventory and choose any weapon. The throwable picker below is unrelated and kept.)

/* --- FFA weapon inventory (press I): pick any of the 20 ladder weapons as your main --- */
let invOpen = false;
function buildInventory() {
  const grid = el('invGrid'); if (!grid) return;
  grid.innerHTML = '';
  GUNGAME_LADDER.concat(FFA_ONLY_WEAPONS).forEach(key => {   // 20 ladder weapons + 5 FFA-only = 25 (5x5)
    const w = WEAPONS[key];
    const card = document.createElement('button');
    card.className = 'invCard'; card.dataset.key = key;
    const rps = (1 / w.fireRate).toFixed(1);
    const spd = Math.round((w.speed || 1) * 100);
    const dmg = w.melee ? 'MELEE' : ((w.explosive || w.damage >= 9999) ? 'EXPLOSIVE' : w.damage);
    const sight = (w.sight && w.sight !== 'none') ? w.sight.replace('scope_', '').toUpperCase() : 'NONE';
    card.innerHTML = `<span class="ic" style="background:#${w.color.toString(16).padStart(6, '0')}"></span>`
      + `<b>${w.name}</b>`
      + `<small>DMG ${dmg} • ${rps}/s</small>`
      + `<small>SIGHT ${sight} • SPD ${spd}%</small>`
      + `<span class="eqTag">EQUIPPED</span>`;
    card.onclick = () => selectInvWeapon(key);
    if (isCustomizable(key)) {   // (PART 2) per-card CUSTOMIZE button -> weapon attachment menu
      const wb = document.createElement('span'); wb.className = 'wcBtn'; wb.textContent = '🔧';
      wb.title = 'Customize attachments'; wb.onclick = (ev) => { ev.stopPropagation(); WeaponCustom.open(key, 'inventory'); };
      card.appendChild(wb);
    }
    grid.appendChild(card);
  });
}
function refreshInventory() {
  [...el('invGrid').children].forEach(c => c.classList.toggle('equipped', c.dataset.key === ffaMain));
}
function selectInvWeapon(key) {
  if (!WEAPONS[key]) return;
  ffaMain = key;
  const ws = weaponState[key];                       // full ammo loadout for the new main (reserve is already Infinite)
  ws.ammo = WEAPONS[key].mag; ws.reloading = 0; ws.cooldown = 0;
  if (key === 'gg17') { ws.ammoL = ws.ammoR = null; }
  ggKarambit = false;
  ggEquip(key);                                      // draws the new weapon immediately
  sfxInvSelect();                                    // confirmation + gun-load
  closeInventory();
}
function toggleInventory() {
  if (gameMode === 'gungame' || !gameState.running) return;
  invOpen = !invOpen;
  if (invOpen) {
    cigCancel();
    setInvTab('paneMain'); refreshInvPanes();
    dismissInvTip(false);   // opening the inventory = discovered it; stop nagging this session
    _chBannerDone = true;   // ...and retire the control-hints new-player banner
    el('invMenu').classList.remove('hidden');
    sfxInvOpen();                                            // tactical tab-open
    document.exitPointerLock && document.exitPointerLock();   // free the cursor (game keeps running)
  } else {
    el('invMenu').classList.add('hidden');
    sfxMenu(false);
    if (gameState.running && player.alive) lockPointer();
  }
}
function closeInventory() { if (invOpen) { invOpen = false; el('invMenu').classList.add('hidden'); if (gameState.running && player.alive) lockPointer(); } }
buildInventory();
// Pause-key (default ESC) toggles the in-match pause menu — and closes the inventory/settings first.
document.addEventListener('keydown', (e) => {
  if (e.repeat || IM.codeAction(e.code) !== 'pause') return;
  if (brMapOpen) { brCloseMap(); return; }                                 // BR: ESC closes the paper map (no pause)
  if (invOpen) { closeInventory(); return; }
  if (!el('skinCreator').classList.contains('hidden')) return;             // skin creator has its own close
  if (!el('settingsScreen').classList.contains('hidden')) { el('settingsBack').click(); return; }   // DONE out of settings
  if (!gameState.running || gameState.over) return;
  if (paused) resumeGame(); else openPauseMenu();
});

// --- Audio: unlock the engine on the first user gesture (browser policy) + delegated UI sounds ---
['pointerdown', 'keydown'].forEach(ev => document.addEventListener(ev, () => { SND.init(); SND.resume(); }));
document.addEventListener('mouseover', (e) => { const b = e.target && e.target.closest && e.target.closest('button'); if (b && !b.disabled) sfxHover(); });
document.addEventListener('mousedown', (e) => { const b = e.target && e.target.closest && e.target.closest('button'); if (b && !b.disabled && !b.classList.contains('invCard')) sfxClick(); });

/* --- Win conditions (FFA kill limit / TDM team kill limit) — host/solo authoritative --- */
// Sum of kills for a TDM team. Solo TDM: the local player is RED, all bots are BLUE.
function teamKills(team) {
  if (!NET.active) return team === 'red' ? gameState.kills : (soloStat.deaths || 0);
  let n = 0; NET.scores.forEach(s => { if (s.team === team) n += s.kills; }); return n;
}
function teamPlayers(team) { const a = []; if (NET.active) NET.scores.forEach((s, id) => { if (s.team === team) a.push(Object.assign({ id }, s)); }); return a; }
function checkWinCondition() {
  if (gameState.over || !gameState.running) return;
  if (NET.active && !NET.isHost) return;            // only host/solo decide the winner
  if (gameMode === 'tdm') {
    const lim = MATCH.tdmKills, rk = teamKills('red'), bk = teamKills('blue');
    if (MATCH._sudden) { if (rk !== bk) finishMatch({ team: rk > bk ? 'red' : 'blue' }); return; }   // sudden death: next decisive kill ends it
    const win = rk >= lim ? 'red' : bk >= lim ? 'blue' : null;
    if (win) finishMatch({ team: win });
  } else if (gameMode === 'ffa') {
    if (NET.active) { let w = null; NET.scores.forEach(s => { if (!w && s.kills >= MATCH.ffaKills) w = s; }); if (w) finishMatch({ winner: w.name }); }
    else if (gameState.kills >= MATCH.ffaKills) finishMatch({ winner: 'YOU' });
  }
  // Gun Game's win (level-20 knife kill) is handled in ggHostKill/ggSoloKill.
}
// Single host/solo path to end a match. result = { winner } (FFA/GG) or { team } (TDM); byTime optional.
function finishMatch(result) {
  if (gameState.over) return;
  const team = result.team || null;
  const winnerName = team ? TEAMS[team].name : result.winner;
  const awards = computeAwards();                    // MVP / highlight cards (Part 2)
  const rows = scoreboardRows();                     // final ranked table snapshot
  if (NET.active && NET.isHost) NET.broadcast({ t: 'matchover', winner: winnerName, team, byTime: !!result.byTime, awards, rows });
  doMatchOver(winnerName, team, { byTime: !!result.byTime, awards, rows, br: !!result.br, placement: result.placement || BR.placement });
}
// Ranked row snapshot from the authoritative stat records — shared by the Tab scoreboard + results table.
function scoreboardRows() {
  let rows;
  if (NET.active) rows = [...NET.scores.entries()].map(([id, s]) => Object.assign({ id }, s));
  else rows = [Object.assign({ id: NET.selfId }, soloStat, { name: 'YOU', score: gameState.score, kills: gameState.kills })];
  if (gameMode === 'gungame') rows.sort((a, b) => (b.level || 1) - (a.level || 1) || b.kills - a.kills);
  else rows.sort((a, b) => b.kills - a.kills || (b.score || 0) - (a.score || 0));
  rows.forEach((r, i) => r.rank = i + 1);
  return rows;
}
// MVP + highlight awards for the results screen — computed once on the host/solo, then broadcast.
function computeAwards() {
  let recs;
  if (NET.active) recs = [...NET.scores.values()].map(r => Object.assign({}, r));
  else recs = [Object.assign({}, soloStat, { name: 'YOU', kills: gameState.kills, score: gameState.score })];
  if (!recs.length) return null;
  const best = (getter) => { let b = null, bv = -1; recs.forEach(r => { const v = getter(r) || 0; if (v > bv) { bv = v; b = r; } }); return (b && bv > 0) ? { name: b.name, val: bv } : null; };
  let topW = null, topWv = 0, topWname = null;
  recs.forEach(r => { const wk = r.wkills || {}; for (const k in wk) { if (wk[k] > topWv) { topWv = wk[k]; topW = k; topWname = r.name; } } });
  return {
    mvp: best(r => r.kills),
    headshots: best(r => r.headshots),
    streak: best(r => r.bestStreak),
    melee: best(r => r.meleeKills),
    streakActs: best(r => r.streakActs),
    weapon: (topW && topWv > 0) ? { name: topWname, val: topWv, weapon: topW, wname: (WEAPONS[topW] ? WEAPONS[topW].name : topW) } : null
  };
}

/* --- Multiplayer match flow --- */
function beginMatch() { startMatch(); }                 // clients enter here on the host's "start"
function hostStartMatch() {                              // host (lobby START or PLAY AGAIN)
  if (!NET.isHost) return;
  NET.broadcast({ t: 'start', mode: gameMode, cfg: MATCH.payload() });
  beginMatch();
}

/* --- TDM TEAM SELECTION (Part 3) — pick RED/BLUE before the match (balance-locked), with a 30s
   countdown + a host force-start. Solo: your pick is yours, bots fill the other side. MP: picks
   relay to the host (authoritative), and the host's countdown / force-start begins the match. --- */
let chosenTeam = null, _tsMode = null, _tsTimer = 0, _tsActive = false, _tsBcast = 0;
function tsCounts() {
  let red = 0, blue = 0, redNames = [], blueNames = [];
  if (NET.active) NET.scores.forEach(s => { if (s.team === 'red') { red++; redNames.push(s.name); } else if (s.team === 'blue') { blue++; blueNames.push(s.name); } });
  else if (chosenTeam === 'red') { red = 1; redNames = ['YOU']; } else if (chosenTeam === 'blue') { blue = 1; blueNames = ['YOU']; }
  return { red, blue, redNames, blueNames };
}
function renderTeamSelect() {
  if (!_tsActive) return;
  const c = tsCounts(), mk = ns => ns.length ? ns.map(n => '<div class="tsPl"><span class="tsDot" style="background:#7a8088"></span>' + String(n).replace(/[<>&]/g, '') + '</div>').join('') : '<div class="tsPl" style="opacity:.5">— bots fill the roster —</div>';
  el('tsRedCount').textContent = 'PLAYERS: ' + c.red; el('tsBlueCount').textContent = 'PLAYERS: ' + c.blue;
  el('tsRedList').innerHTML = mk(c.redNames); el('tsBlueList').innerHTML = mk(c.blueNames);
  const lockRed = (c.red - c.blue) >= 1 && chosenTeam !== 'red', lockBlue = (c.blue - c.red) >= 1 && chosenTeam !== 'blue';
  const jr = el('tsJoinRed'), jb = el('tsJoinBlue');
  jr.disabled = lockRed; jr.textContent = lockRed ? 'TEAM BALANCE LOCKED' : (chosenTeam === 'red' ? '✓ ON TEAM RED' : 'JOIN RED');
  jb.disabled = lockBlue; jb.textContent = lockBlue ? 'TEAM BALANCE LOCKED' : (chosenTeam === 'blue' ? '✓ ON TEAM BLUE' : 'JOIN BLUE');
}
function showTeamSelect(mode) {
  _tsMode = mode; _tsActive = true; chosenTeam = null; _tsTimer = 30; _tsBcast = 0;
  if (NET.active && NET.isHost) NET.scores.forEach(s => s.team = null);   // host: clear prior picks
  if (mode === 'host') NET.broadcast({ t: 'tsel' });                      // tell clients to open the screen too
  el('tsStartNow').style.display = (mode === 'host' || mode === 'solo') ? '' : 'none';
  el('tsBack').style.display = (mode === 'client') ? 'none' : '';
  showScreen('teamSelect'); renderTeamSelect();
}
function teamSelectPick(team) {
  if (!_tsActive) return;
  const c = tsCounts();
  if (team === 'red' && (c.red - c.blue) >= 1 && chosenTeam !== 'red') return;    // balance lock — can't pile onto the bigger team
  if (team === 'blue' && (c.blue - c.red) >= 1 && chosenTeam !== 'blue') return;
  chosenTeam = team; if (typeof sfxClick === 'function') sfxClick();
  if (NET.active) {
    if (NET.isHost) { const s = NET.scores.get(NET.selfId); if (s) s.team = team; NET.broadcastScores(); }
    else NET.route(NET.hostId, { t: 'tpick', id: NET.selfId, team });
  }
  renderTeamSelect();
}
function teamSelectGo() {
  if (!_tsActive) return; _tsActive = false;
  if (!chosenTeam) { const c = tsCounts(); chosenTeam = (c.red <= c.blue) ? 'red' : 'blue'; }   // graceful auto-assign to the smaller team
  if (NET.active && NET.isHost) { const s = NET.scores.get(NET.selfId); if (s) s.team = chosenTeam; }
  el('teamSelect').classList.add('hidden');
  if (_tsMode === 'host') hostStartMatch();
  else if (_tsMode === 'solo') startMatch();   // client: waits for the host's 'start' broadcast (beginMatch)
}
function updateTeamSelect(dt) {
  if (!_tsActive) return;
  if (_tsMode === 'host' || _tsMode === 'solo') {
    _tsTimer -= dt;
    if (_tsTimer <= 0) { teamSelectGo(); return; }
    if (NET.active && NET.isHost) { _tsBcast -= dt; if (_tsBcast <= 0) { _tsBcast = 1; NET.broadcast({ t: 'tseltime', s: _tsTimer }); } }
  }
  el('tsTimer').textContent = 'MATCH STARTING IN: ' + Math.max(0, Math.ceil(_tsTimer)) + 's';
}
if (el('tsJoinRed')) el('tsJoinRed').onclick = () => teamSelectPick('red');
if (el('tsJoinBlue')) el('tsJoinBlue').onclick = () => teamSelectPick('blue');
if (el('tsStartNow')) el('tsStartNow').onclick = () => teamSelectGo();
if (el('tsBack')) el('tsBack').onclick = () => { _tsActive = false; el('teamSelect').classList.add('hidden'); showScreen(NET.active ? 'lobbyScreen' : 'startScreen'); };
let _matchResult = null;   // last match's result payload (winner/team/awards/rows) for the results screen
function doMatchOver(winnerName, team, extra) {
  team = team || null; extra = extra || {};
  gameState.over = true; gameState.running = false;
  MATCH._sudden = false; MATCH._timeLeft = 0; MATCH._hasTime = false;
  paused = false; if (el('pauseMenu')) el('pauseMenu').style.display = 'none';
  aiming = false; scopeBlend = 0; scopePunch = 0; adsBlend = 0; aimSensMult = 1; minigunSpin = 0; minigunSteady = false;
  cancelKillcam(); _kcSends.length = 0;   // a killcam in progress is cut short by the match ending; drop any queued sends
  scooterDismountAll();   // eject any scooter rider; freeze the vehicle
  document.exitPointerLock();
  Ambient.stop(); SaberHum.stop(); clearDogs(); clearKongs(); clearMckaylas();
  // Did the local player win? (TDM: my team is the winning team.)
  let won = team ? (myTeam === team) : ((winnerName && winnerName === NET.selfName) || (!NET.active && winnerName === 'YOU'));
  if (extra.br) { won = player.alive; brEnd(); }   // BR: you win only as the last one standing
  _matchResult = { winnerName, team, won, byTime: !!extra.byTime, br: !!extra.br, placement: won ? 1 : (extra.placement || BR.placement || 0),
                   awards: extra.awards || computeAwards(), rows: extra.rows || scoreboardRows() };
  (won ? sfxWin() : sfxLose());           // victory / defeat fanfare
  showResultsScreen(_matchResult);        // Part 2 — full end-of-match results screen
}
// --- Scooter (Part 7) forward state — the vehicle system + real functions are defined further below. ---
let scooters = [], myScooter = null, riding = false;
/* ============================================================================
   PART 6 — MATCH TIMER + DAY/NIGHT FORCE. Host/solo authoritative; the host
   broadcasts the remaining time (~1 Hz) and clients just display it.
   ============================================================================ */
let _mtimeAcc = 0;                        // match-timer broadcast accumulator
function applyDayNightSetting() {
  const m = MATCH.dayNight;
  if (m === 'day') { timeOfDay = 0.50; dnFrozen = true; }          // noon
  else if (m === 'night') { timeOfDay = 0.0; dnFrozen = true; }    // midnight
  else if (m === 'off') { dnFrozen = true; }                       // freeze at whatever it is now
  else { dnFrozen = false; }                                       // 'on' = cycle normally
  applyDayNight();
}
function fmtClock(sec) { sec = Math.max(0, Math.ceil(sec)); const m = (sec / 60) | 0, s = sec % 60; return m + ':' + (s < 10 ? '0' : '') + s; }
function updateMatchTimerHUD() {
  const e = el('matchTimer'); if (!e) return;
  if (!gameState.running || gameState.over || !MATCH._hasTime) { e.style.display = 'none'; return; }
  e.style.display = 'block'; e.textContent = MATCH._sudden ? 'SUDDEN DEATH' : fmtClock(MATCH._timeLeft);
  e.classList.toggle('low', !MATCH._sudden && MATCH._timeLeft <= 30);
}
function updateMatchTimer(dt) {
  if (!gameState.running || gameState.over) return;
  if (NET.active && !NET.isHost) { updateMatchTimerHUD(); return; }   // clients display the host's broadcast value
  if (MATCH._hasTime && !MATCH._sudden) {
    MATCH._timeLeft = Math.max(0, MATCH._timeLeft - dt);
    if (NET.active && NET.isHost) { _mtimeAcc += dt; if (_mtimeAcc >= 1) { _mtimeAcc = 0; NET.broadcast({ t: 'mtime', s: MATCH._timeLeft, sd: MATCH._sudden }); } }
    if (MATCH._timeLeft <= 0) onTimeExpired();
  }
  updateMatchTimerHUD();
}
// Time ran out: the leader wins (TDM ties go to sudden death — first decisive kill).
function onTimeExpired() {
  if (gameState.over) return;
  if (gameMode === 'tdm') {
    const rk = teamKills('red'), bk = teamKills('blue');
    if (rk === bk) { MATCH._sudden = true; showCenterBanner('SUDDEN DEATH', '#ff5a5a'); if (NET.active && NET.isHost) NET.broadcast({ t: 'mtime', s: 0, sd: true }); return; }
    finishMatch({ team: rk > bk ? 'red' : 'blue', byTime: true });
  } else if (gameMode === 'gungame') {
    let best = null; if (NET.active) NET.scores.forEach(s => { if (!best || (s.level || 1) > (best.level || 1) || ((s.level || 1) === (best.level || 1) && s.kills > best.kills)) best = s; });
    finishMatch({ winner: NET.active ? (best ? best.name : 'YOU') : 'YOU', byTime: true });
  } else {
    let best = null; if (NET.active) NET.scores.forEach(s => { if (!best || s.kills > best.kills) best = s; });
    finishMatch({ winner: NET.active ? (best ? best.name : '') : 'YOU', byTime: true });
  }
}

/* ============================================================================
   PART 4 — TEAM DEATHMATCH: teams, auto-balance, friendly fire, team spawns.
   RED = yellow-house side (north, +z); BLUE = teal-house side (south, -z).
   ============================================================================ */
function teamOf(id) {
  if (id === (NET.active ? NET.selfId : 'me')) return myTeam;
  if (NET.active && NET.scores.has(id)) return NET.scores.get(id).team || null;
  return null;
}
// In TDM with friendly fire OFF, my own team is protected from my fire (bullets pass through).
function ffProtected(id, team) {
  if (gameMode !== 'tdm' || MATCH.friendlyFire || !myTeam) return false;
  const t = (team !== undefined) ? team : teamOf(id);
  return !!t && t === myTeam;
}
function sameTeam(a, b) { return !!a && a === b; }
// Auto-balance teams (host-authoritative). Solo: local player RED, all bots BLUE.
function assignTeams() {
  if (!NET.active) { myTeam = (chosenTeam === 'blue') ? 'blue' : 'red'; soloStat.team = myTeam; bots.forEach(b => b.team = (myTeam === 'red' ? 'blue' : 'red')); return; }   // (Part 3) honour the chosen team
  if (NET.isHost) {
    const mineS = NET.scores.get(NET.selfId); if (mineS && (chosenTeam === 'red' || chosenTeam === 'blue')) mineS.team = chosenTeam;   // (Part 3) the host's own pick
    let r = 0, b = 0;
    NET.scores.forEach(s => { if (s.team === 'red') r++; else if (s.team === 'blue') b++; });
    NET.scores.forEach(s => { if (s.team !== 'red' && s.team !== 'blue') { if (r <= b) { s.team = 'red'; r++; } else { s.team = 'blue'; b++; } } });
    const mine = NET.scores.get(NET.selfId); myTeam = mine ? mine.team : 'red';
    bots.forEach((bt, i) => bt.team = (i % 2 === 0) ? 'red' : 'blue');   // bots split evenly
    NET.broadcastScores();
  }   // clients receive their team via the scores broadcast ('scores' handler sets myTeam)
}
// Host: move a player to the other team if it keeps teams within 1 (used by the pause-menu switch).
function requestTeamSwitch() {
  if (gameMode !== 'tdm' || !NET.active) return false;
  if (NET.isHost) return hostSwitchTeam(NET.selfId);
  NET.route(NET.hostId, { t: 'teamswitch', id: NET.selfId }); return true;
}
function hostSwitchTeam(id) {
  const s = NET.scores.get(id); if (!s) return false;
  const to = s.team === 'red' ? 'blue' : 'red';
  let toCount = 0, fromCount = 0; NET.scores.forEach(x => { if (x.team === to) toCount++; else if (x.team === s.team) fromCount++; });
  if (toCount + 1 - (fromCount - 1) > 1) return false;   // would unbalance by >1
  s.team = to; if (id === NET.selfId) myTeam = to;
  NET.broadcastScores();
  return true;
}
// Distance from a candidate spawn to the nearest living ENEMY of `team`.
function nearestEnemyDist(pos, team) {
  let d = Infinity;
  const consider = (p, t) => { if (t && t !== team) d = Math.min(d, Math.hypot(p.x - pos.x, p.z - pos.z)); };
  if (player.alive) consider(player.pos, myTeam);
  if (NET.active) NET.players.forEach(rp => { if (rp.alive) consider(rp.pos, teamOf(rp.id)); });
  for (const b of bots) if (b.alive) consider(b.pos, b.team);
  return d;
}
// A spawn on the team's side, biased away from the nearest enemy (spawn protection).
function teamSpawnPoint(team) {
  const north = team === 'red';
  const side = spawnPoints.filter(p => north ? p.z > 15 : p.z < -15);
  const pool = side.length ? side : spawnPoints;
  let best = null, bestD = -1;
  for (let i = 0; i < 10; i++) {
    const c = pool[(Math.random() * pool.length) | 0];
    if (spawnBlocked(c)) continue;
    const d = nearestEnemyDist(c, team);
    if (d > bestD) { bestD = d; best = c; }
  }
  return (best || pool[(Math.random() * pool.length) | 0]).clone();
}
// Where the local player should (re)spawn: team side in TDM, anywhere otherwise.
function spawnForPlayer() {
  if (activeMap === 'paradise' && island && island.spawns.length) return island.spawns[(Math.random() * island.spawns.length) | 0].clone();
  return (gameMode === 'tdm' && myTeam) ? teamSpawnPoint(myTeam) : randomSpawn();
}
// Build / update / remove a teammate's see-through team outline + overhead chevron.
function updateTeamMarker(rp) {
  const wantTeam = (gameMode === 'tdm' && rp.team) ? rp.team : null;
  const friendly = wantTeam && myTeam && wantTeam === myTeam;
  if (!wantTeam) { if (rp._teamOutline) { rp.avatar.remove(rp._teamOutline); rp._teamOutline = null; } if (rp._teamChevron) { rp._teamChevron.visible = false; } return; }
  const col = TEAMS[wantTeam].color;
  // Overhead team chevron (always visible — through walls — for teammates; LOS-gated for enemies in drawNameSprite).
  if (!rp._teamChevron) {
    const cv = document.createElement('canvas'); cv.width = cv.height = 64; const cx = cv.getContext('2d');
    cx.fillStyle = '#fff'; cx.beginPath(); cx.moveTo(32, 52); cx.lineTo(10, 14); cx.lineTo(54, 14); cx.closePath(); cx.fill();
    const tex = new THREE.CanvasTexture(cv);
    const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, depthTest: false, transparent: true }));
    spr.scale.set(0.5, 0.5, 1); spr.position.set(0, 3.05, 0); rp.avatar.add(spr); rp._teamChevron = spr;
  }
  rp._teamChevron.material.color.setHex(col);
  rp._teamChevron.visible = !!friendly;     // friendlies always show the chevron (through walls)
  // See-through colored silhouette outline for teammates only.
  if (friendly && !rp._teamOutline) {
    const g = new THREE.Group();
    const om = new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.22, depthTest: false, side: THREE.BackSide });
    buildCharacterModel(om, (geo, material, x, y, z) => { const m = new THREE.Mesh(geo, material); m.position.set(x, y, z); m.scale.setScalar(1.08); g.add(m); return m; });
    g.renderOrder = 999; rp.avatar.add(g); rp._teamOutline = g;
  } else if (!friendly && rp._teamOutline) { rp.avatar.remove(rp._teamOutline); disposeGroup(rp._teamOutline); rp._teamOutline = null; }
}

// --- Menu / lobby button wiring ---
const savedName = () => (localStorage.getItem('blockoutName') || '').slice(0, 14);
function readName() {
  const n = (el('nameInput').value || '').trim().slice(0, 14) || ('Player' + ((Math.random() * 900 + 100) | 0));
  localStorage.setItem('blockoutName', n);
  return n;
}
el('nameInput').value = savedName();

el('menuSolo').onclick = () => { showScreen('startScreen'); };
el('menuHost').onclick = () => { NET.host(readName()); };
el('menuJoin').onclick = () => { setNetStatus('joinStatus', ''); showScreen('joinScreen'); el('codeInput').focus(); };
el('joinBack').onclick = () => { NET.reset(); showScreen('mainMenu'); };
el('joinGo').onclick = () => {
  const code = (el('codeInput').value || '').trim().toUpperCase();
  if (code.length < 4) { setNetStatus('joinStatus', 'Enter the 5-letter code.', true); return; }
  NET.join(readName(), code);
};
el('codeInput').addEventListener('keydown', e => { if (e.key === 'Enter') el('joinGo').click(); });
el('lobbyStart').onclick = () => { if (gameMode === 'tdm') showTeamSelect('host'); else hostStartMatch(); };   // host (TDM → team select first)
el('lobbyLeave').onclick = () => leaveToMenu();
el('lobbyCode').onclick = () => {
  if (NET.code && navigator.clipboard) { navigator.clipboard.writeText(NET.code); setNetStatus('lobbyStatus', 'Code copied!'); }
};
el('soloBack').onclick = () => showScreen('mainMenu');

// --- Game-mode picker (lobby + solo) ---
function refreshModeUI() {
  ['lobbyModePick', 'soloModePick'].forEach(pid => {
    const wrap = el(pid); if (!wrap) return;
    [...wrap.children].forEach(b => b.classList.toggle('selected', b.dataset.mode === gameMode));
  });
  const clientLocked = NET.active && NET.isClient;     // only host/solo choose the mode
  if (el('lobbyModePick')) el('lobbyModePick').classList.toggle('locked', clientLocked);
  if (el('lobbyModeHostNote')) el('lobbyModeHostNote').textContent = clientLocked ? '(set by host)' : '';
}
function setGameMode(mode) {
  if (!['ffa', 'gungame', 'tdm', 'br'].includes(mode)) return;
  if (NET.active && NET.isClient) return;
  gameMode = mode; localStorage.setItem('blockoutMode', mode);
  refreshModeUI(); renderMatchPane(); updateLobbySettingsSummary();
  if (NET.isHost) NET.broadcastRoster();               // sync the mode to lobby clients
}
['lobbyModePick', 'soloModePick'].forEach(pid => {
  const wrap = el(pid); if (!wrap) return;
  [...wrap.children].forEach(b => { b.onclick = () => setGameMode(b.dataset.mode); });
});
// (refreshModeUI runs lazily via showScreen — NET isn't defined yet at load time)

/* ============================================================================
   PART 6 — MATCH SETTINGS UI: per-mode option groups (host-editable, client read-only),
   synced to clients on change, locked during a match, summarized in the lobby + intro banner.
   ============================================================================ */
const MATCH_OPTS = {
  ffa: [['FREE-FOR-ALL', null],
        ['ffaKills', 'Kill limit', [15, 25, 30, 40, 50, 75, 100]],
        ['ffaTime', 'Time limit (min)', [5, 10, 15, 20, 0], v => v ? v : 'None']],
  gungame: [['GUN GAME', null],
        ['ggTime', 'Time limit (min)', [10, 15, 20, 30, 0], v => v ? v : 'None']],
  tdm: [['TEAM DEATHMATCH', null],
        ['tdmKills', 'Team kill limit', [30, 50, 75, 100, 150]],
        ['tdmTime', 'Time limit (min)', [5, 10, 15, 20]],
        ['friendlyFire', 'Friendly fire', [false, true], v => v ? 'ON' : 'OFF']],
  br: [['BATTLE ROYALE', null]],   // 10 players, last alive — full zone/loot settings land in the mechanics pass
  shared: [['SHARED', null],
        ['respawnDelay', 'Respawn delay (s)', [1, 2, 3, 5]],
        ['forceLoadout', 'Starting loadout', [false, true], v => v ? 'Preset' : 'Saved'],
        ['dayNight', 'Day / night', ['on', 'off', 'day', 'night'], v => ({ on: 'Cycle', off: 'Freeze', day: 'Day', night: 'Night' }[v])],
        ['allowKong', 'King Kong', [true, false], v => v ? 'On' : 'Off'],
        ['allowMckayla', 'Mckayla', [true, false], v => v ? 'On' : 'Off'],
        ['allowStreaks', 'Scorestreaks', [true, false], v => v ? 'On' : 'Off']]
};
function matchSettingsEditable() { return !gameState.running && (!NET.active || NET.isHost); }   // host/solo, only between matches
function setMatchOpt(key, val) {
  if (!matchSettingsEditable()) return;
  MATCH[key] = val; MATCH.save();
  renderMatchPane(); updateLobbySettingsSummary();
  if (NET.active && NET.isHost) NET.broadcast({ t: 'matchcfg', cfg: MATCH.payload() });
  sfxClick();
}
function renderMatchPane() {
  const list = el('matchOptList'); if (!list) return;
  const editable = matchSettingsEditable();
  list.classList.toggle('locked', !editable);
  const note = el('matchHostNote');
  if (note) note.innerHTML = (NET.active && NET.isClient) ? '🔒 Match settings are controlled by the <b>host</b>.'
    : (gameState.running ? '🔒 Settings are locked while a match is in progress.' : 'Adjust the rules for the next match.');
  const mn = el('matchModeName'); if (mn) mn.textContent = ({ ffa: 'FREE-FOR-ALL', gungame: 'GUN GAME', tdm: 'TEAM DEATHMATCH', br: 'BATTLE ROYALE' }[gameMode] || gameMode);
  const groups = (MATCH_OPTS[gameMode] || MATCH_OPTS.ffa).concat(MATCH_OPTS.shared);
  let html = '';
  for (const row of groups) {
    if (row[1] === null) { html += `<div class="moCat">${row[0]}</div>`; continue; }
    const [key, label, opts, fmt] = row;
    const btns = opts.map(o => {
      const sel = MATCH[key] === o ? ' sel' : '';
      const lbl = fmt ? fmt(o) : o;
      return `<button class="moOpt${sel}" data-key="${key}" data-val="${typeof o}:${o}">${lbl}</button>`;
    }).join('');
    html += `<div class="moRow"><span class="moName">${label}</span><span class="moOpts">${btns}</span></div>`;
  }
  list.innerHTML = html;
  list.querySelectorAll('.moOpt').forEach(b => b.onclick = () => {
    const [type, raw] = b.dataset.val.split(/:(.*)/s);
    const val = type === 'number' ? parseFloat(raw) : type === 'boolean' ? (raw === 'true') : raw;
    setMatchOpt(b.dataset.key, val);
  });
}
function matchSettingsSummary() {
  const parts = [];
  if (gameMode === 'tdm') { parts.push('TEAM DEATHMATCH'); parts.push(MATCH.tdmKills + ' kills'); if (MATCH.tdmTime) parts.push(MATCH.tdmTime + ' min'); parts.push('FF ' + (MATCH.friendlyFire ? 'ON' : 'OFF')); }
  else if (gameMode === 'gungame') { parts.push('GUN GAME'); parts.push('20 levels'); if (MATCH.ggTime) parts.push(MATCH.ggTime + ' min'); }
  else { parts.push('FREE-FOR-ALL'); parts.push(MATCH.ffaKills + ' kills'); if (MATCH.ffaTime) parts.push(MATCH.ffaTime + ' min'); }
  return parts.join('  •  ');
}
function updateLobbySettingsSummary() { const e = el('lobbySettingsSummary'); if (e) e.textContent = matchSettingsSummary(); }

// --- Settings screen ---
let settingsReturn = 'mainMenu';
function refreshSettingsUI() {
  el('botCountVal').textContent = botCount;
  el('throwGrenadeBtn').classList.toggle('selected', throwableType === 'grenade');
  el('throwTomahawkBtn').classList.toggle('selected', throwableType === 'tomahawk');
}
function openSettings(from) { settingsReturn = from; refreshSettingsUI(); renderMatchPane(); if (window._refreshAudioSettings) window._refreshAudioSettings(); if (window._renderControls) { window._renderControls(); window._refreshControlOpts(); } setSettingsTab('paneControls'); showScreen('settingsScreen'); }
el('menuSettings').onclick = () => openSettings('mainMenu');
el('lobbySettings').onclick = () => openSettings('lobbyScreen');
el('settingsBack').onclick = () => {
  refreshKeyHints();   // re-stamp all in-game keybind hints with any rebinds the player just made
  if (settingsReturn === 'pause') { el('settingsScreen').classList.add('hidden'); el('pauseMenu').style.display = 'flex'; }   // back to the in-match pause menu
  else showScreen(settingsReturn);
};
// Settings tab switching. During a Battle Royale match, gear-affecting tabs (WEAPONS customization,
// MATCH settings) are locked — controls/sensitivity/audio/controller/gameplay stay fully editable (Part 2).
const BR_LOCKED_TABS = { paneWeaponCustom: 'Weapon customization', paneMatch: 'Match settings' };
function brTabLocked(paneId) { return BR.active && gameState.running && !!BR_LOCKED_TABS[paneId]; }
function brMarkLockedTabs() {
  const on = BR.active && gameState.running;
  document.querySelectorAll('#settingsScreen .setTab').forEach(t => {
    const lock = on && BR_LOCKED_TABS[t.dataset.pane];
    t.style.opacity = lock ? '0.5' : ''; t.dataset.lock = lock ? '1' : '';
    const base = t.textContent.replace(/^🔒\s*/, '');
    t.textContent = lock ? '🔒 ' + base : base;
  });
}
function setSettingsTab(paneId) {
  brMarkLockedTabs();
  if (brTabLocked(paneId)) {   // clicking a locked tab → explain, don't switch
    const lm = el('setLockMsg'); if (lm) { lm.textContent = '🔒 ' + BR_LOCKED_TABS[paneId] + ' cannot be changed during a Battle Royale match. Set this before joining a BR lobby.'; lm.style.display = 'block'; clearTimeout(lm._t); lm._t = setTimeout(() => { lm.style.display = 'none'; }, 4500); }
    if (typeof sfxClick === 'function') sfxClick(); return;
  }
  const lm = el('setLockMsg'); if (lm) lm.style.display = 'none';
  document.querySelectorAll('#settingsScreen .setTab').forEach(t => t.classList.toggle('active', t.dataset.pane === paneId));
  document.querySelectorAll('#settingsScreen .setPane').forEach(p => p.classList.toggle('active', p.id === paneId));
  if (paneId === 'paneMatch') renderMatchPane();   // refresh editability + selections each time it's opened
  if (paneId === 'paneWeaponCustom') renderWeaponGrid();
  if (paneId === 'paneController') { refreshGpStatus(); if (window._renderGpBinds) window._renderGpBinds(); if (window._refreshGpOpts) window._refreshGpOpts(); }
}
document.querySelectorAll('#settingsScreen .setTab').forEach(tab => tab.onclick = () => { setSettingsTab(tab.dataset.pane); sfxClick(); });
// Pause-menu buttons.
el('pauseResume').onclick = () => resumeGame();
el('pauseSettings').onclick = () => { el('pauseMenu').style.display = 'none'; openSettings('pause'); };
el('pauseLeave').onclick = () => { paused = false; el('pauseMenu').style.display = 'none'; leaveToMenu(); };
el('pauseTeamSwitch').onclick = () => {
  const ok = requestTeamSwitch();
  el('pauseTeamSwitch').textContent = ok ? 'REQUESTED…' : 'TEAMS WOULD UNBALANCE';
  if (ok) setTimeout(resumeGame, 350);
};

/* --- CONTROLS tab: rebindable keybindings + control options (autosaved to localStorage) --- */
(function setupControlsUI() {
  let rebindAction = null, pendingConflict = null;
  const labelFor = (a) => { const r = IM.ROWS.find(x => x[0] === a); return r ? r[1] : a; };
  function hideConflict() { pendingConflict = null; const cc = el('ctrlConflict'); cc.style.display = 'none'; cc.innerHTML = ''; }
  function cancelRebind() { rebindAction = null; hideConflict(); renderControls(); }
  function renderControls() {
    const list = el('ctrlList'); list.innerHTML = '';
    IM.ROWS.forEach(([a, label, note]) => {
      if (label === null) { const h = document.createElement('div'); h.className = 'ctrlCat'; h.textContent = a; list.appendChild(h); return; }
      const row = document.createElement('div'); row.className = 'ctrlRow';
      row.innerHTML = `<span class="cName">${label}${note ? ' <span class="cNote">(' + note + ')</span>' : ''}</span>`;
      const kb = document.createElement('div'); kb.className = 'ctrlKey'; kb.dataset.action = a;
      const code = IM.bind[a];
      if (rebindAction === a) { kb.textContent = 'Press any key…'; kb.classList.add('rebinding'); }
      else { kb.textContent = IM.keyLabel(code); if (!code) kb.classList.add('unbound'); }
      kb.onclick = () => { if (!pendingConflict) { rebindAction = a; renderControls(); } };
      row.appendChild(kb); list.appendChild(row);
    });
  }
  function applyBind(action, code) { IM.bind[action] = code; IM.save(); rebindAction = null; hideConflict(); renderControls(); refreshKeyHints(); sfxClick(); }
  function tryBind(action, code) {
    const owner = IM.codeAction(code);
    if (owner === action) { applyBind(action, code); return; }
    if (owner && IM.CRITICAL.indexOf(owner) !== -1) {   // movement keys can't be unbound (so can't be stolen)
      pendingConflict = {}; const cc = el('ctrlConflict'); cc.style.display = 'block';
      cc.textContent = `${IM.keyLabel(code)} is bound to "${labelFor(owner)}", which cannot be unbound.`;
      sfxNotify(); setTimeout(cancelRebind, 1700); return;
    }
    if (owner) {   // conflict with a non-critical action: ask to replace
      pendingConflict = { action, code, oldAction: owner }; rebindAction = null; renderControls();
      const cc = el('ctrlConflict'); cc.style.display = 'block';
      cc.innerHTML = `<b>${IM.keyLabel(code)}</b> is already bound to <b>${labelFor(owner)}</b>. Replace? `;
      const mk = (t, fn) => { const b = document.createElement('button'); b.className = 'smallbtn'; b.textContent = t; b.onclick = fn; return b; };
      cc.appendChild(mk('YES', () => { IM.bind[owner] = ''; applyBind(action, code); }));   // old action becomes unbound (red)
      cc.appendChild(mk('NO', cancelRebind));
      sfxNotify(); return;
    }
    applyBind(action, code);
  }
  // Capture the next input while rebinding (capture phase + stopPropagation so gameplay never sees it).
  window.addEventListener('keydown', (e) => {
    if (!rebindAction || pendingConflict) return;
    e.preventDefault(); e.stopPropagation();
    if (e.code === 'Escape') { cancelRebind(); return; }   // ESC cancels rebind
    tryBind(rebindAction, e.code);
  }, true);
  window.addEventListener('mousedown', (e) => {
    if (!rebindAction || pendingConflict) return;
    if (e.target.closest && e.target.closest('.ctrlKey, button, select, input')) return;   // UI clicks don't bind
    e.preventDefault(); e.stopPropagation();
    tryBind(rebindAction, ({ 0: 'Mouse0', 1: 'Mouse1', 2: 'Mouse2' })[e.button] || 'Mouse0');
  }, true);
  window.addEventListener('wheel', (e) => {
    if (!rebindAction || pendingConflict) return;
    e.preventDefault(); e.stopPropagation();
    tryBind(rebindAction, e.deltaY < 0 ? 'WheelUp' : 'WheelDown');
  }, { capture: true, passive: false });
  el('ctrlReset').onclick = () => { IM.resetDefault(); cancelRebind(); renderControls(); sfxClick(); };
  el('ctrlSavePreset').onclick = () => { IM.saveCustom(); el('ctrlPreset').value = 'custom'; sfxClick(); };
  el('ctrlPreset').onchange = () => { IM.loadPreset(el('ctrlPreset').value); cancelRebind(); renderControls(); sfxClick(); };

  // --- Control OPTIONS (sensitivity / FOV / invert-Y / toggles / auto-reload / hit markers) ---
  function refreshControlOpts() {
    el('optSens').value = Math.round(OPT.sens * 100); el('optSensV').textContent = OPT.sens.toFixed(1) + 'x';
    el('optSensAds').value = Math.round(OPT.sensAds * 100); el('optSensAdsV').textContent = OPT.sensAds.toFixed(1) + 'x';
    el('optSensScope').value = Math.round(OPT.sensScope * 100); el('optSensScopeV').textContent = OPT.sensScope.toFixed(1) + 'x';
    el('optFov').value = OPT.fov; el('optFovV').textContent = OPT.fov;
    el('optInvertY').checked = OPT.invertY; el('optAdsToggle').checked = OPT.adsToggle; el('optSprintToggle').checked = OPT.sprintToggle;
    el('optAutoReload').checked = OPT.autoReload; el('optHitMarkers').checked = OPT.hitMarkers;
    if (el('optDmgNumbers')) el('optDmgNumbers').checked = OPT.dmgNumbers;
    if (el('optCtrlHints')) el('optCtrlHints').checked = OPT.ctrlHints;
  }
  el('optSens').addEventListener('input', () => { OPT.sens = Math.max(0.1, Math.min(5, el('optSens').value / 100)); el('optSensV').textContent = OPT.sens.toFixed(1) + 'x'; OPT.save(); });
  el('optSensAds').addEventListener('input', () => { OPT.sensAds = Math.max(0.1, Math.min(2, el('optSensAds').value / 100)); el('optSensAdsV').textContent = OPT.sensAds.toFixed(1) + 'x'; OPT.save(); });
  el('optSensScope').addEventListener('input', () => { OPT.sensScope = Math.max(0.1, Math.min(2, el('optSensScope').value / 100)); el('optSensScopeV').textContent = OPT.sensScope.toFixed(1) + 'x'; OPT.save(); });
  el('optFov').addEventListener('input', () => { OPT.fov = Math.max(60, Math.min(120, parseInt(el('optFov').value, 10) || 78)); el('optFovV').textContent = OPT.fov; DEFAULT_FOV = OPT.fov; if (!aiming) { camera.fov = DEFAULT_FOV; camera.updateProjectionMatrix(); } OPT.save(); });
  const tog = (id, key) => el(id).addEventListener('change', () => { OPT[key] = el(id).checked; if (key === 'sprintToggle') sprintLatch = false; OPT.save(); sfxClick(); });
  tog('optInvertY', 'invertY'); tog('optAdsToggle', 'adsToggle'); tog('optSprintToggle', 'sprintToggle'); tog('optAutoReload', 'autoReload'); tog('optHitMarkers', 'hitMarkers'); tog('optDmgNumbers', 'dmgNumbers'); tog('optCtrlHints', 'ctrlHints');

  window._renderControls = renderControls; window._refreshControlOpts = refreshControlOpts;
  renderControls(); refreshControlOpts();
})();

/* --- GAMEPAD: connection toast, first-time tutorial overlay, and the Controller settings tab --- */
let _gpToastT = null;
function gpToast(msg) { const t = el('gpToast'); if (!t) return; t.textContent = msg; t.classList.add('on'); clearTimeout(_gpToastT); _gpToastT = setTimeout(() => t.classList.remove('on'), 3000); }
let _gpTutT = null;
function gpTutorialOpen() { const t = el('gpTutorial'); return !!(t && t.classList.contains('on')); }
function showGpTutorial() { const t = el('gpTutorial'); if (!t) return; t.classList.add('on'); clearTimeout(_gpTutT); _gpTutT = setTimeout(hideGpTutorial, 8000); }
function hideGpTutorial() { const t = el('gpTutorial'); if (t) t.classList.remove('on'); clearTimeout(_gpTutT); }
function maybeShowGpTutorial() {   // first controller connection only (re-viewable from Controller settings)
  let seen = false; try { seen = localStorage.getItem('gpTutorialSeen') === '1'; } catch (e) {}
  if (seen) return; try { localStorage.setItem('gpTutorialSeen', '1'); } catch (e) {}
  showGpTutorial();
}
window.addEventListener('mousedown', () => { if (gpTutorialOpen()) hideGpTutorial(); });
window.addEventListener('keydown', () => { if (gpTutorialOpen()) hideGpTutorial(); });
function gpApplyBind(action, btn) {   // bind + clear any other action holding that button (-1 = unbound)
  for (const a in GP.bind) if (GP.bind[a] === btn && a !== action) GP.bind[a] = -1;
  GP.bind[action] = btn; GP.rebindAction = null; GP.save();
  if (window._renderGpBinds) window._renderGpBinds();
  refreshKeyHints(); if (typeof updateStreakHUD === 'function') updateStreakHUD(); sfxClick();
}
function refreshGpStatus() {
  const box = el('gpStatusBox'); if (!box) return;
  const names = Object.keys(GP.pads).map(k => (GP.pads[k].name || 'Controller').replace(/\s*\([^)]*\)\s*/g, '').trim()).filter(Boolean);
  if (!names.length) { box.innerHTML = '<span class="gpOff">●</span> No controller detected — connect an Xbox / PlayStation controller via USB or Bluetooth.'; return; }
  box.innerHTML = '<span class="gpOn">●</span> ' + names.map(n => '<b>' + n + '</b>').join(', ')
    + ' &nbsp;·&nbsp; type: ' + (GP.type === 'ps' ? 'PlayStation' : 'Xbox / Standard')
    + ' &nbsp;·&nbsp; input mode: <b>' + (GP.active ? 'GAMEPAD' : 'keyboard') + '</b>';
}
(function setupControllerUI() {
  const GP_ROWS = [
    ['fire', 'Fire / Attack'], ['ads', 'Aim Down Sights / Block'], ['jump', 'Jump'], ['crouch', 'Crouch / Dive'],
    ['reload', 'Reload'], ['karambit', 'Swap to Melee'], ['quickMelee', 'Inspect Weapon (R3)'], ['sprint', 'Sprint'],
    ['grenade', 'Throw Impulse'], ['lethal', 'Throw Lethal'], ['use', 'Cigar / Drink JD'], ['interact', 'Interact / Climb'],
    ['weapon1', 'Weapon Slot 1'], ['weapon2', 'Weapon Slot 2'], ['scoreboard', 'Scoreboard / Inventory (hold)'], ['pause', 'Pause / Menu']
  ];
  function renderGpBinds() {
    const list = el('gpBindList'); if (!list) return; list.innerHTML = '';
    GP_ROWS.forEach(([a, label]) => {
      const row = document.createElement('div'); row.className = 'ctrlRow';
      row.innerHTML = `<span class="cName">${label}</span>`;
      const kb = document.createElement('div'); kb.className = 'ctrlKey'; kb.dataset.action = a;
      if (GP.rebindAction === a) { kb.textContent = 'Press any button…'; kb.classList.add('rebinding'); }
      else { kb.textContent = GP.gpIcon(a); if (GP.bind[a] == null || GP.bind[a] < 0) kb.classList.add('unbound'); }
      kb.onclick = () => { GP.rebindAction = (GP.rebindAction === a ? null : a); renderGpBinds(); };
      row.appendChild(kb); list.appendChild(row);
    });
    // a fixed-combos hint (sticks / triggers / scorestreaks aren't remappable)
    const note = document.createElement('div'); note.className = 'cNote'; note.style.cssText = 'opacity:.6;font-size:12px;margin-top:8px;line-height:1.5';
    note.innerHTML = 'Sticks (move / look) &amp; triggers (LT/RT) are fixed. Scorestreaks = <b>LT + DPad</b>, King Kong = <b>LB + RB</b>.';
    list.appendChild(note);
  }
  function refreshGpOpts() {
    const setv = (id, v) => { const e = el(id); if (e) e.value = v; }, sett = (id, t) => { const e = el(id); if (e) e.textContent = t; };
    setv('gpDzL', Math.round(GP.dzL * 100)); sett('gpDzLV', Math.round(GP.dzL * 100) + '%');
    setv('gpDzR', Math.round(GP.dzR * 100)); sett('gpDzRV', Math.round(GP.dzR * 100) + '%');
    setv('gpSensH', Math.round(GP.sensH * 100)); sett('gpSensHV', GP.sensH.toFixed(1) + 'x');
    setv('gpSensV', Math.round(GP.sensV * 100)); sett('gpSensVV', GP.sensV.toFixed(1) + 'x');
    setv('gpSensAds', Math.round(GP.sensAds * 100)); sett('gpSensAdsV', GP.sensAds.toFixed(1) + 'x');
    setv('gpAimStr', Math.round(GP.aimStr * 100)); sett('gpAimStrV', Math.round(GP.aimStr * 100) + '%');
    setv('gpRumbleInt', Math.round(GP.rumbleInt * 100)); sett('gpRumbleIntV', Math.round(GP.rumbleInt * 100) + '%');
    const ck = (id, v) => { const e = el(id); if (e) e.checked = v; };
    ck('gpAimAssist', GP.aimAssist); ck('gpCurve', GP.curve === 'exp'); ck('gpRumble', GP.rumbleOn); ck('gpInvertY', GP.invertY);
  }
  const rng = (id, vid, fn, fmt) => { const e = el(id); if (e) e.addEventListener('input', () => { fn(parseInt(e.value, 10)); el(vid).textContent = fmt(); GP.save(); }); };
  rng('gpDzL', 'gpDzLV', v => GP.dzL = v / 100, () => Math.round(GP.dzL * 100) + '%');
  rng('gpDzR', 'gpDzRV', v => GP.dzR = v / 100, () => Math.round(GP.dzR * 100) + '%');
  rng('gpSensH', 'gpSensHV', v => GP.sensH = Math.max(0.1, Math.min(5, v / 100)), () => GP.sensH.toFixed(1) + 'x');
  rng('gpSensV', 'gpSensVV', v => GP.sensV = Math.max(0.1, Math.min(5, v / 100)), () => GP.sensV.toFixed(1) + 'x');
  rng('gpSensAds', 'gpSensAdsV', v => GP.sensAds = Math.max(0.1, Math.min(2, v / 100)), () => GP.sensAds.toFixed(1) + 'x');
  rng('gpAimStr', 'gpAimStrV', v => GP.aimStr = Math.max(0, Math.min(1, v / 100)), () => Math.round(GP.aimStr * 100) + '%');
  rng('gpRumbleInt', 'gpRumbleIntV', v => GP.rumbleInt = Math.max(0, Math.min(1, v / 100)), () => Math.round(GP.rumbleInt * 100) + '%');
  const chk = (id, fn) => { const e = el(id); if (e) e.addEventListener('change', () => { fn(e.checked); GP.save(); sfxClick(); }); };
  chk('gpAimAssist', v => GP.aimAssist = v); chk('gpCurve', v => GP.curve = v ? 'exp' : 'lin'); chk('gpRumble', v => { GP.rumbleOn = v; if (v) GP.rumble(0.4, 0.4, 150); }); chk('gpInvertY', v => GP.invertY = v);
  if (el('gpReset')) el('gpReset').onclick = () => { GP.resetBind(); renderGpBinds(); refreshKeyHints(); sfxClick(); };
  if (el('gpViewTut')) el('gpViewTut').onclick = () => { showGpTutorial(); sfxClick(); };
  window._renderGpBinds = renderGpBinds; window._refreshGpOpts = refreshGpOpts;
  renderGpBinds(); refreshGpOpts();
})();

/* ============================================================================
   GPUI (Part 2) — UNIVERSAL CONTROLLER UI NAVIGATION. While ANY menu/overlay is open and the player
   is in gamepad mode, the DPad / left stick move a focus highlight between buttons/cards/sliders/tabs;
   A = select, B = back, LB/RB = switch tabs, left/right on a slider adjusts it, Y = context (customize).
   A bottom hint bar shows the mappings; text fields open an on-screen keyboard. The mouse still works —
   moving it hides the highlight, and any controller input brings it back.
   ============================================================================ */
let _vkTarget = null, _vkVal = '';
function vkBuild() {
  const c = el('vkRows'); if (!c || c.childElementCount) return;   // build once
  ['1234567890', 'QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM'].forEach(r => { const d = document.createElement('div'); d.className = 'vkRow';
    [...r].forEach(ch => { const b = document.createElement('button'); b.className = 'vkKey'; b.textContent = ch; b.onclick = () => vkType(ch); d.appendChild(b); }); c.appendChild(d); });
  const last = document.createElement('div'); last.className = 'vkRow';
  const mk = (cls, txt, fn) => { const b = document.createElement('button'); b.className = 'vkKey ' + cls; b.textContent = txt; b.onclick = fn; return b; };
  last.appendChild(mk('del', '⌫', () => vkType('\b'))); last.appendChild(mk('wide', 'SPACE', () => vkType(' '))); last.appendChild(mk('wide go', 'DONE', () => vkClose())); c.appendChild(last);
}
function vkOpen(input) { _vkTarget = input; _vkVal = input.value || ''; vkBuild(); el('vkPreview').textContent = _vkVal || ' '; el('vk').classList.add('on'); GPUI._screen = null; }
function vkType(ch) { if (ch === '\b') _vkVal = _vkVal.slice(0, -1); else if (_vkVal.length < 16) _vkVal += ch; el('vkPreview').textContent = _vkVal || ' '; if (_vkTarget) { _vkTarget.value = _vkVal; _vkTarget.dispatchEvent(new Event('input', { bubbles: true })); } }
function vkClose() { if (_vkTarget) { _vkTarget.value = _vkVal; _vkTarget.dispatchEvent(new Event('input', { bubbles: true })); _vkTarget.dispatchEvent(new Event('change', { bubbles: true })); } el('vk').classList.remove('on'); _vkTarget = null; GPUI._screen = null; }

const GPUI = {
  _screen: null, els: [], idx: -1, shown: false, navCd: 0, mouseActive: false, _aB: false, _bB: false, _yB: false, _lbB: false, _rbB: false,
  SCREENS: ['vk', 'fullControls', 'weaponCustom', 'skinCreator', 'invMenu', 'settingsScreen', 'resultsScreen', 'endScreen', 'teamSelect', 'pauseMenu', 'lobbyScreen', 'startScreen', 'joinScreen', 'mainMenu'],
  vis(e) { if (!e) return false; if (e.classList && e.classList.contains('hidden')) return false; const cs = getComputedStyle(e); return cs.display !== 'none' && cs.visibility !== 'hidden' && e.offsetWidth > 0 && e.offsetHeight > 0; },
  activeScreen() { for (const id of this.SCREENS) { const e = el(id); if (this.vis(e)) return e; } return null; },
  menuOpen() { return GP.active ? this.activeScreen() : null; },
  collect(screen) {
    this.els = [...screen.querySelectorAll('button, input, select, .invCard, .wcOpt, .wcCat, .skGalThumb, .skTool')].filter(e => this.vis(e) && !e.disabled);
    if (this.idx >= this.els.length) this.idx = this.els.length - 1; if (this.idx < 0 && this.els.length) this.idx = 0;
  },
  cur() { return this.els[this.idx] || null; },
  rect(e) { const r = e.getBoundingClientRect(); return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 }; },
  highlight() { this.els.forEach((e, i) => e.classList.toggle('gpfocus', i === this.idx && this.shown && !this.mouseActive)); const c = this.cur(); if (c && this.shown && !this.mouseActive && c.scrollIntoView) { try { c.scrollIntoView({ block: 'nearest' }); } catch (e) {} } },
  hide() { this.els.forEach(e => e.classList.remove('gpfocus')); this.shown = false; const h = el('gpHintBar'); if (h) h.classList.remove('on'); },
  move(dx, dy) {
    if (!this.els.length) return;
    if (this.idx < 0 || !this.cur()) { this.idx = 0; this.highlight(); return; }
    const c = this.rect(this.cur()); let best = -1, bestScore = Infinity;
    for (let i = 0; i < this.els.length; i++) { if (i === this.idx) continue; const t = this.rect(this.els[i]);
      const ddx = t.cx - c.cx, ddy = t.cy - c.cy, along = ddx * dx + ddy * dy; if (along <= 4) continue;
      const perp = Math.abs(ddx * dy - ddy * dx), score = along + perp * 2.2; if (score < bestScore) { bestScore = score; best = i; } }
    if (best >= 0) { this.idx = best; this.highlight(); if (typeof sfxClick === 'function') sfxClick(); }
  },
  activate() {
    const e = this.cur(); if (!e) return;
    const tag = e.tagName, ty = (e.type || '').toLowerCase();
    if (tag === 'INPUT' && ty === 'range') return;                          // sliders use left/right, not A
    if (tag === 'INPUT' && (ty === 'text' || ty === 'search' || ty === 'number' || ty === '')) { vkOpen(e); return; }   // text field → on-screen keyboard
    if (tag === 'SELECT') { e.selectedIndex = (e.selectedIndex + 1) % e.options.length; e.dispatchEvent(new Event('change', { bubbles: true })); return; }
    e.click();   // buttons, checkboxes, cards, tabs, tool buttons
  },
  yAction() { const e = this.cur(); if (e && e.classList && e.classList.contains('invCard')) { const b = e.querySelector('.wcBtn'); if (b) b.click(); } },
  back(screen) {
    const id = screen.id;
    if (id === 'vk') { vkClose(); return; }
    if (id === 'pauseMenu') { resumeGame(); return; }
    if (id === 'settingsScreen') { const b = el('settingsBack'); if (b) b.click(); return; }
    if (id === 'invMenu') { if (typeof toggleInventory === 'function') toggleInventory(); return; }
    if (id === 'fullControls') { toggleFullControls(false); return; }
    if (id === 'teamSelect') { const b = el('tsBack'); if (b && b.style.display !== 'none') b.click(); return; }
    if (id === 'weaponCustom') { const b = el('wcClose'); if (b) b.click(); return; }
    const b = [...screen.querySelectorAll('button')].find(x => /back|cancel|close|done|resume|lobby/i.test(x.textContent || '') && this.vis(x)); if (b) b.click();
  },
  tab(dir) {
    const screen = this._screen; if (!screen) return;
    const tabs = [...screen.querySelectorAll('.setTab, .invTab')].filter(t => this.vis(t)); if (!tabs.length) return;
    let a = tabs.findIndex(t => t.classList.contains('active')); if (a < 0) a = 0;
    const n = (a + (dir > 0 ? 1 : -1) + tabs.length) % tabs.length; tabs[n].click(); this.idx = 0; setTimeout(() => { this.collect(this._screen); this.highlight(); }, 0);
  },
  hint(screen) {
    const ps = GP.type === 'ps', A = ps ? '✕' : 'Ⓐ', B = ps ? '○' : 'Ⓑ', Y = ps ? '△' : 'Ⓨ', LR = ps ? 'L1/R1' : 'LB/RB';
    let s = '<span><b>' + A + '</b>Select</span><span><b>' + B + '</b>Back</span><span><b>✛</b>Navigate</span>';
    if (screen.querySelector('.setTab, .invTab')) s += '<span><b>' + LR + '</b>Switch Tabs</span>';
    const c = this.cur(); if (c && c.tagName === 'INPUT' && c.type === 'range') s = '<span><b>◄ ►</b>Adjust</span>' + s;
    if (c && c.classList && c.classList.contains('invCard')) s += '<span><b>' + Y + '</b>Customize</span>';
    const h = el('gpHintBar'); if (h) { h.innerHTML = s; h.classList.add('on'); }
  },
  poll(dt, just, pressed, val, lx, ly) {
    const screen = this.activeScreen(); if (!screen) { this.hide(); this._screen = null; return; }
    const B = GP.bind;
    // any controller input this frame cancels the mouse takeover
    const navUp = just(B.use) || ly < -0.55, navDown = just(B.interact) || ly > 0.55, navLeft = just(B.weapon1) || lx < -0.55, navRight = just(B.weapon2) || lx > 0.55;
    const aPress = just(B.jump), bPress = just(B.crouch), yPress = just(B.karambit), lbPress = just(B.grenade), rbPress = just(B.lethal), startPress = just(B.pause);
    const anyInput = navUp || navDown || navLeft || navRight || aPress || bPress || yPress || lbPress || rbPress || startPress;
    if (anyInput) this.mouseActive = false;
    if (screen !== this._screen) { this._screen = screen; this.collect(screen); if (this.idx < 0 && this.els.length) this.idx = 0; this.shown = true; }
    else this.collect(screen);   // re-collect (lists/cards can change) — cheap
    if (this.mouseActive) { this.hide(); return; }
    this.shown = true;
    // navigation (DPad = discrete; stick = cooldown-repeat)
    this.navCd -= dt; const stickNav = (Math.abs(lx) > 0.55 || Math.abs(ly) > 0.55);
    const cur = this.cur(), onSlider = cur && cur.tagName === 'INPUT' && cur.type === 'range';
    if (navUp || navDown || navLeft || navRight) {
      if (!stickNav || this.navCd <= 0) {
        this.navCd = 0.16;
        if (onSlider && (navLeft || navRight)) { const step = (parseFloat(cur.step) || 1) * (navRight ? 1 : -1); cur.value = Math.max(+cur.min, Math.min(+cur.max, (parseFloat(cur.value) || 0) + step)); cur.dispatchEvent(new Event('input', { bubbles: true })); }
        else if (navUp) this.move(0, -1); else if (navDown) this.move(0, 1); else if (navLeft) this.move(-1, 0); else if (navRight) this.move(1, 0);
      }
    } else this.navCd = 0;
    // LT/RT quick slider nudge
    if (onSlider) { const lt = val(B.ads) > 0.6, rt = val(B.fire) > 0.6; if ((lt || rt) && this.navCd <= 0) { this.navCd = 0.05; const step = (parseFloat(cur.step) || 1) * (rt ? 2 : -2); cur.value = Math.max(+cur.min, Math.min(+cur.max, (parseFloat(cur.value) || 0) + step)); cur.dispatchEvent(new Event('input', { bubbles: true })); } }
    if (aPress) this.activate();
    if (bPress || startPress) this.back(screen);
    if (yPress) this.yAction();
    if (lbPress) this.tab(-1); if (rbPress) this.tab(1);
    this.highlight(); this.hint(screen);
  }
};
window.addEventListener('mousemove', () => { GPUI.mouseActive = true; if (GPUI.shown) GPUI.hide(); });

// Skin creator access: main menu, and "Edit Skin" inside Settings (applies next respawn).
el('menuSkin').onclick = () => SkinCreator.open('mainMenu');
el('settingsEditSkin').onclick = () => SkinCreator.open(settingsReturn);
// --- MELEE picker UI (main menu + lobby): 3 cards with line-art icons; click to select + persist. ---
// Line-art icons for the inventory MELEE + LETHAL cards (drawn to a 120x90 canvas).
function meleeIconCanvas(type) {
  const c = document.createElement('canvas'); c.width = 120; c.height = 90; const x = c.getContext('2d');
  x.strokeStyle = '#dfe8f0'; x.lineCap = 'round'; x.lineJoin = 'round';
  if (type === 'karambit') { x.lineWidth = 8; x.beginPath(); x.arc(66, 40, 34, 0.5, 3.3); x.stroke(); x.lineWidth = 5; x.beginPath(); x.arc(86, 70, 12, 0, 7); x.stroke(); }   // hook + finger ring
  else if (type === 'm9') { x.lineWidth = 9; x.beginPath(); x.moveTo(22, 78); x.lineTo(98, 16); x.stroke(); x.lineWidth = 15; x.beginPath(); x.moveTo(16, 82); x.lineTo(36, 66); x.stroke(); x.lineWidth = 2; for (let i = 0; i < 6; i++) { x.beginPath(); x.moveTo(66 - i * 7, 38 + i * 5); x.lineTo(74 - i * 7, 30 + i * 5); x.stroke(); } }   // blade + handle + serrations
  else { x.lineWidth = 7; x.beginPath(); x.moveTo(20, 72); x.lineTo(100, 18); x.stroke(); x.lineWidth = 6; x.beginPath(); x.moveTo(22, 38); x.lineTo(66, 76); x.stroke(); x.beginPath(); x.moveTo(36, 24); x.lineTo(74, 60); x.stroke(); }   // butterfly handles + blade
  return c;
}
function lethalIconCanvas(type) {
  const c = document.createElement('canvas'); c.width = 120; c.height = 90; const x = c.getContext('2d');
  if (type === 'smoke') { x.fillStyle = 'rgba(225,228,234,0.85)'; [[52, 50, 24], [74, 46, 20], [62, 34, 18], [44, 40, 15], [82, 56, 14]].forEach(([cx, cy, r]) => { x.beginPath(); x.arc(cx, cy, r, 0, 7); x.fill(); }); x.strokeStyle = '#8a9098'; x.lineWidth = 5; x.beginPath(); x.moveTo(56, 64); x.lineTo(56, 82); x.stroke(); }   // smoke puffs + canister
  else { x.strokeStyle = '#b07a3a'; x.lineWidth = 9; x.lineCap = 'round'; x.beginPath(); x.moveTo(36, 82); x.lineTo(76, 22); x.stroke(); x.fillStyle = '#aab0b8'; x.beginPath(); x.moveTo(70, 12); x.quadraticCurveTo(100, 22, 92, 48); x.quadraticCurveTo(80, 40, 66, 30); x.closePath(); x.fill(); }   // wooden handle + steel axe head
  return c;
}
const MELEE_DESC = { m9: 'Combat knife', karambit: 'Curved tactical', butterfly: 'Folding flip knife' };
const LETHAL_DESC = { smoke: 'Blocks line of sight • 2/life', axe: 'One-shot • retrievable • 2/life' };
function _bigCard(cls, key, icon, name, desc, onclick) {
  const b = document.createElement('button'); b.className = 'invBigCard'; b.dataset[cls] = key;
  b.appendChild(icon);
  const nm = document.createElement('b'); nm.textContent = name; b.appendChild(nm);
  const ds = document.createElement('small'); ds.textContent = desc; b.appendChild(ds);
  b.onclick = onclick; return b;
}
function buildInvMelee() {
  const wrap = el('invMeleeRow'); if (!wrap) return; wrap.innerHTML = '';
  MELEE_TYPES.forEach(t => wrap.appendChild(_bigCard('melee', t, meleeIconCanvas(t), MELEE_NAMES[t], MELEE_DESC[t], () => { setMeleeChoice(t); sfxMeleeEquip(t); closeInventory(); })));
}
function buildInvLethal() {
  const wrap = el('invLethalRow'); if (!wrap) return; wrap.innerHTML = '';
  ['smoke', 'axe'].forEach(t => wrap.appendChild(_bigCard('lethal', t, lethalIconCanvas(t), LETHAL_NAMES[t], LETHAL_DESC[t], () => { setLethalChoice(t); sfxInvSelect(); closeInventory(); })));
}
function refreshInvPanes() {
  refreshInventory();
  document.querySelectorAll('#invMeleeRow .invBigCard').forEach(b => b.classList.toggle('sel', b.dataset.melee === meleeChoice));
  document.querySelectorAll('#invLethalRow .invBigCard').forEach(b => b.classList.toggle('sel', b.dataset.lethal === lethalChoice));
}
function setInvTab(pane) {
  document.querySelectorAll('#invMenu .invTab').forEach(t => t.classList.toggle('active', t.dataset.pane === pane));
  document.querySelectorAll('#invMenu .invPane').forEach(p => p.classList.toggle('active', p.id === pane));
  const ik = getKeyForAction('inventory'), kk = getKeyForAction('karambit'), lk = getKeyForAction('lethal');
  const hints = { paneMain: 'Click a weapon to equip it as your main • full ammo on swap • ' + ik + '/ESC to close', paneMelee: 'Pick your melee (key ' + kk + ') — identical stats, different style & animations', paneLethal: 'Pick your lethal (key ' + lk + ') — 2 per life' };
  const h = el('invHint'); if (h) h.textContent = hints[pane] || '';
}
document.querySelectorAll('#invMenu .invTab').forEach(t => t.onclick = () => { setInvTab(t.dataset.pane); sfxMenu(true); });
buildInvMelee(); buildInvLethal(); refreshKeyHints();   // stamp keybind hints from saved bindings on load
el('invTipX').onclick = () => dismissInvTip(false);                     // session dismiss
el('invTipNever').onclick = () => dismissInvTip(true);                  // permanent dismiss (localStorage)
function setBotCount(n) {
  botCount = Math.max(0, Math.min(BOT_MAX, n));
  localStorage.setItem('blockoutBots', botCount);
  refreshSettingsUI();
  if (gameState.running && (!NET.active || NET.isHost)) applyBotCount();   // add/remove live
}
el('botMinus').onclick = () => setBotCount(botCount - 1);
el('botPlus').onclick = () => setBotCount(botCount + 1);
[['throwGrenadeBtn', 'grenade'], ['throwTomahawkBtn', 'tomahawk']].forEach(([id, type]) => {
  el(id).onclick = () => {
    throwableType = type; localStorage.setItem('blockoutThrow', type);
    if (gameState.running && player.alive) player.grenades = throwMaxCarry();   // swap carry on the fly
    refreshSettingsUI(); updateHUD();
  };
});
refreshSettingsUI();

// --- AUDIO settings: master + per-category volume sliders + mute (persisted in localStorage) ---
(function setupAudioSettings() {
  SND.loadSettings();   // pull persisted volumes even before the engine is unlocked
  const rows = [['volmaster', 'master'], ['volweapons', 'weapons'], ['volfootsteps', 'footsteps'], ['volui', 'ui'], ['volambient', 'ambient']];
  function refresh() {
    rows.forEach(([id, cat]) => { const v = Math.round((SND.vol[cat] != null ? SND.vol[cat] : 1) * 100); el(id).value = v; el(id + 'V').textContent = v; });
    el('muteToggle').checked = SND.muted;
  }
  rows.forEach(([id, cat]) => el(id).addEventListener('input', () => {
    const v = parseInt(el(id).value, 10) / 100; el(id + 'V').textContent = el(id).value;
    if (cat === 'master') SND.setMaster(v); else SND.setCat(cat, v);
    sfxSlider();
  }));
  el('muteToggle').addEventListener('change', () => { SND.setMuted(el('muteToggle').checked); });
  window._refreshAudioSettings = refresh; refresh();
})();

// Start / restart
el('startButton').onclick = () => { if (gameMode === 'tdm') showTeamSelect('solo'); else startMatch(); };   // solo (TDM → team select first)
el('restartButton').onclick = () => {
  if (!NET.active) startMatch();
  else if (NET.isHost) hostStartMatch();                // host re-runs the match for everyone
};
el('endMenuButton').onclick = () => leaveToMenu();
// If the player presses ESC mid-match, re-lock on the next canvas click
canvas.addEventListener('click', () => { if (gameState.running && !pointerLocked) lockPointer(); });
// BR hotbar: click a slot to select/use it (delegated; works whenever the cursor is free)
(function () { const hb = el('brHotbar'); if (!hb) return; hb.addEventListener('mousedown', (e) => { const s = e.target.closest('[data-brslot]'); if (!s || !BR.active) return; e.stopPropagation(); brSelect(+s.getAttribute('data-brslot')); }); })();

/* ============================================================================
   9b. MULTIPLAYER — WebRTC peer-to-peer (PeerJS) private lobbies + FFA netcode
   ----------------------------------------------------------------------------
   Topology: STAR. One player is the HOST (peer id == the room code). Everyone
   else is a CLIENT and connects only to the host. The host:
     • runs the bots authoritatively and broadcasts their transforms,
     • relays player positions between everyone,
     • owns the scoreboard / kill credit / win condition.
   Each player is authoritative over its OWN position and its OWN health
   (damage you take is applied locally), which keeps PvP responsive without a
   dedicated server. Solo play leaves NET.active = false and changes nothing.
   ============================================================================ */
const PLAYER_COLORS = [0x3b8cff,0xff3b3b,0x35e0c0,0xffd23b,0xff7bd5,0x9b59ff,0xff8c1a,0x2ecc71,0xffffff,0x00d0ff];
const PEER_PREFIX = 'blockoutffs-';                 // namespace so codes don't collide with other apps
const peerIdFor = (code) => PEER_PREFIX + code.toUpperCase();
function makeCode() {
  const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';     // no ambiguous I/O/0/1
  let s = ''; for (let i = 0; i < 5; i++) s += A[(Math.random() * A.length) | 0];
  return s;
}
function lerpAngle(a, b, t) {
  let d = b - a; while (d > Math.PI) d -= Math.PI * 2; while (d < -Math.PI) d += Math.PI * 2;
  return a + d * t;
}

const NET = {
  active: false, isHost: false, isClient: false,
  peer: null, hostId: null, selfId: 'me', selfName: 'YOU', code: null,
  conns: {},                 // host: id->DataConnection for each client. client: { host: conn }
  players: new Map(),        // id -> remote player object (everyone EXCEPT me)
  scores: new Map(),         // id -> { name, score, kills }   (authoritative copy lives on host)
  botCredit: null,           // player id to credit for the current bot kill (host only)
  _sendAcc: 0, _botAcc: 0, _colorIdx: 0,
  ready: false,              // match has begun

  reset() {
    this.players.forEach(rp => { if (rp.avatar) scene.remove(rp.avatar); });
    this.players.clear(); this.scores.clear();
    this.active = this.isHost = this.isClient = this.ready = false;
    this.conns = {}; this.botCredit = null; this.code = null; this.hostId = null;
    this._colorIdx = 0;
    if (this.peer) { try { this.peer.destroy(); } catch (e) {} this.peer = null; }
  },

  nextColor() { return PLAYER_COLORS[(this._colorIdx++) % PLAYER_COLORS.length]; },

  // -- send to one id (handles client->client relay through the host) --
  route(toId, msg) {
    if (this.isHost) {
      if (toId === this.selfId) this.handleSelf(msg);
      else if (this.conns[toId]) this.conns[toId].send(msg);
    } else {
      if (toId === this.hostId) this.conns.host && this.conns.host.send(msg);
      else this.conns.host && this.conns.host.send({ t: 'route', to: toId, msg });
    }
  },
  broadcast(msg) {                  // host -> every client
    for (const id in this.conns) this.conns[id] && this.conns[id].send(msg);
  },

  /* ---------------- HOST ---------------- */
  host(name) {
    if (typeof Peer === 'undefined') { showScreen('lobbyScreen'); setNetStatus('lobbyStatus', 'Networking failed to load — check your internet connection.', true); return; }
    this.reset();
    this.selfName = name; this.isHost = true; this.active = true;
    this.code = makeCode(); this.selfId = peerIdFor(this.code); this.hostId = this.selfId;
    setNetStatus('lobbyStatus', 'Connecting to broker…');
    showScreen('lobbyScreen');
    el('lobbyStart').style.display = '';                 // host can start
    el('lobbyCode').textContent = this.code;
    this.peer = new Peer(this.selfId, { debug: 1 });
    this.peer.on('open', () => {
      this.scores.set(this.selfId, freshStat(this.selfName));
      this.color = this.nextColor();
      if (mySkinDataURL()) skinDataCache[this.selfId] = mySkinDataURL();   // cache own skin to serve to joiners
      setNetStatus('lobbyStatus', 'Lobby is live — share the code!');
      renderRoster();
    });
    this.peer.on('connection', (conn) => this.onClientConnect(conn));
    this.peer.on('error', (e) => {
      if (e.type === 'unavailable-id') { this.peer.destroy(); this.peer = null; this.host(name); }   // code taken: retry
      else setNetStatus('lobbyStatus', 'Network error: ' + e.type, true);
    });
  },
  onClientConnect(conn) {
    conn.on('open', () => { this.conns[conn.peer] = conn; });
    conn.on('data', (d) => this.onData(conn, d));
    conn.on('close', () => this.removePlayer(conn.peer));
    conn.on('error', () => this.removePlayer(conn.peer));
  },

  /* ---------------- CLIENT ---------------- */
  join(name, code) {
    if (typeof Peer === 'undefined') { setNetStatus('joinStatus', 'Networking failed to load — check your internet connection.', true); return; }
    this.reset();
    this.selfName = name; this.isClient = true; this.active = true; this.code = code.toUpperCase();
    this.hostId = peerIdFor(this.code);
    setNetStatus('joinStatus', 'Connecting…');
    this.peer = new Peer({ debug: 1 });
    let opened = false;
    this.peer.on('open', (id) => {
      this.selfId = id;
      const conn = this.peer.connect(this.hostId, { reliable: true });
      this.conns.host = conn;
      conn.on('open', () => {
        opened = true;
        conn.send({ t: 'hello', id, name });
        this.broadcastSkin();                                    // send my custom skin to the host (relayed to all)
        showScreen('lobbyScreen');
        el('lobbyCode').textContent = this.code;
        el('lobbyStart').style.display = 'none';                 // only the host can start
        setNetStatus('lobbyStatus', 'Joined! Waiting for host to start…');
      });
      conn.on('data', (d) => this.onData(conn, d));
      conn.on('close', () => this.onHostLost());
      conn.on('error', () => { if (!opened) setNetStatus('joinStatus', 'Could not reach that lobby.', true); });
    });
    this.peer.on('error', (e) => {
      if (!opened) setNetStatus('joinStatus', 'Could not join (' + e.type + '). Check the code.', true);
    });
    setTimeout(() => { if (!opened && this.isClient) setNetStatus('joinStatus', 'No response — is the code right and the host online?', true); }, 9000);
  },
  onHostLost() {
    if (!this.active) return;
    alert('Lost connection to the host. Returning to menu.');
    leaveToMenu();
  },
  removePlayer(id) {
    const rp = this.players.get(id);
    if (rp && rp.avatar) scene.remove(rp.avatar);
    if (rp && rp._flash) { scene.remove(rp._flash.cone); scene.remove(rp._flash.light); scene.remove(rp._flash.light.target); }
    this.players.delete(id);
    if (this.conns[id]) { delete this.conns[id]; }
    this.scores.delete(id);
    if (rp) sfxLeave();   // "doot" when a player leaves
    if (this.isHost) { this.broadcastRoster(); this.broadcastScores(); renderRoster(); refreshScoreboard(); }
  },

  /* ---------------- ROSTER / LOBBY ---------------- */
  rosterList() {
    const list = [{ id: this.selfId, name: this.selfName, host: this.isHost && true, color: this.color }];
    this.scores.forEach((s, id) => { if (id !== this.selfId) list.push({ id, name: s.name, host: id === this.hostId, color: (this.players.get(id) || {}).color }); });
    return list;
  },
  broadcastRoster() {
    const list = [];
    this.scores.forEach((s, id) => list.push({ id, name: s.name, host: id === this.hostId, color: id === this.selfId ? this.color : (this.players.get(id) || {}).color }));
    this.broadcast({ t: 'roster', code: this.code, list, mode: gameMode, cfg: MATCH.payload() });
  },

  /* ---------------- SCORES ---------------- */
  initScores() {},
  broadcastScores() {
    const list = []; this.scores.forEach((s, id) => list.push({ id, name: s.name, score: s.score, kills: s.kills,
      deaths: s.deaths || 0, streak: s.streak || 0, bestStreak: s.bestStreak || 0, level: s.level || 1, team: s.team || null, ping: s.ping || 0, lw: s.lastWeapon || null }));
    this.broadcast({ t: 'scores', list });
  },

  /* ---------------- CUSTOM SKINS ---------------- */
  // Send one player's skin (base64 PNG) in chunks via `sendFn` (handles >200KB).
  sendSkin(sendFn, fromId, url) {
    if (!url) return;
    const CH = 48000, n = Math.ceil(url.length / CH);
    for (let i = 0; i < n; i++) sendFn({ t: 'skin', from: fromId, seq: i, count: n, data: url.slice(i * CH, (i + 1) * CH) });
  },
  // Broadcast MY active skin to everyone (cached for late joiners / host relay).
  broadcastSkin() {
    if (!this.active) return;
    const url = mySkinDataURL(); if (!url) return;
    skinDataCache[this.selfId] = url;
    this.sendSkin(this.broadcast.bind(this), this.selfId, url);
  },
  _skinRecv: {},
  // Reassemble incoming skin chunks; on completion build the texture + apply to that avatar.
  onSkinChunk(msg, fromConnId) {
    const buf = this._skinRecv[msg.from] || (this._skinRecv[msg.from] = { count: msg.count, parts: [] });
    buf.count = msg.count; buf.parts[msg.seq] = msg.data;
    let done = 0; for (let i = 0; i < buf.count; i++) if (buf.parts[i] != null) done++;
    if (this.isHost) for (const id in this.conns) { if (id !== fromConnId && this.conns[id]) this.conns[id].send(msg); }   // relay to other clients
    if (done === buf.count) {
      const url = buf.parts.join(''); delete this._skinRecv[msg.from];
      textureFromDataURL(msg.from, url, () => applyRemoteSkin(msg.from));
    }
  },
  applyScoresLocal() {
    const mine = this.scores.get(this.selfId);
    if (mine) {
      gameState.score = mine.score; gameState.kills = mine.kills;
      if (gameMode === 'tdm' && mine.team) myTeam = mine.team;   // adopt my assigned team
      // safety resync: if a ggset was missed, the authoritative score level wins
      if (gameMode === 'gungame' && mine.level && mine.level !== ggLevel && !this.isHost) ggSetLevel(mine.level);
    }
    // keep remote avatars' team in sync for friendly-fire + outlines
    if (gameMode === 'tdm') this.players.forEach((rp, id) => { const s = this.scores.get(id); if (s) rp.team = s.team; });
    updateHUD(); refreshScoreboard();
  },
  // Host-only: credit a kill, announce it, broadcast scores, check win.
  awardKill(killerId, pts, victimName, opts) {
    if (!this.isHost) return;
    opts = opts || {};
    if (killerId === 'kong') { kongKillFeed(victimName); return; }   // King Kong kill — attributed to Kong, no player score
    let killerName = 'A bot';
    if (killerId && this.scores.has(killerId)) {
      const s = this.scores.get(killerId); s.score += pts; s.kills += 1; killerName = s.name;
      statKill(s, opts.weapon, opts.headshot, opts.melee);
    } else if (killerId === 'bot') killerName = 'A bot';
    if (opts.victimId && this.scores.has(opts.victimId)) statDeath(this.scores.get(opts.victimId));   // record the victim's death
    streakCredit(killerId);   // FFA/TDM: every credited kill bumps the killer's scorestreak
    const html = buildKillFeed(killerName, victimName, opts);
    addKillFeed(html); this.broadcast({ t: 'feed', html });
    this.broadcastScores(); this.applyScoresLocal();
    checkWinCondition();      // FFA kill limit / TDM team kill limit
  },

  /* ---------------- DAMAGE ROUTING ---------------- */
  // I shot a remote player's avatar -> tell them to take damage (they're authoritative on their HP).
  // weapon/melee ride along so the host can validate gun-game progression & demotion.
  damageRemote(rp, dmg, head, weapon, melee, origin, dir) {
    if (ffProtected(rp.id)) return;   // TDM, friendly fire OFF: a teammate takes no damage (and no karambit demotion)
    const m = { t: 'youhit', dmg, head: !!head, fromId: this.selfId, fromName: this.selfName, weapon: weapon || null, melee: !!melee, sx: player.pos.x, sy: player.pos.y, sz: player.pos.z };   // sx/sy/sz: shooter position for the victim's directional arc
    // Direct bullets ride their trajectory along so the target's saber can decide to deflect.
    if (origin && dir) { m.ox = origin.x; m.oy = origin.y; m.oz = origin.z; m.dx = dir.x; m.dy = dir.y; m.dz = dir.z; }
    this.route(rp.id, m);
  },
  // Report my own death so the host can credit my killer.
  reportDeath(byId, head, weapon, melee) {
    if (this.isHost) {
      if (gameMode === 'gungame') ggHostKill(byId, weapon, true, this.selfId, !!melee);
      else this.awardKill(byId, POINTS_KILL + (head ? POINTS_HEADSHOT : 0), this.selfName, { headshot: head, weapon, melee: !!melee, victimId: this.selfId });
    } else {
      this.route(this.hostId, { t: 'killed', byId, head: !!head, victimId: this.selfId, weapon: weapon || null, melee: !!melee });
    }
  },

  /* ---------------- SNAPSHOTS ---------------- */
  selfSnapshot() {
    const ws = weaponState[currentWeaponKey];
    const rl = (ws && ws.reloading > 0) ? Math.max(0, Math.min(1, 1 - ws.reloading / (ws.reloadTotal || 1))) : 0;
    return { id: this.selfId, name: this.selfName, x: player.pos.x, y: player.pos.y, z: player.pos.z,
             yaw, pitch, weapon: currentWeaponKey, health: Math.max(0, player.health), alive: player.alive,
             ads: (adsBlend > 0.5), rl,            // aim + reload state for others to see
             cr: player.crouchBlend, dv: player.diving,                      // crouch amount + dive (shorter hitbox)
             cig: cigSmoking && !cigCanceling,                               // smoking a cigar (third-person tell)
             sb: saberBlocking,                                              // saber block stance (third-person pose)
             flm: (flameEquipped && firing && flameFuel > 0), brn: (player.burnT > 0),   // flamethrower spray + on-fire tells
             lz: (laserOn && hasLaser(currentWeaponKey) && !laserSuppressedNow()) ? effLaser(currentWeaponKey) : 'off',   // laser on + color (off when scoped)
             fl: (effFlash(currentWeaponKey) === 'on' && flashlightOn && !flashSuppressedNow()) ? 1 : 0,   // flashlight cone on (others see it)
             wc: (liveCfg[currentWeaponKey] || getCfg(currentWeaponKey)) || null,   // weapon attachment config (third-person model)
             mc: meleeChoice,                                               // chosen melee (others render the right knife)
             clm: player.onLadder };                                         // climbing a ladder (third-person)
  },
  // host -> all: positions of every human (host builds from its own state + clients' last pmove)
  broadcastPlayers() {
    const list = [this.selfSnapshot()];
    this.players.forEach((rp) => list.push({ id: rp.id, name: rp.name, x: rp.pos.x, y: rp.pos.y, z: rp.pos.z,
      yaw: rp.yaw, pitch: rp.pitch || 0, weapon: rp.weapon, health: rp.health, alive: rp.alive, ads: !!rp.ads, rl: rp.rl || 0,
      cr: rp.cr || 0, dv: !!rp.dv, cig: !!rp.cig, sb: !!rp.sb, flm: !!rp.flm, brn: !!rp.brn, lz: rp.lz || 'off', fl: rp.fl || 0, wc: rp.wc || null, mc: rp.mc || 'karambit', clm: !!rp.clm }));
    this.broadcast({ t: 'players', list });
  },
  broadcastBots() {
    const list = [];
    for (const b of bots) list.push({ id: b.id, x: b.pos.x, y: b.pos.y, z: b.pos.z, yaw: b.yawFacing || 0, alive: !!b.alive, tm: b.team || null });
    // include the loot-crate state so every player sees the green block
    this.broadcast({ t: 'bots', list, loot: { active: lootActive, x: lootPos.x, y: lootBaseY, z: lootPos.z } });
  },

  /* ---------------- INBOUND ---------------- */
  handleSelf(msg) { this.onData(this.conns.host || null, msg); },   // host as the target of a routed msg
  onData(conn, msg) {
    if (!msg || !msg.t) return;
    const fromId = conn ? conn.peer : this.selfId;
    switch (msg.t) {
      /* ---- HOST handlers ---- */
      case 'hello': {                                  // a client joined
        if (this.rosterList().length >= 10) { if (conn) conn.send({ t: 'lobbyfull' }); break; }   // LOBBY FULL — cap at 10 players
        this.scores.set(msg.id, freshStat(msg.name));
        const rp = this.ensurePlayer(msg.id, msg.name); rp.color = rp.color || this.nextColor();
        sfxJoin();   // friendly "ding" when a player joins the lobby
        this.broadcastRoster(); renderRoster();
        // Serve every skin we've cached (host's own + other clients') to the newcomer.
        if (conn) for (const sid in skinDataCache) this.sendSkin((m) => conn.send(m), sid, skinDataCache[sid]);
        if (conn) conn.send({ t: 'daynight', tod: timeOfDay, cyc: dnFullCycle });   // hand the newcomer the current time-of-day
        break;
      }
      case 'lobbyfull': { setNetStatus('lobbyStatus', 'LOBBY FULL — that lobby already has 10 players.', true); setTimeout(() => leaveToMenu(), 1600); break; }   // host rejected us
      case 'pmove': {                                  // client position update
        const rp = this.ensurePlayer(msg.id, msg.name);
        rp.apply(msg);
        break;
      }
      case 'dmgbot': {                                 // client hit a bot — host adjudicates
        const bot = bots.find(b => b.id === msg.botId);
        if (bot && bot.alive) {
          this.botCredit = msg.fromId;
          const dir = new THREE.Vector3(0, 0, 0);
          damageBot(bot, msg.dmg, dir, msg.head ? 'head' : 'torso', { weapon: msg.weapon, headshot: !!msg.head, dist: 10 });
          this.botCredit = null;
          if (msg.burn) { bot.burnT = FLAME.burnDur; bot.burnBy = msg.fromId; }   // flamethrower burn
        }
        break;
      }
      case 'killed': {                                 // a client died; credit its killer
        despawnOwnedDogs(msg.victimId); despawnKong(msg.victimId);   // their attack dogs + King Kong leave when they fall
        if (gameMode === 'gungame') { ggHostKill(msg.byId, msg.weapon, true, msg.victimId, !!msg.melee); break; }
        const victim = this.scores.get(msg.victimId);
        this.awardKill(msg.byId, POINTS_KILL + (msg.head ? POINTS_HEADSHOT : 0), victim ? victim.name : 'Player', { headshot: msg.head, weapon: msg.weapon, melee: !!msg.melee, victimId: msg.victimId });
        break;
      }
      case 'dogsummon': { if (this.isHost) summonDogs(msg.ownerId); break; }   // a client deployed their 10-kill dogs
      case 'doghit': { if (this.isHost) { const d = dogs.find(x => x.id === msg.dogId); if (d) { damageDog(d, msg.dmg); if (msg.burn) d.burnT = FLAME.burnDur; } } break; }   // a client shot/burned an enemy dog
      case 'kongsummon': { if (this.isHost) summonKong(msg.ownerId); break; }   // a client summoned King Kong
      case 'konghit': { if (this.isHost) { const k = kongs.find(x => x.id === msg.kongId); if (k) { damageKong(k, msg.dmg, msg.fromId); if (msg.burn) k.burnT = FLAME.burnDur; } } break; }   // a client shot/burned an enemy Kong
      case 'route': { this.route(msg.to, msg.msg); break; }   // forward client->client

      /* ---- CLIENT handlers ---- */
      case 'roster': { this.code = msg.code; el('lobbyCode').textContent = this.code; if (msg.mode) { gameMode = msg.mode; refreshModeUI(); } if (msg.cfg) { MATCH.apply(msg.cfg); if (typeof renderMatchPane === 'function') renderMatchPane(); updateLobbySettingsSummary(); } this.applyRoster(msg.list); break; }
      case 'start': { if (msg.mode) gameMode = msg.mode; if (msg.cfg) MATCH.apply(msg.cfg); _tsActive = false; el('teamSelect').classList.add('hidden'); beginMatch(); break; }
      case 'tsel': { showTeamSelect('client'); break; }                       // Part 3: host opened TDM team select
      case 'tpick': { if (this.isHost) { const s = this.scores.get(msg.id); if (s) s.team = msg.team; this.broadcastScores(); if (_tsActive) renderTeamSelect(); } break; }   // a client picked a team
      case 'tseltime': { if (_tsActive && _tsMode === 'client') _tsTimer = msg.s; break; }   // host's authoritative countdown
      case 'players': { this.applyPlayers(msg.list); break; }
      case 'bots': { applyBotsSnapshot(msg.list); applyClientLoot(msg.loot); break; }
      case 'kdogs': { applyDogsSnapshot(msg.list); break; }   // host -> clients: attack-dog positions/state
      case 'kongs': { applyKongsSnapshot(msg.list); break; }  // host -> clients: King Kong positions/state
      case 'mcksummon': { if (this.isHost) summonMckayla(msg.ownerId); break; }   // a client summoned their Mckayla
      case 'mckhit': { if (this.isHost) { const m = mckaylas.find(x => x.id === msg.mckId); if (m) damageMckayla(m, msg.dmg); } break; }   // a client shot an enemy Mckayla
      case 'mcks': { applyMckaylasSnapshot(msg.list); break; }   // host -> clients: Mckayla positions/state
      case 'banana': { spawnBanana(new THREE.Vector3(msg.x, msg.y, msg.z), new THREE.Vector3(msg.vx, msg.vy, msg.vz), msg.o, false); break; }   // render-only banana copy
      case 'kongmsg': { showKongMsg(msg.m); break; }          // host -> me: Kong summon/fall/kill notification
      case 'lootgrab': {                               // a client walked into the crate
        if (lootActive) {
          const key = chooseSpecial();
          spawnBlood(lootPos, 22, 0x33ff66);
          lootGroup.visible = false; lootActive = false; lootTimer = LOOT.cooldown;
          this.route(msg.fromId, { t: 'lootgrant', key });
          this.broadcastBots();                        // immediately tell everyone it's gone
        }
        break;
      }
      case 'lootgrant': {                              // host granted me a special weapon
        el('lootFlash').style.opacity = 0.55; setTimeout(() => el('lootFlash').style.opacity = 0, 130);
        grantSpecial(msg.key); updateHUD();
        break;
      }
      case 'scores': {
        msg.list.forEach(s => { const r = this.scores.get(s.id) || freshStat(s.name);
          r.name = s.name; r.score = s.score; r.kills = s.kills; r.deaths = s.deaths || 0; r.streak = s.streak || 0;
          r.bestStreak = s.bestStreak || 0; r.level = s.level || 1; r.team = s.team || null; r.ping = s.ping || 0; r.lastWeapon = s.lw || r.lastWeapon; this.scores.set(s.id, r); });
        [...this.scores.keys()].forEach(id => { if (!msg.list.find(s => s.id === id)) this.scores.delete(id); });
        if (gameMode === 'tdm') { const mine = this.scores.get(this.selfId); if (mine && mine.team) myTeam = mine.team; }
        if (_tsActive) renderTeamSelect();   // Part 3: refresh the team-select rosters live
        this.applyScoresLocal(); break;
      }
      case 'feed': { addKillFeed(msg.html); break; }
      case 'matchover': { doMatchOver(msg.winner, msg.team || null, { byTime: !!msg.byTime, awards: msg.awards || null, rows: msg.rows || null }); break; }
      case 'proj': {                                   // a peer fired a projectile — render-only copy
        spawnGGProjectile(msg.pt, new THREE.Vector3(msg.x, msg.y, msg.z), new THREE.Vector3(msg.vx, msg.vy, msg.vz), false, msg.pt);
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay to other clients
        break;
      }
      case 'rc': {                                     // a peer's RC missile (render-only exterior + trail)
        if (msg.id !== this.selfId) {
          const rp = new THREE.Vector3(msg.x, msg.y, msg.z);
          if (msg.s === 'spawn') { rcRemoteSpawn(msg.id, rp, new THREE.Vector3(msg.dx, msg.dy, msg.dz)); sfxFire('rcrl', rp); }   // launch whoosh
          else if (msg.s === 'move') rcRemoteMove(msg.id, rp, new THREE.Vector3(msg.dx, msg.dy, msg.dz));
          else if (msg.s === 'boom') { rcRemoteBoom(msg.id, rp); sfxExplosion('rc', rp); }
        }
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay
        break;
      }
      case 'rcshot': {                                 // my RC missile was shot down — detonate it where it is
        if (msg.id === this.selfId && (rcActive || rcMissile)) rcDetonate(null, null, null, false);
        break;
      }
      case 'axe': {                                    // a peer threw a lethal axe — render a flying copy (no damage locally)
        if (msg.id !== this.selfId) spawnRemoteAxe(new THREE.Vector3(msg.x, msg.y, msg.z), new THREE.Vector3(msg.vx, msg.vy, msg.vz));
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }
        break;
      }
      case 'smoke': {                                  // a peer's smoke grenade erupted — spawn the cloud locally
        if (msg.id !== this.selfId) spawnSmokeCloud(new THREE.Vector3(msg.x, msg.y, msg.z), false);
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }
        break;
      }
      case 'imp': {                                    // a peer's impulse grenade (throw / stick / detonation)
        if (msg.s === 'spawn') {
          if (msg.id !== this.selfId) { spawnImpulse(new THREE.Vector3(msg.x, msg.y, msg.z), new THREE.Vector3(msg.vx, msg.vy, msg.vz), false, msg.id); sfxImpulseThrow(new THREE.Vector3(msg.x, msg.y, msg.z)); }
        } else if (msg.s === 'stick') {                                          // snap the network copy to the owner's stuck surface
          for (let k = 0; k < liveImpulses.length; k++) {
            const c = liveImpulses[k];
            if (!c.owned && c.ownerId === msg.id) {
              impulseOrient(c.mesh, new THREE.Vector3(msg.nx, msg.ny, msg.nz));
              c.stuck = true; c.fuse = IMPULSE.settleFuse; c.vel.set(0, 0, 0);
              c.pos.set(msg.x, msg.y, msg.z); c.mesh.position.copy(c.pos); sfxImpulseStick(c.pos);
              const f = msg.fid ? impulseResolveFollow(msg.fid) : null;
              if (f) { c.follow = f; c.followId = msg.fid; const a = impulseFollowPos(f); if (a) c.followOff.copy(c.pos).sub(a); }
              break;
            }
          }
        } else if (msg.s === 'boom') {
          impulseDetonate(new THREE.Vector3(msg.x, msg.y, msg.z), this.isHost);   // only the host applies launches
          for (let k = liveImpulses.length - 1; k >= 0; k--) {                    // drop the matching network canister copy
            if (!liveImpulses[k].owned && liveImpulses[k].ownerId === msg.id) { scene.remove(liveImpulses[k].mesh); disposeGroup(liveImpulses[k].mesh); liveImpulses.splice(k, 1); }
          }
        }
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay
        break;
      }
      case 'impulse': {                                // host launched me — apply the impulse to my velocity
        applyImpulseVec(new THREE.Vector3(msg.vx, msg.vy, msg.vz));
        break;
      }
      case 'fire': {                                   // a peer fired — play their weapon's shot at their position
        if (msg.id !== this.selfId) sfxFire(msg.w, new THREE.Vector3(msg.x, msg.y, msg.z), msg.sd || null, msg.mc);
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay to other clients
        break;
      }
      case 'melee': {                                  // a peer changed their chosen melee (lobby/in-match) — update their knife
        const rpm = this.players.get(msg.id); if (rpm) { rpm.mc = msg.mc; if (rpm.weaponKey) rpm.weaponKey = null; }
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }
        if (typeof LobbyStage !== 'undefined') LobbyStage.refresh();
        break;
      }
      case 'minspin': {                                // a peer started spinning up their minigun (heard map-wide)
        if (msg.id !== this.selfId) sfxMinigunSpin(new THREE.Vector3(msg.x, msg.y, msg.z));
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }
        break;
      }
      case 'trace': {                                  // a peer's bullet tracer — render it locally (visual only)
        if (msg.id !== this.selfId) renderNetTracer(msg);
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay to other clients
        break;
      }
      case 'daynight': {                               // host -> clients: current time-of-day (clients lerp to it)
        if (!this.isHost) { dnTarget = msg.tod; dnHasTarget = true; if (msg.cyc) dnFullCycle = msg.cyc; }
        break;
      }
      case 'mtime': {                                  // host -> clients: remaining match time + sudden-death flag
        if (!this.isHost) { MATCH._timeLeft = msg.s; MATCH._hasTime = true; MATCH._sudden = !!msg.sd; updateMatchTimerHUD(); }
        break;
      }
      case 'ping': { if (!this.isHost) this.route(this.hostId, { t: 'pong', id: this.selfId, ts: msg.ts }); break; }   // RTT probe -> reply
      case 'pong': { if (this.isHost) { const s = this.scores.get(msg.id); if (s) s.ping = Math.round(performance.now() - msg.ts); } break; }
      case 'matchcfg': {                               // host -> clients: updated match settings (lobby)
        if (!this.isHost) { MATCH.apply(msg.cfg); if (typeof renderMatchPane === 'function') renderMatchPane(); updateLobbySettingsSummary(); sfxNotify(); setNetStatus('lobbyStatus', 'Settings updated by host.'); }
        break;
      }
      case 'boost': {                                  // a peer triggered a boost pad — dim it + whoosh (their flight syncs via pmove)
        const pad = boostPads[msg.i];
        if (pad) { pad.cd = BOOST.cooldown; sfxBoostLaunch(new THREE.Vector3(pad.x, pad.y, pad.z)); }
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }
        break;
      }
      case 'skin': { this.onSkinChunk(msg, fromId); break; }   // a peer's painted skin (chunked PNG)

      case 'ggset': { ggSetLevel(msg.level); break; }    // host told me my new gun-game level
      case 'kc': { streakOnKill(); break; }              // host credited me a kill -> bump my (local) scorestreak
      case 'kcReq': { scheduleKillcamSend(msg.from); break; }   // a victim I killed wants my replay — keep recording 2s, then send the 3s+2s buffer
      case 'kcData': { if (killcam.active && killcam.waiting) { killcam.frames = msg.frames || null; killcam.killAbs = msg.killAt || 0; killcam.killerCfgs = msg.cfgs || null; } break; }   // killer's 3s+2s replay frames arrived
      case 'scoot': {                                  // one scooter's state from its current owner (occupant, or host while idle)
        const sc = scooters[msg.i];
        if (sc && !scooterOwns(sc)) {
          sc.pos.set(msg.x, msg.y, msg.z); sc.yaw = msg.yaw; sc.hp = msg.hp; sc.nosOn = msg.on;
          if (myScooter === sc && msg.occ && msg.occ !== NET.selfId) scooterDismount();   // someone else claimed it
          sc.occupant = msg.occ;
          if (sc.alive !== msg.alive) { sc.alive = msg.alive; sc.group.visible = msg.alive; if (msg.alive) respawnScooter(sc); }
        }
        if (this.isHost) for (const id in this.conns) { if (id !== fromId && this.conns[id]) this.conns[id].send(msg); }   // relay
        break;
      }
      case 'scoothit': { const sc = scooters[msg.i]; if (sc && scooterOwns(sc)) damageScooter(sc, msg.dmg); break; }   // a shooter routed scooter damage to the owner
      case 'streakact': { if (this.isHost) { const s = this.scores.get(msg.id); if (s) s.streakActs = (s.streakActs || 0) + 1; } break; }   // a player activated a scorestreak (results award)
      case 'teamswitch': { if (this.isHost) hostSwitchTeam(msg.id); break; }   // TDM: a client asked to switch teams (host validates balance)
      case 'burn': { if (player.alive) player.burnT = FLAME.burnDur; break; }   // an enemy flamethrower set me alight

      /* ---- both: I got shot ---- */
      case 'youhit': {
        player.lastAttacker = msg.fromId; player.lastAttackerHead = !!msg.head; player.lastAttackerName = msg.fromName;
        player.lastAttackerWeapon = msg.weapon || null; player.lastAttackerMelee = !!msg.melee;
        // Saber deflection: if a direct bullet (origin+dir present) crosses the active blade, reflect it.
        if (msg.ox != null && saberCanDeflect()) {
          const o = new THREE.Vector3(msg.ox, msg.oy, msg.oz), d = new THREE.Vector3(msg.dx, msg.dy, msg.dz).normalize();
          const defl = saberDeflectRay(o, d);
          if (defl) { saberDoDeflect(defl, msg.dmg); break; }   // blocked — take no damage
        }
        hurtPlayer(msg.dmg, msg.sx != null ? new THREE.Vector3(msg.sx, msg.sy, msg.sz) : null);
        break;
      }
    }
  },

  ensurePlayer(id, name) {
    let rp = this.players.get(id);
    if (!rp) { rp = makeRemotePlayer(id, name, this.nextColor()); this.players.set(id, rp); }
    if (name) rp.name = name.slice(0, 14);
    return rp;
  },
  applyRoster(list) {
    const keep = new Set();
    for (const p of list) {
      if (p.id === this.selfId) continue;
      keep.add(p.id);
      const rp = this.ensurePlayer(p.id, p.name); if (p.color != null) rp.color = p.color;
      this.scores.set(p.id, this.scores.get(p.id) || freshStat(p.name));
    }
    // drop anyone who left
    [...this.players.keys()].forEach(id => { if (!keep.has(id)) this.removePlayer(id); });
    renderRoster();
  },
  applyPlayers(list) {
    for (const e of list) {
      if (e.id === this.selfId) continue;
      const rp = this.ensurePlayer(e.id, e.name); rp.apply(e);
    }
  },
};

/* ============================================================================
   9d. CUSTOM SKINS — a paintable UV-atlas texture shared by the player character
   model (skin creator preview + every remote avatar). Geometry is unchanged; only
   the texture differs. Default = a plain light-gray mannequin.
   ============================================================================ */
const SKIN_RES = 512;
// Atlas cells (normalized) for each body box — a 3-col × 2-row grid. Each box's 6
// faces are spread into sub-rects of its cell so paint wraps correctly per face.
const SKIN_CELLS = {
  head:  [0 / 3, 0 / 2], torso: [1 / 3, 0 / 2], legs: [2 / 3, 0 / 2],
  armL:  [0 / 3, 1 / 2], armR:  [1 / 3, 1 / 2]
};
const CELL_W = 1 / 3, CELL_H = 1 / 2;
// Remap a BoxGeometry's UVs so each of its 6 faces occupies a distinct sub-rect of [u0,v0].
function assignBoxUVs(geo, u0, v0) {
  const uv = geo.attributes.uv, subW = CELL_W / 3, subH = CELL_H / 2;
  for (let f = 0; f < 6; f++) {
    const col = f % 3, row = (f / 3) | 0;
    const cu = u0 + col * subW, cv = v0 + row * subH;
    for (let k = 0; k < 4; k++) {
      const i = f * 4 + k, a = uv.getX(i), b = uv.getY(i);   // a,b are 0 or 1
      uv.setXY(i, cu + a * subW * 0.96 + subW * 0.02, cv + b * subH * 0.96 + subH * 0.02);
    }
  }
  uv.needsUpdate = true;
}
// Build the shared character: 5 textured body boxes (one material/atlas) + tags via `mk`.
// `mk(w,h,d,x,y,z,part)` lets callers tag meshes (e.g. for hit detection on remotes).
function buildCharacterModel(material, mk) {
  const part = (w, h, d, x, y, z, name) => {
    const geo = new THREE.BoxGeometry(w, h, d);
    assignBoxUVs(geo, SKIN_CELLS[name][0], SKIN_CELLS[name][1]);
    const m = mk ? mk(geo, material, x, y, z, name) : new THREE.Mesh(geo, material);
    if (!mk) { m.position.set(x, y, z); }
    return m;
  };
  return {
    legs:  part(0.5, 0.6, 0.5, 0, 0.55, 0, 'legs'),
    torso: part(0.85, 0.7, 0.55, 0, 1.15, 0, 'torso'),
    armL:  part(0.18, 0.55, 0.18, -0.5, 1.2, 0, 'armL'),
    armR:  part(0.18, 0.55, 0.18, 0.5, 1.2, 0, 'armR'),
    head:  part(0.5, 0.5, 0.5, 0, 1.75, 0, 'head')
  };
}
// Default blank mannequin texture (plain light gray) — shared by uncustomised players.
function makeBlankSkinCanvas() {
  const cv = document.createElement('canvas'); cv.width = cv.height = SKIN_RES;
  const ctx = cv.getContext('2d'); ctx.fillStyle = '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES);
  return cv;
}
const defaultSkinTex = new THREE.CanvasTexture(makeBlankSkinCanvas());
defaultSkinTex.colorSpace = THREE.SRGBColorSpace !== undefined ? THREE.SRGBColorSpace : defaultSkinTex.colorSpace;

const skinCache = {};          // id -> THREE.Texture (received/own skins, keyed by player id)
const skinDataCache = {};      // id -> dataURL (so we can re-broadcast / persist)
// Turn a PNG dataURL into a texture (async) and cache it under `id`; calls cb(tex) when ready.
function textureFromDataURL(id, url, cb) {
  const img = new Image();
  img.onload = () => {
    const tex = new THREE.Texture(img); tex.needsUpdate = true;
    if (THREE.SRGBColorSpace !== undefined) tex.colorSpace = THREE.SRGBColorSpace;
    skinCache[id] = tex; skinDataCache[id] = url; if (cb) cb(tex);
  };
  img.onerror = () => { if (cb) cb(null); };
  img.src = url;
}

/* ---- Remote player object + blocky avatar ---- */
function makeRemotePlayer(id, name, color) {
  return {
    id, name: (name || 'Player').slice(0, 14), color, alive: true, health: 100, weapon: 'pistol',
    pos: new THREE.Vector3(0, 0, 0), yaw: 0, ads: false, rl: 0, cr: 0, dv: false, cig: false, clm: false, crShown: 0, _cigPuffT: 0,
    renderPos: new THREE.Vector3(0, 0, 0), renderYaw: 0,
    avatar: null, head: null, gun: null, nameSprite: null, _hadAvatar: false, _lastNameHp: -1, mc: 'karambit',
    apply(d) {
      if (d.name) this.name = d.name.slice(0, 14);
      if (d.x != null) this.pos.set(d.x, d.y, d.z);
      if (d.yaw != null) this.yaw = d.yaw;
      if (d.weapon) this.weapon = d.weapon;
      if (d.health != null) this.health = d.health;
      if (d.alive != null) this.alive = d.alive;
      if (d.ads != null) this.ads = d.ads;
      if (d.rl != null) this.rl = d.rl;
      if (d.cr != null) this.cr = d.cr;
      if (d.dv != null) this.dv = d.dv;
      if (d.cig != null) this.cig = d.cig;
      if (d.clm != null) this.clm = d.clm;
      if (d.pitch != null) this.pitch = d.pitch;
      if (d.sb != null) this.sb = d.sb;
      if (d.flm != null) this.flm = d.flm;
      if (d.brn != null) this.brn = d.brn;
      if (d.lz != null) this.lz = d.lz;
      if (d.fl != null) this.fl = d.fl;
      if (d.wc != null) this.wc = d.wc;
      if (d.mc) this.mc = d.mc;
    }
  };
}
function buildRemoteAvatar(rp) {
  const g = new THREE.Group();
  // One material sampling the player's custom skin texture (or the default blank mannequin).
  const mat = new THREE.MeshLambertMaterial({ map: skinCache[rp.id] || defaultSkinTex });
  rp.skinMat = mat;
  const parts = buildCharacterModel(mat, (geo, material, x, y, z, name) => {
    const m = new THREE.Mesh(geo, material);
    m.position.set(x, y, z); m.castShadow = true;
    m.userData = { remote: rp, part: name === 'head' ? 'head' : 'torso' };   // head = headshot, rest = body
    g.add(m); return m;
  });
  const head = parts.head;
  // Third-person held weapon — real geometry, (re)built when rp.weapon changes (see updateRemoteWeapon).
  rp.weaponKey = null; rp.weaponMesh = null; rp.jdMesh = null;
  // Third-person cigar held to the mouth (shown only while this player is smoking — a heal tell).
  const cigM = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.045, 0.34, 8), new THREE.MeshLambertMaterial({ color: 0x6b4a2a, flatShading: true }));
  cigM.rotation.z = Math.PI / 2; cigM.position.set(0.20, 1.62, 0.22); cigM.visible = false; g.add(cigM);
  const cigEm = new THREE.Mesh(new THREE.SphereGeometry(0.04, 6, 5), new THREE.MeshBasicMaterial({ color: 0xff5a1a })); cigEm.position.set(0.38, 1.62, 0.22); cigEm.visible = false; g.add(cigEm);
  rp.cigMesh = cigM; rp.cigEmber = cigEm;
  rp.avatar = g; rp.head = head;
  rp.renderPos.copy(rp.pos);
  drawNameSprite(rp);
  scene.add(g);
}
// Swap a remote player's avatar material to their (now-loaded) skin texture, or default.
function applyRemoteSkin(id) {
  const rp = NET.players.get(id);
  if (rp && rp.skinMat) { rp.skinMat.map = skinCache[id] || defaultSkinTex; rp.skinMat.needsUpdate = true; }
}

/* ---- Local skin storage (up to 5 named slots in localStorage) ---- */
const SKIN_STORE_KEY = 'blockoutSkins';
function loadSkinStore() {
  try { const s = JSON.parse(localStorage.getItem(SKIN_STORE_KEY)); if (s && Array.isArray(s.slots)) return s; } catch (e) {}
  return { slots: [], active: -1 };   // slots: [{name, data(dataURL)}]
}
function saveSkinStore(s) { try { localStorage.setItem(SKIN_STORE_KEY, JSON.stringify(s)); } catch (e) {} }
// The dataURL of the player's currently-active saved skin, or null if they've never customised.
function mySkinDataURL() {
  const s = loadSkinStore();
  return (s.active >= 0 && s.slots[s.active]) ? s.slots[s.active].data : null;
}
function drawNameSprite(rp) {
  const cv = document.createElement('canvas'); cv.width = 256; cv.height = 80;
  const ctx = cv.getContext('2d');
  ctx.font = 'bold 30px Trebuchet MS, Arial'; ctx.textAlign = 'center';
  ctx.lineWidth = 6; ctx.strokeStyle = 'rgba(0,0,0,0.85)';
  ctx.fillStyle = (gameMode === 'tdm' && rp.team) ? TEAMS[rp.team].css : '#fff';   // team-tinted nameplate
  ctx.strokeText(rp.name, 128, 30); ctx.fillText(rp.name, 128, 30);
  // health bar
  const hp = Math.max(0, Math.min(100, rp.health)) / 100;
  ctx.fillStyle = 'rgba(0,0,0,0.6)'; ctx.fillRect(58, 48, 140, 14);
  ctx.fillStyle = hp > 0.5 ? '#34d058' : hp > 0.25 ? '#f0b429' : '#e0392b';
  ctx.fillRect(60, 50, 136 * hp, 10);
  const tex = new THREE.CanvasTexture(cv);
  if (rp.nameSprite) { rp.nameSprite.material.map.dispose(); rp.nameSprite.material.map = tex; rp.nameSprite.material.needsUpdate = true; }
  else {
    const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, depthTest: false, transparent: true }));
    spr.scale.set(2.2, 0.7, 1); spr.position.set(0, 2.55, 0); rp.avatar.add(spr); rp.nameSprite = spr;
  }
  rp._lastNameHp = Math.round(rp.health);
}
// Rebuild a remote player's held weapon mesh when their equipped weapon changes; manage the
// left-hand Jack Daniels bottle that accompanies the saber scorestreak.
function updateRemoteWeapon(rp) {
  const wcKey = rp.wc ? (rp.wc.sight + rp.wc.magazine + rp.wc.laser + rp.wc.flashlight) : '';   // (PART 2) rebuild on attachment changes too
  if (rp.weaponKey === rp.weapon && rp.weaponMc === rp.mc && rp.weaponWc === wcKey) return;
  rp.weaponKey = rp.weapon; rp.weaponMc = rp.mc; rp.weaponWc = wcKey;
  if (rp.weaponMesh) { rp.avatar.remove(rp.weaponMesh); disposeGroup(rp.weaponMesh); rp.weaponMesh = null; }
  if (WEAPONS[rp.weapon]) {
    rp.weaponMesh = buildThirdPersonWeapon(rp.weapon, rp.weapon === KARAMBIT_KEY ? (rp.mc || 'karambit') : undefined, rp.wc || null);   // chosen knife + attachment config
    rp.weaponMesh.position.set(0.42, 1.26, 0.34);
    rp.avatar.add(rp.weaponMesh);
  }
  const wantBottle = (rp.weapon === 'saber');
  if (wantBottle && !rp.jdMesh) { rp.jdMesh = buildTpBottle(); rp.jdMesh.position.set(-0.42, 1.18, 0.30); rp.avatar.add(rp.jdMesh); }
  else if (!wantBottle && rp.jdMesh) { rp.avatar.remove(rp.jdMesh); disposeGroup(rp.jdMesh); rp.jdMesh = null; }
  // Flamethrower: a fuel tank strapped to the character's back (visible to others).
  const wantTank = (rp.weapon === 'flame');
  if (wantTank && !rp.tankMesh) {
    const tk = new THREE.Group();
    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.7, 10), new THREE.MeshLambertMaterial({ color: 0x44444c, flatShading: true })); tk.add(body);
    const stripe = new THREE.Mesh(new THREE.BoxGeometry(0.46, 0.12, 0.05), new THREE.MeshLambertMaterial({ color: 0xcc3322, flatShading: true })); stripe.position.set(0, 0.1, 0.22); tk.add(stripe);
    tk.position.set(0, 1.3, -0.42); rp.avatar.add(tk); rp.tankMesh = tk;
  } else if (!wantTank && rp.tankMesh) { rp.avatar.remove(rp.tankMesh); disposeGroup(rp.tankMesh); rp.tankMesh = null; }
}
// Smoothly move all remote players toward their last network position.
function lerpRemotePlayers(dt) {
  NET.players.forEach(rp => {
    if (!rp.alive) { if (rp.avatar) rp.avatar.visible = false; hideLaser(rp._laser); return; }
    if (!rp.avatar) buildRemoteAvatar(rp);
    rp.avatar.visible = true;
    const t = Math.min(1, dt * 14);
    // Spatial footsteps for remote players: accumulate ground distance moved and step periodically.
    if (!rp.dv && !rp.clm) {
      const moved = Math.hypot(rp.pos.x - rp.renderPos.x, rp.pos.z - rp.renderPos.z);
      if (moved > 0.02 && Math.abs(rp.pos.y - rp.renderPos.y) < 0.4) {
        rp._stepD = (rp._stepD || 0) + moved;
        const stride = (rp.cr || 0) > 0.5 ? 1.7 : 2.3;
        if (rp._stepD >= stride) { rp._stepD = 0; sfxFootstep(rp.pos, (rp.cr || 0) > 0.5 ? 0.5 : 0.85); }
      }
    }
    rp.renderPos.lerp(rp.pos, t);
    rp.renderYaw = lerpAngle(rp.renderYaw, rp.yaw, t);
    rp.avatar.position.copy(rp.renderPos);
    rp.avatar.rotation.y = rp.renderYaw;
    // Crouch / dive: squash the avatar toward its feet so it's shorter — the raycast hitbox
    // follows, so shooting where a standing head would be MISSES a crouched player.
    const lowAmt = Math.max(rp.cr || 0, rp.dv ? 1 : 0);
    rp.crShown += (lowAmt - rp.crShown) * t;
    rp.avatar.scale.y = 1 - 0.40 * rp.crShown;            // ~60% height when fully crouched/prone
    rp.avatar.rotation.x = (rp.dv ? 0.45 : 0) * rp.crShown;  // slight forward (prone) lean while diving
    if (rp.nameSprite) { const sy = rp.avatar.scale.y || 1; rp.nameSprite.scale.set(2.2, 0.7 / sy, 1); rp.nameSprite.position.y = 2.55 / sy; }   // keep tag upright + above head
    // Third-person held weapon: rebuild on weapon change, then pose for aim/reload/climb/saber-block.
    updateRemoteWeapon(rp);
    { const mb = rp.weaponMesh && rp.weaponMesh.getObjectByName('miniBarrels'); if (mb) mb.rotation.z += dt * 16; }   // spin a remote minigun's barrels
    if (rp.weaponMesh) {
      const wm = rp.weaponMesh, sy = rp.avatar.scale.y || 1;
      wm.scale.set(1, 1 / sy, 1);                               // un-squash from the crouch scale (it still lowers)
      const saber = rp.weapon === 'saber';
      let tx = 0.42, ty = 1.26, rotx = -(rp.pitch || 0) * 0.5, rotz = 0, show = true;
      if (rp.clm) show = false;                                 // climbing: holstered (both hands on the ladder)
      else if (saber && rp.sb) { tx = 0.16; ty = 1.34; rotx = 0; rotz = 1.4; }   // block stance: blade held horizontally across the front
      else if (rp.ads) { tx = 0.14; ty = 1.5; rotx *= 0.4; }
      else if (rp.rl > 0) { ty = 1.06; rotx = 0.6; }
      wm.visible = show;
      wm.position.x += (tx - wm.position.x) * t;
      wm.position.y += (ty - wm.position.y) * t;
      wm.rotation.x += (rotx - wm.rotation.x) * t;
      wm.rotation.z += (rotz - wm.rotation.z) * t;
    }
    if (rp.jdMesh) { rp.jdMesh.visible = !rp.clm; rp.jdMesh.scale.set(1, 1 / (rp.avatar.scale.y || 1), 1); }
    // Laser sight beam from an enemy's gun (tactical tell), dimmer with distance, terminated by walls.
    const rpDir = () => { const cp = Math.cos(rp.pitch || 0); return new THREE.Vector3(-Math.sin(rp.renderYaw) * cp, Math.sin(rp.pitch || 0), -Math.cos(rp.renderYaw) * cp).normalize(); };
    if (rp.lz && rp.lz !== 'off' && rp.weaponMesh && !rp.clm) {
      if (!rp._laser) rp._laser = makeLaserBeam();
      const muzzle = rp.weaponMesh.getWorldPosition(new THREE.Vector3()), dir = rpDir();
      const camDist = camera.getWorldPosition(new THREE.Vector3()).distanceTo(muzzle);
      const bright = Math.max(0.15, Math.min(1, 1 - camDist / 85)) * (LASER_WEAPONS[rp.weapon] || 1);
      placeLaser(rp._laser, muzzle, laserCast(muzzle, dir, rp.avatar), bright, laserHex(rp.lz === 'green' ? 'green' : 'red', LASER_WEAPONS[rp.weapon] < 1));
    } else if (rp._laser) hideLaser(rp._laser);
    // Enemy flashlight cone (tactical tell — gives their position away), terminated by walls.
    if (rp.fl && rp.weaponMesh && !rp.clm) {
      const muzzle = rp.weaponMesh.getWorldPosition(new THREE.Vector3());
      updateFlashlightBeam(rp, muzzle, rpDir());
    } else if (rp._flash) { rp._flash.cone.visible = false; rp._flash.light.visible = false; }
    // Cigar smoking tell: show the held cigar + lit ember and puff smoke from the tip.
    if (rp.cigMesh) {
      const on = !!rp.cig;
      rp.cigMesh.visible = on; rp.cigEmber.visible = on;
      if (on) { rp._cigPuffT -= dt; if (rp._cigPuffT <= 0) { spawnSmokePuff(rp.cigEmber.getWorldPosition(new THREE.Vector3()), 0xcfcfcf, 0.14, 0.8); rp._cigPuffT = 0.5; } }
    }
    // Flamethrower spray (visible from all angles) + on-fire flame tell for remote players.
    if (rp.flm && rp.weaponMesh) { const o = rp.weaponMesh.getWorldPosition(new THREE.Vector3()); const aim = new THREE.Vector3(-Math.sin(rp.renderYaw), 0, -Math.cos(rp.renderYaw)); flameSprayFX(o, aim); }
    if (rp.brn) burnFX(new THREE.Vector3(rp.pos.x, rp.pos.y + 1.0, rp.pos.z), 1.4);
    // TEAM DEATHMATCH: sync team, build/refresh the team outline + chevron, and gate enemy nameplate by line-of-sight.
    if (gameMode === 'tdm') {
      const s = NET.scores.get(rp.id); rp.team = s ? s.team : rp.team;
      updateTeamMarker(rp);
      const enemy = rp.team && myTeam && rp.team !== myTeam;
      if (rp.nameSprite) rp.nameSprite.visible = enemy ? remoteInSight(rp) : true;   // enemies only show their tag when seen
    } else if (rp._teamChevron || rp._teamOutline) { updateTeamMarker(rp); if (rp.nameSprite) rp.nameSprite.visible = true; }
    if (Math.round(rp.health) !== rp._lastNameHp || rp._lastNameTeam !== rp.team) { rp._lastNameTeam = rp.team; drawNameSprite(rp); }
  });
}
// Rough line-of-sight from the camera to a remote player (used to gate enemy nameplates in TDM).
function remoteInSight(rp) {
  const cam = camera.position, tp = new THREE.Vector3(rp.pos.x, rp.pos.y + 1.4, rp.pos.z);
  const dir = tp.clone().sub(cam); const dist = dir.length(); if (dist < 0.1) return true; dir.normalize();
  // must be roughly in front of the camera
  const fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
  if (fwd.dot(dir) < 0.2) return false;
  const ray = new THREE.Raycaster(cam, dir, 0.3, dist - 0.6);
  return ray.intersectObjects(colliders, false).length === 0;   // no wall between us
}

/* ---- Bots on a client are render-only ghosts driven by host snapshots ---- */
function applyBotsSnapshot(list) {
  for (const e of list) {
    let bot = bots.find(b => b.id === e.id);
    if (!bot) { bot = { id: e.id, pos: new THREE.Vector3(), vel: new THREE.Vector3(), health: 100, alive: true, group: null }; bots.push(bot); }
    if (e.tm) bot.team = e.tm;
    if (!bot.group) { spawnBot(bot); } else updateBotTeamPip(bot);
    bot.targetPos = bot.targetPos || new THREE.Vector3();
    bot.targetPos.set(e.x, e.y, e.z); bot.targetYaw = e.yaw;
    if (e.alive && !bot.alive && bot.materials) bot.materials.forEach(m => { m.opacity = 1; m.transparent = false; });
    bot.alive = e.alive;
    if (bot.group) bot.group.visible = e.alive;
  }
}
function lerpClientBots(dt) {
  const t = Math.min(1, dt * 12);
  for (const b of bots) {
    if (!b.group || !b.targetPos || !b.alive) continue;
    b.pos.lerp(b.targetPos, t);
    b.group.position.set(b.pos.x, b.pos.y, b.pos.z);
    b.group.rotation.set(0, lerpAngle(b.group.rotation.y, b.targetYaw || 0, t), 0);
  }
}

// TDM: a small overhead cone above each bot, colored by team (depth-test off so it reads through walls).
function updateBotTeamPip(bot) {
  if (gameMode !== 'tdm' || !bot.team) { if (bot.teamPip) bot.teamPip.visible = false; return; }
  if (!bot.teamPip && bot.group) {
    const pip = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.3, 4), new THREE.MeshBasicMaterial({ depthTest: false, transparent: true }));
    pip.rotation.x = Math.PI; pip.position.set(0, 2.45, 0); pip.renderOrder = 998; bot.group.add(pip); bot.teamPip = pip;
  }
  if (bot.teamPip) { bot.teamPip.visible = true; bot.teamPip.material.color.setHex(TEAMS[bot.team].color); }
}
/* ---- Bot targeting: nearest living human (local player + remote players) ---- */
function humanTargets() {
  if (!NET.active) return player.alive ? [player] : [];
  const list = [];
  if (player.alive) list.push(player);
  NET.players.forEach(rp => { if (rp.alive) list.push(rp); });
  return list;
}
function nearestHuman(bot) {
  let best = null, bd = Infinity;
  for (const h of humanTargets()) {
    if (gameMode === 'tdm' && bot && bot.team) { const ht = (h === player) ? myTeam : teamOf(h.id); if (ht && ht === bot.team) continue; }   // skip teammates
    const d = bot.pos.distanceTo(h.pos); if (d < bd) { bd = d; best = h; }
  }
  return best;
}
// Bot landed a shot on `target` (a human). Route the damage to the right place. (TDM: bots only target enemies.)
function damageHuman(target, dmg, srcPos) {
  if (target === player) { player.lastAttacker = 'bot'; player.lastAttackerHead = false; player.lastAttackerName = 'A bot'; hurtPlayer(dmg, srcPos); }
  else if (target && target.id != null) { const m = { t: 'youhit', dmg, head: false, fromId: 'bot', fromName: 'A bot' }; if (srcPos) { m.sx = srcPos.x; m.sy = srcPos.y; m.sz = srcPos.z; } NET.route(target.id, m); }
}

/* ---- Kill-feed text used across the network ---- */
function buildKillFeed(killer, victim, opts) {
  opts = opts || {};
  let tags = '';
  const wt = WEAPON_TAGS[opts.weapon];
  if (wt) tags += ` <span class="${wt.gold ? 'leg' : 'wtag'}">${wt.label}</span>`;
  if (opts.dism) tags += ` <span class="hs">DISMEMBERED</span>`;
  const k = (killer === NET.selfName) ? '<b class="you">YOU</b>' : killer;
  const v = (victim === NET.selfName) ? '<b class="you">YOU</b>' : victim;
  const skull = opts.headshot ? '💀' : '';                              // headshot marker
  const longshot = (opts.dist && opts.dist > 30) ? '↗' : '';            // long-range kill marker
  return `${k} <span class="wic">${weaponIcon(opts.weapon)}${skull}${longshot}</span> ${v}${tags}`;
}

/* ---- Live scoreboard (hold TAB) ---- */
// Small emoji icon for a kill weapon (used in the scoreboard "LAST" column + kill feed polish).
function weaponIcon(key) {
  if (!key) return '·';
  if (key === 'tomahawk' || key === 'axe') return '🪓';
  if (key === 'flame') return '🔥';
  if (key === 'saber') return '⚔️';
  if (key === 'rcrl') return '🚀';
  if (key === 'kongbanana' || key === 'kongmelee') return '🦍';
  if (key === 'dogbite') return '🐕';
  const w = WEAPONS[key];
  if (!w) return '🔫';
  if (w.melee || w.karambit) return '🔪';
  if (w.explosive) return '💥';
  if (w.sight && /scope/.test(w.sight)) return '🎯';
  return '🔫';
}
function _kd(r) { return ((r.kills || 0) / Math.max(1, r.deaths || 0)).toFixed(2); }
function _sbRow(r, rankClass, isGG) {
  const me = r.id === (NET.active ? NET.selfId : 'me');
  const crown = r.rank === 1 ? '👑 ' : '';
  const flame = (r.streak || 0) >= 3 ? ' 🔥' : '';
  const ping = (NET.active && !me) ? (r.ping ? r.ping + 'ms' : '—') : '—';
  const scoreCol = isGG ? ((r.level || 1) + ' / ' + GUNGAME_MAX) : (r.kills || 0);
  return `<tr class="${me ? 'me ' : ''}${rankClass}">`
    + `<td class="rank">${r.rank || ''}</td>`
    + `<td class="pl">${crown}${me ? 'YOU' : r.name}${flame}</td>`
    + `<td>${scoreCol}</td><td>${r.kills || 0}</td><td>${r.deaths || 0}</td><td>${_kd(r)}</td>`
    + `<td>${r.streak || 0}</td><td>${ping}</td><td>${weaponIcon(r.lastWeapon)}</td></tr>`;
}
function _sbTable(rows, isGG) {
  const head = `<thead><tr><th class="rank">#</th><th class="pl">PLAYER</th><th>${isGG ? 'LEVEL' : 'SCORE'}</th><th>K</th><th>D</th><th>K/D</th><th>STRK</th><th>PING</th><th>LAST</th></tr></thead>`;
  const body = rows.map((r, i) => _sbRow(r, i < 3 ? 't' + (i + 1) : '', isGG)).join('') || `<tr><td class="pl" colspan="9" style="opacity:.5">—</td></tr>`;
  return `<table>${head}<tbody>${body}</tbody></table>`;
}
function refreshScoreboard() {
  const content = el('sbContent'); if (!content) return;
  const title = el('sbTitle'), sub = el('sbSub');
  const isGG = gameMode === 'gungame';
  const rows = scoreboardRows();   // ranked snapshot
  const timeStr = MATCH._hasTime ? (MATCH._sudden ? ' • SUDDEN DEATH' : ' • ' + fmtClock(MATCH._timeLeft) + ' left') : '';
  if (gameMode === 'tdm') {
    if (title) title.textContent = 'TEAM DEATHMATCH';
    const rk = teamKills('red'), bk = teamKills('blue');
    if (sub) sub.textContent = `${rk} – ${bk} • first to ${MATCH.tdmKills}${timeStr}`;
    const red = rows.filter(r => r.team === 'red'), blue = rows.filter(r => r.team === 'blue'), other = rows.filter(r => r.team !== 'red' && r.team !== 'blue');
    red.forEach((r, i) => r.rank = i + 1); blue.forEach((r, i) => r.rank = i + 1);
    let html = `<div class="sbTeam red"><span>TEAM RED</span><span class="tt">${rk}</span></div>` + _sbTable(red, false);
    html += `<div class="sbTeam blue"><span>TEAM BLUE</span><span class="tt">${bk}</span></div>` + _sbTable(blue, false);
    if (other.length) html += _sbTable(other, false);
    content.innerHTML = html;
    return;
  }
  if (title) title.textContent = isGG ? 'GUN GAME' : 'FREE-FOR-ALL';
  if (sub) sub.textContent = (isGG ? `First to Level ${GUNGAME_MAX}` : `${rows[0] ? rows[0].kills : 0} / ${MATCH.ffaKills} kills`) + timeStr;
  content.innerHTML = _sbTable(rows, isGG);
}

/* ============================================================================
   PART 2 — END-OF-MATCH RESULTS SCREEN
   ============================================================================ */
function sfxApplause() { SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 2.2, peak: 0.16, filter: 'bandpass', freq: 1700, freq1: 1300, q: 0.5, verb: 0.5 }); for (let i = 0; i < 36; i++) aNoise(ctx, out, t + Math.random() * 1.8, { dur: 0.04, peak: 0.05, filter: 'highpass', freq: 2600 }); }, 'ui', 'applause', 0.85, 2.3); }
function sfxCardReveal() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [880, 1320], 0.05, 0.18, 0.22, 'sine'), 'ui', 'card', 0.7, 0.3); }

// Mini 3D winner stage: victory pose (arms + weapon raised), spotlight, slow turntable.
const ResultStage = (() => {
  let inited = false, renderer, scene, cam, raf = 0, spin = 0; const groups = [];
  function init() {
    if (inited) return; inited = true;
    scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xdfe8ff, 0x20242e, 1.1));
    const dl = new THREE.DirectionalLight(0xfff0d8, 1.0); dl.position.set(2, 8, 5); scene.add(dl);
    const sl = new THREE.SpotLight(0xfff2cc, 1.5, 32, 0.55, 0.6); sl.position.set(0, 9, 3); sl.target.position.set(0, 1.1, 0); scene.add(sl); scene.add(sl.target);
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    el('resModelHost').appendChild(renderer.domElement);
    cam = new THREE.PerspectiveCamera(40, 280 / 230, 0.1, 100); cam.position.set(0, 1.5, 5.2); cam.lookAt(0, 1.1, 0);
  }
  function clear() { for (const g of groups) { scene.remove(g); disposeGroup(g); } groups.length = 0; }
  function show(winners) {
    init(); clear();
    const host = el('resModelHost'), w = host.clientWidth || 280, h = host.clientHeight || 230;
    renderer.setSize(w, h); cam.aspect = w / h; cam.updateProjectionMatrix();
    const n = winners.length, spread = n > 1 ? 1.8 : 0;
    winners.forEach((wn, i) => {
      const g = new THREE.Group(), isSelf = wn.id === (NET.active ? NET.selfId : 'me');
      const tex = skinCache[wn.id] || (isSelf ? mySkinTexture() : null) || defaultSkinTex;
      const mat = new THREE.MeshLambertMaterial({ map: tex });
      let armL = null, armR = null;
      buildCharacterModel(mat, (geo, material, x, y, z, name) => { const m = new THREE.Mesh(geo, material); m.position.set(x, y, z); g.add(m); if (name === 'armL') armL = m; if (name === 'armR') armR = m; return m; });
      if (armL) { armL.rotation.z = 2.2; armL.position.set(-0.42, 1.5, 0); }   // victory: arms thrown up
      if (armR) { armR.rotation.z = -2.2; armR.position.set(0.42, 1.5, 0); }
      const wk = wn.weapon || 'gg2';
      if (WEAPONS[wk] && !WEAPONS[wk].melee && !WEAPONS[wk].rc) { const gun = buildThirdPersonWeapon(wk); gun.position.set(0.6, 1.85, 0.15); gun.rotation.z = -0.7; g.add(gun); }   // weapon held high
      g.position.set((i - (n - 1) / 2) * spread, 0, 0); g.scale.setScalar(n > 1 ? 0.82 : 1);
      scene.add(g); groups.push(g);
    });
    cancelAnimationFrame(raf); loop();
  }
  function loop() { raf = requestAnimationFrame(loop); spin += 0.012; groups.forEach((g, i) => g.rotation.y = Math.sin(spin + i * 1.3) * 0.45); if (renderer) renderer.render(scene, cam); }
  function stop() { cancelAnimationFrame(raf); raf = 0; }
  return { show, stop };
})();

let _resCountdownT = null;
function weaponForRow(r) {
  if (r.id === (NET.active ? NET.selfId : 'me')) return mainGunKey();
  const rp = NET.active ? NET.players.get(r.id) : null; return (rp && rp.weapon) || r.lastWeapon || 'gg2';
}
function resultsWinnerList(result) {
  const rows = result.rows || scoreboardRows();
  if (result.team) return rows.filter(r => r.team === result.team).slice(0, 3).map(r => ({ id: r.id, name: r.name, weapon: weaponForRow(r) }));
  const top = rows[0] || { id: (NET.active ? NET.selfId : 'me'), name: 'YOU' };
  return [{ id: top.id, name: top.name, weapon: weaponForRow(top) }];
}
function buildResultCards(a) {
  const host = el('resCards'); if (!host) return; host.innerHTML = '';
  if (!a) return;
  const cards = [];
  if (a.mvp) cards.push(['mvp', '🏆', 'MVP — MOST KILLS', a.mvp.name, a.mvp.val + ' kills']);
  if (a.weapon) cards.push(['', weaponIcon(a.weapon.weapon), 'TOP ' + a.weapon.wname, a.weapon.name, a.weapon.val + ' kills']);
  if (a.streak) cards.push(['', '🔥', 'LONGEST KILLSTREAK', a.streak.name, a.streak.val + ' in a row']);
  if (a.melee) cards.push(['', '🔪', 'MOST MELEE KILLS', a.melee.name, a.melee.val + ' knives']);
  if (a.headshots) cards.push(['', '🎯', 'MOST HEADSHOTS', a.headshots.name, a.headshots.val + ' HS']);
  if (a.streakActs) cards.push(['', '⚡', 'MOST SCORESTREAKS', a.streakActs.name, a.streakActs.val + ' used']);
  cards.forEach((c, i) => {
    const d = document.createElement('div'); d.className = 'resCard' + (c[0] ? ' ' + c[0] : '');
    d.innerHTML = `<div class="rcIco">${c[1]}</div><div class="rcAward">${c[2]}</div><div class="rcName">${c[3]}</div><div class="rcVal">${c[4]}</div>`;
    host.appendChild(d);
    setTimeout(() => { d.classList.add('show'); sfxCardReveal(); }, 450 + i * 340);
  });
}
function resultsTableHTML() {
  const rows = scoreboardRows();
  if (gameMode === 'tdm') {
    const red = rows.filter(r => r.team === 'red'), blue = rows.filter(r => r.team === 'blue');
    red.forEach((r, i) => r.rank = i + 1); blue.forEach((r, i) => r.rank = i + 1);
    return `<div class="sbTeam red"><span>TEAM RED</span><span>${teamKills('red')}</span></div>` + _sbTable(red, false)
         + `<div class="sbTeam blue"><span>TEAM BLUE</span><span>${teamKills('blue')}</span></div>` + _sbTable(blue, false);
  }
  return _sbTable(rows, gameMode === 'gungame');
}
function resultsExtraHTML() {
  const rows = scoreboardRows(); let k = 0, d = 0, hs = 0, mk = 0, sa = 0;
  rows.forEach(r => { k += r.kills || 0; d += r.deaths || 0; hs += r.headshots || 0; mk += r.meleeKills || 0; sa += r.streakActs || 0; });
  const row = (a, b) => `<div class="seRow"><span>${a}</span><span>${b}</span></div>`;
  return `<h3 style="margin:0 0 6px">MATCH TOTALS</h3>` + row('Total kills', k) + row('Total deaths', d) + row('Total headshots', hs) + row('Total knife kills', mk) + row('Scorestreaks used', sa) + row('Players', rows.length);
}
function spawnConfetti(cols) {
  const host = el('resConfetti'); if (!host) return; host.innerHTML = '';
  for (let i = 0; i < 90; i++) {
    const p = document.createElement('div'); p.className = 'confetti';
    p.style.left = (Math.random() * 100) + 'vw'; p.style.background = cols[i % cols.length];
    const dur = 2.5 + Math.random() * 2.5; p.style.animationDuration = dur + 's'; p.style.animationDelay = (Math.random() * 0.8) + 's';
    host.appendChild(p); setTimeout(() => p.remove(), (dur + 1.2) * 1000);
  }
}
function hideResults() { clearInterval(_resCountdownT); ResultStage.stop(); const r = el('resultsScreen'); if (r) r.style.display = 'none'; const c = el('resConfetti'); if (c) c.innerHTML = ''; }
function resultsPlayAgain() {
  hideResults();
  if (gameMode === 'tdm') { showTeamSelect(!NET.active ? 'solo' : (NET.isHost ? 'host' : 'client')); return; }   // (Part 3) re-pick teams before a TDM rematch
  if (!NET.active) startMatch(); else if (NET.isHost) hostStartMatch();
}
function resultsToLobby() {
  hideResults();
  if (NET.active) { gameState.running = false; gameState.over = false; document.exitPointerLock && document.exitPointerLock(); showScreen('lobbyScreen'); }
  else leaveToMenu();
}
function showResultsScreen(result) {
  result = result || _matchResult || { rows: scoreboardRows() }; _matchResult = result;
  const wt = el('resWinner'), ws = el('resWinSub');
  if (result.br) {
    wt.textContent = result.won ? 'WINNER WINNER CHICKEN DINNER!' : ordinal(result.placement || 2) + ' PLACE';
    wt.style.color = result.won ? '#ffd34a' : '#ff8a4a';
    ws.textContent = (result.won ? 'Last one standing' : (result.winnerName ? result.winnerName.toUpperCase() + ' won' : 'Eliminated')) + ' • BATTLE ROYALE • ' + (BR.startCount || 10) + ' players';
  } else if (result.team) { wt.textContent = TEAMS[result.team].name + ' WINS!'; wt.style.color = TEAMS[result.team].css; ws.textContent = (result.byTime ? 'Time expired • ' : '') + matchSettingsSummary(); }
  else { const who = result.won ? 'YOU WIN!' : (result.winnerName ? result.winnerName.toUpperCase() + ' WINS!' : 'MATCH OVER'); wt.textContent = who; wt.style.color = '#ffd34a'; ws.textContent = (result.byTime ? 'Time expired • ' : '') + matchSettingsSummary(); }
  try { ResultStage.show(resultsWinnerList(result)); } catch (e) {}
  if (result.br) { if (el('resCards')) el('resCards').innerHTML = ''; } else buildResultCards(result.awards || computeAwards());
  el('resTable').innerHTML = result.br ? brResultsTableHTML() : resultsTableHTML();
  el('resStatsExtra').innerHTML = resultsExtraHTML(); el('resStatsExtra').style.display = 'none'; el('resStatsBtn').textContent = 'VIEW MATCH STATS';
  el('resAgain').style.display = (NET.active && NET.isClient) ? 'none' : '';
  spawnConfetti(result.team ? [TEAMS[result.team].css, '#ffffff', '#ffe600'] : (result.won ? ['#ffe600', '#ff5a5a', '#5aa6ff', '#fff'] : ['#5aa6ff', '#9fd0ff', '#ffffff']));
  setTimeout(() => { sfxApplause(); }, 240);
  el('resultsScreen').style.display = 'flex';
  document.exitPointerLock && document.exitPointerLock();
  let cd = 30; const cde = el('resCountdown'); if (cde) cde.textContent = 'Returning to lobby in ' + cd + 's…';
  clearInterval(_resCountdownT);
  _resCountdownT = setInterval(() => { cd--; if (cd <= 0) { clearInterval(_resCountdownT); resultsToLobby(); } else if (cde) cde.textContent = 'Returning to lobby in ' + cd + 's…'; }, 1000);
}
// Results-screen buttons
if (el('resAgain')) el('resAgain').onclick = () => resultsPlayAgain();
if (el('resLobby')) el('resLobby').onclick = () => resultsToLobby();
if (el('resStatsBtn')) el('resStatsBtn').onclick = () => { const e = el('resStatsExtra'); const open = e.style.display === 'none'; e.style.display = open ? 'block' : 'none'; el('resStatsBtn').textContent = open ? 'HIDE MATCH STATS' : 'VIEW MATCH STATS'; sfxClick(); };

/* ---- Lobby roster UI ---- */
function renderRoster() {
  const wrap = el('lobbyPlayers'); if (!wrap) return;
  const list = NET.rosterList();
  wrap.innerHTML = list.map(p =>
    `<div class="pl${p.id === NET.selfId ? ' me' : ''}" data-self="${p.id === NET.selfId}"><span>${p.id === NET.selfId ? p.name + ' (you) 🎨' : p.name}</span>${p.host ? '<span class="tag">HOST</span>' : ''}</div>`
  ).join('');
  // Click your own roster entry to open the skin creator.
  const meEl = wrap.querySelector('.pl[data-self="true"]');
  if (meEl) { meEl.style.cursor = 'pointer'; meEl.title = 'Customize your skin'; meEl.onclick = () => SkinCreator.open('lobbyScreen'); }
  if (typeof LobbyStage !== 'undefined') LobbyStage.refresh();   // re-render the 3D stage when the party changes
  updateLobbySettingsSummary();
}
function setNetStatus(id, text, isErr) {
  const e = el(id); if (!e) return; e.textContent = text; e.classList.toggle('err', !!isErr);
}

/* ---- Screen routing ---- */
function showScreen(id) {
  ['mainMenu', 'joinScreen', 'lobbyScreen', 'startScreen', 'settingsScreen', 'teamSelect'].forEach(s => el(s).classList.toggle('hidden', s !== id));
  el('endScreen').style.display = 'none';
  if (typeof LobbyStage !== 'undefined') { if (id === 'lobbyScreen') LobbyStage.open(); else LobbyStage.close(); }   // 3D character stage runs only in the lobby
  if (id !== '__none__') sfxMenu(true);   // soft swoosh on opening a menu (silent until audio is unlocked)
  if (typeof refreshModeUI === 'function') refreshModeUI();
}
function leaveToMenu() {
  cancelKillcam();
  scooterDismountAll(); scooters.forEach(sc => { if (sc.group) { scene.remove(sc.group); disposeGroup(sc.group); } }); scooters = []; myScooter = null;
  NET.reset();
  Ambient.stop();   // silence the in-match ambience back at the menu
  rcResetMatch();   // lock the RC launcher + clear any missiles when leaving to the lobby
  cigSmoking = false; cigCanceling = false; if (_cigVM) _cigVM.visible = false;
  invOpen = false; el('invMenu').classList.add('hidden');
  // wipe remote/client-bot state and any in-progress match
  bots.forEach(b => { if (b.group) { scene.remove(b.group); disposeGroup(b.group); } });
  bots.length = 0;
  gameState.running = false; gameState.over = false;
  document.exitPointerLock && document.exitPointerLock();
  el('lobbyStart').style.display = '';
  showScreen('mainMenu');
}

/* ---- Network tick: clients push their pose; the host relays everyone's poses + bots ---- */
function netTick(dt) {
  if (!NET.active) return;
  NET._sendAcc += dt; NET._botAcc += dt;
  if (NET.isClient) {
    if (NET._sendAcc >= 0.05) {                 // ~20 Hz
      NET._sendAcc = 0;
      const s = NET.selfSnapshot(); s.t = 'pmove';
      NET.route(NET.hostId, s);
    }
  } else if (NET.isHost) {
    if (NET._sendAcc >= 0.05) { NET._sendAcc = 0; NET.broadcastPlayers(); }
    if (NET._botAcc >= 0.066) { NET._botAcc = 0; NET.broadcastBots(); }     // ~15 Hz
    NET._pingAcc = (NET._pingAcc || 0) + dt;
    if (NET._pingAcc >= 2) { NET._pingAcc = 0; NET.broadcast({ t: 'ping', ts: performance.now() }); }   // RTT probe for the scoreboard PING column
  }
}

/* ---- Hold the Scoreboard key (default TAB) to see the live free-for-all scoreboard ---- */
document.addEventListener('keydown', (e) => {
  if (killcam.active && IM.codeAction(e.code) === 'jump') { e.preventDefault(); skipKillcam(); return; }   // Part 5: skip the killcam / respawn now
  if (IM.codeAction(e.code) === 'scoreboard' && gameState.running && !paused) { e.preventDefault(); refreshScoreboard(); el('scoreboard').style.display = 'flex'; }
});
document.addEventListener('keyup', (e) => {
  if (IM.codeAction(e.code) === 'scoreboard') { e.preventDefault(); el('scoreboard').style.display = 'none'; }
});

/* ============================================================================
   9e. SKIN CREATOR — paint the character model (own mini-renderer + tools)
   ============================================================================ */
/* ============================================================================
   LOBBY CHARACTER DISPLAY — a Fortnite-style waiting-room stage. Each player's
   character (custom skin + equipped main weapon + holstered karambit) stands on a
   low-poly platform with a name label + HOST badge, idle animation, and a 1s intro
   camera sweep. Click your own character to open the skin creator; click another to
   see their name + weapon. Separate scene/renderer that only runs while the lobby is
   open — reuses the already-synced skins (skinCache) + weapons (rosterList / ffaMain).
   ============================================================================ */
let _mySkinTex = null, _mySkinURL = null;
function mySkinTexture() {   // the LOCAL player's custom skin as a live texture (or the blank mannequin)
  const url = (typeof mySkinDataURL === 'function') ? mySkinDataURL() : null;
  if (!url) return defaultSkinTex;
  if (url !== _mySkinURL) { _mySkinURL = url; _mySkinTex = new THREE.Texture(); if (THREE.SRGBColorSpace !== undefined) _mySkinTex.colorSpace = THREE.SRGBColorSpace; const img = new Image(); img.onload = () => { _mySkinTex.image = img; _mySkinTex.needsUpdate = true; }; img.src = url; }
  return _mySkinTex || defaultSkinTex;
}
const LobbyStage = (() => {
  let inited = false, isOpen = false, renderer, scene, cam, raf = 0, sweep = 0;
  const chars = [], ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  function init() {
    if (inited) return; inited = true;
    scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xdfe8ff, 0x20242e, 1.05));
    const dl = new THREE.DirectionalLight(0xfff0d8, 0.85); dl.position.set(4, 8, 6); scene.add(dl);
    const dl2 = new THREE.DirectionalLight(0x6a8cff, 0.4); dl2.position.set(-5, 3, -4); scene.add(dl2);
    const plat = new THREE.Mesh(new THREE.CylinderGeometry(7, 7.5, 0.5, 36), new THREE.MeshLambertMaterial({ color: 0x232a36, flatShading: true })); plat.position.y = -0.25; scene.add(plat);
    const ring = new THREE.Mesh(new THREE.TorusGeometry(6.8, 0.08, 8, 44), new THREE.MeshBasicMaterial({ color: 0x4a7aff })); ring.rotation.x = Math.PI / 2; ring.position.y = 0.02; scene.add(ring);
    const host = el('lobbyStage');
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    host.insertBefore(renderer.domElement, host.firstChild);
    cam = new THREE.PerspectiveCamera(42, 2, 0.1, 100);
    renderer.domElement.addEventListener('click', onClick);
  }
  function resize() { const host = el('lobbyStage'); if (!host || !renderer) return; const w = host.clientWidth || 700, h = host.clientHeight || 290; renderer.setSize(w, h); cam.aspect = w / h; cam.updateProjectionMatrix(); }
  function makeLabel(text, isHost) {
    const c = document.createElement('canvas'); c.width = 256; c.height = 64; const x = c.getContext('2d');
    x.textAlign = 'center'; x.lineWidth = 5; x.strokeStyle = '#000';
    x.font = 'bold 28px Segoe UI, sans-serif'; x.fillStyle = '#fff'; x.strokeText(text, 128, 30); x.fillText(text, 128, 30);
    if (isHost) { x.font = 'bold 16px Segoe UI'; x.fillStyle = '#ffd34a'; x.strokeText('★ HOST', 128, 54); x.fillText('★ HOST', 128, 54); }
    return new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(c), transparent: true, depthTest: false }));
  }
  function clearChars() { for (const c of chars) { scene.remove(c.group); disposeGroup(c.group); } chars.length = 0; }
  function build() {
    if (!inited) return; clearChars();
    const self = NET.selfId || 'me';
    const list = NET.active ? NET.rosterList() : [{ id: self, name: NET.selfName || 'YOU', host: true }];
    const n = list.length, spread = n > 1 ? Math.min(2.0, 11 / (n - 1)) : 0;
    list.forEach((p, i) => {
      const g = new THREE.Group(), isSelf = (p.id === self);
      const skinTex = skinCache[p.id] || (isSelf ? mySkinTexture() : null) || defaultSkinTex;
      const mat = new THREE.MeshLambertMaterial({ map: skinTex });
      let head = null;
      buildCharacterModel(mat, (geo, material, x, y, z, name) => { const m = new THREE.Mesh(geo, material); m.position.set(x, y, z); g.add(m); if (name === 'head') head = m; return m; });
      const wk = isSelf ? mainGunKey() : ((NET.players.get(p.id) || {}).weapon || ffaMain || 'gg2');
      if (WEAPONS[wk] && !WEAPONS[wk].melee && !WEAPONS[wk].rc) { const w = buildThirdPersonWeapon(wk); w.position.set(0.42, 1.26, 0.34); g.add(w); }   // equipped main weapon
      const kar = buildThirdPersonWeapon('karambit', isSelf ? meleeChoice : ((NET.players.get(p.id) || {}).mc || 'karambit')); kar.position.set(-0.46, 0.95, 0.12); kar.scale.setScalar(0.7); g.add(kar);   // holstered melee (their chosen knife)
      const label = makeLabel(p.name + (isSelf ? ' (you)' : ''), p.host); label.scale.set(2.3, 0.58, 1); label.position.y = 2.55; g.add(label);
      const x = (i - (n - 1) / 2) * spread;
      g.position.set(x, 0, 0); g.userData = { id: p.id, self: isSelf, phase: Math.random() * 6.28, head, baseRot: Math.PI - x * 0.06 }; g.rotation.y = g.userData.baseRot;   // FRONT faces the camera (flipped 180°) so faces/skins/weapons are visible
      scene.add(g); chars.push({ group: g, id: p.id, name: p.name, weapon: wk });
    });
    resize();
  }
  function onClick(e) {
    if (!renderer) return;
    const r = renderer.domElement.getBoundingClientRect();
    ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    ray.setFromCamera(ndc, cam);
    for (const c of chars) {
      if (ray.intersectObject(c.group, true).length) {
        if (c.group.userData.self) SkinCreator.open('lobbyScreen');   // your own character → skin creator
        else setNetStatus('lobbyStatus', c.name + ' — ' + ((WEAPONS[c.weapon] && WEAPONS[c.weapon].name) || 'WEAPON'));   // others → name + weapon
        return;
      }
    }
  }
  function loop() {
    raf = requestAnimationFrame(loop);
    const t = performance.now() / 1000;
    for (const c of chars) { const u = c.group.userData; c.group.position.y = Math.sin(t * 1.6 + u.phase) * 0.03; c.group.rotation.y = u.baseRot + Math.sin(t * 0.5 + u.phase) * 0.08; if (u.head) u.head.rotation.y = Math.sin(t * 0.35 + u.phase) * 0.4; }   // idle breathe + sway + head turn
    if (sweep > 0) sweep = Math.max(0, sweep - 0.016);
    const k = sweep; cam.position.set(-k * 9, 2.4 + k * 0.8, 10 - k * 1.2); cam.lookAt(0, 1.15, 0);   // 1s intro sweep, then settle
    if (renderer) renderer.render(scene, cam);
  }
  return {
    open() { try { init(); build(); isOpen = true; sweep = 1.0; resize(); if (!raf) loop(); } catch (e) {} },
    refresh() { if (isOpen) { try { build(); } catch (e) {} } },
    close() { isOpen = false; if (raf) { cancelAnimationFrame(raf); raf = 0; } if (inited) clearChars(); }
  };
})();

const SkinCreator = (() => {
  let inited = false, open = false, returnScreen = 'mainMenu', dirty = false;
  let renderer, scene, cam, char, raf = 0, spinIn = 0;
  let yaw = 0.4, pitch = 0.1, dist = 3.4;
  let canvas, ctx, tex, mat;                       // the paint canvas (512) + its texture/material
  let tool = 'marker', size = 18, color = '#e0392b';
  let painting = false, rotating = false, lastUV = null, lastM = { x: 0, y: 0 };
  let selSlot = 0;
  let stampImg = null, stampSize = 90, stampRot = 0, stampOpacity = 1;   // image-upload stamp state (Part 1)
  const UPLOADS_KEY = 'skinUploads_v1';
  const undoStack = [], redoStack = [];
  const ray = new THREE.Raycaster(), ndc = new THREE.Vector2();
  const PALETTE = ['#000000','#ffffff','#7f7f7f','#e0392b','#ff8c1a','#ffe600','#34d058','#1ca3ec',
                   '#2b50c8','#9b59ff','#ff7bd5','#7a4a1e','#3a2a1a','#0a5a2a','#0a2a5a','#d8d8d8'];

  function init() {
    if (inited) return; inited = true;
    canvas = makeBlankSkinCanvas(); ctx = canvas.getContext('2d');
    tex = new THREE.CanvasTexture(canvas);
    if (THREE.SRGBColorSpace !== undefined) tex.colorSpace = THREE.SRGBColorSpace;
    mat = new THREE.MeshLambertMaterial({ map: tex });
    scene = new THREE.Scene(); scene.background = new THREE.Color(0x1a2230);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x55606e, 1.0));
    const dl = new THREE.DirectionalLight(0xffffff, 0.7); dl.position.set(3, 6, 4); scene.add(dl);
    const grp = new THREE.Group();
    char = buildCharacterModel(mat, (geo, material, x, y, z, name) => {
      const m = new THREE.Mesh(geo, material); m.position.set(x, y, z); m.userData = { skPart: name }; grp.add(m); return m;
    });
    grp._parts = char; scene.add(grp); scene._charGrp = grp;
    const stage = el('skStage');
    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    stage.insertBefore(renderer.domElement, stage.firstChild);
    cam = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    bindStage(); buildPalette(); buildTemplates(); wireTools();
  }
  function resize() {
    const stage = el('skStage'), w = stage.clientWidth, h = stage.clientHeight;
    renderer.setSize(w, h); cam.aspect = w / h; cam.updateProjectionMatrix();
  }
  function loop() {
    raf = requestAnimationFrame(loop);
    if (spinIn > 0) { spinIn -= 0.016; yaw += 0.05; }       // intro spin-in
    const cy = 1.1;
    cam.position.set(Math.sin(yaw) * dist, cy + pitch * 2.2, Math.cos(yaw) * dist);
    cam.lookAt(0, cy, 0);
    renderer.render(scene, cam);
  }

  /* ---- painting ---- */
  function snapshot() { undoStack.push(ctx.getImageData(0, 0, SKIN_RES, SKIN_RES)); if (undoStack.length > 22) undoStack.shift(); redoStack.length = 0; }
  function hitUV(e) {
    const r = renderer.domElement.getBoundingClientRect();
    ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    ray.setFromCamera(ndc, cam);
    const hit = ray.intersectObjects(scene._charGrp.children, false)[0];
    return hit ? { uv: hit.uv, part: hit.object.userData.skPart } : null;
  }
  function stamp(px, py) {
    if (tool === 'spray') {
      ctx.fillStyle = color; ctx.globalAlpha = 0.16;
      for (let i = 0; i < size * 1.2; i++) { const a = Math.random() * 6.283, rr = Math.random() * size; ctx.beginPath(); ctx.arc(px + Math.cos(a) * rr, py + Math.sin(a) * rr, 1.1, 0, 6.283); ctx.fill(); }
      ctx.globalAlpha = 1;
    } else if (tool === 'pen') {
      ctx.fillStyle = color; ctx.beginPath(); ctx.arc(px, py, Math.max(1, size * 0.22), 0, 6.283); ctx.fill();
    } else {                                                 // marker / eraser (soft round)
      const col = tool === 'eraser' ? '#d8d8d8' : color, g = ctx.createRadialGradient(px, py, 0, px, py, size);
      g.addColorStop(0, col); g.addColorStop(0.7, col); g.addColorStop(1, col + (tool === 'eraser' ? '' : '00'));
      ctx.fillStyle = (tool === 'eraser') ? col : g;
      ctx.beginPath(); ctx.arc(px, py, size, 0, 6.283); ctx.fill();
    }
  }
  let _brushT = 0;
  function paint(e) {
    const h = hitUV(e); if (!h) { lastUV = null; return; }
    const now = performance.now(); if (now - _brushT > 90) { _brushT = now; sfxSkinBrush(); }   // soft brush whisper (throttled)
    const px = h.uv.x * SKIN_RES, py = (1 - h.uv.y) * SKIN_RES;
    if (lastUV && Math.abs(h.uv.x - lastUV.x) < 0.1 && Math.abs(h.uv.y - lastUV.y) < 0.1) {
      const lpx = lastUV.x * SKIN_RES, lpy = (1 - lastUV.y) * SKIN_RES, steps = Math.ceil(Math.hypot(px - lpx, py - lpy) / 3);
      for (let i = 1; i <= steps; i++) stamp(lpx + (px - lpx) * i / steps, lpy + (py - lpy) * i / steps);
    } else stamp(px, py);
    lastUV = { x: h.uv.x, y: h.uv.y }; tex.needsUpdate = true; dirty = true;
  }
  function fillAt(e) {                                       // bucket: flood-fill within the clicked body part's cell
    const h = hitUV(e); if (!h) return; snapshot();
    const cell = SKIN_CELLS[h.part], x0 = Math.floor(cell[0] * SKIN_RES), y0 = Math.floor(cell[1] * SKIN_RES);
    const x1 = Math.floor((cell[0] + CELL_W) * SKIN_RES), y1 = Math.floor((cell[1] + CELL_H) * SKIN_RES);
    const sx = Math.floor(h.uv.x * SKIN_RES), sy = Math.floor((1 - h.uv.y) * SKIN_RES);
    floodFill(sx, sy, color, x0, y0, x1, y1); tex.needsUpdate = true; dirty = true;
  }
  function floodFill(sx, sy, hex, x0, y0, x1, y1) {
    const img = ctx.getImageData(0, 0, SKIN_RES, SKIN_RES), d = img.data, W = SKIN_RES;
    const at = (x, y) => (y * W + x) * 4;
    const si = at(sx, sy), tr = d[si], tg = d[si + 1], tb = d[si + 2];
    const nr = parseInt(hex.slice(1, 3), 16), ng = parseInt(hex.slice(3, 5), 16), nb = parseInt(hex.slice(5, 7), 16);
    if (tr === nr && tg === ng && tb === nb) return;
    const match = (i) => Math.abs(d[i] - tr) < 24 && Math.abs(d[i + 1] - tg) < 24 && Math.abs(d[i + 2] - tb) < 24;
    const stack = [[sx, sy]];
    while (stack.length) {
      const [x, y] = stack.pop(); if (x < x0 || y < y0 || x >= x1 || y >= y1) continue;
      const i = at(x, y); if (!match(i)) continue;
      d[i] = nr; d[i + 1] = ng; d[i + 2] = nb; d[i + 3] = 255;
      stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
    }
    ctx.putImageData(img, 0, 0);
  }

  /* ---- templates ---- */
  function template(name) {
    snapshot();
    ctx.fillStyle = (name === 'solid') ? color : '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES);
    if (name === 'camo') {
      const cols = ['#4a5d23', '#3a4a1a', '#6b7a3a', '#2a3312'];
      for (let i = 0; i < 220; i++) { ctx.fillStyle = cols[i % 4]; ctx.beginPath(); ctx.ellipse(Math.random() * SKIN_RES, Math.random() * SKIN_RES, 14 + Math.random() * 22, 10 + Math.random() * 16, Math.random() * 3, 0, 6.283); ctx.fill(); }
    } else if (name === 'stripes') {
      for (let x = 0; x < SKIN_RES; x += 26) { ctx.fillStyle = (x / 26) % 2 ? '#222' : color; ctx.fillRect(x, 0, 26, SKIN_RES); }
    } else if (name === 'skull') {
      const c = SKIN_CELLS.head, hx = c[0] * SKIN_RES, hy = c[1] * SKIN_RES, hw = CELL_W * SKIN_RES, hh = CELL_H * SKIN_RES;
      ctx.fillStyle = '#111'; ctx.fillRect(hx, hy, hw, hh);
      ctx.fillStyle = '#eee'; ctx.font = 'bold ' + (hh * 0.7) + 'px serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      for (let f = 0; f < 6; f++) { const col = f % 3, row = (f / 3) | 0; ctx.fillText('☠', hx + (col + 0.5) * hw / 3, hy + (row + 0.5) * hh / 2); }
    }
    tex.needsUpdate = true; dirty = true;
  }

  /* ---- slots / storage ---- */
  function renderSlots() {
    const store = loadSkinStore(), host = el('skSlots'); host.innerHTML = '';
    for (let i = 0; i < 5; i++) {
      const sl = document.createElement('div'); sl.className = 'slot' + (i === selSlot ? ' sel' : '');
      const data = store.slots[i];
      if (data) { sl.classList.add('filled'); sl.style.backgroundImage = `url(${data.data})`; sl.title = data.name; sl.textContent = ''; }
      else sl.textContent = 'slot ' + (i + 1);
      sl.onclick = () => { selSlot = i; if (store.slots[i]) { snapshot(); loadDataURLToCanvas(store.slots[i].data); el('skName').value = store.slots[i].name || ''; } renderSlots(); };
      host.appendChild(sl);
    }
  }
  function loadDataURLToCanvas(url) {
    const img = new Image(); img.onload = () => { ctx.fillStyle = '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES); ctx.drawImage(img, 0, 0, SKIN_RES, SKIN_RES); tex.needsUpdate = true; }; img.src = url;
  }
  function saveAndUse() {
    const store = loadSkinStore();
    const url = canvas.toDataURL('image/png');
    store.slots[selSlot] = { name: (el('skName').value || ('Skin ' + (selSlot + 1))).slice(0, 16), data: url };
    store.active = selSlot; saveSkinStore(store);
    dirty = false; el('skStatus').textContent = 'Saved & active ✓';
    sfxSkinSave();   // confirmation chime
    // Make it our live skin + push to peers.
    if (NET.active) { skinDataCache[NET.selfId] = url; NET.broadcastSkin(); }
    renderSlots();
  }

  /* ---- input wiring ---- */
  function bindStage() {
    const dom = renderer.domElement, cur = el('skBrushCursor');
    dom.addEventListener('contextmenu', e => e.preventDefault());
    dom.addEventListener('pointerdown', e => {
      if (e.button === 2) { rotating = true; lastM = { x: e.clientX, y: e.clientY }; }
      else if (e.button === 0) {
        if (tool === 'fill') fillAt(e);
        else if (tool === 'stamp') { if (stampImg) { snapshot(); stampImageAt(e); } }
        else { snapshot(); painting = true; lastUV = null; paint(e); }
      }
    });
    window.addEventListener('pointermove', e => {
      if (!open) return;
      const r = dom.getBoundingClientRect();
      if (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) {
        cur.style.display = (tool === 'fill') ? 'none' : 'block'; cur.style.left = (e.clientX - r.left) + 'px'; cur.style.top = (e.clientY - r.top) + 'px';
        if (tool === 'stamp' && stampImg) {                       // stamp mode: cursor previews the image at the stamp size
          cur.classList.add('stamp'); cur.style.backgroundImage = 'url(' + stampImg.src + ')';
          const sp = stampSize * (r.width / SKIN_RES); cur.style.width = cur.style.height = Math.max(8, sp) + 'px';
        } else {
          cur.classList.remove('stamp'); cur.style.backgroundImage = '';
          const px = (tool === 'pen' ? size * 0.44 : size * 2) * (r.width / renderer.domElement.width * window.devicePixelRatio || 1);
          cur.style.width = cur.style.height = Math.max(4, px) + 'px';
        }
      } else cur.style.display = 'none';
      if (rotating) { yaw -= (e.clientX - lastM.x) * 0.01; pitch = Math.max(-0.8, Math.min(0.8, pitch - (e.clientY - lastM.y) * 0.01)); lastM = { x: e.clientX, y: e.clientY }; }
      else if (painting) paint(e);
    });
    window.addEventListener('pointerup', () => { painting = false; rotating = false; lastUV = null; });
    dom.addEventListener('wheel', e => { e.preventDefault(); dist = Math.max(1.6, Math.min(7, dist + e.deltaY * 0.002)); }, { passive: false });
  }
  function buildPalette() {
    const host = el('skPalette');
    PALETTE.forEach(c => { const s = document.createElement('div'); s.className = 'sw'; s.style.background = c; s.onclick = () => setColor(c); host.appendChild(s); });
  }
  function buildTemplates() { el('skTemplates').querySelectorAll('.skTpl').forEach(b => b.onclick = () => template(b.dataset.tpl)); }
  function setColor(c) { color = c; el('skColor').value = c; el('skSwatch').style.background = c; }
  function setTool(t) { if (t === 'stamp' && !stampImg) return; tool = t; el('skTools').querySelectorAll('.skTool').forEach(b => b.classList.toggle('sel', b.dataset.tool === t)); el('skStampOpts').classList.toggle('on', t === 'stamp'); }
  /* ---- image upload + stamps (Part 1) ---- */
  function loadUploads() { try { const a = JSON.parse(localStorage.getItem(UPLOADS_KEY)); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function saveUploads(a) { try { localStorage.setItem(UPLOADS_KEY, JSON.stringify(a.slice(-5))); } catch (e) {} }
  function renderGallery() {
    const host = el('skGallery'), ups = loadUploads(); host.innerHTML = '';
    ups.forEach((url, i) => {
      const th = document.createElement('div'); th.className = 'skGalThumb' + (stampImg && stampImg.src === url ? ' sel' : ''); th.style.backgroundImage = 'url(' + url + ')'; th.title = 'Click to stamp this image';
      th.onclick = () => selectStamp(url);
      const x = document.createElement('div'); x.className = 'x'; x.textContent = '×';
      x.onclick = (ev) => { ev.stopPropagation(); const a = loadUploads(); a.splice(i, 1); saveUploads(a); renderGallery(); };
      th.appendChild(x); host.appendChild(th);
    });
  }
  function selectStamp(url) {
    stampImg = new Image(); stampImg.onload = renderGallery; stampImg.src = url;
    el('skStampTool').disabled = false; el('skUseBase').disabled = false;
    setTool('stamp'); renderGallery();
  }
  function processUpload(file) {
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { el('skStatus').textContent = 'Image must be under 5 MB'; sfxNotify(); return; }
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const cap = 512, sc = Math.min(1, cap / Math.max(img.width, img.height));   // downscale to 512px max (keeps aspect)
        const w = Math.max(1, Math.round(img.width * sc)), h = Math.max(1, Math.round(img.height * sc));
        const cv = document.createElement('canvas'); cv.width = w; cv.height = h; cv.getContext('2d').drawImage(img, 0, 0, w, h);
        const png = cv.toDataURL('image/png');               // convert to PNG internally (preserves transparency)
        const a = loadUploads(); a.push(png); saveUploads(a); selectStamp(png);
        el('skStatus').textContent = 'Image ready — Stamp it on, or Use as Base';
      };
      img.onerror = () => { el('skStatus').textContent = 'Could not read that image'; };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
  }
  function stampImageAt(e) {
    const h = hitUV(e); if (!h || !stampImg) return;
    const px = h.uv.x * SKIN_RES, py = (1 - h.uv.y) * SKIN_RES;
    const iw = stampImg.width || 1, ih = stampImg.height || 1, sc = stampSize / Math.max(iw, ih), w = iw * sc, hh = ih * sc;
    ctx.save(); ctx.globalAlpha = stampOpacity; ctx.translate(px, py); ctx.rotate(stampRot * Math.PI / 180);
    ctx.drawImage(stampImg, -w / 2, -hh / 2, w, hh); ctx.restore(); ctx.globalAlpha = 1;
    tex.needsUpdate = true; dirty = true; sfxSkinBrush();
  }
  function useAsBase() {
    if (!stampImg) return;
    if (!confirm('Replace current skin with this image as base? Current paint will be lost.')) return;
    snapshot(); ctx.fillStyle = '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES); ctx.drawImage(stampImg, 0, 0, SKIN_RES, SKIN_RES);
    tex.needsUpdate = true; dirty = true; el('skStatus').textContent = 'Applied as base — paint on top';
  }
  function wireTools() {
    el('skTools').querySelectorAll('.skTool').forEach(b => b.onclick = () => setTool(b.dataset.tool));
    el('skSize').oninput = e => { size = +e.target.value; el('skSizeVal').textContent = size; };
    el('skColor').oninput = e => setColor(e.target.value);
    el('skUndo').onclick = () => { if (!undoStack.length) return; redoStack.push(ctx.getImageData(0, 0, SKIN_RES, SKIN_RES)); ctx.putImageData(undoStack.pop(), 0, 0); tex.needsUpdate = true; };
    el('skRedo').onclick = () => { if (!redoStack.length) return; undoStack.push(ctx.getImageData(0, 0, SKIN_RES, SKIN_RES)); ctx.putImageData(redoStack.pop(), 0, 0); tex.needsUpdate = true; };
    el('skClear').onclick = () => { if (confirm('Erase all paint?')) { snapshot(); ctx.fillStyle = '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES); tex.needsUpdate = true; dirty = true; } };
    el('skSave').onclick = saveAndUse;
    el('skClose').onclick = close;
    // image upload + stamp controls (Part 1)
    el('skUpload').onclick = () => el('skFile').click();
    el('skFile').onchange = (e) => { processUpload(e.target.files && e.target.files[0]); e.target.value = ''; };
    el('skUseBase').onclick = useAsBase;
    el('skStampSize').oninput = e => { stampSize = +e.target.value; el('skStampSizeVal').textContent = stampSize; };
    el('skStampRot').oninput = e => { stampRot = +e.target.value; el('skStampRotVal').textContent = stampRot; };
    el('skStampOpac').oninput = e => { stampOpacity = (+e.target.value) / 100; el('skStampOpacVal').textContent = e.target.value; };
  }

  function openCreator(ret) {
    returnScreen = ret || 'mainMenu'; init();
    el('skinCreator').classList.remove('hidden');
    open = true; dirty = false; spinIn = 0.9;
    const store = loadSkinStore(); selSlot = store.active >= 0 ? store.active : 0;
    if (store.active >= 0 && store.slots[store.active]) { loadDataURLToCanvas(store.slots[store.active].data); el('skName').value = store.slots[store.active].name || ''; }
    else { ctx.fillStyle = '#d8d8d8'; ctx.fillRect(0, 0, SKIN_RES, SKIN_RES); tex.needsUpdate = true; el('skName').value = ''; }
    setColor(color); if (tool === 'stamp' && !stampImg) tool = 'marker'; setTool(tool); el('skSizeVal').textContent = size; renderSlots(); renderGallery(); el('skStatus').textContent = '';
    resize(); if (!raf) loop();
  }
  function close() {
    if (dirty && !confirm('Discard unsaved changes?')) return;
    open = false; if (raf) { cancelAnimationFrame(raf); raf = 0; }
    el('skinCreator').classList.add('hidden');
    if (returnScreen === '__resume') { /* opened from settings mid-session: just go back to menu */ showScreen('mainMenu'); }
    else showScreen(returnScreen);
  }
  window.addEventListener('resize', () => { if (open) resize(); });
  return { open: openCreator };
})();

/* ============================================================================
   PART 2 — WEAPON CUSTOMIZATION UI: rotatable 3D preview + sight/mag/laser/flashlight
   options (per-weapon restrictions), live preview, RESET. Opened from the Settings
   WEAPONS tab (weapon grid) or the inventory CUSTOMIZE button.
   ============================================================================ */
const WeaponCustom = (() => {
  let inited = false, renderer, scene, cam, raf = 0, gun = null, gwrap = null, laserLine = null, flashCone = null, spin = 0;
  let key = null, ret = 'settingsScreen', editCfg = null, cat = 'sight';
  let rotating = false, lastX = 0, lastY = 0, manualYaw = 0, manualPitch = 0;
  function init() {
    if (inited) return; inited = true;
    scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xdfe8ff, 0x20242e, 1.15));
    const dl = new THREE.DirectionalLight(0xffffff, 0.85); dl.position.set(3, 5, 4); scene.add(dl);
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true }); renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    el('wcStage').appendChild(renderer.domElement);
    cam = new THREE.PerspectiveCamera(40, 1.6, 0.1, 100); cam.position.set(0.15, 0.15, 2.2); cam.lookAt(0, -0.12, -0.4);
    const dom = renderer.domElement;
    dom.addEventListener('pointerdown', e => { rotating = true; lastX = e.clientX; lastY = e.clientY; });
    window.addEventListener('pointermove', e => { if (!rotating) return; manualYaw -= (e.clientX - lastX) * 0.01; manualPitch = Math.max(-0.8, Math.min(0.8, manualPitch + (e.clientY - lastY) * 0.01)); lastX = e.clientX; lastY = e.clientY; });
    window.addEventListener('pointerup', () => rotating = false);
  }
  function resize() { const s = el('wcStage'), w = s.clientWidth || 600, h = s.clientHeight || 360; renderer.setSize(w, h); cam.aspect = w / h; cam.updateProjectionMatrix(); }
  function buildPreview() {
    if (gwrap) { scene.remove(gwrap); disposeGroup(gwrap); gwrap = gun = laserLine = flashCone = null; }
    const built = buildWeaponMesh(key, undefined, editCfg);   // FP mesh built with the in-progress config
    gun = built.g; gwrap = new THREE.Group(); gwrap.add(gun); scene.add(gwrap);
    const mz = built.muzzleZ || -0.6;
    if (editCfg.laser && editCfg.laser !== 'off') {
      const geo = new THREE.BufferGeometry(); geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array([0, -0.05, mz, 0, -0.05, mz - 3]), 3));
      laserLine = new THREE.Line(geo, new THREE.LineBasicMaterial({ color: laserHex(editCfg.laser === 'green' ? 'green' : 'red'), transparent: true, opacity: 0.7 })); gun.add(laserLine);
    }
    if (editCfg.flashlight === 'on') {
      flashCone = new THREE.Mesh(new THREE.ConeGeometry(0.55, 2.4, 16, 1, true), new THREE.MeshBasicMaterial({ color: 0xfff6d8, transparent: true, opacity: 0.13, side: THREE.DoubleSide, depthWrite: false }));
      flashCone.position.set(-0.07, -0.02, mz - 1.2); flashCone.rotation.x = -Math.PI / 2; gun.add(flashCone);
    }
  }
  function loop() { raf = requestAnimationFrame(loop); spin += 0.008; if (gwrap) { gwrap.rotation.y = spin + manualYaw; gwrap.rotation.x = manualPitch; } renderer.render(scene, cam); }
  function renderCats(c) {
    cat = c; el('wcCats').querySelectorAll('.wcCat').forEach(b => b.classList.toggle('sel', b.dataset.cat === c));
    const host = el('wcOptions'); host.innerHTML = ''; const opts = [];
    if (c === 'sight') { const al = sightAllowed(key); ['iron', 'red_dot', 'acog', 'holo', 'sniper', 'thermal'].forEach(s => opts.push([s, ATT_SIGHTS[s].name, '', al.indexOf(s) >= 0])); }
    else if (c === 'magazine') { const al = magAllowed(key); ['standard', 'extended', 'drum'].forEach(m => opts.push([m, ATT_MAGS[m].name, '×' + ATT_MAGS[m].mult + ' capacity', al.indexOf(m) >= 0])); }
    else if (c === 'laser') { ['off', 'red', 'green'].forEach(l => opts.push([l, ATT_LASERS[l] + ' Laser', '', true])); }
    else { ['off', 'on'].forEach(f => opts.push([f, ATT_FLASH[f] === 'Off' ? 'Off' : 'White Flashlight', '', true])); }
    opts.forEach(o => {
      const id = o[0], b = document.createElement('button');
      b.className = 'wcOpt' + (editCfg[c] === id ? ' sel' : '') + (o[3] ? '' : ' locked');
      b.innerHTML = o[1] + (o[2] ? '<small>' + o[2] + '</small>' : '');
      if (!o[3]) b.title = 'Not compatible with this weapon';
      else b.onclick = () => { editCfg[c] = id; setCfg(key, Object.assign({}, editCfg)); buildPreview(); renderCats(c); sfxClick(); };
      host.appendChild(b);
    });
  }
  function open(k, retScreen) {
    if (!isCustomizable(k)) { sfxStreakDenied(); return; }
    init(); key = k; ret = retScreen || 'settingsScreen'; editCfg = Object.assign({}, getCfg(k));
    el('wcName').textContent = (WEAPONS[k] && WEAPONS[k].name) || k;
    el('weaponCustom').classList.remove('hidden'); manualYaw = 0; manualPitch = 0; spin = 0;
    buildPreview(); renderCats('sight'); resize(); if (!raf) loop();
  }
  function close() {
    el('weaponCustom').classList.add('hidden'); if (raf) { cancelAnimationFrame(raf); raf = 0; }
    applyWeaponMag(key);
    if (ret && ret !== 'inventory') showScreen(ret);   // inventory: just reveal the still-open inventory overlay behind us
  }
  function resetCur() { resetCfg(key); editCfg = Object.assign({}, getCfg(key)); buildPreview(); renderCats(cat); sfxClick(); }
  el('wcClose').onclick = close; el('wcReset').onclick = resetCur;
  el('wcCats').querySelectorAll('.wcCat').forEach(b => b.onclick = () => renderCats(b.dataset.cat));
  window.addEventListener('resize', () => { if (!el('weaponCustom').classList.contains('hidden')) resize(); });
  return { open };
})();
// Settings "WEAPONS" tab: a grid of customizable weapons to pick from.
function renderWeaponGrid() {
  const host = el('wcWeaponGrid'); if (!host) return; host.innerHTML = '';
  Object.keys(WPN_CLASS).forEach(k => { const b = document.createElement('button'); b.textContent = (WEAPONS[k] && WEAPONS[k].name) || k; b.onclick = () => { WeaponCustom.open(k, 'settingsScreen'); sfxClick(); }; host.appendChild(b); });
}

/* ============================================================================
   10. GAME LOOP
   ============================================================================ */
/* ============================================================================
   PART 7 — MOBILITY SCOOTERS (Walmart-style, two NOS tanks). FOUR spawn on the
   map; mount with the interact key, drive WASD, hold SPACE for INFINITE NOS,
   fire while seated. 200 HP each, respawn 60s after destruction. The occupant
   owns its physics + broadcasts state; the host owns idle scooters.
   ============================================================================ */
const SCOOTER = { base: 4.2, reverse: 2.2, turn: 1.9, nosSpeed: 17, hp: 200, respawn: 60, mountDist: 3.6, seatEye: 1.0 };
const SCOOTER_SPAWNS = [
  new THREE.Vector3(8, 0, 50),    // yellow house front yard (north)
  new THREE.Vector3(-8, 0, -50),  // teal house front yard (south)
  new THREE.Vector3(-46, 0, 6),   // near the castle entrance (west flank)
  new THREE.Vector3(6, 0, 2)      // central street between the bus + car
];
function scooterOwns(sc) { return !NET.active || (sc && (sc.occupant ? sc.occupant === NET.selfId : NET.isHost)); }
function _scLed(sc, line1, line2, color) {
  const u = sc && sc.group && sc.group.userData; if (!u || !u.ledCtx) return;
  const c = u.ledCtx; c.fillStyle = '#0a0400'; c.fillRect(0, 0, 128, 64);
  c.fillStyle = color || '#ff5a3c'; c.textAlign = 'center'; c.font = 'bold 22px monospace'; c.fillText(line1, 64, 27);
  c.font = 'bold 18px monospace'; c.fillText(line2 || '', 64, 52); u.ledTex.needsUpdate = true;
}
function buildScooterModel() {
  const grp = new THREE.Group(); grp.userData = {};
  const dark = new THREE.MeshLambertMaterial({ color: 0x222831, flatShading: true });
  const blue = new THREE.MeshLambertMaterial({ color: 0x2a6fdf, flatShading: true });
  const black = new THREE.MeshLambertMaterial({ color: 0x111316, flatShading: true });
  const chrome = new THREE.MeshLambertMaterial({ color: 0x9aa6b2, flatShading: true });
  const deck = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.22, 1.9), dark); deck.position.y = 0.5; deck.userData = { scooter: true }; grp.add(deck);
  const body = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.42, 1.2), blue); body.position.set(0, 0.72, -0.1); body.userData = { scooter: true }; grp.add(body);
  const wheels = [];
  [[-0.55, -0.8], [0.55, -0.8], [-0.55, 0.8], [0.55, 0.8]].forEach(([wx, wz]) => { const w = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.3, 0.18, 12), black); w.rotation.z = Math.PI / 2; w.position.set(wx, 0.3, wz); grp.add(w); wheels.push(w); });
  const seat = new THREE.Mesh(new THREE.BoxGeometry(0.78, 0.16, 0.7), black); seat.position.set(0, 0.98, 0.15); seat.userData = { scooter: true }; grp.add(seat);
  const back = new THREE.Mesh(new THREE.BoxGeometry(0.78, 0.5, 0.14), black); back.position.set(0, 1.25, 0.5); grp.add(back);
  const col = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 1.0, 8), chrome); col.position.set(0, 1.0, -0.85); col.rotation.x = -0.22; grp.add(col);
  const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.74, 8), chrome); bar.rotation.z = Math.PI / 2; bar.position.set(0, 1.46, -0.96); grp.add(bar);
  const basket = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.3, 0.36), new THREE.MeshLambertMaterial({ color: 0xcfd6dd, flatShading: true, wireframe: true })); basket.position.set(0, 1.12, -1.06); grp.add(basket);
  const cv = document.createElement('canvas'); cv.width = 128; cv.height = 64; grp.userData.ledCtx = cv.getContext('2d'); grp.userData.ledTex = new THREE.CanvasTexture(cv);
  const led = new THREE.Mesh(new THREE.PlaneGeometry(0.36, 0.18), new THREE.MeshBasicMaterial({ map: grp.userData.ledTex })); led.position.set(0, 1.5, -0.86); led.rotation.x = -0.22; grp.add(led);
  const tanks = [];
  [-0.26, 0.26].forEach(tx => {
    const tank = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.16, 0.82, 12), new THREE.MeshLambertMaterial({ color: 0x18b6ff, emissive: 0x0a4a7a, emissiveIntensity: 0.55, flatShading: true, transparent: true })); tank.position.set(tx, 1.36, 0.64); grp.add(tank);
    const valve = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.16, 8), chrome); valve.position.set(tx, 1.84, 0.64); grp.add(valve);
    const hose = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.8, 6), black); hose.position.set(tx, 1.0, 0.46); hose.rotation.x = 0.6; grp.add(hose);
    const lc = document.createElement('canvas'); lc.width = 64; lc.height = 32; const lx = lc.getContext('2d'); lx.fillStyle = '#fff'; lx.font = 'bold 19px Arial'; lx.textAlign = 'center'; lx.fillText('N₂O', 32, 22);
    const lab = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(lc), transparent: true })); lab.scale.set(0.3, 0.15, 1); lab.position.set(tx, 1.52, 0.47); grp.add(lab);
    tanks.push(tank);
  });
  const jet = new THREE.Mesh(new THREE.ConeGeometry(0.24, 1.5, 10), new THREE.MeshBasicMaterial({ color: 0x6fd3ff, transparent: true, opacity: 0.85 })); jet.rotation.x = Math.PI / 2; jet.position.set(0, 0.7, 1.5); jet.visible = false; grp.add(jet);
  grp.userData.tanks = tanks; grp.userData.led = led; grp.userData.jet = jet; grp.userData.wheels = wheels;
  return grp;
}
function spawnScooters() {
  scooters.forEach(sc => { if (sc.group) { scene.remove(sc.group); disposeGroup(sc.group); } });
  scooters = []; riding = false; myScooter = null;
  const _scSpawns = (activeMap === 'paradise' && island && island.scooterSpawns.length) ? island.scooterSpawns : SCOOTER_SPAWNS;   // BR rides the island; other modes use Nuketown
  _scSpawns.forEach((sp, i) => {
    const grp = buildScooterModel(), y = groundHeightAt(sp.x, sp.z, 0.3);
    grp.traverse(o => { if (o.isMesh && o.userData && o.userData.scooter) o.userData.scIdx = i; });
    const sc = { i: i, group: grp, home: sp.clone(), pos: new THREE.Vector3(sp.x, y, sp.z), yaw: i * 1.3, speed: 0, nosOn: false, hp: SCOOTER.hp,
                 alive: true, occupant: null, respawnT: 0, rpos: new THREE.Vector3(sp.x, y, sp.z), ryaw: i * 1.3, netAcc: 0, _wheel: 0, _nosSndT: 0 };
    grp.position.copy(sc.pos); grp.rotation.y = sc.yaw; scene.add(grp); scooters.push(sc);
    _scLed(sc, 'NOS', 'READY', '#6fd3ff');
  });
}
function respawnScooter(sc) {
  const sp = sc.home, y = groundHeightAt(sp.x, sp.z, 0.3);
  sc.alive = true; sc.hp = SCOOTER.hp; sc.speed = 0; sc.nosOn = false; sc.occupant = null;
  sc.pos.set(sp.x, y, sp.z); sc.yaw = sc.i * 1.3; sc.rpos.copy(sc.pos); sc.group.visible = true; sc.group.position.copy(sc.pos);
  sc.group.userData.tanks.forEach(t => t.material.opacity = 1); _scLed(sc, 'NOS', 'READY', '#6fd3ff');
}
function tryMountScooter() {
  if (riding || !player.alive || player.onLadder) return false;
  let best = null, bd = SCOOTER.mountDist;
  for (const sc of scooters) { if (sc.alive && !sc.occupant) { const d = player.pos.distanceTo(sc.pos); if (d < bd) { bd = d; best = sc; } } }
  if (!best) return false;
  best.occupant = NET.active ? NET.selfId : 'me'; riding = true; myScooter = best; best.yaw = yaw; best.speed = 0;
