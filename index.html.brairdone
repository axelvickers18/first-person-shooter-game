  const nb = el('nosBar'); if (nb) { nb.style.width = '100%'; nb.style.background = sc.nosOn ? 'linear-gradient(90deg,#7fe9ff,#ffffff)' : 'linear-gradient(90deg,#2a7fff,#7fe9ff)'; }
