    for (const key in weaponState) {
      const ws = weaponState[key];
      if (ws.cooldown > 0) ws.cooldown -= dt;
      if (ws.cdL > 0) ws.cdL -= dt; if (ws.cdR > 0) ws.cdR -= dt;   // akimbo per-pistol cooldowns
      if (ws.reloading > 0) {
