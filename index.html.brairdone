  for (let i = 0; i < 3; i++) { const s = new THREE.Mesh(new THREE.BoxGeometry(0.72, 1.0, 0.05), flatMat(i === 0 ? 0xcc2222 : (i % 2 ? 0xeeeeee : 0x2a3a8a))); s.position.set(0.36 + i * 0.72, -0.55, 0); flagGrp.add(s); segs.push(s); }
  scene.add(flagGrp); mapFlag = { segs, pos: new THREE.Vector3(SP(6), 9, SP(24)), t: 0 };

