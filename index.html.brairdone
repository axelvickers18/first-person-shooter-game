let laserOn = true;   // master toggle (default ON), rebindable to L in the Controls menu
function hasLaser(key) { return effLaser(key) !== 'off'; }   // (PART 2) effective laser from the weapon config

/* ============================================================================
   PART 2 — WEAPON ATTACHMENT CUSTOMIZATION (sight / magazine / laser / flashlight).
   Per-weapon config saved to localStorage; applied on equip (reuses the ADS / scope /
   thermal / laser systems). `liveCfg` = the config locked in at equip (so mid-life
   edits only take effect on the next respawn/equip).
   ============================================================================ */
// Sight options -> existing ADS kind/style/fov (reuses the built-in reticle/scope/thermal overlays).
const ATT_SIGHTS = {
  iron:    { name: 'Iron Sights',    kind: 'iron',  fov: 0.85 },
  red_dot: { name: 'Red Dot',        kind: 'dot',   fov: 0.85 },
  acog:    { name: 'ACOG 3.5×',      kind: 'scope', style: 'heavy',   fov: 0.42, sway: 0.4 },
  holo:    { name: 'Holographic',    kind: 'holo',  fov: 0.85 },
  sniper:  { name: 'Sniper Scope 8×',kind: 'scope', style: 'heavy',   fov: 0.16, sway: 1.0 },
  thermal: { name: 'Thermal ACOG',   kind: 'scope', style: 'thermal', fov: 0.50, sway: 0.4 }
};
const ATT_MAGS = { standard: { name: 'Standard', mult: 1 }, extended: { name: 'Extended', mult: 1.5 }, drum: { name: 'Drum', mult: 2 } };
const ATT_LASERS = { off: 'Off', red: 'Red', green: 'Green' };
const ATT_FLASH = { off: 'Off', on: 'White' };
// Per-weapon class (drives the allowed-attachment restrictions). Omitted weapons aren't customizable.
const WPN_CLASS = { gg1:'lmg', gg2:'ar', gg3:'smg', gg4:'ar', gg5:'ar', gg6:'shotgun', gg7:'shotgun', gg8:'dmr',
  gg9:'sniper', gg10:'crossbow', gg13:'smg', gg14:'pistol', gg15:'revolver', gg16:'pistol', gg18:'pistol',
  gg21:'shotgun', gg22:'smg', gg23:'sniper', gg24:'ar', gg25:'smg', gg26:'lmg', gg27:'dmr', gg28:'ar' };   // Dragunov 'dmr'; AK-47 'ar' = iron/red_dot/acog/holo/thermal + standard/extended/drum (no sniper scope)
const CLASS_SIGHTS = {
  pistol:['iron','red_dot'], smg:['iron','red_dot','holo'], ar:['iron','red_dot','acog','holo','thermal'],
  shotgun:['iron','red_dot','holo'], lmg:['iron','red_dot','holo'], dmr:['acog','holo','sniper','thermal'],
  sniper:['sniper','thermal','acog'], crossbow:['iron','red_dot','acog'], revolver:['iron','red_dot']
};
const CLASS_MAGS = {
  pistol:['standard','extended'], smg:['standard','extended','drum'], ar:['standard','extended','drum'],
  shotgun:['standard','extended','drum'], lmg:['standard','extended'], dmr:['standard','extended'],
  sniper:['standard','extended'], crossbow:['standard'], revolver:['standard']
};
const _baseMag = {}; for (const k in WEAPONS) _baseMag[k] = WEAPONS[k].mag;   // remember each weapon's base magazine
function isCustomizable(key) { return !!WPN_CLASS[key]; }
function sightAllowed(key) { const c = WPN_CLASS[key]; return (CLASS_SIGHTS[c] || []).slice(); }
function magAllowed(key) { const c = WPN_CLASS[key]; return (CLASS_MAGS[c] || ['standard']).slice(); }
function defaultCfg(key) {
  const SIGHT = { gg1:'iron', gg2:'red_dot', gg3:'red_dot', gg4:'red_dot', gg5:'red_dot', gg6:'iron', gg7:'red_dot',
    gg8:'sniper', gg9:'sniper', gg10:'iron', gg13:'iron', gg14:'iron', gg15:'iron', gg16:'iron', gg18:'iron',
    gg21:'red_dot', gg22:'red_dot', gg23:'sniper', gg24:'red_dot', gg25:'red_dot', gg26:'iron', gg27:'sniper', gg28:'iron' };
  return { sight: SIGHT[key] || 'iron', magazine: 'standard', laser: LASER_WEAPONS[key] != null ? 'red' : 'off', flashlight: 'off' };
}
let weaponCfgs = {};
function loadWeaponCfgs() { try { const o = JSON.parse(localStorage.getItem('weaponCfgs_v1')); if (o && typeof o === 'object') weaponCfgs = o; } catch (e) {} }
function saveWeaponCfgs() { try { localStorage.setItem('weaponCfgs_v1', JSON.stringify(weaponCfgs)); } catch (e) {} }
loadWeaponCfgs();
// The saved (or default) config for a weapon, sanitized against its restrictions.
function getCfg(key) {
  if (!isCustomizable(key)) return null;
  const d = defaultCfg(key), c = Object.assign({}, d, weaponCfgs[key] || {});
  if (sightAllowed(key).indexOf(c.sight) < 0) c.sight = sightAllowed(key)[0] || d.sight;   // clamp to allowed
  if (magAllowed(key).indexOf(c.magazine) < 0) c.magazine = 'standard';
  return c;
}
function setCfg(key, cfg) { if (!isCustomizable(key)) return; weaponCfgs[key] = cfg; saveWeaponCfgs(); applyWeaponMag(key); }
function resetCfg(key) { delete weaponCfgs[key]; saveWeaponCfgs(); applyWeaponMag(key); }
// `liveCfg` is locked in at equip so a mid-life customization only applies on the next respawn/equip.
let liveCfg = {};
function effSightId(key) { const c = (liveCfg[key] || getCfg(key)); return c ? c.sight : null; }
function effLaser(key) { const c = (liveCfg[key] || getCfg(key)); return c ? c.laser : (LASER_WEAPONS[key] ? 'red' : 'off'); }   // non-customizable weapons keep their built-in laser (akimbo)
function effFlash(key) { const c = (liveCfg[key] || getCfg(key)); return c ? c.flashlight : 'off'; }
// Set WEAPONS[key].mag from the config multiplier (FP/HUD read this; remotes use their own synced config).
function applyWeaponMag(key) { if (!_baseMag[key]) return; const c = getCfg(key); const mult = c ? (ATT_MAGS[c.magazine] || ATT_MAGS.standard).mult : 1; WEAPONS[key].mag = Math.round(_baseMag[key] * mult); }
function applyAllWeaponMags() { for (const k in WPN_CLASS) applyWeaponMag(k); }
applyAllWeaponMags();
// Laser beam/emitter color for a config value ('red'|'green'), optionally a dimmer variant.
function laserHex(which, dim) { const g = which === 'green'; return dim ? (g ? 0x119033 : 0x7a1010) : (g ? 0x2bff5a : 0xff2222); }
let flashlightOn = false;   // flashlight master toggle (F key); only acts if the equipped weapon has the attachment
function _sightIsScope(key) { const s = ATT_SIGHTS[effSightId(key)]; return s ? s.kind === 'scope' : /scope/.test((WEAPONS[key] && WEAPONS[key].sight) || ''); }
function laserSuppressedNow() { return adsBlend > 0.5 && _sightIsScope(currentWeaponKey); }   // laser hidden while scoped
function flashSuppressedNow() { return adsBlend > 0.5 && _sightIsScope(currentWeaponKey); }   // flashlight hidden while scoped

const WEAPON_ORDER  = ["pistol", "smg", "shotgun", "sniper"]; // base weapons, keys 1..4
const SPECIAL_ORDER = ["rocket", "laser", "deagle"];          // specials, keys 5..7 (if owned)
const ALL_KEYS      = WEAPON_ORDER.concat(SPECIAL_ORDER);
const ownedSpecials = new Set();   // which special weapons the player currently has

// Movement tuning (arcadey / Krunker-fast, Quake-style accel for bunny hop)
const MOVE = {
  groundSpeed: 11,   // target ground speed
  groundAccel: 90,   // how snappy ground accel is
  airSpeed: 1.8,     // small air "wish speed" -> enables subtle bhop strafing
  airAccel: 90,
  friction: 9,       // ground friction
  maxSpeed: 17,      // hard cap so bhop never breaks
  gravity: 30,
  jumpVel: 11,
  slideSpeed: 19,    // forward boost on slide
  slideTime: 0.45,
  eyeHeight: 1.6,
  slideEye: 0.9,
  radius: 0.4,
  // --- Crouch / dive tuning ---
  crouchEye: 0.95,    // camera eye height while crouched (~60% standing)
  diveEye: 0.5,       // very low (prone-ish) eye height mid-dive
  crouchSpeed: 0.5,   // move-speed multiplier while crouched (on top of weapon mult)
  diveTrigger: 0.9,   // dive needs horizontal speed >= this fraction of max
  diveBoost: 1.5,     // forward burst = current speed × this
  diveUp: 5.5,        // small upward hop on dive launch
  diveTime: 0.75,     // nominal dive duration (s) — but you stay diving until you land
  diveTilt: 0.22,     // forward camera pitch (rad ~12.6°) during a dive
  diveRecover: 0.25   // post-landing window where you can't dive/slide again
};

// --- Sniper scope tuning (improvement #1) ---
const SCOPE = {
  fov: 25,          // zoomed FOV when scoped (vs DEFAULT_FOV ~78) -> strong zoom
  sensMult: 0.35,   // mouse sensitivity multiplier while scoped (precise aim)
  moveMult: 0.45,   // movement-speed multiplier while scoped
  punch: 0.20,      // seconds the scope blinks out after firing (recoil), then returns
  blendSpeed: 12    // how fast the scope blends in/out (higher = snappier)
};

// --- Launch-pad tuning (improvement #2) ---
const LAUNCH = {
  impulse: 27,      // upward velocity applied on contact (tune launch height here)
  cooldown: 0.5     // per-player retrigger guard so it fires once per step-on (s)
};

// --- Frag-grenade tuning (improvement: grenades) ---
const GRENADE = {
  maxCarry: 2,        // grenades carried per life
  fuseTime: 3.0,      // seconds from THROW to detonation (fuse starts on throw)
  throwVel: 24,       // forward launch speed
  upArc: 6,           // extra upward velocity for the lob arc
  gravity: 30,        // grenade gravity
  bounceDamping: 0.5, // fraction of velocity kept after a bounce
  blastRadius: 10,    // damage radius (units)
  maxDamage: 120,     // damage at the center, falling off linearly to 0 at the edge
  shakeRange: 24      // player within this distance of a blast gets screen shake
};

// --- Tomahawk tuning (alternate throwable; pick it in Settings) ---
const TOMAHAWK = {
  maxCarry: 3,        // tomahawks carried per life
  throwVel: 42,       // fast, flat throw
  upArc: 2,           // tiny arc
  gravity: 22,        // lighter than a grenade so it flies straighter
  spin: 26,           // rad/s tumble
  hitRadius: 1.3,     // direct-hit detection radius around a body
  damage: 200,        // direct hit one-shots a bot (and most players)
  headMult: 1.0,      // already lethal; head not special
  life: 5.0           // seconds before it despawns
};

// --- LETHAL throwable selection (chosen in the inventory, thrown with H, 2 per life) ---
const LETHAL_MAX = 2;
const LETHAL_NAMES = { smoke: 'SMOKE GRENADE', axe: 'THROWING AXE' };
let lethalChoice = 'smoke';
try { const _lc = localStorage.getItem('lethalChoice_v1'); if (_lc === 'smoke' || _lc === 'axe') lethalChoice = _lc; } catch (e) {}
function setLethalChoice(t) { if (t !== 'smoke' && t !== 'axe') return; lethalChoice = t; try { localStorage.setItem('lethalChoice_v1', t); } catch (e) {} if (typeof refreshInvPanes === 'function') refreshInvPanes(); if (typeof updateHUD === 'function') updateHUD(); }

// --- Bullet-tracer styling (improvement #1) ---
// One entry per weapon (+ 'bot' for enemy fire). life = seconds before fade-out;
// thick = use a glowing beam box instead of a thin line.
const TRACER = {
  color: { pistol:0xfff3a0, smg:0xffffff, shotgun:0xff5418, sniper:0x33e6ff,
           laser:0xff1e1e, deagle:0xffd24a, bot:0xff7a55, def:0xffb330,
           // Per-weapon tracer flavours (Part 4): yellow-orange default rifles/LMG/tactical SG/bullpup,
           gg1:0xffb330, gg2:0xffb330, gg4:0xffb330, gg5:0xffb330, gg21:0xffb330, gg24:0xffb330, gg28:0xffb330,
           gg3:0xff8a1a, gg22:0xff8a1a, gg13:0xff8a1a,                                  // orange (SMG / micro SMG / machine pistol)
           gg6:0xff5418, gg7:0xff5418,                                                  // orange-red (shotguns)
           gg8:0x35dd55, gg9:0x35dd55, gg23:0x35dd55, gg27:0x35dd55,                    // green (DMR / bolt + heavy sniper + Dragunov)
           gg14:0xffe23a, gg15:0xffe23a, gg16:0xffe23a, gg17:0xffe23a, gg18:0xffe23a, gg25:0xffe23a, gg26:0xffb330 },  // yellow pistols/akimbo/suppressed; minigun yellow-orange
  life:  { pistol:0.10, smg:0.09, shotgun:0.08, sniper:0.16,
           laser:0.25, deagle:0.13, bot:0.10, def:0.10,
           gg8:0.16, gg9:0.20, gg23:0.22, gg27:0.18 },          // sniper tracers linger (more visible at range)
  thick: { sniper:true, laser:true, deagle:true, gg9:true, gg23:true, gg27:true },   // these render as thicker beams
  dim:   { gg25:true }   // suppressed SMG: very dim tracer (matches its stealth profile)
};

// --- Rocket Launcher projectile tuning (improvement #3) ---
const ROCKET = {
  speed: 70,          // travel speed (straight line, no gravity)
  blastRadius: 14,    // (also mirrored in WEAPONS.rocket.blastRadius)
  blastDamage: 170,   // center damage, linear falloff
  limbRadius: 7,      // limbs can be torn off within this of the blast
  limbChance: 0.85,
  shakeRange: 30,     // screen-shake distance
  shakeMag: 0.22,
  life: 4.0           // max seconds before auto-detonate (safety cleanup)
};

// --- Green loot crate + special-weapon drop tuning (improvement #2) ---
const LOOT = {
  points: [ [0, 0], [0, 16], [0, -16], [-24, 0], [24, 0] ],   // x,z spots (street + flanks)
  cooldown: 25,        // seconds after a crate is collected before the next spawns
  weights: { rocket: 0.45, laser: 0.45, deagle: 0.10 } // drop chances
};
// Kill-feed tags for special-weapon / grenade kills (gold flag => legendary styling).
const WEAPON_TAGS = {
  rocket: { label: 'ROCKET' }, laser: { label: 'LASER' },
  deagle: { label: 'LEGENDARY', gold: true }, grenade: { label: 'GRENADE' },
  tomahawk: { label: 'TOMAHAWK' }, rcrl: { label: '🚀 RC', rc: true }
};

/* ============================================================================
   2. SETUP — renderer, scene, camera, lights, bright skybox
   ============================================================================ */
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;   // <-- valid constant (old code crashed here)
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);        // bright sky blue
scene.fog = new THREE.Fog(0x87ceeb, 180, 420);       // pushed back for the bigger map

const camera = new THREE.PerspectiveCamera(78, window.innerWidth / window.innerHeight, 0.1, 1000);
let DEFAULT_FOV = 78; const ADS_FOV = 55;            // hipfire (adjustable via the FOV option) / generic aim-down-sights

// Lighting: soft ambient + one sun casting clean shadows (flat-shaded look)
const hemi = new THREE.HemisphereLight(0xffffff, 0x6688aa, 0.85);   // (ref kept so the day/night cycle can retint it)
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xffffff, 0.9);
sun.position.set(70, 130, 50);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
sun.shadow.camera.left = -140; sun.shadow.camera.right = 140;   // widened to cover the bigger arena
sun.shadow.camera.top = 140; sun.shadow.camera.bottom = -140;
sun.shadow.camera.near = 1; sun.shadow.camera.far = 360;
scene.add(sun);

// Reusable flat-shaded material factory (no textures, bright saturated colors)
const matCache = {};
function flatMat(color) {
  if (!matCache[color]) matCache[color] = new THREE.MeshLambertMaterial({ color, flatShading: true });
  return matCache[color];
}

/* ============================================================================
   2b. AUDIO — central procedural sound engine (Web Audio API).
   All SFX are synthesized in code (oscillators + filtered noise + envelopes) so
   nothing needs to be hosted. Sounds route: per-sound nodes -> category gain ->
   master gain -> destination. Gameplay sounds are 3D (distance falloff + stereo
   pan vs the camera); UI sounds are 2D (centre, full). Polyphony is clamped per
   sound type, and sounds past ~80 units are culled. Settings persist locally.
   ============================================================================ */
const SND = {
  ctx: null, ready: false, master: null, cat: {}, delay: null,
  CATS: ['weapons', 'footsteps', 'ui', 'ambient', 'voice'],
  vol: { master: 0.5, weapons: 1.0, footsteps: 0.85, ui: 0.7, ambient: 0.45, voice: 1.0 },
  muted: false,
  poly: {}, LIM: { footstep: 6, dog: 8, kong: 4, _def: 4 },
  lpos: new THREE.Vector3(), lright: new THREE.Vector3(1, 0, 0),
  _noise: null, _tmp: new THREE.Vector3(), CULL: 80,

  loadSettings() {
    try { const s = JSON.parse(localStorage.getItem('blockoutAudio')); if (s) { Object.assign(this.vol, s.vol || {}); this.muted = !!s.muted; } } catch (e) {}
  },
  saveSettings() { try { localStorage.setItem('blockoutAudio', JSON.stringify({ vol: this.vol, muted: this.muted })); } catch (e) {} },
  init() {
    if (this.ready) return;
    const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
    this.loadSettings();
    this.ctx = new AC();
    this.master = this.ctx.createGain(); this.master.gain.value = this.muted ? 0 : this.vol.master;
    this.master.connect(this.ctx.destination);
    // Cheap shared "reverb": a feedback delay big weapons/explosions send into.
    this.delay = this.ctx.createDelay(0.5); this.delay.delayTime.value = 0.085;
    const fb = this.ctx.createGain(); fb.gain.value = 0.32; const wet = this.ctx.createGain(); wet.gain.value = 0.5;
    this.delay.connect(fb); fb.connect(this.delay); this.delay.connect(wet); wet.connect(this.master); this._verb = wet; this._verbIn = this.delay;
    this.CATS.forEach(c => { const g = this.ctx.createGain(); g.gain.value = this.vol[c]; g.connect(this.master); this.cat[c] = g; });
    // 1s white-noise buffer (looped + windowed per sound) — reused by every noisy SFX.
    const n = Math.floor(this.ctx.sampleRate); const buf = this.ctx.createBuffer(1, n, this.ctx.sampleRate); const d = buf.getChannelData(0);
    for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
    this._noise = buf; this.ready = true;
  },
  resume() { if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume(); },   // call on a user gesture
  setMaster(v) { this.vol.master = v; if (this.master) this.master.gain.value = this.muted ? 0 : v; this.saveSettings(); },
  setCat(c, v) { this.vol[c] = v; if (this.cat[c]) this.cat[c].gain.value = v; this.saveSettings(); },
  setMuted(b) { this.muted = b; if (this.master) this.master.gain.value = b ? 0 : this.vol.master; this.saveSettings(); },
  setListener(pos, right) { this.lpos.copy(pos); this.lright.copy(right); },
  _can(type) { const k = type || '_def'; const lim = this.LIM[k] != null ? this.LIM[k] : this.LIM._def; return (this.poly[k] || 0) < lim; },
  _bump(type, dur) { const k = type || '_def'; this.poly[k] = (this.poly[k] || 0) + 1; setTimeout(() => { this.poly[k] = Math.max(0, (this.poly[k] || 1) - 1); }, Math.max(40, (dur || 0.25) * 1000)); },
  // 2D (UI / non-positional): full volume, centre pan.
  play2d(build, cat, type, vol, dur) {
    if (!this.ready || this.muted) return; if (type && !this._can(type)) return;
    const g = this.ctx.createGain(); g.gain.value = (vol == null ? 1 : vol); g.connect(this.cat[cat] || this.master);
    if (type) this._bump(type, dur); try { build(this.ctx, g, this.ctx.currentTime); } catch (e) {}
  },
  // 3D (positional): distance falloff (squared) + stereo pan relative to the camera.
  play3d(build, pos, cat, type, vol, dur, maxDist) {
    if (!this.ready || this.muted || !pos) return;
    const cull = maxDist || this.CULL;   // per-sound carry distance (suppressed weapons pass a short one)
    const to = this._tmp.subVectors(pos, this.lpos); const dist = to.length();
    if (dist > cull) return; if (type && !this._can(type)) return;
    const fall = Math.max(0, 1 - dist / cull); const g0 = (vol == null ? 1 : vol) * fall * fall;
    if (g0 < 0.004) return;
    const pan = dist > 0.05 ? Math.max(-1, Math.min(1, to.multiplyScalar(1 / dist).dot(this.lright))) : 0;
    const pn = this.ctx.createStereoPanner(); pn.pan.value = pan;
    const g = this.ctx.createGain(); g.gain.value = g0; pn.connect(g); g.connect(this.cat[cat] || this.master);
    if (type) this._bump(type, dur); try { build(this.ctx, pn, this.ctx.currentTime); } catch (e) {}
  }
};
// --- Low-level synth helpers (kept cheap: a couple of nodes, short envelopes) ---
function aTone(ctx, out, t, o) {
  const osc = ctx.createOscillator(), g = ctx.createGain(), pp = SND.pitch || 1;   // global pitch (slow-mo film effect)
  osc.type = o.type || 'sine'; osc.frequency.setValueAtTime(Math.max(1, o.f0 * pp), t);
  if (o.f1 != null) osc.frequency.exponentialRampToValueAtTime(Math.max(1, o.f1 * pp), t + o.dur);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(Math.max(0.001, o.peak || 0.5), t + (o.atk || 0.005));
  g.gain.exponentialRampToValueAtTime(0.0001, t + o.dur);
  osc.connect(g); g.connect(out); if (o.verb && SND._verbIn) g.connect(SND._verbIn);
  osc.start(t); osc.stop(t + o.dur + 0.03);
}
function aNoise(ctx, out, t, o) {
  const pp = SND.pitch || 1;   // global pitch (slow-mo film effect)
  const src = ctx.createBufferSource(); src.buffer = SND._noise; src.loop = true; src.playbackRate.value = (o.rate || 1) * pp;
  const f = ctx.createBiquadFilter(); f.type = o.filter || 'lowpass'; f.frequency.setValueAtTime((o.freq || 2000) * pp, t);
  if (o.freq1 != null) f.frequency.exponentialRampToValueAtTime(Math.max(40, o.freq1 * pp), t + o.dur);
  f.Q.value = o.q || 0.7;
  const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(Math.max(0.001, o.peak || 0.4), t + (o.atk || 0.002));
  g.gain.exponentialRampToValueAtTime(0.0001, t + o.dur);
  src.connect(f); f.connect(g); g.connect(out); if (o.verb && SND._verbIn) g.connect(SND._verbIn);
  src.start(t + (o.start || 0)); src.stop(t + o.dur + 0.03);
}
// A small ascending/descending note sequence (used by progression + UI chimes).
function aChime(ctx, out, t, freqs, step, dur, peak, type) {
  freqs.forEach((f, i) => aTone(ctx, out, t + i * step, { type: type || 'triangle', f0: f, dur: dur || 0.18, peak: peak || 0.4, atk: 0.01 }));
}

/* --- Per-weapon FIRE profiles (base pitch / length / noise / tone → unique shot per gun) --- */
const GUN_SFX = {
  _def: { f: 200, dur: 0.09, noise: 0.6, nf: 2400, peak: 0.5 },
  gg1:  { f: 80,  dur: 0.13, noise: 1.0, nf: 1200, peak: 0.65, verb: 0.5 },   // Heavy LMG — deep BRRT
  gg2:  { f: 165, dur: 0.10, noise: 0.7, nf: 2600, peak: 0.55 },              // Assault Rifle
  gg3:  { f: 240, dur: 0.07, noise: 0.6, nf: 3200, peak: 0.48 },              // SMG — snappy
  gg4:  { f: 120, dur: 0.13, noise: 0.7, nf: 2000, peak: 0.62, verb: 0.4 },   // Battle Rifle — heavier
  gg5:  { f: 190, dur: 0.09, noise: 0.6, nf: 2700, peak: 0.52 },              // Carbine
  gg6:  { f: 70,  dur: 0.20, noise: 1.0, nf: 1600, peak: 0.7,  verb: 0.5 },   // Pump Shotgun — BOOM
  gg7:  { f: 90,  dur: 0.15, noise: 0.95,nf: 1800, peak: 0.62 },              // Auto Shotgun
  gg8:  { f: 110, dur: 0.16, noise: 0.7, nf: 2200, peak: 0.66, verb: 0.55 },  // DMR — marksman crack
  gg9:  { f: 95,  dur: 0.26, noise: 0.85,nf: 2000, peak: 0.8,  verb: 0.8 },   // Bolt Sniper — huge THWACK
  gg13: { f: 280, dur: 0.06, noise: 0.55,nf: 3400, peak: 0.45 },             // Machine Pistol
  gg14: { f: 220, dur: 0.08, noise: 0.6, nf: 2800, peak: 0.52 },              // 9mm Pistol
  gg15: { f: 130, dur: 0.16, noise: 0.7, nf: 2200, peak: 0.66, verb: 0.5, ring: 1 },  // Revolver — metallic ring
  gg16: { f: 85,  dur: 0.18, noise: 0.85,nf: 1700, peak: 0.78, verb: 0.5 },   // Desert Eagle — deep BOOM
  gg17: { f: 220, dur: 0.08, noise: 0.6, nf: 2800, peak: 0.52 },              // Akimbo (alternating pan handled at call site)
  gg18: { f: 250, dur: 0.06, noise: 0.4, nf: 3000, peak: 0.4,  hp: 1200 },    // Tactical — tight suppressed-ish snap
  gg21: { f: 120, dur: 0.16, noise: 0.9, nf: 1700, peak: 0.66, verb: 0.4 },   // Tactical Shotgun — punchy boom
  gg22: { f: 300, dur: 0.045,noise: 0.5, nf: 3600, peak: 0.40 },              // PDW / Micro SMG — tiny fast pop
  gg24: { f: 175, dur: 0.085,noise: 0.62,nf: 2600, peak: 0.56 },              // Bullpup Rifle — punchy mid
  gg26: { f: 58,  dur: 0.11, noise: 1.0, nf: 1000, peak: 0.72, verb: 0.5 },   // Minigun — deep menacing BRRRT
  gg27: { f: 100, dur: 0.20, noise: 0.8, nf: 2100, peak: 0.74, verb: 0.5 },   // Dragunov — deep heavy bang + sharp crack, snappier (less tail) than the bolt sniper
  gg28: { f: 135, dur: 0.115,noise: 0.85,nf: 2100, peak: 0.62, verb: 0.35 },  // AK-47 — bassier, rougher "dirty" crack vs the standard AR's cleaner snap
};
// Build the fire SFX for a weapon (layered tone + sub + powder noise + optional tail/ring).
function buildGunFire(key) {
  const p = GUN_SFX[key] || GUN_SFX._def;
  return (ctx, out, t) => {
    aTone(ctx, out, t, { type: 'square', f0: p.f, f1: p.f * 0.42, dur: p.dur, peak: p.peak, atk: 0.003, verb: p.verb });
    aTone(ctx, out, t, { type: 'sine', f0: p.f * 0.6, f1: p.f * 0.28, dur: p.dur * 1.3, peak: p.peak * 0.8 });
    aNoise(ctx, out, t, { dur: p.dur * 1.15, peak: 0.55 * p.noise, filter: 'lowpass', freq: p.nf, freq1: p.nf * 0.45, verb: p.verb });
    if (p.hp) aNoise(ctx, out, t, { dur: p.dur * 0.5, peak: 0.28, filter: 'highpass', freq: p.hp });
    if (p.ring) aTone(ctx, out, t + 0.02, { type: 'triangle', f0: 1800, f1: 1200, dur: 0.18, peak: 0.12 });   // revolver ring
  };
}
// Knife/melee whoosh (bandpass noise swept down); higher pitch = karambit.
function buildSlash(high) {
  return (ctx, out, t) => aNoise(ctx, out, t, { dur: 0.18, peak: 0.4, filter: 'bandpass', freq: high ? 2600 : 1800, freq1: high ? 900 : 600, q: 1.2 });
}
// Hollow trigger click on empty.
function sfxEmpty(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 320, dur: 0.03, peak: 0.18 }); aNoise(ctx, out, t, { dur: 0.035, peak: 0.12, filter: 'highpass', freq: 3000 }); }, pos || playerEarPos(), 'weapons', 'empty', 0.7, 0.06); }

// Convenience: where the local player "hears from" (camera world position).
function playerEarPos() { return camera.getWorldPosition(new THREE.Vector3()); }
// Play a weapon's fire sound at a world position (used locally + for networked remote shots).
// CS:GO-style melee SFX — distinct swing / hit / equip per knife (all share the 'karambit' weapon).
function sfxMeleeSwing(mv, pos) {
  const P = pos || playerEarPos();
  if (mv === 'm9') SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.22, peak: 0.4, filter: 'bandpass', freq: 1100, freq1: 480, q: 0.9 }), P, 'weapons', 'melee', 0.8, 0.22);           // heavy whoosh
  else if (mv === 'butterfly') SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.12, peak: 0.32, filter: 'bandpass', freq: 2200, freq1: 1000, q: 1.2 }), P, 'weapons', 'melee', 0.7, 0.12);  // light quick whoosh
  else SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.16, peak: 0.38, filter: 'bandpass', freq: 2600, freq1: 900, q: 1.3 }), P, 'weapons', 'melee', 0.75, 0.16);                          // sharp aggressive swish
}
function sfxMeleeHit(mv, pos) {
  const P = pos || playerEarPos();
  if (mv === 'm9') SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 160, f1: 70, dur: 0.1, peak: 0.32 }); aNoise(ctx, out, t, { dur: 0.09, peak: 0.34, filter: 'lowpass', freq: 700 }); }, P, 'weapons', 'meleehit', 0.85, 0.12);   // meaty thud
  else if (mv === 'butterfly') SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.07, peak: 0.34, filter: 'bandpass', freq: 1800, freq1: 800, q: 1.5 }); aTone(ctx, out, t, { type: 'triangle', f0: 1400, f1: 700, dur: 0.06, peak: 0.16 }); }, P, 'weapons', 'meleehit', 0.8, 0.1);   // clean cut
  else SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.12, peak: 0.36, filter: 'lowpass', freq: 1100, freq1: 400 }); aNoise(ctx, out, t + 0.03, { dur: 0.08, peak: 0.2, filter: 'bandpass', freq: 900, q: 0.8 }); }, P, 'weapons', 'meleehit', 0.85, 0.12);   // tearing / ripping
}
function sfxMeleeEquip(mv) {
  if (mv === 'm9') SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.18, peak: 0.3, filter: 'bandpass', freq: 1600, freq1: 3200, q: 1.0 }); aTone(ctx, out, t + 0.12, { type: 'triangle', f0: 2600, f1: 1800, dur: 0.1, peak: 0.12 }); }, 'weapons', 'meleeq', 0.6, 0.4);   // unsheath scrape + ring
  else if (mv === 'butterfly') SND.play2d((ctx, out, t) => { for (let i = 0; i < 5; i++) aTone(ctx, out, t + i * 0.12, { type: 'square', f0: 1800 + Math.random() * 600, dur: 0.03, peak: 0.16 }); aTone(ctx, out, t + 0.66, { type: 'square', f0: 1400, dur: 0.05, peak: 0.24 }); }, 'weapons', 'meleeq', 0.6, 0.7);   // click-clack flips + final SNAP
  else SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.14, peak: 0.2, filter: 'bandpass', freq: 1200, freq1: 2400, q: 0.8 }); aNoise(ctx, out, t + 0.18, { dur: 0.12, peak: 0.18, filter: 'bandpass', freq: 2400, freq1: 1000, q: 0.8 }); aTone(ctx, out, t + 0.42, { type: 'square', f0: 900, dur: 0.04, peak: 0.18 }); }, 'weapons', 'meleeq', 0.6, 0.55);   // spin whoosh-whoosh + grip click
}
function sfxFire(weaponKey, pos, side, meleeVar) {
  const cat = 'weapons';
  // Lightsaber swing: airy whoosh + the iconic high energy zing.
  if (weaponKey === 'saber') { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.22, peak: 0.34, filter: 'bandpass', freq: 700, freq1: 2400, q: 0.8 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 900, f1: 1500, dur: 0.18, peak: 0.16 }); aTone(ctx, out, t + 0.03, { type: 'sine', f0: 1700, f1: 1200, dur: 0.16, peak: 0.1 }); }, pos, cat, 'sabersw', 0.8, 0.24); return; }
  if (weaponKey === KARAMBIT_KEY) { sfxMeleeSwing(meleeVar || meleeChoice, pos); return; }   // swing sound varies by the chosen knife
  if (weaponKey === 'gg20' || (WEAPONS[weaponKey] && WEAPONS[weaponKey].melee)) { SND.play3d(buildSlash(false), pos, cat, 'melee', 0.8, 0.2); return; }
  if (weaponKey === 'gg19') { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.12, peak: 0.3, filter: 'bandpass', freq: 1700, freq1: 2600, q: 1.4 }); }, pos, cat, 'melee', 0.6, 0.13); return; }   // throwing-knife release
  if (weaponKey === 'gg10') { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.05, peak: 0.3, filter: 'lowpass', freq: 1200 }); aNoise(ctx, out, t + 0.02, { dur: 0.16, peak: 0.16, filter: 'bandpass', freq: 1800, freq1: 700, q: 0.8 }); }, pos, cat, 'fire', 0.7, 0.18); return; }   // crossbow: thunk + string whoosh
  if (weaponKey === 'gg11') { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 320, f1: 140, dur: 0.14, peak: 0.5 }); aNoise(ctx, out, t, { dur: 0.1, peak: 0.3, filter: 'lowpass', freq: 900 }); }, pos, cat, 'fire', 0.85, 0.15); return; }   // grenade launcher: hollow thoonk
  if (weaponKey === 'gg12' || weaponKey === 'rcrl') { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.4, peak: 0.6, filter: 'lowpass', freq: 1400, freq1: 500, verb: 0.6 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 160, f1: 60, dur: 0.4, peak: 0.4 }); }, pos, cat, 'rpg', 0.95, 0.45); return; }   // RPG / RC launch: whoosh + ignition roar
  if (weaponKey === 'gg23') {   // HEAVY SNIPER — deep booming report + huge echo, then a CHK-CHUNK bolt cycle
    SND.play3d((ctx, out, t) => {
      aTone(ctx, out, t, { type: 'square', f0: 72, f1: 30, dur: 0.34, peak: 0.92, atk: 0.002, verb: 0.9 });
      aTone(ctx, out, t, { type: 'sine', f0: 48, f1: 22, dur: 0.5, peak: 0.85, verb: 0.9 });
      aNoise(ctx, out, t, { dur: 0.3, peak: 0.78, filter: 'lowpass', freq: 1800, freq1: 300, verb: 0.9 });
      aNoise(ctx, out, t + 0.06, { dur: 0.55, peak: 0.3, filter: 'bandpass', freq: 500, q: 0.5, verb: 0.9 });   // rolling echo tail
      aTone(ctx, out, t + 0.45, { type: 'square', f0: 540, dur: 0.04, peak: 0.22 }); aNoise(ctx, out, t + 0.45, { dur: 0.05, peak: 0.18, filter: 'highpass', freq: 2600 });   // CHK
      aTone(ctx, out, t + 0.64, { type: 'square', f0: 300, dur: 0.06, peak: 0.26 }); aNoise(ctx, out, t + 0.64, { dur: 0.06, peak: 0.2, filter: 'lowpass', freq: 1400 });        // CHUNK
    }, pos, cat, 'fire' + weaponKey, 1.0, 0.5); return;
  }
  if (weaponKey === 'gg25') {   // SUPPRESSED SMG — muffled "pfft" at ~30% volume that carries only ~15u
    SND.play3d((ctx, out, t) => {
      aNoise(ctx, out, t, { dur: 0.06, peak: 0.32, filter: 'lowpass', freq: 1100, freq1: 500 });
      aTone(ctx, out, t, { type: 'sine', f0: 200, f1: 90, dur: 0.05, peak: 0.18 });
      aTone(ctx, out, t + 0.004, { type: 'square', f0: 430, dur: 0.02, peak: 0.08 });   // faint mechanical clack
    }, pos, cat, 'fire' + weaponKey, 0.30, 0.12, 15); return;
  }
  const b = buildGunFire(weaponKey);
  // Akimbo: pan the muzzle slightly L/R per side for the alternating-hands feel.
  if (side && pos) { const off = SND.lright.clone().multiplyScalar(side === 'L' ? -1.5 : 1.5); pos = pos.clone().add(off); }
  SND.play3d(b, pos, cat, 'fire' + (weaponKey || ''), 1.0, 0.3);
}
// MINIGUN spin-up (rising electric whine) + wind-down (descending whirr) — audible across the map.
function sfxMinigunSpin(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 90, f1: 520, dur: 0.8, peak: 0.34 }); aTone(ctx, out, t, { type: 'square', f0: 60, f1: 300, dur: 0.8, peak: 0.18 }); aNoise(ctx, out, t, { dur: 0.8, peak: 0.18, filter: 'bandpass', freq: 400, freq1: 1400, q: 0.7 }); }, pos || playerEarPos(), 'weapons', 'minspin', 0.9, 0.8); }
function sfxMinigunDown(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 480, f1: 70, dur: 1.0, peak: 0.28 }); aNoise(ctx, out, t, { dur: 1.0, peak: 0.16, filter: 'bandpass', freq: 1200, freq1: 300, q: 0.7 }); }, pos || playerEarPos(), 'weapons', 'mindown', 0.8, 1.0); }

/* --- EXPLOSIONS / impulse / projectile flight + impacts --- */
function sfxExplosion(kind, pos) {
  SND.play3d((ctx, out, t) => {
    aTone(ctx, out, t, { type: 'sine', f0: 90, f1: 30, dur: kind === 'big' ? 0.8 : 0.5, peak: 0.9, verb: 0.7 });   // low boom
    aNoise(ctx, out, t, { dur: kind === 'big' ? 0.7 : 0.45, peak: 0.8, filter: 'lowpass', freq: 1200, freq1: 200, verb: 0.7 });
    aNoise(ctx, out, t + 0.05, { dur: 0.4, peak: 0.25, filter: 'bandpass', freq: 700, q: 0.6 });                   // debris/rumble tail
    if (kind === 'rc') aNoise(ctx, out, t + 0.04, { dur: 0.35, peak: 0.2, filter: 'highpass', freq: 5000, rate: 1.4 });  // electrical fizz
    if (kind === 'gl') aNoise(ctx, out, t, { dur: 0.12, peak: 0.4, filter: 'highpass', freq: 2500 });               // sharp crack
  }, pos, 'weapons', 'expl', 1.0, 0.7);
}
// Impulse grenade: kinetic SHWHOOM + electric crackle (NOT a fire boom).
function sfxImpulseBoom(pos) {
  SND.play3d((ctx, out, t) => {
    aNoise(ctx, out, t, { dur: 0.45, peak: 0.8, filter: 'bandpass', freq: 320, freq1: 1400, q: 0.8, verb: 0.5 });   // rising kinetic whoosh
    aTone(ctx, out, t, { type: 'sine', f0: 70, f1: 200, dur: 0.4, peak: 0.6 });
    for (let i = 0; i < 5; i++) aTone(ctx, out, t + 0.02 + Math.random() * 0.25, { type: 'square', f0: 2000 + Math.random() * 3000, dur: 0.04, peak: 0.12 });   // electric crackle
  }, pos, 'weapons', 'expl', 1.0, 0.5);
}
function sfxImpulseThrow(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.18, peak: 0.35, filter: 'bandpass', freq: 1200, freq1: 600, q: 0.9 }); aTone(ctx, out, t + 0.05, { type: 'square', f0: 220, dur: 0.05, peak: 0.12 }); }, pos, 'weapons', 'imp', 0.7, 0.2); }
function sfxImpulseStick(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 420, f1: 120, dur: 0.09, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.05, peak: 0.25, filter: 'lowpass', freq: 1500 }); }, pos, 'weapons', 'imp', 0.7, 0.1); }
function sfxImpulseCharge(pos) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sawtooth', f0: 500, f1: 1900, dur: 0.2, peak: 0.3 }), pos, 'weapons', 'impchg', 0.6, 0.2); }
function sfxLaunched(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.32, peak: 0.4, filter: 'bandpass', freq: 700, freq1: 1600, q: 0.7 }), pos, 'voice', 'gust', 0.6, 0.32); }
// Bullet impacts.
function sfxImpact(kind, pos) {
  const builders = {
    wall:  (ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.06, peak: 0.4, filter: 'lowpass', freq: 1800 }); aNoise(ctx, out, t, { dur: 0.03, peak: 0.2, filter: 'highpass', freq: 4000 }); },
    metal: (ctx, out, t) => { aTone(ctx, out, t, { type: 'triangle', f0: 3200, f1: 1400, dur: 0.14, peak: 0.3 }); aTone(ctx, out, t, { type: 'square', f0: 5200, f1: 2600, dur: 0.08, peak: 0.14 }); },
    flesh: (ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.08, peak: 0.45, filter: 'lowpass', freq: 700 }); aTone(ctx, out, t, { type: 'sine', f0: 160, f1: 80, dur: 0.08, peak: 0.25 }); },
    stick: (ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 240, f1: 90, dur: 0.1, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.05, peak: 0.2, filter: 'lowpass', freq: 1200 }); },
    head:  (ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.05, peak: 0.45, filter: 'bandpass', freq: 2600, q: 2 }); aTone(ctx, out, t, { type: 'square', f0: 900, f1: 300, dur: 0.05, peak: 0.2 }); }
  };
  SND.play3d(builders[kind] || builders.wall, pos, 'weapons', 'impact', 0.8, 0.14);
}

/* --- FOOTSTEPS + movement --- */
// Surface under a point: 'wood' (porch/watchtower/house floor), 'pavement' (street/driveway),
// 'interior' (deep inside a house), else 'grass'.
function surfaceAt(x, z, y) {
  if (y > 0.2) return 'wood';                                                     // porch / platform / 2nd floor / roof
  if (Math.abs(x) < 12 && (z > 30 && z < 48 || z < -30 && z > -48)) return 'interior';   // inside a house (wood/carpet)
  if (Math.abs(x) < 10.5 && Math.abs(z) < 30) return 'pavement';                  // central street between the houses
  return 'grass';                                                                 // lawns / yards / flanks
}
function buildStep(surface, loud) {
  return (ctx, out, t) => {
    if (surface === 'grass') aNoise(ctx, out, t, { dur: 0.07, peak: 0.28 * loud, filter: 'bandpass', freq: 2600, q: 0.8, rate: 1.2 });
    else if (surface === 'pavement') aNoise(ctx, out, t, { dur: 0.06, peak: 0.34 * loud, filter: 'lowpass', freq: 900 });
    else if (surface === 'wood') { aTone(ctx, out, t, { type: 'sine', f0: 180, f1: 90, dur: 0.07, peak: 0.22 * loud }); aNoise(ctx, out, t, { dur: 0.05, peak: 0.18 * loud, filter: 'lowpass', freq: 1400 }); }
    else aNoise(ctx, out, t, { dur: 0.05, peak: 0.18 * loud, filter: 'lowpass', freq: 600 });   // interior/carpet (muffled)
  };
}
function sfxFootstep(pos, loud) { SND.play3d(buildStep(surfaceAt(pos.x, pos.z, pos.y), loud == null ? 1 : loud), pos, 'footsteps', 'footstep', 1.0, 0.08); }
function sfxJump(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 260, f1: 360, dur: 0.1, peak: 0.18 }); aNoise(ctx, out, t, { dur: 0.06, peak: 0.12, filter: 'lowpass', freq: 1200 }); }, pos, 'footsteps', 'jump', 0.7, 0.1); }
function sfxLand(pos, hard) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 150, f1: 60, dur: 0.12, peak: 0.3 * hard }); aNoise(ctx, out, t, { dur: 0.09, peak: 0.3 * hard, filter: 'lowpass', freq: 900 }); }, pos, 'footsteps', 'land', 1.0, 0.12); }
function sfxDive(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.3, peak: 0.4, filter: 'bandpass', freq: 500, freq1: 1500, q: 0.6 }), pos, 'footsteps', 'dive', 0.8, 0.3); }
function sfxLadderTap(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 300, f1: 180, dur: 0.04, peak: 0.16 }); aNoise(ctx, out, t, { dur: 0.03, peak: 0.1, filter: 'highpass', freq: 3000 }); }, pos, 'footsteps', 'footstep', 0.8, 0.05); }

/* --- DAMAGE / HEALTH / KILL feedback --- */
function sfxHurt(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.16, peak: 0.4, filter: 'bandpass', freq: 500, freq1: 300, q: 0.9 }); aTone(ctx, out, t, { type: 'sine', f0: 150, f1: 90, dur: 0.12, peak: 0.25 }); }, pos || playerEarPos(), 'voice', 'hurt', 0.9, 0.16); }
// LOCAL player took damage: a bass body-impact thud + a varied pained vocal grunt, scaled by the hit size. Non-positional.
function sfxHitTaken(dmg) {
  const heavy = dmg >= 40, med = dmg >= 15, vol = heavy ? 1.0 : med ? 0.8 : 0.5;
  const gf = [118, 142, 168, 196][(Math.random() * 4) | 0];   // varied grunt pitch so it doesn't repeat
  SND.play2d((ctx, out, t) => {
    aTone(ctx, out, t, { type: 'sine', f0: heavy ? 105 : 145, f1: 48, dur: heavy ? 0.17 : 0.1, peak: heavy ? 0.55 : med ? 0.38 : 0.24 });   // bass body-impact thud
    aNoise(ctx, out, t, { dur: 0.07, peak: heavy ? 0.32 : 0.18, filter: 'lowpass', freq: heavy ? 650 : 1000 });
    aTone(ctx, out, t + 0.02, { type: 'sawtooth', f0: gf, f1: gf * 0.6, dur: heavy ? 0.24 : med ? 0.16 : 0.1, peak: heavy ? 0.3 : med ? 0.2 : 0.11 });   // pained grunt
    aNoise(ctx, out, t + 0.02, { dur: 0.12, peak: 0.1 * vol, filter: 'bandpass', freq: 850, freq1: 480, q: 1.3 });
  }, 'voice', 'hittaken', vol, 0.3);
}
function sfxDeath(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 240, f1: 70, dur: 0.6, peak: 0.4 }); aNoise(ctx, out, t + 0.3, { dur: 0.2, peak: 0.3, filter: 'lowpass', freq: 600 }); }, pos || playerEarPos(), 'voice', 'death', 1.0, 0.6); }
function sfxKill(headshot) { SND.play2d((ctx, out, t) => { if (headshot) aChime(ctx, out, t, [1320, 1980], 0.05, 0.12, 0.32, 'sine'); else aTone(ctx, out, t, { type: 'sine', f0: 1180, dur: 0.12, peak: 0.3, atk: 0.005 }); }, 'ui', 'kill', 0.8, 0.15); }
// Critical-health heartbeat (looping; started/stopped by the health watcher). vol scales with how low HP is.
function sfxHeartbeat(vol) { const v = vol || 0.55; SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 60, f1: 45, dur: 0.14, peak: 0.5 }); aTone(ctx, out, t + 0.22, { type: 'sine', f0: 55, f1: 42, dur: 0.16, peak: 0.4 }); }, 'voice', 'heart', v, 0.4); }

/* --- RELOAD / ADS / scope (per-weapon flavour) --- */
function sfxReload(weaponKey, pos) {
  const w = WEAPONS[weaponKey] || {}, rstyle = w.rstyle, P = pos || playerEarPos();
  const clickMag = (ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 380, dur: 0.04, peak: 0.22 }); aTone(ctx, out, t + 0.18, { type: 'square', f0: 300, dur: 0.05, peak: 0.26 }); aNoise(ctx, out, t + 0.18, { dur: 0.05, peak: 0.18, filter: 'lowpass', freq: 1500 }); };
  let b;
  if (rstyle === 'belt') b = (ctx, out, t) => { for (let i = 0; i < 5; i++) { aNoise(ctx, out, t + i * 0.12, { dur: 0.07, peak: 0.2, filter: 'lowpass', freq: 1300 }); aTone(ctx, out, t + i * 0.12, { type: 'square', f0: 260, dur: 0.04, peak: 0.14 }); } };
  else if (rstyle === 'shell') b = (ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 520, dur: 0.04, peak: 0.18 }); aNoise(ctx, out, t + 0.05, { dur: 0.06, peak: 0.22, filter: 'lowpass', freq: 1000 }); };
  else if (rstyle === 'cylinder') b = (ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.08, peak: 0.16, filter: 'bandpass', freq: 900 }); for (let i = 0; i < 3; i++) aTone(ctx, out, t + 0.15 + i * 0.06, { type: 'triangle', f0: 1400, dur: 0.03, peak: 0.12 }); aTone(ctx, out, t + 0.4, { type: 'square', f0: 360, dur: 0.05, peak: 0.2 }); };
  else if (rstyle === 'break') b = (ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 300, f1: 200, dur: 0.1, peak: 0.2 }); aNoise(ctx, out, t + 0.2, { dur: 0.06, peak: 0.18, filter: 'lowpass', freq: 1100 }); aTone(ctx, out, t + 0.4, { type: 'square', f0: 340, dur: 0.05, peak: 0.22 }); };
  else if (rstyle === 'rpg') b = (ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.18, peak: 0.2, filter: 'lowpass', freq: 900 }); aTone(ctx, out, t + 0.25, { type: 'sine', f0: 120, dur: 0.1, peak: 0.26 }); aNoise(ctx, out, t + 0.45, { dur: 0.1, peak: 0.18, filter: 'lowpass', freq: 700 }); };
  else b = clickMag;
  SND.play3d(b, P, 'weapons', 'reload', w.suppressed ? 0.4 : 0.75, 0.6, w.suppressed ? 24 : undefined);   // suppressed = quieter, short carry
}
function sfxADS(into, scope) {
  SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.1, peak: 0.12, filter: 'bandpass', freq: into ? 1200 : 900, freq1: into ? 2200 : 600, q: 0.8 }); if (scope) aTone(ctx, out, t + 0.04, { type: 'square', f0: 1600, dur: 0.03, peak: 0.1 }); }, 'weapons', 'ads', 0.5, 0.12);
}

/* --- CIGAR --- */
function sfxCigarLight() { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 700, dur: 0.03, peak: 0.14 }); aNoise(ctx, out, t + 0.05, { dur: 0.25, peak: 0.18, filter: 'highpass', freq: 4000 }); }, 'voice', 'cig', 0.6, 0.3); }
function sfxCigarPuff() { SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.2, peak: 0.12, filter: 'bandpass', freq: 600, freq1: 900, q: 0.6 }); aNoise(ctx, out, t + 0.22, { dur: 0.25, peak: 0.1, filter: 'bandpass', freq: 800, freq1: 400, q: 0.5 }); }, 'voice', 'cig', 0.55, 0.5); }
function sfxCigarDone() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 330, f1: 440, dur: 0.5, peak: 0.3, atk: 0.05 }), 'voice', 'cig', 0.6, 0.5); }
function sfxCigarCancel() { SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.12, peak: 0.2, filter: 'highpass', freq: 5000 }); }, 'voice', 'cig', 0.5, 0.12); }

/* --- GUN GAME progression + match outcome (non-positional chimes) --- */
function sfxLevelUp() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [660, 880, 1175], 0.09, 0.16, 0.34), 'ui', 'prog', 0.8, 0.5); }
function sfxDemote() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [620, 466, 349], 0.1, 0.18, 0.32), 'ui', 'prog', 0.8, 0.6); }
function sfxFinalLevel() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [784, 988, 1318, 1568], 0.08, 0.2, 0.34), 'ui', 'prog', 0.9, 0.7); }
function sfxWin() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [523, 659, 784, 1046, 1318], 0.12, 0.28, 0.36), 'ui', 'prog', 1.0, 1.5); }
function sfxLose() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [440, 349, 262], 0.16, 0.3, 0.3), 'ui', 'prog', 0.8, 0.9); }

/* --- SCORESTREAK feedback chimes --- */
// Bright triumphant power chime when a streak tier unlocks (distinct from level-up/notify).
function sfxStreakUnlock() { SND.play2d((ctx, out, t) => { aChime(ctx, out, t, [784, 1046, 1318, 1568], 0.06, 0.22, 0.32, 'sine'); aTone(ctx, out, t, { type: 'triangle', f0: 392, f1: 784, dur: 0.4, peak: 0.18 }); }, 'ui', 'streak', 0.95, 0.6); }
// Soft low "nope" blip when a not-yet-unlocked streak key is pressed.
function sfxStreakDenied() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'square', f0: 240, f1: 150, dur: 0.1, peak: 0.16 }), 'ui', 'deny', 0.6, 0.12); }
// Descending power-down when the player dies and the streak resets.
function sfxStreakLost() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'sawtooth', f0: 520, f1: 90, dur: 0.5, peak: 0.22 }), 'ui', 'streak', 0.7, 0.5); }

/* --- LIGHTSABER + JACK DANIELS (3-kill scorestreak) --- */
// Ignition "SHWOOM": a fast upward whoosh layered with a rising hum.
function sfxSaberIgnite() { SND.play2d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.3, peak: 0.4, filter: 'bandpass', freq: 300, freq1: 2200, q: 0.7 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 120, f1: 320, dur: 0.32, peak: 0.22 }); aTone(ctx, out, t + 0.02, { type: 'sine', f0: 240, f1: 600, dur: 0.3, peak: 0.14 }); }, 'weapons', 'saberig', 0.9, 0.34); }
// Blade-flesh contact: a meaty thrum-strike (played locally on a successful hit).
function sfxSaberHit(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 420, f1: 120, dur: 0.16, peak: 0.34 }); aNoise(ctx, out, t, { dur: 0.12, peak: 0.3, filter: 'lowpass', freq: 1400 }); }, pos, 'weapons', 'saberhit', 0.85, 0.16); }
// Blade-vs-solid: sharp electric crackle/sizzle.
function sfxSaberClash(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.18, peak: 0.36, filter: 'highpass', freq: 3500 }); for (let i = 0; i < 5; i++) aTone(ctx, out, t + Math.random() * 0.12, { type: 'square', f0: 2600 + Math.random() * 3000, dur: 0.03, peak: 0.12 }); }, pos, 'weapons', 'saberclash', 0.8, 0.2); }
// --- KIRKS AVENGERS attack dogs ---
// "PACK SUMMONED" signature: a whistle + a rising/falling howl + a big bark chorus (for the summoner).
function sfxDogSummon() { SND.play2d((ctx, out, t) => {
  aTone(ctx, out, t, { type: 'sine', f0: 1000, f1: 1900, dur: 0.2, peak: 0.18 });                  // whistle
  aTone(ctx, out, t + 0.15, { type: 'sawtooth', f0: 300, f1: 640, dur: 0.45, peak: 0.2 });           // howl up
  aTone(ctx, out, t + 0.6, { type: 'sawtooth', f0: 640, f1: 240, dur: 0.5, peak: 0.18 });            // howl down
  for (let i = 0; i < 12; i++) aTone(ctx, out, t + 0.1 + Math.random() * 1.0, { type: 'sawtooth', f0: 260 + Math.random() * 260, f1: 160, dur: 0.1, peak: 0.16 });   // bark chorus
}, 'voice', 'dogsum', 1.0, 1.3); }
// Chase-loop sounds share the 'dog' audio type so polyphony is clamped to MAX 8 (see SND.LIM.dog).
function sfxDogBark(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 440, f1: 200, dur: 0.1, peak: 0.3 }); aNoise(ctx, out, t, { dur: 0.08, peak: 0.18, filter: 'bandpass', freq: 800, q: 0.8 }); }, pos, 'voice', 'dog', 0.7, 0.12); }
function sfxDogGrowl(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 95, f1: 70, dur: 0.5, peak: 0.16 }); aNoise(ctx, out, t, { dur: 0.5, peak: 0.1, filter: 'lowpass', freq: 320 }); }, pos, 'voice', 'dog', 0.7, 0.5); }
function sfxDogPaws(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.05, peak: 0.16, filter: 'lowpass', freq: 260 }), pos, 'voice', 'dog', 0.5, 0.06); }
function sfxDogPant(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.12, peak: 0.12, filter: 'bandpass', freq: 700, freq1: 1100, q: 0.6 }), pos, 'voice', 'dog', 0.45, 0.13); }
// Bite (lunge snap + chomp) and death (whimper) stay on their own one-shot types.
function sfxDogBite(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.06, peak: 0.34, filter: 'bandpass', freq: 1500, freq1: 600, q: 0.7 }); aTone(ctx, out, t, { type: 'square', f0: 210, f1: 90, dur: 0.07, peak: 0.24 }); }, pos, 'voice', 'bite', 0.8, 0.1); }
function sfxDogDeath(pos) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 720, f1: 240, dur: 0.42, peak: 0.28 }), pos, 'voice', 'yelp', 0.85, 0.44); }

/* --- KING KONG (secret boss-tier ally) --- */
// Summon + death roars are NON-positional (play2d) — a major event everyone hears equally.
function sfxKongSummon() { SND.play2d((ctx, out, t) => {
  for (let i = 0; i < 5; i++) aTone(ctx, out, t + i * 0.17, { type: 'sine', f0: 92, f1: 58, dur: 0.16, peak: 0.45 });   // jungle drums
  aTone(ctx, out, t + 0.3, { type: 'sawtooth', f0: 210, f1: 70, dur: 0.95, peak: 0.42 });                              // roar
  aTone(ctx, out, t + 0.3, { type: 'sine', f0: 90, f1: 55, dur: 0.95, peak: 0.3 });
  aNoise(ctx, out, t + 0.3, { dur: 0.95, peak: 0.3, filter: 'lowpass', freq: 800, freq1: 300 });
}, 'voice', 'kongsum', 1.0, 1.4); }
function sfxKongRoar() { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 230, f1: 52, dur: 1.5, peak: 0.45 }); aTone(ctx, out, t, { type: 'sine', f0: 72, f1: 42, dur: 1.5, peak: 0.32 }); aNoise(ctx, out, t, { dur: 1.5, peak: 0.3, filter: 'lowpass', freq: 700, freq1: 200 }); }, 'voice', 'kongroar', 1.0, 1.6); }
// Continuous Kong vocalizations share the 'kong' audio type (capped at 4 simultaneous — see SND.LIM.kong).
function sfxKongGrunt(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 145, f1: 88, dur: 0.22, peak: 0.3 }); aNoise(ctx, out, t, { dur: 0.18, peak: 0.12, filter: 'lowpass', freq: 500 }); }, pos, 'voice', 'kong', 0.7, 0.24); }
function sfxKongThump(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 120, f1: 68, dur: 0.12, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.1, peak: 0.16, filter: 'lowpass', freq: 300 }); aTone(ctx, out, t + 0.14, { type: 'sine', f0: 110, f1: 60, dur: 0.12, peak: 0.34 }); }, pos, 'voice', 'kong', 0.85, 0.28); }
function sfxKongBreath(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.5, peak: 0.13, filter: 'lowpass', freq: 360, freq1: 540 }); aNoise(ctx, out, t + 0.6, { dur: 0.42, peak: 0.1, filter: 'lowpass', freq: 300 }); }, pos, 'voice', 'kong', 0.6, 1.0); }
function sfxKongHuff(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.12, peak: 0.28, filter: 'bandpass', freq: 600, freq1: 300, q: 0.6 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 165, f1: 92, dur: 0.12, peak: 0.22 }); }, pos, 'voice', 'kong', 0.75, 0.14); }
function sfxKongRoarNear(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 240, f1: 70, dur: 0.7, peak: 0.42 }); aTone(ctx, out, t, { type: 'sine', f0: 92, f1: 52, dur: 0.7, peak: 0.28 }); aNoise(ctx, out, t, { dur: 0.7, peak: 0.26, filter: 'lowpass', freq: 700, freq1: 250 }); }, pos, 'voice', 'kong', 0.95, 0.72); }
function sfxKongBellow(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 205, f1: 110, dur: 0.3, peak: 0.34 }); aNoise(ctx, out, t, { dur: 0.24, peak: 0.2, filter: 'lowpass', freq: 600 }); }, pos, 'voice', 'kong', 0.8, 0.3); }
function sfxKongPain(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 270, f1: 120, dur: 0.3, peak: 0.36 }); aNoise(ctx, out, t, { dur: 0.2, peak: 0.16, filter: 'lowpass', freq: 800 }); }, pos, 'voice', 'kong', 0.85, 0.3); }
function sfxKongStep(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 80, f1: 45, dur: 0.16, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.12, peak: 0.18, filter: 'lowpass', freq: 250 }); }, pos, 'footsteps', 'kongstep', 0.9, 0.17); }
function sfxKongFire(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 130, f1: 50, dur: 0.28, peak: 0.55, atk: 0.004 }); aTone(ctx, out, t, { type: 'sine', f0: 70, f1: 40, dur: 0.35, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.18, peak: 0.3, filter: 'lowpass', freq: 900, freq1: 300 }); }, pos, 'weapons', 'kongfire', 1.0, 0.34); }
function sfxBananaFly(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.14, peak: 0.12, filter: 'bandpass', freq: 500, freq1: 900, q: 0.6 }), pos, 'weapons', 'banfly', 0.5, 0.14); }
function sfxBananaSplat(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.2, peak: 0.3, filter: 'lowpass', freq: 1200, freq1: 400 }); aTone(ctx, out, t, { type: 'sine', f0: 200, f1: 90, dur: 0.12, peak: 0.2 }); }, pos, 'weapons', 'bansplat', 0.7, 0.2); }
function sfxBananaHit(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.16, peak: 0.34, filter: 'lowpass', freq: 800 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 160, f1: 68, dur: 0.18, peak: 0.3 }); aTone(ctx, out, t + 0.05, { type: 'sawtooth', f0: 150, f1: 100, dur: 0.14, peak: 0.16 }); }, pos, 'weapons', 'banhit', 0.85, 0.2); }
function sfxKongMelee(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.22, peak: 0.32, filter: 'bandpass', freq: 300, freq1: 1200, q: 0.5 }); aTone(ctx, out, t + 0.12, { type: 'sine', f0: 110, f1: 55, dur: 0.16, peak: 0.35 }); }, pos, 'weapons', 'kongmel', 0.85, 0.3); }
function sfxKongHurt(pos) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sawtooth', f0: 185, f1: 110, dur: 0.16, peak: 0.26 }), pos, 'voice', 'kong', 0.6, 0.17); }

/* --- FLAMETHROWER (4-kill scorestreak) --- */
function sfxFlameLoop(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.3, peak: 0.3, filter: 'lowpass', freq: 1200, freq1: 700 }); aNoise(ctx, out, t, { dur: 0.3, peak: 0.16, filter: 'bandpass', freq: 420, freq1: 900, q: 0.4 }); }, pos, 'weapons', 'flame', 0.7, 0.3); }
function sfxFlamePilot(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.2, peak: 0.07, filter: 'highpass', freq: 3000 }), pos, 'weapons', 'flamepilot', 0.4, 0.2); }
function sfxFlameEquip(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.35, peak: 0.2, filter: 'lowpass', freq: 600, freq1: 1400 }); aTone(ctx, out, t + 0.3, { type: 'square', f0: 900, dur: 0.03, peak: 0.18 }); aTone(ctx, out, t + 0.34, { type: 'square', f0: 1200, dur: 0.03, peak: 0.16 }); }, pos || playerEarPos(), 'weapons', 'flameeq', 0.7, 0.4); }
function sfxBurnCrackle(pos) { SND.play3d((ctx, out, t) => { for (let i = 0; i < 3; i++) aNoise(ctx, out, t + Math.random() * 0.2, { dur: 0.04, peak: 0.12, filter: 'highpass', freq: 3500 }); aNoise(ctx, out, t, { dur: 0.25, peak: 0.1, filter: 'bandpass', freq: 600, q: 0.5 }); }, pos, 'weapons', 'burn', 0.5, 0.26); }
// Force jump "whoom": a low rising swoosh on a saber leap.
function sfxForceJump(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 170, f1: 440, dur: 0.32, peak: 0.3, atk: 0.02 }); aNoise(ctx, out, t, { dur: 0.32, peak: 0.18, filter: 'lowpass', freq: 600, freq1: 1700 }); }, pos, 'weapons', 'forcejmp', 0.85, 0.34); }
// Sharp electric ricochet "zing" when the saber blade deflects a bullet.
function sfxSaberDeflect(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.1, peak: 0.34, filter: 'highpass', freq: 4000 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 2200, f1: 700, dur: 0.14, peak: 0.2 }); for (let i = 0; i < 4; i++) aTone(ctx, out, t + Math.random() * 0.08, { type: 'square', f0: 3000 + Math.random() * 3500, dur: 0.025, peak: 0.12 }); }, pos, 'weapons', 'deflect', 0.8, 0.16); }
// Jack Daniels swig: a few liquid glugs then a satisfied exhale.
function sfxJDDrink() { SND.play2d((ctx, out, t) => { for (let i = 0; i < 3; i++) aNoise(ctx, out, t + 0.15 + i * 0.18, { dur: 0.1, peak: 0.18, filter: 'bandpass', freq: 380, freq1: 700, q: 1.4 }); aTone(ctx, out, t + 0.85, { type: 'sine', f0: 300, f1: 220, dur: 0.5, peak: 0.16, atk: 0.08 }); aNoise(ctx, out, t + 0.85, { dur: 0.5, peak: 0.06, filter: 'bandpass', freq: 700, q: 0.5 }); }, 'voice', 'jd', 0.8, 1.3); }

/* --- UI / menu / lobby / notifications --- */
function sfxHover() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 900, dur: 0.04, peak: 0.12 }), 'ui', 'hover', 0.5, 0.05); }
function sfxClick() { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 700, f1: 480, dur: 0.05, peak: 0.2 }); }, 'ui', 'click', 0.6, 0.06); }
function sfxMenu(open) { SND.play2d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.18, peak: 0.16, filter: 'bandpass', freq: open ? 700 : 1300, freq1: open ? 1500 : 500, q: 0.7 }), 'ui', 'menu', 0.6, 0.18); }
function sfxInvOpen() { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 520, f1: 760, dur: 0.08, peak: 0.18 }); aNoise(ctx, out, t, { dur: 0.06, peak: 0.12, filter: 'highpass', freq: 2500 }); }, 'ui', 'menu', 0.6, 0.1); }
function sfxInvSelect() { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 760, dur: 0.04, peak: 0.18 }); aTone(ctx, out, t + 0.06, { type: 'square', f0: 300, dur: 0.06, peak: 0.2 }); aNoise(ctx, out, t + 0.06, { dur: 0.05, peak: 0.14, filter: 'lowpass', freq: 1400 }); }, 'ui', 'click', 0.7, 0.12); }
function sfxSlider() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'square', f0: 1100, dur: 0.02, peak: 0.1 }), 'ui', 'tick', 0.5, 0.03); }
function sfxNotify() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [880, 1320, 1760], 0.07, 0.16, 0.34, 'sine'), 'ui', 'notify', 0.8, 0.4); }
function sfxJoin() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [660, 990], 0.07, 0.14, 0.3, 'sine'), 'ui', 'notify', 0.7, 0.25); }
function sfxLeave() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [660, 440], 0.08, 0.16, 0.28, 'sine'), 'ui', 'notify', 0.7, 0.3); }
function sfxSkinBrush() { SND.play2d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.06, peak: 0.07, filter: 'bandpass', freq: 1800, q: 0.6 }), 'ui', 'brush', 0.4, 0.06); }
function sfxSkinSave() { SND.play2d((ctx, out, t) => aChime(ctx, out, t, [784, 1046, 1318], 0.07, 0.16, 0.3, 'sine'), 'ui', 'notify', 0.7, 0.4); }
function sfxCountdown(step) { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'square', f0: step >= 3 ? 1320 : 440 + step * 180, dur: step >= 3 ? 0.3 : 0.14, peak: 0.34 }), 'ui', 'notify', 0.9, 0.3); }

/* --- AMBIENT: suburban wind loop + occasional distant birds (very low volume) --- */
const Ambient = {
  on: false, src: null, g: null, lfo: null, birdT: 0,
  start() {
    if (!SND.ready || this.on) return; this.on = true;
    const ctx = SND.ctx;
    const src = ctx.createBufferSource(); src.buffer = SND._noise; src.loop = true;
    const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 430; f.Q.value = 0.5;
    const g = ctx.createGain(); g.gain.value = 0.1;
    src.connect(f); f.connect(g); g.connect(SND.cat.ambient); src.start();
    const lfo = ctx.createOscillator(), la = ctx.createGain(); lfo.frequency.value = 0.08; la.gain.value = 0.05; lfo.connect(la); la.connect(g.gain); lfo.start();
    this.src = src; this.g = g; this.lfo = lfo; this.birdT = 3 + Math.random() * 5;
  },
  stop() { if (!this.on) return; this.on = false; try { this.src.stop(); this.lfo.stop(); } catch (e) {} this.src = this.lfo = this.g = null; },
  update(dt) {
    if (!this.on) return;
    // Windier up high (watchtower), quieter deep inside a house.
    const indoor = surfaceAt(player.pos.x, player.pos.z, player.pos.y) === 'interior';
    const base = player.pos.y > 5 ? 0.16 : indoor ? 0.05 : 0.1;
    if (this.g) this.g.gain.value += (base - this.g.gain.value) * Math.min(1, dt * 2);
    // Castle: a low, hollow stone drone when you're near/inside the keep.
    if (typeof castle !== 'undefined' && Math.hypot(player.pos.x - castle.cx, player.pos.z - castle.cz) < 24) {
      this.castleT = (this.castleT || 0) - dt;
      if (this.castleT <= 0) { this.castleT = 3 + Math.random() * 2; SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 70, dur: 1.6, peak: 0.12, atk: 0.4, verb: 0.5 }); aNoise(ctx, out, t, { dur: 1.4, peak: 0.04, filter: 'lowpass', freq: 280 }); }, new THREE.Vector3(castle.cx, 3, castle.cz), 'ambient', 'castle', 0.7, 1.6); }
    }
    this.birdT -= dt;
    if (this.birdT <= 0) {
      this.birdT = 6 + Math.random() * 10;
      const p = SND.lpos.clone().add(new THREE.Vector3((Math.random() - 0.5) * 70, 6 + Math.random() * 12, (Math.random() - 0.5) * 70));
      SND.play3d((ctx, out, t) => { const f0 = 2200 + Math.random() * 900; aTone(ctx, out, t, { type: 'sine', f0, f1: f0 * 1.3, dur: 0.08, peak: 0.13 }); aTone(ctx, out, t + 0.11, { type: 'sine', f0: f0 * 1.1, f1: f0 * 0.85, dur: 0.07, peak: 0.1 }); }, p, 'ambient', 'bird', 0.6, 0.2);
    }
  }
};
// Continuous lightsaber idle hum (two detuned saws + slow wobble) while the saber is equipped.
const SaberHum = {
  on: false, oscA: null, oscB: null, g: null, lfo: null,
  start() {
    if (!SND.ready || this.on) return; this.on = true;
    const ctx = SND.ctx;
    const oscA = ctx.createOscillator(); oscA.type = 'sawtooth'; oscA.frequency.value = 102;
    const oscB = ctx.createOscillator(); oscB.type = 'sawtooth'; oscB.frequency.value = 106;   // slight detune = beating hum
    const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 520; f.Q.value = 4;
    const g = ctx.createGain(); g.gain.value = 0.0;
    oscA.connect(f); oscB.connect(f); f.connect(g); g.connect(SND.cat.weapons);
    const lfo = ctx.createOscillator(), la = ctx.createGain(); lfo.frequency.value = 5.5; la.gain.value = 6; lfo.connect(la); la.connect(oscA.frequency);
    oscA.start(); oscB.start(); lfo.start();
    g.gain.setTargetAtTime(0.06, ctx.currentTime, 0.1);
    this.oscA = oscA; this.oscB = oscB; this.g = g; this.lfo = lfo;
  },
  stop() { if (!this.on) return; this.on = false; const ctx = SND.ctx; try { if (this.g) this.g.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.05); const a = this.oscA, b = this.oscB, l = this.lfo; setTimeout(() => { try { a.stop(); b.stop(); l.stop(); } catch (e) {} }, 200); } catch (e) {} this.oscA = this.oscB = this.lfo = this.g = null; }
};
let _heartT = 0;
function updateHeartbeat(dt) {
  if (gameState.running && player.alive && player.health > 0 && player.health < 30) {
    const f = 1 - player.health / 30;   // 0 at 30HP .. 1 near death: faster + louder as HP drops
    _heartT -= dt; if (_heartT <= 0) { sfxHeartbeat(0.4 + 0.55 * f); _heartT = 0.9 - 0.45 * f; }
  } else _heartT = 0;
}
// Per-frame: tell the audio engine where the player is hearing from (camera pos + right vector).
function updateAudioListener() {
  if (!SND.ready) return;
  const p = camera.getWorldPosition(SND._tmp.clone ? SND._tmp : new THREE.Vector3());   // (use a fresh vec for pos)
  const pos = camera.getWorldPosition(new THREE.Vector3());
  const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
  SND.setListener(pos, right);
}

/* ============================================================================
   3. MAP — Krunker-style arena (flat-colored boxes, platforms, ramps, crates)
   Collidable solids are pushed to `colliders` (meshes) for shooting + walls,
   and to `solids`/`ramps` (math boxes) for player/bot ground & wall resolution.
   ============================================================================ */
const colliders = [];     // meshes used for raycast blocking (walls/crates/platforms)
const solids    = [];     // {min,max} AABBs for collision + standing surfaces
const ramps     = [];     // {minX,maxX,minZ,maxZ, axis,'x'|'z', lowAt,highAt,lowH,highH}
const ladders   = [];     // {x,z, bottom,top, nx,nz} climbable ladders (watchtower etc.)
const spawnPoints = [];   // where players/bots can spawn
const STEP = 0.7;         // ledge auto-step height — declared here so groundHeightAt() works
                          // while the map is being built (launch pads / spawn points use it)

// Add a solid box to the world; registers visuals + collision math.
function addBox(x, y, z, w, h, d, color, opts = {}) {
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), flatMat(color));
  mesh.position.set(x, y + h / 2, z);   // y = bottom of the box
  mesh.castShadow = true; mesh.receiveShadow = true;
  if (opts.mat) mesh.userData.mat = opts.mat;   // surface tag for impact SFX ('metal' on vehicles/fence)
  scene.add(mesh);
  if (!opts.noCollide) {
    colliders.push(mesh);
    solids.push({ min: new THREE.Vector3(x - w/2, y, z - d/2), max: new THREE.Vector3(x + w/2, y + h, z + d/2) });
  }
  return mesh;
}

// Add a ramp (a tilted box you can walk up). axis is the direction it climbs.
function addRamp(x, y, z, w, d, lowH, highH, axis, color) {
  // Visual: a thin slab rotated to match the slope.
  const len = axis === 'z' ? d : w;
  const rise = highH - lowH;
  const slope = Math.atan2(rise, len);
  const slabLen = Math.sqrt(len*len + rise*rise);
  const geo = axis === 'z' ? new THREE.BoxGeometry(w, 0.4, slabLen) : new THREE.BoxGeometry(slabLen, 0.4, d);
  const mesh = new THREE.Mesh(geo, flatMat(color));
  mesh.position.set(x, y + (lowH + highH) / 2, z);
  if (axis === 'z') mesh.rotation.x = -slope; else mesh.rotation.z = slope;
  mesh.castShadow = true; mesh.receiveShadow = true;
  scene.add(mesh);
  colliders.push(mesh);
  ramps.push({
    minX: x - w/2, maxX: x + w/2, minZ: z - d/2, maxZ: z + d/2,
    axis, lowH: y + lowH, highH: y + highH,
    lowAt: axis === 'z' ? z - d/2 : x - w/2,
    highAt: axis === 'z' ? z + d/2 : x + w/2
  });
}

// Launch pads (improvement #2) and patrol points (improvement #4) live here too.
const launchPads = [];    // {minX,maxX,minZ,maxZ, top} footprints that fling the player up
const patrolPoints = [];  // Vector3 waypoints bots roam between (some elevated)

// A launch pad: a bright, glowing flat slab. Visual only (no block) + a trigger footprint.
function addLaunchPad(x, z, color) {
  const size = 6, padY = groundHeightAt(x, z, 50);
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(size, 0.4, size),
    new THREE.MeshLambertMaterial({ color, emissive: color, emissiveIntensity: 0.9 }));
  mesh.position.set(x, padY + 0.2, z);
  mesh.receiveShadow = true;
  scene.add(mesh);
  // A faint upward "beam" so it reads as a jump pad from a distance
  const beam = new THREE.Mesh(new THREE.BoxGeometry(size * 0.7, 8, size * 0.7),
    new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.12 }));
  beam.position.set(x, padY + 4, z);
  scene.add(beam);
  launchPads.push({ minX: x - size/2, maxX: x + size/2, minZ: z - size/2, maxZ: z + size/2, top: padY + 0.4 });
}

/* ===========================================================================
   NUKETOWN — compact symmetrical Cold-War test-site: two enterable houses
   facing each other across a street, vehicles for center cover, three lanes
   (left flank / street / right flank), ringed by yellow chevron hazard fence.
   Built entirely from flat-shaded primitives; collision via solids/ramps.
   =========================================================================== */
// SPREAD: every map FEATURE position is multiplied by this so the playspace grows but props keep their size
// (just spread farther apart). Bumping it +35% here makes room for the grand mansion estate on the right flank.
const SPREAD = 1.35;
const SP = v => v * SPREAD;   // scale a single coordinate
const ARENA = Math.round(84 * SPREAD);   // ~226×226 playspace; FENCE + floor + all entity bounds clamps derive from this

// Washed-out 1950s nuclear-test daylight (overrides the earlier sky/fog/sun tone).
scene.background = new THREE.Color(0xbcd6e4);
scene.fog = new THREE.Fog(0xcfd9cf, 95, 280);
sun.color.setHex(0xfff1d4); sun.intensity = 1.0; sun.position.set(40, 90, 30);

// --- Lawn floor + central asphalt street (wider street + more spacing for the bigger map) ---
const floor = new THREE.Mesh(new THREE.PlaneGeometry(ARENA * 2, ARENA * 2), flatMat(0x7BAE6C));
floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; scene.add(floor);
addBox(0, -0.02, 0, SP(30), 0.05, SP(150), 0x8A8A8A, { noCollide: true });  // street down the long (Z) axis
addBox(0, -0.02, 0, SP(2.4), 0.06, SP(140), 0xd8d49a, { noCollide: true }); // faded centre line

// --- Wall builders: panelWall cuts door/window holes out of a wall plane ---
function wallSeg(axis, fixed, a0, a1, y0, y1, t, color) {
  const len = a1 - a0; if (len <= 0.02 || y1 - y0 <= 0.02) return;
  if (axis === 'x') addBox((a0 + a1) / 2, y0, fixed, len, y1 - y0, t, color);
  else addBox(fixed, y0, (a0 + a1) / 2, t, y1 - y0, len, color);
}
function panelWall(axis, fixed, A0, A1, Y0, Y1, t, color, holes) {
  holes = holes || [];
  const cuts = [A0, A1]; holes.forEach(h => { cuts.push(h.a0, h.a1); });
  const xs = [...new Set(cuts)].filter(v => v >= A0 - 1e-6 && v <= A1 + 1e-6).sort((a, b) => a - b);
  for (let i = 0; i < xs.length - 1; i++) {
    const c0 = xs[i], c1 = xs[i + 1], cm = (c0 + c1) / 2;
    let bands = [[Y0, Y1]];
    holes.filter(h => h.a0 <= cm && h.a1 >= cm).forEach(h => {
      const nb = [];
      bands.forEach(([b0, b1]) => { const lo = Math.max(b0, h.y0), hi = Math.min(b1, h.y1); if (lo >= hi) nb.push([b0, b1]); else { if (b0 < lo) nb.push([b0, lo]); if (hi < b1) nb.push([hi, b1]); } });
      bands = nb;
    });
    bands.forEach(([b0, b1]) => wallSeg(axis, fixed, c0, c1, b0, b1, t, color));
  }
}
function cyl(x, y, z, r, h, color, rotAxis) {
  const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, 12), flatMat(color));
  m.position.set(x, y, z); if (rotAxis === 'x') m.rotation.x = Math.PI / 2; else if (rotAxis === 'z') m.rotation.z = Math.PI / 2;
  m.castShadow = true; scene.add(m); return m;
}

// --- A substantial two-story enterable suburban home (front faces map centre).
// Both houses share this layout, mirrored across the central axis via `fdir`.
// Scaled ~60% bigger than the original so rooms, halls, stairs + headroom feel roomy.
function buildHouse(cx, cz, wallC, roofC) {
  const W = 24, D = 18, t = 0.4, H = 12.4, F2 = 6.2;   // wider/deeper/taller; thicker walls; tall floors
  const fdir = cz > 0 ? -1 : 1;                        // direction from this house toward centre
  const frontZ = cz + fdir * (D / 2), backZ = cz - fdir * (D / 2);
  const xl = cx - W / 2, xr = cx + W / 2;
  const z0 = Math.min(frontZ, backZ), z1 = Math.max(frontZ, backZ);
  addBox(cx, 0, cz, W - 0.5, 0.06, D - 0.5, 0x6b5333, { noCollide: true });   // wood floor (stand on world y=0)
  // FRONT wall: big door + 2 large ground windows + a wide upper window (the iconic sniper peek)
  panelWall('x', frontZ, xl, xr, 0, H, t, wallC, [
    { a0: cx - 2.2, a1: cx + 2.2, y0: 0,       y1: 4.4 },
    { a0: xl + 2.4, a1: xl + 6.4, y0: 1.4,     y1: 4.2 },
    { a0: xr - 6.4, a1: xr - 2.4, y0: 1.4,     y1: 4.2 },
    { a0: cx - 5,   a1: cx + 5,   y0: F2 + 1.0, y1: H - 1.6 }
  ]);
  // BACK wall: back door (to side yard) + wide upper window
  panelWall('x', backZ, xl, xr, 0, H, t, wallC, [
    { a0: cx - 2.2, a1: cx + 2.2, y0: 0,       y1: 4.4 },
    { a0: cx - 5,   a1: cx + 5,   y0: F2 + 1.0, y1: H - 1.6 }
  ]);
  // SIDE walls: a big ground window + a big upper window each side
  [xl, xr].forEach(sx => panelWall('z', sx, z0, z1, 0, H, t, wallC, [
    { a0: cz - 4, a1: cz - 0.4, y0: 1.4,     y1: 4.2 },
    { a0: cz + 0.4, a1: cz + 4, y0: F2 + 1.0, y1: H - 1.8 }
  ]));
  addBox(cx, H, cz, W, 0.4, D, roofC);                                   // roof cap (solid — standable)
  // --- 2nd-floor slab: covers the front portion; a ~6.5-deep stairwell stays open at the back ---
  const stairOpen = 6.5, stairW = 4.0;
  const slabFrontO = D / 2 - 0.2, slabBackO = -D / 2 + stairOpen;
  addBox(cx, F2 - 0.2, cz + fdir * (slabBackO + slabFrontO) / 2, W - 0.8, 0.2, slabFrontO - slabBackO, 0x7a6a4a);
  // Wide stairwell (ground -> 2nd floor) centred in the back-open region.
  const stairCz = cz + fdir * (-D / 2 + stairOpen / 2);
  if (fdir > 0) addRamp(cx, 0, stairCz, stairW, stairOpen, 0, F2, 'z', 0x5a4a2a);
  else          addRamp(cx, 0, stairCz, stairW, stairOpen, F2, 0, 'z', 0x5a4a2a);
  // Banister posts flanking the stairwell so the opening reads (decor).
  [cx - stairW / 2, cx + stairW / 2].forEach(px => addBox(px, F2, cz + fdir * slabBackO, 0.18, 1.1, 0.18, 0x5a4a2a, { noCollide: true }));
  // --- Interior partitions: GROUND FLOOR -> left room | central hall (stairs) | right room ---
  [cx - 5, cx + 5].forEach(px => panelWall('z', px, z0 + t, z1 - t, 0, F2 - 0.2, t, 0xcfc4a8, [
    { a0: cz - 1.5, a1: cz + 1.5, y0: 0, y1: 3.4 }                       // doorway hall <-> room
  ]));
  // --- Interior partitions: 2ND FLOOR -> two bedrooms off the landing (only over the slab) ---
  const upBack = cz + fdir * slabBackO;
  [cx - 5, cx + 5].forEach(px => panelWall('z', px, Math.min(upBack, z1 - t), Math.max(upBack, z1 - t), F2, H - 0.4, t, 0xcfc4a8, [
    { a0: cz + fdir * 2 - 1.4, a1: cz + fdir * 2 + 1.4, y0: F2, y1: F2 + 3.2 }
  ]));
  // --- Interior cover / furniture (low-poly flat-shaded; solid so they're real cover) ---
  addBox(cx - 8.5, 0,  cz + fdir * 3.5, 3.6, 1.0, 1.4, 0x8a5a3a);        // living-room couch (left room)
  addBox(cx - 10.6, 0, cz - fdir * 4.5, 1.0, 2.6, 2.8, 0x5a3f24);        // tall bookshelf (left room)
  addBox(cx - 6.5, 0,  cz - fdir * 5,   1.8, 0.9, 1.0, 0x7a5a3a);        // side table
  addBox(cx + 8.5, 0,  cz - fdir * 3.5, 3.8, 1.1, 2.6, 0x9aa0ad);        // bed (right room)
  addBox(cx + 10.6, 0, cz + fdir * 4.5, 1.3, 1.3, 1.3, 0x6a4a2a);        // dresser (right room)
  addBox(cx, 0,        cz + fdir * 6.4, 2.4, 1.0, 1.2, 0x7a5a3a);        // hall console table (near front door)
  addBox(cx - 7, F2,   cz + fdir * 2,   3.6, 1.0, 2.4, 0x9aa0ad);        // upstairs bed
  addBox(cx + 7, F2,   cz + fdir * 2,   2.0, 0.9, 1.0, 0x7a5a3a);        // upstairs table
  addBox(cx + 9.5, F2, cz - fdir * 4,   1.0, 2.4, 2.4, 0x5a3f24);        // upstairs bookshelf
  // --- Porch: SOLID floor (stand/walk on it) + posts + overhang + a low step up from the lawn ---
  const porchZ = frontZ + fdir * 2.4;
  addBox(cx, 0, porchZ, W - 3, 0.3, 4.6, 0xbdb39a);                                  // porch FLOOR (solid; top ~0.3)
  addBox(cx, 0, porchZ + fdir * 2.7, W - 4, 0.15, 0.9, 0xb0a690);                    // step up from the lawn (solid; auto-stepped)
  addBox(cx - W / 2 + 2, 2.6, porchZ + fdir * 1.8, 0.4, 5.2, 0.4, roofC);            // support post (solid)
  addBox(cx + W / 2 - 2, 2.6, porchZ + fdir * 1.8, 0.4, 5.2, 0.4, roofC);            // support post (solid)
  addBox(cx, 5.0, porchZ, W - 2, 0.3, 5, roofC);                                     // overhang roof (solid)
  addBox(cx - W / 2 - 7, -0.02, cz, 11, 0.05, 13, 0x8A8A8A, { noCollide: true });    // driveway (flat ground decor)
  return { cx, cz, frontZ, fdir };
}
const houseN = buildHouse(SP(0),  SP(58), 0xE8D27A, 0xb89a4a);   // yellow (north) — same size, spread farther out
const houseS = buildHouse(SP(0), SP(-58), 0x5C9C8E, 0x3f6e63);   // teal  (south)

// --- Center cover: a bus (one side of the street) + a small car (other side). Scaled ~30%
// bigger so they stay useful cover on the larger map; box collision wraps the full body. ---
function buildBus(x, z) {
  addBox(x, 0, z, 5.7, 5.5, 15.6, 0xe8e0c8, { mat: 'metal' });             // body (cover)
  addBox(x, 3.4, z, 5.8, 1.6, 14.3, 0x6a86a0, { noCollide: true });        // window band
  addBox(x, 0.4, z - 7.8, 5.7, 0.9, 1.3, 0x333333, { noCollide: true });   // bumper
  [[-2.7, -5.5], [-2.7, 5.5], [2.7, -5.5], [2.7, 5.5]].forEach(([wx, wz]) => cyl(x + wx, 0.9, z + wz, 0.9, 0.6, 0x161616, 'x'));
}
function buildCar(x, z, color) {
  addBox(x, 0, z, 4.4, 1.8, 7.8, color, { mat: 'metal' });                 // lower body
  addBox(x, 1.8, z + 0.3, 3.9, 1.4, 4.2, color, { mat: 'metal' });         // cabin
  addBox(x, 2.1, z + 0.3, 4.0, 1.1, 3.9, 0x556677, { noCollide: true });   // windows
  [[-1.9, -2.5], [-1.9, 2.5], [1.9, -2.5], [1.9, 2.5]].forEach(([wx, wz]) => cyl(x + wx, 0.7, z + wz, 0.7, 0.5, 0x111111, 'x'));
}
buildBus(SP(-10), SP(8));                   // bus, left of street centre (same size — spread apart on the bigger street)
buildCar(SP(10), SP(-9), 0xb55a4a);         // faded-red sedan, right of street centre
// Central bus-stop sign post (cosmetic)
cyl(SP(11), 1.4, SP(1.5), 0.12, 2.8, 0x6b5333);
addBox(SP(11), 2.4, SP(1.5), 1.2, 0.7, 0.12, 0xddddcc, { noCollide: true });

// --- Mannequins (cream, no collision — bullets pass through) ---
function mannequin(x, z, ry, sitting) {
  const C = 0xe8dcc0, g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry || 0;
  const b = (bx, by, bz, w, h, d) => { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), flatMat(C)); m.position.set(bx, by, bz); g.add(m); };
  if (sitting) { b(0, 0.45, 0, 0.5, 0.9, 0.5); b(0, 0.22, 0.32, 0.45, 0.45, 0.6); b(0, 1.15, 0, 0.4, 0.4, 0.4); }
  else { b(0, 0.5, 0, 0.45, 1.0, 0.45); b(0, 1.45, 0, 0.85, 0.8, 0.5); b(-0.5, 1.45, 0, 0.18, 0.7, 0.18); b(0.5, 1.45, 0, 0.18, 0.7, 0.18); b(0, 2.1, 0, 0.42, 0.42, 0.42); }
  scene.add(g);
}
// lawn chairs + 2 sitting mannequins on the yellow porch (mannequins stay realistic player-scale)
addBox(SP(-4), 0.3, SP(47), 1.0, 0.6, 1.0, 0x9a3b3b, { noCollide: true });
addBox(SP(4), 0.3, SP(47), 1.0, 0.6, 1.0, 0x3b5a9a, { noCollide: true });
mannequin(SP(-4), SP(47), Math.PI, true); mannequin(SP(4), SP(47), Math.PI, true);
mannequin(SP(-19), SP(38), 0.4);                // standing in the yellow front yard
mannequin(SP(16), SP(2), -1.6);                 // near the bus stop
mannequin(SP(0), SP(-66), 0);                   // visible through the teal back window
mannequin(SP(-7), SP(55), 0.2);                 // inside the yellow house

// --- Lawn props (mailboxes, picnic table, tricycle) — realistic scale relative to mannequins ---
addBox(SP(-24), 0, SP(66), 0.4, 1.1, 0.4, 0x7a5a3a); addBox(SP(-24), 1.2, SP(66), 0.7, 0.5, 0.5, 0x444444);   // yellow mailbox
addBox(SP(24), 0, SP(-66), 0.4, 1.1, 0.4, 0x7a5a3a); addBox(SP(24), 1.2, SP(-66), 0.7, 0.5, 0.5, 0x444444);   // teal mailbox
addBox(SP(18), 0, SP(-42), 3, 1.0, 1.6, 0x9c7a4a);                      // picnic table (cover)
addBox(SP(-15), 0.25, SP(-40), 0.8, 0.5, 1.4, 0x9a9a3b, { noCollide: true });  // tricycle-ish
addBox(SP(15), 0.2, SP(40), 1.2, 0.4, 0.7, 0xcc8844, { noCollide: true });     // tipped lawn chair

// --- Flank cover (left/right alleys alongside the houses) — spread out for the wider lanes ---
[[-48, 20], [-48, -20], [48, 16], [48, -16], [-44, 0], [44, 0]].forEach(([cx, cz], i) =>
  addBox(SP(cx), 0, SP(cz), 2.8, 2.8, 2.8, i % 2 ? 0x8a5a2b : 0x6a7a4a));      // prop crates / shrubs

// --- WATCHTOWER (left flank): weathered-wood high-ground sniper perch with a climbable ladder.
// Tall enough to see over the houses' second floors; tucked near the -X fence with clearance
// so players can still run past it on either side. Ladder faces map centre (+X). ---
// Tall multi-level fortified outpost (the premier sniper spot). 6x6 footprint, THREE levels:
// ground (open legs + ladder), a small enclosed MID room (~midY), and a walled TOP platform with
// shooting windows + crenellations + a partial metal roof + a central antenna pole. Full-height
// ladder from the ground to the top, with a mid-platform step-off (press E while passing it).
function buildWatchtower(cx, cz) {
  const wood = 0x9a7a4a, woodDk = 0x6f5733, woodLt = 0xb39463, metal = 0x6f6f6f, metalDk = 0x4e4e52, rust = 0x6e4226;
  const half = 3.0, midY = 7.5, topY = 15.0, legW = 0.55;
  // 4 corner legs (solid) the full height + metal reinforcement straps + rust streaks (decor).
  [[-half, -half], [-half, half], [half, -half], [half, half]].forEach(([lx, lz]) => {
    addBox(cx + lx, 0, cz + lz, legW, topY, legW, woodDk);
    [3, 7.5, 11.5].forEach(sy => addBox(cx + lx, sy, cz + lz, legW + 0.12, 0.25, legW + 0.12, metalDk, { noCollide: true }));
    addBox(cx + lx + 0.02, 5, cz + lz, 0.06, 1.6, 0.06, rust, { noCollide: true });
  });
  // Diagonal cross-braces between legs (decor) for the truss look.
  [1.6, 5.5, 9.5, 13].forEach(by => {
    addBox(cx, by, cz - half, half * 2, 0.22, 0.2, wood, { noCollide: true });
    addBox(cx, by + 0.9, cz + half, half * 2, 0.22, 0.2, wood, { noCollide: true });
    addBox(cx - half, by, cz, 0.2, 0.22, half * 2, wood, { noCollide: true });
    addBox(cx + half, by + 0.9, cz, 0.2, 0.22, half * 2, wood, { noCollide: true });
  });
  // ----- MID PLATFORM: small enclosed room; the +X side (toward the boost pad/centre) is open. -----
  addBox(cx, midY - 0.3, cz, half * 2 + 0.6, 0.3, half * 2 + 0.6, wood);   // floor (top = midY)
  const mWallH = 2.4, mTop = midY + mWallH, mw = 1.6;
  panelWall('z', cx - half - 0.2, cz - half - 0.3, cz + half + 0.3, midY, mTop, 0.25, woodLt, [{ a0: cz - mw / 2, a1: cz + mw / 2, y0: midY + 0.7, y1: mTop - 0.4 }]);   // back (-X) wall + window
  [cz - half - 0.2, cz + half + 0.2].forEach(pz =>
    panelWall('x', pz, cx - half - 0.3, cx + half + 0.3, midY, mTop, 0.25, woodLt, [{ a0: cx - mw / 2, a1: cx + mw / 2, y0: midY + 0.7, y1: mTop - 0.4 }]));   // side walls + windows
  panelWall('z', cx + half + 0.2, cz - half - 0.3, cz + half + 0.3, midY, midY + 0.7, 0.2, woodLt, [{ a0: cz - 1.0, a1: cz + 1.0, y0: midY, y1: midY + 0.7 }]);   // open +X side: low rail with an entry gap
  // ----- TOP PLATFORM: full walls + shooting windows on all 4 sides + crenellations. -----
  addBox(cx, topY - 0.3, cz, half * 2 + 0.7, 0.3, half * 2 + 0.7, wood);   // floor (top = topY)
  const tWallH = 1.6, tTop = topY + tWallH, gw = 1.8;
  [cx - half - 0.25, cx + half + 0.25].forEach(px =>
    panelWall('z', px, cz - half - 0.35, cz + half + 0.35, topY, tTop, 0.25, wood, [{ a0: cz - gw / 2, a1: cz + gw / 2, y0: topY + 0.45, y1: tTop }]));
  [cz - half - 0.25, cz + half + 0.25].forEach(pz =>
    panelWall('x', pz, cx - half - 0.35, cx + half + 0.35, topY, tTop, 0.25, wood, [{ a0: cx - gw / 2, a1: cx + gw / 2, y0: topY + 0.45, y1: tTop }]));
  const merl = (x, z) => addBox(x, tTop, z, 0.5, 0.5, 0.5, woodDk, { noCollide: true });   // merlons (crouch cover)
  for (let a = -half; a <= half + 0.01; a += 1.2) { merl(cx + a, cz - half - 0.25); merl(cx + a, cz + half + 0.25); merl(cx - half - 0.25, cz + a); merl(cx + half + 0.25, cz + a); }
  // Partial corrugated-metal roof over the back (-X) half — blocks RC dives there; +X stays open sky.
  addBox(cx - half * 0.5, tTop + 2.3, cz, half + 0.4, 0.3, half * 2 + 0.7, metalDk);
  for (let rz = cz - half; rz <= cz + half + 0.01; rz += 0.5) { const r = new THREE.Mesh(new THREE.BoxGeometry(half + 0.5, 0.08, 0.42), flatMat(metal)); r.position.set(cx - half * 0.5, tTop + 2.5, rz); r.rotation.x = 0.12; scene.add(r); }
  cyl(cx, tTop + 3.0, cz, 0.09, 6.0, metal);                                   // central antenna/lookout pole (cosmetic)
  addBox(cx, tTop + 5.6, cz, 1.2, 0.06, 0.06, metalDk, { noCollide: true });    // antenna crossbar
  // Atmosphere props (cosmetic): a folded chair + radio on the mid platform, binoculars up top.
  addBox(cx - 1.4, midY, cz - 1.4, 0.5, 0.05, 0.5, 0x3a4a5a, { noCollide: true }); addBox(cx - 1.55, midY + 0.05, cz - 1.6, 0.5, 0.55, 0.05, 0x3a4a5a, { noCollide: true });
  addBox(cx - 0.9, midY, cz - 1.5, 0.3, 0.26, 0.2, 0x2a2a2a, { noCollide: true });
  addBox(cx + 1.2, topY, cz + 1.2, 0.3, 0.12, 0.16, 0x1a1a1a, { noCollide: true });
  // ----- LADDER: full height (ground -> top), +X face, with a mid-platform exit (E while passing it). -----
  const lx = cx + half + 0.5;
  [cz - 0.55, cz + 0.55].forEach(rz => addBox(lx, 0, rz, 0.12, topY, 0.12, woodDk, { noCollide: true }));   // 2 rails
  for (let y = 0.5; y < topY; y += 0.55) { const m = new THREE.Mesh(new THREE.BoxGeometry(1.3, 0.1, 0.1), flatMat(metal)); m.position.set(lx, y, cz); scene.add(m); }
  ladders.push({ x: lx, z: cz, bottom: 0, top: topY, cx, cz, outX: 1, outZ: 0, midY });   // W climbs to top; E at midY steps onto the mid platform
  return { cx, cz, platY: topY, midY };
}
const watchtower = buildWatchtower(SP(-69), 0);   // taller multi-level outpost on the left flank (highest point on the map)

/* --- BOOST PADS: glowing kinetic launch pads. Step on one to get flung high upward while
   keeping your horizontal momentum (arc forward) or straight up if standing still. Per-pad
   cooldown; fall-damage immunity on launch; aerial control is fully free. --- */
const BOOST = { launch: 45, radius: 1.6, cooldown: 0.5, grace: 4.0, humR: 10 };
const boostPads = [];
function addBoostPad(x, z) {
  const y = groundHeightAt(x, z, 0.5);
  const grp = new THREE.Group(); grp.position.set(x, y, z);
  const base = new THREE.Mesh(new THREE.CylinderGeometry(BOOST.radius + 0.25, BOOST.radius + 0.4, 0.18, 18), new THREE.MeshLambertMaterial({ color: 0x10222e, flatShading: true }));
  base.position.y = 0.09; grp.add(base);
  const glowMat = new THREE.MeshBasicMaterial({ color: 0x32e0ff, transparent: true, opacity: 0.85 });
  const ring = new THREE.Mesh(new THREE.CylinderGeometry(BOOST.radius, BOOST.radius, 0.06, 18), glowMat); ring.position.y = 0.2; grp.add(ring);
  const arrow = new THREE.Mesh(new THREE.ConeGeometry(0.55, 0.9, 4), glowMat); arrow.position.y = 0.7; grp.add(arrow);   // up-pointing chevron/arrow
  const parts = [];
  for (let i = 0; i < 9; i++) {
    const m = new THREE.Mesh(new THREE.SphereGeometry(0.08, 6, 5), new THREE.MeshBasicMaterial({ color: 0x9cf2ff, transparent: true, opacity: 0.9 }));
    m.position.set((Math.random() - 0.5) * BOOST.radius * 1.5, Math.random() * 3.2, (Math.random() - 0.5) * BOOST.radius * 1.5); grp.add(m); parts.push(m);
  }
  scene.add(grp);
  boostPads.push({ x, z, y, grp, glowMat, arrow, parts, cd: 0, humT: Math.random() * 0.5, t: 0 });
}
// 6 pads: a front yard of each house (roof access), the contested centre, both flank lanes, the watchtower base.
// ([41,0] is the old castle-approach pad, nudged in so it lands on the driveway in front of the estate gate, not inside the courtyard)
[[0, 47], [0, -47], [0, 0], [-45, 26], [41, 0], [-62, 0]].forEach(([x, z]) => addBoostPad(SP(x), SP(z)));

// Boost-pad SFX: a low positional hum when you're near a ready pad + a whoosh/charge on launch.
function sfxBoostHum(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 110, dur: 0.5, peak: 0.12 }); aTone(ctx, out, t, { type: 'sine', f0: 165, dur: 0.5, peak: 0.05 }); }, pos, 'ambient', 'boosthum', 0.6, 0.5); }
function sfxBoostLaunch(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.4, peak: 0.6, filter: 'bandpass', freq: 400, freq1: 1800, q: 0.8, verb: 0.4 }); aTone(ctx, out, t, { type: 'sawtooth', f0: 300, f1: 1400, dur: 0.35, peak: 0.3 }); for (let i = 0; i < 4; i++) aTone(ctx, out, t + 0.02 + Math.random() * 0.2, { type: 'square', f0: 2200 + Math.random() * 2500, dur: 0.04, peak: 0.1 }); }, pos, 'weapons', 'boost', 1.0, 0.4); }

// Fling the local player upward off a pad (keeps horizontal momentum; cancels ADS/reload/cigar).
function boostLaunch(pad) {
  player.vel.y = BOOST.launch;                       // strong, fresh upward launch (stacking-friendly)
  player.onGround = false; player.jumps = 1; player.sliding = false; player.diving = false;
  player.impulseT = 1.2; player.impulseGrace = BOOST.grace;   // un-clamped horizontal + fall-damage immunity
  aiming = false;
  const ws = weaponState[currentWeaponKey]; if (ws) ws.reloading = 0;   // launching cancels a reload
  cigCancel();                                       // ...and a cigar heal
  pad.cd = BOOST.cooldown;
  addShake(0.06, 0.3);
  el('boostFlash').style.opacity = 0.9; setTimeout(() => el('boostFlash').style.opacity = 0, 130);
  const p = new THREE.Vector3(pad.x, pad.y, pad.z);
  sfxBoostLaunch(p); sfxLaunched(playerEarPos());
  if (NET.active) NET.broadcast({ t: 'boost', i: boostPads.indexOf(pad) });
}
// Per-frame: pulse glow, rise particles (paused on cooldown), proximity hum, and the launch test.
function updateBoostPads(dt) {
  for (let k = 0; k < boostPads.length; k++) {
    const pad = boostPads[k];
    if (pad.cd > 0) pad.cd -= dt;
    pad.t += dt;
    const ready = pad.cd <= 0;
    const pulse = ready ? 0.6 + 0.3 * Math.sin(pad.t * 4) : 0.22;   // dim while on cooldown
    pad.glowMat.opacity = pulse;
    pad.arrow.position.y = 0.7 + (ready ? Math.sin(pad.t * 4) * 0.08 : 0);
    for (const m of pad.parts) {                       // rising glow dots (frozen during cooldown)
      if (ready) { m.position.y += dt * 1.4; if (m.position.y > 3.2) { m.position.y = 0; } }
      m.material.opacity = ready ? Math.max(0, 0.9 * (1 - m.position.y / 3.2)) : 0.15;
    }
    if (!gameState.running || !player.alive) continue;
    const dx = player.pos.x - pad.x, dz = player.pos.z - pad.z, d = Math.hypot(dx, dz);
    // Proximity hum when near a ready pad.
    if (ready && d < BOOST.humR) { pad.humT -= dt; if (pad.humT <= 0) { sfxBoostHum(new THREE.Vector3(pad.x, pad.y + 0.5, pad.z)); pad.humT = 0.55; } }
    // Step-on launch (player on/near the pad surface).
    if (ready && d < BOOST.radius + MOVE.radius && player.pos.y <= pad.y + 1.3) boostLaunch(pad);
  }
}

/* ============================================================================
   THE MANSION ESTATE (right flank, opposite the watchtower) — a sprawling Gilded-Age
   stone manor. U-plan around a formal forecourt: a 3-storey central block (grand foyer +
   sweeping stair, dining, kitchen, bedrooms, study, attic), two great wings (BALLROOM north,
   LIBRARY south), FOUR corner sniper towers, a rear wine-cellar undercroft with a SECRET
   garden passage, dozens of playable windows (open archways; some low-silled to vault through),
   and formal grounds (fountain, hedges, urns, driveway, gates). Flat-shaded limestone; full
   solid collision via addBox/solids. Local coords: +X = back (away from map), -X = front
   (toward map centre / entrance), ±Z = wings. Built flush at world y=0 so spawns/bots/jump-
   windows all work (the engine's ground can't go sub-grade — the "cellar" is a dark rear
   undercroft at grade). ~38×38 footprint. ============================================================================ */
function buildMansion(cx, cz) {
  // --- palette ---
  const stone = 0xb8b09a, stoneLt = 0xcdc6b2, stoneDk = 0x7c7666, stoneWarm = 0xa89e84, stoneCool = 0x9aa0a0;
  const slate = 0x3d4452, slateDk = 0x2b313c, wood = 0x6f5333, woodDk = 0x49371f, woodLt = 0x8c6a3c;
  const marble = 0xdcd7cb, marbleDk = 0xb7b0a0, parquet = 0x7a5a32, carpet = 0x7a2230, gold = 0xc9a24a, glassC = 0xacc4d2;
  const T = 0.8, GF = 0, F2 = 6, F3 = 11, RF = 15.5;     // wall thickness + floor (walk-on) heights
  const glows = [];                                       // [x,y,z,w,h,d,color,max] warm interior glows for night
  const glassMat = new THREE.MeshBasicMaterial({ color: glassC, transparent: true, opacity: 0.16, depthWrite: false });
  // --- local→world helpers ---
  const B  = (lx, y, lz, w, h, d, c, o) => addBox(cx + lx, y, cz + lz, w, h, d, c, o);          // solid box (local)
  const BD = (lx, y, lz, w, h, d, c) => addBox(cx + lx, y, cz + lz, w, h, d, c, { noCollide: true });  // decorative
  const glow = (lx, y, lz, w, h, d, c, m) => glows.push([cx + lx, y, cz + lz, w, h, d, c, m == null ? 0.8 : m]);
  function pane(lx, y, lz, w, h, vertical) {              // faint glass (in a wall plane); vertical=true => spans X/Y at fixed Z
    const m = new THREE.Mesh(vertical ? new THREE.PlaneGeometry(w, h) : new THREE.PlaneGeometry(w, h), glassMat);
    m.position.set(cx + lx, y, cz + lz); if (!vertical) m.rotation.y = Math.PI / 2; scene.add(m);
  }
  // window/door dressing: faint glass + a low marker sill for the wide vault-through windows
  function dressWin(axis, fixed, center, w, y0, y1, jump) {
    const my = (y0 + y1) / 2, h = y1 - y0;
    if (axis === 'x') { pane(center, my, fixed, w, h, true); if (jump) BD(center, y0 + 0.06, fixed, w, 0.16, T + 0.3, gold); }
    else { pane(fixed, my, center, w, h, false); if (jump) BD(fixed, y0 + 0.06, center, T + 0.3, 0.16, w, gold); }
  }
  // walls along X (fixed local Z) / Z (fixed local X); holes/dressing in LOCAL coords
  function wallX(lzf, lx0, lx1, y0, y1, c, holes) {
    holes = holes || [];
    panelWall('x', cz + lzf, cx + lx0, cx + lx1, y0, y1, T, c, holes.map(h => ({ a0: cx + h.a0, a1: cx + h.a1, y0: h.y0, y1: h.y1 })));
    holes.forEach(h => dressWin('x', cz + lzf, cx + (h.a0 + h.a1) / 2, h.a1 - h.a0, h.y0, h.y1, h.jump));
  }
  function wallZ(lxf, lz0, lz1, y0, y1, c, holes) {
    holes = holes || [];
    panelWall('z', cx + lxf, cz + lz0, cz + lz1, y0, y1, T, c, holes.map(h => ({ a0: cz + h.a0, a1: cz + h.a1, y0: h.y0, y1: h.y1 })));
    holes.forEach(h => dressWin('z', cx + lxf, cz + (h.a0 + h.a1) / 2, h.a1 - h.a0, h.y0, h.y1, h.jump));
  }
  function slab(lx, lz, w, d, top, c, deco) { B(lx, top - 0.4, lz, w, 0.4, d, c, deco ? { noCollide: true } : undefined); }  // floor slab, walkable top at `top`
  // evenly spaced window holes along [a0,a1]
  function wins(a0, a1, y0, y1, n, ww, jump) { const out = [], step = (a1 - a0) / n; for (let i = 0; i < n; i++) { const cM = a0 + (i + 0.5) * step; out.push({ a0: cM - ww / 2, a1: cM + ww / 2, y0, y1, jump }); } return out; }
  // decorative quoins up a vertical corner + horizontal cornice band
  function quoin(lx, lz) { for (let y = 0.6; y < RF; y += 1.3) BD(lx, y, lz, 1.4, 0.78, 1.4, (Math.round(y) % 2 ? stoneLt : stoneWarm)); }
  function cornice(lzf, lx0, lx1, y) { BD((lx0 + lx1) / 2, y, lzf, lx1 - lx0, 0.4, T + 0.5, stoneLt); }   // along X
  function corniceZ(lxf, lz0, lz1, y) { BD(lxf, y, (lz0 + lz1) / 2, T + 0.5, 0.4, lz1 - lz0, stoneLt); }  // along Z
  // balustrade rail (solid waist-high top + bottom + decorative spindles). axis 'x' runs along X at fixed Z.
  function balus(axis, fixed, a0, a1, y) {
    const rh = 1.0;
    if (axis === 'x') { B((a0 + a1) / 2, y, fixed, a1 - a0, 0.16, 0.2, stoneLt); B((a0 + a1) / 2, y + rh - 0.18, fixed, a1 - a0, 0.2, 0.26, stoneLt);
      for (let a = a0 + 0.5; a < a1; a += 0.7) BD(a, y + 0.16, fixed, 0.18, rh - 0.34, 0.18, stoneLt); }
    else { B(fixed, y, (a0 + a1) / 2, 0.2, 0.16, a1 - a0, stoneLt); B(fixed, y + rh - 0.18, (a0 + a1) / 2, 0.26, 0.2, a1 - a0, stoneLt);
      for (let a = a0 + 0.5; a < a1; a += 0.7) BD(fixed, y + 0.16, a, 0.18, rh - 0.34, 0.18, stoneLt); }
  }
  function chandelier(lx, y, lz, r) {   // low-poly crystal chandelier (decorative) + a night glow
    BD(lx, y, lz, 0.12, 1.2, 0.12, woodDk); BD(lx, y - 0.1, lz, r * 2, 0.18, r * 2, gold);
    for (let a = 0; a < 6; a++) { const ax = Math.cos(a) * r, az = Math.sin(a) * r; const m = new THREE.Mesh(new THREE.OctahedronGeometry(0.18), new THREE.MeshBasicMaterial({ color: 0xfff0c0 })); m.position.set(cx + lx + ax, y - 0.2, cz + lz + az); scene.add(m); }
    glow(lx, y - 0.2, lz, r * 2.4, 1.0, r * 2.4, 0xffe6a8, 0.75);
  }
  function fireplace(lx, lz, axis, faceDir) {   // stone mantel + dark firebox + a low always-on ember glow
    const w = 2.6;
    if (axis === 'x') { B(lx, GF, lz, w, 3.0, 0.6, stoneLt); BD(lx, GF, lz - faceDir * 0.05, w - 1.0, 2.0, 0.5, 0x171310); BD(lx, GF + 2.3, lz, w + 0.6, 0.35, 0.85, stoneDk); }
    else { B(lx, GF, lz, 0.6, 3.0, w, stoneLt); BD(lx - faceDir * 0.05, GF, lz, 0.5, 2.0, w - 1.0, 0x171310); BD(lx, GF + 2.3, lz, 0.85, 0.35, w + 0.6, stoneDk); }
    const ember = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.5, 0.4), new THREE.MeshBasicMaterial({ color: 0xff6a1e, transparent: true, opacity: 0.5 })); ember.position.set(cx + lx, GF + 0.45, cz + lz); scene.add(ember);
    glow(lx, GF + 0.7, lz, 2.0, 1.6, 1.2, 0xff7a2a, 0.7);
  }

  // ============ FOUNDATION + GROUND-FLOOR FLOORS (decorative; you stand on world y=0) ============
  B(0, -0.5, 0, 40, 0.5, 40, stoneDk, { noCollide: true });                 // plinth lip
  slab(8.5, 0, 21, 38, 0.04, marble, true);                                  // central-block marble (deco)
  slab(-10.5, 15, 17, 8, 0.04, parquet, true);                               // ballroom parquet (north wing)
  slab(-10.5, -15, 17, 8, 0.04, woodDk, true);                               // library wood (south wing)

  // ============ GROUND FLOOR — exterior shell (y 0→6) ============
  // Back wall + side walls (outer perimeter of the central block)
  wallZ(19, -19, 19, GF, F2, stone, [...wins(-18, 18, 1.4, 4.6, 6, 1.7), { a0: -16, a1: -13.5, y0: 0, y1: 2.6 }]);   // back (+X) + the secret-passage door slot
  wallX(19, 0, 19, GF, F2, stone, wins(1, 18, 1.4, 4.6, 4, 1.7));            // central-block north outer (back half)
  wallX(-19, 0, 19, GF, F2, stone, wins(1, 18, 1.4, 4.6, 4, 1.7));          // central-block south outer
  // WINGS — outer fronts face the map centre (-X): tall arched windows, ground ones vault-through
  wallZ(-19, 11, 19, GF, F2, stoneWarm, wins(11.5, 18.5, 0.4, 4.8, 3, 1.9, true));   // ballroom front (jump-through)
  wallZ(-19, -19, -11, GF, F2, stoneWarm, wins(-18.5, -11.5, 0.4, 4.8, 3, 1.9, true)); // library front (jump-through)
  // WINGS — outer long sides (north/south extremes of the wings)
  wallX(19, -19, 0, GF, F2, stoneWarm, wins(-18, -3, 1.2, 4.6, 4, 1.7));     // ballroom outer long wall
  wallX(-19, -19, 0, GF, F2, stoneWarm, wins(-18, -3, 1.2, 4.6, 4, 1.7));    // library outer long wall
  // WINGS — inner walls face the courtyard: ground windows vault-through into the rooms
  wallX(11, -19, -2, GF, F2, stoneWarm, wins(-18, -3, 0.4, 4.6, 3, 1.9, true));    // ballroom courtyard wall
  wallX(-11, -19, -2, GF, F2, stoneWarm, wins(-18, -3, 0.4, 4.6, 3, 1.9, true));   // library courtyard wall
  // CENTRAL-BLOCK FRONT FACADE (faces courtyard): GRAND ENTRANCE arch (centre) + flanking windows + wing-back infill
  wallZ(-2, -19, -11, GF, F2, stone, wins(-18, -12, 1.4, 4.6, 2, 1.7));      // S wing back wall
  wallZ(-2, 11, 19, GF, F2, stone, wins(12, 18, 1.4, 4.6, 2, 1.7));         // N wing back wall
  wallZ(-2, -11, 11, GF, F2, stone, [                                        // entrance facade
    { a0: -3.2, a1: 3.2, y0: 0, y1: 5.2 },                                   // grand doorway (open arch)
    { a0: -9, a1: -6, y0: 1.4, y1: 4.6 }, { a0: 6, a1: 9, y0: 1.4, y1: 4.6 }
  ]);
  BD(-2, 5.2, 0, T + 0.2, 0.7, 7.0, stoneDk);                                // arch lintel over the doorway

  // ============ GROUND FLOOR — interior partitions + rooms ============
  // Central block split: front rooms (x[-2,11]) vs back service (x[11,19]); foyer / dining / kitchen
  wallX(7, -2, 11, GF, F2, stoneLt, [{ a0: 2, a1: 4, y0: 0, y1: 3 }]);       // foyer | dining (doorway)
  wallX(-7, -2, 11, GF, F2, stoneLt, [{ a0: 2, a1: 4, y0: 0, y1: 3 }]);      // foyer | kitchen (doorway)
  wallZ(11, -19, 19, GF, F2, stoneLt, [                                      // front rooms | back service
    { a0: -4, a1: -1.5, y0: 0, y1: 3 }, { a0: 1.5, a1: 4, y0: 0, y1: 3 }, { a0: 10, a1: 12.5, y0: 0, y1: 3 }, { a0: -12.5, a1: -10, y0: 0, y1: 3 }
  ]);
  // BALLROOM / LIBRARY open to the central block via wide arches in the wing-back walls (already holed above)

  // --- FOYER: double-height (open to F2), grand staircase, fireplace, chandelier, portraits ---
  addRamp(cx + 8.5, GF, cz, 9, 5, 0, F2, 'x', marbleDk);                     // sweeping stair up to the F2 back landing (climbs +X, lands x≈94)
  balus('z', cx + 4.0, cz - 2.6, cz + 2.6, GF + 0.1);                        // stair side balustrade (approx; not a true split curve)
  fireplace(-1, 5.6, 'x', -1); BD(-1, GF + 3.6, 6.0, 2.0, 1.4, 0.1, carpet);  // foyer fireplace + a portrait over it
  BD(-1, GF + 3.6, -6.0, 1.4, 2.0, 0.1, 0x243042); BD(-1.0, GF + 3.6, -6.05, 1.6, 2.2, 0.05, gold);   // framed portrait (S wall)
  chandelier(4, F2 + 2.4, 0, 1.1);                                           // grand chandelier high in the void

  // --- BALLROOM (north wing): biggest room, double-height feel, 2 chandeliers, grand fireplace ---
  chandelier(-9, 4.4, 15, 1.0); chandelier(-15, 4.4, 15, 1.0);
  fireplace(-10.5, 18.4, 'x', 1);                                            // fireplace on the outer wall
  B(-7, GF, 13, 2.4, 0.9, 1.0, woodLt);                                      // a long couch (SOLID low cover)
  B(-13, GF, 17, 1.4, 0.8, 2.4, woodLt);                                     // chaise (SOLID)

  // --- LIBRARY (south wing): tall bookshelves (solid), reading table, globe, fireplace, darker ---
  for (let i = 0; i < 5; i++) { const lz = -19 + 1.0 + i * 1.55; B(-18.2, GF, lz, 1.0, 4.6, 1.2, woodDk); shelfBooks(-17.7, lz); }   // shelves on outer wall
  for (let i = 0; i < 4; i++) { const lz = -18.5 + i * 1.6; B(-3.0, GF, lz, 0.9, 4.2, 1.2, woodDk); shelfBooks(-3.4, lz); }          // shelves on the courtyard-side
  function shelfBooks(lx, lz) { for (let y = 0.7; y < 4.0; y += 0.85) for (let k = -0.4; k < 0.45; k += 0.18) BD(lx, GF + y, lz + k, 0.12, 0.7, 0.15, [0x6a2a2a, 0x2a4a2a, 0x2a3a5a, 0x6a5a2a][Math.floor(Math.random() * 4)]); }
  B(-10.5, GF, -15, 3.6, 0.9, 1.2, woodLt);                                  // long reading table (SOLID)
  fireplace(-10.5, -18.4, 'x', -1);
  BD(-7, GF + 0.9, -13, 0.5, 1.0, 0.5, 0x3a5a3a); cyl(cx - 7, GF + 1.7, cz - 13, 0.5, 0.5, gold);  // globe on a stand

  // --- DINING (central-block north): long table + chairs + chandelier + mirror ---
  B(4, GF, 13, 2.0, 1.0, 6.0, woodDk);                                       // long dining table (SOLID — stand on / take cover behind)
  for (let z = 10.5; z <= 15.5; z += 1.6) { B(2.4, GF, z, 0.5, 1.4, 0.5, wood, { noCollide: true }); B(5.6, GF, z, 0.5, 1.4, 0.5, wood, { noCollide: true }); }  // chairs
  chandelier(4, F2 - 0.6, 13, 0.8);
  // --- KITCHEN (central-block south): island + counters + brick oven + stair down to the cellar ---
  B(4, GF, -13, 3.2, 1.1, 2.0, marbleDk);                                    // island (SOLID)
  B(0.5, GF, -18, 5.0, 1.2, 1.4, stoneCool);                                 // counter along the back
  B(9.0, GF, -13, 1.8, 2.6, 1.8, 0x6a3326);                                  // brick oven block (solid)
  for (let i = 0; i < 4; i++) BD(2 + i * 1.4, GF + 2.6, -18.6, 0.5, 0.6, 0.2, 0xb5742a);  // hanging copper pots

  // ============ REAR WINE-CELLAR UNDERCROFT (back service zone, dim, stone) + SECRET PASSAGE ============
  // A dark stone room behind the kitchen (central-block back, x[11,19], z[-19,-2]); reached from the
  // kitchen and via a hidden door in the back garden. (At grade — engine floors can't go sub-grade.)
  wallX(-2, 11, 19, GF, F2, stoneDk, [{ a0: 13, a1: 15.5, y0: 0, y1: 2.6 }]);   // cellar | back-hall divider (dark stone) w/ doorway (reached from the kitchen via the x=92 partition door)
  BD(15, GF + 0.02, -10.5, 8, 0.04, 17, 0x4a4640);                            // cellar stone floor (dark)
  for (let i = 0; i < 4; i++) { const lz = -18 + i * 3.6; B(18.2, GF, lz, 1.0, 3.4, 2.8, woodDk); for (let y = 0.6; y < 3.0; y += 0.7) for (let k = -1.0; k < 1.05; k += 0.5) BD(17.6, GF + y, lz + k, 0.2, 0.5, 0.2, 0x2a1414); }  // wine racks + bottles
  B(12.5, GF, -15, 1.3, 1.3, 1.3, woodLt); B(14, GF, -16.5, 1.0, 1.0, 1.0, wood);   // crates for cover (SOLID)
  glow(16, GF + 2.4, -10.5, 1.0, 0.8, 1.0, 0xffb060, 0.5);                    // single dim cellar lantern
  // SECRET PASSAGE: a HOLLOW tunnel from the cellar (through the back-wall door slot) out to a hidden
  // garden door. Two solid side walls + a ceiling cap; the interior + far end stay open so you can run it.
  B(22.5, GF, -16.1, 7, 2.8, 0.4, stoneDk);                                  // tunnel side wall (-Z)
  B(22.5, GF, -13.4, 7, 2.8, 0.4, stoneDk);                                  // tunnel side wall (+Z)
  B(22.5, GF + 2.6, -14.75, 7, 0.4, 2.7, stoneDk);                           // tunnel ceiling cap (SOLID — can't impulse-jump out the top)
  BD(22.5, GF + 0.02, -14.75, 7, 0.04, 2.2, 0x4a4640);                       // tunnel floor (dark)
  glow(22, GF + 2.0, -14.75, 0.8, 0.7, 0.8, 0xffb060, 0.45);                 // dim passage lantern
  BD(26.1, GF + 1.3, -14.75, 0.12, 2.4, 2.3, 0x223018);                      // camouflaged ivy "door" at the garden end (passable)

  // ============ SECOND FLOOR (y 6→11): landing + hallway + bedrooms + study ============
  // F2 slabs over the central block + dining + kitchen (NOT over the double-height foyer void x[-2,7],z[-7,7])
  slab(4, 13, 21, 12, F2, marbleDk);          // over dining (north)
  slab(4, -13, 21, 12, F2, marbleDk);         // over kitchen + cellar (south)
  slab(15, 0, 8, 14, F2, marbleDk);           // back service strip (behind the foyer void)
  slab(15, 10, 8, 6, F2, marbleDk);           // NE back-corner fill (dining slab stops at x≈14.5; closes the gap to the back wall + tower)
  slab(15, -10, 8, 6, F2, marbleDk);          // SE back-corner fill (mirror, over the cellar back corner)
  slab(-2.5, 0, 1.5, 14, F2, marbleDk);       // thin front landing strip across the void front
  balus('z', cx - 1.7, cz - 7, cz + 7, F2);   // balustrade around the void front edge (look down into foyer)
  balus('x', cz + 7, -2, 11, F2); balus('x', cz - 7, -2, 11, F2);            // void side balustrades
  // Upper exterior walls (y 6→11) — central block perimeter with windows + the balcony over the entrance
  wallZ(19, -19, 19, F2, F3, stone, wins(-18, 18, 7.4, 10.2, 6, 1.5));
  wallX(19, -2, 19, F2, F3, stone, wins(-1, 18, 7.4, 10.2, 4, 1.5)); wallX(-19, -2, 19, F2, F3, stone, wins(-1, 18, 7.4, 10.2, 4, 1.5));
  wallZ(-2, -19, 19, F2, F3, stone, [{ a0: -4, a1: 4, y0: 6.2, y1: 10.0 }, ...wins(-18, -6, 7.4, 10.2, 3), ...wins(6, 18, 7.4, 10.2, 3)]);  // big French window onto the balcony
  // BALCONY over the grand entrance (stand-out terrace at F2 with balustrade + French doors above)
  B(-3.4, F2 - 0.4, 0, 2.8, 0.4, 8, stoneLt); balus('z', cx - 4.7, cz - 4, cz + 4, F2); balus('x', cz + 4, -4.7, -2, F2); balus('x', cz - 4, -4.7, -2, F2);
  // Upper hallway down the central block (connects toward both wings) + runner rug + sconces + doors
  BD(8, F2 + 0.03, 0, 14, 0.05, 2.2, carpet);                                 // runner rug
  wallX(3.2, -2, 19, F2, F3, stoneLt, [{ a0: 2, a1: 4, y0: 6, y1: 9 }, { a0: 13, a1: 15, y0: 6, y1: 9 }]);   // hall | north bedrooms
  wallX(-3.2, -2, 19, F2, F3, stoneLt, [{ a0: 2, a1: 4, y0: 6, y1: 9 }, { a0: 13, a1: 15, y0: 6, y1: 9 }]);  // hall | south bedrooms
  for (let i = 0; i < 4; i++) { glow(2 + i * 4.2, F2 + 2.4, 3.0, 0.5, 0.7, 0.3, 0xffd98a, 0.6); glow(2 + i * 4.2, F2 + 2.4, -3.0, 0.5, 0.7, 0.3, 0xffd98a, 0.6); }  // wall sconces
  // BEDROOMS (4) — four-poster bed + wardrobe + fireplace; alternating fabric colours
  function bedroom(lx, lz, col) {
    B(lx, F2, lz, 2.6, 0.7, 3.0, woodDk);                                    // bed base (SOLID — crouch behind)
    BD(lx, F2 + 0.7, lz, 2.4, 0.35, 2.8, col);                               // mattress/cover
    [[-1.1, -1.3], [1.1, -1.3], [-1.1, 1.3], [1.1, 1.3]].forEach(([ox, oz]) => BD(lx + ox, F2, lz + oz, 0.16, 2.6, 0.16, woodDk));  // bed posts
    B(lx + 2.0, F2, lz - 1.0, 0.8, 2.4, 1.6, wood);                           // wardrobe (SOLID)
  }
  bedroom(5, 16, carpet); bedroom(14, 16, 0x2a4a3a); bedroom(5, -16, 0x2a3a5a); bedroom(14, -16, 0x4a3a5a);
  // PRIVATE STUDY (off the hallway): desk, chair, shelves, globe
  B(17, F2, 0, 2.2, 1.0, 1.2, woodDk); B(15.6, F2, 0, 0.5, 1.4, 0.5, wood, { noCollide: true });   // study desk SOLID (chair stays passable)
  B(18.2, F2, 3, 1.0, 3.0, 2.0, woodDk);

  // ============ THIRD FLOOR / ATTIC (y 11→15.5): central core, lower narrow rooms ============
  slab(8, 0, 16, 26, F3, woodLt);                                            // F3 floor over the central core
  wallZ(11, -13, 13, F3, RF, stoneLt, [{ a0: -2, a1: 2, y0: 11, y1: 13.6 }]);   // attic hallway divider
  wallZ(4, -13, 13, F3, RF, stoneLt, [{ a0: -2, a1: 2, y0: 11, y1: 13.6 }]);
  wallX(13, 0, 16, F3, RF, stone, wins(1, 15, 11.6, 13.8, 3, 1.3)); wallX(-13, 0, 16, F3, RF, stone, wins(1, 15, 11.6, 13.8, 3, 1.3));
  wallZ(16, -13, 13, F3, RF, stone, wins(-12, 12, 11.6, 13.8, 4, 1.3));
  for (let i = 0; i < 3; i++) BD(3 + i * 5, F3 + 0.03, 0, 0.05, 0.05, 22, carpet);  // attic plank seams (deco)
  glow(8, F3 + 2.2, 6, 0.5, 0.6, 0.3, 0xffd98a, 0.5); glow(8, F3 + 2.2, -6, 0.5, 0.6, 0.3, 0xffd98a, 0.5);

  // ============ ROOFS — pitched slate over the central block + wings, dormers, chimneys, parapets ============
  hipRoof(8, 0, 18, 28, RF, 4.2);                                            // central block hip roof
  hipRoof(-10.5, 15, 18, 9, F2 + 0.2, 2.6);                                  // ballroom (north wing) roof
  hipRoof(-10.5, -15, 18, 9, F2 + 0.2, 2.6);                                 // library (south wing) roof
  function hipRoof(lx, lz, w, d, base, rise) {
    // A single flat SOLID roof deck (a player who climbs/lands up here stands cleanly on the roof, and it
    // caps the room/attic below so looking up no longer shows sky) + a DECORATIVE stepped pyramid on top
    // for the low-poly hip silhouette. Only the deck collides: stacking the steps as solids would let a
    // fast fall settle inside an upper step and then get shoved sideways by resolveHorizontal.
    B(lx, base - 0.1, lz, w, 0.5, d, slateDk);                                                              // solid roof deck (walk-on top ≈ base+0.4)
    for (let i = 0; i < 5; i++) { const f = i / 5, ny = base + 0.4 + f * rise; BD(lx, ny, lz, w * (1 - f * 0.8), 0.5, d * (1 - f * 0.8), i % 2 ? slate : slateDk); }
  }
  // Roof parapet balustrades around the central block + dormers + chimneys
  balus('x', 14, -2, 19, RF + 0.2); balus('x', -14, -2, 19, RF + 0.2);
  balus('z', 18, -14, 14, RF + 0.2);
  for (let i = 0; i < 3; i++) { dormer(2 + i * 6, 14, 1); dormer(2 + i * 6, -14, -1); }   // dormer windows on the central roof
  function dormer(lx, lz, dir) { BD(lx, RF + 0.6, lz, 1.4, 1.6, 1.0, stoneLt); pane(lx, RF + 1.2, lz + dir * 0.55, 1.0, 0.9, true); const r = new THREE.Mesh(new THREE.ConeGeometry(1.1, 1.0, 4), flatMat(slateDk)); r.rotation.y = Math.PI / 4; r.position.set(cx + lx, RF + 2.2, cz + lz); scene.add(r); }
  [[2, 8], [2, -8], [14, 10], [14, -10], [8, 16], [8, -16]].forEach(([lx, lz]) => chimney(lx, lz));   // tall ornate chimneys
  function chimney(lx, lz) { BD(lx, RF, lz, 1.3, 5.5, 1.3, 0x7a4a30); BD(lx, RF + 5.4, lz, 1.7, 0.5, 1.7, stoneDk); for (let k = -0.4; k <= 0.4; k += 0.4) BD(lx + k, RF + 5.8, lz, 0.3, 0.6, 0.3, 0x4a2e1c); }

  // ============ FOUR CORNER SNIPER TOWERS ============
  // Hollow tower: 4 levels, arrow slits, a ladder up the inner corner, open crenellated observation deck.
  function tower(lx, lz, indx, indz) {     // (indx,indz) = inward direction (door + ladder face the building)
    const hs = 3.2, body = 0xc2bba6;
    const arrow = [{ y0: 2.2, y1: 4.0 }, { y0: 7.2, y1: 9.0 }, { y0: 12.0, y1: 13.6 }];   // arrow slits at each level
    const slitHoles = () => arrow.map(a => ({ a0: -0.4, a1: 0.4, y0: a.y0, y1: a.y1 }));
    // walls (GF→RF) with arrow slits + a ground doorway on the inward (building-facing) face
    [lx - hs, lx + hs].forEach(fx => {
      const inward = (fx < lx) === (indx < 0);
      const holes = slitHoles().map(h => ({ a0: lz + h.a0, a1: lz + h.a1, y0: h.y0, y1: h.y1 }));
      if (indx !== 0 && inward) holes.push({ a0: lz - 1.3, a1: lz + 1.3, y0: 0, y1: 2.8 });   // doorway
      wallZ(fx, lz - hs, lz + hs, GF, RF, body, holes);
    });
    [lz - hs, lz + hs].forEach(fz => {
      const inward = (fz < lz) === (indz < 0);
      const holes = slitHoles().map(h => ({ a0: lx + h.a0, a1: lx + h.a1, y0: h.y0, y1: h.y1 }));
      if (indz !== 0 && inward) holes.push({ a0: lx - 1.3, a1: lx + 1.3, y0: 0, y1: 2.8 });
      wallX(fz, lx - hs, lx + hs, GF, RF, body, holes);
    });
    // internal drop-down floors (F2, F3) + open observation deck (RF), all reached by a full-height ladder
    // (a true helical staircase isn't expressible in the AABB collision model — the ladder is the climb).
    const lxd = lx + indx * (hs - 1.0), lzd = lz + indz * (hs - 1.0);        // ladder up the inner corner
    [F2, F3].forEach(fy => slab(lx, lz, hs * 2 - T, hs * 2 - T, fy, woodLt));
    slab(lx, lz, hs * 2 - T, hs * 2 - T, RF, slateDk);                       // observation deck floor
    for (let y = 0.5; y < RF; y += 0.6) { const m = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.1, 0.1), flatMat(0x6a6a6a)); m.position.set(cx + lxd, y, cz + lzd); scene.add(m); }  // ladder rungs
    ladders.push({ x: cx + lxd, z: cz + lzd, bottom: 0, top: RF, cx: cx + lx, cz: cz + lz, outX: indx, outZ: indz });
    // SOLID crenellated parapet (cover) around the open deck
    for (let a = -hs; a < hs; a += 1.3) { B(lx + a + 0.65, RF, lz - hs, 0.95, 1.3, 0.32, body); B(lx + a + 0.65, RF, lz + hs, 0.95, 1.3, 0.32, body); B(lx - hs, RF, lz + a + 0.65, 0.32, 1.3, 0.95, body); B(lx + hs, RF, lz + a + 0.65, 0.32, 1.3, 0.95, body); }
    // conical roof on 4 corner posts (the deck stays open between the posts for sniping)
    [[-hs, -hs], [hs, -hs], [-hs, hs], [hs, hs]].forEach(([ox, oz]) => BD(lx + ox, RF + 1.3, lz + oz, 0.3, 3.2, 0.3, woodDk));
    const cone = new THREE.Mesh(new THREE.ConeGeometry(hs * 1.55, 4.6, 8), flatMat(slateDk)); cone.position.set(cx + lx, RF + 5.2, cz + lz); scene.add(cone);
    BD(lx + indx * hs * 0.9, RF - 1.0, lz + indz * hs * 0.9, 0.6, 0.6, 0.9, stoneDk);   // corner eagle/gargoyle nub
  }
  tower(16, 16, -1, 0); tower(16, -16, -1, 0);     // back corner towers (doors face -X into the block)
  tower(-16, 15, 1, 0); tower(-16, -15, 1, 0);     // front wing-tip towers (doors face +X into the wings)

  // ============ EXTERIOR DETAIL — entrance portico, quoins, cornices ============
  // Grand entrance: wide ceremonial perron stairs up to a low portico, two columns, triangular pediment + crest
  for (let i = 0; i < 5; i++) B(-5.0 + i * 0.5, 0, 0, 0.5, 0.45 + i * 0.18, 9 - i * 0.6, stoneLt);   // wide front steps (climb to ~1.0)
  B(-3.6, 1.0, 0, 1.4, 0.3, 8.4, stoneLt);                                   // portico landing
  [-3.0, 3.0].forEach(oz => { B(-4.4, 1.0, oz, 0.9, 5.0, 0.9, stoneLt); BD(-4.4, 1.0, oz, 1.1, 0.4, 1.1, stoneDk); BD(-4.4, 5.8, oz, 1.2, 0.5, 1.2, stoneDk); });  // 2 columns + base/capital
  BD(-4.4, 6.4, 0, 2.6, 0.5, 8.0, stoneLt);                                  // portico entablature
  for (let i = 0; i < 4; i++) BD(-4.4, 6.9 + i * 0.4, 0, 2.4, 0.4, 7.0 - i * 1.7, stoneWarm);   // triangular pediment (stepped)
  BD(-4.5, 7.4, 0, 0.2, 1.4, 1.6, gold);                                     // simple low-poly coat-of-arms crest
  BD(-2.1, 2.6, 0, 0.18, 4.6, 6.0, woodDk);                                  // ornate double doors (visual, in the open arch)
  for (let oz = -2.4; oz <= 2.4; oz += 1.2) BD(-2.0, 2.6, oz, 0.06, 4.2, 0.5, woodLt);   // door panels/carving hints
  // QUOINS at every outer corner + a cornice band between floors
  [[-19, 19], [19, 19], [-19, -19], [19, -19], [-19, 11], [-19, -11], [-2, 11], [-2, -11]].forEach(([lx, lz]) => quoin(lx, lz));
  cornice(19, -19, 19, F2 + 0.1); cornice(-19, -19, 19, F2 + 0.1); corniceZ(19, -19, 19, F2 + 0.1);
  cornice(19, -19, 19, F3 + 0.1); cornice(-19, -19, 19, F3 + 0.1); corniceZ(19, -19, 19, F3 + 0.1);
  // weathering streaks on the big facades
  [[-2, 3, -7], [-2, 3, 7], [19, 4, 0], [-19, 3, 15]].forEach(([lx, y, lz]) => { const p = new THREE.Mesh(new THREE.BoxGeometry(0.05, 3, 3), new THREE.MeshLambertMaterial({ color: 0x000000, transparent: true, opacity: 0.12 })); p.position.set(cx + lx, y, cz + lz); scene.add(p); });

  // ============ GROUNDS — forecourt garden, fountain, urns, benches, driveway, boundary wall, gates, rear terrace ============
  // Boundary wall (waist-high crouch cover) around the front of the estate + wrought-iron gate pillars
  wallZ(-22, -14, 14, 0, 1.4, stoneWarm, [{ a0: -2.5, a1: 2.5, y0: 0, y1: 1.4 }]);   // front boundary wall w/ gate gap
  [-2.5, 2.5].forEach(gz => B(-22, 0, gz, 1.2, 3.4, 1.2, stoneDk));                   // gate pillars
  [-2.5, 2.5].forEach(gz => BD(-22, 3.4, gz, 1.4, 0.5, 1.4, gold));                   // pillar finials
  // Gravel driveway from the gate to the entrance steps (cosmetic strip)
  BD(-13, 0.015, 0, 18, 0.03, 5.5, 0xb6a98a);
  // FOUNTAIN — round tiered basin + central obelisk + a faint water plume
  cyl(cx - 10, 0.45, cz, 3.0, 0.9, stoneLt); cyl(cx - 10, 1.0, cz, 2.4, 0.3, stoneCool);
  B(-10, 0, 0, 1.0, 2.6, 1.0, stoneLt); const ob = new THREE.Mesh(new THREE.ConeGeometry(0.4, 1.4, 4), flatMat(stoneLt)); ob.position.set(cx - 10, 3.4, cz); scene.add(ob);
  const plume = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.3, 1.6, 8), new THREE.MeshBasicMaterial({ color: 0xbfe0ee, transparent: true, opacity: 0.4 })); plume.position.set(cx - 10, 2.6, cz); scene.add(plume);
  B(-10, 0, 0, 6.4, 0.5, 6.4, stoneDk, { noCollide: true });                          // fountain plinth ring (visual base)
  // Low formal hedges (square parterre pattern) + 2 topiary urns flanking the steps + benches
  for (let hz = -8; hz <= 8; hz += 4) { B(-15, 0, hz, 4.5, 0.9, 0.6, 0x3f6e3a, { noCollide: true }); B(-7, 0, hz, 4.5, 0.9, 0.6, 0x3f6e3a, { noCollide: true }); }
  [-4.5, 4.5].forEach(uz => { B(-6.5, 0, uz, 0.9, 1.4, 0.9, stoneLt); const t = new THREE.Mesh(new THREE.SphereGeometry(0.8, 8, 6), flatMat(0x3f7e3a)); t.position.set(cx - 6.5, 2.3, cz + uz); scene.add(t); });   // urns + topiary
  [[-13, 7], [-13, -7]].forEach(([lx, lz]) => B(lx, 0, lz, 2.0, 0.6, 0.7, stoneLt, { noCollide: true }));   // garden benches
  // REAR TERRACE / PATIO at the back with steps down to a small back garden
  B(22.5, GF, 0, 4, 0.3, 16, stoneLt); balus('z', cx + 24.4, cz - 8, cz + 8, GF);     // terrace slab + balustrade
  for (let i = 0; i < 3; i++) B(24.5 + i * 0.6, 0, 6, 0.6, 0.4 - i * 0.0, 3, stoneLt, { noCollide: true });   // a few back steps (cosmetic descent to grade)
  for (let hz = -10; hz <= 10; hz += 5) B(28, 0, hz, 0.6, 0.9, 3.5, 0x3f6e3a, { noCollide: true });          // back-garden hedges

  return { cx, cz, W: 38, D: 38, H: RF, glows };
}
const castle = buildMansion(81, 0);   // sprawling mansion estate on the right flank (~38×38, centre x=81)

// --- Perimeter: yellow chevron HAZARD FENCING ---
const FENCE = ARENA - 1, FH = 5.5;
function fenceSide(axis, fixed, from, to) {
  if (axis === 'x') addBox((from + to) / 2, 0, fixed, Math.abs(to - from) + 0.5, FH, 0.5, 0xF2C61F, { mat: 'metal' });
  else addBox(fixed, 0, (from + to) / 2, 0.5, FH, Math.abs(to - from) + 0.5, 0xF2C61F, { mat: 'metal' });
  const n = Math.max(2, Math.floor(Math.abs(to - from) / 3));
  for (let i = 0; i < n; i++) {
    const p = from + (i + 0.5) * (to - from) / n;
    const m = new THREE.Mesh(new THREE.BoxGeometry(0.7, FH * 1.25, 0.14), flatMat(0x1a1a1a));
    m.rotation.z = (i % 2 ? 1 : -1) * 0.6;
    if (axis === 'x') m.position.set(p, FH / 2, fixed - Math.sign(fixed || 1) * 0.32);
    else { m.position.set(fixed - Math.sign(fixed || 1) * 0.32, FH / 2, p); m.rotation.y = Math.PI / 2; }
    scene.add(m);
  }
}
fenceSide('x', FENCE, -FENCE, FENCE); fenceSide('x', -FENCE, -FENCE, FENCE);
fenceSide('z', FENCE, -FENCE, FENCE); fenceSide('z', -FENCE, -FENCE, FENCE);

// --- Desert backdrop beyond the fence (cosmetic) ---
const desert = new THREE.Mesh(new THREE.PlaneGeometry(700, 700), flatMat(0xcdb487));
desert.rotation.x = -Math.PI / 2; desert.position.y = -0.12; scene.add(desert);
[[-130, -90], [150, -70], [95, 160], [-170, 130], [180, 90]].forEach(([hx, hz]) => {
  const m = new THREE.Mesh(new THREE.BoxGeometry(70, 20, 70), flatMat(0xbfa477)); m.position.set(hx, 0, hz); m.rotation.y = Math.random() * 3; scene.add(m);
});
(() => {   // distant nuclear-test rocket silhouette
  const g = new THREE.Group(); g.position.set(125, 0, -135);
  const body = new THREE.Mesh(new THREE.CylinderGeometry(3, 3.4, 30, 12), flatMat(0xcfcfcf)); body.position.y = 15; g.add(body);
  const nose = new THREE.Mesh(new THREE.ConeGeometry(3, 8, 12), flatMat(0xb0453a)); nose.position.y = 34; g.add(nose);
  scene.add(g);
})();
[[-40, 58, -28], [32, 64, 38], [4, 70, 6], [-22, 60, 30]].forEach(([cx, cy, cz]) => {   // clouds
  const m = new THREE.Mesh(new THREE.BoxGeometry(24, 2, 13), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.85 })); m.position.set(cx, cy, cz); scene.add(m);
});

/* ============================================================================
   MAP DETAILS — extra cover + Cold-War suburban dressing (flat-shaded, collision via
   addBox/solids). Animated bits (oil-drum flames, the flag) live in updateMapFx().
   ============================================================================ */
const mapFlames = [];   // burning oil drums: { flame, inner, pos, t, smokeT }
const streetLamps = [];  // street-lamp bulb meshes (day/night cycle tints/glows these)
let mapFlag = null;     // American flag: { segs, pos, t }
const mapPuddles = [];  // street puddles (cosmetic)
// New positional ambience: oil-drum fire crackle + flag flap.
function sfxFireCrackle(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.3, peak: 0.12, filter: 'bandpass', freq: 500, freq1: 1400, q: 0.5 }); for (let i = 0; i < 3; i++) aNoise(ctx, out, t + Math.random() * 0.25, { dur: 0.03, peak: 0.1, filter: 'highpass', freq: 3000 }); }, pos, 'ambient', 'fire', 0.5, 0.3); }
function sfxFlagFlap(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.25, peak: 0.1, filter: 'bandpass', freq: 300, freq1: 900, q: 0.4 }), pos, 'ambient', 'flag', 0.4, 0.26); }

function buildMapDetails() {
  // 1. SANDBAG BUNKERS — chest-high khaki stacks for crouch cover (mid-flank areas).
  function sandbagBunker(x, z) {
    const tan = 0xb6a87a, tanDk = 0x9a8c5e, sb = (sx, sy, sz) => addBox(sx, sy, sz, 1.0, 0.5, 0.6, Math.random() < 0.5 ? tan : tanDk);
    sb(x - 1.0, 0, z); sb(x, 0, z); sb(x + 1.0, 0, z);
    sb(x - 0.5, 0.5, z + 0.05); sb(x + 0.5, 0.5, z - 0.05); sb(x, 1.0, z);
    sb(x - 1.45, 0, z + 0.7); sb(x + 1.45, 0, z - 0.7);
  }
  [[-28, 22], [28, -22], [-30, -28], [32, 28]].forEach(([x, z]) => sandbagBunker(SP(x), SP(z)));

  // 2. SHIPPING CONTAINER — rusted orange, open both ends (run through), climbable roof via crates.
  (function shippingContainer(x, z) {
    const rust = 0xb5552a, rustDk = 0x8a3f1e, frame = 0x6a3416, L = 7, W = 2.6, H = 2.6;
    addBox(x - W / 2, 0, z, 0.25, H, L, rust); addBox(x + W / 2, 0, z, 0.25, H, L, rust);   // long side walls
    addBox(x, H, z, W + 0.1, 0.25, L + 0.1, rustDk);                                          // roof (stand on top)
    for (let rz = z - L / 2 + 0.4; rz < z + L / 2; rz += 0.6) addBox(x, H + 0.13, rz, W, 0.05, 0.12, frame, { noCollide: true });
    [z - L / 2, z + L / 2].forEach(ez => addBox(x, 0, ez, W + 0.12, H + 0.1, 0.1, frame, { noCollide: true }));   // open door frames
