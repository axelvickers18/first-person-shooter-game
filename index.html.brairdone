  camera.position.set(sc.pos.x, sc.pos.y + player.eye + 0.35, sc.pos.z);
  camera.rotation.order = 'YXZ'; camera.rotation.y = yaw + recoilYaw + sx; camera.rotation.x = pitch + recoilPitch + sy;
