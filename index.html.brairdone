    for (let y = 0.5; y < platY; y += 0.55) { const m = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.09, 0.09), flatMat(metal)); m.position.set(lx, y, lz); scene.add(m); }
    ladders.push({ x: lx, z: lz, bottom: 0, top: platY, cx: lx, cz: bz, outX: 0, outZ: 1 });   // climb to the billboard platform
  })(SP(22), SP(-78));

