    else if (!riding) updateMovement(dt);   // while riding a scooter, updateScooters drives the player + camera
    if (!killcam.active) updateScooters(dt);   // Part 7: scooter physics / rider input / seat camera / respawn / net sync
    // Bots: the host (or solo) runs the AI; clients just interpolate host snapshots.
    if (!NET.active || NET.isHost) updateBots(dt);
    else lerpClientBots(dt);
    if (NET.active && !killcam.active) lerpRemotePlayers(dt);   // smooth other humans toward their net positions (killcam replays its own world)
    netTick(dt);                             // send/relay positions
    updateGrenades(dt);   // frag grenade physics + fuse
    updateTomahawks(dt);  // thrown tomahawks / lethal throwing axes (flight + stick + pickup)
    updateSmokes(dt);     // lethal smoke grenades: canister settle + view-blocking smoke cloud
    updateInvTip(dt);     // fade the "PRESS I" inventory hint
    updateMatchTimer(dt); // Part 6: match time limit countdown (host authoritative) + HUD clock
    if (BR.active) brUpdate(dt);   // BATTLE ROYALE: loot, shrinking zone, players-remaining HUD, win check
    updateDmgNums(dt);    // Part 3: expire floating damage numbers
    recordCamFrame(dt);   // Part 5: record my camera for others' killcams
    if (NET.active) processKcSends(dt);   // Part 5/2: flush queued killcam buffers (2s after a kill, or early if I die)
    if (el('scoreboard').style.display === 'flex') refreshScoreboard();   // live scoreboard while TAB is held
    updateRockets(dt);    // rocket projectiles (special weapon)
    updateGGProjectiles(dt); updateSmoke(dt);   // gun-game projectiles (bolt/grenade/rocket/knife) + trails
    rcUpdate(dt); updateRcRemote(dt);   // SECRET RC missile flight + camera handoff + others' missiles
    updateImpulses(dt);   // impulse-grenade canisters (bounce + fast activation + kinetic launch)
    updateBoostPads(dt);  // boost pads: glow/particles + step-on launch
    updateDeflectedBullets(dt);   // saber-reflected bullets in flight
    updateDogs(dt);       // Kirks Avengers attack dogs (host AI / client render)
    updateKongs(dt);      // King Kong boss-ally (host AI / client render) + banana projectiles
    updateMckaylas(dt);   // Mckayla katana ally (host AI / client render)
    updateFlamethrower(dt);   // flamethrower spray/fuel + burn status ticks
