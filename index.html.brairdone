    const seg = (x, y, z, sx, sy, sz, mat, rx) => { const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat); m.position.set(x, y, z); if (rx) m.rotation.x = rx; g.add(m); return m; };
    if (mv === 'm9') {
