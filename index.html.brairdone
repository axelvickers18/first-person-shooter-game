    body(0,-0.02,0.36,0.072,0.11,0.34,wood);        // wooden fixed stock
    body(0,0.04,0.36,0.074,0.02,0.34,woodDk);       // stock grain accent
    body(0.052,0.015,0.10,0.006,0.045,0.12,0x201e1c); // subtle "AK-47" receiver stamp plate (cosmetic)
    muzzleZ = -0.70;
  }
  // Iron-sight weapons get a visible rear notch + front post so the ADS picture reads.
  if (GG_IRON[key]) addIronSights(g, GG_IRON[key]);
  // Red-dot weapons get a mounted optic housing on top of the receiver.
  if (GG_REDDOT[key]) addRedDotOptic(g, GG_REDDOT[key]);
  // (PART 2) attachment config: cfg arg (remote) or this weapon's local effective config.
  const _c = cfg || (isCustomizable(key) ? (liveCfg[key] || getCfg(key)) : null);
  const _lz = _c ? _c.laser : (LASER_WEAPONS[key] ? 'red' : 'off');   // non-customizable weapons keep their built-in laser
  if (_lz && _lz !== 'off') addLaserEmitter(g, key, muzzleZ, _lz);   // mounted laser emitter (config color)
  addWeaponAttachments(g, key, _c, muzzleZ);   // magazine size / flashlight body / scope tube
  return { g, muzzleZ };
}
// Visible attachment models (magazine size, flashlight body, scope tube) from a weapon config.
function addWeaponAttachments(g, key, c, muzzleZ) {
  if (!c) return; const mz = muzzleZ || -0.5;
  if (c.magazine === 'extended') { const m = new THREE.Mesh(new THREE.BoxGeometry(0.075, 0.28, 0.1), flatMat(0x202024)); m.position.set(0, -0.26, 0.06); g.add(m); }   // long mag sticking out
  else if (c.magazine === 'drum') { const d = new THREE.Mesh(new THREE.CylinderGeometry(0.17, 0.17, 0.08, 16), flatMat(0x202024)); d.rotation.x = Math.PI / 2; d.position.set(0, -0.22, 0.06); g.add(d); }   // big drum
  if (c.flashlight === 'on') {
    const fl = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.046, 0.13, 10), flatMat(0x2a2a2e)); fl.rotation.x = Math.PI / 2; fl.position.set(-0.07, -0.02, mz + 0.2); g.add(fl);
    const lens = new THREE.Mesh(new THREE.CircleGeometry(0.034, 10), new THREE.MeshBasicMaterial({ color: 0xfff6d8 })); lens.position.set(-0.07, -0.02, mz + 0.14); g.add(lens);
  }
  const sid = c.sight;
  if (sid === 'acog' || sid === 'sniper' || sid === 'thermal') {
    const tube = new THREE.Mesh(new THREE.CylinderGeometry(0.052, 0.052, 0.26, 12), flatMat(0x111114)); tube.rotation.x = Math.PI / 2; tube.position.set(0, 0.12, -0.04); g.add(tube);
    const lens = new THREE.Mesh(new THREE.CircleGeometry(0.046, 12), new THREE.MeshBasicMaterial({ color: sid === 'thermal' ? 0x3aa0ff : 0x6fd3ff })); lens.position.set(0, 0.12, 0.1); g.add(lens);
  } else if ((sid === 'red_dot' || sid === 'holo') && !GG_REDDOT[key]) {
    const o = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.05, 0.1), flatMat(0x141418)); o.position.set(0, 0.1, -0.02); g.add(o);   // optic block for swaps onto iron-default guns
  }
}
// First-person viewmodel: the shared weapon mesh + a muzzle anchor/flash, anchored lower-right.
function buildGunModel(key, cfg) {
  if (gunMesh) viewModel.remove(gunMesh);
  const built = buildWeaponMesh(key, undefined, cfg), g = built.g, muzzleZ = built.muzzleZ;   // cfg: killcam passes the killer's attachment config
  // Muzzle anchor (tracers/flash originate here) + a hidden muzzle-flash sprite
  gunMuzzle = new THREE.Object3D(); gunMuzzle.position.set(0, 0, muzzleZ); g.add(gunMuzzle);
  gunFlash = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.22, 0.12),
    new THREE.MeshBasicMaterial({ color: 0xffe27a, transparent: true, opacity: 0.95 }));
  gunFlash.position.set(0, 0, muzzleZ - 0.06); gunFlash.visible = false; g.add(gunFlash);

  g.position.set(0.32, -0.28, -0.6);  // lower-right of the view
  g.rotation.y = 0.04;
  viewModel.add(g);
  gunMesh = g;
  // One-time diagnostic for the Tactical Pistol model fix: confirm the body now exists, is
  // visible, and sits at the normal lower-right hipfire anchor (not off-screen / hidden).
  if (key === 'gg18' && !window._tacLogged) {
    window._tacLogged = true;
    const bodyMeshes = g.children.filter(c => c.isMesh).length;
    console.log('[tactical pistol] model exists:', bodyMeshes > 0, '| body meshes:', bodyMeshes,
      '| visible:', g.visible, '| local pos:', g.position.toArray().map(n => n.toFixed(2)).join(','));
  }
}
// Third-person held weapon for remote avatars: the shared mesh, rotated so its muzzle points the
// avatar's forward (+Z), wrapped in a holder we pose at the hand. Saber/RC/akimbo geometry included.
function buildThirdPersonWeapon(key, variant, cfg) {
  const holder = new THREE.Group();
  const built = buildWeaponMesh(key, variant, cfg);
  built.g.rotation.y = Math.PI;   // FP weapons point -Z; flip so the muzzle faces avatar-forward (+Z)
  holder.add(built.g);
  holder.userData.muzzleZ = built.muzzleZ;
  return holder;
}
// A compact Jack Daniels bottle for a remote avatar's left hand (shown with the saber scorestreak).
function buildTpBottle() {
  const g = new THREE.Group();
  const glass = new THREE.MeshLambertMaterial({ color: 0x241a12, flatShading: true });
  const black = new THREE.MeshLambertMaterial({ color: 0x0a0a0a, flatShading: true });
  const gold = new THREE.MeshBasicMaterial({ color: 0xC9A24A });
  g.add(Object.assign(new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.34, 0.11), glass), {}));
  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.05, 0.12, 8), glass); neck.position.y = 0.23; g.add(neck);
  const label = new THREE.Mesh(new THREE.BoxGeometry(0.145, 0.20, 0.006), black); label.position.z = 0.058; g.add(label);
  const badge = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.03, 0.004), gold); badge.position.set(0, 0, 0.062); g.add(badge);
  return g;
}
buildGunModel(currentWeaponKey);

// World position of the held gun's muzzle (for tracer/projectile origins).
function gunMuzzleWorld() {
  if (gunMuzzle) return gunMuzzle.getWorldPosition(new THREE.Vector3());
  return camera.getWorldPosition(new THREE.Vector3());
}

// --- Akimbo pistols: per-pistol ammo, muzzle, flash + kick ---
const AKIMBO_SPREAD = 0.12;   // ~3.5° random spread cone per shot (rapid akimbo fire)
function akimboRig() { return gunMesh && gunMesh.userData ? gunMesh.userData.akimbo : null; }
function akimboEnsure(ws, w) {                     // lazily split the mag into two pistols (12 + 12)
  if (ws.ammoL == null || ws.ammoR == null) { ws.ammoL = Math.ceil(w.mag / 2); ws.ammoR = Math.floor(w.mag / 2); }
  if (ws.cdL == null) ws.cdL = 0; if (ws.cdR == null) ws.cdR = 0;
  ws.ammo = ws.ammoL + ws.ammoR;
}
function akimboMuzzleWorld(side) {
  const rig = akimboRig(); const p = rig && (side === 'L' ? rig.L : rig.R);
  return p ? p.mz.getWorldPosition(new THREE.Vector3()) : gunMuzzleWorld();
}
function akimboKick(side) {                         // recoil + flash on whichever pistol fired
  const rig = akimboRig(); if (!rig) return;
  const p = side === 'L' ? rig.L : rig.R;
  p.p.rotation.x = 0.40; p.p.position.z = 0.06;     // kick up + back (recovered in the loop)
  p.fl.visible = true; p.flT = 0.045;
}

function switchWeapon(key) {
  if (key === currentWeaponKey || !WEAPONS[key]) return;
  if (WEAPONS[key].special && !ownedSpecials.has(key)) return;   // can't select an un-owned special
  rcEquipped = (key === 'rcrl');
  currentWeaponKey = key;
  weaponState[key].reloading = 0;
  currentSpread = 0;
  buildGunModel(key);
  updateHUD();
}

function reload() {
  if (inspectT > 0) { inspectT = 0; return; }   // (Part 5) reload cancels an inspect
  const ws = weaponState[currentWeaponKey];
  const w = WEAPONS[currentWeaponKey];
  if (w.melee) return;                                           // knives don't reload
  if (ws.reloading > 0 || ws.ammo >= w.mag) return;
  if (ws.reserve !== Infinity && ws.reserve <= 0) return;        // nothing left to load
  sfxReload(currentWeaponKey);                                   // per-weapon reload SFX (local)
  if (w.rstyle === 'shell') {                                    // pump shotgun: one shell at a time
    ws.reloading = w.reload; ws.reloadTotal = w.reload; ws.shellReload = true; return;
  }
  // Gun-game-style weapons: empty-mag reloads run a touch longer (both modes).
  const empty = ggWeapon() && ws.ammo <= 0;
  ws.reloading = w.reload * (empty ? 1.12 : 1);
  ws.reloadTotal = ws.reloading; ws.shellReload = false;
}

// Move ammo from reserve into the magazine when a reload completes.
function finishReload(key) {
  const ws = weaponState[key], w = WEAPONS[key];
  if (w.akimbo) { ws.ammoL = Math.ceil(w.mag / 2); ws.ammoR = Math.floor(w.mag / 2); ws.ammo = w.mag; return; }  // both pistols
  if (ws.shellReload) {                                          // pump shotgun: load 1, keep going until full
    ws.ammo = Math.min(w.mag, ws.ammo + 1);
    if (ws.ammo < w.mag) { ws.reloading = w.reload; ws.reloadTotal = w.reload; }
    else ws.shellReload = false;
    return;
  }
  if (ws.reserve === Infinity) { ws.ammo = w.mag; return; }      // base + gun-game weapons: infinite reserve
  const take = Math.min(w.mag - ws.ammo, ws.reserve);
  ws.ammo += take; ws.reserve -= take;
}

// Build the current cycle order (base weapons + owned specials) for the mouse wheel.
function cycleKeys() { return WEAPON_ORDER.concat(SPECIAL_ORDER.filter(k => ownedSpecials.has(k))); }

// Remove an emptied special (the Desert Eagle is gone once spent).
function removeSpecial(key) {
  ownedSpecials.delete(key);
  weaponState[key].ammo = 0; weaponState[key].reserve = 0;
  if (currentWeaponKey === key) switchWeapon('pistol');
  updateHUD();
}

// --- Bullet tracers (improvement #1): pooled, reused, never created per-shot ---
// Each pool slot has both a thin Line and a thicker beam Mesh; spawnTracer picks one.
const TRACER_POOL = 80;
const tracerPool = [];
const _beamGeo = new THREE.BoxGeometry(1, 1, 1);   // unit box, scaled per beam
let _tracerCursor = 0;
for (let i = 0; i < TRACER_POOL; i++) {
  const lgeo = new THREE.BufferGeometry();
  lgeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
  const line = new THREE.Line(lgeo, new THREE.LineBasicMaterial({ transparent: true }));
  line.frustumCulled = false; line.visible = false; scene.add(line);
  const beam = new THREE.Mesh(_beamGeo, new THREE.MeshBasicMaterial({ transparent: true }));
  beam.frustumCulled = false; beam.visible = false; scene.add(beam);
  tracerPool.push({ line, beam, active: false, life: 0, maxLife: 0, thick: false });
}
function spawnTracer(from, to, opts) {
  opts = opts || {};
  const color = opts.color != null ? opts.color : TRACER.color.def;
  const life  = opts.life  != null ? opts.life  : TRACER.life.def;
  const thick = !!opts.thick;
  let t = tracerPool.find(o => !o.active);
  if (!t) { t = tracerPool[_tracerCursor++ % TRACER_POOL]; }   // recycle oldest if pool is saturated
  t.active = true; t.life = life; t.maxLife = life; t.thick = thick;
  t.op = opts.dim ? 0.42 : 1;                        // suppressed weapons get a dim tracer
  if (thick) {
    t.line.visible = false;
    const b = t.beam; b.visible = true; b.material.color.setHex(color); b.material.opacity = t.op;
    b.position.copy(from).add(to).multiplyScalar(0.5);
    b.scale.set(0.07, 0.07, Math.max(0.01, from.distanceTo(to)));
    b.lookAt(to);                                  // align local Z along the shot
  } else {
    t.beam.visible = false;
    const l = t.line; l.visible = true; l.material.color.setHex(color); l.material.opacity = t.op;
    const pos = l.geometry.attributes.position;
    pos.setXYZ(0, from.x, from.y, from.z); pos.setXYZ(1, to.x, to.y, to.z); pos.needsUpdate = true;
  }
}
function updateTracers(dt) {
  for (const t of tracerPool) {
    if (!t.active) continue;
    t.life -= dt;
    const a = Math.max(0, t.life / t.maxLife);
    (t.thick ? t.beam : t.line).material.opacity = a * (t.op || 1);
    if (t.life <= 0) { t.active = false; t.line.visible = false; t.beam.visible = false; }
  }
}
// --- Networked tracers (Part 4): purely visual (the host still validates hits), shown to everyone. ---
let tracerShotCount = 0;   // per-shot counter so automatic fire only tracers every 3rd bullet
// Ending FX: a bright flash on a body hit, a small spark on a wall, nothing in mid-air.
function tracerImpact(pos, kind) {
  if (kind === 2) spawnExplosionFX(pos, 0.9, 0xfff0b0);        // hit a player/bot — bright ending flash
  else if (kind === 1) spawnExplosionFX(pos, 0.4, 0xffb060);   // hit a wall — small spark
}
// Render an incoming tracer broadcast from another player (distance-limited; shotguns fan out).
function renderNetTracer(msg) {
  const from = new THREE.Vector3(msg.sx, msg.sy, msg.sz), to = new THREE.Vector3(msg.ex, msg.ey, msg.ez);
  const cam = camera.getWorldPosition(new THREE.Vector3());
  if (from.clone().add(to).multiplyScalar(0.5).distanceTo(cam) > 80) return;   // skip tracers from across the map
  const w = msg.w;
  const opts = { color: (TRACER.color[w] != null ? TRACER.color[w] : TRACER.color.def),
                 life: (TRACER.life[w] != null ? TRACER.life[w] : TRACER.life.def),
                 thick: !!TRACER.thick[w], dim: !!TRACER.dim[w] };
  if (w === 'shotgun' || w === 'gg6' || w === 'gg7') {           // shotgun spread: a fan of small pellet tracers
    for (let i = 0; i < 5; i++) spawnTracer(from, new THREE.Vector3(to.x + (Math.random() - 0.5) * 1.6, to.y + (Math.random() - 0.5) * 1.6, to.z + (Math.random() - 0.5) * 1.6), opts);
  } else spawnTracer(from, to, opts);
  tracerImpact(to, msg.k || 0);
}

// --- LASER SIGHT rendering: a world-space red beam from the muzzle + a bright landing dot. ---
// Mounted emitter dot on the weapon model (also shows third-person to others).
function addLaserEmitter(g, key, muzzleZ, which) {
  const dim = LASER_WEAPONS[key] < 1;   // suppressed SMG = dim emitter
  const col = laserHex(which === 'green' ? 'green' : 'red', dim);   // (PART 2) emitter matches the chosen laser color
  const mk = () => new THREE.Mesh(new THREE.BoxGeometry(0.045, 0.045, 0.07), new THREE.MeshBasicMaterial({ color: col }));
  if (g.userData.akimbo) {              // akimbo: an emitter under each pistol
    const eR = mk(); eR.position.set(0.045, -0.07, -0.18); g.userData.akimbo.R.p.add(eR);
    const eL = mk(); eL.position.set(0.045, -0.07, -0.18); g.userData.akimbo.L.p.add(eL);
  } else { const e = mk(); e.position.set(0.05, -0.075, muzzleZ + 0.14); g.add(e); }
}
function makeLaserBeam() {
  const lgeo = new THREE.BufferGeometry(); lgeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
  const line = new THREE.Line(lgeo, new THREE.LineBasicMaterial({ color: 0xff1818, transparent: true, opacity: 0.6, depthWrite: false }));
  line.frustumCulled = false; line.visible = false; scene.add(line);
  const dot = new THREE.Mesh(new THREE.SphereGeometry(0.055, 8, 6), new THREE.MeshBasicMaterial({ color: 0xff3030, transparent: true, opacity: 0.95, depthWrite: false }));
  dot.frustumCulled = false; dot.visible = false; scene.add(dot);
  return { line, dot };
}
const localLasers = [makeLaserBeam(), makeLaserBeam()];   // [0] main / right pistol, [1] left pistol (akimbo)
const LASER_LEN = 30, _laserTgt = [];
// Nearest of world geometry + bodies (bots + remote avatars) along a ray; body=true if it lands on a player/bot.
function laserCast(origin, dir, exclude) {
  let dist = LASER_LEN, body = false;
  const wall = new THREE.Raycaster(origin, dir, 0, LASER_LEN).intersectObjects(colliders, false);
  if (wall.length) dist = wall[0].distance;
  _laserTgt.length = 0;
  for (const m of botMeshes()) _laserTgt.push(m);
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.avatar && rp.avatar !== exclude) rp.avatar.children.forEach(c => { if (c.userData && c.userData.remote) _laserTgt.push(c); }); });
  if (_laserTgt.length) { const bh = new THREE.Raycaster(origin, dir, 0, dist).intersectObjects(_laserTgt, false); if (bh.length) { dist = bh[0].distance; body = true; } }
  return { point: origin.clone().addScaledVector(dir, dist), body };
}
function placeLaser(beam, from, hit, bright, hex) {
  const p = beam.line.geometry.attributes.position;
  p.setXYZ(0, from.x, from.y, from.z); p.setXYZ(1, hit.point.x, hit.point.y, hit.point.z); p.needsUpdate = true;
  if (hex != null) { beam.line.material.color.setHex(hex); if (beam.dot.material.color) beam.dot.material.color.setHex(hex); }
  beam.line.visible = true; beam.line.material.opacity = 0.55 * bright;
  beam.dot.visible = true; beam.dot.position.copy(hit.point);
  beam.dot.material.opacity = Math.min(1, (hit.body ? 1.0 : 0.85) * bright + 0.1);
  beam.dot.scale.setScalar(hit.body ? 1.6 : 1.0);
}
function hideLaser(beam) { if (beam) { beam.line.visible = false; beam.dot.visible = false; } }
/* ---- Flashlight (PART 2): a translucent cone + a SpotLight; reused for the local player + each remote holder. ---- */
const _FL_UP = new THREE.Vector3(0, 1, 0);
function makeFlashlight() {
  const cone = new THREE.Mesh(new THREE.ConeGeometry(3.2, 12, 20, 1, true), new THREE.MeshBasicMaterial({ color: 0xfff6d8, transparent: true, opacity: 0.1, side: THREE.DoubleSide, depthWrite: false }));
  cone.renderOrder = 2;
  const light = new THREE.SpotLight(0xfff2cc, 2.4, 14, 0.52, 0.5, 1.2);
  scene.add(cone); scene.add(light); scene.add(light.target);
  return { cone, light };
}
function _aimFlash(f, pos, dir) {
  f.cone.visible = true; f.light.visible = true;
  f.cone.position.copy(pos).addScaledVector(dir, 6); f.cone.quaternion.setFromUnitVectors(_FL_UP, dir.clone().negate());   // apex at the gun, widening forward
  f.light.position.copy(pos); f.light.target.position.copy(pos.clone().addScaledVector(dir, 12));
}
function updateFlashlightBeam(holder, pos, dir) { if (!holder._flash) holder._flash = makeFlashlight(); _aimFlash(holder._flash, pos, dir); }
let localFlash = null;
function updateLocalFlashlight() {
  const on = effFlash(currentWeaponKey) === 'on' && flashlightOn && player.alive && gameState.running && !paused && !rcActive && !cigSmoking && !invOpen && !player.onLadder && !flashSuppressedNow() && !killcam.active && !riding;
  if (!localFlash) { if (!on) return; localFlash = makeFlashlight(); }
  if (!on) { localFlash.cone.visible = false; localFlash.light.visible = false; return; }
  _aimFlash(localFlash, gunMuzzleWorld(), camera.getWorldDirection(new THREE.Vector3()));
}
function toggleFlashlight() {
  if (!gameState.running || !player.alive) return;
  if (effFlash(currentWeaponKey) === 'on') { flashlightOn = !flashlightOn; sfxFlashlight(flashlightOn); }
  else sfxFlashClick();   // no flashlight attachment on this gun: a subtle dead click
}
function sfxFlashlight(on) { SND.play2d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: on ? 520 : 360, f1: on ? 680 : 280, dur: 0.05, peak: 0.16 }); aNoise(ctx, out, t, { dur: 0.03, peak: 0.1, filter: 'highpass', freq: 2500 }); }, 'ui', 'flash', 0.6, 0.08); }
function sfxFlashClick() { SND.play2d((ctx, out, t) => aTone(ctx, out, t, { type: 'square', f0: 300, dur: 0.025, peak: 0.08 }), 'ui', 'flashc', 0.4, 0.04); }
let _laserWob = 0;
function updateLocalLaser(dt) {
  const show = laserOn && player.alive && gameState.running && !paused && !rcActive && !cigSmoking && !player.onLadder && !invOpen && hasLaser(currentWeaponKey);
  if (!show) { hideLaser(localLasers[0]); hideLaser(localLasers[1]); return; }
  _laserWob += dt;
  const bright = LASER_WEAPONS[currentWeaponKey] || 1;
  const hex = laserHex(effLaser(currentWeaponKey) === 'green' ? 'green' : 'red', LASER_WEAPONS[currentWeaponKey] < 1);   // (PART 2) beam color from config
  const moving = Math.hypot(player.vel.x, player.vel.z) > 1.2;
  const wob = moving ? 0.013 : 0.0045;   // subtle hand-held drift; more when moving
  const dir = camera.getWorldDirection(new THREE.Vector3());
  dir.x += Math.sin(_laserWob * 7.0) * wob; dir.y += Math.cos(_laserWob * 5.3) * wob * 0.7; dir.normalize();
  if (akimboEquipped()) {
    const mR = akimboMuzzleWorld('R'); placeLaser(localLasers[0], mR, laserCast(mR, dir), bright, hex);   // two lasers
    const mL = akimboMuzzleWorld('L'); placeLaser(localLasers[1], mL, laserCast(mL, dir), bright, hex);
  } else { const m = gunMuzzleWorld(); placeLaser(localLasers[0], m, laserCast(m, dir), bright, hex); hideLaser(localLasers[1]); }
}

// Melee swing — used by the combat knife (lvl 20) AND the karambit. Short-range
// instant kill in front. The karambit demotes its victim (the host applies it on
// the kill report); the combat knife is the win weapon.
function meleeAttack(swingDir) {
  if (!gameState.running || !player.alive) return;
  const ws = weaponState[currentWeaponKey], w = WEAPONS[currentWeaponKey];
  if (w.saber && saberBlocking) return;          // can't swing while holding the block stance
  if (ws.cooldown > 0) return;
  ws.cooldown = w.fireRate;
  // The saber kills as the player's CURRENT ladder weapon (so it advances gun-game normally) and
  // does NOT demote like the karambit. Everything else melees as its own weapon (knife demotes).
  const creditW = w.saber ? saberCreditWeapon() : currentWeaponKey;
  const meleeFlag = w.saber ? false : true;
  sfxFire(currentWeaponKey, playerEarPos());     // slash whoosh (karambit higher-pitched, saber = energy zing)
  if (NET.active) NET.broadcast({ t: 'fire', id: NET.selfId, w: currentWeaponKey, mc: meleeChoice, x: player.pos.x, y: player.pos.y + 1.2, z: player.pos.z });
  // Distinct viewmodel motion: saber = fast alternating arc, karambit = arcing slash (+1/-1),
  // combat knife = forward stab.
  if (gunMesh) {
    if (w.saber) { saberSwingT = 0.28; saberSwingDir = -saberSwingDir; }
    else if (w.karambit) { karSwingT = 0.35; karSwingDir = (swingDir === -1) ? -1 : 1; }
    else gunMesh.position.z = -0.2;
  }
  alertBots(player.pos);
  const origin = camera.getWorldPosition(new THREE.Vector3());
  const dir = camera.getWorldDirection(new THREE.Vector3());
  const reach = w.range, inFront = (p) => {
    const to = new THREE.Vector3(p.x, p.y + 1.0, p.z).sub(origin);
    return to.length() <= reach && to.normalize().dot(dir) > 0.4;
  };
  let hit = false;
  for (const bot of bots) {
    if (!bot.alive || !inFront(bot.pos)) continue;
    hit = true; spawnBlood(new THREE.Vector3(bot.pos.x, bot.pos.y + 1.2, bot.pos.z), 16);
    if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg: 9999, head: false, weapon: creditW, fromId: NET.selfId });
    else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, 9999, dir, null, { weapon: creditW, melee: meleeFlag }); if (NET.isHost) NET.botCredit = null; }
    break;
  }
  if (!hit && NET.active) {
    NET.players.forEach(rp => {
      if (hit || !rp.alive || !inFront(rp.pos)) return;
      hit = true; spawnBlood(new THREE.Vector3(rp.pos.x, rp.pos.y + 1.2, rp.pos.z), 16);
      NET.damageRemote(rp, 9999, false, creditW, meleeFlag);   // saber: melee=false (no demote, counts as a gun kill)
    });
  }
  if (hit) { showHitMarker(); showKillFlash(); if (w.saber) sfxSaberHit(origin.clone().addScaledVector(dir, reach * 0.6)); else if (w.karambit) sfxMeleeHit(meleeChoice, origin.clone().addScaledVector(dir, reach * 0.6)); }
  else if (w.saber) {
    // Missed a body — if the swing clips a wall/object, give an electric clash + sparks.
    const ray = new THREE.Raycaster(origin, dir, 0, reach);
    const ch = ray.intersectObjects(colliders, false);
    if (ch.length) { sfxSaberClash(ch[0].point); spawnSmokePuff(ch[0].point, 0x9ed2ff, 0.18, 0.3); }
  }
  updateHUD();
}

// --- Per-melee viewmodel poses (equip flourish / swing / idle inspect), driven by progress 0..1. ---
function meleeEquipPose(g, mt, e) {   // e: 0 (just drawn from below) -> 1 (settled in ready pose)
  const k = 1 - e;
  g.position.set(0.32, -0.28 - k * 0.55, -0.6);
  if (mt === 'm9') g.rotation.set(k * 0.2, 0.04 + Math.sin(k * Math.PI * 2) * 0.7, 0);                     // rise + left-then-right inspect tilt
  else if (mt === 'butterfly') g.rotation.set(k * Math.PI * 10, 0.04, Math.sin(k * Math.PI * 5) * 0.3);    // elaborate ~5-flip balisong sequence
  else g.rotation.set(0, 0.04, k * -Math.PI * 4);                                                          // karambit: 360 spin + flourish around the ring
}
function meleeSwingPose(g, mt, s, dir) {   // s: 0 -> 1 -> 0 across the swing
  if (mt === 'm9') { g.position.set(0.32 - 0.05 * s, -0.28 - 0.04 * s, -0.6 - 0.34 * s); g.rotation.set(0.95 * s, 0.04, 0.18 * s); }        // downward/forward stab
  else if (mt === 'butterfly') { g.position.set(0.32 - 0.30 * s, -0.28 + 0.07 * s, -0.6 + 0.10 * s); g.rotation.set(0.2 * s, 0.04, -1.0 * s + s * s * Math.PI * 0.5); }   // quick slash + flip flourish
  else { g.position.set(0.32 - dir * 0.34 * s, -0.28 + 0.10 * s, -0.6 + 0.12 * s); g.rotation.set(0.30 * s, 0.04, dir * 1.30 * s); }        // karambit arcing reverse-grip slash
}
function meleeInspectPose(g, mt, e) {   // e: 0 -> 1 full inspect cycle
  g.position.set(0.30, -0.26 + Math.sin(e * Math.PI) * 0.04, -0.55);
  if (mt === 'm9') g.rotation.set(0.1, 0.04 + Math.sin(e * Math.PI * 2) * 0.7, 0);          // tilt the blade side to side
  else if (mt === 'butterfly') g.rotation.set(e * Math.PI * 4, 0.04, 0);                     // flip closed and back open (2-flip flourish)
  else g.rotation.set(0, 0.04, Math.sin(e * Math.PI) * -Math.PI * 2);                        // karambit spins once on the ring
}

/* ============================================================================
   WEAPON INSPECT (Part 5) — press the Inspect key (default T) or controller R3 to play a brief,
   cosmetic showcase of the equipped weapon. LOCAL-ONLY (not networked). Movement stays free;
   firing / ADS / reload / weapon-swap instantly cancel it. The melee slot reuses its own flourish.
   ============================================================================ */
let inspectT = 0, inspectDur = 0, inspectKind = '';
function inspectKindFor(key) {
  if (key === 'saber') return 'saber';
  const w = WEAPONS[key]; if (!w) return 'rifle';
  if (w.akimbo) return 'akimbo';
  const m = w.baseModel || key;
  if (m === 'pistol' || m === 'deagle' || m === 'mpistol' || m === 'tactical' || m === 'revolver') return 'pistol';
  if (m === 'knife' || m === 'tknife') return 'knife';
  if (m === 'rocket' || m === 'gl' || m === 'rpg') return 'launcher';
  if (m === 'crossbow') return 'crossbow';
  return 'rifle';   // ARs, snipers, shotguns, LMG, AK, Dragunov, etc.
}
function startInspect() {
  if (!gameState.running || !player.alive || paused || invOpen || rcActive || cigSmoking || player.onLadder || (typeof killcam !== 'undefined' && killcam.active) || riding) return;
  if (inspectT > 0) return;
  if (currentWeaponKey === KARAMBIT_KEY) {   // melee: reuse the existing equip/idle inspect flourish
    const mt = (gunMesh && gunMesh.userData && gunMesh.userData.meleeType) || meleeChoice;
    karInspectDur = (mt === 'butterfly' ? 1.4 : mt === 'karambit' ? 1.1 : 0.9); karInspectT = karInspectDur;
    (mt === 'butterfly' ? sfxMeleeEquip('butterfly') : sfxMeleeSwing(mt)); return;
  }
  const ws = weaponState[currentWeaponKey]; if (ws && ws.reloading > 0) return;   // not mid-reload
  inspectKind = inspectKindFor(currentWeaponKey);
  inspectDur = (inspectKind === 'knife') ? 2.0 : (inspectKind === 'pistol' || inspectKind === 'launcher' || inspectKind === 'crossbow' || inspectKind === 'saber') ? 2.5 : 3.0;
  inspectT = inspectDur; sfxInspect(inspectKind);
}
function cancelInspect() { inspectT = 0; }
function _kf(p, ts, vs) {   // smoothstep keyframe interpolation over p in [0,1]
  for (let i = 0; i < ts.length - 1; i++) if (p <= ts[i + 1]) { const t = Math.max(0, Math.min(1, (p - ts[i]) / ((ts[i + 1] - ts[i]) || 1))), e = t * t * (3 - 2 * t); return vs[i] + (vs[i + 1] - vs[i]) * e; }
  return vs[vs.length - 1];
}
// Cosmetic inspect pose for the gun viewmodel: raise + bring closer, sweep to show each side, ease in/out.
function applyInspectPose(g, kind, p) {
  const close = Math.sin(Math.max(0, Math.min(1, p)) * Math.PI);   // 0->1->0 raise/close envelope
  const bx = 0.32, by = -0.28, bz = -0.6;
  let yaw, roll, pitch, x = bx, y = by, z = bz;
  if (kind === 'pistol') {
    yaw = Math.sin(p * Math.PI * 2) * 0.95;                              // tilt left then right
    roll = _kf(p, [0, 0.5, 0.62, 0.74, 1], [0, 0.2, 0.5, 0.2, 0]);       // brief slide-rack tilt mid-way
    pitch = 0.12 * close; x = bx - 0.12 * close; y = by + 0.13 * close; z = bz + 0.18 * close;
  } else if (kind === 'akimbo') {
    yaw = Math.sin(p * Math.PI * 1.5) * 0.8; roll = Math.sin(p * Math.PI * 3) * 0.55; pitch = 0.10 * close;
    x = bx - 0.10 * close; y = by + 0.12 * close; z = bz + 0.16 * close;
  } else if (kind === 'knife') {
    yaw = Math.sin(p * Math.PI * 2) * 1.0; roll = Math.sin(p * Math.PI) * 0.5; pitch = 0.18 * close;
    x = bx - 0.14 * close; y = by + 0.12 * close; z = bz + 0.2 * close;
  } else {   // rifle / sniper / shotgun / lmg / launcher / crossbow / saber: tilt to one side, rotate to the other
    yaw = _kf(p, [0, 0.28, 0.42, 0.7, 0.82, 1], [0, -1.15, -1.15, 1.0, 1.0, 0]);
    roll = _kf(p, [0, 0.5, 1], [0, 0.22, 0]); pitch = 0.14 * close;
    x = bx - 0.13 * close; y = by + 0.10 * close; z = bz + 0.18 * close;
  }
  g.position.set(x, y, z); g.rotation.set(pitch, 0.04 + yaw, roll);
}
function sfxInspect(kind) {   // subtle handling sound: cloth shuffle + a metal/leather click (or click-clacks for a knife)
  SND.play2d((ctx, out, t) => {
    aNoise(ctx, out, t, { dur: 0.18, peak: 0.06, filter: 'bandpass', freq: 600, freq1: 1400, q: 0.5 });
    aTone(ctx, out, t + 0.06, { type: 'square', f0: 320, f1: 220, dur: 0.045, peak: 0.07 });
    if (kind === 'knife') { for (let i = 0; i < 3; i++) aTone(ctx, out, t + 0.5 + i * 0.18, { type: 'square', f0: 1500 + Math.random() * 500, dur: 0.03, peak: 0.1 }); }
    else if (kind === 'rifle' || kind === 'pistol' || kind === 'launcher') aTone(ctx, out, t + 0.95, { type: 'square', f0: 280, f1: 200, dur: 0.05, peak: 0.07 });
  }, 'weapons', 'inspect', 0.5, 0.4);
}

// Burst-fire scheduler: weapons with a `burst` count queue their follow-up shells here.
const burstQueue = [];
function updateBurstQueue(dt) {
  for (let i = burstQueue.length - 1; i >= 0; i--) {
    const q = burstQueue[i]; q.t -= dt;
    if (q.t <= 0) {
      burstQueue.splice(i, 1);
      if (q.key === currentWeaponKey && player.alive && gameState.running && !paused) tryShoot(q.side, true);
    }
  }
}
// Distance damage falloff: full damage within `start`, linearly down to `min` fraction by `end`.
function ffMul(f, dist) { if (dist <= f.start) return 1; if (dist >= f.end) return f.min; return 1 - (1 - f.min) * (dist - f.start) / (f.end - f.start); }

function tryShoot(akSide, burstFollow) {
  if (!gameState.running || !player.alive || cigSmoking || player.onLadder) return;   // holstered while smoking / climbing
  const ws = weaponState[currentWeaponKey];
  const w = WEAPONS[currentWeaponKey];
  if (w.rc) { rcTryLaunch(); return; }                 // SECRET RC launcher: fire = launch a guided missile
  if (w.flame) return;                                 // flamethrower sprays continuously in updateFlamethrower (uses the `firing` hold)
  if (w.melee) { meleeAttack(); return; }

  // Akimbo: each pistol has its own ammo + cooldown. LMB fires right ('R'), RMB fires left ('L').
  const akimbo = !!w.akimbo, side = akimbo ? (akSide || 'R') : null;
  if (akimbo) {
    akimboEnsure(ws, w);
    if (ws.reloading > 0) return;
    const cdK = side === 'L' ? 'cdL' : 'cdR', amK = side === 'L' ? 'ammoL' : 'ammoR';
    if (ws[cdK] > 0) return;
    if (ws[amK] <= 0) { sfxEmpty(); if (OPT.autoReload) reload(); return; }
    ws[amK]--; ws[cdK] = w.fireRate; ws.ammo = ws.ammoL + ws.ammoR;
  } else {
    if (!burstFollow && ws.cooldown > 0) return;
    if (ws.reloading > 0) {
      if (ws.shellReload && ws.ammo > 0) { ws.reloading = 0; ws.shellReload = false; }  // pump: firing cancels the shell reload
      else return;
    }
    if (ws.ammo <= 0) { sfxEmpty(); if (!burstFollow && OPT.autoReload) reload(); return; }
    ws.ammo--;
    if (!burstFollow) ws.cooldown = w.fireRate;
    // Burst weapons (Tactical Shotgun): queue the remaining shells of this trigger pull.
    if (w.burst && !burstFollow) for (let i = 1; i < w.burst; i++) burstQueue.push({ key: currentWeaponKey, side: akSide || null, t: i * (w.burstDelay || 0.08) });
  }
  // Bolt-cycle / pump animation after the shot (bolt sniper, pump shotgun) — both modes
  if (ggWeapon()) {
    if (w.boltShot)            ggStartCycle('bolt', 0.5);
    else if (w.rstyle === 'shell') ggStartCycle('pump', Math.min(0.45, w.fireRate * 0.7));
  }

  // Recoil kick (camera) + grow spread with sustained fire
  recoilPitch += w.recoil;
  recoilYaw   += (Math.random() - 0.5) * w.recoil * 0.6;
  GP.rumble(0.18 + w.recoil * 1.5, 0.4, 55);   // brief per-shot controller rumble (scaled by the weapon's kick)
  currentSpread = Math.min(w.spreadMax, Math.max(currentSpread, w.spreadBase) + w.spreadGrow);

  // Firing while scoped briefly un-scopes from recoil, then auto-returns (improvement #1)
  if (currentWeaponKey === 'sniper' && aiming) scopePunch = SCOPE.punch;

  // Bots can "hear" the gunshot and go investigate
  alertBots(player.pos);

  // Gun "kickback" pop + muzzle flash on the viewmodel (akimbo: only the firing pistol kicks)
  if (akimbo) {
    akimboKick(side);
  } else {
    if (gunMesh) gunMesh.position.z = -0.45;
    if (!w.suppressed && gunFlash) { gunFlash.visible = true; playerFlashTimer = 0.045; }   // suppressed weapons show NO muzzle flash
  }
  _camFire = 1;   // Part 5 killcam: mark a shot fired this sample (muzzle flash + tracer replays)

  // SFX: weapon fire (local, at the muzzle) + broadcast so peers hear the shot at our position.
  sfxFire(currentWeaponKey, akimbo ? akimboMuzzleWorld(side) : gunMuzzleWorld(), akimbo ? side : null);
  if (NET.active) NET.broadcast({ t: 'fire', id: NET.selfId, w: currentWeaponKey, sd: side || null, x: player.pos.x, y: player.pos.y + 1.2, z: player.pos.z });

  const origin = camera.getWorldPosition(new THREE.Vector3());
  const baseDir = camera.getWorldDirection(new THREE.Vector3());

  // Gun-game projectile weapons (crossbow bolt / grenade / RPG rocket / thrown knife):
  // fire a visible physics projectile from the muzzle instead of hitscan.
  if (w.projType) {
    fireGGProjectile(w.projType, gunMuzzleWorld(), baseDir.clone());
    if (ws.ammo <= 0) reload();
    updateHUD();
    return;
  }

  // Rocket Launcher (FFA special): fire a physical projectile instead of hitscan (its flame
  // trail is the "tracer"). Then auto-reload from reserve.
  if (w.projectile) {
    fireRocket(gunMuzzleWorld(), baseDir.clone());
    if (ws.ammo <= 0) reload();
    updateHUD();
    return;
  }

  let effSpread = (aiming ? currentSpread * 0.4 : currentSpread) + (akimbo ? AKIMBO_SPREAD : 0);
  if (minigunSteady) effSpread *= 0.7;   // minigun steady stance: 30% tighter spread
  const muzzle = akimbo ? akimboMuzzleWorld(side) : gunMuzzleWorld();
  // Explosive gun-game tiers get a fat orange beam (and a blast FX on impact below).
  const tColor = w.explosive ? 0xffb030 : (TRACER.color[currentWeaponKey] != null ? TRACER.color[currentWeaponKey] : TRACER.color.def);
  const tLife  = TRACER.life[currentWeaponKey]  != null ? TRACER.life[currentWeaponKey]  : TRACER.life.def;
  const tThick = !!TRACER.thick[currentWeaponKey] || !!w.explosive;
  tracerShotCount++;
  const shotgunSpread = (currentWeaponKey === 'shotgun' || currentWeaponKey === 'gg6' || currentWeaponKey === 'gg7');
  // Tracer frequency: shotguns show every pellet; full-auto shows ~every 3rd bullet; everything else every shot.
  const showTracer = shotgunSpread || !w.auto || (tracerShotCount % 3 === 0);
  let firstEnd = null, endKind = 0;   // ending FX kind: 0 = air, 1 = wall/object, 2 = body

  // Raycast against bots' part-meshes, remote-player avatars, ENEMY dogs, AND world colliders.
  // TDM (friendly fire off): same-team bots + teammates are excluded, so bullets pass through them.
  const targets = colliders.concat(botMeshes().filter(m => !ffProtected(null, m.userData.bot && m.userData.bot.team)));
  dogMeshes(dogSelfId()).forEach(m => targets.push(m));   // shootable ENEMY dogs (never your own)
  kongMeshes(dogSelfId()).forEach(m => targets.push(m));  // shootable ENEMY King Kongs (never your own ally)
  mckaylaMeshes(dogSelfId()).forEach(m => targets.push(m));   // shootable ENEMY Mckaylas (never your own)
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.avatar && !ffProtected(rp.id)) rp.avatar.children.forEach(c => { if (c.userData && c.userData.remote) targets.push(c); }); });
  // Other players' in-flight RC missiles can be shot down (any direct bullet hit detonates them).
  rcRemote.forEach(o => o.grp.children.forEach(c => { if (c.isMesh) targets.push(c); }));
  for (const sc of scooters) { if (sc.alive && sc.group.visible) sc.group.traverse(o => { if (o.isMesh && o.userData && o.userData.scooter) targets.push(o); }); }   // scooters are shootable (200 HP each)

  let hitSomething = false, killedSomeone = false, killedHead = false, headHit = false;
  for (let p = 0; p < w.pellets; p++) {
    const dir = baseDir.clone();
    // Apply random spread cone
    dir.x += (Math.random() - 0.5) * effSpread;
    dir.y += (Math.random() - 0.5) * effSpread;
    dir.z += (Math.random() - 0.5) * effSpread;
    dir.normalize();

    const ray = new THREE.Raycaster(origin, dir, 0, w.range);
    const hits = ray.intersectObjects(targets, false);
    let end = origin.clone().add(dir.clone().multiplyScalar(w.range));
    if (hits.length) {
      const hit = hits[0];
      end = hit.point.clone();
      const ud = hit.object.userData || {};
      if (ud.explosive) { hitSomething = true; if (firstEnd === null) { firstEnd = end; endKind = 1; } brExplodeBarrel(hit.object); continue; }   // BR: shooting a fuel barrel detonates it
      const bot = ud.bot;
      if (bot && bot.alive) {
        hitSomething = true;
        const part = ud.part;
        const isHead = part === 'head';
        let dmg = w.damage * (isHead ? w.headMult : 1);
        if (w.falloff) dmg *= ffMul(w.falloff, hit.distance);   // Tactical Shotgun drops off past ~8u
        spawnBlood(hit.point, isHead ? 16 : 9);
        if (isHead) headHit = true;
        showDamageNumber(hit.point, dmg, isHead);   // floating damage number (Part 3)
        if (NET.isClient) {
          // host owns the bots — report the hit, just show local feedback
          NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg, head: isHead, weapon: currentWeaponKey, fromId: NET.selfId });
        } else {
          if (NET.isHost) NET.botCredit = NET.selfId;
          const dead = damageBot(bot, dmg, dir, part, { weapon: currentWeaponKey, dist: hit.distance, headshot: isHead });
          if (NET.isHost) NET.botCredit = null;
          if (dead) { killedSomeone = true; if (isHead) killedHead = true; spawnBlood(hit.point, 14); }
        }
      }
      else if (ud.remote && ud.remote.alive) {
        // PvP: tell that player to take damage (they're authoritative on their own HP)
        hitSomething = true;
        const isHead = ud.part === 'head';
        let dmg = w.damage * (isHead ? w.headMult : 1);
        if (w.falloff) dmg *= ffMul(w.falloff, hit.distance);   // Tactical Shotgun drops off past ~8u
        spawnBlood(hit.point, isHead ? 16 : 9);
        if (!ffProtected(ud.remote.id)) { if (isHead) headHit = true; showDamageNumber(hit.point, dmg, isHead); }   // no marker/number for protected teammates
        NET.damageRemote(ud.remote, dmg, isHead, currentWeaponKey, false, origin, dir);   // origin+dir let their saber deflect
      }
      else if (ud.dog && ud.dog.alive && !ud.dog.dying) {
        // Shot an enemy's attack dog — host applies the damage (clients route it for validation).
        hitSomething = true; spawnBlood(hit.point, 8);
        if (NET.isClient) NET.route(NET.hostId, { t: 'doghit', dogId: ud.dog.id, dmg: w.damage });
        else damageDog(ud.dog, w.damage);
      }
      else if (ud.kong && ud.kong.alive && !ud.kong.dying) {
        // Shot an enemy's King Kong — host applies the damage (clients route it, crediting the shooter).
        hitSomething = true; spawnBlood(hit.point, 10);
        if (NET.isClient) NET.route(NET.hostId, { t: 'konghit', kongId: ud.kong.id, dmg: (w.kongDmg || w.damage), fromId: NET.selfId });
        else damageKong(ud.kong, (w.kongDmg || w.damage), dogSelfId());
      }
      else if (ud.mck && ud.mck.alive && !ud.mck.dying) {
        // Shot an enemy's Mckayla — host applies the damage (clients route it for validation).
        hitSomething = true; spawnBlood(hit.point, 10);
        if (NET.isClient) NET.route(NET.hostId, { t: 'mckhit', mckId: ud.mck.id, dmg: w.damage });
        else damageMckayla(ud.mck, w.damage);
      }
      else if (ud.rcRemoteOwner) {
        // Shot down someone's RC missile: pop a flash here + tell the owner to detonate it.
        hitSomething = true;
        spawnExplosionFX(end, RC.blastR * 0.5, 0x7ad8ff);
        NET.route(ud.rcRemoteOwner, { t: 'rcshot', id: ud.rcRemoteOwner, byId: NET.selfId });
        rcRemoteCleanup(ud.rcRemoteOwner);          // remove our local copy immediately
      }
      else if (ud.scooter) {                        // shot a mobility scooter (200 HP each)
        hitSomething = true; spawnExplosionFX(hit.point, 0.5, 0xffd27a);
        let dmg = w.damage; if (w.falloff) dmg *= ffMul(w.falloff, hit.distance);
        if (scooters[ud.scIdx]) damageScooter(scooters[ud.scIdx], dmg);
      }
      // Impact SFX (first pellet only): flesh/headshot on a body, metal on vehicles/fence, else wall.
      if (p === 0) {
        if ((ud.bot && ud.bot.alive) || (ud.remote && ud.remote.alive)) { endKind = 2; sfxImpact(ud.part === 'head' ? 'head' : 'flesh', hit.point); }
        else if (ud.dog || ud.kong || ud.mck) endKind = 2;
        else if (!ud.rcRemoteOwner) { endKind = 1; sfxImpact(ud.mat === 'metal' ? 'metal' : 'wall', hit.point); }
      }
    }
    if (p === 0) firstEnd = end.clone();   // primary tracer end (hit point or max range)
    // Tracer: shotgun shows one per pellet; otherwise a single tracer on qualifying shots.
    if ((shotgunSpread || p === 0) && showTracer) {
      spawnTracer(muzzle, end, { color: tColor, life: tLife, thick: tThick, dim: TRACER.dim[currentWeaponKey] });
      if (w.explosive) spawnExplosionFX(end, 6, 0xffb030);   // cosmetic blast on impact
    }
  }
  // Networked tracer + ending FX — every player sees it (visual only; hits are validated separately).
  if (showTracer && firstEnd && !w.explosive) {
    tracerImpact(firstEnd, endKind);
    if (NET.active) NET.broadcast({ t: 'trace', id: NET.selfId, w: currentWeaponKey, sx: muzzle.x, sy: muzzle.y, sz: muzzle.z, ex: firstEnd.x, ey: firstEnd.y, ez: firstEnd.z, k: endKind });
  }

  // The Desert Eagle is gone once fully spent.
  if (currentWeaponKey === 'deagle' && ws.ammo <= 0 && ws.reserve <= 0) removeSpecial('deagle');
  else if (ws.ammo <= 0) reload();

  if (hitSomething) showHitMarker(headHit);
  if (killedSomeone) showKillFlash(killedHead);
  updateHUD();
}

/* ============================================================================
   7. BOTS — blocky players, wander/chase/shoot AI, respawn
   ============================================================================ */
const BOT_COLORS = [0xff3b3b, 0x3b8cff, 0xffd23b, 0xff7bd5, 0x35e0c0, 0xff8c1a, 0x9b59ff, 0x2ecc71];
const bots = [];

/* ----------------------------------------------------------------------------
   BANDIT APPEARANCE (improvement #3) + RIG (improvement #1)
   Each bot is a root group whose children are *part pivots* (head / torso /
   armL / armR / legL / legR). A pivot sits at the part's joint so it can be
   detached cleanly for dismemberment. Every visual mesh is tagged with
   userData.part + userData.bot so raycasts resolve to the right limb.
---------------------------------------------------------------------------- */
// Slightly varied bandit palettes so the arena looks like a gang, not clones.
const BANDIT_PALETTES = [
  { jacket:0x5b4636, shirt:0xc9b48b, bandana:0xb83227, pants:0x4a3b2c, boots:0x2b211a, skin:0xd9a066, hat:0x3a2a1c },
  { jacket:0x3c4a32, shirt:0xb0b08a, bandana:0x1c1c1c, pants:0x33402b, boots:0x161616, skin:0xc98f5a, hat:0x222018 },
  { jacket:0x6b3f2a, shirt:0xd8c69a, bandana:0x8a5a2b, pants:0x523524, boots:0x241813, skin:0xe0b483, hat:0x2e1d12 },
  { jacket:0x444a55, shirt:0xb9c2cf, bandana:0x9a1f1f, pants:0x383d45, boots:0x1a1d22, skin:0xcf9b6a, hat:0x20242b },
  { jacket:0x6d5a2f, shirt:0xd3c98f, bandana:0x111111, pants:0x4d4022, boots:0x221c10, skin:0xd9a066, hat:0x2b2410 },
  { jacket:0x704241, shirt:0xcbb59a, bandana:0x2b2b2b, pants:0x4b2f2e, boots:0x201413, skin:0xc98f5a, hat:0x2a1817 }
];
const HEADWEAR = ['hat', 'beanie', 'bare'];

// Build a small low-poly weapon for a bot's hand. Barrel points along +Z
// (the bot's local forward, i.e. toward whatever it faces). Returns {group, muzzle, mats}.
function buildBotWeapon(key) {
  const g = new THREE.Group();
  const mats = [];
  const col = WEAPONS[key].color;
  const box = (x, y, z, sx, sy, sz, c) => {
    const mat = new THREE.MeshLambertMaterial({ color: c, flatShading: true });
    mats.push(mat);
    const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat);
    m.position.set(x, y, z); g.add(m); return m;
  };
  if (key === 'pistol')      { box(0, 0, 0.18, 0.10, 0.10, 0.36, col); box(0, -0.13, 0.05, 0.09, 0.18, 0.11, 0x222222); }
  else if (key === 'smg')    { box(0, 0, 0.26, 0.11, 0.13, 0.52, col); box(0, -0.15, 0.12, 0.08, 0.20, 0.10, 0x222222); box(0, -0.05, 0.34, 0.07, 0.10, 0.20, 0x333333); }
  else if (key === 'shotgun'){ box(0, 0, 0.34, 0.13, 0.13, 0.72, col); box(0, -0.05, 0.34, 0.10, 0.08, 0.74, 0x5a3010); box(0, -0.14, 0.04, 0.10, 0.18, 0.16, 0x3a1f0a); }
  else                       { box(0, 0, 0.46, 0.09, 0.09, 0.92, col); box(0, 0.10, 0.30, 0.06, 0.06, 0.30, 0x111111); box(0, -0.14, 0.06, 0.09, 0.18, 0.14, 0x222222); } // sniper
  // Muzzle flash (hidden until the bot fires) at the barrel tip
  const barrelZ = key === 'sniper' ? 0.95 : key === 'shotgun' ? 0.72 : key === 'smg' ? 0.55 : 0.38;
  const muzzle = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.22, 0.22),
    new THREE.MeshBasicMaterial({ color: 0xffd24a, transparent: true, opacity: 0.9 }));
  muzzle.position.set(0, 0, barrelZ); muzzle.visible = false; g.add(muzzle);
  return { group: g, muzzle, mats };
}

// Build the full bandit rig onto `bot`. Sets bot.group, bot.parts, bot.materials,
// bot.weaponKey, bot.weaponMesh, bot.muzzle.
function buildBanditRig(bot) {
  const pal = BANDIT_PALETTES[(Math.random() * BANDIT_PALETTES.length) | 0];
  const headwear = HEADWEAR[(Math.random() * HEADWEAR.length) | 0];
  const weaponKey = pickBotWeapon();
  const root = new THREE.Group();
  const mats = [];
  const matOf = (c) => { const m = new THREE.MeshLambertMaterial({ color: c, flatShading: true }); mats.push(m); return m; };

  // Make a part pivot at (px,py,pz); `add(...)` places child boxes relative to it.
  function makePart(name, px, py, pz) {
    const pivot = new THREE.Group();
    pivot.position.set(px, py, pz);
    pivot.userData.part = name; pivot.userData.bot = bot;
    pivot.add2 = (x, y, z, sx, sy, sz, color) => {
      const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), matOf(color));
      m.position.set(x, y, z); m.castShadow = true;
      m.userData.part = name; m.userData.bot = bot;   // every mesh resolves to this part
      pivot.add(m); return m;
    };
    root.add(pivot);
    return pivot;
  }

  // TORSO (pivot at the waist) — worn jacket + lighter undershirt + belt + chest strap
  const torso = makePart('torso', 0, 0.55, 0);
  torso.add2(0, 0.40, 0, 0.78, 0.85, 0.46, pal.jacket);     // jacket body
  torso.add2(0, 0.84, 0, 0.50, 0.14, 0.30, pal.shirt);      // undershirt at neck
  torso.add2(0, 0.05, 0, 0.82, 0.12, 0.50, 0x1a1208);       // waist belt
  const strap = torso.add2(0, 0.42, 0.235, 0.10, 0.95, 0.06, 0x241810); // diagonal chest strap
  strap.rotation.z = 0.5;

  // HEAD (pivot at the neck) — skin face + lower-half bandana mask + headwear
  const head = makePart('head', 0, 1.45, 0);
  head.add2(0, 0.28, 0, 0.50, 0.50, 0.50, pal.skin);        // face block
  head.add2(0, 0.16, 0.02, 0.52, 0.20, 0.52, pal.bandana);  // bandana over mouth/nose
  head.add2(0, 0.34, 0.245, 0.40, 0.08, 0.06, 0x1a1a1a);    // dark eye band
  if (headwear === 'hat') {
    head.add2(0, 0.55, 0, 1.02, 0.06, 1.02, pal.hat);       // wide brim
    head.add2(0, 0.66, 0, 0.46, 0.22, 0.46, pal.hat);       // crown
  } else if (headwear === 'beanie') {
    head.add2(0, 0.50, 0, 0.56, 0.30, 0.56, pal.bandana);   // pulled-down beanie
  } else {
    head.add2(0, 0.48, 0, 0.54, 0.16, 0.54, pal.bandana);   // bandana-wrapped top
  }

  // ARMS (pivots at the shoulders) — jacket sleeves + hands
  const armL = makePart('armL', -0.52, 1.30, 0);
  armL.add2(0, -0.40, 0, 0.30, 0.80, 0.30, pal.jacket);
  armL.add2(0, -0.82, 0, 0.26, 0.16, 0.28, pal.skin);       // hand
  const armR = makePart('armR', 0.52, 1.30, 0);
  armR.add2(0, -0.40, 0, 0.30, 0.80, 0.30, pal.jacket);
  armR.add2(0, -0.82, 0, 0.26, 0.16, 0.28, pal.skin);       // hand

  // LEGS (pivots at the hips) — pants + dark boots
  const legL = makePart('legL', -0.22, 0.70, 0);
  legL.add2(0, -0.36, 0, 0.30, 0.72, 0.30, pal.pants);
  legL.add2(0, -0.72, 0.04, 0.32, 0.18, 0.36, pal.boots);   // boot
  const legR = makePart('legR', 0.22, 0.70, 0);
  legR.add2(0, -0.36, 0, 0.30, 0.72, 0.30, pal.pants);
  legR.add2(0, -0.72, 0.04, 0.32, 0.18, 0.36, pal.boots);

  // Visible weapon in the RIGHT hand (improvement #2)
  const wpn = buildBotWeapon(weaponKey);
  wpn.group.position.set(0, -0.82, 0.12);   // at the hand, barrel forward (+Z)
  armR.add(wpn.group);

  bot.group = root;
  bot.parts = {
    head:  { group: head,  hp: DISMEMBER.partHP.head,  detached: false },
    torso: { group: torso, hp: DISMEMBER.partHP.torso, detached: false },
    armL:  { group: armL,  hp: DISMEMBER.partHP.armL,  detached: false },
    armR:  { group: armR,  hp: DISMEMBER.partHP.armR,  detached: false },
    legL:  { group: legL,  hp: DISMEMBER.partHP.legL,  detached: false },
    legR:  { group: legR,  hp: DISMEMBER.partHP.legR,  detached: false }
  };
  bot.materials = mats.concat(wpn.mats);
  bot.weaponKey = weaponKey;
  bot.weaponMesh = wpn.group;
  bot.muzzle = wpn.muzzle;
}

function botMeshes() {
  // All hittable part meshes on alive bots (recursive; excludes guns/muzzle/stumps
  // which carry no userData.part, so you can't "hit" a bot's gun).
  const arr = [];
  for (const b of bots) if (b.alive) b.group.traverse(o => { if (o.isMesh && o.userData.part) arr.push(o); });
  return arr;
}

// Pick a spawn point, avoiding any that has a living enemy in line of sight within
// ~5 units (spawn protection). Tries several candidates, falls back to a random one.
function spawnEnemies() {
  const list = [];
  for (const b of bots) if (b.alive) list.push(b.pos);
  if (typeof NET !== 'undefined' && NET.active) NET.players.forEach(rp => { if (rp.alive) list.push(rp.pos); });
  return list;
}
function spawnBlocked(p) {
  const eyes = new THREE.Vector3(p.x, p.y + 1.5, p.z);
  for (const e of spawnEnemies()) {
    if (eyes.distanceTo(e) > 5) continue;                     // far enough away → fine
    const tgt = new THREE.Vector3(e.x, e.y + 1.2, e.z), dir = tgt.clone().sub(eyes), d = dir.length();
    dir.normalize();
    const r = new THREE.Raycaster(eyes, dir, 0, d - 0.4);
    if (!r.intersectObjects(colliders, false).length) return true;   // close AND in line of sight → blocked
  }
  return false;
}
function randomSpawn() {
  const pts = (activeMap === 'paradise' && island && island.spawns.length) ? island.spawns : spawnPoints;   // BR: spawn on the island
  if (!pts.length) return new THREE.Vector3(activeMap === 'paradise' && island ? island.cx : 0, 0, activeMap === 'paradise' && island ? island.cz : 0);
  let best = null;
  for (let i = 0; i < 14; i++) {
    const c = pts[(Math.random() * pts.length) | 0];
    if (!best) best = c;
    if (!spawnBlocked(c)) return c.clone();
  }
  return best.clone();
}
function botPatrolPoint() { const pts = (activeMap === 'paradise' && island && island.patrol.length) ? island.patrol : patrolPoints; return pts[(Math.random() * pts.length) | 0]; }

// --- Bot AI tuning (improvement #4): tweak personality/difficulty here ---
const BOT_AI = {
  patrolSpeed: 3.2,        // walking pace between patrol points
  chaseSpeed: 7.0,         // top speed when investigating / repositioning
  engageSpeed: 4.5,        // speed while fighting (strafing/peeking)
  accel: 26,               // velocity acceleration (units/s^2) -> smooth, no teleporting
  detectRange: 58,         // how far a bot can spot the player (with line-of-sight)
  loseRange: 75,           // give up the chase beyond this
  shootRange: 52,          // max engagement distance
  visionHalfAngle: 1.15,   // vision cone half-angle (rad); inside ~8u they always notice
  hearRange: 50,           // gunshots within this radius trigger "investigate"
  fireRate: 1.25,          // seconds between bot shots
  damage: 8,               // damage per landed bot shot
  baseAccuracy: 0.8,       // point-blank hit chance (scales down with distance)
  aimWobble: 0.07,         // random aim error (radians) for fair, imperfect aim
  strafeInterval: 1.1,     // how often a bot flips strafe direction while engaging
  lookAroundTime: 2.2,     // pause-and-rotate duration at a patrol point
  investigateTime: 5.0,    // how long to search a last-known position
  lowHealth: 35,           // retreat-to-cover threshold
  fleeTime: 2.5,           // how long to hold cover before re-engaging
  // --- movement/animation feel (improvement: believable bot motion) ---
  maxSpeedForLean: 7.0,    // reference speed for the lean-into-travel amount
  flinchTime: 0.18,        // stagger duration when shot (pauses + knockback)
  flinchKnockback: 4.0,    // velocity nudge in the bullet's direction on hit
  crouchMin: 0.5,          // min seconds between crouch/peek toggles while engaging
  crouchMax: 1.4,          // max seconds between crouch/peek toggles
  deathFade: 1.2           // seconds to topple + fade out after dying
};

// --- Dismemberment thresholds & chances (improvement #1) ---
const DISMEMBER = {
  // Per-part hit-point pools. A part pops off when its pool hits 0, OR per the
  // weapon-specific rules below. (Head pool is low so heavy hits decapitate.)
  partHP: { head: 70, torso: 9999, armL: 40, armR: 40, legL: 55, legR: 55 },
  sniperHeadAlways: true,   // a sniper hit to the head ALWAYS decapitates (instant kill)
  shotgunRange: 16,         // "close range" distance for shotgun limb blow-off
  shotgunLimbChance: 0.6,   // chance a close shotgun limb hit tears the limb off
  grenadeLimbRadius: 5.5,   // within this of a blast, limbs can be torn off
  grenadeLimbChance: 0.75,  // base chance per limb inside that radius (scaled by closeness)
  partLife: 4.0,            // seconds before detached limbs / dropped guns clean up
  partSpin: 7,              // random spin speed for tumbling detached parts
  armAimPenalty: 2.2        // bot aim wobble multiplier after losing an arm
};

// --- Bot loadout: which weapon each bandit spawns with (improvement #2) ---
// Weighted so the arena reads as a gang: mostly pistols/SMGs, fewer shotguns/snipers.
const BOT_LOADOUT = {
  weights: { pistol: 0.40, smg: 0.34, shotgun: 0.16, sniper: 0.10 },
  // per-weapon bot combat feel (kept fair/slow); rate = sec between shots, dmg = per hit
  stats: {
    pistol:  { rate: 1.15, dmg: 8  },
    smg:     { rate: 0.55, dmg: 5  },
    shotgun: { rate: 1.50, dmg: 14 },
    sniper:  { rate: 2.10, dmg: 20 }
  }
};
function pickBotWeapon() {
  let r = Math.random(), acc = 0;
  for (const k of WEAPON_ORDER) { acc += BOT_LOADOUT.weights[k] || 0; if (r <= acc) return k; }
  return 'pistol';
}

// Free a group's geometries + materials (called when rebuilding a bot rig).
function disposeGroup(group) {
  group.traverse(o => {
    if (o.isMesh) { if (o.geometry) o.geometry.dispose(); if (o.material) o.material.dispose(); }
  });
}

// Reset all state for a (re)spawned bot. The rig is rebuilt each life so
// dismemberment / dropped guns / new loadout + appearance start fresh.
function spawnBot(bot) {
  if (bot.group) { scene.remove(bot.group); disposeGroup(bot.group); }
  bot.teamPip = null;
  if (gameMode === 'tdm' && !bot.team) bot.team = NET.active ? ((bot.id % 2) ? 'red' : 'blue') : 'blue';   // solo TDM: bots are the enemy (BLUE)
  buildBanditRig(bot);                 // assigns group, parts, materials, weapon
  scene.add(bot.group);
  updateBotTeamPip(bot);               // TDM: overhead team-color pip

  const sp = randomSpawn();
  bot.pos.set(sp.x, groundHeightAt(sp.x, sp.z, 0.5), sp.z);
  bot.vel.set(0, 0, 0);
  bot.health = 100;
  bot.alive = true;
  bot.state = 'PATROL';
  bot.patrolTarget = botPatrolPoint();
  bot.pauseTimer = 0;
  bot.lookYaw = Math.random() * Math.PI * 2;
  bot.yawFacing = bot.lookYaw;
  bot.lastKnown = null;
  bot.investigateTimer = 0;
  bot.shootCd = 0.5 + Math.random();
  bot.strafeDir = Math.random() < 0.5 ? 1 : -1;
  bot.strafeTimer = BOT_AI.strafeInterval;
  bot.fleeTimer = 0;
  bot.coverPoint = null;
  // animation/juice state
  bot.flinch = 0;
  bot.crouch = 0; bot.crouching = false; bot.crouchTimer = 0;
  bot.bobPhase = Math.random() * Math.PI * 2;
  bot.dying = false; bot.deathTimer = 0; bot.toppleAngle = 0; bot.deathYaw = bot.yawFacing;
  // dismemberment / equipment state (improvements #1, #2)
  bot.hasGun = true;
  bot.aimPenalty = false;
  bot.collapsed = false;
  bot.dismembered = false;
  bot.muzzleTimer = 0;
  bot.group.scale.set(1, 1, 1);
  bot.group.rotation.set(0, bot.yawFacing, 0);
  bot.group.visible = true;
}

const BOT_NAMES = ['Viper', 'Maverick', 'Ghost', 'Reaper', 'Hawk', 'Bandit', 'Rogue', 'Echo', 'Frost', 'Talon', 'Cobra', 'Wraith'];
function createBots() {
  for (let i = 0; i < botCount; i++) {
    const bot = {
      id: i + 1,
      name: BOT_NAMES[i % BOT_NAMES.length],   // used by the BR spectator HUD + results placement table
      pos: new THREE.Vector3(), vel: new THREE.Vector3(),
      health: 100, alive: true, respawnTimer: 0, group: null
    };
    bots.push(bot);
    spawnBot(bot);   // builds the rig
  }
}

// Reconcile the live bot list to the current `botCount` setting (host/solo only).
// Lets Settings add or remove bots without restarting the match.
function applyBotCount() {
  if (NET.active && !NET.isHost) return;          // clients get bots from the host
  while (bots.length < botCount) {
    const bot = { id: bots.length + 1, pos: new THREE.Vector3(), vel: new THREE.Vector3(),
                  health: 100, alive: true, respawnTimer: 0, group: null };
    bots.push(bot); spawnBot(bot);
  }
  while (bots.length > botCount) {
    const bot = bots.pop();
    if (bot.group) { scene.remove(bot.group); disposeGroup(bot.group); }
  }
}

// World debris (detached limbs, heads, dropped guns) — falls, spins, fades, cleans up.
const debris = [];
function detachToDebris(obj3d, hitDir, baseLife) {
  scene.attach(obj3d);                       // reparent to scene, preserving world transform
  const mats = [];
  obj3d.traverse(o => { if (o.isMesh) { o.material = o.material.clone(); mats.push(o.material); } }); // own materials so fading doesn't touch the bot
  const v = new THREE.Vector3((Math.random() - 0.5) * 3, 3 + Math.random() * 3, (Math.random() - 0.5) * 3);
  if (hitDir) { v.x += hitDir.x * 4; v.z += hitDir.z * 4; }
  const spin = new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).multiplyScalar(DISMEMBER.partSpin);
  debris.push({ obj: obj3d, vel: v, spin, life: baseLife, maxLife: baseLife, mats });
}
function updateDebris(dt) {
  for (let i = debris.length - 1; i >= 0; i--) {
    const d = debris[i];
    d.life -= dt;
    d.vel.y -= 26 * dt;
    d.obj.position.addScaledVector(d.vel, dt);
    const gy = groundHeightAt(d.obj.position.x, d.obj.position.z, 50) + 0.18;
    if (d.obj.position.y < gy) { d.obj.position.y = gy; d.vel.y *= -0.3; d.vel.x *= 0.7; d.vel.z *= 0.7; d.spin.multiplyScalar(0.6); }
    d.obj.rotation.x += d.spin.x * dt; d.obj.rotation.y += d.spin.y * dt; d.obj.rotation.z += d.spin.z * dt;
    if (d.life < 1) for (const m of d.mats) { m.transparent = true; m.opacity = Math.max(0, d.life); }
    if (d.life <= 0) { scene.remove(d.obj); disposeGroup(d.obj); debris.splice(i, 1); }
  }
}

// Add a dark-red stump at a detached part's joint (stays on the bot, fades with it).
function addStump(bot, pivot) {
  const mat = new THREE.MeshLambertMaterial({ color: 0x5a0a0a, flatShading: true });
  bot.materials.push(mat);                   // so it fades during the death animation
  const stump = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.26, 0.26), mat);
  stump.position.copy(pivot.position);
  bot.group.add(stump);
}

// Decide whether a hit should pop the part off, per the DISMEMBER rules.
function shouldDismember(bot, partName, ctx) {
  const p = bot.parts[partName];
  if (!p || p.detached) return false;
  if (partName === 'torso') return false;                         // torso never detaches
  if (partName === 'head') {
    if (ctx.weapon === 'sniper' && DISMEMBER.sniperHeadAlways) return true;  // sniper = instant decap
    return p.hp <= 0;
  }
  // limbs (arms / legs)
  if (ctx.weapon === 'shotgun' && ctx.dist != null && ctx.dist <= DISMEMBER.shotgunRange &&
      Math.random() < DISMEMBER.shotgunLimbChance) return true;
  if (ctx.blast && ctx.dist != null && ctx.dist <= DISMEMBER.grenadeLimbRadius &&
      Math.random() < DISMEMBER.grenadeLimbChance * (1 - ctx.dist / DISMEMBER.grenadeLimbRadius)) return true;
  return p.hp <= 0;                                               // sustained fire wears it off
}

// The bot drops its gun into the world (loses the ability to shoot).
function dropGun(bot) {
  if (!bot.hasGun || !bot.weaponMesh) return;
  if (bot.muzzle) bot.muzzle.visible = false;
  detachToDebris(bot.weaponMesh, null, DISMEMBER.partLife);
  bot.weaponMesh = null; bot.muzzle = null; bot.hasGun = false;
}

// Detach a limb/head: spawn flying debris + a stump + a blood burst, update state.
function detachPart(bot, partName, hitDir) {
  const p = bot.parts[partName];
  if (!p || p.detached) return;
  p.detached = true;
  bot.dismembered = true;
  const jointWorld = p.group.getWorldPosition(new THREE.Vector3());
  if (partName === 'armR') dropGun(bot);          // weapon hand gone -> drop gun first
  detachToDebris(p.group, hitDir, DISMEMBER.partLife);
  addStump(bot, p.group);                          // p.group.position is the joint (local)
  spawnBlood(jointWorld, 20);                       // strong blood burst at the stump
  if (partName === 'armL' || partName === 'armR') bot.aimPenalty = true;  // can't aim as well
  if (partName === 'legL' || partName === 'legR') bot.collapsed = true;   // legs gone -> collapse
}

// Mark a bot dead and start the topple/fade death animation.
function killBot(bot, hitDir, info) {
  if (!bot.alive) return;
  bot.alive = false;
  bot.dying = true;
  bot.deathTimer = BOT_AI.deathFade;
  bot.toppleAngle = 0;
  bot.deathYaw = hitDir ? Math.atan2(hitDir.x, hitDir.z) : bot.yawFacing;
  if (bot.muzzle) bot.muzzle.visible = false;
  spawnBloodDecal(bot.pos);
  onBotKilled(bot, info || {});
}

// Apply damage to a bot, resolve dismemberment, and handle death.
// partName = which part was hit (null for pure blast damage).
// ctx = { weapon, dist, headshot, blast } context for dismemberment rules.
function damageBot(bot, dmg, hitDir, partName, ctx) {
  ctx = ctx || {};
  if (!bot.alive) return false;
  bot.health -= dmg;
  bot.flinch = BOT_AI.flinchTime;                 // brief stagger
  if (hitDir) {                                   // knockback in the bullet's direction
    bot.vel.x += hitDir.x * BOT_AI.flinchKnockback;
    bot.vel.z += hitDir.z * BOT_AI.flinchKnockback;
  }
  let headRemoved = false;
  if (partName && bot.parts[partName] && !bot.parts[partName].detached) {
    bot.parts[partName].hp -= dmg;
    if (shouldDismember(bot, partName, ctx)) {
      detachPart(bot, partName, hitDir);
      if (partName === 'head') headRemoved = true;   // no head = dead
    }
  }
  if (headRemoved || bot.health <= 0) {
    killBot(bot, hitDir, { headshot: !!ctx.headshot || headRemoved, dismembered: bot.dismembered, weapon: ctx.weapon });
    return true;
  }
  return false;
}

/* --- AI helper functions --- */
const _up = new THREE.Vector3(0, 1, 0);
function rotateY(v, a) {
  const c = Math.cos(a), s = Math.sin(a);
  return new THREE.Vector3(v.x * c + v.z * s, 0, -v.x * s + v.z * c);
}
function approach(cur, target, maxDelta) {
  const d = target - cur;
  return Math.abs(d) <= maxDelta ? target : cur + Math.sign(d) * maxDelta;
}

// Can this bot actually see the player? (range + vision cone + line-of-sight)
const _botEye = new THREE.Vector3(), _plrEye = new THREE.Vector3(), _toP = new THREE.Vector3();
function botCanSeePlayer(bot, target) {
  target = target || player;
  if (!target.alive) return false;
  _toP.subVectors(target.pos, bot.pos); _toP.y = 0;
  const dist = _toP.length();
  if (dist > BOT_AI.detectRange) return false;
  _toP.normalize();
  // Outside ~8 units the target must be within the vision cone
  if (dist > 8) {
    const facing = new THREE.Vector3(Math.sin(bot.yawFacing), 0, Math.cos(bot.yawFacing));
    if (facing.dot(_toP) < Math.cos(BOT_AI.visionHalfAngle)) return false;
  }
  // Line-of-sight: no world collider between the eyes
  _botEye.set(bot.pos.x, bot.pos.y + 1.4, bot.pos.z);
  _plrEye.set(target.pos.x, target.pos.y + 1.2, target.pos.z);
  const dir = _plrEye.clone().sub(_botEye);
  const d = dir.length(); dir.normalize();
  const ray = new THREE.Raycaster(_botEye, dir, 0, d);
  return !ray.intersectObjects(colliders, false).some(h => h.distance < d - 0.6);
}

// Simple raycast obstacle avoidance: nudge the steering dir around walls.
function botAvoid(bot, dir) {
  if (dir.lengthSq() < 1e-4) return dir;
  const probe = new THREE.Vector3(bot.pos.x, bot.pos.y + 1.0, bot.pos.z);
  const clear = (d) => {
    const ray = new THREE.Raycaster(probe, d, 0, 4);
    return !ray.intersectObjects(colliders, false).length;
  };
  if (clear(dir)) return dir;
  for (const a of [0.6, -0.6, 1.2, -1.2, 2.0]) {  // try increasingly wide detours
    const alt = rotateY(dir, a);
    if (clear(alt)) return alt;
  }
  return rotateY(dir, Math.PI); // boxed in: turn around
}

// Find a hide spot behind the nearest crate, on the far side from the player.
function botFindCover(bot) {
  let best = null, bestD = Infinity;
  for (const [cx, cz] of cratePositions) {
    const d = (cx - bot.pos.x) ** 2 + (cz - bot.pos.z) ** 2;
    if (d < bestD) { bestD = d; best = [cx, cz]; }
  }
  if (!best) return player.pos.clone().sub(bot.pos).setLength(-20).add(bot.pos);
  const c = new THREE.Vector3(best[0], 0, best[1]);
  const away = c.clone().sub(player.pos); away.y = 0; away.normalize();
  return c.add(away.multiplyScalar(3.5));
}

// Gunshots alert nearby bots (improvement #4): go investigate the source.
function alertBots(pos) {
  for (const bot of bots) {
    if (!bot.alive || bot.state === 'ENGAGE') continue;
    if (bot.pos.distanceTo(pos) <= BOT_AI.hearRange) {
      bot.lastKnown = pos.clone();
      bot.state = 'INVESTIGATE';
      bot.investigateTimer = BOT_AI.investigateTime;
    }
  }
}

function updateBots(dt) {
  const lim = ARENA - 2;
  for (const bot of bots) {
    if (!bot.alive) {
      if (bot.dying) {
        // Death animation: topple over in the bullet's direction, then fade out.
        bot.deathTimer -= dt;
        bot.toppleAngle += (1.45 - bot.toppleAngle) * Math.min(1, dt * 9);  // fall flat
        bot.group.rotation.set(bot.toppleAngle, bot.deathYaw, 0);
        const f = bot.deathTimer / BOT_AI.deathFade;     // 1 -> 0
        bot.group.position.y = bot.pos.y - (1 - f) * 0.3; // sink a touch
        if (f < 0.55 && bot.materials) {                  // fade during the last ~0.6s
          for (const m of bot.materials) { m.transparent = true; m.opacity = Math.max(0, f / 0.55); }
        }
        if (bot.deathTimer <= 0) { bot.dying = false; bot.group.visible = false; if (gameMode === 'br' && BR.active) { bot.respawnTimer = Infinity; brEliminate(bot.name); } else bot.respawnTimer = BOT_RESPAWN; }   // BR: bots get a single life
      } else {
        bot.respawnTimer -= dt;
        if (bot.respawnTimer <= 0) spawnBot(bot);
      }
      continue;
    }

    // Flinch/stagger timer (set when shot): briefly slows the bot.
    if (bot.flinch > 0) bot.flinch -= dt;
    // Muzzle-flash timer (improvement #2): hide the flash shortly after firing.
    if (bot.muzzleTimer > 0) { bot.muzzleTimer -= dt; if (bot.muzzleTimer <= 0 && bot.muzzle) bot.muzzle.visible = false; }

    const target = nearestHuman(bot) || player;   // nearest living human (local or remote)
    const sees = botCanSeePlayer(bot, target);
    if (sees) bot.lastKnown = target.pos.clone();
    const distToPlayer = target.alive ? bot.pos.distanceTo(target.pos) : Infinity;

    // --- State transitions -------------------------------------------------
    if (bot.health <= BOT_AI.lowHealth && (bot.state === 'ENGAGE' || sees)) {
      if (bot.state !== 'FLEE') { bot.state = 'FLEE'; bot.fleeTimer = BOT_AI.fleeTime; bot.coverPoint = botFindCover(bot); }
    }
    if (bot.state !== 'FLEE') {
      if (sees && distToPlayer < BOT_AI.shootRange) bot.state = 'ENGAGE';
      else if (bot.state === 'ENGAGE') { bot.state = 'INVESTIGATE'; bot.investigateTimer = BOT_AI.investigateTime; }
    }

    // --- Per-state behavior: produce a desired direction, speed, facing ----
    let desiredDir = new THREE.Vector3(), speed = 0;
    let faceTarget = null;   // a world point to look at (else face movement)

    if (bot.state === 'PATROL') {
      if (!bot.patrolTarget) bot.patrolTarget = botPatrolPoint();
      const flat = bot.patrolTarget.clone(); flat.y = bot.pos.y;
      if (bot.pos.distanceTo(flat) < 2.5) {
        // Arrived: pause and "look around" by slowly rotating, then pick a new point
        bot.pauseTimer -= dt;
        if (bot.pauseTimer <= 0) {
          if (Math.random() < 0.5) { bot.lookYaw = Math.random() * Math.PI * 2; bot.pauseTimer = BOT_AI.lookAroundTime; }
          else { bot.patrolTarget = botPatrolPoint(); bot.pauseTimer = 0; }
        }
      } else {
        desiredDir.subVectors(bot.patrolTarget, bot.pos); desiredDir.y = 0; desiredDir.normalize();
        speed = BOT_AI.patrolSpeed;
      }
    }
    else if (bot.state === 'INVESTIGATE') {
      bot.investigateTimer -= dt;
      const target = bot.lastKnown || bot.pos;
      if (bot.pos.distanceTo(target) > 2.5) {
        desiredDir.subVectors(target, bot.pos); desiredDir.y = 0; desiredDir.normalize();
        speed = BOT_AI.chaseSpeed * 0.8;
      } else {
        bot.lookYaw += dt * 2.2;        // search by spinning to look around
        bot.lookYaw %= Math.PI * 2;
      }
      if (bot.investigateTimer <= 0) { bot.state = 'PATROL'; bot.pauseTimer = 0; }
    }
    else if (bot.state === 'ENGAGE') {
      faceTarget = target.pos;
      const toP = new THREE.Vector3().subVectors(target.pos, bot.pos); toP.y = 0;
      const d = toP.length(); toP.normalize();
      // Keep a fighting distance band; strafe inside it
      bot.strafeTimer -= dt;
      if (bot.strafeTimer <= 0) { bot.strafeDir *= -1; bot.strafeTimer = BOT_AI.strafeInterval * (0.7 + Math.random()); }
      const strafe = rotateY(toP, Math.PI / 2 * bot.strafeDir);
      if (d > BOT_AI.shootRange * 0.8) desiredDir.add(toP);          // close in
      else if (d < 12) desiredDir.add(toP.clone().multiplyScalar(-1)); // back off
      desiredDir.add(strafe.multiplyScalar(0.9));                    // always juke
      if (desiredDir.lengthSq() > 0) desiredDir.normalize();
      speed = BOT_AI.engageSpeed;
      // Crouch/peek cycle: occasionally duck (lower + can't shoot), then pop up to fire
      bot.crouchTimer -= dt;
      if (bot.crouchTimer <= 0) {
        bot.crouching = !bot.crouching;
        bot.crouchTimer = BOT_AI.crouchMin + Math.random() * (BOT_AI.crouchMax - BOT_AI.crouchMin);
      }
      if (bot.crouching) speed *= 0.4;   // move less while ducked
    }
    else if (bot.state === 'FLEE') {
      bot.fleeTimer -= dt;
      faceTarget = target.pos;          // keep eyes on the threat while retreating
      const cover = bot.coverPoint || botFindCover(bot);
      if (bot.pos.distanceTo(cover) > 2) {
        desiredDir.subVectors(cover, bot.pos); desiredDir.y = 0; desiredDir.normalize();
        speed = BOT_AI.chaseSpeed;
      }
      if (bot.fleeTimer <= 0) { bot.state = sees ? 'ENGAGE' : 'INVESTIGATE'; bot.investigateTimer = BOT_AI.investigateTime; }
    }

    // --- Smooth, velocity-based motion with obstacle avoidance -------------
    if (bot.flinch > 0) speed *= 0.2;   // staggered: barely move while flinching
    if (bot.collapsed) speed = 0;        // legs blown off: can't move (still can shoot)
    desiredDir = botAvoid(bot, desiredDir);
    const maxDelta = BOT_AI.accel * dt;
    bot.vel.x = approach(bot.vel.x, desiredDir.x * speed, maxDelta);
    bot.vel.z = approach(bot.vel.z, desiredDir.z * speed, maxDelta);
    bot.pos.x += bot.vel.x * dt; bot.pos.z += bot.vel.z * dt; clampToMap(bot.pos, 2);   // map-aware (Nuketown arena or Paradise Island region)
    resolveHorizontal(bot.pos, 1.8);
    bot.pos.y = groundHeightAt(bot.pos.x, bot.pos.z, bot.pos.y + 0.4);

    // --- Facing (smoothly turn toward look target / movement) --------------
    let targetYaw = bot.yawFacing;
    if (faceTarget) targetYaw = Math.atan2(faceTarget.x - bot.pos.x, faceTarget.z - bot.pos.z);
    else if (speed > 0.1 && (bot.vel.x || bot.vel.z)) targetYaw = Math.atan2(bot.vel.x, bot.vel.z);
    else targetYaw = bot.lookYaw;
    let dYaw = targetYaw - bot.yawFacing;
    while (dYaw > Math.PI) dYaw -= Math.PI * 2;
    while (dYaw < -Math.PI) dYaw += Math.PI * 2;
    bot.yawFacing += dYaw * Math.min(1, dt * 8);

    // --- Animation: walk-bob, lean into travel, crouch (improvement: bot motion) ---
    const moveSpeed = Math.hypot(bot.vel.x, bot.vel.z);
    bot.bobPhase += dt * (6 + moveSpeed * 1.5);
    const bob = Math.sin(bot.bobPhase) * 0.05 * Math.min(1, moveSpeed / 2);
    const crouchTarget = bot.collapsed ? 1 : ((bot.state === 'ENGAGE' && bot.crouching) ? 1 : 0);
    bot.crouch += (crouchTarget - bot.crouch) * Math.min(1, dt * 10);
    bot.group.scale.y = 1 - (bot.collapsed ? 0.55 : 0.32) * bot.crouch;   // duck down / collapse low
    // lean: forward into travel + sideways toward the strafe direction
    const leanFwd = Math.min(0.14, moveSpeed * 0.018);
    const leanSide = (bot.state === 'ENGAGE') ? -bot.strafeDir * 0.10 * Math.min(1, moveSpeed / BOT_AI.engageSpeed) : 0;
    bot.group.position.set(bot.pos.x, bot.pos.y + bob, bot.pos.z);
    bot.group.rotation.set(leanFwd, bot.yawFacing, leanSide);

    // --- Shooting (only while engaged + still holding a gun) ----------------
    bot.shootCd -= dt;
    const canShoot = bot.state === 'ENGAGE' && sees && distToPlayer < BOT_AI.shootRange &&
                     bot.shootCd <= 0 && target.alive && bot.hasGun &&
                     bot.crouch < 0.5 && bot.flinch <= 0;   // peek up (not ducked/staggered) to fire
    if (canShoot) {
      const stat = BOT_LOADOUT.stats[bot.weaponKey] || BOT_LOADOUT.stats.pistol;
      bot.shootCd = stat.rate * (0.85 + Math.random() * 0.3);
      // Fire from the gun muzzle (falls back to chest height if no muzzle)
      const muzzlePos = bot.muzzle ? bot.muzzle.getWorldPosition(new THREE.Vector3())
                                   : new THREE.Vector3(bot.pos.x, bot.pos.y + 1.35, bot.pos.z);
      const plrEye = new THREE.Vector3(target.pos.x, target.pos.y + 1.2, target.pos.z);
      // Losing an arm makes aim worse (improvement #1)
      const wobble = BOT_AI.aimWobble * (bot.aimPenalty ? DISMEMBER.armAimPenalty : 1);
      const aimPt = plrEye.clone().add(new THREE.Vector3(
        (Math.random() - 0.5) * wobble * distToPlayer,
        (Math.random() - 0.5) * wobble * distToPlayer,
        (Math.random() - 0.5) * wobble * distToPlayer));
      spawnTracer(muzzlePos, aimPt, { color: TRACER.color.bot, life: TRACER.life.bot });  // dimmer enemy tracer
      if (bot.muzzle) { bot.muzzle.visible = true; bot.muzzleTimer = 0.05; }   // muzzle flash
      if (BR.active) brNoteGunshot(bot.pos.x, bot.pos.z);   // BR minimap: heard gunshot dot
      // Hit chance falls off with distance (and with a lost arm)
      let chance = Math.max(0.08, BOT_AI.baseAccuracy * (1 - distToPlayer / (BOT_AI.shootRange * 1.4)));
      if (bot.aimPenalty) chance *= 0.5;
      // If the shot is aimed at the LOCAL player and crosses their active saber blade, it's blocked
      // (deflected back out) instead of dealing damage.
      let deflected = false;
      if (target === player && saberCanDeflect()) {
        const bdir = aimPt.clone().sub(muzzlePos).normalize();
        const defl = saberDeflectRay(muzzlePos, bdir);
        if (defl) { saberDoDeflect(defl, stat.dmg); deflected = true; }
      }
      if (!deflected && Math.random() < chance) damageHuman(target, stat.dmg, muzzlePos);
    }
  }
}

/* ============================================================================
   7b. EFFECTS — blood particles, ground decals, floating combat text
   ============================================================================ */
// Blood particle pool (reused — modest count for perf). Small red boxes that
// fly out from the hit point, fall under gravity, and fade.
const bloodGeo = new THREE.BoxGeometry(0.14, 0.14, 0.14);
const bloodParticles = [];
for (let i = 0; i < 140; i++) {
  const m = new THREE.Mesh(bloodGeo, new THREE.MeshBasicMaterial({ color: 0xcc0000, transparent: true }));
  m.visible = false; scene.add(m);
  bloodParticles.push({ mesh: m, vel: new THREE.Vector3(), life: 0, maxLife: 0, active: false });
}
// Generic particle burst from the pool. color defaults to blood-red; the loot
// crate passes green. (Reuses the same pooled meshes — no allocation per hit.)
function spawnBlood(point, count, color) {
  let n = 0;
  for (const p of bloodParticles) {
    if (p.active) continue;
    p.active = true; p.mesh.visible = true; p.mesh.position.copy(point);
    p.mesh.material.color.setHex(color != null ? color : 0xcc0000);
    const sp = 4 + Math.random() * 5;
    p.vel.set((Math.random() - 0.5) * sp, Math.random() * sp * 0.8 + 1.5, (Math.random() - 0.5) * sp);
    p.maxLife = 0.4 + Math.random() * 0.35; p.life = p.maxLife;
    p.mesh.material.opacity = 1;
    p.mesh.scale.setScalar(0.6 + Math.random() * 0.9);
    if (++n >= count) break;
  }
}
function updateBlood(dt) {
  for (const p of bloodParticles) {
    if (!p.active) continue;
    p.life -= dt;
    if (p.life <= 0) { p.active = false; p.mesh.visible = false; continue; }
    p.vel.y -= 22 * dt;
    p.mesh.position.addScaledVector(p.vel, dt);
    p.mesh.material.opacity = Math.max(0, p.life / p.maxLife);
  }
}

// Lingering blood decal on the ground under a kill (fades over a few seconds).
const bloodDecals = [];
const decalGeo = new THREE.PlaneGeometry(2.2, 2.2);
function spawnBloodDecal(pos) {
  const mat = new THREE.MeshBasicMaterial({ color: 0x7a0000, transparent: true, opacity: 0.85, depthWrite: false });
  const d = new THREE.Mesh(decalGeo, mat);
  d.rotation.x = -Math.PI / 2;
  d.position.set(pos.x, groundHeightAt(pos.x, pos.z, 50) + 0.04, pos.z);
  scene.add(d);
  bloodDecals.push({ mesh: d, life: 4.5, maxLife: 4.5 });
}
function updateDecals(dt) {
  for (let i = bloodDecals.length - 1; i >= 0; i--) {
    const d = bloodDecals[i]; d.life -= dt;
    d.mesh.material.opacity = 0.85 * Math.max(0, d.life / d.maxLife);
    if (d.life <= 0) { scene.remove(d.mesh); d.mesh.material.dispose(); bloodDecals.splice(i, 1); }
  }
}

// Floating combat text (improvement #5): "+100" / "+140 HEADSHOT!" at a world
// point, projected to screen, rising and fading via CSS over ~1s.
const _proj = new THREE.Vector3();
function floatText(worldPos, text, color) {
  _proj.copy(worldPos).project(camera);
  if (_proj.z > 1) return;                                  // behind the camera
  const div = document.createElement('div');
  div.className = 'floatText'; div.textContent = text; div.style.color = color;
  div.style.left = (_proj.x * 0.5 + 0.5) * window.innerWidth + 'px';
  div.style.top = (-_proj.y * 0.5 + 0.5) * window.innerHeight + 'px';
  el('floatLayer').appendChild(div);
  requestAnimationFrame(() => { div.style.transform = 'translate(-50%,-190%)'; div.style.opacity = '0'; });
  setTimeout(() => div.remove(), 1050);
}

/* ============================================================================
   PART 3 — DAMAGE NUMBERS + KILLSTREAK ANNOUNCER (the "dopamine" layer).
   ============================================================================ */
// --- Floating damage numbers (stack rapid hits on the same target) ---
const _dmgNums = [];
function showDamageNumber(worldPos, dmg, headshot) {
  if (BR.active || !OPT.dmgNumbers || dmg <= 0) return;   // BR: no damage numbers
  _proj.copy(worldPos).project(camera); if (_proj.z > 1) return;
  const sx = (_proj.x * 0.5 + 0.5) * window.innerWidth, sy = (-_proj.y * 0.5 + 0.5) * window.innerHeight, now = performance.now();
  for (const d of _dmgNums) {   // merge into a recent nearby number (same target within 320ms)
    if (now - d.t < 320 && Math.abs(d.sx - sx) < 60 && Math.abs(d.sy - sy) < 60) {
      d.total += dmg; d.t = now; d.headshot = d.headshot || headshot; d.life = 0.85; d.sx = sx; d.sy = sy;
      d.el.textContent = Math.round(d.total);
      d.el.className = 'dmgNum' + (d.headshot ? ' hs' : (d.total >= 50 ? ' big' : ''));
      d.el.style.left = sx + 'px'; d.el.style.top = sy + 'px';
      d.el.style.transition = 'none'; d.el.style.transform = 'translate(-50%,-50%) scale(1.3)'; d.el.style.opacity = '1';
      requestAnimationFrame(() => { d.el.style.transition = 'transform .85s ease-out, opacity .85s ease-out'; d.el.style.transform = 'translate(-50%,-170%) scale(1)'; d.el.style.opacity = '0'; });
      return;
    }
  }
  const div = document.createElement('div');
  div.className = 'dmgNum' + (headshot ? ' hs' : (dmg >= 50 ? ' big' : ''));
  div.textContent = Math.round(dmg); div.style.left = sx + 'px'; div.style.top = sy + 'px';
  el('floatLayer').appendChild(div);
  requestAnimationFrame(() => { div.style.transform = 'translate(-50%,-170%)'; div.style.opacity = '0'; });
  _dmgNums.push({ el: div, sx, sy, total: dmg, t: now, headshot: !!headshot, life: 0.85 });
}
function updateDmgNums(dt) {
  for (let i = _dmgNums.length - 1; i >= 0; i--) { _dmgNums[i].life -= dt; if (_dmgNums[i].life <= 0) { _dmgNums[i].el.remove(); _dmgNums.splice(i, 1); } }
}

// --- Killstreak announcer (LOCAL player only): multi-kills (within 4s) + spree milestones ---
let _multiCount = 0, _multiLast = 0, _announceT = null;
const SPREE_TIERS = { 3: ['KILLING SPREE', 'hi'], 5: ['RAMPAGE', 'hi'], 7: ['DOMINATING', 'hi'], 10: ['UNSTOPPABLE', 'god'], 15: ['GODLIKE', 'god'], 20: ['WICKED SICK', 'god'], 25: ['M-M-M-MONSTER KILL', 'god'] };
const MULTI_TIERS = { 2: ['DOUBLE KILL', ''], 3: ['TRIPLE KILL', 'hi'], 4: ['MULTI KILL', 'hi'], 5: ['MONSTER KILL', 'hi'], 6: ['GODLIKE', 'god'], 7: ['UNSTOPPABLE', 'god'] };
function announceStreakKill() {
  const now = performance.now();
  _multiCount = (now - _multiLast < 4000) ? _multiCount + 1 : 1; _multiLast = now;
  const spree = SPREE_TIERS[STREAK.count];           // exact spree threshold this kill?
  if (spree) { showAnnouncer(spree[0], spree[1]); sfxAnnouncer(spree[1]); return; }
  if (_multiCount >= 2) { const m = MULTI_TIERS[Math.min(7, _multiCount)]; showAnnouncer(m[0], m[1]); sfxAnnouncer(m[1] || 'lo'); }
}
function announceReset() { _multiCount = 0; _multiLast = 0; }
function showAnnouncer(text, tier) {
  const e = el('announcer'); if (!e) return;
  e.textContent = text; e.className = tier === 'god' ? 'tier-god' : tier === 'hi' ? 'tier-hi' : '';
  void e.offsetWidth; e.classList.add('show');
  clearTimeout(_announceT); _announceT = setTimeout(() => e.classList.remove('show'), 1500);
}
// Synthesized deep "announcer voice" stinger (bass-heavy formant tones + reverb tail). Words are on screen.
function sfxAnnouncer(tier) {
  const base = tier === 'god' ? 70 : tier === 'hi' ? 86 : 104;
  SND.play2d((ctx, out, t) => {
    aTone(ctx, out, t, { type: 'sawtooth', f0: base, f1: base * 1.5, dur: 0.5, peak: 0.3, verb: 0.5 });
    aTone(ctx, out, t, { type: 'sine', f0: base / 2, dur: 0.6, peak: 0.34 });                                   // sub-bass
    aNoise(ctx, out, t, { dur: 0.5, peak: 0.12, filter: 'bandpass', freq: 700, freq1: 1500, q: 3, verb: 0.6 });   // vocal formant sweep
    aTone(ctx, out, t + 0.18, { type: 'square', f0: base * 2, f1: base * 1.2, dur: 0.35, peak: 0.15, verb: 0.4 });
    if (tier === 'god') aTone(ctx, out, t + 0.3, { type: 'sawtooth', f0: base * 3, f1: base * 4, dur: 0.4, peak: 0.18, verb: 0.6 });
  }, 'voice', 'announcer', 0.95, 0.95);
}

/* ============================================================================
   7c. EQUIPMENT — frag grenades (throw with G; bounce, fuse, blast)
   ============================================================================ */
const liveGrenades = [];
const explosions = [];
const grenadeGeo = new THREE.SphereGeometry(0.28, 8, 6);
const grenadeMat = new THREE.MeshLambertMaterial({ color: 0x2b2b2b, flatShading: true });
const explGeo = new THREE.SphereGeometry(1, 12, 10);

/* --- Tomahawk throwable: a spinning axe that one-shots on a direct hit --- */
const liveTomahawks = [];
function buildTomahawkMesh() {
  const g = new THREE.Group();
  const handle = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.07, 0.7), new THREE.MeshLambertMaterial({ color: 0x6b4326, flatShading: true }));
  const blade = new THREE.Mesh(new THREE.BoxGeometry(0.40, 0.34, 0.07), new THREE.MeshLambertMaterial({ color: 0xcfd6dd, flatShading: true }));
  blade.position.set(0.16, 0, 0.30);
  g.add(handle); g.add(blade);
  return g;
}
function throwTomahawk(pos, dir) {
  const mesh = buildTomahawkMesh();
  mesh.position.copy(pos); scene.add(mesh);
  const vel = dir.normalize().multiplyScalar(TOMAHAWK.throwVel); vel.y += TOMAHAWK.upArc;
  liveTomahawks.push({ mesh, pos: pos.clone(), vel, life: TOMAHAWK.life, spin: 0, stuck: false });
}
function updateTomahawks(dt) {
  const lim = ARENA - 1;
  let promptAxe = null;
  for (let i = liveTomahawks.length - 1; i >= 0; i--) {
    const t = liveTomahawks[i];
    const owned = t.owned !== false;                // remote-rendered copies don't deal damage
    t.life -= dt;
    if (t.stuck) {                                  // stuck in a surface/body: linger, allow pickup, then fade
      if (t.pickup && player.alive && lethalChoice === 'axe' && (player.lethals || 0) < LETHAL_MAX) {
        const d = t.pos.distanceTo(player.pos);
        if (d < 1.3) { axePickup(t, i); continue; }                // walk-over pickup (gain back one axe)
        else if (d < 2.8 && (!promptAxe || d < promptAxe)) promptAxe = d;
      }
      if (t.life <= 0) { scene.remove(t.mesh); disposeGroup(t.mesh); liveTomahawks.splice(i, 1); }
      continue;
    }
    t.vel.y -= TOMAHAWK.gravity * dt;
    t.pos.addScaledVector(t.vel, dt);
    t.spin += TOMAHAWK.spin * dt;
    t.mesh.position.copy(t.pos);
    t.mesh.rotation.set(t.spin, Math.atan2(t.vel.x, t.vel.z), 0);
    t._whT = (t._whT || 0) - dt; if (t._whT <= 0) { t._whT = 0.2; sfxAxeWhistle(t.pos); }   // spinning whistle in flight
    // --- Direct hit (owner only): bots (host adjudicates / client reports) + remote players ---
    let hit = false;
    if (owned) {
      for (const bot of bots) {
        if (!bot.alive) continue;
        const bp = new THREE.Vector3(bot.pos.x, bot.pos.y + 1.1, bot.pos.z);
        if (bp.distanceTo(t.pos) < TOMAHAWK.hitRadius) {
          spawnBlood(t.pos, 16);
          if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg: TOMAHAWK.damage, head: false, weapon: 'tomahawk', fromId: NET.selfId });
          else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, TOMAHAWK.damage, t.vel.clone().setY(0).normalize(), null, { weapon: 'tomahawk', dist: 4 }); if (NET.isHost) NET.botCredit = null; }
          showHitMarker(); sfxAxeHit(t.pos); hit = true; break;
        }
      }
      if (!hit && NET.active) NET.players.forEach(rp => {
        if (hit || !rp.alive) return;
        const pp = new THREE.Vector3(rp.pos.x, rp.pos.y + 1.1, rp.pos.z);
        if (pp.distanceTo(t.pos) < TOMAHAWK.hitRadius) { spawnBlood(t.pos, 16); NET.damageRemote(rp, TOMAHAWK.damage, false); showHitMarker(); sfxAxeHit(t.pos); hit = true; }
      });
    }
    if (hit) { t.stuck = true; t.pickup = false; t.life = 1.0; t.mesh.position.copy(t.pos); continue; }   // stick in the body briefly, no pickup off a corpse
    // --- Stick into the ground / walls / arena edges (then pickup-able for ~3s) ---
    const gh = groundHeightAt(t.pos.x, t.pos.z, t.pos.y);
    let land = false;
    if (t.pos.y < gh + 0.15) { t.pos.y = gh + 0.15; land = true; }
    if (Math.abs(t.pos.x) > lim || Math.abs(t.pos.z) > lim) land = true;
    for (const s of solids) {
      if (t.pos.y < s.max.y && t.pos.y > s.min.y &&
          t.pos.x > s.min.x && t.pos.x < s.max.x && t.pos.z > s.min.z && t.pos.z < s.max.z) { land = true; break; }
    }
    if (land || t.life <= 0) { t.stuck = true; t.pickup = true; t.life = 3.0; t.mesh.position.copy(t.pos); sfxAxeStick(t.pos); }
  }
  const ap = el('axePrompt'); if (ap) ap.style.display = (promptAxe != null && gameState.running) ? 'block' : 'none';
}
function axePickup(t, i) { scene.remove(t.mesh); disposeGroup(t.mesh); liveTomahawks.splice(i, 1); player.lethals = Math.min(LETHAL_MAX, (player.lethals || 0) + 1); sfxAxePickup(player.pos); updateHUD(); }
function tryPickupAxe() {   // E near a stuck axe also picks it up
  if (lethalChoice !== 'axe' || (player.lethals || 0) >= LETHAL_MAX) return false;
  for (let i = liveTomahawks.length - 1; i >= 0; i--) { const t = liveTomahawks[i]; if (t.stuck && t.pickup && t.pos.distanceTo(player.pos) < 2.8) { axePickup(t, i); return true; } }
  return false;
}
// LETHAL — Throwing Axe (reuses the spinning tomahawk model/physics) + networked render copies for peers.
function throwAxe(pos, dir) {
  const mesh = buildTomahawkMesh(); mesh.position.copy(pos); scene.add(mesh);
  const vel = dir.normalize().multiplyScalar(TOMAHAWK.throwVel); vel.y += TOMAHAWK.upArc;
  liveTomahawks.push({ mesh, pos: pos.clone(), vel, life: TOMAHAWK.life, spin: 0, stuck: false, owned: true, ownerId: NET.selfId, pickup: false });
  sfxAxeThrow(pos);
  if (NET.active) NET.broadcast({ t: 'axe', id: NET.selfId, x: pos.x, y: pos.y, z: pos.z, vx: vel.x, vy: vel.y, vz: vel.z });
}
function spawnRemoteAxe(pos, vel) {   // render-only copy a peer threw (no damage)
  const mesh = buildTomahawkMesh(); mesh.position.copy(pos); scene.add(mesh);
  liveTomahawks.push({ mesh, pos: pos.clone(), vel: vel.clone(), life: TOMAHAWK.life, spin: 0, stuck: false, owned: false, pickup: false });
}

// LETHAL — Smoke Grenade: a thrown canister that settles, erupts a synced view-blocking smoke cloud.
const liveSmokeNades = [], smokeClouds = [];
let _smokeTex = null;
function smokePuffTexture() {
  if (_smokeTex) return _smokeTex;
  const c = document.createElement('canvas'); c.width = c.height = 64; const x = c.getContext('2d');
  const g = x.createRadialGradient(32, 32, 2, 32, 32, 31); g.addColorStop(0, 'rgba(246,246,250,0.95)'); g.addColorStop(0.55, 'rgba(232,233,238,0.72)'); g.addColorStop(1, 'rgba(226,228,234,0)');
  x.fillStyle = g; x.fillRect(0, 0, 64, 64); _smokeTex = new THREE.CanvasTexture(c); return _smokeTex;
}
function buildSmokeCanister() {
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.09, 0.26, 10), new THREE.MeshLambertMaterial({ color: 0x2a2e34, flatShading: true })); g.add(body);
  const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.04, 10), new THREE.MeshLambertMaterial({ color: 0x6a6f76, flatShading: true })); cap.position.y = 0.15; g.add(cap);
  return g;
}
function throwSmoke(pos, dir) {
  const mesh = buildSmokeCanister(); mesh.position.copy(pos); scene.add(mesh);
  const vel = dir.normalize().multiplyScalar(26); vel.y += 6;
  liveSmokeNades.push({ mesh, pos: pos.clone(), vel, life: 6, restT: 0 });
  sfxSmokeThrow(pos);
}
function spawnSmokeCloud(center, networked) {
  const tex = smokePuffTexture(), parts = [];
  for (let i = 0; i < 32; i++) {
    const m = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0, depthWrite: false, fog: false }));
    const off = new THREE.Vector3((Math.random() - 0.5) * 9, Math.random() * 4, (Math.random() - 0.5) * 9);
    m.position.copy(center).add(off.clone().multiplyScalar(0.25)); m.scale.setScalar(3); scene.add(m);
    parts.push({ spr: m, base: center.clone(), off, sc: 6 + Math.random() * 4 });
  }
  smokeClouds.push({ parts, t: 0, dur: 18 });
  sfxSmokeHiss(center);
  if (networked && NET.active) NET.broadcast({ t: 'smoke', id: NET.selfId, x: center.x, y: center.y, z: center.z });
}
function updateSmokes(dt) {
  const lim = ARENA - 1, damp = 0.45;
  for (let i = liveSmokeNades.length - 1; i >= 0; i--) {
    const s = liveSmokeNades[i]; s.life -= dt; s.vel.y -= 30 * dt; s.pos.addScaledVector(s.vel, dt);
    const gh = groundHeightAt(s.pos.x, s.pos.z, s.pos.y); let resting = false;
    if (s.pos.y < gh + 0.13) { s.pos.y = gh + 0.13; if (s.vel.y < 0) { s.vel.y = -s.vel.y * damp; s.vel.x *= 0.6; s.vel.z *= 0.6; } if (Math.hypot(s.vel.x, s.vel.y, s.vel.z) < 1.4) resting = true; }
    s.pos.x = Math.max(-lim, Math.min(lim, s.pos.x)); s.pos.z = Math.max(-lim, Math.min(lim, s.pos.z));
    s.mesh.position.copy(s.pos); s.mesh.rotation.x += dt * 5;
    s.restT = resting ? s.restT + dt : 0;
    if (s.restT >= 1.0 || s.life <= 0) { scene.remove(s.mesh); disposeGroup(s.mesh); liveSmokeNades.splice(i, 1); spawnSmokeCloud(s.pos.clone().setY(gh + 0.8), true); }
  }
  for (let i = smokeClouds.length - 1; i >= 0; i--) {
    const c = smokeClouds[i]; c.t += dt;
    const erupt = Math.min(1, c.t / 2);                                  // form over ~2s
    const fade = c.t > 15 ? Math.max(0, 1 - (c.t - 15) / 3) : 1;          // hold to 15s, fade over 3s (18s total)
    for (const p of c.parts) { p.spr.position.copy(p.base).add(p.off.clone().multiplyScalar(0.25 + 0.75 * erupt)); p.spr.scale.setScalar(3 + (p.sc - 3) * erupt); p.spr.material.opacity = 0.88 * erupt * fade; }
    if (c.t >= c.dur) { for (const p of c.parts) { scene.remove(p.spr); p.spr.material.dispose(); } smokeClouds.splice(i, 1); }
  }
}
// LETHAL audio: throwing-axe (throw/whistle/stick/hit/pickup) + smoke (throw/hiss).
function sfxAxeThrow(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.18, peak: 0.36, filter: 'bandpass', freq: 900, freq1: 2200, q: 0.9 }); }, pos, 'weapons', 'axethrow', 0.7, 0.18); }
function sfxAxeWhistle(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 1700, f1: 1300, dur: 0.12, peak: 0.07 }); }, pos, 'weapons', 'axewh', 0.5, 0.1); }
function sfxAxeStick(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 320, f1: 140, dur: 0.08, peak: 0.32 }); aNoise(ctx, out, t, { dur: 0.07, peak: 0.3, filter: 'lowpass', freq: 1400 }); }, pos, 'weapons', 'axestick', 0.8, 0.1); }
function sfxAxeHit(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 150, f1: 60, dur: 0.12, peak: 0.4 }); aNoise(ctx, out, t, { dur: 0.1, peak: 0.4, filter: 'lowpass', freq: 650 }); }, pos, 'weapons', 'axehit', 0.9, 0.12); }
function sfxAxePickup(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'square', f0: 700, f1: 1100, dur: 0.06, peak: 0.18 }); }, pos, 'weapons', 'axepick', 0.6, 0.1); }
function sfxSmokeThrow(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.16, peak: 0.3, filter: 'bandpass', freq: 700, freq1: 1500, q: 0.8 }); }, pos, 'weapons', 'smokethrow', 0.6, 0.16); }
function sfxSmokeHiss(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 1.6, peak: 0.26, filter: 'highpass', freq: 3200, rate: 1.2 }); aNoise(ctx, out, t + 0.2, { dur: 1.2, peak: 0.16, filter: 'bandpass', freq: 2400, q: 0.6 }); }, pos, 'weapons', 'smokehiss', 0.8, 1.6); }

// How many throwables a fresh life carries (depends on the chosen throwable).
function throwMaxCarry() { return throwableType === 'tomahawk' ? TOMAHAWK.maxCarry : GRENADE.maxCarry; }

function throwGrenade() {
  if (!gameState.running || !player.alive || player.grenades <= 0) return;
  cigCancel();                                     // throwing cancels a cigar in progress
  player.grenades--;
  const origin = camera.getWorldPosition(new THREE.Vector3());
  const dir = camera.getWorldDirection(new THREE.Vector3());
  const pos = origin.clone().add(dir.clone().multiplyScalar(0.6));
  if (throwableType === 'tomahawk') { throwTomahawk(pos, dir.clone()); updateHUD(); return; }
  const mesh = new THREE.Mesh(grenadeGeo, grenadeMat);
  const vel = dir.multiplyScalar(GRENADE.throwVel); vel.y += GRENADE.upArc;   // forward + arc
  mesh.position.copy(pos); scene.add(mesh);
  liveGrenades.push({ mesh, pos, vel, fuse: GRENADE.fuseTime });   // fuse starts on throw
  updateHUD();
}

function updateGrenades(dt) {
  const r = 0.28, damp = GRENADE.bounceDamping, lim = ARENA - 1;
  for (let i = liveGrenades.length - 1; i >= 0; i--) {
    const g = liveGrenades[i];
    g.fuse -= dt;
    g.vel.y -= GRENADE.gravity * dt;
    g.pos.addScaledVector(g.vel, dt);
    // floor / standable surfaces
    const gh = groundHeightAt(g.pos.x, g.pos.z, g.pos.y);
    if (g.pos.y < gh + r) { g.pos.y = gh + r; if (g.vel.y < 0) { g.vel.y = -g.vel.y * damp; g.vel.x *= 0.8; g.vel.z *= 0.8; } }
    // walls / crates: reflect off solid sides
    for (const s of solids) {
      if (g.pos.y >= s.max.y - 0.02 || g.pos.y <= s.min.y) continue;
      if (g.pos.x > s.min.x - r && g.pos.x < s.max.x + r && g.pos.z > s.min.z - r && g.pos.z < s.max.z + r) {
        const penL = g.pos.x - (s.min.x - r), penR = (s.max.x + r) - g.pos.x;
        const penB = g.pos.z - (s.min.z - r), penF = (s.max.z + r) - g.pos.z;
        if (Math.min(penL, penR) < Math.min(penB, penF)) { g.pos.x += penL < penR ? -penL : penR; g.vel.x = -g.vel.x * damp; }
        else { g.pos.z += penB < penF ? -penB : penF; g.vel.z = -g.vel.z * damp; }
      }
    }
    // arena bounds
    if (g.pos.x < -lim) { g.pos.x = -lim; g.vel.x = -g.vel.x * damp; }
    if (g.pos.x >  lim) { g.pos.x =  lim; g.vel.x = -g.vel.x * damp; }
    if (g.pos.z < -lim) { g.pos.z = -lim; g.vel.z = -g.vel.z * damp; }
    if (g.pos.z >  lim) { g.pos.z =  lim; g.vel.z = -g.vel.z * damp; }
    g.mesh.position.copy(g.pos);
    if (g.fuse <= 0) { explodeGrenade(g); scene.remove(g.mesh); liveGrenades.splice(i, 1); }
  }
}

// Shared blast: area damage with linear falloff + limb dismemberment + player
// damage/shake. Used by grenades AND rockets. weaponTag flows into the kill feed.
function applyBlast(center, radius, maxDmg, weaponTag, opts) {
  opts = opts || {};
  const limbR = opts.limbRadius != null ? opts.limbRadius : DISMEMBER.grenadeLimbRadius;
  const limbC = opts.limbChance != null ? opts.limbChance : DISMEMBER.grenadeLimbChance;
  for (const bot of bots) {
    if (!bot.alive) continue;
    const bp = new THREE.Vector3(bot.pos.x, bot.pos.y + 1, bot.pos.z);
    const dist = bp.distanceTo(center);
    if (dist >= radius) continue;
    const dir = bp.clone().sub(center).setY(0);
    dir.lengthSq() < 1e-4 ? dir.set(1, 0, 0) : dir.normalize();
    const dmg = maxDmg * (1 - dist / radius);
    const dead = damageBot(bot, dmg, dir, null, { weapon: weaponTag, blast: true, dist });
    if (!dead && bot.alive && dist < limbR) {        // close blast tears off limbs
      for (const limb of ['armL', 'armR', 'legL', 'legR', 'head']) {
        const p = bot.parts[limb];
        if (p && !p.detached && Math.random() < limbC * (1 - dist / limbR)) {
          detachPart(bot, limb, dir);
          if (limb === 'head') { killBot(bot, dir, { dismembered: true, weapon: weaponTag }); break; }
        }
      }
    }
  }
  // Explosions are indiscriminate — they hurt attack dogs (and King Kong) in range too (host/solo).
  if (!NET.active || NET.isHost) {
    for (const dog of dogs) {
      if (!dog.alive || dog.dying) continue;
      const dd = new THREE.Vector3(dog.pos.x, dog.pos.y + 0.5, dog.pos.z).distanceTo(center);
      if (dd < radius) damageDog(dog, maxDmg * (1 - dd / radius));
    }
    for (const k of kongs) {
      if (!k.alive || k.dying) continue;
      const kd = new THREE.Vector3(k.pos.x, k.pos.y + 4.5, k.pos.z).distanceTo(center);
      if (kd < radius) damageKong(k, maxDmg * (1 - kd / radius), null);
    }
    for (const m of mckaylas) {
      if (!m.alive || m.dying) continue;
      const md = new THREE.Vector3(m.pos.x, m.pos.y + 0.8, m.pos.z).distanceTo(center);
      if (md < radius) damageMckayla(m, maxDmg * (1 - md / radius));   // explosions/bananas hurt Mckayla too
    }
  }
  const pe = new THREE.Vector3(player.pos.x, player.pos.y + 1, player.pos.z);
  const pdist = pe.distanceTo(center);
  if (player.alive && pdist < radius) hurtPlayer(maxDmg * (1 - pdist / radius), center);
  damageScooterRadius(center, radius, maxDmg);   // explosions damage the scooter too
  const shakeRange = opts.shakeRange != null ? opts.shakeRange : GRENADE.shakeRange;
  if (pdist < shakeRange) addShake((opts.shakeMag != null ? opts.shakeMag : 0.13) * (1 - pdist / shakeRange), 0.4);
}

// Spawn the expanding-sphere explosion FX (radius drives the final scale).
// Exploding fuel barrel (Part 3 / airfield): a shot barrel blasts + radius-damages nearby player & bots,
// and chain-detonates other barrels close by. Marked once so it can't re-explode.
function brExplodeBarrel(mesh) {
  if (!mesh || mesh.userData._exploded) return; mesh.userData._exploded = true;
  const c = mesh.getWorldPosition(new THREE.Vector3());
  spawnExplosionFX(c, 6, 0xff7a2a); addShake(0.12, 0.5); if (typeof sfxExplosion === 'function') sfxExplosion(c); else if (typeof sfxRocketBoom === 'function') sfxRocketBoom(c);
  const R = 7, MAXD = 95;
  if (player.alive && BR.active) { const d = player.pos.distanceTo(c); if (d < R) hurtPlayer(MAXD * (1 - d / R), c); }
  for (const b of bots) { if (b.alive && !b.dying) { const d = b.pos.distanceTo(c); if (d < R) { b.health -= MAXD * (1 - d / R); if (b.health <= 0) killBot(b, null, { barrel: true }); } } }
  mesh.visible = false;
  // chain-detonate neighbours after a short delay
  colliders.forEach(o => { if (o !== mesh && o.userData && o.userData.explosive && !o.userData._exploded && o.getWorldPosition(new THREE.Vector3()).distanceTo(c) < 4.5) setTimeout(() => brExplodeBarrel(o), 140 + Math.random() * 160); });
}
function spawnExplosionFX(center, radius, color) {
  const fx = new THREE.Mesh(explGeo, new THREE.MeshBasicMaterial({ color: color || 0xffa520, transparent: true, opacity: 0.9 }));
  fx.position.copy(center); scene.add(fx);
  explosions.push({ mesh: fx, life: 0.38, maxLife: 0.38, radius });
  const ed = camera.position.distanceTo(center);   // heavy rumble for a blast near the player
  if (ed < 22) GP.rumble(Math.min(1, 1.0 - ed / 28), Math.min(1, 0.85 - ed / 32), 380);
}

// Blue "force jump" energy ring that expands + fades at the player's feet on a saber leap.
const forceRings = [];
function spawnForceRing(pos) {
  const p = pos || player.pos;
  const m = new THREE.Mesh(new THREE.RingGeometry(0.3, 0.52, 24),
    new THREE.MeshBasicMaterial({ color: 0x5ab0ff, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthWrite: false }));
  m.rotation.x = -Math.PI / 2; m.position.set(p.x, p.y + 0.06, p.z);
  scene.add(m); forceRings.push({ m, life: 0.45, max: 0.45 });
}
function updateForceRings(dt) {
  for (let i = forceRings.length - 1; i >= 0; i--) {
    const r = forceRings[i]; r.life -= dt;
    if (r.life <= 0) { scene.remove(r.m); r.m.geometry.dispose(); r.m.material.dispose(); forceRings.splice(i, 1); continue; }
    const k = 1 - r.life / r.max, s = 1 + k * 5;
    r.m.scale.set(s, s, s); r.m.material.opacity = 0.85 * (1 - k);
  }
}

function explodeGrenade(g) {
  spawnExplosionFX(g.pos, GRENADE.blastRadius, 0xffa520);
  sfxExplosion('gl', g.pos);
  spawnBlood(g.pos, 8);
  applyBlast(g.pos, GRENADE.blastRadius, GRENADE.maxDamage, 'grenade', {});
}

function updateExplosions(dt) {
  for (let i = explosions.length - 1; i >= 0; i--) {
    const e = explosions[i]; e.life -= dt;
    const t = 1 - e.life / e.maxLife;
    e.mesh.scale.setScalar(0.5 + t * (e.radius || GRENADE.blastRadius) * 0.9);
    e.mesh.material.opacity = Math.max(0, 0.9 * (1 - t));
    if (e.life <= 0) { scene.remove(e.mesh); e.mesh.material.dispose(); explosions.splice(i, 1); }
  }
}

/* ============================================================================
   7d. ROCKET LAUNCHER projectiles (improvement #3) — physical rocket + trail
   ============================================================================ */
const liveRockets = [];
const rocketGeo = new THREE.CylinderGeometry(0.13, 0.13, 0.6, 8);
rocketGeo.rotateX(Math.PI / 2);                          // length along local +Z
const rocketBodyMat = new THREE.MeshLambertMaterial({ color: 0x222222, flatShading: true });
const flameGeo = new THREE.ConeGeometry(0.22, 0.7, 8);
flameGeo.rotateX(-Math.PI / 2);                          // flame points back along -Z

function fireRocket(origin, dir) {
  dir.normalize();
  const grp = new THREE.Group();
  const bodyM = new THREE.Mesh(rocketGeo, rocketBodyMat); grp.add(bodyM);
  const flameMat = new THREE.MeshBasicMaterial({ color: 0xff8a1a, transparent: true, opacity: 0.9 });
  const flame = new THREE.Mesh(flameGeo, flameMat); flame.position.z = -0.5; grp.add(flame);
  grp.position.copy(origin);
  grp.lookAt(origin.clone().add(dir));                   // orient +Z down the travel dir
  scene.add(grp);
  liveRockets.push({ grp, flameMat, pos: origin.clone(), dir: dir.clone(), vel: dir.clone().multiplyScalar(ROCKET.speed), life: ROCKET.life });
}

function updateRockets(dt) {
  const lim = ARENA - 1;
  const targets = colliders.concat(botMeshes());
  for (let i = liveRockets.length - 1; i >= 0; i--) {
    const rk = liveRockets[i];
    rk.life -= dt;
    const stepLen = rk.vel.length() * dt;
    // Look ahead this frame's travel for an impact
    const ray = new THREE.Raycaster(rk.pos, rk.dir, 0, stepLen + 0.3);
    const hits = ray.intersectObjects(targets, false);
    let detonate = false, point = null, directBot = null;
    if (hits.length) { detonate = true; point = hits[0].point.clone(); directBot = hits[0].object.userData.bot || null; }
    rk.pos.addScaledVector(rk.vel, dt);
    if (!detonate) {
      if (rk.pos.y <= groundHeightAt(rk.pos.x, rk.pos.z, rk.pos.y) + 0.15 ||
          Math.abs(rk.pos.x) > lim || Math.abs(rk.pos.z) > lim) { detonate = true; point = rk.pos.clone(); }
    }
    rk.grp.position.copy(point || rk.pos);
    if (rk.flameMat) rk.flameMat.opacity = 0.6 + Math.random() * 0.4;   // flicker
    if (detonate || rk.life <= 0) {
      explodeRocket(point || rk.pos, directBot, rk.dir);
      scene.remove(rk.grp); rk.flameMat.dispose();   // shared geo/body-mat are reused, only the flame mat is per-rocket
      liveRockets.splice(i, 1);
    }
  }
}

function explodeRocket(center, directBot, dir) {
  spawnExplosionFX(center, ROCKET.blastRadius, 0xffb030);
  sfxExplosion('big', center);
  spawnBlood(center, 10);
  // Direct hit = guaranteed kill on that bot
  if (directBot && directBot.alive) damageBot(directBot, 99999, dir, null, { weapon: 'rocket' });
  applyBlast(center, ROCKET.blastRadius, ROCKET.blastDamage, 'rocket',
             { limbRadius: ROCKET.limbRadius, limbChance: ROCKET.limbChance, shakeRange: ROCKET.shakeRange, shakeMag: ROCKET.shakeMag });
}

/* ============================================================================
   7e. GUN-GAME PROJECTILES — visible crossbow bolt / grenade / RPG rocket / thrown knife
   Each travels with real physics, collides with the world + entities, and is
   broadcast so other peers see it fly. The FIRER simulates hit detection (host
   applies bot/PvP damage directly; clients report it) exactly like the tomahawk;
   non-owned (network) copies are render-only.
   ============================================================================ */
const GG_PROJ = {
  bolt:    { speed: 90,  grav: 14, life: 5, hitR: 1.0, spin: 9,  stick: 0,   dmg: 50,    expl: false, boom: true, blastR: 5, blastDmg: 60, blastMin: 20 },   // EXPLOSIVE BOW: 50 direct impact + a 60→20 blast on impact (≈110 on a direct hit)
  grenade: { speed: 60,  grav: 26, life: 5, hitR: 1.3, spin: 14, stick: 0,   dmg: 99999, expl: true, blastR: 11, blastDmg: 150, smoke: 0x9aa0a0 },
  rocket:  { speed: 115, grav: 0,  life: 5, hitR: 1.3, spin: 0,  stick: 0,   dmg: 99999, expl: true, blastR: 14, blastDmg: 170, flame: true },
  knife:   { speed: 90,  grav: 13, life: 6, hitR: 0.9, spin: 26, stick: 3.0, dmg: 200,   expl: false }
};
const ggProjectiles = [];
const ggSmoke = [];                  // light smoke puffs for grenade/rocket trails
function spawnSmokePuff(pos, color, size, life) {
  const m = new THREE.Mesh(explGeo, new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.5 }));
  m.position.copy(pos); m.scale.setScalar(size); scene.add(m);
  ggSmoke.push({ mesh: m, life: life, maxLife: life, grow: size * 1.8 });
}
function updateSmoke(dt) {
  for (let i = ggSmoke.length - 1; i >= 0; i--) {
    const s = ggSmoke[i]; s.life -= dt;
    const k = 1 - s.life / s.maxLife;
    s.mesh.scale.addScalar(s.grow * dt);
    s.mesh.material.opacity = Math.max(0, 0.5 * (1 - k));
    if (s.life <= 0) { scene.remove(s.mesh); s.mesh.material.dispose(); ggSmoke.splice(i, 1); }
  }
}
// Build the distinct mesh for each projectile type (oriented so local +Z is "forward").
function buildProjMesh(type) {
  const g = new THREE.Group();
  const box = (x, y, z, sx, sy, sz, c, emissive) => {
    const mat = emissive ? new THREE.MeshBasicMaterial({ color: c }) : new THREE.MeshLambertMaterial({ color: c, flatShading: true });
    const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat); m.position.set(x, y, z); g.add(m); return m;
  };
  if (type === 'bolt') {
    box(0, 0, 0.0, 0.04, 0.04, 0.66, 0x4a3320);            // wooden shaft
    const head = new THREE.Mesh(new THREE.ConeGeometry(0.06, 0.16, 6), new THREE.MeshLambertMaterial({ color: 0x9aa4ad, flatShading: true }));
    head.rotation.x = Math.PI / 2; head.position.z = 0.40; g.add(head);   // arrowhead (forward +Z)
    box(0.05, 0, -0.30, 0.02, 0.10, 0.12, 0xe8e8e8);       // fletching
    box(-0.05, 0, -0.30, 0.02, 0.10, 0.12, 0xe8e8e8);
    box(0, 0.05, -0.30, 0.10, 0.02, 0.12, 0xe8e8e8);
  } else if (type === 'grenade') {
    const s = new THREE.Mesh(new THREE.SphereGeometry(0.12, 10, 8), new THREE.MeshLambertMaterial({ color: 0x2f3a22, flatShading: true })); g.add(s);
    box(0, 0, 0, 0.26, 0.05, 0.05, 0xe0c020);              // yellow stripe
  } else if (type === 'rocket') {
    box(0, 0, 0, 0.13, 0.13, 0.5, 0x5a6a3a);               // olive body
    const wh = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.24, 8), new THREE.MeshLambertMaterial({ color: 0x3a3a3a, flatShading: true }));
    wh.rotation.x = Math.PI / 2; wh.position.z = 0.36; g.add(wh);          // warhead
    [[0.11, 0], [-0.11, 0], [0, 0.11], [0, -0.11]].forEach(([fx, fy]) => box(fx, fy, -0.26, 0.04, 0.04, 0.16, 0x2a2a2a));  // fins
    const flame = new THREE.Mesh(flameGeo, new THREE.MeshBasicMaterial({ color: 0xffb030, transparent: true, opacity: 0.95 }));
    flame.position.z = -0.5; g.add(flame); g.userData.flame = flame;
    const light = new THREE.PointLight(0xffa030, 0.8, 7); light.position.z = -0.2; g.add(light);  // faint thrust light
  } else { // knife
    box(0, 0, 0.12, 0.03, 0.10, 0.34, 0xd6dde4);           // blade
    box(0, 0, -0.16, 0.05, 0.07, 0.16, 0x1c1c1c);          // handle
  }
  return g;
}
// Spawn a projectile. `owned` = I fired it (do hit detection); else it's a network render copy.
function spawnGGProjectile(type, pos, vel, owned, weaponKey) {
  const cfg = GG_PROJ[type]; if (!cfg) return;
  const mesh = buildProjMesh(type); mesh.position.copy(pos); scene.add(mesh);
  ggProjectiles.push({ type, cfg, mesh, pos: pos.clone(), vel: vel.clone(),
    life: cfg.life, spin: 0, owned: !!owned, stuck: false, weaponKey: weaponKey || type, trailT: 0 });
}
// Fire from the muzzle (local): spawn an owned projectile + broadcast a render copy to peers.
function fireGGProjectile(type, origin, dir) {
  const cfg = GG_PROJ[type];
  const vel = dir.clone().normalize().multiplyScalar(cfg.speed);
  if (type === 'grenade') vel.y += 6;                       // a little lob on the grenade
  spawnGGProjectile(type, origin, vel, true, currentWeaponKey);
  if (NET.active) NET.broadcast({ t: 'proj', pt: type, x: origin.x, y: origin.y, z: origin.z, vx: vel.x, vy: vel.y, vz: vel.z });
}
function ggProjExplode(p, center) {
  spawnExplosionFX(center, p.cfg.blastR, 0xffb030); spawnBlood(center, 10);
  sfxExplosion(p.type === 'rocket' ? 'big' : 'gl', center);   // everyone hears it (owned + network copies)
  if (!p.owned) return;                                     // network copies are visual-only
  // Damage falloff: linear from blastDmg (centre) to blastMin (edge). blastMin defaults to 0 (grenade/rocket
  // fade to nothing); the explosive bow sets blastMin=20 so its 60→20 edge damage matches the spec.
  const _bMin = p.cfg.blastMin || 0, ffall = dd => _bMin + (p.cfg.blastDmg - _bMin) * Math.max(0, 1 - dd / p.cfg.blastR);
  // Bots in radius (host applies; clients report each hit) — credited to this weapon.
  for (const bot of bots) {
    if (!bot.alive) continue;
    const d = Math.hypot(bot.pos.x - center.x, bot.pos.y + 1 - center.y, bot.pos.z - center.z);
    if (d >= p.cfg.blastR) continue;
    const dmg = ffall(d);
    if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg, head: false, weapon: p.weaponKey, fromId: NET.selfId });
    else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, dmg, new THREE.Vector3(0, 0, 1), null, { weapon: p.weaponKey, blast: true, dist: d }); if (NET.isHost) NET.botCredit = null; }
  }
  // Remote players in radius (PvP splash).
  if (NET.active) NET.players.forEach(rp => {
    if (!rp.alive) return;
    const d = Math.hypot(rp.pos.x - center.x, rp.pos.y + 1 - center.y, rp.pos.z - center.z);
    if (d < p.cfg.blastR) NET.damageRemote(rp, ffall(d), false, p.weaponKey, false);
  });
  // Self splash.
  const pd = Math.hypot(player.pos.x - center.x, player.pos.y + 1 - center.y, player.pos.z - center.z);
  if (player.alive && pd < p.cfg.blastR) hurtPlayer(ffall(pd), center);
  damageScooterRadius(center, p.cfg.blastR, p.cfg.blastDmg);
  addShake(0.18 * Math.max(0, 1 - pd / (p.cfg.blastR * 2)), 0.4);
}
function updateGGProjectiles(dt) {
  const lim = ARENA - 1;
  for (let i = ggProjectiles.length - 1; i >= 0; i--) {
    const p = ggProjectiles[i], cfg = p.cfg;
    p.life -= dt;
    if (p.stuck) { if (p.life <= 0) { scene.remove(p.mesh); disposeGroup(p.mesh); ggProjectiles.splice(i, 1); } continue; }

    p.vel.y -= cfg.grav * dt;
    p.pos.addScaledVector(p.vel, dt);
    p.spin += cfg.spin * dt;
    p.mesh.position.copy(p.pos);
    // Orientation: bolt/rocket point along travel (with a roll); knife/grenade tumble.
    if (p.type === 'bolt' || p.type === 'rocket') {
      p.mesh.lookAt(p.pos.clone().add(p.vel));
      p.mesh.rotateZ(p.spin);
      if (p.type === 'rocket' && p.mesh.userData.flame) p.mesh.userData.flame.material.opacity = 0.7 + Math.random() * 0.3;
    } else {
      p.mesh.rotation.set(p.spin, Math.atan2(p.vel.x, p.vel.z), 0);
    }
    // Trails
    p.trailT -= dt;
    if (p.trailT <= 0) {
      if (p.type === 'rocket') { spawnSmokePuff(p.pos, 0xb0b0b0, 0.4, 0.5); p.trailT = 0.03; }
      else if (p.type === 'grenade') { spawnSmokePuff(p.pos, cfg.smoke, 0.3, 0.4); p.trailT = 0.05; }
      else p.trailT = 1;
    }
    // Flight audio (positional, clamped): RPG engine hum / grenade whistle / knife spin / bolt whoosh.
    p.sfxT = (p.sfxT || 0) - dt;
    if (p.sfxT <= 0) {
      if (p.type === 'rocket') { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sawtooth', f0: 180, f1: 200, dur: 0.16, peak: 0.2 }); aNoise(ctx, out, t, { dur: 0.12, peak: 0.12, filter: 'lowpass', freq: 1400 }); }, p.pos, 'weapons', 'projfly', 0.5, 0.16); p.sfxT = 0.12; }
      else if (p.type === 'grenade') { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 1300, f1: 1000, dur: 0.16, peak: 0.1 }), p.pos, 'weapons', 'projfly', 0.4, 0.16); p.sfxT = 0.18; }
      else if (p.type === 'knife') { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 2400, f1: 3000, dur: 0.08, peak: 0.1 }), p.pos, 'weapons', 'projfly', 0.4, 0.08); p.sfxT = 0.1; }
      else { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.1, peak: 0.1, filter: 'bandpass', freq: 1600, q: 0.8 }), p.pos, 'weapons', 'projfly', 0.4, 0.1); p.sfxT = 0.16; }   // bolt whoosh
    }

    // --- Hit detection (owned only) — bots, then remote players ---
    let hitPoint = null;
    if (p.owned && !cfg.expl) {                              // direct-hit weapons (bolt, knife)
      for (const bot of bots) {
        if (!bot.alive) continue;
        if (Math.hypot(bot.pos.x - p.pos.x, bot.pos.y + 1.1 - p.pos.y, bot.pos.z - p.pos.z) < cfg.hitR) {
          spawnBlood(p.pos, 14);
          if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg: cfg.dmg, head: false, weapon: p.weaponKey, fromId: NET.selfId });
          else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, cfg.dmg, p.vel.clone().setY(0).normalize(), null, { weapon: p.weaponKey, dist: 4 }); if (NET.isHost) NET.botCredit = null; }
          showHitMarker(); hitPoint = p.pos.clone(); break;
        }
      }
      if (!hitPoint && NET.active) NET.players.forEach(rp => {
        if (hitPoint || !rp.alive) return;
        const chestY = rp.pos.y + 1.0 - 0.5 * (rp.cr || 0);   // crouched players sit lower
        if (Math.hypot(rp.pos.x - p.pos.x, chestY - p.pos.y, rp.pos.z - p.pos.z) < cfg.hitR) {
          spawnBlood(p.pos, 14); NET.damageRemote(rp, cfg.dmg, false, p.weaponKey, false); showHitMarker(); hitPoint = p.pos.clone();
        }
      });
    } else if (p.owned && cfg.expl) {                        // explosive proximity (grenade direct contact / rocket)
      for (const bot of bots) { if (bot.alive && Math.hypot(bot.pos.x - p.pos.x, bot.pos.y + 1.1 - p.pos.y, bot.pos.z - p.pos.z) < cfg.hitR) { hitPoint = p.pos.clone(); break; } }
      if (!hitPoint && NET.active) NET.players.forEach(rp => { if (!hitPoint && rp.alive && Math.hypot(rp.pos.x - p.pos.x, rp.pos.y + 1 - p.pos.y, rp.pos.z - p.pos.z) < cfg.hitR) hitPoint = p.pos.clone(); });
    }

    // --- World collision (ground / walls / arena edges) ---
    let world = false;
    const gh = groundHeightAt(p.pos.x, p.pos.z, p.pos.y);
    if (p.pos.y < gh + 0.1) { p.pos.y = gh + 0.1; world = true; }
    if (Math.abs(p.pos.x) > lim || Math.abs(p.pos.z) > lim) world = true;
    if (!world) for (const s of solids) {
      if (p.pos.y < s.max.y && p.pos.y > s.min.y && p.pos.x > s.min.x && p.pos.x < s.max.x && p.pos.z > s.min.z && p.pos.z < s.max.z) { world = true; break; }
    }

    const impact = hitPoint || (world ? p.pos.clone() : null);
    if (impact || p.life <= 0) {
      if (cfg.expl || cfg.boom) {                            // grenade / rocket / explosive bow → explode (bolt also applied its 50 direct above)
        ggProjExplode(p, impact || p.pos);
        scene.remove(p.mesh); disposeGroup(p.mesh); ggProjectiles.splice(i, 1);
      } else if (hitPoint || world) {                        // knife → stick for a moment
        p.stuck = true; p.life = cfg.stick; p.mesh.position.copy(p.pos); sfxImpact('stick', p.pos);   // solid thunk
      } else {                                               // lifetime ran out mid-air
        scene.remove(p.mesh); disposeGroup(p.mesh); ggProjectiles.splice(i, 1);
      }
    }
  }
}

/* ============================================================================
   7f. SECRET RC ROCKET LAUNCHER — a hidden easter-egg guided missile.
   Unlocked mid-match by typing "8888"; equipped with "0". Firing launches a
   steerable missile and hands the camera to its nose cam (the body stays put,
   fully vulnerable). Mouse steers; SHIFT boosts, CTRL brakes; LMB / contact /
   fuel-out detonates. Other peers see the exterior + flame trail and can shoot
   it down. Kills are tagged 🚀[RC] but do NOT advance gun-game level (Option A).
   ============================================================================ */
const RC = {
  launchSpeed: 10, cruiseSpeed: 20, boostSpeed: 30, brakeSpeed: 6,
  rampTime: 5,            // seconds to ramp launch -> cruise
  turnRate: 2.1,          // rad/s (~180° in ~1.5s)
  steerSens: 0.0016,      // mouse px -> turn
  maxFlight: 12,          // seconds of fuel
  boostDrain: 2,          // fuel multiplier while boosting
  killR: 4, blastR: 8, blastDmg: 60,   // explosion (lethal within killR; splash to blastR)
  ammo: 1                              // 1 rocket per 5-kill scorestreak activation
};
// Set true (e.g. from the dev console) to log the missile's pitch input→angle each steered frame.
let RC_DEBUG = false;
// Reused temps for the roll-locked heading matrix (avoid per-frame allocation churn).
const _rcZero = new THREE.Vector3(0, 0, 0), _rcWorldUp = new THREE.Vector3(0, 1, 0), _rcNegDir = new THREE.Vector3();
let rcEquipped = false;   // is the RC launcher the currently-held weapon?
let rcPrevWeapon = null;  // weapon to restore when un-equipping (gun or saber)
let rcActive = false;     // currently piloting a missile (body frozen + vulnerable)
let rcMissile = null;     // the local controlled missile
let rcCamLive = false;    // is the nose cam currently the rendered view?
let rcFade = 0, rcFadeMode = null, rcFadePeak = null;   // black-fade transition (in/out)
let rcSteerX = 0, rcSteerY = 0;   // accumulated mouse delta while piloting
const rcRemote = new Map();       // ownerId -> network render-only missile copy
const rcCam = new THREE.PerspectiveCamera(85, window.innerWidth / window.innerHeight, 0.1, 1000);
scene.add(rcCam);

// Unlock (only for the local player who typed the code) — toast + chime, persists this match.
// (The RC launcher is now deployed via the 5-kill scorestreak — see streakDeployRC() — so the
//  old typed-code unlock + "0" toggle have been removed.)

// Build the distinct sleek black/gray missile (local +Z = forward). Has a glowing nose
// camera lens, antennas, fins, a thruster flame, and a blinking light.
function buildRcMissileMesh() {
  const g = new THREE.Group();
  const box = (x, y, z, sx, sy, sz, c, emi) => {
    const mat = emi ? new THREE.MeshBasicMaterial({ color: c }) : new THREE.MeshLambertMaterial({ color: c, flatShading: true });
    const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat); m.position.set(x, y, z); g.add(m); return m;
  };
  box(0, 0, 0, 0.16, 0.16, 0.72, 0x2b2f36);            // sleek gunmetal body
  const nose = new THREE.Mesh(new THREE.ConeGeometry(0.11, 0.26, 10), new THREE.MeshLambertMaterial({ color: 0x4a505a, flatShading: true }));
  nose.rotation.x = Math.PI / 2; nose.position.z = 0.48; g.add(nose);   // nose
  box(0, 0.02, 0.42, 0.07, 0.05, 0.06, 0x12d0f0, true); // glowing nose camera lens
  box(0.05, 0.11, -0.2, 0.012, 0.2, 0.012, 0x9aa0a8);   // antennas
  box(-0.05, 0.11, -0.2, 0.012, 0.2, 0.012, 0x9aa0a8);
  [[0.12, 0], [-0.12, 0], [0, 0.12], [0, -0.12]].forEach(([fx, fy]) => box(fx, fy, -0.3, 0.03, 0.03, 0.18, 0x1a1d22));  // fins
  box(0, 0.09, 0.0, 0.03, 0.03, 0.03, 0xff3030, true);  // blinking light
  const flameMat = new THREE.MeshBasicMaterial({ color: 0x6cf0ff, transparent: true, opacity: 0.9 });
  const flame = new THREE.Mesh(flameGeo, flameMat); flame.position.z = -0.58; g.add(flame);
  g.userData.flameMat = flameMat;
  return g;
}

// Fire: consume a rocket, spawn the controlled missile, freeze the body, begin the
// fade-to-nose-cam handoff, and tell peers.
function rcTryLaunch() {
  if (!gameState.running || !player.alive || rcActive || rcFadeMode) return;
  const ws = weaponState.rcrl;
  if (ws.cooldown > 0 || ws.ammo <= 0) return;
  ws.ammo--; ws.cooldown = WEAPONS.rcrl.fireRate;
  // Firing CONSUMES the 5-kill scorestreak reward (one rocket only; pressing N again gives nothing).
  const rcTier = STREAK.tiers.find(t => t.id === 'rcrl'); if (rcTier) { rcTier.consumed = true; updateStreakHUD(); }
  const origin = gunMuzzleWorld();
  const dir = camera.getWorldDirection(new THREE.Vector3()).normalize();
  const grp = buildRcMissileMesh(); grp.position.copy(origin);
  grp.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir.clone());
  scene.add(grp);
  rcMissile = { grp, pos: origin.clone(), dir: dir.clone(), quat: grp.quaternion.clone(), speed: RC.launchSpeed,
                fuel: RC.maxFlight, flameMat: grp.userData.flameMat, age: 0, trailT: 0, netAcc: 0,
                // Absolute heading angles (single source of truth for steering). Roll is always
                // locked to world-up so "mouse up = climb" can never invert mid-flight.
                yaw: Math.atan2(dir.x, dir.z), pitch: Math.asin(Math.max(-1, Math.min(1, dir.y))) };
  if (gunMesh) gunMesh.position.z = -0.5;
  alertBots(player.pos);
  rcActive = true; rcSteerX = rcSteerY = 0;          // body freezes immediately (vulnerable)
  rcFade = 0; rcFadeMode = 'in'; rcFadePeak = () => { rcCamLive = true; };   // fade to black, then into the nose cam
  if (NET.active) NET.broadcast({ t: 'rc', s: 'spawn', id: NET.selfId, x: origin.x, y: origin.y, z: origin.z, dx: dir.x, dy: dir.y, dz: dir.z });
  updateHUD();
}

// Apply the missile blast (host-authoritative, weapon 'rcrl'). Direct hits = instant kill.
function rcApplyDamage(center, directBot, directRemote) {
  const wkey = 'rcrl', up = new THREE.Vector3(0, 0, 1);
  if (directBot && directBot.alive) {
    if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: directBot.id, dmg: 99999, head: false, weapon: wkey, fromId: NET.selfId });
    else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(directBot, 99999, up, null, { weapon: wkey }); if (NET.isHost) NET.botCredit = null; }
  }
  if (directRemote && directRemote.alive) NET.damageRemote(directRemote, 99999, false, wkey, false);
  for (const bot of bots) {
    if (!bot.alive || bot === directBot) continue;
    const d = Math.hypot(bot.pos.x - center.x, bot.pos.y + 1 - center.y, bot.pos.z - center.z);
    if (d >= RC.blastR) continue;
    let dmg = RC.blastDmg * (1 - d / RC.blastR); if (d < RC.killR) dmg = Math.max(dmg, 120);
    if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg, head: false, weapon: wkey, fromId: NET.selfId });
    else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, dmg, up, null, { weapon: wkey, blast: true, dist: d }); if (NET.isHost) NET.botCredit = null; }
  }
  if (NET.active) NET.players.forEach(rp => {
    if (!rp.alive || rp === directRemote) return;
    const d = Math.hypot(rp.pos.x - center.x, rp.pos.y + 1 - center.y, rp.pos.z - center.z);
    if (d >= RC.blastR) return;
    let dmg = RC.blastDmg * (1 - d / RC.blastR); if (d < RC.killR) dmg = Math.max(dmg, 120);
    NET.damageRemote(rp, dmg, false, wkey, false);
  });
  if (!NET.active || NET.isHost) for (const k of kongs) {   // RC rockets can hurt King Kong too
    if (!k.alive || k.dying) continue;
    const d = Math.hypot(k.pos.x - center.x, k.pos.y + 4.5 - center.y, k.pos.z - center.z);
    if (d < RC.blastR) damageKong(k, Math.max(RC.blastDmg * (1 - d / RC.blastR), d < RC.killR ? 120 : 0), (NET.active ? NET.selfId : 'solo'));
  }
  const pd = Math.hypot(player.pos.x - center.x, player.pos.y + 1 - center.y, player.pos.z - center.z);
  if (player.alive && pd < RC.blastR) hurtPlayer(RC.blastDmg * (1 - pd / RC.blastR), center);
  damageScooterRadius(center, RC.blastR, RC.blastDmg);
  addShake(0.2 * Math.max(0, 1 - pd / (RC.blastR * 2)), 0.4);
}

// Detonate the local controlled missile. `immediate` skips the fade (used on death).
function rcDetonate(center, directBot, directRemote, immediate) {
  if (!rcMissile) return;
  center = center || rcMissile.pos.clone();
  spawnExplosionFX(center, RC.blastR, 0x7ad8ff);
  spawnExplosionFX(center, RC.blastR * 0.6, 0xffb030);
  sfxExplosion('rc', center);   // big boom + electrical fizz tail
  spawnBlood(center, 10);
  rcApplyDamage(center, directBot, directRemote);
  if (NET.active) NET.broadcast({ t: 'rc', s: 'boom', id: NET.selfId, x: center.x, y: center.y, z: center.z });
  scene.remove(rcMissile.grp); disposeGroup(rcMissile.grp); rcMissile = null;
  if (immediate) { rcActive = false; rcCamLive = false; rcFade = 0; rcFadeMode = null; el('rcFade').style.opacity = 0; }   // death: respawn re-equips the loadout
  else { rcFadeMode = 'in'; rcFadePeak = () => { rcCamLive = false; rcActive = false; streakRcReturnWeapon(); }; }   // fade back to the body + drop the spent launcher
  updateHUD();
}

// Per-frame: fade transitions, flight, steering, collision, nose-cam follow, HUD readout.
function rcUpdate(dt) {
  if (rcFadeMode === 'in') {
    rcFade = Math.min(1, rcFade + dt / 0.1);
    if (rcFade >= 1) { rcFade = 1; if (rcFadePeak) rcFadePeak(); rcFadePeak = null; rcFadeMode = 'out'; }
  } else if (rcFadeMode === 'out') {
    rcFade = Math.max(0, rcFade - dt / 0.1);
    if (rcFade <= 0) { rcFade = 0; rcFadeMode = null; }
  }
  el('rcFade').style.opacity = rcFade;

  if (!rcMissile) return;
  const m = rcMissile, lim = ARENA - 1;
  m.age += dt;

  // Steering (only once the nose cam is live). DETERMINISTIC, single source of truth:
  //   * rcSteerY = accumulated mouse e.movementY this frame (browser: mouse UP => movementY < 0).
  //   * FIXED sign convention, hard-coded (no game-state / settings conditionals):
  //       mouse UP  (rcSteerY < 0) => pitch angle INCREASES => missile climbs.
  //       mouse RIGHT(rcSteerX > 0) => yaw decreases (turns right; same feel as before).
  // We integrate ABSOLUTE yaw/pitch and rebuild the heading every frame, with roll locked to
  // world-up. That removes the roll-drift that used to make pitch feel intermittently inverted.
  if (rcCamLive) {
    const maxTurn = RC.turnRate * dt;
    const dPitch = Math.max(-maxTurn, Math.min(maxTurn, (OPT.invertY ? rcSteerY : -rcSteerY) * RC.steerSens));   // mouse-up = climb (or invert via OPT.invertY)
    const dYaw   = Math.max(-maxTurn, Math.min(maxTurn, -rcSteerX * RC.steerSens));
    m.yaw += dYaw;
    m.pitch += dPitch;
    m.pitch = Math.max(-1.45, Math.min(1.45, m.pitch));   // ~±83°: keep clear of straight-up gimbal
    const cp = Math.cos(m.pitch);
    m.dir.set(Math.sin(m.yaw) * cp, Math.sin(m.pitch), Math.cos(m.yaw) * cp).normalize();
    // Orient the exterior mesh: +Z faces dir, up locked to world +Y (no roll). lookAt(0,-dir,up)
    // puts the matrix's +Z column on dir.
    m.quat.setFromRotationMatrix(new THREE.Matrix4().lookAt(
      _rcZero, _rcNegDir.copy(m.dir).negate(), _rcWorldUp));
    if (RC_DEBUG) console.log(`[RC] mouseY=${rcSteerY.toFixed(1)} sign=-1 dPitch=${dPitch.toFixed(4)} pitch=${m.pitch.toFixed(3)} dir.y=${m.dir.y.toFixed(3)}`);
  }
  rcSteerX = rcSteerY = 0;

  // Speed: ramp launch -> cruise; SHIFT boosts (2x fuel drain), CTRL brakes.
  let targetSpeed = RC.launchSpeed + (RC.cruiseSpeed - RC.launchSpeed) * Math.min(1, m.age / RC.rampTime);
  let drain = dt;
  if (rcCamLive && sprintDown()) { targetSpeed = RC.boostSpeed; drain = dt * RC.boostDrain; }
  else if (rcCamLive && keys['ControlLeft']) { targetSpeed = RC.brakeSpeed; }
  m.speed += (targetSpeed - m.speed) * Math.min(1, dt * 3);
  m.fuel -= drain;

  // Move + collision look-ahead (world + bots + remote players).
  const stepLen = m.speed * dt;
  const targets = colliders.concat(botMeshes());
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.avatar) rp.avatar.children.forEach(c => { if (c.userData && c.userData.remote) targets.push(c); }); });
  const ray = new THREE.Raycaster(m.pos, m.dir, 0, stepLen + 0.4);
  const hits = ray.intersectObjects(targets, false);
  let detonate = false, point = null, directBot = null, directRemote = null;
  if (hits.length) {
    detonate = true; point = hits[0].point.clone();
    const ud = hits[0].object.userData || {};
    directBot = ud.bot || null; directRemote = (ud.remote && ud.remote.alive) ? ud.remote : null;
  }
  m.pos.addScaledVector(m.dir, stepLen);
  if (!detonate) {
    const gh = groundHeightAt(m.pos.x, m.pos.z, m.pos.y);
    if (m.pos.y < gh + 0.15 || Math.abs(m.pos.x) > lim || Math.abs(m.pos.z) > lim) { detonate = true; point = m.pos.clone(); }
  }
  if (!detonate) for (const s of solids) {
    if (m.pos.y < s.max.y && m.pos.y > s.min.y && m.pos.x > s.min.x && m.pos.x < s.max.x && m.pos.z > s.min.z && m.pos.z < s.max.z) { detonate = true; point = m.pos.clone(); break; }
  }

  m.grp.position.copy(point || m.pos);
  m.grp.quaternion.copy(m.quat);
  // Hide the missile's own geometry from the OPERATOR once the nose cam is live, so nothing
  // (body, nose cone, flame) blocks the view. Other players still see their own exterior copy.
  m.grp.visible = !rcCamLive;
  if (m.flameMat) m.flameMat.opacity = 0.6 + Math.random() * 0.4;
  m.trailT -= dt; if (m.trailT <= 0) { spawnSmokePuff(m.pos, 0xb8c0c8, 0.35, 0.5); m.trailT = 0.04; }
  m.sfxT = (m.sfxT || 0) - dt; if (m.sfxT <= 0) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sawtooth', f0: 540, f1: 580, dur: 0.18, peak: 0.16 }), m.pos, 'weapons', 'rcfly', 0.5, 0.18); m.sfxT = 0.13; }   // engine whine

  // Nose cam: sit just ahead of the missile's nose looking down its heading (clean forward view).
  if (rcCamLive) {
    rcCam.position.copy(m.pos).addScaledVector(m.dir, 0.7);
    rcCam.lookAt(m.pos.clone().add(m.dir));
    el('rcAlt').textContent = Math.max(0, Math.round(m.pos.y));
    el('rcSpd').textContent = Math.round(m.speed);
    el('rcFuelBar').style.width = Math.max(0, m.fuel / RC.maxFlight * 100) + '%';
  }

  m.netAcc += dt;
  if (NET.active && m.netAcc >= 0.05) { m.netAcc = 0; NET.broadcast({ t: 'rc', s: 'move', id: NET.selfId, x: m.pos.x, y: m.pos.y, z: m.pos.z, dx: m.dir.x, dy: m.dir.y, dz: m.dir.z }); }

  if (detonate || m.fuel <= 0) rcDetonate(point || m.pos, directBot, directRemote, false);
}

// --- Network render-only copies of OTHER players' missiles (smoothed) ---
function rcRemoteSpawn(id, pos, dir) {
  rcRemoteCleanup(id);
  const grp = buildRcMissileMesh(); grp.position.copy(pos);
  grp.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), dir.clone().normalize());
  grp.userData.rcRemoteOwner = id;
  grp.traverse(o => { if (o.isMesh) o.userData.rcRemoteOwner = id; });   // so bullets can resolve a hit
  scene.add(grp);
  rcRemote.set(id, { grp, pos: pos.clone(), dir: dir.clone(), tpos: pos.clone(), tdir: dir.clone(), flameMat: grp.userData.flameMat, trailT: 0 });
}
function rcRemoteMove(id, pos, dir) {
  const o = rcRemote.get(id); if (!o) { rcRemoteSpawn(id, pos, dir); return; }
  o.tpos.copy(pos); o.tdir.copy(dir);
}
function rcRemoteBoom(id, center) {
  spawnExplosionFX(center, RC.blastR, 0x7ad8ff); spawnExplosionFX(center, RC.blastR * 0.6, 0xffb030); spawnBlood(center, 8);
  rcRemoteCleanup(id);
}
function rcRemoteCleanup(id) { const o = rcRemote.get(id); if (o) { scene.remove(o.grp); disposeGroup(o.grp); rcRemote.delete(id); } }
function updateRcRemote(dt) {
  rcRemote.forEach(o => {
    o.pos.lerp(o.tpos, Math.min(1, dt * 14)); o.dir.lerp(o.tdir, Math.min(1, dt * 14)); o.dir.normalize();
    o.grp.position.copy(o.pos); o.grp.lookAt(o.pos.clone().add(o.dir));
    if (o.flameMat) o.flameMat.opacity = 0.6 + Math.random() * 0.4;
    o.trailT -= dt; if (o.trailT <= 0) { spawnSmokePuff(o.pos, 0xb8c0c8, 0.3, 0.45); o.trailT = 0.05; }
    o.sfxT = (o.sfxT || 0) - dt; if (o.sfxT <= 0) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sawtooth', f0: 540, f1: 580, dur: 0.18, peak: 0.16 }), o.pos, 'weapons', 'rcfly', 0.5, 0.18); o.sfxT = 0.13; }   // engine whine
  });
}

// Reset all RC state for a fresh match / leaving to the menu (RC is now a streak reward).
function rcResetMatch() {
  rcEquipped = false; rcActive = false; rcCamLive = false;
  rcFade = 0; rcFadeMode = null; rcFadePeak = null; rcPrevWeapon = null; rcSteerX = rcSteerY = 0;
  if (rcMissile) { scene.remove(rcMissile.grp); disposeGroup(rcMissile.grp); rcMissile = null; }
  rcRemote.forEach(o => { scene.remove(o.grp); disposeGroup(o.grp); }); rcRemote.clear();
  weaponState.rcrl.ammo = 0; weaponState.rcrl.cooldown = 0;
  el('rcHud').classList.remove('on'); el('rcFade').style.opacity = 0;
}

/* ============================================================================
   7f. IMPULSE GRENADES (gun-game tactical equipment) — Fortnite-style kinetic
   launcher. A bright cyan canister STICKS to the first surface it touches (wall,
   floor, ceiling, fence, or a player), activates FAST, then violently launches
   every nearby player (incl. the thrower) away from its center for mobility.
   Deals NO direct damage. The host validates who's in radius and routes each
   affected player an impulse vector to apply to their own velocity.
   ============================================================================ */
const IMPULSE = { maxCarry: 4, throwVel: 30, upArc: 6.5, gravity: 30,
                  settleFuse: 0.3,   // detonate 0.3s after STICKING
                  maxAir: 1.5,       // ...or auto-detonate 1.5s after the throw if it never sticks (edge case)
                  charge: 0.2,       // glow brightens over the final 0.2s
                  radius: 6,         // launch radius
                  velNear: 50, velMid: 35, velEdge: 18,   // launch speed by distance band (0-1u / 3u / 6u)
                  upFrac: 0.6,       // upward component = 60% of the horizontal launch speed
                  grace: 4.0 };      // post-launch fall-damage immunity window
const liveImpulses = [];      // thrown canisters (owned = I simulate physics; else network render copy)
let impulseThrowT = 0;        // brief throw animation / re-throw guard
const impulseRingGeo = new THREE.TorusGeometry(1, 0.12, 8, 24);   // expanding shockwave ring (scaled up)
function throwImpulse() {
  if (!gameState.running || !player.alive || player.impulses <= 0 || impulseThrowT > 0 || player.onLadder) return;
  cigCancel();                                                  // throwing cancels (and consumes) a cigar in progress
  player.impulses--; impulseThrowT = 0.4;                       // quick throw, ~400ms anim/guard
  const origin = camera.getWorldPosition(new THREE.Vector3()).add(camera.getWorldDirection(new THREE.Vector3()).multiplyScalar(0.6));
  const dir = camera.getWorldDirection(new THREE.Vector3());
  const vel = dir.multiplyScalar(IMPULSE.throwVel); vel.y += IMPULSE.upArc;   // slight forward arc (easy throw-at-feet)
  spawnImpulse(origin, vel, true, NET.selfId);
  sfxImpulseThrow(origin);                                      // whoosh + cylinder rattle
  if (gunMesh) gunMesh.position.z = -0.35;                      // little throw pop on the viewmodel
  if (NET.active) NET.broadcast({ t: 'imp', s: 'spawn', id: NET.selfId, x: origin.x, y: origin.y, z: origin.z, vx: vel.x, vy: vel.y, vz: vel.z });
  updateHUD();
}
// H: throw the player's chosen LETHAL (smoke grenade or throwing axe). 2 per life.
function throwLethal() {
  if (!gameState.running || !player.alive || (player.lethals || 0) <= 0 || player.onLadder || cigSmoking) return;
  player.lethals--;
  const origin = camera.getWorldPosition(new THREE.Vector3()).add(camera.getWorldDirection(new THREE.Vector3()).multiplyScalar(0.6));
  const dir = camera.getWorldDirection(new THREE.Vector3());
  if (lethalChoice === 'axe') throwAxe(origin, dir.clone());
  else throwSmoke(origin, dir.clone());
  if (gunMesh) gunMesh.position.z = -0.35;                      // throw pop on the viewmodel
  updateHUD();
}
// Bright cyan canister with glowing accent rings (kept distinct from any frag grenade).
function buildImpulseCan() {
  const g = new THREE.Group();
  g.add(new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.34, 10), new THREE.MeshLambertMaterial({ color: 0x0e2a3a, flatShading: true })));
  const glowMat = new THREE.MeshBasicMaterial({ color: 0x32e0ff });
  const r1 = new THREE.Mesh(new THREE.CylinderGeometry(0.115, 0.115, 0.08, 10), glowMat); r1.position.y = 0.05; g.add(r1);
  const r2 = new THREE.Mesh(new THREE.CylinderGeometry(0.115, 0.115, 0.05, 10), glowMat); r2.position.y = -0.09; g.add(r2);
  const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.05, 10), new THREE.MeshLambertMaterial({ color: 0xbfeaff, flatShading: true })); cap.position.y = 0.19; g.add(cap);
  g.userData.glow = glowMat;
  return g;
}
function spawnImpulse(pos, vel, owned, ownerId) {
  const mesh = buildImpulseCan(); mesh.position.copy(pos); scene.add(mesh);
  liveImpulses.push({ mesh, pos: pos.clone(), vel: vel.clone(), owned: !!owned, ownerId: ownerId || null,
                      stuck: false, fuse: IMPULSE.settleFuse, air: 0, spin: 0, whined: false,
                      follow: null, followId: null, followOff: new THREE.Vector3() });
}
// Reference position of a follow target (entity the grenade is stuck to), or null if gone.
function impulseFollowPos(f) {
  if (!f || !f.ref) return null;
  if (f.kind === 'self') return player.alive ? player.pos : null;
  return f.ref.alive ? f.ref.pos : null;
}
// Resolve a follow id received over the network to a local entity (bot / remote / self).
function impulseResolveFollow(fid) {
  if (!fid) return null;
  if (fid === NET.selfId) return { kind: 'self', ref: player, id: fid };
  if (fid.indexOf('bot') === 0) { const b = bots.find(x => ('bot' + x.id) === fid); return b ? { kind: 'bot', ref: b, id: fid } : null; }
  const rp = NET.players.get(fid); return rp ? { kind: 'remote', ref: rp, id: fid } : null;
}
// Orient the canister so its long (local +Y) axis aligns with the surface normal (sits flush).
function impulseOrient(mesh, normal) { mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal); }
// Stick the canister in place against `normal`, optionally following a moving entity.
function impulseStick(c, point, normal, follow) {
  c.stuck = true; c.pos.copy(point); c.vel.set(0, 0, 0); c.fuse = IMPULSE.settleFuse;
  sfxImpulseStick(point);   // solid magnetic CLUNK
  impulseOrient(c.mesh, normal); c.mesh.position.copy(point);
  if (follow) { c.follow = follow; c.followId = follow.id; const a = impulseFollowPos(follow); if (a) c.followOff.copy(point).sub(a); }
  if (c.owned && NET.active) NET.broadcast({ t: 'imp', s: 'stick', id: c.ownerId, x: point.x, y: point.y, z: point.z, nx: normal.x, ny: normal.y, nz: normal.z, fid: c.followId || null });
  return true;
}
// First-contact test: stick to a player (follow), then ground / fence / solids (6 faces).
function impulseTryStick(c, r, lim) {
  for (const bot of bots) {                        // bots
    if (!bot.alive) continue;
    if (Math.hypot(c.pos.x - bot.pos.x, c.pos.y - (bot.pos.y + 1.0), c.pos.z - bot.pos.z) < 1.0) {
      const n = new THREE.Vector3(c.pos.x - bot.pos.x, 0, c.pos.z - bot.pos.z); if (n.lengthSq() < 1e-4) n.set(0, 0, 1); n.normalize();
      return impulseStick(c, c.pos.clone(), n, { kind: 'bot', ref: bot, id: 'bot' + bot.id });
    }
  }
  if (NET.active) for (const rp of NET.players.values()) {   // remote players
    if (!rp.alive) continue;
    if (Math.hypot(c.pos.x - rp.pos.x, c.pos.y - (rp.pos.y + 1.0), c.pos.z - rp.pos.z) < 1.0) {
      const n = new THREE.Vector3(c.pos.x - rp.pos.x, 0, c.pos.z - rp.pos.z); if (n.lengthSq() < 1e-4) n.set(0, 0, 1); n.normalize();
      return impulseStick(c, c.pos.clone(), n, { kind: 'remote', ref: rp, id: rp.id });
    }
  }
  const gh = groundHeightAt(c.pos.x, c.pos.z, c.pos.y);         // floor
  if (c.pos.y <= gh + r) return impulseStick(c, new THREE.Vector3(c.pos.x, gh + r, c.pos.z), new THREE.Vector3(0, 1, 0), null);
  if (c.pos.x <= -lim) return impulseStick(c, new THREE.Vector3(-lim, c.pos.y, c.pos.z), new THREE.Vector3(1, 0, 0), null);   // arena fence
  if (c.pos.x >= lim)  return impulseStick(c, new THREE.Vector3(lim, c.pos.y, c.pos.z),  new THREE.Vector3(-1, 0, 0), null);
  if (c.pos.z <= -lim) return impulseStick(c, new THREE.Vector3(c.pos.x, c.pos.y, -lim), new THREE.Vector3(0, 0, 1), null);
  if (c.pos.z >= lim)  return impulseStick(c, new THREE.Vector3(c.pos.x, c.pos.y, lim),  new THREE.Vector3(0, 0, -1), null);
  for (const s of solids) {                                    // walls / crates / roofs / ceilings (closest face)
    if (c.pos.x > s.min.x - r && c.pos.x < s.max.x + r && c.pos.y > s.min.y - r && c.pos.y < s.max.y + r && c.pos.z > s.min.z - r && c.pos.z < s.max.z + r) {
      const dxn = c.pos.x - (s.min.x - r), dxp = (s.max.x + r) - c.pos.x, dyn = c.pos.y - (s.min.y - r), dyp = (s.max.y + r) - c.pos.y, dzn = c.pos.z - (s.min.z - r), dzp = (s.max.z + r) - c.pos.z;
      const m = Math.min(dxn, dxp, dyn, dyp, dzn, dzp);
      const p = c.pos.clone(), n = new THREE.Vector3();
      if (m === dxn) { p.x = s.min.x - r; n.set(-1, 0, 0); } else if (m === dxp) { p.x = s.max.x + r; n.set(1, 0, 0); }
      else if (m === dyn) { p.y = s.min.y - r; n.set(0, -1, 0); } else if (m === dyp) { p.y = s.max.y + r; n.set(0, 1, 0); }
      else if (m === dzn) { p.z = s.min.z - r; n.set(0, 0, -1); } else { p.z = s.max.z + r; n.set(0, 0, 1); }
      return impulseStick(c, p, n, null);
    }
  }
  return false;
}
function updateImpulses(dt) {
  const lim = ARENA - 1, r = 0.16;
  for (let i = liveImpulses.length - 1; i >= 0; i--) {
    const c = liveImpulses[i]; c.air += dt;
    if (!c.stuck) {
      c.vel.y -= IMPULSE.gravity * dt;
      c.pos.addScaledVector(c.vel, dt); c.spin += dt * 7;
      c.mesh.position.copy(c.pos); c.mesh.rotation.set(c.spin, 0, c.spin * 0.7);
      if (c.owned) impulseTryStick(c, r, lim);   // owned canister is authoritative; copies snap on the 'stick' message
    } else {
      if (c.follow) { const a = impulseFollowPos(c.follow); if (a) { c.pos.copy(a).add(c.followOff); c.mesh.position.copy(c.pos); } }   // follow a moving body
      c.fuse -= dt;
    }
    // Charge / flashing cue on the glow rings.
    if (c.mesh.userData.glow) {
      const g = c.mesh.userData.glow;
      if (c.stuck && c.fuse <= IMPULSE.charge) {                // final 0.2s: ramp to white + swell
        const k = Math.max(0, Math.min(1, 1 - c.fuse / IMPULSE.charge));
        g.color.setRGB(0.196 + 0.804 * k, 0.878 + 0.122 * k, 1.0); c.mesh.scale.setScalar(1 + 0.5 * k);
        if (!c.whined) { c.whined = true; sfxImpulseCharge(c.pos); }   // rising electronic charge-up whine (positional)
      } else if (c.stuck) {                                     // stuck & armed: flashing beacon
        const f = 0.5 + 0.5 * Math.sin(c.air * 18);
        g.color.setRGB(0.10 + 0.10 * f, 0.55 + 0.33 * f, 1.0); c.mesh.scale.setScalar(1);
      }
    }
    const boom = (c.stuck && c.fuse <= 0) || (c.air >= IMPULSE.maxAir);
    if (c.owned && boom) {
      const center = c.pos.clone();
      if (NET.active && !NET.isHost) { impulseDetonate(center, false); NET.route(NET.hostId, { t: 'imp', s: 'boom', id: NET.selfId, x: center.x, y: center.y, z: center.z }); }
      else { impulseDetonate(center, true); if (NET.active) NET.broadcast({ t: 'imp', s: 'boom', id: NET.selfId, x: center.x, y: center.y, z: center.z }); }
      scene.remove(c.mesh); disposeGroup(c.mesh); liveImpulses.splice(i, 1);
    } else if (!c.owned && c.air > IMPULSE.maxAir + 2) {   // safety: drop a network copy if its boom message was lost
      scene.remove(c.mesh); disposeGroup(c.mesh); liveImpulses.splice(i, 1);
    }
  }
}
// Bright cyan kinetic shockwave VFX (no fire — visually distinct from RPG/GL explosions).
function spawnImpulseFX(center) {
  const sph = new THREE.Mesh(explGeo, new THREE.MeshBasicMaterial({ color: 0x4fe3ff, transparent: true, opacity: 0.8 }));
  sph.position.copy(center); scene.add(sph);
  explosions.push({ mesh: sph, life: 0.4, maxLife: 0.4, radius: IMPULSE.radius });
  const ring = new THREE.Mesh(impulseRingGeo, new THREE.MeshBasicMaterial({ color: 0x9cf2ff, transparent: true, opacity: 0.9, side: THREE.DoubleSide }));
  ring.position.copy(center); ring.rotation.x = Math.PI / 2; scene.add(ring);
  explosions.push({ mesh: ring, life: 0.5, maxLife: 0.5, radius: IMPULSE.radius * 1.3 });
}
// Launch speed by distance band: 50 (≤1u) → 35 (3u) → 18 (edge 6u).
function impulseSpeedAt(d) {
  if (d <= 1) return IMPULSE.velNear;
  if (d <= 3) return IMPULSE.velNear + (IMPULSE.velMid - IMPULSE.velNear) * (d - 1) / 2;
  return Math.max(IMPULSE.velEdge, IMPULSE.velMid + (IMPULSE.velEdge - IMPULSE.velMid) * (d - 3) / 3);
}
// Velocity to fling a body at (px,py,pz) away from the grenade center (+60% upward).
function impulseVecFor(px, py, pz, center) {
  const dx = px - center.x, dz = pz - center.z;
  const d3 = Math.hypot(dx, py - center.y, dz);
  const sp = impulseSpeedAt(Math.min(IMPULSE.radius, d3));
  const horiz = new THREE.Vector3(dx, 0, dz); const hl = horiz.length();
  if (hl < 0.4) return new THREE.Vector3(0, sp, 0);   // ~directly above the grenade (feet self-throw) -> straight up
  horiz.divideScalar(hl);
  return new THREE.Vector3(horiz.x * sp, sp * IMPULSE.upFrac, horiz.z * sp);
}
// Apply an impulse velocity to the LOCAL player (keeps look/fire control; carries through the air).
function applyImpulseVec(v) {
  if (!player.alive) return;
  player.vel.x += v.x; player.vel.z += v.z;
  player.vel.y = Math.max(player.vel.y, 0) + v.y;
  player.onGround = false; player.jumps = 1; player.sliding = false; player.diving = false;
  player.impulseT = 1.2;                // don't speed-clamp the (now stronger) launch for ~1.2s
  player.impulseGrace = IMPULSE.grace;  // suppress impulse-fall damage for 4s (no fall-damage system yet, but future-proof)
  sfxLaunched(playerEarPos());          // gust/whoosh as you're flung through the air
}
// Detonate: spawn the shockwave VFX everywhere; the AUTHORITY (host/solo) launches each player in radius.
function impulseDetonate(center, doLaunches) {
  spawnImpulseFX(center);
  sfxImpulseBoom(center);   // kinetic SHWHOOM + electric crackle (everyone hears it positionally)
  const pe = new THREE.Vector3(player.pos.x, player.pos.y + 0.9, player.pos.z);
  const pdist = pe.distanceTo(center);
  if (pdist < IMPULSE.radius * 1.5) addShake(0.12 * (1 - pdist / (IMPULSE.radius * 1.5)), 0.35);
  if (!doLaunches) return;
  // Local player in radius -> launch (no damage).
  if (player.alive && pdist <= IMPULSE.radius) applyImpulseVec(impulseVecFor(player.pos.x, player.pos.y + 0.9, player.pos.z, center));
  // Remote players in radius -> route each an impulse vector (they apply it to their own velocity).
  if (NET.active && NET.isHost) NET.players.forEach(rp => {
    if (!rp.alive) return;
    const d = Math.hypot(rp.pos.x - center.x, rp.pos.y + 0.9 - center.y, rp.pos.z - center.z);
    if (d > IMPULSE.radius) return;
    const v = impulseVecFor(rp.pos.x, rp.pos.y + 0.9, rp.pos.z, center);
    NET.route(rp.id, { t: 'impulse', vx: v.x, vy: v.y, vz: v.z });
  });
}

/* ============================================================================
   7g. CIGAR HEAL (press Q) — light up a fat cigar held in the left hand to recover
   HP smoothly over ~3s (~33%/s). Holsters the weapon (can't fire/ADS/melee), 80%
   move speed, and CANCELS (and is consumed) on fire / weapon-switch / reload /
   grenade / dive. Other players see the smoking tell on the third-person avatar.
   ============================================================================ */
const CIGAR = { maxCarry: 3, dur: 3.0, raise: 0.4, lowerFast: 0.25 };
let cigSmoking = false;        // a cigar use is in progress (raise→light→hold→lower)
let cigCanceling = false;      // an interrupt triggered: quick-lower then finish
let cigT = 0, cigLowerT = 0, cigPuffT = 0, _cigAudioPuffT = 0;
let _cigVM = null;

// Build the first-person left-hand + cigar viewmodel (lower-left), attached to the camera.
function buildCigarVM() {
  const g = new THREE.Group();
  const skin = new THREE.MeshLambertMaterial({ color: 0xc98f5a, flatShading: true });   // default skin-tone hand
  // Left hand: palm + fingers curled to hold the cigar between index & middle.
  const palm = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.12, 0.30), skin); palm.position.set(0, 0, 0); g.add(palm);
  for (let i = 0; i < 3; i++) { const f = new THREE.Mesh(new THREE.BoxGeometry(0.055, 0.10, 0.20), skin); f.position.set(-0.08 + i * 0.075, 0.03, -0.18); f.rotation.x = -0.5; g.add(f); }
  const thumb = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.10, 0.13), skin); thumb.position.set(0.14, 0.04, -0.04); thumb.rotation.z = 0.4; g.add(thumb);
  const wrist = new THREE.Mesh(new THREE.BoxGeometry(0.20, 0.16, 0.26), skin); wrist.position.set(0.02, -0.06, 0.22); g.add(wrist);
  // The cigar itself (large), held angled up toward the camera "mouth"; lit ember at the far tip.
  const cigar = new THREE.Group();
  const bodyMat = new THREE.MeshLambertMaterial({ color: 0x6b4a2a, flatShading: true });
  const body = new THREE.Mesh(new THREE.CylinderGeometry(0.046, 0.052, 0.52, 10), bodyMat); body.rotation.z = Math.PI / 2; cigar.add(body);
  const band = new THREE.Mesh(new THREE.CylinderGeometry(0.054, 0.054, 0.07, 10), new THREE.MeshLambertMaterial({ color: 0xd8c69a, flatShading: true })); band.rotation.z = Math.PI / 2; band.position.x = -0.17; cigar.add(band);
  const gold = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.02, 10), new THREE.MeshBasicMaterial({ color: 0xc8a23a })); gold.rotation.z = Math.PI / 2; gold.position.x = -0.13; cigar.add(gold);
  const red  = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.015, 10), new THREE.MeshBasicMaterial({ color: 0x9a2b2b })); red.rotation.z = Math.PI / 2; red.position.x = -0.20; cigar.add(red);
  const emberMat = new THREE.MeshBasicMaterial({ color: 0xff5a1a });
  const ember = new THREE.Mesh(new THREE.SphereGeometry(0.05, 8, 6), emberMat); ember.position.x = 0.28; ember.visible = false; cigar.add(ember);
  const tip = new THREE.Object3D(); tip.position.x = 0.31; cigar.add(tip);
  cigar.position.set(0.05, 0.11, -0.10); cigar.rotation.set(0, 0.55, 0.18); g.add(cigar);
  g.userData = { ember, emberMat, tip };
  g.position.set(-0.34, -0.95, -0.5);    // start fully below the screen (raised during use)
  g.rotation.set(0.1, 0.2, 0);
  g.visible = false; camera.add(g);
  return g;
}
// Q: light up the cigar (one per life; consumed the instant you start — no cancel-and-reuse).
function useCigar() {
  if (!gameState.running || !player.alive || cigSmoking || player.cigar <= 0) return;
  player.cigar--;
  sfxCigarLight();                             // lighter click + flame hiss
  cigSmoking = true; cigCanceling = false; cigT = 0; cigLowerT = 0; cigPuffT = 0; _cigAudioPuffT = 1.0;
  aiming = false;                              // drop ADS — the main weapon holsters
  if (!_cigVM) _cigVM = buildCigarVM();
  _cigVM.visible = true; _cigVM.userData.ember.visible = false; _cigVM.position.set(-0.34, -0.95, -0.5);
  if (gunMesh) gunMesh.visible = false;
  updateHUD();
}
// Interrupt: quick-lower and stop healing (the cigar is already consumed for this life).
function cigCancel() { if (cigSmoking && !cigCanceling) { cigCanceling = true; cigLowerT = 0; sfxCigarCancel(); } }
function cigFinish() { cigSmoking = false; cigCanceling = false; if (_cigVM) _cigVM.visible = false; updateHUD(); }
// Per-frame: heal, animate the viewmodel (raise → light → hold+puff → lower), keep the gun holstered.
function updateCigar(dt) {
  if (!cigSmoking) return;
  if (!player.alive) { cigFinish(); return; }
  if (gunMesh) gunMesh.visible = false;        // keep the weapon holstered every frame (overrides scope/sight logic)
  const downY = -0.95, restY = -0.30, vm = _cigVM, ember = vm.userData.ember;
  if (cigCanceling) {                          // fast lower, heal stopped
    cigLowerT += dt; const k = Math.min(1, cigLowerT / CIGAR.lowerFast);
    vm.position.y = restY + (downY - restY) * smoothstep(k);
    ember.visible = false;
    if (k >= 1) cigFinish();
    return;
  }
  // Heal smoothly to full over the full duration (~33%/s); incoming damage still applies normally.
  player.health = Math.min(100, player.health + (100 / CIGAR.dur) * dt);
  updateHUD();
  cigT += dt;
  const lowerStart = CIGAR.dur - 0.4;
  if (cigT < CIGAR.raise) vm.position.y = downY + (restY - downY) * smoothstep(cigT / CIGAR.raise);
  else if (cigT < lowerStart) vm.position.y = restY + Math.sin(cigT * 2.0) * 0.012;     // subtle idle bob at the mouth
  else vm.position.y = restY + (downY - restY) * smoothstep((cigT - lowerStart) / 0.4);
  if (cigT >= 0.5) {                           // light the ember after the raise + flicker it
    ember.visible = true;
    const f = 0.85 + Math.random() * 0.15;
    ember.scale.setScalar(f); vm.userData.emberMat.color.setRGB(1, 0.35 * f, 0.08);
  }
  if (cigT >= 0.6 && cigT < lowerStart) {      // periodic smoke wisps from the lit tip
    cigPuffT -= dt;
    if (cigPuffT <= 0) { spawnSmokePuff(vm.userData.tip.getWorldPosition(new THREE.Vector3()), 0xcfcfcf, 0.12, 0.7); cigPuffT = 0.35; }
    _cigAudioPuffT -= dt;
    if (_cigAudioPuffT <= 0) { sfxCigarPuff(); _cigAudioPuffT = 1.0; }   // inhale/exhale ~1/s
  }
  if (cigT >= CIGAR.dur) { sfxCigarDone(); GP.rumble(0.12, 0.22, 130); cigFinish(); }   // warm satisfaction tone + subtle rumble at full heal
}

/* ============================================================================
   7h. SCORESTREAKS — kills-without-dying unlock powerful rewards (CoD-style).
     3 kills -> SABER + JACK DANIELS combo (press B)
     5 kills -> RC ROCKET LAUNCHER (press N)
   Dying resets the streak to 0 and forfeits every unlocked/active reward. The
   streak counter is LOCAL; kill credit is funneled here from the host-authoritative
   kill code (and directly in solo). See streakCredit() / the 'kc' net message.
   ============================================================================ */
const STREAK = {
  count: 0,
  tiers: [
    { id: 'saberjd', need: 3, key: 'KeyB', action: 'saber',       name: 'SABER + JACK',     unlocked: false, consumed: false },
    { id: 'flame',   need: 4, key: 'KeyV', action: 'flamethrower', name: 'FLAMETHROWER',    unlocked: false, consumed: false },
    { id: 'rcrl',    need: 5, key: 'KeyN', action: 'rcStreak',     name: 'RC ROCKET',        unlocked: false, consumed: false },
    { id: 'dogs',    need: 10, key: 'KeyM', action: 'dogs',        name: '20 KIRKS AVENGERS', unlocked: false, consumed: false }
  ]
};
// Saber + Jack Daniels combo state.
const SABER_IGNITE = 0.4, JD_DRINK = 1.5, OVERHEAL_MAX = 100, JD_REST_Y = -0.40;
let saberMode = false;          // saber+JD scorestreak currently equipped
let saberBlocking = false;      // RMB block stance (50% damage taken, 70% move speed, can't swing)
let saberIgniteT = 0;           // blade-ignition animation timer (counts down from SABER_IGNITE)
let saberSwingT = 0, saberSwingDir = 1;   // slash arc timer + alternating direction
let saberPulseT = 0;            // brief blade glow-pulse after a successful bullet deflection
let _jdVM = null, jdDrinking = false, jdDrinkT = 0;   // Jack Daniels left-hand viewmodel + drink anim

// A kill happened for the LOCAL player (any weapon). Bump the streak + unlock tiers.
function streakOnKill() {
  if (!player.alive || !gameState.running) return;
  STREAK.count++;
  STREAK.tiers.forEach(t => {
    if (!t.unlocked && !t.consumed && STREAK.count >= t.need) { t.unlocked = true; streakFlashUnlock(t); sfxStreakUnlock(); }
  });
  updateStreakHUD();
  announceStreakKill();   // Part 3: multi-kill / spree voice + visual callout (local only)
}
// Host-authority credit: bump the killer's streak (locally if it's me, else notify that peer).
function streakCredit(killerId, victimId) {
  if (!killerId || killerId === 'bot' || killerId === victimId) return;   // no self/environment streaks
  if (!NET.active || killerId === NET.selfId) streakOnKill();
  else NET.route(killerId, { t: 'kc' });
}
// Death (or match reset): wipe the streak + forfeit rewards. announce=true shows "STREAK LOST".
function streakReset(announce) {
  const had = STREAK.count > 0 || STREAK.tiers.some(t => t.unlocked || t.consumed);
  STREAK.count = 0; announceReset();   // dying breaks the multi-kill/spree announcer chain
  STREAK.tiers.forEach(t => { t.unlocked = false; t.consumed = false; t.armed = false; });
  saberEnd();
  player.overheal = 0; player.burnT = 0;
  flameFuel = 0; flameEquipped = false;   // flamethrower fuel is per-life
  despawnOwnedDogs(NET.active ? NET.selfId : 'solo');   // loyalty: my dogs leave when I fall
  if (announce && had) { showStreakLost(); sfxStreakLost(); }
  updateStreakHUD();
}
// Record a scorestreak activation (for the end-of-match "most activations" award).
function noteStreakActivation() {
  if (!NET.active) { soloStat.streakActs = (soloStat.streakActs || 0) + 1; }
  else if (NET.isHost) { const s = NET.scores.get(NET.selfId); if (s) s.streakActs = (s.streakActs || 0) + 1; }
  else NET.route(NET.hostId, { t: 'streakact', id: NET.selfId });
}
// Press B / N — activate an unlocked reward (or a soft "denied" if it isn't ready).
function streakActivate(tierId) {
  const t = STREAK.tiers.find(x => x.id === tierId);
  if (!t || !gameState.running || !player.alive) return;
  if (!MATCH.allowStreaks) { sfxStreakDenied(); return; }            // host disabled scorestreaks for this match
  if (!t.unlocked || t.consumed) { sfxStreakDenied(); return; }
  noteStreakActivation();
  if (tierId === 'saberjd') { t.consumed = true; equipSaberJD(); updateStreakHUD(); }
  else if (tierId === 'flame') { equipFlamethrower(); }   // consumed when the fuel tank runs dry (see flameEmpty)
  else if (tierId === 'rcrl') { streakDeployRC(); }   // consumed when the rocket is actually fired (see rcTryLaunch)
  else if (tierId === 'dogs') { t.consumed = true; requestSummonDogs(); updateStreakHUD(); }
}

/* ---- SABER + JACK DANIELS (3-kill reward) ---- */
function saberCreditWeapon() { return gameMode === 'gungame' ? ggLadderKey() : currentWeaponKey; }   // saber kills count as the current ladder weapon
function syncSaberHum() { if (saberMode && currentWeaponKey === 'saber' && player.alive && gameState.running) SaberHum.start(); else SaberHum.stop(); }
function equipSaberJD() {
  if (!player.alive) return;
  if (cigSmoking) cigFinish();          // the bottle replaces the cigar while saber+JD is active
  aiming = false; saberBlocking = false;
  saberMode = true; ggKarambit = false;
  saberIgniteT = SABER_IGNITE;
  ggEquip('saber');                     // mainGunKey() now resolves to the saber (keys 1/2 re-equip it)
  if (gunMesh && gunMesh.userData.saber) gunMesh.userData.saber.bladeGrp.scale.y = 0.0001;   // start the blade collapsed so the ignition reads
  sfxSaberIgnite(); flashSaber();
  if (!_jdVM) _jdVM = buildJdVM();
  _jdVM.visible = true; _jdVM.position.set(-0.42, JD_REST_Y, -0.55); _jdVM.rotation.set(0, -0.2, 0.12);
}
function saberEnd() {
  if (!saberMode) return;
  saberMode = false; saberBlocking = false; saberIgniteT = 0; saberSwingT = 0; jdDrinking = false;
  SaberHum.stop();
  if (_jdVM) _jdVM.visible = false;
  if (player.alive && gameState.running && currentWeaponKey === 'saber') ggEquipCurrent();   // back to the normal gun (respawn handles death)
}

// Build the square Jack Daniels bottle held by the neck in the left hand (lower-left).
function buildJdVM() {
  const g = new THREE.Group();
  const skin  = new THREE.MeshLambertMaterial({ color: 0xc98f5a, flatShading: true });
  const glass = new THREE.MeshLambertMaterial({ color: 0x241a12, flatShading: true });   // dark square JD bottle
  const cap   = new THREE.MeshLambertMaterial({ color: 0x111111, flatShading: true });
  const black = new THREE.MeshLambertMaterial({ color: 0x0a0a0a, flatShading: true });
  const gold  = new THREE.MeshBasicMaterial({ color: 0xC9A24A });
  const white = new THREE.MeshBasicMaterial({ color: 0xeee6d2 });
  const body = new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.34, 0.11), glass); g.add(body);
  const shoulder = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.06, 0.08), glass); shoulder.position.y = 0.19; g.add(shoulder);
  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.045, 0.12, 10), glass); neck.position.y = 0.27; g.add(neck);
  const capm = new THREE.Mesh(new THREE.CylinderGeometry(0.042, 0.042, 0.05, 10), cap); capm.position.y = 0.345; g.add(capm);
  const label = new THREE.Mesh(new THREE.BoxGeometry(0.145, 0.21, 0.006), black); label.position.set(0, -0.02, 0.058); g.add(label);   // iconic black label
  const l1 = new THREE.Mesh(new THREE.BoxGeometry(0.10, 0.02, 0.004), white); l1.position.set(0, 0.055, 0.062); g.add(l1);             // "JACK DANIEL'S"
  const l2 = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.034, 0.004), gold);  l2.position.set(0, 0.0, 0.062); g.add(l2);              // gold "Old No. 7"
  const l3 = new THREE.Mesh(new THREE.BoxGeometry(0.085, 0.012, 0.004), white); l3.position.set(0, -0.05, 0.062); g.add(l3);          // small print
  const palm = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.12, 0.16), skin); palm.position.set(-0.02, 0.13, 0.0); g.add(palm);       // left fist on the neck
  for (let i = 0; i < 3; i++) { const f = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.085, 0.05), skin); f.position.set(-0.07 + i * 0.06, 0.17, 0.07); g.add(f); }
  g.position.set(-0.42, JD_REST_Y, -0.55);
  g.rotation.set(0, -0.2, 0.12);
  g.visible = false; camera.add(g);
  return g;
}
// Q while saber+JD active: take a swig — full HP + full overheal. Unlimited uses while active.
function drinkJD() {
  if (!gameState.running || !player.alive || !saberMode || jdDrinking) return;
  jdDrinking = true; jdDrinkT = 0;
  player.health = 100;
  player.overheal = OVERHEAL_MAX;
  flashJD(); sfxJDDrink();
  updateHUD();
}
// Animate the bottle (raise -> tilt to mouth -> lower) and keep it shown while saber+JD is active.
function updateJD(dt) {
  if (!_jdVM) return;
  if (!saberMode || !player.alive) { _jdVM.visible = false; jdDrinking = false; return; }
  _jdVM.visible = !rcCamLive;
  const restY = JD_REST_Y, upY = -0.16;
  if (jdDrinking) {
    jdDrinkT += dt;
    const k = Math.min(1, jdDrinkT / JD_DRINK);
    const raise = Math.min(1, k / 0.35), lower = k > 0.7 ? (k - 0.7) / 0.3 : 0;
    const up = smoothstep(raise) * (1 - smoothstep(lower));
    _jdVM.position.y = restY + (upY - restY) * up;
    _jdVM.position.x = -0.42 + 0.15 * up;
    _jdVM.rotation.x = -1.1 * up;                 // tilt up to the mouth for the swig
    if (k >= 1) { jdDrinking = false; _jdVM.position.set(-0.42, restY, -0.55); _jdVM.rotation.set(0, -0.2, 0.12); }
  } else {
    _jdVM.position.x += (-0.42 - _jdVM.position.x) * Math.min(1, dt * 10);
    _jdVM.position.y += (restY - _jdVM.position.y) * Math.min(1, dt * 10);
    _jdVM.rotation.x += (0 - _jdVM.rotation.x) * Math.min(1, dt * 10);
  }
}

/* ---- SABER BULLET BLOCK + DEFLECT ----
   The blade is a physical object: a tall thin box in normal stance, a wide horizontal bar in block
   stance. An incoming DIRECT BULLET whose ray crosses the blade before reaching the body is blocked
   and mirror-reflected off the blade's broad face (can hit anyone, including the shooter). Explosions
   and projectiles (RPG/GL/crossbow/grenade) are NOT blocked — only hitscan bullets pass through here. */
function saberCanDeflect() { return saberMode && currentWeaponKey === 'saber' && player.alive && gameState.running; }
// The blade's oriented box in world space (center + orthonormal axes u/v/w + half-extents + face normal).
function saberBladeBox() {
  const eye = camera.getWorldPosition(new THREE.Vector3());
  const F = camera.getWorldDirection(new THREE.Vector3()).normalize();
  const R = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion).normalize();
  const U = new THREE.Vector3().crossVectors(R, F).normalize();
  if (saberBlocking) {   // horizontal bar across the front — WIDE arc
    return { center: eye.clone().addScaledVector(F, 0.55), u: R, v: U, w: F, hu: 0.78, hv: 0.17, hw: 0.12, normal: F.clone(), eye };
  }
  // vertical blade held front-right — NARROW arc (just where the blade is)
  return { center: eye.clone().addScaledVector(F, 0.5).addScaledVector(R, 0.22).addScaledVector(U, 0.25),
           u: R, v: U, w: F, hu: 0.1, hv: 0.62, hw: 0.1, normal: F.clone(), eye };
}
// Ray (origin O, unit dir D) vs the blade box. Returns { point, reflectDir } if it strikes the blade
// before reaching the body, else null. Slab test in the box's local frame.
function saberDeflectRay(O, D) {
  const b = saberBladeBox();
  const p = new THREE.Vector3().subVectors(O, b.center);
  const loA = [p.dot(b.u), p.dot(b.v), p.dot(b.w)], ldA = [D.dot(b.u), D.dot(b.v), D.dot(b.w)], h = [b.hu, b.hv, b.hw];
  let tmin = 0, tmax = Infinity;
  for (let i = 0; i < 3; i++) {
    if (Math.abs(ldA[i]) < 1e-6) { if (loA[i] < -h[i] || loA[i] > h[i]) return null; }
    else {
      let t1 = (-h[i] - loA[i]) / ldA[i], t2 = (h[i] - loA[i]) / ldA[i];
      if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
      tmin = Math.max(tmin, t1); tmax = Math.min(tmax, t2);
      if (tmin > tmax) return null;
    }
  }
  if (tmin < 0 || tmin > O.distanceTo(b.eye)) return null;   // must hit the blade before the body
  const point = O.clone().addScaledVector(D, tmin);
  const reflectDir = D.clone().addScaledVector(b.normal, -2 * D.dot(b.normal)).normalize();   // mirror off the broad face
  return { point, reflectDir };
}
// Resolve a successful deflection: spawn the reflected bullet, sparks, sound, blade glow pulse.
function saberDoDeflect(defl, dmg) {
  spawnDeflectedBullet(defl.point, defl.reflectDir, dmg);
  spawnExplosionFX(defl.point, 0.55, 0x9ed2ff);   // bright spark flash
  spawnBlood(defl.point, 6, 0x9ed2ff);            // blue spark particles
  sfxSaberDeflect(defl.point);
  saberPulseT = 0.18;                              // blade glow pulse
}

// Reflected bullets: fast projectiles with a bright white-blue trail; on hit they deal the original
// damage to any enemy (bot or remote player, including the original shooter). Simulated locally by
// the deflector (host/solo apply bot damage directly; clients route it for host validation).
const deflectedBullets = [];
function spawnDeflectedBullet(point, dir, dmg) {
  deflectedBullets.push({ pos: point.clone(), dir: dir.clone().normalize(), dmg: dmg, life: 0.6, speed: 90 });
}
function updateDeflectedBullets(dt) {
  for (let i = deflectedBullets.length - 1; i >= 0; i--) {
    const b = deflectedBullets[i];
    b.life -= dt;
    if (b.life <= 0) { deflectedBullets.splice(i, 1); continue; }
    const step = b.speed * dt;
    const from = b.pos.clone();
    const targets = colliders.concat(botMeshes());
    if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.avatar) rp.avatar.children.forEach(c => { if (c.userData && c.userData.remote) targets.push(c); }); });
    const ray = new THREE.Raycaster(from, b.dir, 0, step + 0.05);
    const hits = ray.intersectObjects(targets, false);
    let done = false;
    if (hits.length) {
      const hp = hits[0], ud = hp.object.userData || {};
      if (ud.bot && ud.bot.alive) {
        spawnBlood(hp.point, 10);
        if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: ud.bot.id, dmg: b.dmg, head: false, weapon: saberCreditWeapon(), fromId: NET.selfId });
        else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(ud.bot, b.dmg, b.dir, ud.part, { weapon: saberCreditWeapon(), dist: 8 }); if (NET.isHost) NET.botCredit = null; }
        done = true;
      } else if (ud.remote && ud.remote.alive) {
        spawnBlood(hp.point, 10);
        NET.damageRemote(ud.remote, b.dmg, ud.part === 'head', saberCreditWeapon(), false);   // no origin/dir => can't be re-deflected
        done = true;
      } else if (!ud.rcRemoteOwner) { sfxImpact(ud.mat === 'metal' ? 'metal' : 'wall', hp.point); done = true; }   // hit world geometry
      if (done) { spawnTracer(from, hp.point, { color: 0xcfeeff, life: 0.3, thick: true }); deflectedBullets.splice(i, 1); continue; }
    }
    b.pos.addScaledVector(b.dir, step);
    spawnTracer(from, b.pos, { color: 0xcfeeff, life: 0.28, thick: true });   // bright white-blue deflected trail
  }
}

/* ---- RC ROCKET LAUNCHER (5-kill reward) ---- */
// Deploy the RC launcher with exactly 1 rocket. Consumed when the rocket is fired (rcTryLaunch);
// re-pressing N before firing just re-arms the same single rocket (never grants a second).
function streakDeployRC() {
  if (rcActive || !player.alive || !gameState.running) return;
  if (cigSmoking) cigFinish();
  weaponState.rcrl.ammo = 1; weaponState.rcrl.cooldown = 0; weaponState.rcrl.reloading = 0;
  if (currentWeaponKey !== 'rcrl') rcPrevWeapon = currentWeaponKey;   // remember what to return to (gun or saber)
  rcEquipped = true; currentWeaponKey = 'rcrl'; aiming = false; currentSpread = 0;
  buildGunModel('rcrl'); syncSaberHum(); updateHUD();
}
// After the rocket detonates, drop the launcher and return to the previous weapon (gun or saber).
function streakRcReturnWeapon() {
  if (!rcEquipped) return;
  rcEquipped = false;
  if (player.alive && gameState.running) {
    if (saberMode) ggEquipCurrent();
    else if (gameMode === 'gungame') ggEquipCurrent();
    else { currentWeaponKey = rcPrevWeapon && WEAPONS[rcPrevWeapon] ? rcPrevWeapon : mainGunKey(); buildGunModel(currentWeaponKey); }
    syncSaberHum(); updateHUD();
  }
}

/* ---- SCORESTREAK HUD (left side) ---- */
// --- Dynamic keybind hints: every UI key label reads live from the binding system (IM). ---
function getKeyForAction(action) { return IM.keyLabel(IM.bind[action]); }   // 'flamethrower' -> 'V' (or 'F' if rebound), '(Not Bound)' if unbound
// Prompt label for the CURRENT input mode: a controller icon in gamepad mode, else the keyboard key.
function getPromptForAction(action) { return GP.active ? GP.gpIcon(action) : getKeyForAction(action); }
function refreshKeyHints() {       // re-stamp static prompts from the current bindings (load / rebind / settings-close / match-start)
  const ik = getPromptForAction('interact'), set = (id, html) => { const e = el(id); if (e) e.innerHTML = html; };
  set('ladderPrompt', 'Press <b>' + ik + '</b> to climb');
  set('noodlePrompt', 'Press <b>' + ik + '</b> to summon Mckayla');
  set('axePrompt', 'Press <b>' + ik + '</b> to pick up axe');
  const it = el('invTipText'); if (it) it.textContent = GP.active ? (GP.gpIcon('inventory').toUpperCase() + ' TO OPEN INVENTORY') : ('PRESS [' + getKeyForAction('inventory') + '] TO OPEN INVENTORY');
}

/* ============================================================================
   CONTROL HINTS PANEL — a live, mode-aware (keyboard/controller) HUD list of the key actions +
   context-sensitive prompts. Every label is pulled live via getPromptForAction() so rebinds and
   keyboard↔controller switches update instantly. Toggle in Settings → Gameplay.
   ============================================================================ */
const CH_BASE = [
  ['inventory', 'OPEN INVENTORY'], ['use', 'CIGAR / DRINK JD'], ['grenade', 'IMPULSE GRENADE'],
  ['lethal', 'LETHAL — SMOKE/AXE'], ['interact', 'INTERACT'], ['karambit', 'MELEE WEAPON'],
  ['scoreboard', 'SCOREBOARD'], ['pause', 'PAUSE / SETTINGS']
];
let _chBannerT = 0, _chBannerDone = false, _chBuilt = false;
function chKeyColor(action) {   // keyboard = gold; controller face buttons colour-coded (Xbox/PS), else neutral
  if (!GP.active) return '#ffd34a';
  const bi = GP.bind[action];
  const c = (GP.type === 'ps' ? { 0: '#7fb0ff', 1: '#ff7a9a', 2: '#e08fd0', 3: '#7fe08f' } : { 0: '#7fe08f', 1: '#ff6a6a', 2: '#7fb0ff', 3: '#ffd24a' })[bi];
  return c || '#7fd0ff';
}
function _chRow(cls) { const r = document.createElement('div'); r.className = 'chRow' + (cls ? ' ' + cls : ''); r.innerHTML = '<span class="chKey"></span><span class="chAct"></span>'; return r; }
function buildCtrlHints() {
  if (_chBuilt) return; const base = el('chBase'), ctx = el('chCtx'); if (!base || !ctx) return; _chBuilt = true;
  base.innerHTML = ''; ctx.innerHTML = '';
  CH_BASE.forEach(([a, label]) => { const r = _chRow(); r.dataset.action = a; r.querySelector('.chAct').textContent = label; base.appendChild(r); });
  // persistent context rows (toggled .on for smooth slide in/out): ready scorestreaks + interaction prompts
  STREAK.tiers.forEach(t => { const r = _chRow('ctx'); r._k = 's:' + t.id; r.dataset.streak = t.id; r.dataset.action = t.action; r.querySelector('.chAct').textContent = t.name; ctx.appendChild(r); });
  [['ladderPrompt', 'CLIMB LADDER'], ['noodlePrompt', 'SUMMON MCKAYLA'], ['scooterPrompt', 'MOUNT SCOOTER'], ['axePrompt', 'PICK UP AXE']].forEach(([src, label]) => {
    const r = _chRow('ctx'); r._k = 'p:' + src; r.dataset.src = src; r.dataset.action = 'interact'; r.querySelector('.chAct').textContent = label; ctx.appendChild(r);
  });
}
function _chToggle(r, on) {
  const was = r.classList.contains('on');
  if (on && !was) { r.classList.add('on'); r.classList.remove('pulse'); void r.offsetWidth; r.classList.add('pulse'); }   // pulse when newly relevant
  else if (!on && was) r.classList.remove('on');
}
function updateCtrlHints(dt) {
  const panel = el('ctrlHints'); if (!panel) return;
  const show = OPT.ctrlHints && gameState.running && !gameState.over && player.alive && !paused && !invOpen && !rcActive && !killcam.active && !riding;
  panel.classList.toggle('hidden', !show);
  if (!show) return;
  if (!_chBuilt) buildCtrlHints();
  el('chBase').querySelectorAll('.chRow').forEach(r => { const k = r.querySelector('.chKey'); k.textContent = getPromptForAction(r.dataset.action); k.style.color = chKeyColor(r.dataset.action); });
  let anyCtx = false;
  el('chCtx').querySelectorAll('.chRow.ctx').forEach(r => {
    let on = false;
    if (r.dataset.streak) { const t = STREAK.tiers.find(x => x.id === r.dataset.streak); on = !!(t && t.unlocked && !t.consumed); }
    else { const s = el(r.dataset.src); on = !!(s && s.style.display === 'block'); }   // mirror the existing interaction prompts
    if (on) { const k = r.querySelector('.chKey'); k.textContent = getPromptForAction(r.dataset.action); k.style.color = chKeyColor(r.dataset.action); }
    _chToggle(r, on); if (on) anyCtx = true;
  });
  el('chCtx').classList.toggle('any', anyCtx);
  const b = el('chBanner');
  if (b) {
    if (_chBannerT > 0 && !_chBannerDone) {
      _chBannerT -= dt; b.classList.add('on');
      b.innerHTML = '💡 New here? <b>' + (GP.active ? ('Hold ' + GP.gpIcon('pause') + ' for all controls') : 'Press [F1] for all controls') + '</b>';
      if (_chBannerT <= 0) { _chBannerDone = true; b.classList.remove('on'); }
    } else b.classList.remove('on');
  }
}
function chResetBanner() { _chBannerT = 60; _chBannerDone = false; }   // 60s new-player banner at match start (also dismissed on first inventory open)

/* --- FULL CONTROLS reference overlay (F1 / hold Start) — same info as Settings → Controls, mid-match --- */
function fullControlsOpen() { const e = el('fullControls'); return !!(e && e.classList.contains('on')); }
function renderFullControls() {
  const cols = el('fcCols'), sub = el('fcSub'), foot = el('fcFoot'); if (!cols) return; cols.innerHTML = '';
  const cat = (name) => { const h = document.createElement('div'); h.className = 'fcCat'; h.textContent = name; cols.appendChild(h); };
  const row = (lab, val) => { const r = document.createElement('div'); r.className = 'fcRow'; r.innerHTML = '<span>' + lab + '</span><b>' + val + '</b>'; cols.appendChild(r); };
  if (GP.active) {
    sub.textContent = 'Controller — ' + (GP.type === 'ps' ? 'PlayStation' : 'Xbox / Standard');
    const I = a => GP.gpIcon(a);
    cat('MOVEMENT'); row('Move', 'Left Stick'); row('Look / Aim', 'Right Stick'); row('Jump', I('jump')); row('Crouch / Dive', I('crouch')); row('Sprint', I('sprint'));
    cat('COMBAT'); row('Fire / Attack', I('fire')); row('Aim Down Sights / Block', I('ads')); row('Reload', I('reload')); row('Melee', I('karambit')); row('Quick Melee', I('quickMelee'));
    cat('EQUIPMENT'); row('Impulse Grenade', I('grenade')); row('Lethal (Smoke / Axe)', I('lethal')); row('Cigar / Drink JD', I('use')); row('Interact / Climb', I('interact')); row('Weapon Slots', I('weapon1') + ' / ' + I('weapon2'));
    cat('SCORESTREAKS'); row('Saber + Jack', I('saber')); row('Flamethrower', I('flamethrower')); row('RC Rocket', I('rcStreak')); row('Kirks Avengers', I('dogs')); row('Summon King Kong', I('kong'));
    cat('UI'); row('Inventory', I('inventory')); row('Scoreboard', 'hold ' + GP.gpIcon('scoreboard')); row('Pause / Menu', I('pause'));
    foot.textContent = 'Release / tap ' + GP.gpIcon('pause') + ' or press ESC to close';
  } else {
    sub.textContent = 'Keyboard & Mouse';
    IM.ROWS.forEach(([a, label]) => { if (label === null) cat(a); else row(label, getKeyForAction(a)); });
    foot.textContent = 'Press [F1] or ESC to close';
  }
}
function toggleFullControls(forceOpen) {
  const e = el('fullControls'); if (!e) return;
  const open = forceOpen != null ? forceOpen : !fullControlsOpen();
  if (open) { renderFullControls(); e.classList.add('on'); } else e.classList.remove('on');
}
window.addEventListener('keydown', (e) => {   // F1 toggles the full-controls overlay mid-match
  if (e.code === 'F1') { e.preventDefault(); if (gameState.running) toggleFullControls(); }
}, true);

/* --- Objective hint (top-centre, ~5s on match start) --- */
let _objHintT = 0;
function showObjHint() {
  const e = el('objHint'); if (!e) return;
  let msg;
  if (gameMode === 'gungame') msg = 'Get a kill to advance to the next weapon';
  else if (gameMode === 'tdm') msg = (myTeam === 'red' ? '<b class="red">RED TEAM</b>' : myTeam === 'blue' ? '<b class="blue">BLUE TEAM</b>' : 'TEAM DEATHMATCH') + ' — eliminate the enemy team to win';
  else msg = 'Press <b>' + getPromptForAction('inventory') + '</b> to pick a different weapon';
  e.innerHTML = msg; e.classList.add('on'); _objHintT = 5;
}
function updateObjHint(dt) { if (_objHintT > 0) { _objHintT -= dt; if (_objHintT <= 0) { const e = el('objHint'); if (e) e.classList.remove('on'); } } }
// --- "PRESS [I] TO OPEN INVENTORY" discoverability hint (FFA only): 30s at match start, ~4s on respawn. ---
let invTipT = 0, invTipSession = false;
function _invTipNever() { try { return localStorage.getItem('invTipNever') === '1'; } catch (e) { return false; } }
function _invTipSeen() { try { return parseInt(localStorage.getItem('invTipSeen') || '0', 10) || 0; } catch (e) { return 0; } }
function maybeShowInvTip(secs, isMatchStart) {
  if ((gameMode !== 'ffa' && gameMode !== 'tdm') || invTipSession || _invTipNever()) return;
  if (isMatchStart) { const n = _invTipSeen() + 1; try { localStorage.setItem('invTipSeen', n); } catch (e) {} }
  const nv = el('invTipNever'); if (nv) nv.style.display = (_invTipSeen() >= 5) ? 'inline' : 'none';   // permanent-dismiss option after 5 views
  const it = el('invTipText'); if (it) it.textContent = GP.active ? (GP.gpIcon('inventory').toUpperCase() + ' TO OPEN INVENTORY') : ('PRESS [' + getKeyForAction('inventory') + '] TO OPEN INVENTORY');
  const box = el('invTip'); if (box) { box.style.display = 'flex'; box.style.opacity = '1'; }
  invTipT = secs;
}
function dismissInvTip(permanent) {
  invTipSession = true; invTipT = 0;
  const box = el('invTip'); if (box) box.style.display = 'none';
  if (permanent) { try { localStorage.setItem('invTipNever', '1'); } catch (e) {} }
}
function updateInvTip(dt) {
  const box = el('invTip'); if (!box) return;
  if (invTipT <= 0) { if (box.style.display !== 'none') box.style.display = 'none'; return; }
  invTipT -= dt;
  if (invTipT <= 0) { box.style.display = 'none'; box.style.opacity = '1'; return; }
  box.style.opacity = invTipT < 1 ? invTipT.toFixed(2) : '1';   // fade out over the final second
}
function updateStreakHUD() {
  const sbar = el('streakBar');
  if (!sbar) return;
  if (!gameState.running || BR.active) { sbar.style.display = 'none'; return; }   // BR: no scorestreaks
  sbar.style.display = 'block';
  el('streakCount').textContent = 'STREAK ' + STREAK.count;
  STREAK.tiers.forEach((t, i) => {
    const row = el('streakTier' + i); if (!row) return;
    row.classList.toggle('locked', !t.unlocked && !t.consumed);
    row.classList.toggle('ready', t.unlocked && !t.consumed);
    row.classList.toggle('consumed', t.consumed);
    const k = getPromptForAction(t.action);   // live key / controller icon (updates instantly on rebind or input-mode switch)
    const lab = row.querySelector('.stLabel'); if (lab) lab.textContent = 'PRESS ' + k + ' · ' + t.name;
    const prog = row.querySelector('.stProg'); if (prog) prog.style.width = Math.max(0, Math.min(100, (STREAK.count / t.need) * 100)) + '%';
    const ready = row.querySelector('.stReady'); if (ready) ready.textContent = t.consumed ? 'USED' : (t.unlocked ? '✓ PRESS ' + k : STREAK.count + ' / ' + t.need);
  });
}
function streakFlashUnlock(t) {
  const i = STREAK.tiers.indexOf(t); const row = el('streakTier' + i); if (!row) return;
  row.classList.remove('unlockFlash'); void row.offsetWidth; row.classList.add('unlockFlash');
}
let _streakLostT = null;
function showStreakLost() {
  const e = el('streakLost'); if (!e) return;
  e.style.display = 'block'; requestAnimationFrame(() => e.style.opacity = '1');
  clearTimeout(_streakLostT);
  _streakLostT = setTimeout(() => { e.style.opacity = '0'; setTimeout(() => e.style.display = 'none', 400); }, 1100);
}
// Quick screen flashes: golden when drinking, blue-white on saber ignition.
function flashJD() { const f = el('jdFlash'); if (!f) return; f.style.transition = 'none'; f.style.opacity = '0.8'; requestAnimationFrame(() => { f.style.transition = 'opacity 0.7s'; f.style.opacity = '0'; }); }
function flashSaber() { const f = el('saberFlash'); if (!f) return; f.style.transition = 'none'; f.style.opacity = '0.7'; requestAnimationFrame(() => { f.style.transition = 'opacity 0.45s'; f.style.opacity = '0'; }); }

/* ============================================================================
   7h2. FLAMETHROWER — the 4-kill scorestreak (press V). A continuous flame-cone sprayer with a
   fuel tank. Cone damage (12/tick × 8/s) + a 3s burn afterward, blocked by world geometry, hits
   players + NPCs (bots, enemy Kongs/dogs). Gun-game kills count as the current ladder weapon.
   ============================================================================ */
const FLAME = { fuelMax: 100, burnRate: 8, range: 16, coneCos: Math.cos(22.5 * Math.PI / 180), tickRate: 8, tickDmg: 12, burnDur: 3, burnDps: 3 };
let flameFuel = 0, flameEquipped = false, flameTickT = 0, flameAudioT = 0, flameHissT = 0;
function flameCreditWeapon() { return gameMode === 'gungame' ? ggLadderKey() : 'flame'; }

// V: equip the flamethrower (first press issues the full tank). Re-equips while fuel remains.
function equipFlamethrower() {
  if (!player.alive || !gameState.running) return;
  const t = STREAK.tiers.find(x => x.id === 'flame'); if (!t || !t.armed && flameFuel <= 0) { flameFuel = FLAME.fuelMax; if (t) t.armed = true; }
  if (flameFuel <= 0) { sfxStreakDenied(); return; }
  if (cigSmoking) cigFinish();
  ggKarambit = false; aiming = false;
  ggEquip('flame');           // sets currentWeaponKey='flame', flameEquipped=true, builds the model
  sfxFlameEquip(playerEarPos());
}
// Tank ran dry — the reward is fully consumed: gray out the V tier + swap back to the main weapon.
function flameEmpty() {
  flameFuel = 0;
  const t = STREAK.tiers.find(x => x.id === 'flame'); if (t) { t.consumed = true; updateStreakHUD(); }
  if (currentWeaponKey === 'flame') ggEquipCurrent();   // back to the gun (or saber)
  sfxEmpty();
}
// Pooled flame particles (spray cone + burn flames). Reused — no per-frame allocation.
const flameParts = [];
(function initFlameParts() {
  const geo = new THREE.SphereGeometry(0.5, 6, 5);
  for (let i = 0; i < 220; i++) { const m = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: 0xff8a1a, transparent: true, opacity: 0 })); m.visible = false; scene.add(m); flameParts.push({ mesh: m, vel: new THREE.Vector3(), life: 0, maxLife: 0, active: false, spray: false, o0: new THREE.Vector3() }); }
})();
// Distance-graded flame palette: bright near the nozzle, fading to dim red then wispy smoke at the 16u tip.
const FLAME_NEAR = new THREE.Color(0xffe23a), FLAME_MID = new THREE.Color(0xff7a1a), FLAME_FAR = new THREE.Color(0xff3010), FLAME_SMOKE = new THREE.Color(0x564f47);
function flameSprayFX(origin, aim) {
  for (let n = 0; n < 5; n++) {
    const p = flameParts.find(x => !x.active); if (!p) break;
    p.active = true; p.spray = true; p.mesh.visible = true; p.mesh.position.copy(origin); p.o0.copy(origin);
    const sp = 0.30, dir = aim.clone().add(new THREE.Vector3((Math.random() - 0.5) * sp, (Math.random() - 0.5) * sp, (Math.random() - 0.5) * sp)).normalize();
    p.vel.copy(dir).multiplyScalar(26 + Math.random() * 13);   // faster jet so particles carry to ~16u before fading
    p.life = p.maxLife = 0.55 + Math.random() * 0.42;
    p.mesh.scale.setScalar(0.22 + Math.random() * 0.22);
    p.mesh.material.color.copy(FLAME_NEAR); p.mesh.material.opacity = 0.92;
  }
}
function burnFX(pos, h) {
  if (Math.random() < 0.55) return;
  const p = flameParts.find(x => !x.active); if (!p) return;
  p.active = true; p.spray = false; p.mesh.visible = true; p.mesh.position.set(pos.x + (Math.random() - 0.5) * 0.8, pos.y + Math.random() * h, pos.z + (Math.random() - 0.5) * 0.8);
  p.vel.set((Math.random() - 0.5), 2 + Math.random(), (Math.random() - 0.5));
  p.life = p.maxLife = 0.4; p.mesh.scale.setScalar(0.22); p.mesh.material.color.setHex(0xff8a1a); p.mesh.material.opacity = 0.9;
}
function updateFlameParts(dt) {
  for (const p of flameParts) {
    if (!p.active) continue;
    p.life -= dt;
    if (p.life <= 0) { p.active = false; p.spray = false; p.mesh.visible = false; continue; }
    p.mesh.position.addScaledVector(p.vel, dt);
    if (p.spray) {
      // 0 at the nozzle, 1 at max range — drives color, opacity, drag and billow along the cone.
      const frac = Math.min(1, p.mesh.position.distanceTo(p.o0) / FLAME.range);
      p.vel.multiplyScalar(0.95 - frac * 0.14);             // further out = slower
      const c = p.mesh.material.color;
      if (frac < 0.45) c.copy(FLAME_NEAR).lerp(FLAME_MID, frac / 0.45);
      else if (frac < 0.78) c.copy(FLAME_MID).lerp(FLAME_FAR, (frac - 0.45) / 0.33);
      else c.copy(FLAME_FAR).lerp(FLAME_SMOKE, (frac - 0.78) / 0.22);   // wispy smoke at the tip
      p.mesh.scale.addScalar((1.5 + frac * 2.4) * dt);      // billows wider downrange (heat-haze read)
      p.mesh.material.opacity = (p.life / p.maxLife) * (0.95 - frac * 0.72) * (frac > 0.85 ? 0.5 : 1);   // dimmer + wispier far out
    } else {
      p.vel.multiplyScalar(0.9); p.mesh.scale.addScalar(2.4 * dt); p.mesh.material.opacity = 0.9 * (p.life / p.maxLife);
    }
  }
}
// Apply one damage tick to everything in the local player's flame cone (blocked by world geometry).
function flameConeDamage() {
  const origin = camera.getWorldPosition(new THREE.Vector3());
  const aim = camera.getWorldDirection(new THREE.Vector3()).normalize();
  const myId = dogSelfId(), creditW = flameCreditWeapon();
  const inCone = (px, py, pz) => {
    const to = new THREE.Vector3(px, py, pz).sub(origin); const dist = to.length();
    if (dist < 0.4 || dist > FLAME.range) return false;
    to.multiplyScalar(1 / dist); if (to.dot(aim) < FLAME.coneCos) return false;
    return new THREE.Raycaster(origin, to, 0, dist - 0.4).intersectObjects(colliders, false).length === 0;   // walls block flames
  };
  for (const bot of bots) { if (bot.alive && inCone(bot.pos.x, bot.pos.y + 1.1, bot.pos.z)) flameHitBot(bot, creditW); }
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && inCone(rp.pos.x, rp.pos.y + 1.0 - 0.5 * (rp.cr || 0), rp.pos.z)) { NET.damageRemote(rp, FLAME.tickDmg, false, creditW, false); NET.route(rp.id, { t: 'burn' }); } });
  for (const k of kongs) { if (!k.alive || k.dying || k.ownerId === myId) continue; if (inCone(k.pos.x, k.pos.y + 4.5, k.pos.z)) { if (NET.isClient) NET.route(NET.hostId, { t: 'konghit', kongId: k.id, dmg: FLAME.tickDmg, fromId: myId, burn: 1 }); else { damageKong(k, FLAME.tickDmg, myId); k.burnT = FLAME.burnDur; } } }
  for (const d of dogs) { if (!d.alive || d.dying || d.ownerId === myId) continue; if (inCone(d.pos.x, d.pos.y + 0.6, d.pos.z)) { if (NET.isClient) NET.route(NET.hostId, { t: 'doghit', dogId: d.id, dmg: FLAME.tickDmg, burn: 1 }); else { damageDog(d, FLAME.tickDmg); d.burnT = FLAME.burnDur; } } }
}
function flameHitBot(bot, creditW) {
  if (NET.isClient) NET.route(NET.hostId, { t: 'dmgbot', botId: bot.id, dmg: FLAME.tickDmg, head: false, weapon: creditW, fromId: NET.selfId, burn: 1 });
  else { if (NET.isHost) NET.botCredit = NET.selfId; damageBot(bot, FLAME.tickDmg, camera.getWorldDirection(new THREE.Vector3()), null, { weapon: creditW, dist: 4 }); if (NET.isHost) NET.botCredit = null; bot.burnT = FLAME.burnDur; bot.burnBy = NET.active ? NET.selfId : 'solo'; }
}
// Per-frame flamethrower driver: spray + cone damage + fuel drain + loop/pilot audio.
function updateFlamethrower(dt) {
  if (flameEquipped && gunMesh && gunMesh.userData.pilot) { gunMesh.userData.pilot.scale.setScalar(0.8 + Math.random() * 0.4); gunMesh.userData.pilot.material.opacity = 0.7 + Math.random() * 0.3; }   // pilot light flicker
  const spraying = flameEquipped && firing && flameFuel > 0 && player.alive && gameState.running && !player.onLadder && !cigSmoking;
  if (spraying) {
    flameFuel = Math.max(0, flameFuel - FLAME.burnRate * dt);
    flameSprayFX(gunMuzzleWorld(), camera.getWorldDirection(new THREE.Vector3()).normalize());
    flameTickT -= dt; if (flameTickT <= 0) { flameTickT = 1 / FLAME.tickRate; flameConeDamage(); }
    flameAudioT -= dt; if (flameAudioT <= 0) { flameAudioT = 0.22; sfxFlameLoop(playerEarPos()); }
    updateHUD();
    if (flameFuel <= 0) flameEmpty();
  } else if (flameEquipped) {
    flameHissT -= dt; if (flameHissT <= 0) { flameHissT = 0.7; sfxFlamePilot(playerEarPos()); }
  }
  updateFlameParts(dt);
  updateBurns(dt);
}
// Burning status: 3s, 3 HP/s, on bots/Kong/dogs (host/solo) + the local player; orange flame FX.
function updateBurns(dt) {
  if (!NET.active || NET.isHost) {
    for (const bot of bots) if (bot.alive && bot.burnT > 0) { bot.burnT -= dt; burnFX(new THREE.Vector3(bot.pos.x, bot.pos.y + 0.8, bot.pos.z), 1.4); bot._bt = (bot._bt || 0) - dt; if (bot._bt <= 0) { bot._bt = 0.5; if (NET.isHost) NET.botCredit = bot.burnBy || null; damageBot(bot, FLAME.burnDps * 0.5, new THREE.Vector3(0, 1, 0), null, { weapon: 'flame' }); if (NET.isHost) NET.botCredit = null; } }
    for (const k of kongs) if (k.alive && !k.dying && k.burnT > 0) { k.burnT -= dt; burnFX(new THREE.Vector3(k.pos.x, k.pos.y + 4, k.pos.z), 3.5); k._bt = (k._bt || 0) - dt; if (k._bt <= 0) { k._bt = 0.5; damageKong(k, FLAME.burnDps * 0.5, k.lastAttacker); } }
    for (const d of dogs) if (d.alive && !d.dying && d.burnT > 0) { d.burnT -= dt; burnFX(new THREE.Vector3(d.pos.x, d.pos.y + 0.6, d.pos.z), 1.0); d._bt = (d._bt || 0) - dt; if (d._bt <= 0) { d._bt = 0.5; damageDog(d, FLAME.burnDps * 0.5); } }
  }
  if (player.alive && player.burnT > 0) { player.burnT -= dt; burnFX(new THREE.Vector3(player.pos.x, player.pos.y + 0.9, player.pos.z), 1.3); player._bt = (player._bt || 0) - dt; if (player._bt <= 0) { player._bt = 0.5; sfxBurnCrackle(player.pos); hurtPlayer(FLAME.burnDps * 0.5); } }
}

/* ============================================================================
   7i. KIRKS AVENGERS — the 10-kill scorestreak: 10 loyal attack dogs (press M).
   The HOST (or solo player) runs the dog AI; clients render host snapshots. Dogs chase the
   nearest ENEMY of their owner, bite for 25 HP, have 100 HP, and despawn when their owner dies.
   ============================================================================ */
// Speeds are relative to the player's walk (MOVE.groundSpeed = 11): chase 1.8x, sprint 2.0x when
// locked onto a target within ~15u. 20 dogs spawn one every 0.15s (~3s). audioMax = closest-N audible.
const DOG = { count: 20, hp: 100, chaseSpeed: 11 * 1.8, sprintSpeed: 11 * 2.0, sprintRange: 15, followSpeed: 5.0,
              accel: 30, biteRange: 1.6, biteDmg: 25, biteCd: 1.5, spawnGap: 0.15, deathFade: 1.0, audioMax: 8 };
const dogs = [];               // active dogs (simulated on host/solo; render-only on clients)
let dogSpawnQueue = [];        // staggered summon queue (host/solo): { ownerId, t }
let dogIdSeq = 1, dogNetAcc = 0;

// Low-poly Doberman: dark body, red collar + glowing red eyes, animated legs/tail/jaws.
function buildDogModel() {
  const g = new THREE.Group();
  const dark = new THREE.MeshLambertMaterial({ color: 0x26292f, flatShading: true });
  const black = new THREE.MeshLambertMaterial({ color: 0x141519, flatShading: true });
  const red = new THREE.MeshBasicMaterial({ color: 0xcc2222 });
  const eye = new THREE.MeshBasicMaterial({ color: 0xff3030 });
  const white = new THREE.MeshLambertMaterial({ color: 0xdde0e6, flatShading: true });
  const box = (mat, x, y, z, sx, sy, sz) => { const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat); m.position.set(x, y, z); g.add(m); return m; };
  box(dark, 0, 0.55, -0.05, 0.36, 0.40, 0.86);     // torso
  box(dark, 0, 0.62, 0.42, 0.30, 0.30, 0.30);      // neck/shoulders
  box(dark, 0, 0.74, 0.62, 0.30, 0.30, 0.34);      // head
  box(black, 0, 0.70, 0.84, 0.22, 0.16, 0.22);     // snout (upper)
  const jaw = box(black, 0, 0.62, 0.86, 0.20, 0.08, 0.20);   // lower jaw (opens to bite)
  box(white, 0, 0.665, 0.97, 0.16, 0.03, 0.04);    // teeth
  box(black, -0.10, 0.93, 0.55, 0.07, 0.16, 0.05); // ears
  box(black, 0.10, 0.93, 0.55, 0.07, 0.16, 0.05);
  box(eye, -0.08, 0.80, 0.78, 0.05, 0.05, 0.03);   // glowing red eyes
  box(eye, 0.08, 0.80, 0.78, 0.05, 0.05, 0.03);
  box(red, 0, 0.60, 0.30, 0.34, 0.09, 0.10);       // red collar
  const legs = [];
  const mkLeg = (x, z) => { const l = new THREE.Group(); l.position.set(x, 0.42, z); const s = new THREE.Mesh(new THREE.BoxGeometry(0.10, 0.42, 0.10), black); s.position.y = -0.21; l.add(s); g.add(l); legs.push(l); };
  mkLeg(-0.14, 0.34); mkLeg(0.14, 0.34); mkLeg(-0.14, -0.36); mkLeg(0.14, -0.36);
  const tail = new THREE.Group(); tail.position.set(0, 0.62, -0.46); const ts = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 0.34), dark); ts.position.z = -0.17; tail.add(ts); tail.rotation.x = -0.5; g.add(tail);
  // Lit cigar clenched in the jaws (cosmetic gag) — ~snout-length, glowing ember, protruding forward.
  const cigBody = new THREE.Mesh(new THREE.CylinderGeometry(0.032, 0.036, 0.26, 8), new THREE.MeshLambertMaterial({ color: 0x6b4a2a, flatShading: true }));
  cigBody.rotation.x = Math.PI / 2; cigBody.position.set(0.06, 0.655, 1.04); g.add(cigBody);
  const cigEmber = new THREE.Mesh(new THREE.SphereGeometry(0.035, 6, 5), new THREE.MeshBasicMaterial({ color: 0xff5a1a })); cigEmber.position.set(0.06, 0.655, 1.18); g.add(cigEmber);
  const cigTip = new THREE.Object3D(); cigTip.position.set(0.06, 0.655, 1.21); g.add(cigTip);
  g.userData = { legs, jaw, tail, cigEmber, cigTip };
  return g;
}
// "Kirks Avengers" nameplate sprite above a dog's head.
function dogNameSprite() {
  const cv = document.createElement('canvas'); cv.width = 256; cv.height = 64;
  const c = cv.getContext('2d'); c.font = 'bold 26px Trebuchet MS, Arial'; c.textAlign = 'center';
  c.lineWidth = 6; c.strokeStyle = 'rgba(0,0,0,0.85)'; c.fillStyle = '#ff8a7a';
  c.strokeText('Kirks Avengers', 128, 42); c.fillText('Kirks Avengers', 128, 42);
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(cv), depthTest: false, transparent: true }));
  spr.scale.set(1.8, 0.45, 1); spr.position.set(0, 1.25, 0);
  return spr;
}
function attachDogMesh(dog) {
  dog.group = buildDogModel();
  dog.group.position.copy(dog.pos);
  dog.nameSprite = dogNameSprite(); dog.group.add(dog.nameSprite);
  scene.add(dog.group);
}
function removeDog(dog) { if (dog.group) { scene.remove(dog.group); disposeGroup(dog.group); dog.group = null; } }

// Owner helpers (the "self" id is 'solo' offline, else the PeerJS id).
function dogSelfId() { return NET.active ? NET.selfId : 'solo'; }
function dogOwnerPos(ownerId) {
  if (ownerId === dogSelfId()) return player.pos;
  const rp = NET.active ? NET.players.get(ownerId) : null;
  return rp ? rp.pos : player.pos;
}
// True if `t` is an enemy team relative to the owner's team `oteam` (always true outside TDM).
function allyEnemyTeam(oteam, t) { return !oteam || !t || t !== oteam; }
// Every alive enemy of `ownerId`: all bots + all humans except the owner. (TDM: excludes the owner's teammates.)
function dogTargets(ownerId) {
  const out = [];
  const oteam = (gameMode === 'tdm') ? teamOf(ownerId) : null;
  for (const b of bots) if (b.alive && allyEnemyTeam(oteam, b.team)) out.push({ pos: b.pos, kind: 'bot', ref: b });
  const sid = dogSelfId();
  if (player.alive && ownerId !== sid && allyEnemyTeam(oteam, myTeam)) out.push({ pos: player.pos, kind: 'self', ref: player });
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.id !== ownerId && allyEnemyTeam(oteam, teamOf(rp.id))) out.push({ pos: rp.pos, kind: 'remote', ref: rp }); });
  for (const m of mckaylas) if (m.alive && !m.dying && m.ownerId !== ownerId) out.push({ pos: m.pos, kind: 'mck', ref: m });   // enemy Mckaylas are fair game
  return out;
}
// Local player pressed M: play the summon fanfare, then summon (host/solo) or ask the host to.
function requestSummonDogs() {
  sfxDogSummon();
  const ownerId = dogSelfId();
  if (!NET.active || NET.isHost) summonDogs(ownerId);
  else NET.route(NET.hostId, { t: 'dogsummon', ownerId });
}
function summonDogs(ownerId) { for (let i = 0; i < DOG.count; i++) dogSpawnQueue.push({ ownerId, t: i * DOG.spawnGap }); }
function spawnOneDog(ownerId) {
  const op = dogOwnerPos(ownerId), ang = Math.random() * Math.PI * 2, r = 0.8 + Math.random() * 1.4;
  const x = op.x + Math.cos(ang) * r, z = op.z + Math.sin(ang) * r;
  const dog = { id: dogIdSeq++, ownerId, pos: new THREE.Vector3(x, groundHeightAt(x, z, 1), z), vel: new THREE.Vector3(),
                yaw: Math.random() * 6.283, health: DOG.hp, alive: true, dying: false, deathT: 0,
                target: null, biteCd: 0, mouthOpen: 0, legPhase: Math.random() * 6.283, state: 'follow',
                _growlT: Math.random() * 0.5, _barkT: 1 + Math.random() * 2, _pawT: Math.random() * 0.3, _smokeT: Math.random() * 1.5 };
  attachDogMesh(dog);
  spawnExplosionFX(dog.pos.clone().setY(dog.pos.y + 0.5), 1.0, 0x9a4cff);   // summon sparkle/portal
  dogs.push(dog);
}
// Host/solo: damage a dog; on lethal damage start the death (yelp + topple + 1s despawn).
function damageDog(dog, dmg) {
  if (!dog || !dog.alive || dog.dying) return;
  dog.health -= dmg;
  if (dog.health <= 0) { dog.alive = false; dog.dying = true; dog.deathT = DOG.deathFade; sfxDogDeath(dog.pos); spawnBlood(dog.pos.clone().setY(dog.pos.y + 0.5), 8); }
}
// Host/solo: a dog bites a target for 25 HP (owner gets the credit).
function dogBite(dog, tgt) {
  dog.mouthOpen = 1; sfxDogBite(dog.pos);
  if (tgt.kind === 'bot') {
    if (NET.isHost) NET.botCredit = dog.ownerId;
    damageBot(tgt.ref, DOG.biteDmg, new THREE.Vector3(0, 0, 1), null, { weapon: 'dogbite', dist: 2 });
    if (NET.isHost) NET.botCredit = null;
  } else if (tgt.kind === 'self') {
    player.lastAttacker = dog.ownerId; player.lastAttackerName = 'Kirks Avengers'; player.lastAttackerWeapon = 'dogbite'; player.lastAttackerMelee = false;
    hurtPlayer(DOG.biteDmg);
  } else if (tgt.kind === 'remote') {
    NET.route(tgt.ref.id, { t: 'youhit', dmg: DOG.biteDmg, head: false, fromId: dog.ownerId, fromName: 'Kirks Avengers', weapon: 'dogbite', melee: false });
  } else if (tgt.kind === 'mck') {
    damageMckayla(tgt.ref, DOG.biteDmg);   // other players' dogs can bite Mckayla
  }
}
// Host/solo per-dog AI: pick the nearest enemy, chase + bite it; if none, follow the owner.
function dogAI(dog, dt) {
  const enemies = dogTargets(dog.ownerId);
  let tgt = null, td = Infinity;
  for (const e of enemies) { const d = dog.pos.distanceTo(e.pos); if (d < td) { td = d; tgt = e; } }
  let desired = new THREE.Vector3(), speed = 0, faceP = null;
  if (tgt) {
    faceP = tgt.pos;
    dog.state = td <= DOG.biteRange + 0.4 ? 'bite' : 'chase';
    // Sprint when locked onto a nearby target (within ~15u), else chase speed.
    if (td > DOG.biteRange) { desired.subVectors(tgt.pos, dog.pos); desired.y = 0; desired.normalize(); speed = td < DOG.sprintRange ? DOG.sprintSpeed : DOG.chaseSpeed; }
    dog.biteCd -= dt;
    if (td <= DOG.biteRange && dog.biteCd <= 0) { dogBite(dog, tgt); dog.biteCd = DOG.biteCd; }
  } else {
    const op = dogOwnerPos(dog.ownerId), d = dog.pos.distanceTo(op);
    dog.state = d > 3 ? 'follow' : 'idle';
    if (d > 2.5) { desired.subVectors(op, dog.pos); desired.y = 0; desired.normalize(); speed = DOG.followSpeed; faceP = op; }
  }
  const maxDelta = DOG.accel * dt, lim = ARENA - 2;
  dog.vel.x = approach(dog.vel.x, desired.x * speed, maxDelta);
  dog.vel.z = approach(dog.vel.z, desired.z * speed, maxDelta);
  dog.pos.x = Math.max(-lim, Math.min(lim, dog.pos.x + dog.vel.x * dt));
  dog.pos.z = Math.max(-lim, Math.min(lim, dog.pos.z + dog.vel.z * dt));
  resolveHorizontal(dog.pos, 1.0);                       // slide along walls/vehicles (basic obstacle handling)
  dog.pos.y = groundHeightAt(dog.pos.x, dog.pos.z, dog.pos.y + 0.4);
  let ty = dog.yaw;
  if (faceP) ty = Math.atan2(faceP.x - dog.pos.x, faceP.z - dog.pos.z);
  else if (Math.hypot(dog.vel.x, dog.vel.z) > 0.2) ty = Math.atan2(dog.vel.x, dog.vel.z);
  let dy = ty - dog.yaw; while (dy > Math.PI) dy -= 6.283; while (dy < -Math.PI) dy += 6.283;
  dog.yaw += dy * Math.min(1, dt * 9);
  dog.group.position.copy(dog.pos); dog.group.rotation.y = dog.yaw;
}
function dogDeathAnim(dog, dt) { dog.deathT -= dt; if (dog.group) { dog.group.rotation.z += (1.4 - dog.group.rotation.z) * Math.min(1, dt * 8); dog.group.position.copy(dog.pos); } }
function dogClientLerp(dog, dt) {
  const t = Math.min(1, dt * 12);
  dog.pos.lerp(dog.tpos, t); dog.yaw = lerpAngle(dog.yaw, dog.tyaw, t);
  dog.group.position.copy(dog.pos); dog.group.rotation.y = dog.yaw;
  if (dog.dying) dog.group.rotation.z += (1.4 - dog.group.rotation.z) * Math.min(1, dt * 8);
}
// Visual animation (both host + clients): trotting legs, wagging tail, snapping jaws.
function dogAnimate(dog, dt) {
  if (!dog.group) return;
  const ud = dog.group.userData, moving = dog.state === 'chase' || dog.state === 'follow';
  dog.legPhase += dt * (dog.state === 'chase' ? 16 : moving ? 9 : 3);
  if (ud.legs) ud.legs.forEach((l, i) => { l.rotation.x = moving ? Math.sin(dog.legPhase + (i < 2 ? 0 : Math.PI) + (i % 2) * Math.PI) * 0.6 : l.rotation.x * 0.8; });
  if (ud.tail) ud.tail.rotation.y = Math.sin(dog.legPhase * 0.5) * 0.45;
  if (dog.state === 'bite') dog.mouthOpen = 1;
  dog.mouthOpen = Math.max(0, dog.mouthOpen - dt * 3);
  if (ud.jaw) ud.jaw.rotation.x = -dog.mouthOpen * 0.55;
  // Lit cigar: flicker the ember + an occasional subtle smoke wisp (only for dogs near the listener).
  if (ud.cigEmber) ud.cigEmber.scale.setScalar(0.8 + Math.random() * 0.25);
  if (ud.cigTip) {
    dog._smokeT = (dog._smokeT == null ? Math.random() * 1.5 : dog._smokeT) - dt;
    if (dog._smokeT <= 0) { dog._smokeT = 1.6 + Math.random() * 1.8; if (SND.lpos && dog.pos.distanceToSquared(SND.lpos) < 900) spawnSmokePuff(ud.cigTip.getWorldPosition(new THREE.Vector3()), 0xcfcfcf, 0.07, 0.6); }
  }
}
// Host/solo: remove every dog owned by `ownerId` (loyalty — they leave when their owner falls).
function despawnOwnedDogs(ownerId) {
  if (NET.active && !NET.isHost) return;   // only the simulator removes; clients follow snapshots
  dogSpawnQueue = dogSpawnQueue.filter(q => q.ownerId !== ownerId);
  for (let i = dogs.length - 1; i >= 0; i--) if (dogs[i].ownerId === ownerId) { removeDog(dogs[i]); dogs.splice(i, 1); }
}
function dogUpdateHUD() {
  const myId = dogSelfId();
  let n = 0; for (const d of dogs) if (d.ownerId === myId && d.alive && !d.dying) n++;
  if (!NET.active || NET.isHost) n += dogSpawnQueue.filter(q => q.ownerId === myId).length;   // count the still-summoning ones
  const wrap = el('dogCount');
  if (wrap) { if (n > 0) { wrap.style.display = 'block'; el('dogNum').textContent = n; } else wrap.style.display = 'none'; }
}
// Dog body meshes NOT owned by `excludeId` — so a player can shoot ENEMY dogs (never their own).
function dogMeshes(excludeId) {
  const out = [];
  for (const d of dogs) {
    if (!d.alive || d.dying || !d.group || d.ownerId === excludeId) continue;
    d.group.traverse(o => { if (o.isMesh) { o.userData.dog = d; out.push(o); } });
  }
  return out;
}
function updateDogs(dt) {
  const sim = !NET.active || NET.isHost;
  if (sim) {
    for (let i = dogSpawnQueue.length - 1; i >= 0; i--) { dogSpawnQueue[i].t -= dt; if (dogSpawnQueue[i].t <= 0) { spawnOneDog(dogSpawnQueue[i].ownerId); dogSpawnQueue.splice(i, 1); } }
    for (let i = dogs.length - 1; i >= 0; i--) {
      const dog = dogs[i];
      if (dog.dying) { dogDeathAnim(dog, dt); if (dog.deathT <= 0) { removeDog(dog); dogs.splice(i, 1); } continue; }
      if (!dog.alive) { removeDog(dog); dogs.splice(i, 1); continue; }
      dogAI(dog, dt);
    }
    if (NET.active) { dogNetAcc += dt; if (dogNetAcc >= 0.06) { dogNetAcc = 0; NET.broadcast({ t: 'kdogs', list: dogs.map(d => ({ id: d.id, o: d.ownerId, x: d.pos.x, y: d.pos.y, z: d.pos.z, yaw: d.yaw, st: d.state, hp: d.health, dy: !!d.dying })) }); } }
  } else {
    for (let i = dogs.length - 1; i >= 0; i--) { const dog = dogs[i]; if (dog._remove) { removeDog(dog); dogs.splice(i, 1); continue; } dogClientLerp(dog, dt); }
  }
  for (const dog of dogs) dogAnimate(dog, dt);
  dogAudioPass(dt);
  dogUpdateHUD();
}
// Chasing dogs growl/bark/pant + pound paws, positionally (louder as they close in). To avoid audio
// chaos we only let the CLOSEST `audioMax` chasing dogs to the listener play — the rest stay silent.
// Runs on every machine (each client hears the dogs near their own camera).
function dogAudioPass(dt) {
  const lp = SND.lpos; if (!lp) return;
  const chasers = [];
  for (const d of dogs) if (d.alive && !d.dying && (d.state === 'chase' || d.state === 'bite')) chasers.push(d);
  chasers.sort((a, b) => a.pos.distanceToSquared(lp) - b.pos.distanceToSquared(lp));
  const n = Math.min(DOG.audioMax, chasers.length);
  for (let i = 0; i < n; i++) {
    const d = chasers[i], dist = d.pos.distanceTo(lp), sprint = d.state === 'chase' && dist < DOG.sprintRange;
    d._growlT -= dt; d._barkT -= dt; d._pawT -= dt;
    if (d._growlT <= 0) { d._growlT = 0.5 + Math.random() * 0.4; sfxDogGrowl(d.pos); }      // near-continuous low growl
    if (d._barkT <= 0)  { d._barkT = 1 + Math.random() * 2; sfxDogBark(d.pos); }            // sharp bark every 1-3s
    if (d._pawT <= 0)   { d._pawT = sprint ? 0.16 : 0.26; sfxDogPaws(d.pos); if (sprint && Math.random() < 0.35) sfxDogPant(d.pos); }   // paw thumps (+pant while sprinting)
  }
}
// Client: rebuild local dog render-copies from the host's snapshot.
function applyDogsSnapshot(list) {
  const seen = {};
  for (const e of list) {
    seen[e.id] = true;
    let dog = dogs.find(d => d.id === e.id);
    if (!dog) { dog = { id: e.id, ownerId: e.o, pos: new THREE.Vector3(e.x, e.y, e.z), tpos: new THREE.Vector3(e.x, e.y, e.z), vel: new THREE.Vector3(), yaw: e.yaw, tyaw: e.yaw, health: e.hp, alive: true, dying: e.dy, state: e.st, mouthOpen: 0, legPhase: Math.random() * 6.283, _growlT: Math.random() * 0.5, _barkT: 1 + Math.random() * 2, _pawT: Math.random() * 0.3, _smokeT: Math.random() * 1.5 }; attachDogMesh(dog); dogs.push(dog); }
    dog.tpos.set(e.x, e.y, e.z); dog.tyaw = e.yaw; dog.state = e.st; dog.health = e.hp; dog.dying = e.dy;
  }
  for (const dog of dogs) if (!seen[dog.id]) dog._remove = true;
}
// Clear all dogs (match start / reset).
function clearDogs() { for (const d of dogs) removeDog(d); dogs.length = 0; dogSpawnQueue = []; dogUpdateHUD(); }

/* ============================================================================
   KING KONG — secret boss-tier ally (press "="). One per summoner, host-authoritative AI
   (mirrors the dogs: broadcast snapshots, clients render). Wields a banana gun that fires
   giant tumbling banana projectiles; melees up close. 1000 HP; despawns on death / summoner
   death / match end. Friendly to the summoner + their Kirks Avengers dogs.
   ============================================================================ */
const KONG = { hp: 1000, speed: 11 * 1.4, accel: 24, fireRange: 40, fireCd: 2.0, bananaSpeed: 35, bananaDmg: 75,
               meleeRange: 4.2, meleeDmg: 60, meleeCd: 1.5, deathHold: 3.0, riseTime: 1.2, footShakeR: 20, scale: 1.6 };
const kongs = [];          // active King Kongs (one per owner) — host/solo simulate, clients render
let kongIdSeq = 1, kongNetAcc = 0;
const bananas = [];        // giant banana projectiles (host-owned do damage; client copies render only)
const bananaSplats = [];   // cosmetic goo decals (fade over 5s)

// ---- Meshes (flat-shaded, low-poly) ----
function buildBananaGun() {
  const g = new THREE.Group();
  const yellow = new THREE.MeshLambertMaterial({ color: 0xf4d11a, flatShading: true });
  const spot = new THREE.MeshLambertMaterial({ color: 0x6e5212, flatShading: true });
  const seg = (z, rz, len, r) => { const m = new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 8), yellow); m.rotation.x = Math.PI / 2; m.rotation.z = rz; m.position.z = z; g.add(m); };
  seg(-0.1, 0, 0.5, 0.16); seg(0.34, 0.4, 0.45, 0.14); seg(0.7, 0.8, 0.4, 0.11);   // curved banana barrel
  for (let i = 0; i < 5; i++) { const s = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.05, 0.05), spot); s.position.set((Math.random() - 0.5) * 0.22, 0.1, -0.2 + i * 0.22); g.add(s); }
  const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.1, 0.18, 6), spot); stem.rotation.x = Math.PI / 2; stem.position.z = -0.42; g.add(stem);   // grip = stem end
  const mz = new THREE.Object3D(); mz.position.set(0.18, 0.18, 0.92); g.add(mz);
  const flash = new THREE.Mesh(new THREE.ConeGeometry(0.3, 0.55, 8), new THREE.MeshBasicMaterial({ color: 0xfff0a0, transparent: true, opacity: 0.95 })); flash.rotation.x = -Math.PI / 2; flash.position.copy(mz.position); flash.visible = false; g.add(flash);
  g.userData = { muzzle: mz, flash };
  return g;
}
function buildBananaMesh() {
  const g = new THREE.Group();
  const yellow = new THREE.MeshLambertMaterial({ color: 0xf6d521, flatShading: true });
  const spot = new THREE.MeshLambertMaterial({ color: 0x5e4710, flatShading: true });
  const seg = (x, ry, len) => { const m = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, len, 8), yellow); m.rotation.z = Math.PI / 2; m.rotation.y = ry; m.position.x = x; g.add(m); };
  seg(-0.34, -0.5, 0.42); seg(0, 0, 0.5); seg(0.34, 0.5, 0.42);   // curved banana (~1u long)
  [-0.5, 0.5].forEach(x => { const t = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.1, 0.14, 6), spot); t.rotation.z = Math.PI / 2 + (x < 0 ? 0.7 : -0.7); t.position.set(x, -0.05, 0); g.add(t); });   // dark tips
  for (let i = 0; i < 6; i++) { const s = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.05, 0.05), spot); s.position.set(-0.4 + i * 0.16, 0.1, (Math.random() - 0.5) * 0.1); g.add(s); }
  return g;
}
function buildKongModel() {
  const root = new THREE.Group();
  const fur = new THREE.MeshLambertMaterial({ color: 0x3a342e, flatShading: true });
  const furLt = new THREE.MeshLambertMaterial({ color: 0x8a8278, flatShading: true });
  const dark = new THREE.MeshLambertMaterial({ color: 0x1c1814, flatShading: true });
  const eye = new THREE.MeshBasicMaterial({ color: 0xffd24a });
  const white = new THREE.MeshLambertMaterial({ color: 0xe8e2d2, flatShading: true });
  const box = (par, mat, x, y, z, sx, sy, sz) => { const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), mat); m.position.set(x, y, z); par.add(m); return m; };
  box(root, fur, -0.7, 0.9, 0, 0.8, 1.8, 0.9); box(root, fur, 0.7, 0.9, 0, 0.8, 1.8, 0.9);     // legs
  box(root, dark, -0.7, 0.1, 0.35, 0.85, 0.3, 0.5); box(root, dark, 0.7, 0.1, 0.35, 0.85, 0.3, 0.5);   // feet
  const upper = new THREE.Group(); upper.position.set(0, 1.8, 0); root.add(upper);
  box(upper, fur, 0, 1.1, 0, 2.0, 2.4, 1.4);                 // torso
  box(upper, furLt, 0, 1.1, 0.72, 1.2, 1.8, 0.1);            // silverback chest patch (+Z front)
  const head = new THREE.Group(); head.position.set(0, 2.55, 0.2); upper.add(head);
  box(head, fur, 0, 0, 0, 1.1, 1.0, 1.0); box(head, fur, 0, 0.55, -0.1, 1.3, 0.4, 1.1);   // skull + brow
  const jaw = box(head, fur, 0, -0.5, 0.2, 0.95, 0.4, 0.7); box(jaw, white, 0, 0.18, 0.28, 0.7, 0.12, 0.06);   // jaw + teeth
  box(head, eye, -0.26, 0.12, 0.5, 0.14, 0.12, 0.06); box(head, eye, 0.26, 0.12, 0.5, 0.14, 0.12, 0.06);       // eyes
  const armL = new THREE.Group(); armL.position.set(-1.15, 2.0, 0); upper.add(armL);
  box(armL, fur, 0, -1.1, 0, 0.7, 2.4, 0.7); box(armL, dark, 0, -2.2, 0.1, 0.8, 0.5, 0.8);
  const armR = new THREE.Group(); armR.position.set(1.15, 2.0, 0); upper.add(armR);
  box(armR, fur, 0, -1.1, 0, 0.7, 2.4, 0.7); box(armR, dark, 0, -2.2, 0.1, 0.8, 0.5, 0.8);
  const gun = buildBananaGun(); gun.scale.setScalar(1.6); gun.position.set(0, -2.2, 0.4); gun.rotation.x = 0.2; armR.add(gun);
  root.userData = { upper, head, jaw, armL, armR, gun, gunFlash: gun.userData.flash, gunMuzzle: gun.userData.muzzle };
  return root;   // ~6.4 units tall (~3.4 player-heights)
}

// ---- HUD / notify ----
function kongDrawHp(kong) {
  const cv = document.createElement('canvas'); cv.width = 256; cv.height = 64; const c = cv.getContext('2d');
  c.font = 'bold 26px Trebuchet MS, Arial'; c.textAlign = 'center'; c.lineWidth = 6; c.strokeStyle = 'rgba(0,0,0,0.85)'; c.fillStyle = '#ffcf5a';
  c.strokeText('🦍 KING KONG', 128, 28); c.fillText('🦍 KING KONG', 128, 28);
  const hp = Math.max(0, Math.min(1, kong.health / KONG.hp));
  c.fillStyle = 'rgba(0,0,0,0.6)'; c.fillRect(40, 40, 176, 16);
  c.fillStyle = hp > 0.5 ? '#34d058' : hp > 0.25 ? '#f0b429' : '#e0392b'; c.fillRect(42, 42, 172 * hp, 12);
  const tex = new THREE.CanvasTexture(cv);
  if (kong.hpSprite) { if (kong.hpSprite.material.map) kong.hpSprite.material.map.dispose(); kong.hpSprite.material.map = tex; kong.hpSprite.material.needsUpdate = true; }
}
function kongUpdateHUD() {
  const myId = dogSelfId(), mine = kongs.find(k => k.ownerId === myId && k.alive && !k.dying), wrap = el('kongHud');
  if (wrap) { if (mine) { wrap.style.display = 'block'; el('kongHpNum').textContent = Math.max(0, Math.ceil(mine.health)); } else wrap.style.display = 'none'; }
}
let _kongMsgT = null;
function showKongMsg(text) {
  const e = el('kongMsg'); if (!e) return;
  e.textContent = text; e.style.display = 'block'; requestAnimationFrame(() => e.style.opacity = '1');
  clearTimeout(_kongMsgT); _kongMsgT = setTimeout(() => { e.style.opacity = '0'; setTimeout(() => e.style.display = 'none', 400); }, 1800);
}
let _bannerT = null;
// Big center banner (match intro line, SUDDEN DEATH, etc.). Newlines render as separate lines.
function showCenterBanner(text, color, dur) {
  const e = el('matchBanner'); if (!e) return;
  e.textContent = text; e.style.color = color || '#fff'; e.style.display = 'block'; requestAnimationFrame(() => e.style.opacity = '1');
  clearTimeout(_bannerT); _bannerT = setTimeout(() => { e.style.opacity = '0'; setTimeout(() => e.style.display = 'none', 350); }, dur || 3200);
}
// Dramatic rise FX + audio, played once per Kong on every machine (it's a major event).
function kongSummonFX(pos) {
  addShake(0.6, 1.0);
  spawnExplosionFX(pos.clone().setY(pos.y + 0.5), 4, 0xbfae8a);
  for (let i = 0; i < 8; i++) spawnSmokePuff(pos.clone().add(new THREE.Vector3((Math.random() - 0.5) * 4, Math.random() * 1.5, (Math.random() - 0.5) * 4)), 0xb0a280, 0.5, 1.0);
  sfxKongSummon();
}
function attachKongMesh(kong) {
  kong.group = buildKongModel();
  kong.group.position.copy(kong.pos); kong.group.rotation.y = kong.yaw;
  const spr = new THREE.Sprite(new THREE.SpriteMaterial({ depthTest: false, transparent: true })); spr.scale.set(3.4, 0.85, 1); spr.position.set(0, 7.4, 0); kong.group.add(spr); kong.hpSprite = spr;
  scene.add(kong.group);
  kongDrawHp(kong); kongSummonFX(kong.pos);
}
function removeKong(kong) { if (kong.group) { scene.remove(kong.group); disposeGroup(kong.group); kong.group = null; } }

// ---- Summon ----
function requestSummonKong() {
  if (!gameState.running || !player.alive) return;
  if (!MATCH.allowKong) { showKongMsg('KING KONG DISABLED'); sfxStreakDenied(); return; }   // host disabled it for this match
  const ownerId = dogSelfId();
  if (kongs.some(k => k.ownerId === ownerId && k.alive)) return;   // one Kong at a time
  showKongMsg('KING KONG SUMMONED');
  if (!NET.active || NET.isHost) summonKong(ownerId);
  else NET.route(NET.hostId, { t: 'kongsummon', ownerId });
}
function summonKong(ownerId) {   // host/solo authoritative spawn
  if (kongs.some(k => k.ownerId === ownerId && k.alive)) return;
  const op = dogOwnerPos(ownerId);
  let fdx, fdz;
  if (ownerId === dogSelfId()) { const f = horizontalForward(); fdx = f.x; fdz = f.z; }
  else { const rp = NET.players.get(ownerId), yw = rp ? rp.yaw : 0; fdx = -Math.sin(yw); fdz = -Math.cos(yw); }
  const fx = op.x + fdx * 5, fz = op.z + fdz * 5;
  const kong = { id: kongIdSeq++, ownerId, pos: new THREE.Vector3(fx, groundHeightAt(fx, fz, 2), fz), vel: new THREE.Vector3(),
                 yaw: Math.atan2(fdx, fdz), health: KONG.hp, alive: true, dying: false, deathT: 0, riseT: KONG.riseTime,
                 target: null, fireCd: 1.2, meleeCd: 0, state: 'idle', bipedal: 1, animPhase: Math.random() * 6,
                 stepT: 0, gruntT: 2 + Math.random() * 3, breathT: Math.random() * 2, huffT: 3 + Math.random() * 4, thumpT: 4 + Math.random() * 6, roarT: 2 + Math.random() * 2, flashT: 0, flinchT: 0, meleeSwingT: 0, burnT: 0, lastAttacker: null };
  attachKongMesh(kong); kongs.push(kong);
}

// ---- AI (host/solo) ----
function kongHasLOS(kong, tgt) {
  const from = new THREE.Vector3(kong.pos.x, kong.pos.y + 6, kong.pos.z);
  const to = new THREE.Vector3(tgt.pos.x, tgt.pos.y + 1, tgt.pos.z);
  const dir = to.clone().sub(from); const dist = dir.length(); dir.normalize();
  const ray = new THREE.Raycaster(from, dir, 0, dist - 1.0);
  return ray.intersectObjects(colliders, false).length === 0;
}
function kongAI(kong, dt) {
  if (kong.riseT > 0) { kong.riseT -= dt; kong.state = 'idle'; kong.group.position.copy(kong.pos); kong.group.rotation.y = kong.yaw; return; }
  const enemies = dogTargets(kong.ownerId);
  let tgt = null, td = Infinity;
  for (const e of enemies) { const d = kong.pos.distanceTo(e.pos); if (d < td) { td = d; tgt = e; } }
  kong.target = tgt;
  let desired = new THREE.Vector3(), speed = 0, faceP = null;
  kong.meleeCd -= dt; kong.fireCd -= dt;
  if (tgt) {
    faceP = tgt.pos;
    if (td <= KONG.meleeRange) {
      kong.state = 'melee';
      if (kong.meleeCd <= 0) { kongMelee(kong, tgt); kong.meleeCd = KONG.meleeCd; }
      desired.subVectors(kong.pos, tgt.pos).setY(0); if (desired.lengthSq() > 0) desired.normalize(); speed = KONG.speed * 0.4;   // back off to re-gun
    } else if (td <= KONG.fireRange && kongHasLOS(kong, tgt)) {
      kong.state = 'attack';
      if (kong.fireCd <= 0) { kongFireBanana(kong, tgt); kong.fireCd = KONG.fireCd; }
    } else {
      kong.state = 'walk'; desired.subVectors(tgt.pos, kong.pos).setY(0).normalize(); speed = KONG.speed;
    }
  } else {
    // No enemies anywhere: Kong NEVER returns to the summoner — he just roams the map centre hunting.
    const dc = Math.hypot(kong.pos.x, kong.pos.z);
    if (dc > 18) { kong.state = 'walk'; desired.set(-kong.pos.x, 0, -kong.pos.z).normalize(); speed = KONG.speed * 0.45; }
    else kong.state = 'idle';
  }
  const wantBiped = kong.state === 'walk' ? 0 : 1;   // upright to attack/idle, leaned to knuckle-walk
  kong.bipedal += (wantBiped - kong.bipedal) * Math.min(1, dt * 6);
  const maxDelta = KONG.accel * dt, lim = ARENA - 3;
  kong.vel.x = approach(kong.vel.x, desired.x * speed, maxDelta);
  kong.vel.z = approach(kong.vel.z, desired.z * speed, maxDelta);
  kong.pos.x = Math.max(-lim, Math.min(lim, kong.pos.x + kong.vel.x * dt));
  kong.pos.z = Math.max(-lim, Math.min(lim, kong.pos.z + kong.vel.z * dt));
  resolveHorizontal(kong.pos, 3.0);                       // too big to pass through buildings (clumsy giant)
  kong.pos.y = groundHeightAt(kong.pos.x, kong.pos.z, kong.pos.y + 0.6);
  let ty = kong.yaw;
  if (faceP) ty = Math.atan2(faceP.x - kong.pos.x, faceP.z - kong.pos.z);
  else if (Math.hypot(kong.vel.x, kong.vel.z) > 0.3) ty = Math.atan2(kong.vel.x, kong.vel.z);
  let dy = ty - kong.yaw; while (dy > Math.PI) dy -= 6.283; while (dy < -Math.PI) dy += 6.283;
  kong.yaw += dy * Math.min(1, dt * 4);   // heavy, slow turning
  kong.group.position.copy(kong.pos); kong.group.rotation.y = kong.yaw;
}
function kongFireBanana(kong, tgt) {
  kong.flashT = 0.1;
  const muzzle = kong.group.userData.gunMuzzle.getWorldPosition(new THREE.Vector3());
  const aim = new THREE.Vector3(tgt.pos.x, tgt.pos.y + 1.0, tgt.pos.z);
  const tv = tgt.ref && tgt.ref.vel ? tgt.ref.vel : null;
  if (tv) { const tHit = muzzle.distanceTo(aim) / KONG.bananaSpeed; aim.addScaledVector(tv, tHit * 0.8); }   // basic lead
  const dir = aim.sub(muzzle).normalize(); dir.y += 0.06;   // counter the gravity arc a touch
  const vel = dir.normalize().multiplyScalar(KONG.bananaSpeed);
  spawnBanana(muzzle, vel, kong.ownerId, true);
  sfxKongFire(muzzle); sfxKongBellow(muzzle);   // bassy BWAMM + Kong's battle bellow on each shot
  if (NET.active) NET.broadcast({ t: 'banana', x: muzzle.x, y: muzzle.y, z: muzzle.z, vx: vel.x, vy: vel.y, vz: vel.z, o: kong.ownerId });
}
function kongMelee(kong, tgt) {
  kong.meleeSwingT = 0.3; sfxKongMelee(kong.pos);
  if (tgt.kind === 'bot') { if (NET.isHost) NET.botCredit = null; damageBot(tgt.ref, KONG.meleeDmg, new THREE.Vector3(0, 0, 1), null, { weapon: 'kongmelee' }); }
  else if (tgt.kind === 'self') { player.lastAttacker = 'kong'; player.lastAttackerName = 'King Kong'; player.lastAttackerWeapon = 'kongmelee'; player.lastAttackerMelee = false; hurtPlayer(KONG.meleeDmg); }
  else if (tgt.kind === 'remote') { NET.route(tgt.ref.id, { t: 'youhit', dmg: KONG.meleeDmg, head: false, fromId: 'kong', fromName: 'King Kong', weapon: 'kongmelee' }); }
}
// Host/solo: damage King Kong; on lethal damage start the death + notifications + killer reward.
function damageKong(kong, dmg, attackerId) {
  if (!kong || !kong.alive || kong.dying) return;
  kong.health -= dmg; kong.flinchT = 0.18; if (attackerId) kong.lastAttacker = attackerId;
  // Vocal reaction scales with the hit: low growl < 50, pain grunt 50-99, full roar of anger 100+.
  if (dmg >= 100) sfxKongRoarNear(kong.pos); else if (dmg >= 50) sfxKongPain(kong.pos); else sfxKongHurt(kong.pos);
  kongDrawHp(kong); kongUpdateHUD();
  if (kong.health <= 0) {
    kong.health = 0; kong.alive = false; kong.dying = true; kong.deathT = KONG.deathHold;
    sfxKongRoar(); addShake(0.5, 0.8);
    const owner = kong.ownerId, killer = kong.lastAttacker;
    if (owner === dogSelfId()) showKongMsg('KING KONG HAS FALLEN'); else NET.route(owner, { t: 'kongmsg', m: 'KING KONG HAS FALLEN' });
    if (killer) {
      if (killer === dogSelfId()) { showKongMsg('KILLED KING KONG'); for (let i = 0; i < 5; i++) streakOnKill(); }   // killing Kong = 5 streak kills
      else { NET.route(killer, { t: 'kongmsg', m: 'KILLED KING KONG' }); for (let i = 0; i < 5; i++) NET.route(killer, { t: 'kc' }); }
    }
  }
}
function despawnKong(ownerId) {
  if (NET.active && !NET.isHost) return;   // only the simulator removes; clients follow snapshots
  for (let i = kongs.length - 1; i >= 0; i--) if (kongs[i].ownerId === ownerId) { removeKong(kongs[i]); kongs.splice(i, 1); }
  kongUpdateHUD();
}
// Kong's kills are attributed to "KING KONG" (no player progression credit).
function kongKillFeed(victimName) {
  const html = `<span class="gg-rc">🦍 KING KONG</span> ▸ ${victimName || 'someone'}`;
  addKillFeed(html); if (NET.active && NET.isHost) NET.broadcast({ t: 'feed', html });
}
function kongDeathAnim(kong, dt) { if (kong.group) { kong.group.position.copy(kong.pos); kong.group.rotation.y = kong.yaw; } }
function kongClientLerp(kong, dt) {
  const t = Math.min(1, dt * 12);
  kong.pos.lerp(kong.tpos, t); kong.yaw = lerpAngle(kong.yaw, kong.tyaw, t);
  kong.group.position.copy(kong.pos); kong.group.rotation.y = kong.yaw;
}
function kongAnimate(kong, dt) {
  if (!kong.group) return;
  const ud = kong.group.userData;
  let yOff = 0, sc = KONG.scale;
  if (kong.riseT > 0) { const p = 1 - kong.riseT / KONG.riseTime; yOff = -(1 - smoothstep(p)) * 5 * KONG.scale; sc = KONG.scale * (0.5 + 0.5 * smoothstep(p)); }
  kong.group.scale.setScalar(sc);
  const lean = (1 - (kong.bipedal || 0)) * 0.6;
  const moving = kong.state === 'walk';
  kong.animPhase += dt * (moving ? 7 : 2);
  const sw = Math.sin(kong.animPhase) * (moving ? 0.5 : 0.05);
  if (ud.upper) ud.upper.rotation.x = lean + (kong.flinchT > 0 ? -0.18 : 0);
  if (ud.armL) ud.armL.rotation.x = -0.3 + sw + lean * 0.5;
  if (ud.armR) ud.armR.rotation.x = -0.3 - sw * 0.3 - (kong.bipedal || 0) * 0.9;   // raise the gun when bipedal
  if (kong.meleeSwingT > 0) { kong.meleeSwingT -= dt; const s = Math.sin(Math.max(0, 1 - kong.meleeSwingT / 0.3) * Math.PI); if (ud.armL) ud.armL.rotation.x = -0.3 - s * 1.9; }
  if (kong.flinchT > 0) kong.flinchT -= dt;
  if (ud.gunFlash) { if (kong.flashT > 0) { kong.flashT -= dt; ud.gunFlash.visible = true; ud.gunFlash.scale.setScalar(0.8 + Math.random() * 0.5); } else ud.gunFlash.visible = false; }
  if (moving) yOff += Math.abs(Math.sin(kong.animPhase)) * 0.12 * KONG.scale;   // heavy step bob
  if (kong.dying) { kong.group.rotation.x += (1.45 - kong.group.rotation.x) * Math.min(1, dt * 5); yOff -= 0.3 * KONG.scale * (1 - Math.max(0, kong.deathT) / KONG.deathHold); }
  kong.group.position.y = kong.pos.y + yOff;
  // Per-machine positional ambience + footstep screen shake for nearby players.
  if (SND.lpos) {
    const dist = Math.hypot(kong.pos.x - SND.lpos.x, kong.pos.z - SND.lpos.z);
    if (moving) { kong.stepT -= dt; if (kong.stepT <= 0) { kong.stepT = 0.42; sfxKongStep(kong.pos); if (dist < KONG.footShakeR) addShake(0.13 * (1 - dist / KONG.footShakeR), 0.18); } }
    if (!kong.dying) kongVoice(kong, dt);   // continuous breathing/grunting/huffing/thumping (escalates while chasing)
  }
}
// Continuous Kong vocal presence: cycles breaths / grunts / huffs / chest-thumps, with heavier
// breathing + more grunts while chasing and close-range roars near a target. (Audio is capped at 4.)
function kongVoice(kong, dt) {
  const chasing = !!kong.target && (kong.state === 'walk' || kong.state === 'attack' || kong.state === 'melee');
  const closeTgt = kong.target && kong.pos.distanceTo(kong.target.pos) < 10;
  kong.breathT -= dt; if (kong.breathT <= 0) { kong.breathT = (chasing ? 1.4 : 2.4) + Math.random(); sfxKongBreath(kong.pos); }       // deep breaths
  kong.gruntT -= dt;  if (kong.gruntT <= 0)  { kong.gruntT = (chasing ? 2.5 : 4.3) + Math.random() * 1.4; sfxKongGrunt(kong.pos); }   // grunts / snorts
  kong.huffT -= dt;   if (kong.huffT <= 0)   { kong.huffT = 6 + Math.random() * 2.5; sfxKongHuff(kong.pos); }                          // aggressive huffs
  kong.thumpT -= dt;  if (kong.thumpT <= 0)  { kong.thumpT = 8 + Math.random() * 4; sfxKongThump(kong.pos); }                          // proud chest thumps
  if (chasing && closeTgt) { kong.roarT -= dt; if (kong.roarT <= 0) { kong.roarT = 4 + Math.random() * 3; sfxKongRoarNear(kong.pos); } }   // intimidating close-range roars
}
function updateKongs(dt) {
  const sim = !NET.active || NET.isHost;
  if (sim) {
    for (let i = kongs.length - 1; i >= 0; i--) {
      const k = kongs[i];
      if (k.dying) { k.deathT -= dt; kongDeathAnim(k, dt); if (k.deathT <= 0) { removeKong(k); kongs.splice(i, 1); } continue; }
      kongAI(k, dt);
    }
    if (NET.active) { kongNetAcc += dt; if (kongNetAcc >= 0.06) { kongNetAcc = 0; NET.broadcast({ t: 'kongs', list: kongs.map(k => ({ id: k.id, o: k.ownerId, x: k.pos.x, y: k.pos.y, z: k.pos.z, yaw: k.yaw, st: k.state, hp: k.health, bp: +(k.bipedal).toFixed(2), rise: Math.max(0, k.riseT), dy: !!k.dying, fl: k.flashT > 0 ? 1 : 0 })) }); } }
  } else {
    for (let i = kongs.length - 1; i >= 0; i--) { const k = kongs[i]; if (k._remove) { removeKong(k); kongs.splice(i, 1); continue; } kongClientLerp(k, dt); }
  }
  for (const k of kongs) kongAnimate(k, dt);
  updateBananas(dt);
  kongUpdateHUD();
}
function applyKongsSnapshot(list) {
  const seen = {};
  for (const e of list) {
    seen[e.id] = true;
    let k = kongs.find(x => x.id === e.id);
    if (!k) { k = { id: e.id, ownerId: e.o, pos: new THREE.Vector3(e.x, e.y, e.z), tpos: new THREE.Vector3(e.x, e.y, e.z), vel: new THREE.Vector3(), yaw: e.yaw, tyaw: e.yaw, health: e.hp, alive: true, dying: e.dy, state: e.st, bipedal: e.bp || 0, riseT: e.rise || 0, animPhase: Math.random() * 6, stepT: 0, gruntT: 2, breathT: Math.random() * 2, huffT: 3 + Math.random() * 4, thumpT: 4 + Math.random() * 6, roarT: 2 + Math.random() * 2, flashT: 0, flinchT: 0, meleeSwingT: 0, burnT: 0 }; attachKongMesh(k); kongs.push(k); }
    k.tpos.set(e.x, e.y, e.z); k.tyaw = e.yaw; k.state = e.st; k.dying = e.dy; k.bipedal = e.bp || 0; if (e.rise != null) k.riseT = e.rise;
    if (e.fl) k.flashT = 0.1;
    if (k.health !== e.hp) { k.health = e.hp; kongDrawHp(k); }
  }
  for (const k of kongs) if (!seen[k.id]) k._remove = true;
  kongUpdateHUD();
}
// Kong body meshes NOT owned by `excludeId` — so players can shoot ENEMY Kongs (never their own ally).
function kongMeshes(excludeId) {
  const out = [];
  for (const k of kongs) { if (!k.alive || k.dying || !k.group || k.ownerId === excludeId) continue; k.group.traverse(o => { if (o.isMesh) { o.userData.kong = k; out.push(o); } }); }
  return out;
}
function clearKongs() {
  for (const k of kongs) removeKong(k); kongs.length = 0;
  for (const b of bananas) { scene.remove(b.mesh); disposeGroup(b.mesh); } bananas.length = 0;
  for (const s of bananaSplats) { scene.remove(s.mesh); } bananaSplats.length = 0;
  kongUpdateHUD();
}

/* ============================================================================
   MCKAYLA — the secret katana-warrior ally summoned from inside the Noodle Box (press E).
   One per life per player. HOST/solo runs her AI; clients render host snapshots. She seeks the
   nearest enemy (bots + enemy humans + enemy King Kong), one-shots players with the katana, and
   chips 80 HP/slash off an enemy Kong. Modeled on the Kirks Avengers attack-dog system.
   ============================================================================ */
const MCK = { hp: 200, walk: 11 * 1.4, sprint: 11 * 1.7, sprintRange: 15, follow: 11, accel: 28,
              slashRange: 2.5, slashCd: 0.8, kongDmg: 80, deathFade: 1.2, scale: 1.0 };   // 100% = normal player height
const mckaylas = [];
let mckIdSeq = 1, mckNetAcc = 0, mckaylaSummonedThisLife = false;

function buildMckaylaMesh() {
  const g = new THREE.Group();
  const skinM = new THREE.MeshLambertMaterial({ color: 0xe8c6a4, flatShading: true });
  const kimono = new THREE.MeshLambertMaterial({ color: 0xf5b8c8, flatShading: true });   // soft cherry-blossom pink kimono
  const hairM = new THREE.MeshLambertMaterial({ color: 0x14161e, flatShading: true });     // jet blue-black hair
  const obi = new THREE.MeshLambertMaterial({ color: 0xc8a83a, flatShading: true });        // gold obi sash
  const legg = new THREE.MeshLambertMaterial({ color: 0x2a2a30, flatShading: true });       // charcoal leggings
  const shoe = new THREE.MeshLambertMaterial({ color: 0x101014, flatShading: true });       // black tabi
  const steel = new THREE.MeshLambertMaterial({ color: 0xccd4de, flatShading: true });
  const lash = new THREE.MeshBasicMaterial({ color: 0x0c0c10 });
  const eyeMat = new THREE.MeshBasicMaterial({ color: 0x2fff6a });
  const box = (w, h, d, x, y, z, mat) => { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat); m.position.set(x, y, z); m.castShadow = true; g.add(m); return m; };
  // --- body: charcoal leggings + tabi, knee-length pink kimono + gold obi, wide elbow-length sleeves ---
  box(0.46, 0.58, 0.46, 0, 0.42, 0, legg);                    // legs (leggings)
  box(0.26, 0.16, 0.36, -0.13, 0.08, 0.05, shoe); box(0.26, 0.16, 0.36, 0.13, 0.08, 0.05, shoe);   // tabi shoes
  box(0.66, 0.46, 0.5, 0, 0.78, 0, kimono);                   // knee-length kimono skirt
  box(0.7, 0.56, 0.45, 0, 1.14, 0, kimono);                   // torso
  box(0.74, 0.14, 0.48, 0, 0.92, 0, obi);                     // obi sash (gold)
  const armL = box(0.16, 0.5, 0.16, -0.42, 1.12, 0, skinM);
  const armR = box(0.16, 0.5, 0.16, 0.42, 1.12, 0, skinM);    // sword arm
  box(0.25, 0.34, 0.25, -0.42, 1.24, 0, kimono); box(0.25, 0.34, 0.25, 0.42, 1.24, 0, kimono);     // wide elbow-length sleeves
  [[-0.16, 1.22, 0.235, 0xe06a98], [0.14, 1.06, 0.235, 0xfff2f7], [0.0, 0.86, 0.265, 0xe06a98], [-0.12, 0.72, 0.265, 0xfff2f7], [0.2, 1.26, 0.235, 0xfff2f7], [-0.2, 0.96, 0.235, 0xe06a98]]
    .forEach(([x, y, z, c]) => box(0.09, 0.09, 0.03, x, y, z, new THREE.MeshLambertMaterial({ color: c, flatShading: true })));   // cherry-blossom floral dots
  // --- head + full black hairstyle (crown + bangs + side frame + long flowing back) ---
  box(0.42, 0.42, 0.42, 0, 1.62, 0, skinM);                   // head
  box(0.5, 0.28, 0.52, 0, 1.84, -0.02, hairM);                // crown / top of hair
  box(0.5, 0.5, 0.2, 0, 1.6, -0.27, hairM);                   // back of head
  box(0.1, 0.42, 0.42, -0.25, 1.56, 0.0, hairM); box(0.1, 0.42, 0.42, 0.25, 1.56, 0.0, hairM);     // side hair framing the face
  box(0.46, 0.13, 0.1, 0, 1.79, 0.21, hairM);                 // front bangs / fringe
  const hair = box(0.5, 1.05, 0.15, 0, 1.12, -0.35, hairM);   // long flowing hair down the back (animated)
  // --- slanted almond green eyes + eyelashes + thin arched brows ---
  box(0.14, 0.06, 0.04, -0.1, 1.64, 0.215, eyeMat).rotation.z = 0.2;
  box(0.14, 0.06, 0.04, 0.1, 1.64, 0.215, eyeMat).rotation.z = -0.2;
  box(0.16, 0.022, 0.04, -0.1, 1.675, 0.216, lash).rotation.z = 0.2;
  box(0.16, 0.022, 0.04, 0.1, 1.675, 0.216, lash).rotation.z = -0.2;
  box(0.15, 0.025, 0.04, -0.1, 1.73, 0.214, lash).rotation.z = 0.22;
  box(0.15, 0.025, 0.04, 0.1, 1.73, 0.214, lash).rotation.z = -0.22;
  // --- katana (scales up with her now-normal height) ---
  const kat = new THREE.Group();
  const grip = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 0.32), hairM); grip.position.z = 0.15; kat.add(grip);
  kat.add(new THREE.Mesh(new THREE.BoxGeometry(0.17, 0.17, 0.04), new THREE.MeshLambertMaterial({ color: 0x2a2a30, flatShading: true })));
  const blade = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.075, 1.1), steel); blade.position.z = -0.62; kat.add(blade);
  const edge = new THREE.Mesh(new THREE.BoxGeometry(0.022, 0.022, 1.04), new THREE.MeshBasicMaterial({ color: 0xbfe6ff })); edge.position.set(0, 0.04, -0.62); kat.add(edge);
  kat.position.set(0.5, 1.0, 0.12); kat.rotation.x = -0.35; g.add(kat); g.userData.katana = kat;
  const trail = new THREE.Mesh(new THREE.PlaneGeometry(1.3, 0.85), new THREE.MeshBasicMaterial({ color: 0x9fd8ff, transparent: true, opacity: 0, side: THREE.DoubleSide, depthWrite: false }));
  trail.position.set(0.45, 1.05, -0.35); g.add(trail); g.userData.trail = trail;
  g.userData.armR = armR; g.userData.armL = armL; g.userData.hair = hair;
  g.scale.setScalar(MCK.scale);   // 100% — normal player height
  return g;
}
function drawMckTag(mck) {
  if (!mck.tagCanvas) { mck.tagCanvas = document.createElement('canvas'); mck.tagCanvas.width = 256; mck.tagCanvas.height = 64; mck.tagTex = new THREE.CanvasTexture(mck.tagCanvas); const spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: mck.tagTex, transparent: true, depthTest: false })); spr.scale.set(2.4 / MCK.scale, 0.6 / MCK.scale, 1); spr.position.y = 2.9; mck.group.add(spr); mck.tagSprite = spr; }
  const c = mck.tagCanvas, x = c.getContext('2d'); x.clearRect(0, 0, 256, 64);
  x.font = 'bold 26px Segoe UI, sans-serif'; x.textAlign = 'center'; x.lineWidth = 4; x.strokeStyle = '#000'; x.fillStyle = '#fff';
  x.strokeText('MCKAYLA', 128, 24); x.fillText('MCKAYLA', 128, 24);
  const frac = Math.max(0, mck.health / MCK.hp);
  x.fillStyle = '#000'; x.fillRect(60, 38, 136, 14); x.fillStyle = frac > 0.4 ? '#37e06a' : '#e04a3a'; x.fillRect(62, 40, 132 * frac, 10);
  mck.tagTex.needsUpdate = true; mck._lastHp = Math.round(mck.health);
}
function attachMckaylaMesh(mck) { mck.group = buildMckaylaMesh(); mck.group.position.copy(mck.pos); scene.add(mck.group); mck.group.traverse(o => { if (o.isMesh) o.userData.mck = mck; }); drawMckTag(mck); }
function removeMckayla(mck) { if (mck.group) { scene.remove(mck.group); disposeGroup(mck.group); mck.group = null; } }
function clearMckaylas() { for (const m of mckaylas) removeMckayla(m); mckaylas.length = 0; mckUpdateHUD(); }
// Shootable part-meshes of every ENEMY Mckayla (never the shooter's own).
function mckaylaMeshes(excludeOwner) { const out = []; for (const m of mckaylas) if (m.alive && !m.dying && m.ownerId !== excludeOwner && m.group) m.group.traverse(o => { if (o.isMesh) out.push(o); }); return out; }
// Every alive enemy of `ownerId`: bots + humans (not the owner) + enemy King Kongs.
function mckTargets(ownerId) {
  const out = [];
  const oteam = (gameMode === 'tdm') ? teamOf(ownerId) : null;
  for (const b of bots) if (b.alive && allyEnemyTeam(oteam, b.team)) out.push({ pos: b.pos, kind: 'bot', ref: b });
  const sid = dogSelfId();
  if (player.alive && ownerId !== sid && allyEnemyTeam(oteam, myTeam)) out.push({ pos: player.pos, kind: 'self', ref: player });
  if (NET.active) NET.players.forEach(rp => { if (rp.alive && rp.id !== ownerId && allyEnemyTeam(oteam, teamOf(rp.id))) out.push({ pos: rp.pos, kind: 'remote', ref: rp }); });
  for (const k of kongs) if (k.alive && !k.dying && k.ownerId !== ownerId) out.push({ pos: k.pos, kind: 'kong', ref: k });
  return out;
}
function summonMckayla(ownerId) {
  const op = dogOwnerPos(ownerId), fx = op.x + 1.6, fz = op.z + 1.0;
  const mck = { id: mckIdSeq++, ownerId, pos: new THREE.Vector3(fx, groundHeightAt(fx, fz, 1), fz), vel: new THREE.Vector3(),
                yaw: 0, health: MCK.hp, alive: true, dying: false, deathT: MCK.deathFade, state: 'idle',
                swingCd: 0, swingT: 0, swingDir: 1, legPhase: Math.random() * 6.28, _lastHp: -1, _huhT: 1 + Math.random() * 2 };
  attachMckaylaMesh(mck); mckaylas.push(mck); mckBlossomFX(mck.pos); sfxMckSummon(); mckUpdateHUD();
}
function despawnOwnedMckaylas(ownerId) {
  if (NET.active && !NET.isHost) return;
  for (let i = mckaylas.length - 1; i >= 0; i--) if (mckaylas[i].ownerId === ownerId) { removeMckayla(mckaylas[i]); mckaylas.splice(i, 1); }
  mckUpdateHUD();
}
function damageMckayla(mck, dmg) {
  if (!mck || !mck.alive || mck.dying) return;
  mck.health -= dmg; drawMckTag(mck); mckUpdateHUD();
  if (mck.health > 0) sfxMckHurt(mck.pos);
  else { mck.health = 0; mck.alive = false; mck.dying = true; mck.deathT = MCK.deathFade; sfxMckDeath(mck.pos); spawnBlood(mck.pos.clone().setY(mck.pos.y + 0.8), 12); }
}
function mckSlash(mck, tgt) {
  mck.swingDir = -mck.swingDir; mck.swingT = 0.3; sfxMckSlash(mck.pos);
  if (tgt.kind === 'bot') { if (NET.isHost) NET.botCredit = mck.ownerId; damageBot(tgt.ref, 9999, new THREE.Vector3(0, 0, 1), null, { weapon: 'katana', melee: true }); if (NET.isHost) NET.botCredit = null; spawnBlood(new THREE.Vector3(tgt.ref.pos.x, tgt.ref.pos.y + 1.2, tgt.ref.pos.z), 14); sfxMckHit(mck.pos); }
  else if (tgt.kind === 'self') { player.lastAttacker = mck.ownerId; player.lastAttackerName = 'Mckayla'; player.lastAttackerWeapon = 'katana'; player.lastAttackerMelee = true; hurtPlayer(9999); sfxMckHit(mck.pos); }
  else if (tgt.kind === 'remote') { NET.route(tgt.ref.id, { t: 'youhit', dmg: 9999, head: false, fromId: mck.ownerId, fromName: 'Mckayla', weapon: 'katana', melee: true }); sfxMckHit(mck.pos); }
  else if (tgt.kind === 'kong') { damageKong(tgt.ref, MCK.kongDmg, mck.ownerId); sfxMckHit(mck.pos); }
}
function mckAI(mck, dt) {
  const enemies = mckTargets(mck.ownerId);
  let tgt = null, td = Infinity; for (const e of enemies) { const d = mck.pos.distanceTo(e.pos); if (d < td) { td = d; tgt = e; } }
  let desired = new THREE.Vector3(), speed = 0, faceP = null;
  mck.swingCd -= dt; if (mck.swingT > 0) mck.swingT -= dt;
  if (tgt) {
    faceP = tgt.pos;
    mck.state = td <= MCK.slashRange + 0.3 ? 'slash' : 'chase';
    if (td > MCK.slashRange) { desired.subVectors(tgt.pos, mck.pos); desired.y = 0; desired.normalize(); speed = td < MCK.sprintRange ? MCK.sprint : MCK.walk; }
    if (td <= MCK.slashRange && mck.swingCd <= 0) { mckSlash(mck, tgt); mck.swingCd = MCK.slashCd; }
  } else {
    const op = dogOwnerPos(mck.ownerId), d = mck.pos.distanceTo(op);
    mck.state = d > 5.5 ? 'follow' : 'idle';
    if (d > 5) { desired.subVectors(op, mck.pos); desired.y = 0; desired.normalize(); speed = MCK.follow; faceP = op; }
  }
  const maxDelta = MCK.accel * dt, lim = ARENA - 2;
  mck.vel.x = approach(mck.vel.x, desired.x * speed, maxDelta);
  mck.vel.z = approach(mck.vel.z, desired.z * speed, maxDelta);
  mck.pos.x = Math.max(-lim, Math.min(lim, mck.pos.x + mck.vel.x * dt));
  mck.pos.z = Math.max(-lim, Math.min(lim, mck.pos.z + mck.vel.z * dt));
  resolveHorizontal(mck.pos, 1.6);                       // obstacle avoidance — slide along walls/vehicles
  mck.pos.y = groundHeightAt(mck.pos.x, mck.pos.z, mck.pos.y + 0.5);
  let ty = mck.yaw; if (faceP) ty = Math.atan2(faceP.x - mck.pos.x, faceP.z - mck.pos.z); else if (Math.hypot(mck.vel.x, mck.vel.z) > 0.2) ty = Math.atan2(mck.vel.x, mck.vel.z);
  let dy = ty - mck.yaw; while (dy > Math.PI) dy -= 6.283; while (dy < -Math.PI) dy += 6.283; mck.yaw += dy * Math.min(1, dt * 9);
  mck.group.position.copy(mck.pos); mck.group.rotation.y = mck.yaw;
  if (speed >= MCK.sprint) { mck._huhT -= dt; if (mck._huhT <= 0) { mck._huhT = 2 + Math.random() * 2; sfxMckHuh(mck.pos); } }   // battle exhale while closing in
}
function mckClientLerp(mck, dt) {
  const t = Math.min(1, dt * 12);
  mck.pos.lerp(mck.tpos, t); mck.yaw = lerpAngle(mck.yaw, mck.tyaw, t);
  mck.group.position.copy(mck.pos); mck.group.rotation.y = mck.yaw;
  if (mck.swingT > 0) mck.swingT -= dt;
}
function mckDeathAnim(mck, dt) { if (mck.group) { mck.group.rotation.z += (1.4 - mck.group.rotation.z) * Math.min(1, dt * 6); mck.group.scale.setScalar(MCK.scale * Math.max(0.02, mck.deathT / MCK.deathFade)); } }
function mckAnimate(mck, dt) {
  const g = mck.group; if (!g) return;
  const moving = Math.hypot(mck.vel.x, mck.vel.z) > 0.6;
  mck.legPhase += dt * (moving ? 12 : 3);
  if (g.userData.hair) g.userData.hair.rotation.x = -0.1 + Math.sin(mck.legPhase * 0.5) * (moving ? 0.18 : 0.05);
  const kat = g.userData.katana, trail = g.userData.trail, sp = mck.swingT > 0 ? (mck.swingT / 0.3) : 0;
  if (kat) kat.rotation.z = mck.swingDir * sp * 1.6;
  if (g.userData.armR) g.userData.armR.rotation.x = -sp * 1.2;
  if (trail) trail.material.opacity = sp * 0.6;
  if (Math.round(mck.health) !== mck._lastHp) drawMckTag(mck);
}
function updateMckaylas(dt) {
  const sim = !NET.active || NET.isHost;
  if (sim) {
    for (let i = mckaylas.length - 1; i >= 0; i--) {
      const m = mckaylas[i];
      if (m.dying) { mckDeathAnim(m, dt); m.deathT -= dt; if (m.deathT <= 0) { removeMckayla(m); mckaylas.splice(i, 1); mckUpdateHUD(); } continue; }
      if (!m.alive) { removeMckayla(m); mckaylas.splice(i, 1); mckUpdateHUD(); continue; }
      mckAI(m, dt);
    }
    if (NET.active) { mckNetAcc += dt; if (mckNetAcc >= 0.06) { mckNetAcc = 0; NET.broadcast({ t: 'mcks', list: mckaylas.map(m => ({ id: m.id, o: m.ownerId, x: m.pos.x, y: m.pos.y, z: m.pos.z, yaw: m.yaw, st: m.state, hp: m.health, sw: m.swingT > 0 ? 1 : 0, dy: !!m.dying })) }); } }
  } else {
    for (let i = mckaylas.length - 1; i >= 0; i--) { const m = mckaylas[i]; if (m._remove) { removeMckayla(m); mckaylas.splice(i, 1); continue; } mckClientLerp(m, dt); }
  }
  for (const m of mckaylas) mckAnimate(m, dt);
  const np = el('noodlePrompt'); if (np) np.style.display = (gameState.running && inNoodleBox() && !mckaylaSummonedThisLife) ? 'block' : 'none';
  mckUpdateHUD();
}
function applyMckaylasSnapshot(list) {
  const seen = {};
  for (const e of list) {
    seen[e.id] = true;
    let m = mckaylas.find(x => x.id === e.id);
    if (!m) { m = { id: e.id, ownerId: e.o, pos: new THREE.Vector3(e.x, e.y, e.z), tpos: new THREE.Vector3(e.x, e.y, e.z), vel: new THREE.Vector3(), yaw: e.yaw, tyaw: e.yaw, health: e.hp, alive: true, dying: e.dy, state: e.st, swingT: 0, swingDir: 1, legPhase: Math.random() * 6.28, _lastHp: -1 }; attachMckaylaMesh(m); mckaylas.push(m); }
    m.tpos.set(e.x, e.y, e.z); m.tyaw = e.yaw; m.state = e.st; m.dying = e.dy; if (e.sw) m.swingT = 0.3;
    if (m.health !== e.hp) { m.health = e.hp; drawMckTag(m); }
  }
  for (const m of mckaylas) if (!seen[m.id]) m._remove = true;
  mckUpdateHUD();
}
function mckUpdateHUD() {
  const myId = dogSelfId(), mine = mckaylas.find(m => m.ownerId === myId && m.alive && !m.dying), wrap = el('mckHud');
  if (wrap) { if (mine) { wrap.style.display = 'block'; el('mckHpNum').textContent = Math.max(0, Math.ceil(mine.health)); } else wrap.style.display = 'none'; }
}
// Press E inside the noodle box: summon Mckayla (once per life).
function tryNoodleSummon() {
  if (!inNoodleBox() || mckaylaSummonedThisLife || !player.alive) return false;
  if (!MATCH.allowMckayla) { showKongMsg('MCKAYLA DISABLED'); sfxStreakDenied(); return true; }   // host disabled her for this match
  mckaylaSummonedThisLife = true;
  const myId = dogSelfId();
  if (NET.isClient) { NET.route(NET.hostId, { t: 'mcksummon', ownerId: myId }); mckBlossomFX(player.pos.clone().setY(player.pos.y + 1)); sfxMckSummon(); }
  else summonMckayla(myId);
  showKongMsg('MCKAYLA: SUMMONED');
  return true;
}
// Cherry-blossom petal swirl + soft pink flash at a summon point.
function mckBlossomFX(pos) {
  spawnExplosionFX(pos.clone().setY(pos.y + 0.9), 1.4, 0xffd0e8);
  for (let i = 0; i < 12; i++) spawnSmokePuff(pos.clone().add(new THREE.Vector3((Math.random() - 0.5) * 1.3, Math.random() * 1.8, (Math.random() - 0.5) * 1.3)), 0xffb0d8, 0.12, 0.9);
}
// Mckayla audio: soft Japanese chime + cherry-blossom whoosh on summon; katana slashes + battle cries.
function sfxMckSummon() { SND.play2d((ctx, out, t) => { aChime(ctx, out, t, [1320, 1760, 2640], 0.08, 0.5, 0.22, 'sine'); aNoise(ctx, out, t, { dur: 0.7, peak: 0.16, filter: 'bandpass', freq: 1800, freq1: 600, q: 0.7 }); }, 'voice', 'mcksum', 0.9, 0.7); }
function sfxMckSlash(pos) { SND.play3d((ctx, out, t) => { aNoise(ctx, out, t, { dur: 0.16, peak: 0.34, filter: 'bandpass', freq: 1400, freq1: 3200, q: 1.1 }); aTone(ctx, out, t, { type: 'sine', f0: 1800, f1: 800, dur: 0.1, peak: 0.1 }); }, pos, 'weapons', 'mckslash', 0.8, 0.16); }
function sfxMckHit(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'triangle', f0: 2600, f1: 1400, dur: 0.14, peak: 0.22 }); aNoise(ctx, out, t, { dur: 0.06, peak: 0.18, filter: 'lowpass', freq: 1000 }); aTone(ctx, out, t + 0.05, { type: 'sine', f0: 700, f1: 1100, dur: 0.12, peak: 0.14 }); }, pos, 'voice', 'mckhit', 0.8, 0.18); }
function sfxMckHurt(pos) { SND.play3d((ctx, out, t) => aTone(ctx, out, t, { type: 'sine', f0: 620, f1: 320, dur: 0.16, peak: 0.2 }), pos, 'voice', 'mckhurt', 0.7, 0.2); }
function sfxMckHuh(pos) { SND.play3d((ctx, out, t) => aNoise(ctx, out, t, { dur: 0.12, peak: 0.22, filter: 'bandpass', freq: 500, freq1: 900, q: 0.8 }), pos, 'voice', 'mckhuh', 0.6, 0.2); }
function sfxMckDeath(pos) { SND.play3d((ctx, out, t) => { aTone(ctx, out, t, { type: 'sine', f0: 520, f1: 180, dur: 0.4, peak: 0.26 }); aTone(ctx, out, t + 0.18, { type: 'triangle', f0: 1800, f1: 700, dur: 0.2, peak: 0.14 }); }, pos, 'voice', 'mckdeath', 0.85, 0.5); }

// ---- Banana projectiles ----
function spawnBanana(pos, vel, ownerId, owned) {
  const mesh = buildBananaMesh(); mesh.position.copy(pos); scene.add(mesh);
  bananas.push({ mesh, pos: pos.clone(), vel: vel.clone(), ownerId, owned: !!owned, life: 3.0, spin: Math.random() * 6, wobble: Math.random() * 6, sfxT: 0 });
}
function spawnBananaSplat(pos) {
  const m = new THREE.Mesh(new THREE.CircleGeometry(0.6 + Math.random() * 0.5, 10), new THREE.MeshBasicMaterial({ color: 0xe8c81e, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthWrite: false }));
  m.position.set(pos.x, Math.max(0.03, pos.y - 0.3), pos.z); m.rotation.x = -Math.PI / 2; scene.add(m);
  bananaSplats.push({ mesh: m, life: 5.0 });
}
function updateBananas(dt) {
  const lim = ARENA - 1;
  for (let i = bananaSplats.length - 1; i >= 0; i--) { const s = bananaSplats[i]; s.life -= dt; if (s.life <= 0) { scene.remove(s.mesh); s.mesh.geometry.dispose(); s.mesh.material.dispose(); bananaSplats.splice(i, 1); continue; } s.mesh.material.opacity = 0.85 * Math.min(1, s.life / 1.0); }
  for (let i = bananas.length - 1; i >= 0; i--) {
    const b = bananas[i]; b.life -= dt;
    b.vel.y -= 9 * dt;                                     // mild gravity arc
    b.pos.addScaledVector(b.vel, dt);
    b.spin += dt * 7; b.wobble += dt * 3;
    b.mesh.position.copy(b.pos);
    b.mesh.rotation.set(Math.sin(b.wobble) * 0.3, Math.atan2(b.vel.x, b.vel.z), b.spin);   // tumble + spin
    b.sfxT -= dt; if (b.sfxT <= 0) { b.sfxT = 0.16; sfxBananaFly(b.pos); }
    let hit = null;
    if (b.owned) { for (const e of dogTargets(b.ownerId)) { const cy = e.pos.y + 1.0 - 0.5 * (e.ref.cr || 0); if (Math.hypot(e.pos.x - b.pos.x, cy - b.pos.y, e.pos.z - b.pos.z) < 1.3) { hit = e; break; } } }
    let world = false;
    const gh = groundHeightAt(b.pos.x, b.pos.z, b.pos.y);
    if (b.pos.y < gh + 0.15) { b.pos.y = gh + 0.15; world = true; }
    if (Math.abs(b.pos.x) > lim || Math.abs(b.pos.z) > lim) world = true;
    if (!world) for (const s of solids) { if (b.pos.y < s.max.y && b.pos.y > s.min.y && b.pos.x > s.min.x && b.pos.x < s.max.x && b.pos.z > s.min.z && b.pos.z < s.max.z) { world = true; break; } }
    if (hit) { kongBananaHit(hit, b); spawnBananaSplat(b.pos); scene.remove(b.mesh); disposeGroup(b.mesh); bananas.splice(i, 1); continue; }
    if (world || b.life <= 0) { if (world) { sfxBananaSplat(b.pos); spawnBananaSplat(b.pos); } scene.remove(b.mesh); disposeGroup(b.mesh); bananas.splice(i, 1); continue; }
  }
}
function kongBananaHit(e, b) {
  sfxBananaHit(b.pos); spawnBlood(b.pos, 12);
  if (e.kind === 'bot') { if (NET.isHost) NET.botCredit = null; damageBot(e.ref, KONG.bananaDmg, b.vel.clone().setY(0).normalize(), null, { weapon: 'kongbanana' }); }
  else if (e.kind === 'self') { player.lastAttacker = 'kong'; player.lastAttackerName = 'King Kong'; player.lastAttackerWeapon = 'kongbanana'; player.lastAttackerMelee = false; hurtPlayer(KONG.bananaDmg); }
  else if (e.kind === 'remote') { NET.route(e.ref.id, { t: 'youhit', dmg: KONG.bananaDmg, head: false, fromId: 'kong', fromName: 'King Kong', weapon: 'kongbanana' }); }
}

// Ammo-box pickups: spin/bob, and refill ammo + 1 grenade when the player touches one.
function updatePickups(dt) {
  for (const pk of pickups) {
    if (pk.active) {
      pk.mesh.rotation.y += dt * 1.6;
      pk.mesh.position.y = pk.pos.y + Math.sin(performance.now() * 0.003) * 0.15;
      if (player.alive &&
          Math.hypot(player.pos.x - pk.pos.x, player.pos.z - pk.pos.z) < 2.2 &&
          Math.abs(player.pos.y - pk.pos.y) < 3) {
        WEAPON_ORDER.forEach(k => { weaponState[k].ammo = WEAPONS[k].mag; weaponState[k].reloading = 0; });
        let pickLabel;
        if (gameMode === 'gungame') {                    // refill the current ladder weapon, no throwables
          weaponState[currentWeaponKey].ammo = WEAPONS[currentWeaponKey].mag; weaponState[currentWeaponKey].reloading = 0;
          pickLabel = 'AMMO REFILLED';
        } else {
          player.grenades = Math.min(throwMaxCarry(), player.grenades + 1);
          pickLabel = throwableType === 'tomahawk' ? 'AMMO +1 TOMAHAWK' : 'AMMO +1 GRENADE';
        }
        pk.active = false; pk.mesh.visible = false; pk.respawn = 12;
        floatText(pk.pos.clone().setY(pk.pos.y + 1), pickLabel, '#8fd0ff');
        updateHUD();
      }
    } else {
      pk.respawn -= dt;
      if (pk.respawn <= 0) { pk.active = true; pk.mesh.visible = true; }
    }
  }
}

/* ============================================================================
   7e. LOOT CRATES — glowing green crates that drop a random special weapon
   ============================================================================ */
// One reusable crate (bright emissive green cube + soft green halo).
const lootCore = new THREE.Mesh(new THREE.BoxGeometry(1.8, 1.8, 1.8),
  new THREE.MeshLambertMaterial({ color: 0x18ff5c, emissive: 0x18ff5c, emissiveIntensity: 0.95, flatShading: true }));
const lootHalo = new THREE.Mesh(new THREE.BoxGeometry(2.9, 2.9, 2.9),
  new THREE.MeshBasicMaterial({ color: 0x4dff88, transparent: true, opacity: 0.16 }));
const lootGroup = new THREE.Group(); lootGroup.add(lootCore); lootGroup.add(lootHalo);
lootGroup.visible = false; scene.add(lootGroup);

let lootActive = false, lootTimer = 0, lootBaseY = 0, lootBob = 0;
const lootPos = new THREE.Vector3();

function spawnLootCrate() {
  const [x, z] = LOOT.points[(Math.random() * LOOT.points.length) | 0];
  lootBaseY = groundHeightAt(x, z, 50) + 1.5;
  lootPos.set(x, lootBaseY, z);
  lootGroup.position.copy(lootPos);
  lootGroup.visible = true; lootActive = true; lootBob = 0;
}
function chooseSpecial() {
  let r = Math.random(), acc = 0;
  for (const k of SPECIAL_ORDER) { acc += LOOT.weights[k] || 0; if (r <= acc) return k; }
  return 'laser';
}
function grantSpecial(key) {
  const w = WEAPONS[key], ws = weaponState[key];
  ownedSpecials.add(key);
  ws.ammo = w.mag; ws.reserve = w.reserveMax; ws.reloading = 0; ws.cooldown = 0;  // (re)fill
  switchWeapon(key);                                  // auto-equip
  showPickupBanner('PICKED UP: ' + w.name, !!w.legendary, w.legendary ? 'LEGENDARY!' : '');
}
function collectLoot() {
  spawnBlood(lootPos, 22, 0x33ff66);                  // green particle burst
  el('lootFlash').style.opacity = 0.55; setTimeout(() => el('lootFlash').style.opacity = 0, 130);
  lootGroup.visible = false; lootActive = false; lootTimer = LOOT.cooldown;
  grantSpecial(chooseSpecial());
  updateHUD();
}
function updateLoot(dt) {
  if (lootActive) {
    lootBob += dt;
    lootGroup.rotation.y += dt * 1.2;
    lootGroup.position.y = lootBaseY + Math.sin(lootBob * 2) * 0.25;     // bob
    el('lootInfo').style.display = 'none';
    if (player.alive &&
        Math.hypot(player.pos.x - lootPos.x, player.pos.z - lootPos.z) < 2.3 &&
        Math.abs(player.pos.y - (lootBaseY - 1.5)) < 3.5) collectLoot();
  } else {
    lootTimer -= dt;
    el('lootInfo').style.display = '';
    el('lootInfo').textContent = 'NEXT LOOT IN: ' + Math.max(0, Math.ceil(lootTimer)) + 's';
    if (lootTimer <= 0) spawnLootCrate();
  }
}

// --- Client: render the host's loot crate + request a pickup when standing on it ---
function applyClientLoot(loot) {
  if (!loot) return;
  NET._lootActive = loot.active;
  if (loot.active) { lootBaseY = loot.y; lootPos.set(loot.x, loot.y, loot.z); lootGroup.position.set(loot.x, loot.y, loot.z); lootGroup.visible = true; }
  else lootGroup.visible = false;
}
function updateClientLoot(dt) {
  el('lootInfo').style.display = 'none';                 // clients don't track the spawn timer
  if (NET._lootReqCd > 0) NET._lootReqCd -= dt;
  if (lootGroup.visible) {
    NET._lootBob = (NET._lootBob || 0) + dt;
    lootGroup.rotation.y += dt * 1.2;
    lootGroup.position.y = lootBaseY + Math.sin(NET._lootBob * 2) * 0.25;
  }
  if (NET._lootActive && player.alive && (NET._lootReqCd || 0) <= 0 &&
      Math.hypot(player.pos.x - lootPos.x, player.pos.z - lootPos.z) < 2.3 &&
      Math.abs(player.pos.y - (lootBaseY - 1.5)) < 3.5) {
    NET.route(NET.hostId, { t: 'lootgrab', fromId: NET.selfId });
    NET._lootReqCd = 1.5;                                 // debounce repeated requests
  }
}
function showPickupBanner(text, gold, subtitle) {
  const b = el('pickupBanner');
  b.innerHTML = `<div class="main"${gold ? ' style="color:#ffd700;text-shadow:0 0 12px rgba(255,215,0,.7)"' : ''}>${text}</div>` +
                (subtitle ? `<div class="sub">${subtitle}</div>` : '');
  b.style.opacity = 1;
  clearTimeout(b._t); b._t = setTimeout(() => b.style.opacity = 0, 2000);
}

/* ============================================================================
   8. HUD — counters, ammo, health, hit marker, kill feed, flashes
   ============================================================================ */
const el = (id) => document.getElementById(id);
/* ============================================================================
   BATTLE ROYALE — core match (single life, last alive wins). Loot, shrinking
   zones and the parachute drop build on this. Solo plays vs bots: each living
   bot is one of the (up to 10) participants. Host-authoritative networking is a
   later increment — for now BR is validated solo / vs bots.
   ============================================================================ */
const BR = { active: false, phase: 'none', t: 0, startCount: 10, placement: 0, zone: null,
  reset() { this.active = false; this.phase = 'none'; this.t = 0; this.placement = 0; this.zone = null; } };
// ===== BR FORTNITE-STYLE 5-SLOT UNIVERSAL INVENTORY (BR-only) =====
// 5 slots, each null or an item object. Weapons take a whole slot; consumables auto-stack.
//   weapon:  { t:'weapon', key, cfg, rar, ammo, reserve }
//   stackable: { t:'cigar'|'jd'|'impulse'|'lethal'|'second', count }
// Melee is SEPARATE (not in a slot) — held via `ggKarambit`, equipped with the melee key (Q).
let brInv = [null, null, null, null, null];   // the 5 universal slots
let brSel = -1;                                // selected slot index 0..4 (-1 = none); melee overrides when ggKarambit
const BR_STACK = { cigar: 5, jd: 5, impulse: 3, lethal: 3, second: 1 };   // per-type stack limits
function brItemMeta(t) {   // icon + name + effect + verb per item type (lethal label depends on the chosen lethal)
  if (t === 'cigar') return { icon: '🚬', name: 'CIGAR', desc: 'Restores 100 HP', verb: 'SMOKE' };
  if (t === 'jd') return { icon: '🥃', name: 'JACK DANIELS', desc: 'Restores 100 Shield', verb: 'DRINK' };
  if (t === 'impulse') return { icon: '💥', name: 'IMPULSE GRENADE', desc: 'Launches enemies / yourself', verb: 'THROW' };
  if (t === 'lethal') return { icon: (lethalChoice === 'axe' ? '🪓' : '💨'), name: (lethalChoice === 'axe' ? 'THROWING AXE' : 'SMOKE GRENADE'), desc: (lethalChoice === 'axe' ? 'Throw to damage' : 'Throw to deploy cover'), verb: 'THROW' };
  if (t === 'second') return { icon: '💉', name: 'SECOND CHANCE', desc: 'Auto-revives on lethal damage', verb: 'PASSIVE' };
  return { icon: '?', name: '—', desc: '', verb: '' };
}
function brSlotKeyBind(i) { return [IM.bind.weapon1, IM.bind.weapon2, IM.bind.karambit, IM.bind.brSlot4, IM.bind.brSlot5][i]; }   // physical key bound to slot i (for dynamic labels)
function brHeldItem() { return (brSel >= 0 && brSel < 5) ? brInv[brSel] : null; }
function brHeldWeapon() { const it = brHeldItem(); return (it && it.t === 'weapon') ? it : null; }
function brHoldingConsumable() { const it = brHeldItem(); return !ggKarambit && it && it.t !== 'weapon'; }
function brHasGun() { return brInv.some(it => it && it.t === 'weapon'); }
function brFirstEmpty() { return brInv.findIndex(it => it == null); }
let brEliminated = [];       // participant names in elimination order
let brElimLog = [];          // [{name, t}] for the results placement table

function ordinal(n) { const v = n % 100; if (v >= 11 && v <= 13) return n + 'TH'; const d = n % 10; return n + (d === 1 ? 'ST' : d === 2 ? 'ND' : d === 3 ? 'RD' : 'TH'); }
function brAliveCount() {
  let n = player.alive ? 1 : 0;
  for (const b of bots) if (b.alive && !b.dying) n++;
  if (NET.active) NET.players.forEach(p => { if (p.alive) n++; });
  return n;
}
function brStart() {
  BR.reset(); BR.active = true; BR.phase = 'play'; BR.t = 0; brInv = [null, null, null, null, null]; brSel = -1; brEliminated = []; brElimLog = [];
  brSpectating = false; brSpecFree = false; brSpecBlend = 1; brSpecCur = null; brZip = null; brHideHeldVM(); if (typeof brCloseMap === 'function') brCloseMap();
  // empty 5-slot inventory — no weapons / ammo / cigars / JD / grenades until you loot them
  player.overheal = 0; player.cigar = 0; player.grenades = 0; player.impulses = 0; player.lethals = 0;
  player.jdBottles = 0; player.secondChance = false; brCurRarity = null;
  saberMode = false; saberBlocking = false;
  ggSetKarambit(true);                                    // spawn holding the melee weapon (the 5 slots start empty; loot to fill them)
  BR.startCount = Math.max(brAliveCount(), 1);
  if (el('streakBar')) el('streakBar').style.display = 'none';
  if (typeof brSpawnLoot === 'function') brSpawnLoot();   // stage 2: scatter loot across the island
  if (typeof brInitZone === 'function') brInitZone();      // stage 3: arm the shrinking zone (full island first)
  if (typeof brBeginDrop === 'function') brBeginDrop();    // stage 4: open on the transport plane
  brGunshots.length = 0; const mm = el('brMinimap'); if (mm) mm.style.display = brMinimapOn ? 'block' : 'none';   // minimap
  brHudShow(true); updateBRHud();
}
function brEnd() { BR.active = false; BR.phase = 'play'; if (BR.drop) { if (BR.drop.chute) { scene.remove(BR.drop.chute); disposeGroup(BR.drop.chute); } if (BR.drop.plane) { scene.remove(BR.drop.plane); disposeGroup(BR.drop.plane); } BR.drop = null; } brHudShow(false); brSpectating = false; brZip = null; if (typeof brHideHeldVM === 'function') brHideHeldVM(); if (typeof brCloseMap === 'function') brCloseMap(); const sp = el('brSpec'); if (sp) sp.style.display = 'none'; const mm = el('brMinimap'); if (mm) mm.style.display = 'none'; const hb = el('brHotbar'); if (hb) hb.style.display = 'none'; const dh = el('brDropHud'); if (dh) dh.style.display = 'none'; if (typeof brClearLoot === 'function') brClearLoot(); if (typeof brClearZone === 'function') brClearZone(); }
function brHudShow(on) { const h = el('brHud'); if (h) h.style.display = on ? 'block' : 'none'; }
function brEliminate(name) {                              // record an elimination + crown the winner when one remains
  if (!BR.active) return;
  brEliminated.push(name || '?'); brElimLog.push({ name: name || '?', t: BR.t });
  updateBRHud();
  if (brAliveCount() <= 1 && (!NET.active || NET.isHost)) {
    let winner = null;
    if (player.alive) winner = NET.active ? NET.selfName : 'YOU';
    else { const b = bots.find(x => x.alive && !x.dying); winner = b ? b.name : null; if (NET.active) NET.players.forEach(p => { if (p.alive) winner = p.name; }); }
    finishMatch({ winner: winner, br: true });
  }
}
function brOnPlayerDeath() {                              // BR: no respawn — record placement, then spectate the rest
  BR.placement = brAliveCount() + 1;                      // player.alive is already false here, so aliveCount excludes you
  showCenterBanner('ELIMINATED — ' + ordinal(BR.placement) + ' PLACE', '#ff6a6a', 3000);
  if (typeof brDropAllOnDeath === 'function') brDropAllOnDeath();   // 5-slot: spill all carried items as loot for others
  brHideHeldVM();
  brCloseMap();
  brEliminate(NET.active ? NET.selfName : 'YOU');         // may finish the match if you were the 2nd-last alive
  if (!gameState.over) {                                  // watch the survivors until one remains -> results
    brSpectating = true; brSpecFree = false; brSpecBlend = 0; brSpecFromCam.copy(camera.position);
    // first target = the killer (nearest living bot to the death spot is a clean proxy in solo)
    const list = brSpecList(); brSpecIdx = 0; let bd = Infinity;
    list.forEach((t, i) => { const d = t.pos.distanceTo(player.pos); if (d < bd) { bd = d; brSpecIdx = i; } });
    brSpecCur = list[brSpecIdx] || null;
  }
}
function brUpdate(dt) {
  if (!BR.active) return;
  BR.t += dt;
  if (typeof brUpdateLoot === 'function') brUpdateLoot(dt);   // stage 2: loot bob + pickup
  if (typeof brUpdateZone === 'function') brUpdateZone(dt);   // stage 3: shrink + OOB damage
  if (brSpectating && typeof brUpdateSpectator === 'function') brUpdateSpectator(dt);   // post-death camera (solo)
  if (typeof brUpdateHeldVM === 'function') brUpdateHeldVM(dt);   // 5-slot: show held consumable / hide gun for empty hands
  if (island && island.fireflies) island.fireflies.material.opacity = dnStarF * (0.5 + 0.3 * Math.sin(BR.t * 2.2));   // glow + gently twinkle at night, hidden by day
  if (brMapOpen) brDrawMap();
  if (brMinimapOn) brDrawMinimap();
  updateBRHud();
}
function brResultsTableHTML() {    // placement table for the BR results screen (PLACE / PLAYER / SURVIVED)
  const winner = (_matchResult && _matchResult.winnerName) || (player.alive ? 'YOU' : '—');
  const rows = [{ place: 1, name: winner, t: BR.t }];
  for (let i = brElimLog.length - 1, p = 2; i >= 0; i--, p++) rows.push({ place: p, name: brElimLog[i].name, t: brElimLog[i].t });
  const fmt = s => { s = Math.max(0, Math.round(s)); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); };
  const selfN = NET.active ? NET.selfName : 'YOU';
  let h = '<table style="width:100%; border-collapse:collapse; font:600 14px \'Segoe UI\',sans-serif; color:#dfe7f0;"><tr style="color:#9fb0c0; font-size:12px;"><th style="text-align:left; padding:4px 8px;">#</th><th style="text-align:left; padding:4px 8px;">PLAYER</th><th style="text-align:right; padding:4px 8px;">SURVIVED</th></tr>';
  rows.forEach(r => { const me = (r.name === selfN || r.name === 'YOU'); h += '<tr style="' + (me ? 'background:rgba(255,211,74,0.16);' : (r.place === 1 ? 'background:rgba(58,160,255,0.12);' : '')) + '"><td style="padding:4px 8px; font-weight:800; color:' + (r.place === 1 ? '#ffd34a' : '#cfe0f0') + ';">' + ordinal(r.place) + '</td><td style="padding:4px 8px;' + (me ? 'color:#ffd34a; font-weight:800;' : '') + '">' + (r.name || '—') + (me ? ' (you)' : '') + (r.place === 1 ? ' 👑' : '') + '</td><td style="padding:4px 8px; text-align:right;">' + fmt(r.t) + '</td></tr>'; });
  return h + '</table>';
}
function brUpdateSpectator(dt) {   // polished spectator: TPS over-shoulder follow OR free-cam; L/R-click cycle; SPACE toggles
  const list = brSpecList(), sp = el('brSpec');
  if (!list.length) { if (sp) sp.style.display = 'none'; brSpecCur = null; return; }
  brSpecIdx = ((brSpecIdx % list.length) + list.length) % list.length;
  const t = list[brSpecIdx]; brSpecCur = t;
  if (camera.fov !== DEFAULT_FOV) { camera.fov = DEFAULT_FOV; camera.updateProjectionMatrix(); }
  camera.rotation.order = 'YXZ'; camera.rotation.y = yaw; camera.rotation.x = pitch;
  if (brSpecFree) {   // FREE CAMERA: fly with WASD (relative to look), SHIFT = faster, mouse look
    const cd = new THREE.Vector3(); camera.getWorldDirection(cd); const r = horizontalRight();
    const mv = new THREE.Vector3();
    if (kbDown('moveForward')) mv.add(cd); if (kbDown('moveBackward')) mv.sub(cd);
    if (kbDown('moveRight')) mv.add(new THREE.Vector3(r.x, 0, r.z)); if (kbDown('moveLeft')) mv.sub(new THREE.Vector3(r.x, 0, r.z));
    if (mv.lengthSq() > 0) mv.normalize();
    brFreePos.addScaledVector(mv, ((keys['ShiftLeft'] || keys['ShiftRight']) ? 65 : 28) * dt);
    clampToMap(brFreePos, 1); brFreePos.y = Math.max(2, Math.min(110, brFreePos.y));
    camera.position.copy(brFreePos);
  } else {   // THIRD-PERSON over-the-shoulder follow (mouse orbits; smooth tracking)
    const desired = new THREE.Vector3(t.pos.x + Math.sin(yaw) * 6, t.pos.y + 2.8, t.pos.z + Math.cos(yaw) * 6);
    brSpecBlend = Math.min(1, brSpecBlend + dt);
    if (brSpecBlend < 1) camera.position.lerpVectors(brSpecFromCam, desired, brSpecBlend < 0 ? 0 : brSpecBlend);   // 1s ease from the death position
    else camera.position.lerp(desired, Math.min(1, dt * 6));
    camera.lookAt(t.pos.x, t.pos.y + 1.5, t.pos.z);
  }
  if (sp) { sp.style.display = 'block'; sp.innerHTML = brSpecHudHtml(t); }
}
function brSpecHudHtml(t) {
  const wk = t.weaponKey || t.weapon, wn = (wk && WEAPONS[wk]) ? WEAPONS[wk].name : '—', hp = Math.max(0, Math.round(t.health || 0));
  const mode = brSpecFree ? '🎥 FREE CAMERA' : '👁 SPECTATING: <b>' + (t.name || 'Player') + '</b>';
  return '<div style="font:800 18px \'Segoe UI\',sans-serif; color:#9fd0ff;">' + mode + '</div>' +
    (brSpecFree ? '' : '<div style="font:700 13px \'Segoe UI\',sans-serif; color:#dfe7f0; margin-top:2px;">🔫 ' + wn + ' &nbsp; ❤ ' + hp + '</div>') +
    '<div style="font:600 11px \'Segoe UI\',sans-serif; color:#aebdcc; margin-top:4px;">L-CLICK: prev &nbsp;•&nbsp; R-CLICK: next &nbsp;•&nbsp; SPACE: ' + (brSpecFree ? 'follow' : 'free cam') + '</div>';
}
function brSpecCycle(d) { if (!brSpectating) return; const n = brSpecList().length; if (!n) return; brSpecIdx = ((brSpecIdx + d) % n + n) % n; brSpecBlend = 1; brSpecFree = false; }
function brSpecToggleFree() { if (!brSpectating) return; brSpecFree = !brSpecFree; if (brSpecFree) brFreePos.copy(camera.position); }
let _brCompassBuilt = false;
function updateBRCompass() {
  const strip = el('brCompassStrip'); if (!strip) return;
  if (!_brCompassBuilt) {   // build a scrolling cardinal strip once (-180°..+540° so it never shows a gap)
    _brCompassBuilt = true; const names = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW']; let h = '';
    for (let d = -180; d <= 540; d += 45) { const nm = names[(((d % 360) + 360) % 360) / 45 | 0], major = (((d % 360) + 360) % 360) % 90 === 0; h += '<span style="position:absolute; left:' + ((d + 180) * 2) + 'px; transform:translateX(-50%); color:' + (major ? '#fff' : '#9fb0c0') + '; font:' + (major ? '800 15px' : '600 11px') + " 'Segoe UI',sans-serif; text-shadow:0 1px 3px #000;\">" + nm + '</span>'; }
    strip.innerHTML = h;
  }
  const fwd = horizontalForward(); let heading = Math.atan2(fwd.x, -fwd.z) * 180 / Math.PI;   // 0=N(-Z) 90=E(+X) 180=S 270=W
  heading = (heading % 360 + 360) % 360;
  strip.style.transform = 'translateX(' + (150 - (heading + 180) * 2) + 'px)';
}
function updateBRHud() {
  const a = el('brAlive'); if (a) a.textContent = brAliveCount();
  const s = el('brStart'); if (s) s.textContent = BR.startCount;
  const k = el('brKills'); if (k) k.textContent = gameState.kills || 0;                                                   // top-right: your kills this match
  const tm = el('brTime'); if (tm) { const sec = Math.max(0, Math.round(BR.t)); tm.textContent = Math.floor(sec / 60) + ':' + ('0' + (sec % 60)).slice(-2); }   // survival time MM:SS
  updateBRCompass();
  const it = el('brItems'); if (it) it.style.display = 'none';   // (Part 3) redundant consumable counters removed — they live in the hotbar now
  const hb = el('brHotbar'); if (hb) { hb.style.display = 'flex'; hb.innerHTML = brHotbarHtml(); }
  const wh = el('brWeapons'); if (wh) wh.innerHTML = brHeldDetailHtml();
  if (typeof brUpdateZoneHud === 'function') brUpdateZoneHud();   // stage 3
}

/* ----------------- BATTLE ROYALE — LOOT ECONOMY (3-tier rarity) -----------------
   Ground loot glows in its rarity colour. Weapons carry attachment configs (common
   = iron + std mag; rare = an optic + extended mag + laser; legendary = best optic +
   drum + laser + flashlight). Picking up a weapon with empty hands auto-equips it;
   carrying one shows an E-to-swap prompt (the old gun drops as loot). Reuses the
   existing weapon customization (liveCfg / buildGunModel / ADS) so attachments just work.
   (Small legendary stat-bonus + the full downed/F self-revive are later refinements.) */
const BR_LOOT = [];
const BR_RAR = { common: { c: 0xd2d8de, name: 'COMMON' }, rare: { c: 0x3aa0ff, name: 'RARE' }, legendary: { c: 0xffc83a, name: 'LEGENDARY' } };
const BR_WPN_POOL = Object.keys(WPN_CLASS);   // every customizable gun
let brCurRarity = null, brSwapTarget = null;
function brRollRarity() { const r = Math.random(); return r < 0.65 ? 'common' : (r < 0.93 ? 'rare' : 'legendary'); }
function brWeaponCfg(key, rar) {
  if (!isCustomizable(key)) return null;
  const cls = WPN_CLASS[key], S = CLASS_SIGHTS[cls] || ['iron'], M = CLASS_MAGS[cls] || ['standard'], d = Object.assign({}, defaultCfg(key));
  if (rar === 'common') { d.sight = S[0]; d.magazine = 'standard'; d.laser = 'off'; d.flashlight = 'off'; }
  else if (rar === 'rare') { d.sight = S[Math.min(1, S.length - 1)]; d.magazine = M.indexOf('extended') >= 0 ? 'extended' : M[0]; d.laser = 'green'; d.flashlight = 'off'; }
  else { d.sight = S[S.length - 1]; d.magazine = M.indexOf('drum') >= 0 ? 'drum' : M[M.length - 1]; d.laser = 'green'; d.flashlight = 'on'; }
  return d;
}
function brLootMesh(kind, rar, key, cfg) {
  const g = new THREE.Group(); let body, col = BR_RAR[rar] ? BR_RAR[rar].c : 0xd2d8de;
  if (kind === 'weapon') {   // naked ground weapon = the real low-poly gun model, scaled up + laid on its side
    try { const built = buildWeaponMesh(key, undefined, cfg); body = built.g; body.scale.setScalar(1.7); body.rotation.z = Math.PI / 2; body.position.y = 0.15; }
    catch (e) { body = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.36, 0.46), flatMat(0x2a2e34)); body.rotation.z = 0.18; }
  }
  else if (kind === 'ammo') { col = 0x8aa0b0; body = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.5, 0.7), flatMat(0x5a6a3a)); }
  else if (kind === 'cigar') { col = 0xd98a3a; body = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.3, 0.5), flatMat(0xb5742a)); }
  else if (kind === 'jd') { col = 0xc9a24a; body = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.2, 0.7, 6), flatMat(0x3a2a1a)); }
  else if (kind === 'impulse') { col = 0x7fe0ff; body = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.6, 8), flatMat(0x2a6a8a)); }
  else if (kind === 'lethal') { col = 0xff8a4a; body = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.5, 0.5), flatMat(0x4a5a2a)); }
  else { col = 0xffc83a; body = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, 0.7, 6), flatMat(0xe8e8f0)); }   // second chance (syringe)
  g.add(body);
  // (Refinement) NO rarity glow/halo/beam on loot — rarity is read off the weapon model itself (attachments). col retained above only for legacy callers.
  void col;
  return g;
}
function brAddLoot(wx, wz, kind, forceRar) {
  let rar = forceRar || 'common', key = null, cfg = null;
  if (kind === 'weapon') { rar = forceRar || brRollRarity(); key = BR_WPN_POOL[(Math.random() * BR_WPN_POOL.length) | 0]; cfg = brWeaponCfg(key, rar); }
  else if (kind === 'second') rar = 'legendary';
  const y = brSafeY(wx, wz) + 0.35, g = brLootMesh(kind, rar, key, cfg); g.position.set(wx, y, wz); scene.add(g);   // sit just above the floor (player-walkable surface), never the roof
  const item = { kind, rarity: rar, key, cfg, mesh: g, pos: new THREE.Vector3(wx, y, wz), taken: false };
  BR_LOOT.push(item);
  if (brLootDebug) console.log('[T][LOOT] ' + kind + ' ' + rar + ' @' + wx.toFixed(0) + ',' + y.toFixed(1) + ',' + wz.toFixed(0) + (brIsIndoors(wx, wz) ? ' INDOOR' : ' open'));
  return item;
}
// --- CHESTS (Part 5): wooden treasure chest, lid opens on E, contents float out by rarity ---
function brChestMesh(rar) {
  const g = new THREE.Group(), wood = 0x6a4a2a, band = 0x33333a;
  const base = new THREE.Mesh(new THREE.BoxGeometry(1.7, 1.0, 1.15), flatMat(wood)); base.position.y = 0.5; g.add(base);
  [-0.6, 0.6].forEach(x => { const b = new THREE.Mesh(new THREE.BoxGeometry(0.14, 1.04, 1.22), flatMat(band)); b.position.set(x, 0.5, 0); g.add(b); });
  const lid = new THREE.Group();
  const lb = new THREE.Mesh(new THREE.BoxGeometry(1.72, 0.42, 1.16), flatMat(wood)); lb.position.set(0, 0.21, 0.58); lid.add(lb);
  [-0.6, 0.6].forEach(x => { const b = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.44, 1.2), flatMat(band)); b.position.set(x, 0.21, 0.58); lid.add(b); });
  lid.position.set(0, 1.0, -0.58); g.add(lid); g.userData.lid = lid;
  // (Refinement) NO rarity glow/halo/beam on chests — all chests look like plain wooden chests; rarity is revealed by the loot inside.
  return g;
}
function brAddChest(wx, wz, rar, atY) {
  const y = (atY != null) ? atY : brSafeY(wx, wz), g = brChestMesh(rar); g.position.set(wx, y, wz); g.rotation.y = Math.random() * 6; scene.add(g);   // chest base sits flush on the floor (or an explicit Y for upper floors)
  BR_LOOT.push({ chest: true, open: false, openT: 0, spawned: false, rarity: rar, mesh: g, lid: g.userData.lid, pos: new THREE.Vector3(wx, y, wz), taken: false });
  if (brLootDebug) console.log('[T][LOOT] chest ' + rar + ' @' + wx.toFixed(0) + ',' + y.toFixed(1) + ',' + wz.toFixed(0) + (brIsIndoors(wx, wz) ? ' INDOOR' : ' open'));
}
function brOpenChest(L) { if (L.open) return; L.open = true; if (typeof sfxAxePickup === 'function') sfxAxePickup(L.pos); brPickupToast('CHEST OPENED', L.rarity !== 'common' ? BR_RAR[L.rarity].c : '#cfe0f0'); }
function brUpdateChestAnim(L, dt) {
  if (!L.chest || !L.open) return;
  if (!L.closing && L.openT < 1) { L.openT = Math.min(1, L.openT + dt * 1.5); if (L.lid) L.lid.rotation.x = -1.45 * L.openT; }   // lid swings open
  if (L.openT >= 0.55 && !L.spawned) { L.spawned = true; L.contents = brSpawnChestContents(L); L.contentsT = 30; }               // fan the loot out
  if (L.spawned && !L.closing) {
    L.contentsT -= dt;
    const anyLeft = L.contents.some(c => !c.taken);
    if (!anyLeft || L.contentsT <= 0) {                                                                                          // all taken OR 30s elapsed -> despawn leftovers + close lid
      if (L.contentsT <= 0) L.contents.forEach(c => { if (!c.taken) { c.taken = true; if (c.mesh) { scene.remove(c.mesh); disposeGroup(c.mesh); } } });
      L.closing = true;
    }
  }
  if (L.closing && L.openT > 0) { L.openT = Math.max(0, L.openT - dt * 2); if (L.lid) L.lid.rotation.x = -1.45 * L.openT; }       // lid swings back shut (stays "open"=looted)
}
function brSpawnChestContents(L) {
  const rar = L.rarity, items = [];
  if (rar === 'legendary') { items.push(['weapon', 'legendary'], ['ammo'], ['ammo'], ['ammo'], ['cigar'], ['cigar'], ['jd'], ['jd'], [Math.random() < 0.5 ? 'impulse' : 'lethal']); if (Math.random() < 0.5) items.push([Math.random() < 0.5 ? 'impulse' : 'lethal']); if (Math.random() < 0.15) items.push(['second']); }
  else if (rar === 'rare') { items.push(['weapon', 'rare'], ['ammo'], ['ammo'], ['cigar'], ['jd']); if (Math.random() < 0.5) items.push([Math.random() < 0.5 ? 'impulse' : 'lethal']); if (Math.random() < 0.2) items.push([Math.random() < 0.35 ? 'second' : (Math.random() < 0.5 ? 'cigar' : 'jd')]); }
  else { items.push(['weapon', 'common'], ['ammo']); if (Math.random() < 0.6) items.push(['ammo']); if (Math.random() < 0.5) items.push([Math.random() < 0.5 ? 'cigar' : 'jd']); if (Math.random() < 0.3) items.push([Math.random() < 0.5 ? 'impulse' : 'lethal']); }
  const out = [];
  items.forEach((it, i) => { const a = i / items.length * Math.PI * 2, r = 1.6; const o = brAddLoot(L.pos.x + Math.cos(a) * r, L.pos.z + Math.sin(a) * r, it[0], it[1]); if (o) { o.fromChest = true; out.push(o); } });
  return out;
}
function brClearLoot() { BR_LOOT.forEach(L => { if (L.mesh) { scene.remove(L.mesh); disposeGroup(L.mesh); } }); BR_LOOT.length = 0; brSwapTarget = null; }
let brLootDebug = false;   // set true to log every loot spawn position (Part 1 diagnostics)
function brCeilingY(x, z) {   // height of the lowest ceiling/roof slab overhead at (x,z), or Infinity if open sky
  let roofY = Infinity;
  for (const s of solids) { if (x > s.min.x && x < s.max.x && z > s.min.z && z < s.max.z && s.min.y >= 2.4 && s.min.y < roofY) roofY = s.min.y; }
  return roofY;
}
function brIsIndoors(x, z) { return brCeilingY(x, z) !== Infinity; }   // (Spec A Part 3) indoors = a roof / upper floor sits overhead
function brPlaceY(x, z) {   // (Part 1) the floor the PLAYER stands on at (x,z): the highest solid below the lowest ceiling (or the terrain if open) — never the roof
  const roofY = brCeilingY(x, z);
  return groundHeightAt(x, z, roofY === Infinity ? 2.5 : roofY - 0.6);   // feetY just under the ceiling excludes the roof itself, so we get the room's floor
}
function brSafeY(x, z) {   // floor placement + safety: if the item body would sit inside a solid, lift it onto that surface (capped, so it never climbs a tall wall)
  let y = brPlaceY(x, z);
  for (let i = 0; i < 5; i++) { let blk = null; for (const s of solids) { if (x > s.min.x && x < s.max.x && z > s.min.z && z < s.max.z && y + 0.5 > s.min.y && y + 0.5 < s.max.y) { blk = s; break; } } if (!blk || blk.max.y > y + 3.5) break; y = blk.max.y; }
  return y;
}
function brPointInSolid(x, y, z) { for (const s of solids) { if (x > s.min.x && x < s.max.x && z > s.min.z && z < s.max.z && y > s.min.y && y < s.max.y) return true; } return false; }
function brIndoorPoint(cxp, czp, maxR) {   // sample for a point in a real, walkable room: roofed, with headroom, not buried in geometry
  for (let t = 0; t < 90; t++) {
    const a = Math.random() * 6.28, r = 2 + Math.random() * maxR, x = cxp + Math.cos(a) * r, z = czp + Math.sin(a) * r;
    const roofY = brCeilingY(x, z); if (roofY === Infinity) continue;          // must be roofed (indoors)
    const fy = brPlaceY(x, z); if (roofY - fy < 1.8) continue;                 // need standing headroom (a room, not a crawlspace / squeezed slab gap)
    if (brPointInSolid(x, fy + 0.9, z)) continue;                              // reject points buried inside walls / solid masses (e.g. the temple pyramid)
    return [x, z];
  }
  return null;
}
// (Part 1) ALL loot lives in CHESTS, placed inside roofed rooms — no naked ground weapons/consumables. Player drops/death loot are the only loose items.
const POI_CHESTS = { 'PARADISE COVE': [15, 20], 'LAGOON RESORT': [12, 15], 'ANCIENT RUINS': [10, 14], 'CAMP DELTA': [18, 22], "HARBOR'S EDGE": [15, 18], 'CLIFF SETTLEMENT': [15, 18], 'RUSTED HULL': [9, 12], 'AIRSTRIP': [14, 18], "MILLIONAIRE'S RETREAT": [16, 20] };   // ship/mansion: fewer ground-floor random chests; fixed chests cover their upper levels   // mansion: ground-floor random chests; +8 fixed chests placed on its upper floors / special rooms
const POI_LEG = { 'ANCIENT RUINS': 1.8, 'CAMP DELTA': 1.6, 'RUSTED HULL': 1.6, "MILLIONAIRE'S RETREAT": 2.0, 'AIRSTRIP': 1.4 };   // higher-risk POIs roll more legendaries (strategic placement, approximated)
function brSpawnLoot() {
  brClearLoot(); if (!island) return;
  let indoorCount = 0, placedCount = 0, last = {};
  island.pois.forEach(poi => {
    const cxp = island.cx + poi.lx, czp = island.cz + poi.lz, rng = POI_CHESTS[poi.name] || [12, 16], legMul = POI_LEG[poi.name] || 1;
    const nChest = rng[0] + (Math.random() * (rng[1] - rng[0] + 1) | 0);
    for (let i = 0; i < nChest; i++) {
      let p = null; for (let tries = 0; tries < 4 && !p; tries++) { const c = brIndoorPoint(cxp, czp, 30); if (c && (!last[poi.name] || Math.hypot(c[0] - last[poi.name][0], c[1] - last[poi.name][1]) > 3)) p = c; else if (c && tries === 3) p = c; }
      if (!p) continue; last[poi.name] = p; placedCount++; if (brIsIndoors(p[0], p[1])) indoorCount++;
      const rr = Math.random();   // 70% common / 23% rare / 7% legendary
      let tier = rr < 0.70 ? 'common' : (rr < 0.93 ? 'rare' : 'legendary');
      if (tier === 'rare' && Math.random() < (legMul - 1) * 0.15) tier = 'legendary';   // high-risk POIs upgrade some rares -> more legendaries
      brAddChest(p[0], p[1], tier);
    }
  });
  BR._lootIndoorRatio = placedCount ? indoorCount / placedCount : 1;   // verification hook
  // Enclosed non-POI sources (wrecks / shipwreck / plane / vine ruins / tent camps / caves / secret rooms) — all chests
  (island.lootSpots || []).forEach(s => { brAddChest(island.cx + s.lx, island.cz + s.lz, s.rar); });
  (island.caveSpots || []).forEach(cv => { const n = 4 + (Math.random() * 2 | 0); for (let i = 0; i < n; i++) brAddChest(island.cx + cv[0] + (i - 2) * 2.4, island.cz + cv[1] + (i % 2) * 2.4, Math.random() < 0.35 ? 'rare' : (Math.random() < 0.1 ? 'legendary' : 'common')); });   // 4-5 cave chests
  (island.secretSpots || []).forEach(s => { brAddChest(island.cx + s.lx, island.cz + s.lz, s.rar || 'legendary'); brAddChest(island.cx + s.lx + 3, island.cz + s.lz, 'rare'); });   // secret rooms: a legendary + a rare
  (island.fixedChests || []).forEach(c => brAddChest(c.x, c.z, c.rar, c.y));   // explicit upper-floor / special-room chests (mansion etc.)
}
// --- BR weapon slots: two primaries (1/2) + the melee (3). Each slot's ammo lives in weaponState[key]. ---
function brWeaponMags(rar, key) {     // reserve magazines by rarity (snipers/DMRs/LMGs carry fewer)
  let m = rar === 'legendary' ? 4 : (rar === 'rare' ? 3 : 2);
  const cls = WPN_CLASS[key]; if (cls === 'sniper') m = Math.max(1, m - 2); else if (cls === 'dmr' || cls === 'lmg') m = Math.max(1, m - 1);
  return m;
}
function brSetupWeaponAmmo(key, cfg, rar, stored) {   // finite ammo: 1 mag loaded + N mags reserve (or restore a dropped weapon's remaining ammo)
  if (isCustomizable(key) && cfg && _baseMag[key]) WEAPONS[key].mag = Math.round(_baseMag[key] * ((ATT_MAGS[cfg.magazine] || ATT_MAGS.standard).mult));
  const ws = weaponState[key]; if (!ws) return;
  ws.reloading = 0; ws.shellReload = false;
  if (stored) { ws.ammo = stored.ammo; ws.reserve = stored.reserve; }
  else { ws.ammo = WEAPONS[key].mag; ws.reserve = WEAPONS[key].mag * brWeaponMags(rar, key); }
}
function brCount(t) { return t === 'cigar' ? (player.cigar || 0) : t === 'jd' ? (player.jdBottles || 0) : t === 'impulse' ? (player.impulses || 0) : t === 'lethal' ? (player.lethals || 0) : t === 'second' ? (player.secondChance ? 1 : 0) : 0; }
function brSetCount(t, v) { if (t === 'cigar') player.cigar = v; else if (t === 'jd') player.jdBottles = v; else if (t === 'impulse') player.impulses = v; else if (t === 'lethal') player.lethals = v; else if (t === 'second') player.secondChance = v > 0; }
function brSlotOfType(t) { return brInv.findIndex(it => it && it.t === t); }
function brLootCol(t) { return t === 'cigar' ? '#d98a3a' : t === 'jd' ? '#ffd98a' : t === 'impulse' ? '#7fe0ff' : t === 'lethal' ? '#ff8a4a' : t === 'second' ? '#ffc83a' : '#fff'; }
function brSyncHeldAmmo() { const it = brHeldWeapon(); if (it && weaponState[it.key]) { it.ammo = weaponState[it.key].ammo; it.reserve = weaponState[it.key].reserve; } }   // write the live (shared) ammo back into the held slot
function brEquipWeaponItem(it) {   // load this slot's cached ammo into the shared weaponState, apply its attachments, then equip
  const key = it.key; ggKarambit = false;
  if (weaponState[key]) { weaponState[key].ammo = (it.ammo != null ? it.ammo : WEAPONS[key].mag); weaponState[key].reserve = (it.reserve != null ? it.reserve : WEAPONS[key].mag * brWeaponMags(it.rar, key)); weaponState[key].reloading = 0; weaponState[key].shellReload = false; }
  if (isCustomizable(key) && it.cfg) { liveCfg[key] = Object.assign({}, it.cfg); buildGunModel(key, it.cfg); }
  ggEquip(key); brHideHeldVM();
}
function brEquipHands() { ggKarambit = false; ggEquip(KARAMBIT_KEY); }   // park on the inert melee key; brUpdateHeldVM hides its model + shows the consumable / empty hands
function brEquipMelee() { brSyncHeldAmmo(); brSel = -1; ggSetKarambit(true); brHideHeldVM(); updateHUD(); }
function brSelect(i) {
  if (i < 0 || i > 4) return;
  if (i === brSel && !ggKarambit && brInv[i] && brInv[i].t !== 'weapon') { brUseSelected(); return; }   // press the held slot's key again -> USE the consumable
  brSyncHeldAmmo(); brSel = i; ggKarambit = false;
  const it = brInv[i];
  if (it && it.t === 'weapon') brEquipWeaponItem(it); else brEquipHands();
  updateHUD();
}
function brSelectAfterEmpty(i) { if (brSel === i) { const n = brInv.findIndex(x => x); if (n >= 0) brSelect(n); else brEquipMelee(); } }
function brGiveWeapon(key, cfg, rar, stored) {   // pick up a weapon: fill an empty slot, else swap the held item
  brSetupWeaponAmmo(key, cfg, rar, stored); const ws = weaponState[key];
  const item = { t: 'weapon', key, cfg: cfg ? Object.assign({}, cfg) : null, rar: rar || 'common', ammo: ws ? ws.ammo : WEAPONS[key].mag, reserve: ws ? ws.reserve : 0 };
  const e = brFirstEmpty();
  if (e >= 0) { brInv[e] = item; if (ggKarambit || !brHeldWeapon()) brSelect(e); else updateHUD(); }   // auto-equip only if not already holding a gun
  else { const i = (brSel >= 0 && brSel < 5) ? brSel : 0; brDropSlotAll(i); brInv[i] = item; brSelect(i); }   // inventory full -> drop the held item, take the weapon
}
function brTakeConsumable(t) {   // stack into an existing slot, else take a new slot (returns false if no room / full)
  const lim = BR_STACK[t] || 1;
  if (brSlotOfType(t) < 0) { const e = brFirstEmpty(); if (e < 0) return false; brInv[e] = { t: t }; }
  if (brCount(t) >= lim) return false;
  brSetCount(t, brCount(t) + 1); return true;
}
function brCanTake(t) { const lim = BR_STACK[t] || 1; return (brSlotOfType(t) >= 0) ? brCount(t) < lim : brFirstEmpty() >= 0; }
function brSpawnDroppedWeapon(wx, wz, it) {
  const y = brSafeY(wx, wz) + 0.35, g = brLootMesh('weapon', it.rar || 'common', it.key, it.cfg); g.position.set(wx, y, wz); scene.add(g);
  BR_LOOT.push({ kind: 'weapon', rarity: it.rar || 'common', key: it.key, cfg: it.cfg, mesh: g, pos: new THREE.Vector3(wx, y, wz), taken: false, ammo: it.ammo, reserve: it.reserve });
}
function brSpawnDroppedItem(wx, wz, t) {
  const y = brSafeY(wx, wz) + 0.35, g = brLootMesh(t, t === 'second' ? 'legendary' : 'common'); g.position.set(wx, y, wz); scene.add(g);
  BR_LOOT.push({ kind: t, rarity: t === 'second' ? 'legendary' : 'common', mesh: g, pos: new THREE.Vector3(wx, y, wz), taken: false });
}
function brDropSlotAll(i) {   // drop a whole slot (the weapon, or the entire consumable stack) as loot
  const it = brInv[i]; if (!it) return;
  const jit = () => [player.pos.x + (Math.random() - 0.5) * 1.8, player.pos.z + (Math.random() - 0.5) * 1.8];
  if (it.t === 'weapon') { if (brHeldWeapon() === it) brSyncHeldAmmo(); const p = jit(); brSpawnDroppedWeapon(p[0], p[1], it); }
  else { const n = brCount(it.t); for (let k = 0; k < n; k++) { const p = jit(); brSpawnDroppedItem(p[0], p[1], it.t); } brSetCount(it.t, 0); }
  brInv[i] = null;
}
function brDropHeldItem() {   // G / X: drop ONE of the currently-held item
  if (ggKarambit) return; const i = brSel; if (i < 0 || !brInv[i]) return;
  const it = brInv[i], p = [player.pos.x + (Math.random() - 0.5) * 1.6, player.pos.z + (Math.random() - 0.5) * 1.6];
  if (it.t === 'weapon') { brSyncHeldAmmo(); brSpawnDroppedWeapon(p[0], p[1], it); brInv[i] = null; }
  else { brSpawnDroppedItem(p[0], p[1], it.t); brSetCount(it.t, brCount(it.t) - 1); if (brCount(it.t) <= 0) brInv[i] = null; }
  if (!brInv[i]) brSelectAfterEmpty(i); else updateHUD();
}
function brDropAllOnDeath() { for (let i = 0; i < 5; i++) if (brInv[i]) brDropSlotAll(i); }
function brWeaponAction(act) {   // BR slot select / wheel / melee / drop
  if (act === 'weapon1') brSelect(0);
  else if (act === 'weapon2') brSelect(1);
  else if (act === 'karambit') brSelect(2);
  else if (act === 'brSlot4') brSelect(3);
  else if (act === 'brSlot5') brSelect(4);
  else if (act === 'melee') brEquipMelee();
  else if (act === 'dropItem' || act === 'dropWeapon') brDropHeldItem();
  else {   // wheel: cycle non-empty slots + melee
    const order = []; for (let i = 0; i < 5; i++) if (brInv[i]) order.push(i); order.push('m');
    let cur = ggKarambit ? order.indexOf('m') : order.indexOf(brSel); if (cur < 0) cur = order.indexOf('m');
    const nx = order[(cur + (act === 'nextWeapon' ? 1 : -1) + order.length) % order.length];
    if (nx === 'm') brEquipMelee(); else brSelect(nx);
  }
}
function brUseType(t) { const s = brSlotOfType(t); if (s < 0 || brCount(t) <= 0) return; brSyncHeldAmmo(); brSel = s; ggKarambit = false; brUseSelected(); }
function brUseSelected() {   // use the held consumable (cigar smoke / JD drink / grenade throw); decrements the stack
  const it = brHeldItem(); if (!it || it.t === 'weapon' || it.t === 'second') return;
  const before = brCount(it.t); let ok = false;
  if (it.t === 'cigar') { useCigar(); ok = brCount('cigar') < before; }
  else if (it.t === 'jd') { ok = brDrinkJD(); }
  else if (it.t === 'impulse') { throwImpulse(); ok = brCount('impulse') < before; }
  else if (it.t === 'lethal') { throwLethal(); ok = brCount('lethal') < before; }
  if (ok) { brHeldUseT = 0.45; if (brCount(it.t) <= 0) { const i = brSel; brInv[i] = null; brSelectAfterEmpty(i); } updateHUD(); }
}
function brTakeLoot(L, label, col) { L.taken = true; if (L.mesh) { scene.remove(L.mesh); disposeGroup(L.mesh); } brPickupToast(label, col); }
function brPickupToast(label, col) { const p = el('brPickup'); if (!p) return; p.textContent = 'PICKED UP: ' + label; p.style.color = col || '#fff'; p.style.transition = 'none'; p.style.opacity = '1'; clearTimeout(p._t); requestAnimationFrame(() => { p.style.transition = 'opacity 1.4s'; }); p._t = setTimeout(() => { p.style.opacity = '0'; }, 900); }
function brPickWeapon(L) {
  brGiveWeapon(L.key, L.cfg, L.rarity, (L.ammo != null) ? { ammo: L.ammo, reserve: L.reserve } : null);
  brTakeLoot(L, BR_RAR[L.rarity].name + ' ' + (WEAPONS[L.key] ? WEAPONS[L.key].name : 'WEAPON'), BR_RAR[L.rarity].c);
}
function brTrySwapLoot() {
  if (!BR.active || !brSwapTarget || brSwapTarget.taken) return false;
  if (brSwapTarget.chest) { brOpenChest(brSwapTarget); brSwapTarget = null; return true; }   // E opens a chest
  brPickWeapon(brSwapTarget); brSwapTarget = null; return true;                               // E swaps a weapon (both slots full)
}
function brRefillAmmo() {   // ammo box: +2 magazines of reserve to EVERY carried weapon (held one updates its live state too)
  brInv.forEach(it => {
    if (!it || it.t !== 'weapon' || !WEAPONS[it.key]) return;
    const add = WEAPONS[it.key].mag * 2;
    if (brHeldWeapon() === it && weaponState[it.key]) { if (weaponState[it.key].reserve !== Infinity) weaponState[it.key].reserve += add; }
    else it.reserve = (it.reserve === Infinity ? 0 : (it.reserve || 0)) + add;
  });
  brSyncHeldAmmo(); updateHUD();
}
function brDrinkJD() {   // returns true if a bottle was consumed (caller decrements the slot)
  if (!BR.active || (player.jdBottles || 0) <= 0 || player.overheal >= OVERHEAL_MAX || !player.alive) return false;
  player.jdBottles--; player.overheal = OVERHEAL_MAX; flashJD(); return true;   // restore shield (full animation = later polish)
}
function brUpdateLoot(dt) {
  brSwapTarget = null;
  const px = player.pos.x, pz = player.pos.z, py = player.pos.y; let nearestSwap = 1e9;
  for (const L of BR_LOOT) {
    if (L.taken) continue;
    if (typeof brUpdateChestAnim === 'function') brUpdateChestAnim(L, dt);   // chests: lid-open animation (Part 5)
    if (L.mesh && !L.chest) { L.mesh.rotation.y += dt * 1.2; L.mesh.position.y = L.pos.y + Math.sin(performance.now() * 0.003 + L.pos.x) * 0.12; }
    if (!player.alive) continue;
    const d = Math.hypot(px - L.pos.x, pz - L.pos.z);
    if (d > 2.8 || Math.abs(py - (L.pos.y - 0.9)) > 4) continue;
    if (L.chest) { if (!L.open && d < nearestSwap) { nearestSwap = d; brSwapTarget = L; } continue; }   // chest: E to open (handled below)
    if (L.kind === 'weapon') { if (brFirstEmpty() >= 0) brPickWeapon(L); else if (d < nearestSwap) { nearestSwap = d; brSwapTarget = L; } }   // auto-pickup into an empty slot; else E-swaps the held item
    else if (L.kind === 'ammo') { if (brHasGun()) { brRefillAmmo(); brTakeLoot(L, 'AMMO', '#8aa0b0'); } }
    else if (L.kind === 'cigar' || L.kind === 'jd' || L.kind === 'impulse' || L.kind === 'lethal' || L.kind === 'second') {   // auto-stack consumables into the 5-slot inventory
      if (brCanTake(L.kind)) { brTakeConsumable(L.kind); const m = brItemMeta(L.kind); brTakeLoot(L, m.name + (L.kind === 'second' ? '!' : (brCount(L.kind) > 1 ? ' ×' + brCount(L.kind) : '')), brLootCol(L.kind)); }
    }
  }
  const sp = el('brSwapPrompt');
  if (sp) {
    if (brSwapTarget) {
      sp.style.display = 'block'; const ekey = '<b style="color:#ffe600">' + IM.keyLabel(IM.bind.interact) + '</b>';
      if (brSwapTarget.chest) sp.innerHTML = 'Press ' + ekey + ' to OPEN ' + (brSwapTarget.rarity !== 'common' ? '<b style="color:' + brRarHex(brSwapTarget.rarity) + '">' + BR_RAR[brSwapTarget.rarity].name + '</b> ' : '') + 'CHEST';
      else sp.innerHTML = 'Press ' + ekey + ' to swap for <b style="color:' + brRarHex(brSwapTarget.rarity) + '">' + BR_RAR[brSwapTarget.rarity].name + ' ' + (WEAPONS[brSwapTarget.key] ? WEAPONS[brSwapTarget.key].name : 'weapon') + '</b>';
    } else sp.style.display = 'none';
  }
}
function brRarHex(r) { return '#' + (BR_RAR[r] ? BR_RAR[r].c : 0xffffff).toString(16).padStart(6, '0'); }
function brWeaponAmmoOf(it) {   // {ammo,reserve,out} for a weapon slot — live state for the held one, cached for the rest
  let a, rsv; if (brHeldWeapon() === it && weaponState[it.key]) { a = weaponState[it.key].ammo; rsv = weaponState[it.key].reserve; } else { a = it.ammo; rsv = it.reserve; }
  const inf = (rsv === Infinity); return { ammo: a, reserve: rsv, txt: inf ? '∞' : (a + ' / ' + rsv), out: (!inf && a === 0 && rsv === 0) };
}
// ----- bottom-center HOTBAR: 5 universal slots (weapons/consumables), active outlined, dynamic key labels -----
function brHotbarHtml() {
  let h = '';
  for (let i = 0; i < 5; i++) {
    const it = brInv[i], active = (!ggKarambit && brSel === i && it), keyLbl = IM.keyLabel(brSlotKeyBind(i));
    let inner = '<span style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#5e6b78; font:700 11px \'Segoe UI\',sans-serif;">EMPTY</span>';
    let border = '#3a4451', tip = 'Empty slot';
    if (it && it.t === 'weapon') {
      const col = brRarHex(it.rar || 'common'), am = brWeaponAmmoOf(it), nm = WEAPONS[it.key] ? WEAPONS[it.key].name : it.key;
      border = col;
      inner = '<span style="position:absolute; top:3px; right:5px; font:800 11px \'Segoe UI\',sans-serif; color:' + (am.out ? '#ff5a5a' : '#fff') + ';">' + am.txt + '</span>' +
              '<span style="position:absolute; left:0; right:0; top:24px; text-align:center; font:900 19px \'Segoe UI\',sans-serif; color:' + col + ';">🔫</span>' +
              '<span style="position:absolute; left:0; right:0; bottom:3px; text-align:center; font:700 9px \'Segoe UI\',sans-serif; color:#cfe0f0; overflow:hidden; white-space:nowrap;">' + nm + '</span>';
      tip = (BR_RAR[it.rar] ? BR_RAR[it.rar].name : '') + ' ' + nm + '  ' + am.txt;
    } else if (it) {
      const m = brItemMeta(it.t), cnt = brCount(it.t); border = '#7a6f57';
      inner = (cnt > 1 ? '<span style="position:absolute; top:2px; right:5px; font:800 13px \'Segoe UI\',sans-serif; color:#fff;">×' + cnt + '</span>' : '') +
              '<span style="position:absolute; left:0; right:0; top:20px; text-align:center; font-size:22px;">' + m.icon + '</span>' +
              '<span style="position:absolute; left:0; right:0; bottom:3px; text-align:center; font:700 8px \'Segoe UI\',sans-serif; color:#cfe0f0; overflow:hidden; white-space:nowrap;">' + m.name + '</span>';
      tip = m.name + (cnt > 1 ? ' ×' + cnt : '') + ' — ' + m.desc;
    }
    h += '<div data-brslot="' + i + '" title="' + tip + '" style="position:relative; width:62px; height:62px; border:2px solid ' + border + '; border-radius:7px; background:rgba(10,14,20,' + (active ? '0.92' : '0.62') + ');' +
         (active ? ' box-shadow:0 0 0 2px #ffd34a, 0 0 12px rgba(255,211,74,.6); transform:translateY(-5px);' : '') + ' cursor:pointer; transition:transform .08s;">' + inner +
         '<span style="position:absolute; left:50%; transform:translateX(-50%); bottom:-17px; font:800 10px \'Segoe UI\',sans-serif; color:' + (active ? '#ffd34a' : '#9fb0c0') + '; background:rgba(0,0,0,.5); padding:0 4px; border-radius:3px;">' + keyLbl + '</span></div>';
  }
  // melee chip (separate from the 5 slots; its own key)
  const mk = IM.keyLabel(IM.bind.use), mn = (typeof MELEE_NAMES !== 'undefined' ? MELEE_NAMES[meleeChoice] : 'KNIFE');
  h += '<div title="Melee — ' + mn + '" style="position:relative; width:50px; height:62px; margin-left:10px; border:2px solid ' + (ggKarambit ? '#ffd34a' : '#3a4451') + '; border-radius:7px; background:rgba(10,14,20,' + (ggKarambit ? '0.92' : '0.62') + ');' + (ggKarambit ? ' box-shadow:0 0 10px rgba(255,211,74,.5); transform:translateY(-5px);' : '') + '">' +
       '<span style="position:absolute; left:0; right:0; top:20px; text-align:center; font-size:20px;">🔪</span>' +
       '<span style="position:absolute; left:0; right:0; bottom:3px; text-align:center; font:700 8px \'Segoe UI\',sans-serif; color:#7fe9ff;">MELEE</span>' +
       '<span style="position:absolute; left:50%; transform:translateX(-50%); bottom:-17px; font:800 10px \'Segoe UI\',sans-serif; color:' + (ggKarambit ? '#ffd34a' : '#9fb0c0') + '; background:rgba(0,0,0,.5); padding:0 4px; border-radius:3px;">' + mk + '</span></div>';
  return h;
}
// ----- bottom-right DETAIL panel for whatever is in hand -----
function brHeldDetailHtml() {
  if (ggKarambit) { const mn = (typeof MELEE_NAMES !== 'undefined' ? MELEE_NAMES[meleeChoice] : 'KNIFE'); return '<div style="font:800 19px \'Segoe UI\',sans-serif; color:#7fe9ff;">' + mn + '</div><div style="font:600 11px \'Segoe UI\',sans-serif; color:#9fb0c0;">Melee weapon</div>'; }
  const it = brHeldItem();
  if (!it) return '<div style="font:800 15px \'Segoe UI\',sans-serif; color:#9fb0c0;">EMPTY HANDS</div><div style="font:600 11px \'Segoe UI\',sans-serif; color:#7a8794;">Select a slot (' + IM.keyLabel(IM.bind.weapon1) + '–' + IM.keyLabel(IM.bind.brSlot5) + ')</div>';
  if (it.t === 'weapon') {
    const col = brRarHex(it.rar || 'common'), am = brWeaponAmmoOf(it), nm = WEAPONS[it.key] ? WEAPONS[it.key].name : it.key;
    const cfg = it.cfg || {}, att = []; if (cfg.sight && cfg.sight !== 'iron') att.push(cfg.sight); if (cfg.magazine && cfg.magazine !== 'standard') att.push(cfg.magazine); if (cfg.laser && cfg.laser !== 'off') att.push('laser'); if (cfg.flashlight === 'on') att.push('light');
    return '<div style="font:800 20px \'Segoe UI\',sans-serif; color:#fff;">' + nm + '</div>' +
      '<div style="font:800 22px \'Segoe UI\',sans-serif; color:' + (am.out ? '#ff5a5a' : '#fff') + ';">' + am.txt + '</div>' +
      '<div style="height:4px; width:84px; margin-left:auto; background:' + col + '; border-radius:2px;"></div>' +
      '<div style="font:600 10px \'Segoe UI\',sans-serif; color:#9fb0c0; margin-top:2px;">' + (BR_RAR[it.rar] ? BR_RAR[it.rar].name : '') + (att.length ? ' • ' + att.join(' • ') : '') + '</div>';
  }
  const m = brItemMeta(it.t), cnt = brCount(it.t), keyLbl = IM.keyLabel(brSlotKeyBind(brSel));
  return '<div style="font:800 19px \'Segoe UI\',sans-serif; color:' + brLootCol(it.t) + ';">' + m.icon + ' ' + m.name + (cnt > 1 ? ' ×' + cnt : '') + '</div>' +
    '<div style="font:600 12px \'Segoe UI\',sans-serif; color:#dfe7f0;">' + m.desc + '</div>' +
    '<div style="font:700 11px \'Segoe UI\',sans-serif; color:#ffd34a; margin-top:3px;">' + (it.t === 'second' ? 'PASSIVE — carry to survive death once' : 'PRESS [' + keyLbl + '] TO ' + m.verb) + '</div>';
}
// ----- in-hand consumable viewmodel (BR-only; weapons/melee use the existing gun viewmodel) -----
let brHeldVM = null, brHeldVMType = null, brHeldUseT = 0;
function brBuildHeldVM(t) {
  const g = new THREE.Group();
  if (t === 'cigar') { const c = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.5, 8), flatMat(0xb5742a)); c.rotation.z = Math.PI / 2; g.add(c); const tip = new THREE.Mesh(new THREE.CylinderGeometry(0.052, 0.052, 0.08, 8), flatMat(0xe8d8b0)); tip.rotation.z = Math.PI / 2; tip.position.x = -0.28; g.add(tip); }
  else if (t === 'jd') { g.add(new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.15, 0.5, 8), flatMat(0x3a2a1a))); const nk = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 0.18, 6), flatMat(0x2a1c10)); nk.position.y = 0.33; g.add(nk); const lbl = new THREE.Mesh(new THREE.BoxGeometry(0.205, 0.2, 0.205), flatMat(0xe8e0c8)); g.add(lbl); }
  else if (t === 'impulse') { g.add(new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.4, 10), flatMat(0x2a6a8a))); const r = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.16, 0.06, 10), new THREE.MeshLambertMaterial({ color: 0x7fe0ff, emissive: 0x7fe0ff, emissiveIntensity: 0.6, flatShading: true })); g.add(r); }
  else if (t === 'lethal') { if (lethalChoice === 'axe') { g.add(new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.5, 0.05), flatMat(0x6f5333))); const bl = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.18, 0.26), flatMat(0x9aa3ab)); bl.position.set(0, 0.22, 0.1); g.add(bl); } else g.add(new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.12, 0.4, 8), flatMat(0x4a5a2a))); }
  else if (t === 'second') { const s = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.5, 8), flatMat(0xe8e8f0)); s.rotation.z = 0.3; g.add(s); const nd = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, 0.16, 4), flatMat(0xcfd6dd)); nd.position.set(0.17, -0.3, 0); nd.rotation.z = 0.3; g.add(nd); }
  g.traverse(o => { if (o.isMesh) { o.renderOrder = 999; o.frustumCulled = false; } });
  return g;
}
function brShowHeldVM(t, dt) {
  if (cigSmoking) { if (brHeldVM) brHeldVM.visible = false; return; }   // the cigar smoke animation has its own viewmodel
  if (brHeldVMType !== t) { if (brHeldVM) { camera.remove(brHeldVM); disposeGroup(brHeldVM); } brHeldVM = brBuildHeldVM(t); brHeldVMType = t; camera.add(brHeldVM); }
  brHeldVM.visible = !rcCamLive;
  const leftHand = (t === 'cigar' || t === 'jd' || t === 'second');
  let lift = 0; if (brHeldUseT > 0) { brHeldUseT = Math.max(0, brHeldUseT - dt); lift = Math.sin((1 - brHeldUseT / 0.45) * Math.PI) * 0.22; }
  brHeldVM.position.set(leftHand ? -0.34 : 0.32, -0.52 + lift, -0.62);
  brHeldVM.rotation.set(0.1, leftHand ? 0.3 : -0.3, 0);
}
function brHideHeldVM() { if (brHeldVM) brHeldVM.visible = false; }
function brUpdateHeldVM(dt) {   // each frame: weapons/melee use the gun viewmodel; consumables/empty-hands hide it + show the held item
  if (!BR.active || ggKarambit) { brHideHeldVM(); return; }
  const it = brHeldItem();
  if (it && it.t === 'weapon') { brHideHeldVM(); return; }
  if (gunMesh) gunMesh.visible = false;
  if (it && it.t !== 'weapon') brShowHeldVM(it.t, dt); else brHideHeldVM();
}

/* ----------------- BATTLE ROYALE — SHRINKING SAFE ZONE -----------------
   Phases hold → warn → shrink, each closing to a smaller circle (random centre inside
   the previous one) with rising out-of-zone damage. A translucent blue wall cylinder
   marks the current circle; the HUD shows the countdown. The whole island is the first
   safe zone; the final tiny circle forces the last fight. (Timers below are tuned for a
   ~12-16 min match; bots taking zone damage is a later refinement.) */
const BR_ZONES = [
  { hold: 55, warn: 15, shrink: 45, rFrac: 0.72, dmg: 1 },
  { hold: 30, warn: 15, shrink: 40, rFrac: 0.46, dmg: 3 },
  { hold: 25, warn: 12, shrink: 35, rFrac: 0.26, dmg: 8 },
  { hold: 20, warn: 10, shrink: 28, rFrac: 0.12, dmg: 12 },
  { hold: 16, warn: 8,  shrink: 22, rFrac: 0.04, dmg: 15 }
];
function brInitZone() {
  if (!island) return;
  const m = new THREE.Mesh(new THREE.CylinderGeometry(1, 1, 90, 48, 1, true), new THREE.MeshBasicMaterial({ color: 0x40b0ff, transparent: true, opacity: 0.15, side: THREE.DoubleSide, depthWrite: false }));
  m.position.set(island.cx, 45, island.cz); scene.add(m);
  BR.zone = { cx: island.cx, cz: island.cz, r: island.R, fromCx: island.cx, fromCz: island.cz, fromR: island.R, toCx: island.cx, toCz: island.cz, toR: island.R, phase: -1, state: 'hold', timer: BR_ZONES[0].hold, shrinkDur: 1, mesh: m, warnShown: false };
  brSetWall();
}
function brSetWall() { const z = BR.zone; if (!z || !z.mesh) return; z.mesh.scale.set(Math.max(0.01, z.r), 1, Math.max(0.01, z.r)); z.mesh.position.set(z.cx, 45, z.cz); }
function brAdvanceZone() {
  const z = BR.zone, pi = z.phase + 1;
  if (pi >= BR_ZONES.length) { z.state = 'final'; return; }
  z.phase = pi; const ph = BR_ZONES[pi];
  z.fromCx = z.cx; z.fromCz = z.cz; z.fromR = z.r; z.toR = island.R * ph.rFrac;
  const maxOff = Math.max(0, z.r - z.toR), a = Math.random() * Math.PI * 2, off = Math.random() * maxOff * 0.85;   // new circle stays inside the old
  z.toCx = z.cx + Math.cos(a) * off; z.toCz = z.cz + Math.sin(a) * off;
  z.state = 'warn'; z.timer = ph.warn; z.warnShown = false;
}
function brUpdateZone(dt) {
  const z = BR.zone; if (!z) return;
  if (z.state === 'hold') { z.timer -= dt; if (z.timer <= 0) brAdvanceZone(); }
  else if (z.state === 'warn') {
    if (!z.warnShown) { z.warnShown = true; showCenterBanner('⚠ ZONE CLOSING SOON', '#ff7a5a', 1800); }
    z.timer -= dt; if (z.timer <= 0) { z.state = 'shrink'; z.shrinkDur = BR_ZONES[z.phase].shrink; z.timer = z.shrinkDur; }
  } else if (z.state === 'shrink') {
    z.timer -= dt; const t = 1 - Math.max(0, z.timer) / (z.shrinkDur || 1);
    z.r = z.fromR + (z.toR - z.fromR) * t; z.cx = z.fromCx + (z.toCx - z.fromCx) * t; z.cz = z.fromCz + (z.toCz - z.fromCz) * t;
    if (z.timer <= 0) { z.r = z.toR; z.cx = z.toCx; z.cz = z.toCz; const last = z.phase + 1 >= BR_ZONES.length; z.state = last ? 'final' : 'hold'; if (!last) z.timer = BR_ZONES[z.phase + 1].hold; }
  }
  brSetWall();
  if (player.alive && z.phase >= 0) {                       // out-of-zone damage (whole island is safe until phase 0 starts)
    const d = Math.hypot(player.pos.x - z.cx, player.pos.z - z.cz);
    if (d > z.r) { player._zoneT = (player._zoneT || 0) + dt; const dmg = BR_ZONES[z.phase].dmg; if (player._zoneT >= 1) { player._zoneT -= 1; hurtPlayer(dmg, null); } }
    else player._zoneT = 0;
  }
  if (z.phase >= 0 && (!NET.active || NET.isHost)) {        // bots caught outside the zone die too, so the circle culls the field toward a finish
    const dmg = BR_ZONES[z.phase].dmg * 1.6;
    for (const b of bots) { if (!b.alive || b.dying) continue; if (Math.hypot(b.pos.x - z.cx, b.pos.z - z.cz) > z.r) { b.health -= dmg * dt; if (b.health <= 0) killBot(b, null, { zone: true }); } }
  }
}
function brUpdateZoneHud() {
  const z = BR.zone, wrap = el('brZoneWrap'), t = el('brZoneTimer'); if (!wrap || !t) return;
  if (!z || !BR.active) { wrap.style.display = 'none'; return; }
  wrap.style.display = 'block';
  const fmt = s => { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2); };
  if (z.state === 'hold') { t.textContent = '🔵 SAFE ZONE • SHRINKS IN ' + fmt(z.timer); t.style.color = '#7fd0ff'; }
  else if (z.state === 'warn') { t.textContent = '⚠ ZONE CLOSING IN ' + Math.ceil(z.timer) + 's'; t.style.color = '#ff8a5a'; }
  else if (z.state === 'shrink') { t.textContent = '🟠 ZONE IS CLOSING — GET INSIDE THE BLUE'; t.style.color = '#ffb05a'; }
  else { t.textContent = '🔴 FINAL ZONE'; t.style.color = '#ff5a5a'; }
}
function brClearZone() { if (BR.zone && BR.zone.mesh) { scene.remove(BR.zone.mesh); if (BR.zone.mesh.geometry) BR.zone.mesh.geometry.dispose(); } BR.zone = null; }

/* ----------------- BATTLE ROYALE — PARACHUTE DROP -----------------
   The match opens on a transport plane crossing the island (random heading). Jump to
   leave (or auto-drop at the end of the run): freefall (WASD steers, look down to dive
   faster), then the parachute auto-deploys near the ground (slower, still steerable),
   then you land with just your melee and scavenge. Drives the player/camera directly,
   so updateMovement early-returns into brUpdateDrop while BR.phase === 'drop'. */
function brBuildPlane() {
  const g = new THREE.Group();
  const fus = new THREE.Mesh(new THREE.CylinderGeometry(2.2, 2.0, 18, 10), flatMat(0x8a9098)); fus.rotation.x = Math.PI / 2; g.add(fus);
  const wing = new THREE.Mesh(new THREE.BoxGeometry(26, 0.6, 4), flatMat(0x7a8088)); wing.position.y = 0.4; g.add(wing);
  const tail = new THREE.Mesh(new THREE.BoxGeometry(9, 0.5, 2.5), flatMat(0x7a8088)); tail.position.set(0, 1.4, -8); g.add(tail);
  const fin = new THREE.Mesh(new THREE.BoxGeometry(0.5, 3, 2.5), flatMat(0x7a8088)); fin.position.set(0, 2.4, -8); g.add(fin);
  const nose = new THREE.Mesh(new THREE.ConeGeometry(2.1, 4, 10), flatMat(0x9aa0a8)); nose.rotation.x = -Math.PI / 2; nose.position.z = 11; g.add(nose);
  return g;
}
function brBuildChute() {
  const g = new THREE.Group();
  const canopy = new THREE.Mesh(new THREE.SphereGeometry(3, 12, 6, 0, Math.PI * 2, 0, Math.PI / 2), new THREE.MeshLambertMaterial({ color: 0x2a7fff, flatShading: true, side: THREE.DoubleSide }));
  canopy.position.y = 5; g.add(canopy);
  for (let a = 0; a < 4; a++) { const ln = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 5, 4), flatMat(0xddddee)); ln.position.set(Math.cos(a * 1.57) * 2, 2.5, Math.sin(a * 1.57) * 2); g.add(ln); }
  return g;
}
function brBeginDrop() {
  if (!island) { BR.phase = 'play'; return; }
  BR.phase = 'drop';
  const ang = Math.random() * Math.PI * 2, range = island.R + 160, dir = new THREE.Vector3(Math.cos(ang), 0, Math.sin(ang));
  const start = new THREE.Vector3(island.cx - dir.x * range, 92, island.cz - dir.z * range);
  const plane = brBuildPlane(); plane.position.copy(start); plane.rotation.y = Math.atan2(dir.x, dir.z); scene.add(plane);
  BR.drop = { state: 'plane', t: 0, traverse: 12, dir, planePos: start.clone(), plane, chute: null, deployed: false, spaceHeld: true, autoDeployed: false, range };
  player.pos.copy(start); player.pos.y -= 3.5; player.vel.set(0, 0, 0); player.onGround = false; player.alive = true;
  yaw = Math.atan2(dir.x, dir.z); pitch = -0.4;
  showCenterBanner('PRESS [' + IM.keyLabel(IM.bind.jump) + '] TO DIVE', '#aef0c0', 2600);
}
function brDeployChute(D, auto) {
  D.deployed = true; if (!D.chute) { D.chute = brBuildChute(); scene.add(D.chute); } D.chute.visible = true;
  if (typeof sfxBoostLaunch === 'function') sfxBoostLaunch(player.pos);   // WHOOSH-FLAP
  if (auto) { D.autoDeployed = true; const hf = el('hurtFlash'); if (hf) { hf.style.opacity = 1; setTimeout(() => hf.style.opacity = 0, 160); } showCenterBanner('PARACHUTE AUTO-DEPLOYED', '#ff8a8a', 1400); }
}
function brCloseChute(D) { D.deployed = false; if (D.chute) D.chute.visible = false; if (typeof sfxClick === 'function') sfxClick(); }   // SNAP back to freefall
function brDropHud(D, alt) {
  const e = el('brDropHud'); if (!e) return; e.style.display = 'block';
  const spaceLbl = IM.keyLabel(IM.bind.jump), shiftLbl = IM.keyLabel(IM.bind.sprint);
  if (D.state === 'plane') { e.innerHTML = '<div style="font:800 22px \'Segoe UI\',sans-serif;color:#aef0c0;">✈ PRESS [' + spaceLbl + '] TO DIVE</div>'; return; }
  const m = Math.max(0, Math.round(alt));
  e.innerHTML = '<div style="font:900 28px \'Segoe UI\',sans-serif;color:#fff;">ALTITUDE: ' + m + 'm</div>' +
    (alt < 35 ? '<div style="font:800 14px \'Segoe UI\',sans-serif;color:#ffd34a;">▼ ' + m + 'm TO GROUND</div>' : '') +
    '<div style="font:800 16px \'Segoe UI\',sans-serif;color:' + (D.deployed ? '#9fd0ff' : '#aef0c0') + ';margin-top:4px;">[' + spaceLbl + '] ' + (D.deployed ? 'CLOSE PARACHUTE' : 'OPEN PARACHUTE') + '</div>' +
    (D.deployed ? '<div style="font:700 12px \'Segoe UI\',sans-serif;color:#cfe0f0;">[' + shiftLbl + '] DIVE FASTER</div>' : '<div style="font:700 12px \'Segoe UI\',sans-serif;color:#cfe0f0;">Look down to dive faster • WASD to glide</div>');
}
function brUpdateDrop(dt) {
  const D = BR.drop; if (!D) { BR.phase = 'play'; return; }
  const speed = (D.range * 2) / D.traverse;
  const spaceNow = IM.down('jump'), spaceEdge = spaceNow && !D.spaceHeld; D.spaceHeld = spaceNow;
  if (D.state === 'plane') {
    D.t += dt; D.planePos.addScaledVector(D.dir, speed * dt); D.plane.position.copy(D.planePos);
    player.pos.copy(D.planePos); player.pos.y -= 3.5;
    if (spaceEdge || D.t >= D.traverse) { D.state = 'air'; D.deployed = false; player.vel.set(D.dir.x * 6, -8, D.dir.z * 6); if (typeof sfxJump === 'function') sfxJump(player.pos); showCenterBanner('FREEFALL — [' + IM.keyLabel(IM.bind.jump) + '] TO OPEN CHUTE', '#aef0c0', 2200); }
    brDropHud(D, 0);
  } else {   // 'air': freefall <-> parachute, toggled with SPACE; auto-deploys near the ground
    D.planePos.addScaledVector(D.dir, speed * dt); if (D.plane) D.plane.position.copy(D.planePos);
    const gh = groundHeightAt(player.pos.x, player.pos.z, 50), alt = player.pos.y - gh;
    if (spaceEdge) { if (!D.deployed) brDeployChute(D, false); else brCloseChute(D); }       // manual open / close
    if (!D.deployed && alt <= 10) brDeployChute(D, true);                                    // auto-deploy safety (prevents a fatal landing)
    if (D.deployed) {                                                                        // PARACHUTE: slow descent (~8), SHIFT dives faster
      const dive = (keys['ShiftLeft'] || keys['ShiftRight']) ? -16 : -8;
      player.vel.y += (dive - player.vel.y) * Math.min(1, dt * 4);
      if (D.chute) { D.chute.position.set(player.pos.x, player.pos.y + 0.5, player.pos.z); D.chute.rotation.y = yaw; D.chute.rotation.z = Math.sin(BR.t * 2.2) * 0.05; }   // gentle wind flutter
    } else {                                                                                 // FREEFALL: fast (~25), faster looking straight down
      const downness = Math.min(1, Math.max(0, -pitch / 1.3));
      player.vel.y += (-(20 + downness * 25) - player.vel.y) * Math.min(1, dt * 3);
    }
    const f = horizontalForward(), r = horizontalRight(); let wx = 0, wz = 0, brake = false;
    if (kbDown('moveForward')) { wx += f.x; wz += f.z; }
    if (kbDown('moveBackward')) { if (D.deployed) brake = true; else { wx -= f.x; wz -= f.z; } }   // S brakes under canopy
    if (kbDown('moveRight')) { wx += r.x; wz += r.z; } if (kbDown('moveLeft')) { wx -= r.x; wz -= r.z; }
    if (GP.active && (GP.mvX || GP.mvY)) { wx += r.x * GP.mvX - f.x * GP.mvY; wz += r.z * GP.mvX - f.z * GP.mvY; }
    const wl = Math.hypot(wx, wz); if (wl > 0) { wx /= wl; wz /= wl; }
    const steer = D.deployed ? 15 : (12 + (1 - Math.min(1, -pitch / 1.3)) * 10);   // freefall glides farther forward when angled forward
    if (brake) { player.vel.x *= 0.9; player.vel.z *= 0.9; }
    else { player.vel.x += (wx * steer - player.vel.x) * Math.min(1, dt * 2.5); player.vel.z += (wz * steer - player.vel.z) * Math.min(1, dt * 2.5); }
    player.pos.x += player.vel.x * dt; player.pos.z += player.vel.z * dt; player.pos.y += player.vel.y * dt;
    clampToMap(player.pos, 1.2);
    brDropHud(D, alt);
    if (player.pos.y <= gh + 0.1) {   // touchdown
      const wasDeployed = D.deployed;
      player.pos.y = gh; player.vel.set(0, 0, 0); player.onGround = true;
      if (D.chute) { scene.remove(D.chute); disposeGroup(D.chute); } if (D.plane) { scene.remove(D.plane); disposeGroup(D.plane); }
      BR.drop = null; BR.phase = 'play'; const dh = el('brDropHud'); if (dh) dh.style.display = 'none';
      if (typeof sfxLand === 'function') sfxLand(player.pos, wasDeployed ? 0.6 : 1.4);
      if (!wasDeployed && player.alive) { showCenterBanner('FATAL FALL DAMAGE', '#ff5a5a', 2200); player.health = 0; if (typeof playerDie === 'function') playerDie(); }   // hit the ground with no chute
    }
  }
  player.eye += (MOVE.eyeHeight - player.eye) * Math.min(1, dt * 10);
  camera.position.set(player.pos.x, player.pos.y + player.eye, player.pos.z);
  camera.rotation.order = 'YXZ'; camera.rotation.y = yaw + recoilYaw; camera.rotation.x = pitch + recoilPitch;
  if (camera.fov !== DEFAULT_FOV) { camera.fov = DEFAULT_FOV; camera.updateProjectionMatrix(); }
}

/* ----------------- BATTLE ROYALE — PAPER MAP (M) + SPECTATOR -----------------
   Top-down hand-drawn-style island: POIs labelled, current safe zone (blue) + next
   zone (orange dashed), out-of-zone shaded red, your position as a white triangle, a
   compass rose. Open with M (the otherwise-disabled Kirks-Avengers key in BR); you
   walk slowly and can't fire while it's open. */
let brMapOpen = false, brSpectating = false, brSpecIdx = 0, brSpecFree = false, brSpecBlend = 1, brSpecCur = null;
const brSpecFromCam = new THREE.Vector3(), brFreePos = new THREE.Vector3();
function brSpecList() { const list = bots.filter(b => b.alive && !b.dying); if (NET.active) NET.players.forEach(rp => { if (rp.alive) list.push(rp); }); return list; }   // living players to spectate (bots + remotes)
function brViewPos() { return (brSpectating && brSpecFree) ? brFreePos : ((brSpectating && brSpecCur) ? brSpecCur.pos : player.pos); }   // minimap/compass centre
function brToggleMap() {
  if (!BR.active) return;
  brMapOpen = !brMapOpen;
  const m = el('brMap'); if (m) m.style.display = brMapOpen ? 'flex' : 'none';
  if (brMapOpen) brDrawMap();
}
function brCloseMap() { brMapOpen = false; const m = el('brMap'); if (m) m.style.display = 'none'; }
/* ----------------- BATTLE ROYALE — MINIMAP (B) -----------------
   Top-right, north-up, player-centred (~80×80 units). Terrain + nearby POIs, the safe
   zone (blue) + next zone (orange), available chests (yellow dots ≤30u) / looted ones
   (gray X), and recent gunshots heard within ~85u (red, fading over 3s). No other players. */
let brMinimapOn = true; const brGunshots = [];
function brToggleMinimap() { if (!BR.active) return; brMinimapOn = !brMinimapOn; const c = el('brMinimap'); if (c) c.style.display = brMinimapOn ? 'block' : 'none'; }
function brNoteGunshot(x, z) { if (!BR.active || Math.hypot(x - player.pos.x, z - player.pos.z) > 85) return; brGunshots.push({ x, z, t: performance.now() }); if (brGunshots.length > 40) brGunshots.shift(); }
function brDrawMinimap() {
  const c = el('brMinimap'); if (!c || !island || !brMinimapOn) return;
  const ctx = c.getContext('2d'), S = c.width, half = S / 2, zoom = 80, ppu = S / zoom, vp = brViewPos();   // centre on the spectated player when spectating
  const w2m = (wx, wz) => [half + (wx - vp.x) * ppu, half + (wz - vp.z) * ppu];
  ctx.clearRect(0, 0, S, S); ctx.save(); ctx.beginPath(); ctx.rect(0, 0, S, S); ctx.clip();
  ctx.fillStyle = '#2a566f'; ctx.fillRect(0, 0, S, S);
  const im = w2m(island.cx, island.cz), ir = island.R * ppu;
  ctx.beginPath(); ctx.arc(im[0], im[1], ir, 0, 7); ctx.fillStyle = '#cdbb8e'; ctx.fill();
  ctx.beginPath(); ctx.arc(im[0], im[1], ir * 0.86, 0, 7); ctx.fillStyle = '#5f8d4e'; ctx.fill();
  ctx.beginPath(); ctx.arc(im[0], im[1], ir * 0.55, 0, 7); ctx.fillStyle = '#477040'; ctx.fill();
  const z = BR.zone;
  if (z) { const zm = w2m(z.cx, z.cz); ctx.beginPath(); ctx.arc(zm[0], zm[1], z.r * ppu, 0, 7); ctx.strokeStyle = '#3aa0ff'; ctx.lineWidth = 2; ctx.stroke();
    if ((z.state === 'warn' || z.state === 'shrink') && z.toR != null) { const nm = w2m(z.toCx, z.toCz); ctx.beginPath(); ctx.arc(nm[0], nm[1], z.toR * ppu, 0, 7); ctx.strokeStyle = '#ff9a3a'; ctx.lineWidth = 1.5; ctx.setLineDash([4, 4]); ctx.stroke(); ctx.setLineDash([]); } }
  for (const Lo of BR_LOOT) { if (!Lo.chest) continue; const d = Math.hypot(Lo.pos.x - vp.x, Lo.pos.z - vp.z); if (d > zoom * 0.7) continue; const m = w2m(Lo.pos.x, Lo.pos.z);
    if (Lo.open) { ctx.strokeStyle = 'rgba(180,180,180,0.6)'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(m[0] - 3, m[1] - 3); ctx.lineTo(m[0] + 3, m[1] + 3); ctx.moveTo(m[0] + 3, m[1] - 3); ctx.lineTo(m[0] - 3, m[1] + 3); ctx.stroke(); }
    else if (d < 30) { ctx.fillStyle = '#ffd34a'; ctx.beginPath(); ctx.arc(m[0], m[1], 2.5, 0, 7); ctx.fill(); } }
  const now = performance.now();
  for (let i = brGunshots.length - 1; i >= 0; i--) { const g = brGunshots[i], age = (now - g.t) / 1000; if (age > 3) { brGunshots.splice(i, 1); continue; } const m = w2m(g.x, g.z); ctx.fillStyle = 'rgba(255,60,60,' + (1 - age / 3).toFixed(2) + ')'; ctx.beginPath(); ctx.arc(m[0], m[1], 3, 0, 7); ctx.fill(); }
  ctx.restore();
  ctx.textAlign = 'center'; ctx.font = "bold 9px 'Segoe UI',sans-serif";
  island.pois.forEach(p => { const wx = island.cx + p.lx, wz = island.cz + p.lz; if (Math.hypot(wx - vp.x, wz - vp.z) > 85) return; const m = w2m(wx, wz), mx = Math.max(10, Math.min(S - 10, m[0])), my = Math.max(12, Math.min(S - 4, m[1])); ctx.fillStyle = 'rgba(0,0,0,0.55)'; ctx.fillText(p.name, mx + 0.5, my + 0.5); ctx.fillStyle = '#e8eef5'; ctx.fillText(p.name, mx, my); });
  const fwd = horizontalForward(), ang = Math.atan2(fwd.x, -fwd.z);
  ctx.save(); ctx.translate(half, half); ctx.rotate(ang); ctx.beginPath(); ctx.moveTo(0, -6); ctx.lineTo(4, 5); ctx.lineTo(-4, 5); ctx.closePath(); ctx.fillStyle = '#fff'; ctx.strokeStyle = '#000'; ctx.lineWidth = 1.5; ctx.fill(); ctx.stroke(); ctx.restore();
  ctx.fillStyle = '#ff6a6a'; ctx.font = "bold 11px 'Segoe UI',sans-serif"; ctx.textAlign = 'center'; ctx.fillText('N', half, 11);
}
function brDrawMap() {
  const cv = el('brMapCanvas'); if (!cv || !island) return;
  const ctx = cv.getContext('2d'); const S = cv.width, pad = 42, inner = S - 2 * pad, R = island.R, cm = pad + inner / 2, rm = inner / 2;
  const w2m = (wx, wz) => [pad + (wx - (island.cx - R)) / (2 * R) * inner, pad + (wz - (island.cz - R)) / (2 * R) * inner];
  ctx.clearRect(0, 0, S, S);
  ctx.fillStyle = '#2a566f'; ctx.fillRect(0, 0, S, S);                                   // ocean
  ctx.beginPath(); ctx.arc(cm, cm, rm, 0, 7); ctx.fillStyle = '#d9c79a'; ctx.fill();      // sand
  ctx.beginPath(); ctx.arc(cm, cm, rm * 0.86, 0, 7); ctx.fillStyle = '#6f9d5a'; ctx.fill();
  ctx.beginPath(); ctx.arc(cm, cm, rm * 0.55, 0, 7); ctx.fillStyle = '#507f44'; ctx.fill();
  const z = BR.zone;
  if (z) {
    const zm = w2m(z.cx, z.cz), zr = Math.max(2, z.r / (2 * R) * inner);
    ctx.save(); ctx.beginPath(); ctx.rect(0, 0, S, S); ctx.arc(zm[0], zm[1], zr, 0, 7, true); ctx.fillStyle = 'rgba(210,40,40,0.24)'; ctx.fill('evenodd'); ctx.restore();   // OOB red
    ctx.beginPath(); ctx.arc(zm[0], zm[1], zr, 0, 7); ctx.strokeStyle = '#3aa0ff'; ctx.lineWidth = 3; ctx.stroke();
    if ((z.state === 'warn' || z.state === 'shrink') && z.toR != null) { const nm = w2m(z.toCx, z.toCz), nr = Math.max(2, z.toR / (2 * R) * inner); ctx.beginPath(); ctx.arc(nm[0], nm[1], nr, 0, 7); ctx.strokeStyle = '#ff9a3a'; ctx.lineWidth = 2; ctx.setLineDash([7, 5]); ctx.stroke(); ctx.setLineDash([]); }
  }
  ctx.textAlign = 'center';                                                               // POIs
  island.pois.forEach(p => { const m = w2m(island.cx + p.lx, island.cz + p.lz);
    ctx.beginPath(); ctx.arc(m[0], m[1], 4, 0, 7); ctx.fillStyle = '#1c1c1c'; ctx.fill();
    ctx.fillStyle = '#15110a'; ctx.font = "bold 11px 'Segoe UI',sans-serif"; ctx.fillText(p.name, m[0], m[1] - 8); });
  const pm = w2m(player.pos.x, player.pos.z), fwd = horizontalForward(), ang = Math.atan2(fwd.x, -fwd.z);   // player triangle (N up)
  ctx.save(); ctx.translate(pm[0], pm[1]); ctx.rotate(ang); ctx.beginPath(); ctx.moveTo(0, -10); ctx.lineTo(7, 8); ctx.lineTo(-7, 8); ctx.closePath(); ctx.fillStyle = brSpectating ? '#9fd0ff' : '#fff'; ctx.strokeStyle = '#000'; ctx.lineWidth = 2; ctx.fill(); ctx.stroke(); ctx.restore();
  ctx.fillStyle = '#15110a'; ctx.font = "bold 16px 'Segoe UI',sans-serif";               // compass rose
  ctx.textAlign = 'center'; ctx.fillText('N', cm, 20); ctx.fillText('S', cm, S - 7);
  ctx.textAlign = 'left'; ctx.fillText('W', 6, cm + 5); ctx.textAlign = 'right'; ctx.fillText('E', S - 6, cm + 5); ctx.textAlign = 'center';
}

function updateHUD() {
  const ws = weaponState[currentWeaponKey];
  const w = WEAPONS[currentWeaponKey];
  el('weaponName').textContent = w.name;
  // Gold = legendary, cyan = karambit/RC, blue = other specials, yellow = base.
  el('weaponName').style.color = w.legendary ? '#ffd700' : ((w.karambit || w.rc) ? '#7fe9ff' : (w.special ? '#9ad0ff' : '#ffe600'));
  el('ammoCur').textContent = ws.ammo;
  // Specials show remaining RESERVE after the slash; base weapons show mag size.
  el('ammoMag').textContent = (ws.reserve === Infinity) ? w.mag : ws.reserve;
  el('ammoCur').textContent = w.rc ? `🚀 ${ws.ammo}` : ws.ammo;
  if (el('ammo')) el('ammo').style.color = (BR.active && ws.reserve !== Infinity && ws.ammo === 0 && ws.reserve === 0) ? '#ff5a5a' : '';   // BR limited ammo: out = red
  el('reloading').textContent = ws.reloading > 0 ? 'RELOADING…' : '';
  el('scoreVal').textContent = gameState.score;
  el('killCount').textContent = gameState.kills;
  { const kt = el('killTarget'); if (kt) kt.textContent = modeKillLimit(); }   // FFA/TDM kill limit
  el('grenadeCount').textContent = player.grenades;
  el('grenadeLabel').textContent = throwableType === 'tomahawk' ? 'TOMAHAWKS' : 'GRENADES';
  // Gun-game: show the level prominently, hide score/kills/grenades; melee shows ∞ ammo.
  const magSpan = document.querySelector('#ammo .mag');
  if (gameMode === 'gungame') {
    el('ggLevel').style.display = '';
    el('ggLevel').innerHTML = `LEVEL ${ggLevel} / ${GUNGAME_MAX}` + (ggKarambit ? ` <span class="gg-karambit">⚔ ${MELEE_NAMES[meleeChoice]}</span>` : ``);
    el('killCounter').style.display = 'none'; el('grenades').style.display = 'none'; el('lootInfo').style.display = 'none';
    el('teamScoreHud').style.display = 'none';
    el('impulseCount').style.display = 'block'; el('impulseNum').textContent = player.impulses;
    el('lethalCount').style.display = 'block'; el('lethalNum').textContent = (player.lethals || 0); el('lethalIco').textContent = (lethalChoice === 'axe' ? '🪓' : '💨');
    if (w.melee) { el('ammoCur').textContent = '∞'; if (magSpan) magSpan.style.display = 'none'; }
    else if (magSpan) magSpan.style.display = '';
  } else {   // FFA / TDM: score/kills + impulse grenades (same equipment as gun game), no frag grenades
    el('ggLevel').style.display = 'none'; el('killCounter').style.display = ''; el('grenades').style.display = 'none';
    const tdm = gameMode === 'tdm';
    const tsh = el('teamScoreHud'); if (tsh) { tsh.style.display = tdm ? 'flex' : 'none'; if (tdm) { tsh.querySelector('.tA').textContent = teamKills('red'); tsh.querySelector('.tB').textContent = teamKills('blue'); } }
    el('impulseCount').style.display = 'block'; el('impulseNum').textContent = player.impulses;
    el('lethalCount').style.display = 'block'; el('lethalNum').textContent = (player.lethals || 0); el('lethalIco').textContent = (lethalChoice === 'axe' ? '🪓' : '💨');
    if (w.melee) { el('ammoCur').textContent = '∞'; if (magSpan) magSpan.style.display = 'none'; }
    else if (magSpan) magSpan.style.display = '';
  }
  if (w.rc && magSpan) magSpan.style.display = 'none';   // RC launcher: rockets/life, no reserve to show
  el('lootInfo').style.display = 'none';                 // no loot crates in either mode
  // Cigar self-heal availability (all modes): full when carried, dimmed once used. Hidden while
  // saber+JD is active (the whiskey bottle replaces the cigar, and Q drinks instead).
  if (saberMode) { el('cigarCount').style.display = 'none'; }
  else { el('cigarCount').style.display = 'block'; el('cigarNum').textContent = player.cigar; el('cigarCount').style.opacity = player.cigar > 0 ? '1' : '0.35'; }
  // Health bar
  const hp = Math.max(0, player.health);
  const bar = el('healthBar');
  bar.style.width = hp + '%';
  bar.style.background = hp > 50 ? '#34d058' : hp > 25 ? '#f0b429' : '#e0392b';
  // Whiskey overheal/shield bar (amber) — stacked above HP, shown only while it has charge.
  const oh = Math.max(0, Math.min(OVERHEAL_MAX, player.overheal || 0));
  const ohWrap = el('overhealBarBg');
  if (ohWrap) { ohWrap.style.display = oh > 0 ? 'block' : 'none'; const ob = el('overhealBar'); if (ob) ob.style.width = (oh / OVERHEAL_MAX * 100) + '%'; }
  // Flamethrower fuel bar (shown only while it's the equipped weapon).
  const ffw = el('flameFuelWrap');
  if (ffw) { if (flameEquipped) { ffw.style.display = 'block'; const fb = el('flameFuelBar'); if (fb) fb.style.width = Math.max(0, Math.min(100, flameFuel)) + '%'; } else ffw.style.display = 'none'; }
  updateStreakHUD();
}

let hitMarkerTimer = 0;
function showHitMarker(headshot) {
  if (BR.active) return;   // BR: no hit markers
  if (!OPT.hitMarkers) return;
  const hm = el('hitmarker'); hm.style.opacity = 1; hm.classList.toggle('hs', !!headshot); hitMarkerTimer = 0.15;
  sfxHitMarker(!!headshot);   // TINK (body) / DING (headshot)
}
function sfxHitMarker(head) {
  SND.play2d((ctx, out, t) => {
    aTone(ctx, out, t, { type: 'square', f0: head ? 2000 : 1150, f1: head ? 1500 : 880, dur: 0.05, peak: 0.15 });
    if (head) aTone(ctx, out, t + 0.015, { type: 'sine', f0: 2700, f1: 2100, dur: 0.06, peak: 0.1 });
  }, 'ui', 'hitmark', 0.55, 0.09);
}
function showKillFlash(headshot) {
  el('killFlash').style.opacity = 0.35;
  setTimeout(() => el('killFlash').style.opacity = 0, 90);
  sfxKill(!!headshot);   // satisfying kill ding (higher chime on a headshot kill)
}
function showHurtFlash() {
  el('hurtFlash').style.opacity = 1;
  setTimeout(() => el('hurtFlash').style.opacity = 0, 140);
}

function addKillFeed(text) {
  if (BR.active) return;   // BR: no kill feed
  const feed = el('killFeed');
  const div = document.createElement('div');
  div.className = 'entry';
  if (/<b[^>]*>YOU<\/b>/.test(text)) div.classList.add('kill-you');   // local player's row gets a yellow accent
  div.innerHTML = text;
  feed.appendChild(div);
  requestAnimationFrame(() => div.classList.add('in'));               // slide in from the right
  setTimeout(() => { div.classList.remove('in'); div.classList.add('out'); }, 6000);
  setTimeout(() => div.remove(), 6300);                               // fade out after 6s
  while (feed.children.length > 6) feed.removeChild(feed.firstChild);
}

/* ============================================================================
   9. MATCH FLOW — kills, win condition, player death/respawn, restart
   ============================================================================ */
const gameState = { running: false, kills: 0, over: false, score: 0 };

/* ============================================================================
   9-GG. GUN GAME — weapon-ladder progression (advance on kill, demote on knife)
   The HOST (or, in solo, the local player) is authoritative for level changes.
   ============================================================================ */
// Equip a weapon immediately (no special-ownership / same-key guards).
function ggEquip(key) {
  if (!WEAPONS[key]) return;
  inspectT = 0;   // (Part 5) a weapon swap cancels any in-progress inspect
  if (isCustomizable(key)) { liveCfg[key] = getCfg(key); applyWeaponMag(key); }   // (PART 2) lock in this weapon's attachment config + mag for this life
  rcEquipped = (key === 'rcrl');
  flameEquipped = (key === 'flame');   // flamethrower in hand? (the V scorestreak weapon)
  currentWeaponKey = key; weaponState[key].reloading = 0; currentSpread = 0;
  buildGunModel(key); syncSaberHum(); updateHUD();
}
// The ladder weapon for the LOCAL player's current level.
function ggLadderKey() { return GUNGAME_LADDER[ggLevel - 1]; }
// The LOCAL player's "main gun" slot: gun-game uses the current ladder rung; FFA uses the
// player-chosen main weapon (set via the inventory menu, default Assault Rifle).
function mainGunKey() { return saberMode ? 'saber' : (gameMode === 'gungame' ? ggLadderKey() : (gameMode === 'br' ? (brHeldWeapon() ? brHeldWeapon().key : KARAMBIT_KEY) : ffaMain)); }
// Equip whichever of the two slots is active (the gun, or the karambit) — both modes.
function ggEquipCurrent() { ggEquip(ggKarambit ? KARAMBIT_KEY : mainGunKey()); }
// Toggle / set the karambit slot (both modes — FFA also carries a permanent karambit).
function ggSetKarambit(use) {
  // Switching slots CANCELS an in-progress reload (you have to start over later).
  const ws = weaponState[currentWeaponKey];
  if (ws) { ws.reloading = 0; ws.shellReload = false; }
  ggKarambit = !!use;
  ggEquipCurrent();
  if (ggKarambit) { karEquipDur = (meleeChoice === 'butterfly' ? 0.9 : meleeChoice === 'karambit' ? 0.7 : 0.6); karEquipT = karEquipDur; karSwingT = 0; karInspectT = 0; karInspectClock = 0; sfxMeleeEquip(meleeChoice); }   // variant-specific pull-out flourish + sound
}
// Set the LOCAL player's level: refill + instantly swap to that ladder weapon
// (advancing always pulls you off the karambit and onto the new gun).
function ggSetLevel(level) {
  const prev = ggLevel;
  ggLevel = Math.max(1, Math.min(GUNGAME_MAX, level));
  const key = ggLadderKey(), ws = weaponState[key];
  ws.ammo = WEAPONS[key].mag; ws.reloading = 0; ws.cooldown = 0;
  // While the saber scorestreak is active, the level still advances (and the underlying gun is
  // refilled for when the saber ends) but we KEEP the saber equipped instead of swapping to the gun.
  if (!saberMode) { ggKarambit = false; ggEquip(key); }
  else updateHUD();
  // Progression SFX for the LOCAL player: ascending chime up (fanfare at the final level), sad chime on demote.
  if (gameState.running) { if (ggLevel > prev) (ggLevel >= GUNGAME_MAX ? sfxFinalLevel() : sfxLevelUp()); else if (ggLevel < prev) sfxDemote(); }
}
const ggMeOrName = (name) => (name === NET.selfName ? '<b>YOU</b>' : name);
// Kill-feed line for a level-up (broadcast by the host).
function ggAnnounce(name, level, type) {
  const html = `${ggMeOrName(name)} ▸ <span class="gg-up">Level ${level}</span>`;
  addKillFeed(html);
  if (NET.isHost) NET.broadcast({ t: 'feed', html });
}
// Kill-feed line for a karambit demotion: "Killer [karambit] Victim → demoted to Level N".
function ggAnnounceDemote(killer, victim, level) {
  const html = `${ggMeOrName(killer)} <span class="gg-karambit">[karambit]</span> ${ggMeOrName(victim)} ` +
               `<span class="gg-demote">→ demoted to Level ${level}</span>`;
  addKillFeed(html);
  if (NET.isHost) NET.broadcast({ t: 'feed', html });
}
// Tell a player (could be the host itself) what level they're now on.
function ggSendLevel(id, level) { NET.route(id, { t: 'ggset', level }); }

// HOST authority: process one kill for gun-game progression / demotion / win.
function ggHostKill(killerId, weapon, victimIsPlayer, victimId, melee) {
  // --- KING KONG: a Kong kill is attributed to "KING KONG" (no player progression). ---
  if (killerId === 'kong' || weapon === 'kongbanana' || weapon === 'kongmelee') {
    const victimName = (victimIsPlayer && victimId && NET.scores.has(victimId)) ? NET.scores.get(victimId).name : (victimIsPlayer ? 'a player' : 'a bot');
    kongKillFeed(victimName); return;
  }
  streakCredit(killerId, victimId);   // every kill (any weapon) counts toward the killer's scorestreak
  if (victimIsPlayer && victimId && NET.scores.has(victimId)) statDeath(NET.scores.get(victimId));   // record the victim's death (results/scoreboard)
  // --- RC ROCKET: tracked separately; the killer NEVER advances / demotes / wins (Option A). ---
  if (weapon === 'rcrl') {
    const killerName = (killerId && NET.scores.has(killerId)) ? NET.scores.get(killerId).name : 'A player';
    const victimName = (victimIsPlayer && victimId && NET.scores.has(victimId)) ? NET.scores.get(victimId).name : null;
    const html = `${ggMeOrName(killerName)} <span class="gg-rc">🚀 [RC]</span> ${victimName ? ggMeOrName(victimName) : 'a bot'}`;
    addKillFeed(html); if (NET.isHost) NET.broadcast({ t: 'feed', html });
    if (killerId && NET.scores.has(killerId)) { const ks = NET.scores.get(killerId); ks.rcKills = (ks.rcKills || 0) + 1; }
    NET.broadcastScores();
    return;
  }
  // --- KARAMBIT: demote the victim one level; the killer NEVER advances / wins. ---
  if (weapon === KARAMBIT_KEY) {
    if (victimIsPlayer && killerId !== victimId && NET.scores.has(victimId)) {
      const vs = NET.scores.get(victimId);
      const nv = Math.max(1, (vs.level || 1) - 1);
      if (nv !== vs.level) {
        vs.level = nv; ggSendLevel(victimId, nv);          // victim respawns on the lower-level gun
        const killerName = (killerId && NET.scores.has(killerId)) ? NET.scores.get(killerId).name : 'A player';
        ggAnnounceDemote(killerName, vs.name, nv);
      }
    }
    if (killerId && killerId !== victimId && NET.scores.has(killerId)) statKill(NET.scores.get(killerId), KARAMBIT_KEY, false, true);   // melee-kill stat (no GG advance)
    NET.broadcastScores();
    return;                                                 // karambit never advances the killer
  }
  // --- Gun / combat-knife kill: advance only if it used the killer's CURRENT ladder weapon. ---
  if (killerId && NET.scores.has(killerId)) {
    const ks = NET.scores.get(killerId), lvl = ks.level || 1;
    if (weapon === GUNGAME_LADDER[lvl - 1]) {
      ks.kills += 1; statKill(ks, weapon, false, isMeleeWeaponKey(weapon));
      if (lvl >= GUNGAME_MAX) {                              // kill with the level-20 combat knife -> WIN
        NET.broadcastScores();
        finishMatch({ winner: ks.name });                   // rich results screen
        return;
      }
      ks.level = lvl + 1; ggSendLevel(killerId, ks.level); ggAnnounce(ks.name, ks.level, 'up');
    }
  }
  NET.broadcastScores();
}
// SOLO authority: only the local player has a level (bots can't knife you, and the
// karambit never advances — so a karambit/non-ladder weapon just does nothing here).
function ggSoloKill(weapon) {
  if (weapon === 'rcrl') { addKillFeed(`<b>YOU</b> <span class="gg-rc">🚀 [RC]</span> a bot`); return; }   // secret weapon: no progression
  if (weapon !== GUNGAME_LADDER[ggLevel - 1]) return;       // wrong weapon (or karambit): no progress
  soloStat.kills = (soloStat.kills || 0) + 1; statKill(soloStat, weapon, false, isMeleeWeaponKey(weapon));
  if (ggLevel >= GUNGAME_MAX) { finishMatch({ winner: 'YOU' }); return; }
  const nl = ggLevel + 1; ggSetLevel(nl); ggAnnounce('YOU', nl, 'up');
}

// info = { headshot, dismembered }. Headshot adds the bonus; both add a kill-feed
// tag and special floating text (improvements #1 + #5).
function onBotKilled(bot, info) {
  info = info || {};
  // King Kong's kills are attributed to "KING KONG" (no player score/progression credit).
  if (info.weapon === 'kongbanana' || info.weapon === 'kongmelee') {
    floatText(new THREE.Vector3(bot.pos.x, bot.pos.y + 1.7, bot.pos.z), '🦍', '#ffcf5a');
    if (!NET.active || NET.isHost) kongKillFeed('Bot ' + bot.id);   // host broadcasts; clients receive via 'feed'
    return;
  }
  const headshot = !!info.headshot, dism = !!info.dismembered;
  const pts = POINTS_KILL + (headshot ? POINTS_HEADSHOT : 0);
  const label = headshot ? `+${pts} HEADSHOT!` : (dism ? `+${pts} DISMEMBERED!` : `+${pts}`);
  const wt = WEAPON_TAGS[info.weapon];
  const col = (wt && wt.gold) ? '#ffd700' : (headshot || dism) ? '#ff5757' : '#ffe600';
  floatText(new THREE.Vector3(bot.pos.x, bot.pos.y + 1.7, bot.pos.z), label, col);

  // --- Multiplayer: the host owns scoring & kill credit (the shooter may be remote) ---
  if (NET.active && NET.isHost) {
    // botCredit is set by the shooter's hit (client) or host hitscan; null => host's own kill.
    const killerId = NET.botCredit || NET.selfId;
    if (gameMode === 'gungame') { ggHostKill(killerId, info.weapon, false, null, false); return; }
    NET.awardKill(killerId, pts, `Bot ${bot.id}`, { weapon: info.weapon, headshot, dism });
    return;
  }
  if (NET.active && NET.isClient) return;   // clients get score/feed from the host

  // --- Solo ---
  streakOnKill();   // every solo bot kill counts toward the scorestreak (both modes)
  if (gameMode === 'gungame') { ggSoloKill(info.weapon); return; }
  gameState.score += pts;
  gameState.kills++;
  soloStat.score = gameState.score; soloStat.kills = gameState.kills;
  statKill(soloStat, info.weapon, headshot, isMeleeWeaponKey(info.weapon));   // rich solo stats for the results screen
  let tags = '';
  if (wt) tags += ` <span class="${wt.gold ? 'leg' : 'wtag'}">${wt.label}</span>`;
  if (headshot) tags += ` <span class="hs">HEADSHOT</span>`;
  else if (dism) tags += ` <span class="hs">DISMEMBERED</span>`;
  addKillFeed(`<b>YOU</b> ▸ Bot ${bot.id}${tags}`);
  updateHUD();
  checkWinCondition();   // FFA: first to the kill limit wins (TDM-solo: team kill limit)
}

function hurtPlayer(dmg, srcPos) {
  if (!player.alive) return;
  if (saberBlocking) dmg *= 0.5;                  // saber block stance: 50% damage reduction
  if (player.overheal > 0 && dmg > 0) {           // whiskey overheal/shield soaks damage before HP
    const soak = Math.min(player.overheal, dmg);
    player.overheal -= soak; dmg -= soak;
  }
  player.health -= dmg;
  if (dmg > 0) GP.rumble(Math.min(0.9, 0.35 + dmg * 0.02), 0.5, 200);   // damage pulse (scales with the hit)
  showHurtFlash();
  if (dmg >= 1 && player.health > 0) sfxHitTaken(dmg);   // body-impact thud + pained grunt, scaled by damage
  if (dmg >= 1 && srcPos) showDamageArc(srcPos);          // red directional arc toward the source
  updateHUD();
  if (player.health <= 0) {
    if (gameMode === 'br' && BR.active && player.secondChance && player.alive) {   // Second Chance: survive one fatal hit (simplified self-revive; full downed/F state is a later refinement)
      player.secondChance = false; player.health = 50; player.overheal = 0; flashJD(); showCenterBanner('SECOND CHANCE!', '#ffc83a', 1600); updateHUD();
    } else playerDie();
  }
}
// Brief red arc at the screen edge pointing toward a damage source (Part 3, directional indicator).
function showDamageArc(srcPos) {
  const wrap = el('dmgArcs'); if (!wrap) return;
  const dx = srcPos.x - player.pos.x, dz = srcPos.z - player.pos.z; if (Math.abs(dx) < 0.01 && Math.abs(dz) < 0.01) return;
  const fx = -Math.sin(yaw), fz = -Math.cos(yaw), rx = Math.cos(yaw), rz = -Math.sin(yaw);   // camera forward + right (horizontal)
  const fwd = dx * fx + dz * fz, rgt = dx * rx + dz * rz;
  const deg = Math.atan2(rgt, fwd) * 180 / Math.PI;   // 0 = ahead (top), +90 = to the right
  const arc = document.createElement('div'); arc.className = 'dmgArc'; arc.style.transform = 'translate(-50%,-50%) rotate(' + deg.toFixed(0) + 'deg)';
  wrap.appendChild(arc);
  requestAnimationFrame(() => { arc.style.opacity = '0'; });   // CSS transition fades it over ~0.6s
  setTimeout(() => arc.remove(), 700);
}

function playerDie() {
  sfxDeath();                                                      // agonized grunt + body drop
  if (rcActive || rcMissile) rcDetonate(null, null, null, true);   // piloting an RC missile? auto-detonate, then die normally
  if (cigSmoking) cigFinish();                                     // dying ends any cigar in progress
  player.onLadder = false; player.ladder = null;                   // drop off any ladder on death
  if (invOpen) closeInventory();                                   // close the inventory if you die while browsing
  player.alive = false;
  player.health = 0;
  if (riding) scooterEject(true);                                  // dying while riding the scooter ejects you
  if (!NET.active) { statDeath(soloStat); if (gameMode === 'tdm') checkWinCondition(); }   // solo: record death + TDM team-kill check
  streakReset(true);                                               // dying wipes the streak + forfeits saber/JD/RC ("STREAK LOST")
  despawnKong(dogSelfId());                                        // loyalty: my King Kong leaves when I fall
  despawnOwnedMckaylas(dogSelfId());                               // loyalty: Mckayla leaves when her summoner falls
  if (NET.active) {
    // tell the host who killed me so they get credit (and everyone sees the feed)
    NET.reportDeath(player.lastAttacker, player.lastAttackerHead, player.lastAttackerWeapon, player.lastAttackerMelee);
    if (NET.isClient && gameMode !== 'gungame') addKillFeed(`${player.lastAttackerName || 'Someone'} fragged <b>YOU</b>`);
  } else {
    addKillFeed(`A bot fragged <b>YOU</b>`);
  }
  const killerInfo = { id: player.lastAttacker, name: player.lastAttackerName, weapon: player.lastAttackerWeapon, head: player.lastAttackerHead };
  player.lastAttacker = null; player.lastAttackerHead = false; player.lastAttackerName = null;
  player.lastAttackerWeapon = null; player.lastAttackerMelee = false;
  updateHUD();
  if (gameMode === 'br' && BR.active) { brOnPlayerDeath(); return; }   // BR: no killcam, no respawn — single life
  beginKillcam(killerInfo);   // Part 5: brief death replay, then doRespawn() (skippable with the jump key)
}
// Reset + spawn the player for a fresh life (FFA keeps going; only the kill target ends the match).
function doRespawn() {
  if (gameState.over || player.alive) return;
  if (gameMode === 'br' && BR.active) return;   // BR is single-life — no respawn
  const sp = spawnForPlayer();   // TDM: respawn on my team's side, away from the nearest enemy
  player.pos.set(sp.x, groundHeightAt(sp.x, sp.z, 0.5), sp.z);
  player.vel.set(0, 0, 0);
  player.health = 100; player.alive = true;
  player.crouching = false; player.diving = false; player.diveAir = false; player.crouchBlend = 0; player.diveTilt = 0; player.eye = MOVE.eyeHeight;
  player.impulseT = 0; player.impulseGrace = 0; player.onLadder = false; player.ladder = null;
  player.cigar = CIGAR.maxCarry; if (cigSmoking) cigFinish();   // fresh cigar each life
  player.overheal = 0; saberMode = false; saberBlocking = false; if (_jdVM) _jdVM.visible = false; SaberHum.stop();   // no streak rewards carry into a new life
  mckaylaSummonedThisLife = false;                    // fresh Mckayla summon available each life
  player.grenades = throwMaxCarry();                  // refill throwables on respawn
  WEAPON_ORDER.forEach(k => weaponState[k].ammo = WEAPONS[k].mag);
  weaponState.rcrl.ammo = 0; weaponState.rcrl.cooldown = 0;     // RC launcher is streak-only — no respawn ammo
  rcEquipped = false;                                 // never respawn holding the RC launcher
  // Both modes respawn onto the main gun (gun-game: current ladder rung; FFA: your chosen main).
  player.grenades = 0; player.impulses = IMPULSE.maxCarry; player.lethals = LETHAL_MAX; ggKarambit = false;
  player.overheal = 0;   // a fresh life starts at a clean 100 HP — no leftover JD shield
  // Part 2: respawn FULLY LOADED — every gun gets a full magazine + full reserve, no reloads/cooldowns pending.
  GUNGAME_LADDER.concat(FFA_ONLY_WEAPONS).forEach(k => {
    weaponState[k].ammo = WEAPONS[k].mag; weaponState[k].cooldown = 0; weaponState[k].reloading = 0;
    if (weaponState[k].reserve !== Infinity && WEAPONS[k].reserveMax != null) weaponState[k].reserve = WEAPONS[k].reserveMax;
  });
  weaponState.gg17.ammoL = weaponState.gg17.ammoR = null;   // re-split akimbo on respawn refill
  if (gameMode !== 'gungame' && !WEAPONS[ffaMain]) ffaMain = 'gg2';
  ggEquip(mainGunKey());
  updateHUD();
  maybeShowInvTip(4, false);   // brief inventory reminder on FFA respawn
}

/* ============================================================================
   PART 5 — KILLCAM: a brief death replay from the killer's perspective (or a
   death-cam orbit fallback), skippable with the jump key. Victim-only.
   ============================================================================ */
let _camRing = [], _camRingAcc = 0, _camFire = 0;   // rolling killer-POV buffer @ 30Hz (holds 3s before + 2s after a kill)
let _worldRing = [], _worldRingAcc = 0;             // rolling buffer of OTHER players' positions @ 20Hz
// New timing (Part 2): the killcam shows 3s BEFORE the kill + 2s AFTER (kill lands at the 3s / 60% mark).
