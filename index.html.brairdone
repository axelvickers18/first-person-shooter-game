    const p = new THREE.Mesh(new THREE.BoxGeometry(3, 3, 0.05), new THREE.MeshLambertMaterial({ color: 0x000000, transparent: true, opacity: 0.16 })); p.position.set(SP(x), y, SP(z)); scene.add(p);
  });

  // 13. PUDDLES — flat, faintly reflective dark discs on the street (cosmetic).
  [[-4, -10], [5, 15], [-6, 35], [8, -30]].forEach(([x, z]) => { const p = new THREE.Mesh(new THREE.CylinderGeometry(1.4, 1.4, 0.04, 16), new THREE.MeshLambertMaterial({ color: 0x2a3a4a, transparent: true, opacity: 0.7 })); p.position.set(SP(x), 0.03, SP(z)); scene.add(p); mapPuddles.push({ mesh: p }); });

