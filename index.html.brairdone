    if (new THREE.Raycaster(from, rd, 0, Math.abs(step) + 0.7).intersectObjects(colliders, false).length) sc.speed *= 0.25;
    else { sc.pos.x = Math.max(-ARENA + 2, Math.min(ARENA - 2, sc.pos.x + dir.x * step)); sc.pos.z = Math.max(-ARENA + 2, Math.min(ARENA - 2, sc.pos.z + dir.z * step)); }
  }
