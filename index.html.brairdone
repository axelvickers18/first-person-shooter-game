      const hA = new THREE.MeshPhongMaterial({ color: 0xaab2bc, specular: 0xeaf0f6, shininess: 90, flatShading: true });   // lighter handle
      const hB = new THREE.MeshPhongMaterial({ color: 0x6a7079, specular: 0xaab2bc, shininess: 70, flatShading: true });   // darker handle
