  const rcView = rcActive && rcCamLive;
  el('rcHud').classList.toggle('on', rcView);
  if (rcView) {
    const W = window.innerWidth, H = window.innerHeight;
    rcCam.aspect = W / H; rcCam.updateProjectionMatrix();
    renderer.render(scene, rcCam);
    // picture-in-picture: the player body's normal view, bottom-right corner
    const pw = Math.round(W * 0.24), ph = Math.round(H * 0.24), pad = 16;
    renderer.clearDepth();
    renderer.setScissorTest(true);
    renderer.setScissor(W - pw - pad, pad, pw, ph);
    renderer.setViewport(W - pw - pad, pad, pw, ph);
    camera.aspect = pw / ph; camera.updateProjectionMatrix();
    renderer.render(scene, camera);
    renderer.setScissorTest(false);
    renderer.setViewport(0, 0, W, H);
    camera.aspect = W / H; camera.updateProjectionMatrix();
  } else {
    renderer.render(scene, camera);
  }
}
animate();
</script>
</body>
</html>
