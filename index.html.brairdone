      iB(px, G + 4, pz, 6, 0.3, 7, 0x55585c); iD(px - 1.2, G + 0.4, pz, 1.6, 0.8, 1.4, 0x40454c); lightFix(px, pz, G + 3.6); })();
    iD(lx + 0, G + 0.45, lz + 9, 5, 0.95, 1.0, 0x8a8a82); iD(lx - 3, G + 0.45, lz + 9, 1.0, 0.95, 3, 0x8a8a82); lightFix(lx, lz + 9, G + 4.7);   // kitchen counters
    iD(lx + 15, G + 0.4, lz - 6, 2.8, 0.7, 1.1, 0x46688a); iD(lx + 15, G + 0.4, lz - 3, 1.1, 0.7, 2.8, 0x46688a); iD(lx + 17, G + 0.5, lz + 6, 1.0, 1.6, 3, 0x7a3a2a); lightFix(lx + 15, lz - 4, G + 4.7);   // drawing room: couches + fireplace
    // ---- F2: bedroom corridor + master suite ----
    for (let i = 0; i < 5; i++) { const bx = lx - 14 + i * 7, bz = (i % 2 ? lz + 8 : lz - 8); iD(bx, F2 + 0.3, bz, 2.0, 0.5, 1.1, 0x5a4a6a); iD(bx - 0.6, F2 + 0.55, bz, 0.7, 0.22, 1.0, 0xe8e2ee); lightFix(bx, bz, F2 + 4.7); }   // bedrooms (beds + pillows)
    iD(lx + 14.5, F2 + 0.35, lz, 2.8, 0.6, 1.5, 0x6a4a6a); iD(lx + 14.5, F2 + 0.3, lz + 4, 1.4, 0.7, 1.4, 0x55504a); lightFix(lx + 14.5, lz + 1, F2 + 4.7);   // master suite (king bed + dresser)
    // ---- F3: attic bedrooms + library annex ----
    for (let i = 0; i < 3; i++) { const bx = lx - 10 + i * 9; iD(bx, F3 + 0.3, lz - 6, 1.8, 0.5, 1.0, 0x5a4a6a); lightFix(bx, lz - 6, F3 + 4.7); }
    for (let i = 0; i < 4; i++) iD(lx - 15 + i * 4, F3 + 1.0, lz + 9, 0.5, 2.0, 1.8, 0x5a4632);   // library-annex shelves
    // ---- rear wine-cellar annex (ground level, the "lower" level) ----
    (function () { const wx = lx, wz = lz + hd + 6;
      iWallX(wz + 4, wx - 7, wx + 7, G, G + 4, t, 0x6a5a4a, []); iWallX(wz - 4, wx - 7, wx + 7, G, G + 4, t, 0x6a5a4a, [{ a0: wx - 1.5, a1: wx + 1.5, y0: G, y1: G + 2.4 }]);
      iWallZ(wx - 7, wz - 4, wz + 4, G, G + 4, t, 0x6a5a4a, []); iWallZ(wx + 7, wz - 4, wz + 4, G, G + 4, t, 0x6a5a4a, []); iB(wx, G + 4, wz, 14.5, 0.3, 8.5, 0x5a4a3a);
      for (let i = 0; i < 4; i++) iD(wx - 5 + i * 3.3, G + 1.0, wz + 3, 2.8, 2.0, 0.6, 0x4a3a2a); lightFix(wx, wz, G + 3.6); })();
    // ---- GARAGE with luxury cars ----
    (function () { const gx = lx - 30, gz = lz + 4, gw = 16, gd = 12;
      iWallX(gz - gd / 2, gx - gw / 2, gx + gw / 2, G, G + 4.5, t, 0xc9c0aa, [{ a0: gx - 4, a1: gx + 4, y0: G, y1: G + 3.8 }]); iWallX(gz + gd / 2, gx - gw / 2, gx + gw / 2, G, G + 4.5, t, 0xc9c0aa, []);
      iWallZ(gx - gw / 2, gz - gd / 2, gz + gd / 2, G, G + 4.5, t, 0xc9c0aa, []); iWallZ(gx + gw / 2, gz - gd / 2, gz + gd / 2, G, G + 4.5, t, 0xc9c0aa, []);
      iB(gx, G + 4.5, gz, gw + 0.4, 0.4, gd + 0.4, 0x8a8276);
      [[-4.5, 0x8a2a2a], [0, 0x222a3a], [4.5, 0xb0a060]].forEach(c => { iD(gx + c[0], G + 0.6, gz + 1, 2.6, 1.1, 5, c[1]); iD(gx + c[0], G + 1.35, gz + 0.5, 2.2, 0.7, 2.4, c[1]); }); lightFix(gx, gz, G + 4.0); })();
    hut(lx - 50, lz + 16, 11, 9, 0xd9d2c0, 'e');                                        // guest house
    hut(lx + 52, lz - 8, 9, 8, 0xc9d9e0, 'w'); disc(lx + 52, lz + 8, 7, 0.06, 0x3a8acf, 18);   // pool house + pool
    iCyl(lx, G + 0.4, lz - 35, 2.4, 0.8, stoneLt); iB(lx, G, lz - 35, 0.7, 1.9, 0.7, stoneLt);   // garden fountain
    [[-14, -29], [14, -29]].forEach(h => iB(lx + h[0], G, lz + h[1], 5, 1.2, 0.7, 0x3f6e3a)); [[-18, -31], [18, -31]].forEach(s => iB(lx + s[0], G, lz + s[1], 1, 3, 1, stoneLt));   // hedges + statues
    iD(lx + 34, G + 0.05, lz + 16, 14, 0.05, 24, 0x2f6e4a); iD(lx + 34, G + 0.6, lz + 16, 14, 1.0, 0.2, 0xffffff);   // tennis court + net
    // chests on the upper floors + special rooms (placed at an exact Y — the indoor loot sampler only reaches the ground floor)
    fixedChests.push(
      { x: cx + lx + 14.5, z: cz + lz, y: F2 + 0.1, rar: 'legendary' },                                                                          // master-suite legendary
      { x: cx + lx - 14, z: cz + lz - 8, y: F2 + 0.1, rar: 'rare' }, { x: cx + lx, z: cz + lz + 8, y: F2 + 0.1, rar: 'common' }, { x: cx + lx + 7, z: cz + lz - 8, y: F2 + 0.1, rar: 'common' },   // F2 bedrooms
      { x: cx + lx - 10, z: cz + lz - 6, y: F3 + 0.1, rar: 'rare' }, { x: cx + lx + 8, z: cz + lz + 9, y: F3 + 0.1, rar: 'common' },               // F3 attic + library annex
      { x: cx + lx - 15.5, z: cz + lz + 11, y: G + 0.1, rar: 'legendary' },                                                                       // hidden panic room
      { x: cx + lx, z: cz + lz + hd + 6, y: G + 0.1, rar: 'rare' }                                                                                // wine cellar
    );
    iSpawn(lx, lz - 9); iSpawn(lx - 12, lz + 8); iSpawn(lx - 30, lz + 4); iSpawn(lx - 50, lz + 16); iPatrol(lx, lz); iPatrol(lx, lz - 26); iPatrol(lx + 34, lz + 16);
  }
  // __POI_DEFS__
  poiBeachTown(0, -205);     // south beach
  poiResort(-165, -135);     // south-west coast
  poiRuins(0, 0);            // central jungle
  poiCamp(150, 35);          // east-central
  poiHarbor(212, -25);       // east coast (stilts over the water)
  poiCliff(-150, 116);       // south flank of the west mountain
  poiCargo(35, 212);         // north shore (beached)
  poiAirstrip(-95, 165);     // north clearing
  poiMansion(155, 150);      // north-east hilltop
  // __POI_CALLS__

  // ============ POI DEPTH PASS (Part 3): extra enterable buildings + interior furniture + verticality ============
  function furnish(lx, lz, by, n) { for (let i = 0; i < (n || 3); i++) { const a = i * 1.9, r = 1.2 + (i % 3); iD(lx + Math.cos(a) * r, (by || 0) + 0.02, lz + Math.sin(a) * r, 1.0, 0.55 + (i % 2) * 0.5, 1.0, [0x6f5333, 0x8a7a5a, 0x55554a, 0x7a6f55][i % 4]); } }
  // ===== (Part 2) INTERIOR DETAIL: themed furniture library + ceiling lights + framed windows =====
  const FURN = {   // [w, h, d, colour] per furniture piece
    bed: [2.0, 0.5, 1.1, 0x5a4a6a], pillow: [0.7, 0.22, 1.0, 0xe8e2ee], table: [1.5, 0.7, 0.95, 0x6f5333], chair: [0.6, 0.9, 0.6, 0x7a6f55],
    shelf: [1.7, 1.9, 0.45, 0x7a6f55], counter: [2.6, 0.95, 0.8, 0x8a7a5a], crate: [1.1, 1.0, 1.1, 0x6a5a3a], couch: [2.3, 0.7, 0.95, 0x46688a],
    desk: [1.6, 0.8, 0.85, 0x55504a], locker: [0.85, 1.9, 0.7, 0x586272], bunk: [2.1, 1.7, 0.95, 0x4a4a44], barrel: [0.8, 1.05, 0.8, 0x8c3a2a],
    pew: [2.4, 0.55, 0.6, 0x6f5a3a], altar: [1.7, 1.05, 1.1, 0x9a9384], rack: [1.8, 1.7, 0.4, 0x40454c], bookshelf: [2.0, 2.2, 0.5, 0x5a4632],
    stove: [1.2, 1.0, 0.9, 0x55585c], crates2: [1.4, 1.6, 1.4, 0x7a6a4a], toilet: [0.7, 0.7, 0.9, 0xe2e6ea], sink: [1.0, 0.85, 0.6, 0xd2d8dc],
    car: [2.4, 1.3, 5.0, 0x8a2a2a], winerack: [1.7, 2.0, 0.6, 0x4a3a2a], cot: [2.0, 0.45, 0.9, 0x6a6a5e], tank: [1.3, 1.9, 1.3, 0x6a7a5a]
  };
  function lightFix(lx, lz, y) { iD(lx, y - 0.1, lz, 0.7, 0.12, 0.7, 0x2b2b2e); iGlow(lx, y - 0.42, lz, 1.05, 0.5, 1.05, 0xffe6a8, 0.7); }   // ceiling lamp + warm glow (lit at night)
  function furnishRoom(lx, lz, by, kinds, ceilY) {   // scatter themed furniture pieces (decorative) round a room + a ceiling light
    by = by || 0;
    kinds.forEach((k, i) => { const f = FURN[k] || FURN.crate, a = i * 2.39 + 0.6, r = 0.9 + (i % 3) * 0.95; const fx = lx + Math.cos(a) * r, fz = lz + Math.sin(a) * r; iD(fx, by + f[1] / 2 + 0.02, fz, f[0], f[1], f[2], f[3]); if (k === 'bed') iD(fx - 0.6, by + 0.5 + 0.13, fz, FURN.pillow[0], FURN.pillow[1], FURN.pillow[2], FURN.pillow[3]); });
    if (ceilY) lightFix(lx, lz, by + ceilY);
  }
  function windowPane(lx, lz, axis, span, y) {   // a translucent glass pane on a wall (framed look from outside)
    const m = new THREE.Mesh(axis === 'x' ? new THREE.BoxGeometry(span, 1.3, 0.12) : new THREE.BoxGeometry(0.12, 1.3, span), new THREE.MeshLambertMaterial({ color: 0xbfe0ee, transparent: true, opacity: 0.32, flatShading: true }));
    m.position.set(cx + lx, y, cz + lz); scene.add(m);
    const fr = axis === 'x' ? [span + 0.18, 1.5, 0.16] : [0.16, 1.5, span + 0.18]; iD(lx, y, lz, fr[0], fr[1], fr[2], 0x4a4038);   // dark frame
  }
  function enterBox(lx, lz, w, d, h, col, dd, by, kinds) {   // a single-storey enterable room (door on dd), roof + framed door/windows + furniture + ceiling light
    by = by || 0;
    const dh = (dir) => dd === dir ? [{ a0: lx - 1, a1: lx + 1, y0: by, y1: by + 2.4 }] : [];
    const dhZ = (dir) => dd === dir ? [{ a0: lz - 1, a1: lz + 1, y0: by, y1: by + 2.4 }] : [];
    iWallX(lz + d / 2, lx - w / 2, lx + w / 2, by, by + h, 0.35, col, dh('n'));
    iWallX(lz - d / 2, lx - w / 2, lx + w / 2, by, by + h, 0.35, col, dh('s'));
    iWallZ(lx + w / 2, lz - d / 2, lz + d / 2, by, by + h, 0.35, col, dhZ('e'));
    iWallZ(lx - w / 2, lz - d / 2, lz + d / 2, by, by + h, 0.35, col, dhZ('w'));
    iB(lx, by + h, lz, w + 0.3, 0.4, d + 0.3, 0x8a8276); iB(lx, by, lz, w - 0.4, 0.08, d - 0.4, 0x55504a);   // solid roof + solid floor (so elevated rooms are walkable, not fall-through)
    if (dd !== 'n') windowPane(lx, lz + d / 2 - 0.1, 'x', Math.min(2.2, w - 2), by + 1.7); if (dd !== 's') windowPane(lx, lz - d / 2 + 0.1, 'x', Math.min(2.2, w - 2), by + 1.7);   // framed windows on the wall-less sides
    if (dd === 'n' || dd === 's') { const fp = 0.9; [-1, 1].forEach(s => iD(lx + s * 1.05, by + 1.2, lz + (dd === 'n' ? d / 2 : -d / 2), 0.18, 2.4, 0.4, 0x4a4038)); iD(lx, by + 2.45, lz + (dd === 'n' ? d / 2 : -d / 2), 2.4, 0.25, 0.4, 0x4a4038); }   // door frame posts + lintel
    furnishRoom(lx, lz, by, kinds || ['table', 'shelf', 'crate', 'chair'], h - 0.3);
  }
  function ladderTo(lx, lz, top) { for (let y = 0.5; y < top; y += 0.6) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.1, 0.1), flatMat(0x6a6a6a)); m.position.set(cx + lx, y, cz + lz); scene.add(m); } ladders.push({ x: cx + lx, z: cz + lz, bottom: 0, top: top, cx: cx + lx, cz: cz + lz - 1.2, outX: 0, outZ: -1 }); }
  pois.forEach(p => {
    const lx = p.lx, lz = p.lz, n = p.name;
    if (n === 'PARADISE COVE') {
      enterBox(lx + 31, lz + 4, 10, 8, 4.2, pastel[1], 'w', 0, ['bed', 'bed', 'table', 'chair', 'counter']); ladderTo(lx + 31, lz + 8.3, 4.6);   // inn: bar downstairs, beds up
      enterBox(lx - 29, lz + 11, 9, 7, 3.6, pastel[2], 'e', 0, ['counter', 'crate', 'shelf', 'crate']);                                          // fish market
      furnishRoom(lx - 24, lz - 15, 0, ['pew', 'pew', 'pew', 'altar'], 4.6);   // chapel pews + altar
      furnishRoom(lx + 26, lz - 17, 0, ['shelf', 'shelf', 'counter', 'crate'], 4.4);   // general store
    }
    // LAGOON RESORT is now fully built (4-storey hotel + pool house + spa + bar) in poiResort — no generic furnishing here

    // ANCIENT RUINS is now fully built (hollow pyramid + chambers + crypt + priest buildings) in poiRuins — no generic furnishing here

    // CAMP DELTA is now fully built (2-storey command center, barracks, armory, towers, motor pool) in poiCamp — no generic furnishing here

    else if (n === "HARBOR'S EDGE") {
      enterBox(lx - 18, lz + 24, 12, 10, 4, 0x6a6f78, 'n', 0, ['crates2', 'crate', 'shelf', 'crates2']); ladderTo(lx - 18, lz + 29.3, 4.6);   // warehouse
      furnishRoom(lx + 6, lz + 4, 0, ['table', 'counter', 'crate'], 3.6);   // fish processing tables
    }
    else if (n === 'CLIFF SETTLEMENT') {
      enterBox(lx + 16, lz + 6, 8, 7, 3.4, rockDk, 'w', 0, ['bed', 'table', 'crate']);              // hut
      enterBox(lx - 15, lz + 4, 7, 6, 3.2, rockC, 'e', 0, ['cot', 'shelf', 'crate']);               // hut
      furnishRoom(lx, lz, 0, ['table', 'pew', 'pew', 'crate'], 3.8);                                 // longhouse meeting hall
    }
    // RUSTED HULL is now fully built (4 levels + stairs + crew/bridge) in poiCargo — no generic furnishing here
    // AIRSTRIP is now fully built (4-storey control tower + hangars + terminal + fuel depot) in poiAirstrip — no generic furnishing here

    // MILLIONAIRE'S RETREAT is now fully built (3 storeys + rooms + stairs) in poiMansion — no generic furnishing needed here
  });

  // --- generic loot/exploration spawns: a ring of beach drop-in points (more added per-POI) ---
  for (let a = 0; a < 10; a++) { const ang = a / 10 * Math.PI * 2; iSpawn(Math.cos(ang) * (R - 40), Math.sin(ang) * (R - 40)); iPatrol(Math.cos(ang) * (R - 60), Math.sin(ang) * (R - 60)); }
  iPatrol(0, 0); iPatrol(60, 60); iPatrol(-60, -60); iPatrol(150, 40); iPatrol(0, -210);

  // --- scooters along the roads (traversal) + boost pads at select POIs (Section 1 "kept in BR") ---
  [[-90, -70], [80, 5], [10, 150], [-60, 35], [120, -70], [180, 100]].forEach(s => scooterSpawns.push(new THREE.Vector3(cx + s[0], groundHeightAt(cx + s[0], cz + s[1], 0.4), cz + s[1])));
  [[35, 196], [-150, 134], [-150, -128], [150, 70]].forEach(p => addLaunchPad(cx + p[0], cz + p[1], 0x12d0f0));   // cargo beach, cliff foot, resort, camp

  // night fireflies over the jungle (opacity raised at night in brUpdate)
  const ffGeo = new THREE.BufferGeometry(), ffN = 150, ffPos = new Float32Array(ffN * 3);
  for (let i = 0; i < ffN; i++) { const a = Math.random() * 6.28, rr = Math.random() * (R - 70); ffPos[i * 3] = cx + Math.cos(a) * rr; ffPos[i * 3 + 1] = 1.5 + Math.random() * 5; ffPos[i * 3 + 2] = cz + Math.sin(a) * rr; }
  ffGeo.setAttribute('position', new THREE.BufferAttribute(ffPos, 3));
  const fireflies = new THREE.Points(ffGeo, new THREE.PointsMaterial({ color: 0xcaff70, size: 0.6, transparent: true, opacity: 0, depthWrite: false })); scene.add(fireflies);

  return { cx, cz, R, spawns, scooterSpawns, patrol, pois, glows, peaks, caveSpots, lootSpots, secretSpots, fixedChests, fireflies };
}

/* ============================================================================
   COLLISION HELPERS — ground height lookup + horizontal wall push-out
   (STEP is declared up in the MAP section so the map can use groundHeightAt.)
   ============================================================================ */

// Highest standable surface at (x,z) given the entity's current feet height.
function groundHeightAt(x, z, feetY) {
  let h = 0; // floor
  for (const s of solids) {
    if (x > s.min.x && x < s.max.x && z > s.min.z && z < s.max.z) {
      const top = s.max.y;
      if (top <= feetY + STEP && top > h) h = top;
    }
  }
  for (const r of ramps) {
    if (x > r.minX && x < r.maxX && z > r.minZ && z < r.maxZ) {
      const along = r.axis === 'z' ? z : x;
      const t = (along - r.lowAt) / (r.highAt - r.lowAt);
      const surf = r.lowH + Math.max(0, Math.min(1, t)) * (r.highH - r.lowH);
      if (surf <= feetY + STEP + 0.6 && surf > h) h = surf;
    }
  }
  return h;
}

// Push an entity out of any wall/crate it's overlapping (only when feet are
// below the box top — so you can still stand on top of crates/platforms).
function resolveHorizontal(pos, bodyHeight, prevY) {
  const r = MOVE.radius;
  if (prevY == null) prevY = pos.y;               // NPC callers omit prevY -> reduces to the original behavior
  for (const s of solids) {
    const top = s.max.y, bot = s.min.y;
    // Don't push out of a surface you're standing ON or can step ONTO (top within STEP of the
    // feet). This matches groundHeightAt's step rule, so the per-frame gravity dip while standing
    // on an elevated surface (2nd floor, crate, watchtower platform) never shoves you off the edge.
    if (pos.y >= top - STEP) continue;            // standing on / stepping onto / above it
    // ...nor off a floor you were on/above LAST frame and are now (fast-)falling onto. A hard drop can
    // dip the feet >STEP below a floor top in a single frame; without this guard the floor would be read
    // as a wall and the player flung sideways off its edge — landing on nothing and phasing through.
    // (Walls you run into have prevY well below their top, so they still push you out normally.)
    if (prevY >= top - 0.02) continue;
    if (pos.y + bodyHeight <= bot) continue;      // entirely below it
    if (pos.x > s.min.x - r && pos.x < s.max.x + r &&
        pos.z > s.min.z - r && pos.z < s.max.z + r) {
      const penLeft  = pos.x - (s.min.x - r);
      const penRight = (s.max.x + r) - pos.x;
      const penBack  = pos.z - (s.min.z - r);
      const penFwd   = (s.max.z + r) - pos.z;
      const minX = Math.min(penLeft, penRight);
      const minZ = Math.min(penBack, penFwd);
      if (minX < minZ) pos.x += (penLeft < penRight) ? -minX : minX;
      else             pos.z += (penBack < penFwd) ? -minZ : minZ;
    }
  }
}

/* ============================================================================
   4. INPUT — custom pointer lock (so we control recoil) + keys/mouse
   ============================================================================ */
const keys = {};
let yaw = 0, pitch = 0;            // look angles
let recoilPitch = 0, recoilYaw = 0;
let pointerLocked = false;
let paused = false;                // pause/settings menu open mid-match: local input disabled (game keeps running)
const SENS = 0.0022;

/* ============================================================================
   INPUT MANAGER — central action→key binding map. All gameplay input goes through
   IM.down(action) (held) / IM.codeAction(code) (press dispatch), so remapping a key in
   the Controls menu instantly works everywhere. Bindings + options persist in localStorage.
   Codes are KeyboardEvent.code values, or pseudo-codes for the mouse: Mouse0 (L), Mouse2 (R),
   Mouse1 (M), WheelUp, WheelDown.
   ============================================================================ */
const IM = {
  defaults: {
    moveForward: 'KeyW', moveBackward: 'KeyS', moveLeft: 'KeyA', moveRight: 'KeyD', jump: 'Space', sprint: 'ShiftLeft', crouch: 'KeyC',
    weapon1: 'Digit1', weapon2: 'Digit2', karambit: 'Digit3', brSlot4: 'Digit4', brSlot5: 'Digit5', equipRC: 'Digit0', fire: 'Mouse0', ads: 'Mouse2', reload: 'KeyR', prevWeapon: 'WheelUp', nextWeapon: 'WheelDown', toggleLaser: 'KeyL',
    use: 'KeyQ', grenade: 'KeyG', lethal: 'KeyH', interact: 'KeyE', flashlight: 'KeyF',
    saber: 'KeyB', flamethrower: 'KeyV', rcStreak: 'KeyN', dogs: 'KeyM', kong: 'Equal',
    inventory: 'KeyI', pause: 'Escape', scoreboard: 'Tab', chat: 'Enter', toggleHints: 'KeyP', inspect: 'KeyT', drinkJD: 'KeyZ', dropWeapon: 'KeyX'
  },
  // Movement keys can't be left unbound (the player must be able to move). ESC always reaches the menu.
  CRITICAL: ['moveForward', 'moveBackward', 'moveLeft', 'moveRight'],
  // Ordered UI layout: ['CATEGORY', null] header rows, else [action, label, note].
  ROWS: [
    ['MOVEMENT', null],
    ['moveForward', 'Move Forward'], ['moveBackward', 'Move Backward'], ['moveLeft', 'Move Left'], ['moveRight', 'Move Right'],
    ['jump', 'Jump'], ['sprint', 'Sprint'], ['crouch', 'Crouch / Dive (sprint + key)'],
    ['WEAPONS / EQUIPMENT', null],
    ['weapon1', 'Weapon Slot 1 / BR Inv Slot 1'], ['weapon2', 'Weapon Slot 2 / BR Inv Slot 2'], ['karambit', 'Equip Karambit / BR Inv Slot 3'], ['brSlot4', 'BR Inventory Slot 4'], ['brSlot5', 'BR Inventory Slot 5'], ['equipRC', 'Equip RC Launcher', 'when unlocked'],
    ['fire', 'Fire / Attack'], ['ads', 'Aim Down Sights / Block'], ['reload', 'Reload'], ['prevWeapon', 'Previous Weapon'], ['nextWeapon', 'Next Weapon'], ['toggleLaser', 'Toggle Laser Sight', 'laser weapons'], ['flashlight', 'Toggle Flashlight', 'flashlight attachment'],
    ['CONSUMABLES / ABILITIES', null],
    ['use', 'Use Cigar / Drink JD  •  BR: Equip Melee'], ['grenade', 'Throw Impulse  •  BR: Drop Held Item'], ['lethal', 'Throw Lethal (Smoke / Axe)'], ['interact', 'Interact / Climb Ladder'],
    ['SCORESTREAKS', null],
    ['saber', 'Saber + Jack Daniels', '3-kill streak'], ['flamethrower', 'Flamethrower', '4-kill streak'], ['rcStreak', 'RC Rocket Launcher', '5-kill streak'], ['dogs', 'Kirks Avengers', '10-kill streak'], ['kong', 'Summon King Kong', 'secret'],
    ['UI / MENUS', null],
    ['inventory', 'Inventory / FFA Loadout'], ['pause', 'Pause / Settings'], ['scoreboard', 'Scoreboard'], ['chat', 'Chat'], ['toggleHints', 'Toggle Control Hints'], ['inspect', 'Inspect Weapon']
  ],
  PRESETS: {
    default: {},   // = defaults (filled in load)
    southpaw: { moveForward: 'ArrowUp', moveBackward: 'ArrowDown', moveLeft: 'ArrowLeft', moveRight: 'ArrowRight' }
  },
  bind: {},
  load() {
    this.PRESETS.default = Object.assign({}, this.defaults);
    this.bind = Object.assign({}, this.defaults);
    try { const b = JSON.parse(localStorage.getItem('controls_v1')); if (b && typeof b === 'object') Object.assign(this.bind, b); } catch (e) {}
  },
  save() { try { localStorage.setItem('controls_v1', JSON.stringify(this.bind)); } catch (e) {} },
  saveCustom() { try { localStorage.setItem('controls_custom_v1', JSON.stringify(this.bind)); } catch (e) {} },
  resetDefault() { this.bind = Object.assign({}, this.defaults); this.save(); },
  loadPreset(name) {
    if (name === 'custom') { let c = null; try { c = JSON.parse(localStorage.getItem('controls_custom_v1')); } catch (e) {} this.bind = Object.assign({}, this.defaults, c || {}); }
    else this.bind = Object.assign({}, this.defaults, this.PRESETS[name] || {});
    this.save();
  },
  down(action) { return !!keys[this.bind[action]] || !!(GP.held && GP.held[action]); },   // held: keyboard OR gamepad (ladder/scooter/jump/crouch/sprint)
  codeAction(code) { for (const a in this.bind) if (this.bind[a] === code) return a; return null; },   // reverse lookup
  keyLabel(code) {
    if (!code) return '(Not Bound)';
    const m = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'Shift', ControlLeft: 'Ctrl', ControlRight: 'Ctrl', AltLeft: 'Alt', AltRight: 'Alt', Tab: 'Tab', Enter: 'Enter', Escape: 'ESC', Backspace: 'Backspace', CapsLock: 'Caps',
      Mouse0: 'L Mouse', Mouse2: 'R Mouse', Mouse1: 'M Mouse', WheelUp: 'M Wheel ↑', WheelDown: 'M Wheel ↓', ArrowUp: '↑', ArrowDown: '↓', ArrowLeft: '←', ArrowRight: '→' };
    if (m[code]) return m[code];
    let mm; if (mm = code.match(/^Key([A-Z])$/)) return mm[1];
    if (mm = code.match(/^Digit([0-9])$/)) return mm[1];
    if (mm = code.match(/^Numpad(.+)$/)) return 'Num ' + mm[1];
    if (/^F\d+$/.test(code)) return code;
    return code;
  }
};
IM.load();

/* Local control OPTIONS (sensitivity, invert-Y, ADS/sprint hold-vs-toggle, auto-reload, hit markers, FOV). */
const OPT = {
  sens: 1, sensAds: 1, sensScope: 1, invertY: false, adsToggle: false, sprintToggle: false, autoReload: true, hitMarkers: true, dmgNumbers: true, ctrlHints: true, fov: 78,
  load() { try { const o = JSON.parse(localStorage.getItem('controls_opts_v1')); if (o && typeof o === 'object') Object.assign(this, o); } catch (e) {} },
  save() { try { localStorage.setItem('controls_opts_v1', JSON.stringify({ sens: this.sens, sensAds: this.sensAds, sensScope: this.sensScope, invertY: this.invertY, adsToggle: this.adsToggle, sprintToggle: this.sprintToggle, autoReload: this.autoReload, hitMarkers: this.hitMarkers, dmgNumbers: this.dmgNumbers, ctrlHints: this.ctrlHints, fov: this.fov })); } catch (e) {} }
};
OPT.load();
DEFAULT_FOV = OPT.fov;     // apply the saved field-of-view
let sprintLatch = false;   // sprint toggle-mode latched state (held checks read sprint OR this)
function kbDown(action) { return !!keys[IM.bind[action]]; }   // keyboard-only held (gamepad analog movement is added separately)

/* ============================================================================
   GAMEPAD / CONTROLLER SUPPORT — W3C Gamepad API (navigator.getGamepads). Additive to the
   keyboard: polled each frame in animate(), routed through the SAME action system (gameAction /
   firePress / adsPress / IM.down via GP.held) so every gameplay feature works on a controller with
   no per-feature changes. Standard mapping (Xbox button indices; PS = same indices, relabelled).
   ============================================================================ */
const GP = {
  active: false,            // true => the controller is the CURRENT input mode (drives on-screen prompts)
  index: -1,                // active gamepad slot in navigator.getGamepads()
  type: 'xbox',             // 'xbox' | 'ps' (label set auto-detected from the gamepad id)
  pads: {},                 // index -> { name } of every connected pad (up to 4)
  held: {},                 // action -> bool, merged into IM.down() (movement 8-way + jump/sprint/crouch)
  mvX: 0, mvY: 0,           // left-stick analog (deadzoned): +x right, +y down (updateMovement reads these)
  prev: [],                 // previous frame's button.pressed[] (edge detection)
  _rt: false, _lt: false, _kong: false, _back: false, _invByBack: false, backHoldT: 0,
  rebindAction: null,       // when set, the next gamepad button press rebinds this action
  // --- persisted settings (controller_v1) ---
  dzL: 0.12, dzR: 0.08, sensH: 2.0, sensV: 1.5, sensAds: 0.6, aimAssist: true, aimStr: 0.30,
  curve: 'exp', rumbleOn: true, rumbleInt: 0.7, invertY: false,
  // default action -> standard button index
  bind: { jump: 0, crouch: 1, reload: 2, karambit: 3, grenade: 4, lethal: 5, ads: 6, fire: 7,
          scoreboard: 8, pause: 9, sprint: 10, quickMelee: 11, use: 12, interact: 13, weapon1: 14, weapon2: 15 },
  defaults: {},
  load() {
    this.defaults = Object.assign({}, this.bind);
    try { const o = JSON.parse(localStorage.getItem('controller_v1')); if (o && typeof o === 'object') {
      ['dzL','dzR','sensH','sensV','sensAds','aimAssist','aimStr','curve','rumbleOn','rumbleInt','invertY'].forEach(k => { if (o[k] != null) this[k] = o[k]; });
      if (o.bind && typeof o.bind === 'object') Object.assign(this.bind, o.bind);
    } } catch (e) {}
  },
  save() { try { localStorage.setItem('controller_v1', JSON.stringify({ dzL: this.dzL, dzR: this.dzR, sensH: this.sensH, sensV: this.sensV, sensAds: this.sensAds, aimAssist: this.aimAssist, aimStr: this.aimStr, curve: this.curve, rumbleOn: this.rumbleOn, rumbleInt: this.rumbleInt, invertY: this.invertY, bind: this.bind })); } catch (e) {} },
  resetBind() { this.bind = Object.assign({}, this.defaults); this.save(); },
  dz(v, d) { const a = Math.abs(v); if (a <= d) return 0; return Math.sign(v) * (a - d) / (1 - d); },   // deadzone + rescale
  detectType(id) { const s = (id || '').toLowerCase(); if (/xbox|xinput|045e/.test(s)) return 'xbox'; if (/dualshock|dualsense|playstation|sony|054c|0ce6/.test(s)) return 'ps'; return 'xbox'; },   // Xbox first ("Xbox Wireless Controller"), then PS, else standard=Xbox labels
  setMode(on) { if (this.active === on) return; this.active = on; if (typeof refreshKeyHints === 'function') refreshKeyHints(); if (typeof updateStreakHUD === 'function') updateStreakHUD(); },
  onConnect(g) {
    if (Object.keys(this.pads).length >= 4 && this.pads[g.index] == null) return;   // support up to 4
    this.pads[g.index] = { name: g.id }; if (this.index < 0) { this.index = g.index; this.type = this.detectType(g.id); }
    const nm = (g.id || 'Controller').replace(/\s*\([^)]*\)\s*/g, '').trim().slice(0, 30) || 'Controller';
    if (typeof gpToast === 'function') gpToast('🎮 ' + nm + ' CONNECTED');
    if (typeof maybeShowGpTutorial === 'function') maybeShowGpTutorial();
  },
  onDisconnect(g) {
    delete this.pads[g.index];
    if (this.index === g.index) { this.index = -1; for (const k in this.pads) { this.index = +k; break; } }
    if (this.index < 0) { this.held = {}; this.setMode(false); if (typeof gpToast === 'function') gpToast('🎮 Controller disconnected — switching to keyboard'); }
  },
  rumble(strong, weak, dur) {
    if (!this.rumbleOn || this.index < 0) return;
    const pads = navigator.getGamepads ? navigator.getGamepads() : []; const g = pads[this.index]; if (!g) return;
    const act = g.vibrationActuator; if (!act || !act.playEffect) return;
    try { act.playEffect('dual-rumble', { duration: dur, strongMagnitude: Math.min(1, strong * this.rumbleInt), weakMagnitude: Math.min(1, weak * this.rumbleInt) }); } catch (e) {}
  },
  // PS/Xbox label for a button index, plus combo labels — used by the dynamic on-screen prompts
  gpIcon(action) {
    const F = this.type === 'ps'
      ? ['(✕)','(○)','(▢)','(△)','[L1]','[R1]','[L2]','[R2]','[Share]','[Options]','[L3]','[R3]','[D↑]','[D↓]','[D←]','[D→]']
      : ['(A)','(B)','(X)','(Y)','[LB]','[RB]','[LT]','[RT]','[Back]','[Start]','[L3]','[R3]','[D↑]','[D↓]','[D←]','[D→]'];
    const combos = { saber: F[6] + '+' + F[12], flamethrower: F[6] + '+' + F[13], rcStreak: F[6] + '+' + F[14], dogs: F[6] + '+' + F[15], kong: F[4] + '+' + F[5], inventory: 'hold ' + F[8] };
    if (combos[action]) return combos[action];
    const bi = this.bind[action]; return (bi != null && F[bi] != null) ? F[bi] : '?';
  }
};
GP.load();
window.addEventListener('gamepadconnected', e => GP.onConnect(e.gamepad));
window.addEventListener('gamepaddisconnected', e => GP.onDisconnect(e.gamepad));

// Poll the active controller once per frame (called early in animate). Reads sticks/buttons/triggers,
// switches to gamepad mode on any input, then routes everything through the existing action system.
GP.poll = function (dt) {
  const pads = navigator.getGamepads ? navigator.getGamepads() : [];
  if (this.index < 0 || !pads[this.index]) { this.index = -1; for (let i = 0; i < pads.length; i++) if (pads[i]) { this.index = i; this.type = this.detectType(pads[i].id); break; } }
  const g = this.index >= 0 ? pads[this.index] : null;
  if (!g) { this.held = {}; this.mvX = this.mvY = 0; return; }
  const b = g.buttons, ax = g.axes, B = this.bind;
  const pressed = i => i != null && b[i] && b[i].pressed;
  const val = i => (i != null && b[i]) ? b[i].value : 0;
  const just = i => pressed(i) && !this.prev[i];
  const lx = this.dz(ax[0] || 0, this.dzL), ly = this.dz(ax[1] || 0, this.dzL);
  const rx = this.dz(ax[2] || 0, this.dzR), ry = this.dz(ax[3] || 0, this.dzR);
  // --- input-mode auto-switch: any button or a stick beyond deadzone => gamepad mode ---
  let any = (Math.hypot(lx, ly) > 0.02 || Math.hypot(rx, ry) > 0.02);
  for (let i = 0; i < b.length && !any; i++) if (b[i] && b[i].pressed) any = true;
  if (any) this.setMode(true);
  // --- first-time tutorial overlay: any button dismisses it (and is consumed) ---
  if (typeof gpTutorialOpen === 'function' && gpTutorialOpen()) { for (let i = 0; i < b.length; i++) if (just(i)) { hideGpTutorial(); break; } this.snapshot(b); return; }
  // --- rebinding capture (Controller settings): grab the next pressed button, don't act on it ---
  if (this.rebindAction) { for (let i = 0; i < b.length; i++) if (just(i)) { if (typeof gpApplyBind === 'function') gpApplyBind(this.rebindAction, i); break; } this.snapshot(b); return; }
  // (Part 2) any menu / overlay open => the gamepad drives UI navigation instead of gameplay
  if (typeof GPUI !== 'undefined' && GPUI.menuOpen()) { GPUI.poll(dt, just, pressed, val, lx, ly); this.snapshot(b); return; }

  const playing = gameState.running && !paused;
  const ltDown = val(B.ads) > 0.5 || pressed(B.ads);    // LT = ADS (also the scorestreak modifier with the DPad)
  const rtDown = val(B.fire) > 0.5 || pressed(B.fire);  // RT = fire
  // ---- LEFT STICK -> movement (analog for updateMovement + 8-way held flags for ladder/scooter via IM.down) ----
  this.held = {};
  if (playing && player.alive && !invOpen) {
    this.mvX = lx; this.mvY = ly;
    this.held.moveForward = ly < -0.35; this.held.moveBackward = ly > 0.35; this.held.moveLeft = lx < -0.35; this.held.moveRight = lx > 0.35;
    if (pressed(B.jump)) this.held.jump = true;
    if (pressed(B.crouch)) this.held.crouch = true;
    if (pressed(B.sprint)) this.held.sprint = true;
  } else { this.mvX = this.mvY = 0; }
  // ---- RIGHT STICK -> look (response curve + per-axis sens + ADS multiplier + invert) ----
  if (playing && player.alive && !invOpen && !rcActive && !killcam.active && (rx || ry)) {
    const cv = v => this.curve === 'exp' ? Math.sign(v) * v * v : v;   // exponential = precise centre, fast edges
    let sh = this.sensH, sv = this.sensV;
    if (aiming || camera.fov < DEFAULT_FOV - 0.5) { sh *= this.sensAds; sv *= this.sensAds; }
    const TURN = 3.0;
    yaw   -= cv(rx) * sh * TURN * dt;
    pitch -= cv(ry) * sv * TURN * dt * (this.invertY ? -1 : 1);
    pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, pitch));
  }
  if (playing && player.alive && !rcActive && !killcam.active && this.aimAssist) this.applyAimAssist(dt);
  // ---- TRIGGERS -> fire / ADS (edge-detected; analog threshold 0.5) ----
  if (playing && !invOpen) {
    if (rtDown && !this._rt) firePress(); else if (!rtDown && this._rt) fireRelease(); this._rt = rtDown;
    if (ltDown && !this._lt) adsPress(); else if (!ltDown && this._lt) adsRelease(); this._lt = ltDown;
  } else { if (this._rt) { fireRelease(); this._rt = false; } if (this._lt) { adsRelease(); this._lt = false; } }
  // ---- BUTTONS -> actions ----
  // START: tap = pause/resume (or close the controls overlay); hold ≥0.5s = toggle the full-controls overlay
  const startDown = pressed(B.pause);
  if (startDown && !this._start) { this._startT = 0; this._startHeld = false; }
  if (startDown) { this._startT += dt; if (this._startT >= 0.5 && !this._startHeld) { this._startHeld = true; toggleFullControls(); } }
  if (!startDown && this._start && !this._startHeld) {
    if (fullControlsOpen()) toggleFullControls(false); else if (paused) resumeGame(); else if (invOpen) toggleInventory(); else openPauseMenu();
  }
  this._start = startDown;
  this.handleBack(dt, pressed(B.scoreboard));
  if (playing && player.alive && !invOpen && !rcActive) {
    const lb = pressed(B.grenade), rb = pressed(B.lethal);
    const kong = lb && rb;                                   // LB+RB = summon King Kong
    if (kong && !this._kong) { requestSummonKong(); this._kong = true; } if (!kong) this._kong = false;
    if (!kong) { if (just(B.grenade)) gameAction('grenade', false); if (just(B.lethal)) gameAction('lethal', false); }
    if (just(B.reload)) gameAction('reload', false);
    if (just(B.karambit)) gameAction('karambit', false);
    if (just(B.quickMelee)) gameAction('inspect', false);   // R3 = inspect weapon (Part 5)
    if (just(B.crouch)) gameAction('crouch', false);   // press = dive (when sprinting); hold = crouch via GP.held
    if (just(B.sprint)) gameAction('sprint', false);   // press = slide + toggle-mode latch; hold = sprint via GP.held
    // DPad: normal action, OR a scorestreak when LT (the modifier) is held
    const dmap = [[B.use, 'use', 'saber'], [B.interact, 'interact', 'flamethrower'], [B.weapon1, 'weapon1', 'rcStreak'], [B.weapon2, 'weapon2', 'dogs']];
    dmap.forEach(([btn, normal, streak]) => { if (just(btn)) gameAction(ltDown ? streak : normal, false); });
  }
  this.snapshot(b);
};
GP.snapshot = function (b) { for (let i = 0; i < b.length; i++) this.prev[i] = b[i] && b[i].pressed; };
// Hold Back/Select = scoreboard; hold ≥1s = open inventory (a fresh press while open closes it).
GP.handleBack = function (dt, down) {
  const justDown = down && !this._back, justUp = !down && this._back;
  if (justDown) {
    this.backHoldT = 0; this._invByBack = false;
    if (invOpen) { toggleInventory(); this._back = down; return; }
    if (gameState.running && !paused && !rcActive) { refreshScoreboard(); el('scoreboard').style.display = 'flex'; }
  }
  if (down && !invOpen && gameState.running && !paused) {
    this.backHoldT += dt;
    if (this.backHoldT >= 1.0 && !this._invByBack && gameMode !== 'gungame') { el('scoreboard').style.display = 'none'; toggleInventory(); this._invByBack = true; }
  }
  if (justUp && el('scoreboard').style.display === 'flex' && !this._invByBack) el('scoreboard').style.display = 'none';
  this._back = down;
};
// Aim assist: gently rotate the view toward the nearest enemy within a small cone of the crosshair.
GP.applyAimAssist = function (dt) {
  const fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion), origin = camera.position;
  let bestDir = null, bestAng = 0.087;   // ~5° cone
  const consider = (pos, h) => {
    const to = new THREE.Vector3(pos.x, pos.y + h, pos.z).sub(origin); const d = to.length();
    if (d < 2.5 || d > 90) return; to.multiplyScalar(1 / d);
    const ang = fwd.angleTo(to); if (ang < bestAng) { bestAng = ang; bestDir = to; }
  };
  if (typeof bots !== 'undefined') for (const bt of bots) if (bt && bt.alive) consider(bt.pos, 1.5);
  if (NET.active) NET.players.forEach(rp => { if (rp.alive) consider(rp.pos, 1.5); });
  if (!bestDir) return;
  const desiredYaw = Math.atan2(-bestDir.x, -bestDir.z), desiredPitch = Math.atan2(bestDir.y, Math.hypot(bestDir.x, bestDir.z));
  let dy = desiredYaw - yaw; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;
  const k = Math.min(1, this.aimStr * dt * 6);                                  // subtle magnetic pull, scaled by strength
  yaw += dy * k; pitch += (desiredPitch - pitch) * k;
  pitch = Math.max(-Math.PI / 2 + 0.05, Math.min(Math.PI / 2 - 0.05, pitch));
};

const canvas = renderer.domElement;
function lockPointer() { canvas.requestPointerLock(); }

document.addEventListener('pointerlockchange', () => {
  pointerLocked = (document.pointerLockElement === canvas);
  if (!pointerLocked) {
    clearInput();   // ESC / lost lock: don't leave keys held
    // Pressing ESC (or otherwise losing the lock) mid-match with no menu open → open the pause menu.
    setTimeout(() => {
      if (!pointerLocked && fullControlsOpen()) { toggleFullControls(false); if (gameState.running && player.alive) lockPointer(); return; }   // ESC closes the controls overlay (no pause)
      if (!pointerLocked && gameState.running && !gameState.over && !paused && !invOpen && el('settingsScreen').classList.contains('hidden') && el('skinCreator').classList.contains('hidden')) openPauseMenu();
    }, 40);
  }
});
// --- In-match PAUSE menu (the game keeps running for everyone else; local input is disabled) ---
function openPauseMenu() {
  if (paused || !gameState.running || gameState.over) return;
  paused = true; firing = false; firingL = false; aiming = false; saberBlocking = false;
  const pts = el('pauseTeamSwitch'); if (pts) { pts.style.display = (gameMode === 'tdm' && NET.active) ? '' : 'none'; if (myTeam) pts.textContent = '⇄ SWITCH TO ' + (myTeam === 'red' ? 'BLUE' : 'RED'); }
  el('pauseMenu').style.display = 'flex';
  document.exitPointerLock && document.exitPointerLock();
}
function resumeGame() {
  paused = false; el('pauseMenu').style.display = 'none'; el('settingsScreen').classList.add('hidden');
  if (gameState.running && player.alive) lockPointer();
}
document.addEventListener('mousemove', (e) => {
  if (!pointerLocked || paused) return;
  if (rcActive) { rcSteerX += e.movementX; rcSteerY += e.movementY; return; }   // piloting: mouse steers the missile
  // ZOOM-SCALED (uniform) sensitivity: at hipfire = base; when aiming/scoped, scale by the LIVE
  // FOV ratio (camera.fov / DEFAULT_FOV) so a given mouse move covers the SAME screen distance at
  // any zoom — feels identical from SMG hipfire to a 10x heavy-sniper scope. The ADS multiplier
  // applies to every aimed state; the scope multiplier layers on top only for high-zoom optics.
  let s = SENS * OPT.sens;
  if (camera.fov < DEFAULT_FOV - 0.5) {
    s *= (camera.fov / DEFAULT_FOV) * OPT.sensAds;
    if (scopedHighZoom) s *= OPT.sensScope;
  }
  yaw   -= e.movementX * s;
  pitch -= e.movementY * s * (OPT.invertY ? -1 : 1);
  pitch = Math.max(-Math.PI/2 + 0.05, Math.min(Math.PI/2 - 0.05, pitch));
  // Red-dot parallax: the dot lags a fast turn by a few px (clamped), then re-centers.
  rdParX = Math.max(-5, Math.min(5, rdParX - e.movementX * 0.03));
  rdParY = Math.max(-5, Math.min(5, rdParY - e.movementY * 0.03));
});

let firing = false, firingL = false;   // firing = fire input; firingL = ADS-input akimbo left pistol
let minigunSpin = 0, minigunSpinAngle = 0, minigunSteady = false;   // minigun barrel spin-up (0..1), barrel angle, steady stance
function akimboEquipped() { return !!(WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].akimbo); }

// --- Fire / ADS press+release (shared by mouse + key bindings, so Fire/ADS can be remapped) ---
function firePress() {
  if (brSpectating) { brSpecCycle(-1); return; }   // BR spectator: L-click = previous player
  if (brMapOpen) return;   // BR: can't fire while the map is open
  if (BR.active && !ggKarambit && !brHeldWeapon()) { if (brHoldingConsumable()) brUseSelected(); return; }   // empty hands / consumable: no shot; left-click uses the held consumable
  if (rcActive) { if (rcCamLive) rcDetonate(null, null, null, false); return; }   // piloting: fire = manual detonate
  if (inspectT > 0) { inspectT = 0; return; }                                     // (Part 5) fire cancels an inspect
  if (cigSmoking) { cigCancel(); return; }                                        // smoking: fire cancels (weapon holstered)
  if (player.onLadder) return;
  firing = true;
  if (WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].minigun) {   // minigun spins up first (no instant shot)
    if (minigunSpin <= 0.02) { sfxMinigunSpin(playerEarPos()); if (NET.active) NET.broadcast({ t: 'minspin', id: NET.selfId, x: player.pos.x, y: player.pos.y + 1.2, z: player.pos.z }); }
    return;
  }
  tryShoot(akimboEquipped() ? 'R' : undefined);
}
function fireRelease() {
  if (firing && WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].minigun && minigunSpin > 0.05) sfxMinigunDown(playerEarPos());
  firing = false;
}
function adsPress() {
  if (brSpectating) { brSpecCycle(1); return; }   // BR spectator: R-click = next player
  if (brMapOpen) return;   // BR: can't ADS while the map is open
  if (BR.active && !ggKarambit && !brHeldWeapon()) return;   // empty hands / consumable: no ADS or melee
  if (inspectT > 0) { inspectT = 0; return; }   // (Part 5) ADS cancels an inspect
  if (rcActive || cigSmoking || player.onLadder) return;
  if (akimboEquipped()) { firingL = true; tryShoot('L'); return; }
  if (currentWeaponKey === KARAMBIT_KEY) { meleeAttack(-1); return; }
  if (currentWeaponKey === 'saber') { saberBlocking = true; return; }
  if (WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].minigun) { minigunSteady = true; return; }   // steady stance: tighter spread, rooted in place
  if (OPT.adsToggle) { aiming = !aiming; if (ggAdsInfo()) sfxADS(aiming, aiming && ggAdsInfo().kind === 'scope'); }
  else { if (!aiming && ggAdsInfo()) { const i = ggAdsInfo(); sfxADS(true, i && i.kind === 'scope'); } aiming = true; }
}
function adsRelease() {
  firingL = false; saberBlocking = false; minigunSteady = false;
  if (OPT.adsToggle) return;                            // toggle mode: keep `aiming` until tapped again
  if (aiming && ggAdsInfo()) sfxADS(false);
  aiming = false;
}
// One-shot gameplay actions (shared by keydown + mouse-bound triggers). `rep` = key auto-repeat.
function gameAction(act, rep) {
  if (act === 'crouch' && !rep) crouchKey();
  if (player.diving) return;                                            // no reload / swap / grenade mid-dive
  if (act === 'saber' && !rep) { if (BR.active) { brToggleMinimap(); return; } streakActivate('saberjd'); return; }   // BR: the (disabled) saber key toggles the minimap
  if (act === 'jump' && !rep && BR.active && brSpectating) { brSpecToggleFree(); return; }   // BR spectator: SPACE toggles third-person follow / free camera
  if (act === 'flamethrower' && !rep) { streakActivate('flame'); return; }
  if (act === 'rcStreak' && !rep) { streakActivate('rcrl'); return; }
  if (act === 'dogs' && !rep) { if (BR.active) { brToggleMap(); return; } streakActivate('dogs'); return; }   // BR: the (disabled) Kirks-Avengers key opens the paper map
  if (BR.active && player.alive && !brSpectating) {   // BR 5-slot inventory OWNS the slot / melee / drop / quick-use keys
    if (act === 'weapon1' || act === 'weapon2' || act === 'karambit' || act === 'brSlot4' || act === 'brSlot5' || act === 'prevWeapon' || act === 'nextWeapon') { if (cigSmoking) cigCancel(); brWeaponAction(act); return; }   // 1-5 = inventory slots, wheel cycles
    if (act === 'use' && !rep) { if (cigSmoking) cigCancel(); brWeaponAction('melee'); return; }            // Q -> equip melee (separate from the 5 slots)
    if ((act === 'grenade' || act === 'dropWeapon') && !rep) { brWeaponAction('dropItem'); return; }         // G / X -> drop ONE of the held item
    if (act === 'lethal' && !rep) { brUseType('lethal'); return; }                                           // H -> quick-throw a lethal from its slot
    if (act === 'drinkJD' && !rep) { brUseType('jd'); return; }                                              // Z -> quick-drink a JD from its slot
  }
  if (act === 'use' && !rep) { if (saberMode) drinkJD(); else useCigar(); }
  if (act === 'interact' && !rep) { if (riding) { scooterDismount(); return; } if (brTrySwapLoot() || brTryZip() || tryMountScooter() || tryPickupAxe() || tryNoodleSummon()) return; tryGrabLadder(); }   // E: BR loot swap > zip line > dismount > mount scooter > pick up axe > Mckayla > ladder
  if (act === 'reload') { cigCancel(); reload(); }
  if (act === 'inventory' && !rep && gameMode !== 'gungame' && !BR.active) { toggleInventory(); return; }   // BR has no loadout inventory — you loot what you find (5-slot hotbar instead)
  if (act === 'weapon1' || act === 'weapon2') { if (cigSmoking) cigCancel(); ggSetKarambit(false); }
  else if (act === 'karambit' || act === 'prevWeapon' || act === 'nextWeapon') { if (cigSmoking) cigCancel(); ggSetKarambit(!ggKarambit); }   // 2-slot: main <-> karambit
  if (act === 'sprint') { if (OPT.sprintToggle) sprintLatch = !sprintLatch; if (!ggHeavyScopedNow()) startSlide(); }
  if (act === 'grenade') throwImpulse();
  if (act === 'lethal') throwLethal();
  if (act === 'toggleLaser' && !rep) { laserOn = !laserOn; sfxADS(laserOn); }   // hide/show your laser tactically
  if (act === 'flashlight' && !rep) { toggleFlashlight(); return; }   // (PART 2) toggle weapon flashlight
  if (act === 'toggleHints' && !rep) { OPT.ctrlHints = !OPT.ctrlHints; OPT.save(); const cb = el('optCtrlHints'); if (cb) cb.checked = OPT.ctrlHints; if (typeof sfxClick === 'function') sfxClick(); return; }   // P: show/hide the control-hints panel (persisted)
  if (act === 'inspect' && !rep) { if (typeof startInspect === 'function') startInspect(); return; }   // V/T: inspect the equipped weapon (cosmetic, local-only)
  if (act === 'drinkJD' && !rep) { if (BR.active) brDrinkJD(); return; }   // Z (BR): drink a Jack Daniels bottle -> restore shields
}
// Held sprint state for breath-hold / RC-boost (raw key in hold mode, latched in toggle mode).
function sprintDown() { return OPT.sprintToggle ? sprintLatch : IM.down('sprint'); }

document.addEventListener('keydown', (e) => {
  keys[e.code] = true;
  if (GP.active && !GP.rebindAction) GP.setMode(false);   // a key press switches the prompt/aim mode back to keyboard
  if (!gameState.running || paused) return;
  const act = IM.codeAction(e.code);
  if (invOpen) { if (act === 'inventory' && !e.repeat) toggleInventory(); return; }   // inventory open: only the inventory key closes it
  if (!act) return;
  // SECRET: summon King Kong (works even while piloting). Ignored while a text input is focused.
  if (act === 'kong' && !e.repeat) { const ae = document.activeElement; if (!(ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.isContentEditable))) requestSummonKong(); return; }
  if (act === 'fire' && !e.repeat) { firePress(); return; }   // Fire remapped to a key
  if (act === 'ads' && !e.repeat) { adsPress(); return; }     // ADS remapped to a key
  if (rcActive) return;   // piloting a missile: only kong/boost/brake apply (handled elsewhere)
  gameAction(act, e.repeat);
});
document.addEventListener('keyup', (e) => {
  keys[e.code] = false;
  const act = IM.codeAction(e.code);
  if (act === 'fire') fireRelease();
  else if (act === 'ads') adsRelease();
});

// Clear all input when focus is lost / pointer lock drops, so keys never get "stuck".
function clearInput() { for (const k in keys) keys[k] = false; firing = false; firingL = false; aiming = false; sprintLatch = false; minigunSteady = false; }
window.addEventListener('blur', clearInput);

const MOUSE_CODE = { 0: 'Mouse0', 1: 'Mouse1', 2: 'Mouse2' };
document.addEventListener('mousedown', (e) => {
  if (!gameState.running || !pointerLocked || paused) return;
  const act = IM.codeAction(MOUSE_CODE[e.button]); if (!act) return;
  if (act === 'fire') firePress();
  else if (act === 'ads') adsPress();
  else if (act === 'kong') requestSummonKong();
  else if (!rcActive) gameAction(act, false);
});
document.addEventListener('mouseup', (e) => {
  const act = IM.codeAction(MOUSE_CODE[e.button]);
  if (act === 'fire') fireRelease();
  else if (act === 'ads') adsRelease();
});
document.addEventListener('contextmenu', (e) => e.preventDefault());

// Mouse wheel → whatever action is bound to WheelUp/WheelDown (default prev/next weapon = 2-slot swap).
document.addEventListener('wheel', (e) => {
  if (!gameState.running || player.diving || paused) return;
  const act = IM.codeAction(e.deltaY < 0 ? 'WheelUp' : 'WheelDown'); if (!act) return;
  if (act === 'prevWeapon' || act === 'nextWeapon' || act === 'karambit') { cigCancel(); if (BR.active) brWeaponAction(act); else ggSetKarambit(!ggKarambit); }
  else if (!rcActive) gameAction(act, false);
});

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  if (typeof rcCam !== 'undefined') { rcCam.aspect = window.innerWidth / window.innerHeight; rcCam.updateProjectionMatrix(); }
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* ============================================================================
   5. PLAYER MOVEMENT — Quake-style accel, double jump, slide, bunny hop
   ============================================================================ */
const player = {
  pos: new THREE.Vector3(0, 0, 30),     // feet position
  vel: new THREE.Vector3(),
  onGround: false,
  jumps: 0,                              // for double jump
  jumpHeld: false,
  health: 100,
  sliding: false, slideTimer: 0,
  alive: true,
  launchCd: 0,                           // launch-pad retrigger guard
  grenades: 2,                           // frag grenades carried this life
  lastAttacker: null,                    // MP: id of who last damaged me (for kill credit)
  lastAttackerHead: false,
  lastAttackerName: null,
  lastAttackerWeapon: null,              // gun-game: weapon they killed me with
  lastAttackerMelee: false,              // gun-game: was it a knife (melee) kill?
  // --- Crouch / dive (all modes) ---
  crouching: false,                      // effective crouched state (HOLD-based: true while C held)
  crouchBlend: 0,                        // 0 standing .. 1 fully crouched/prone (drives hitbox + net)
  eye: 1.6,                              // smoothed camera eye height
  diving: false, diveAir: false,         // dive in progress / has left the ground
  diveTime: 0, diveRecover: 0,           // dive duration + post-landing recovery
  diveTilt: 0,                           // smoothed forward camera tilt during a dive
  impulses: 0,                           // impulse grenades carried this life (gun-game equipment)
  impulseT: 0,                           // brief window where an impulse launch isn't speed-clamped
  impulseGrace: 0,                       // window where impulse-launch fall damage is suppressed
  cigar: 1,                              // self-heal cigars carried this life (1, refills on respawn)
  overheal: 0,                           // amber whiskey shield (Jack Daniels) — absorbs damage before HP
  burnT: 0,                              // remaining flamethrower-burn time (3 HP/s)
  onLadder: false, ladder: null          // climbing a watchtower ladder (E to grab, W/S to climb, Space to drop)
};
const LADDER_SPEED = 4;                  // climb speed (units/sec) up or down
let aiming = false;

// Scope / juice state (improvements #1 and #2)
let scopeBlend = 0;     // 0..1 how scoped we currently are (FFA sniper only, smoothed)
let scopePunch = 0;     // brief un-scope timer after firing while scoped
let shakeTime = 0;      // remaining screen-shake time
let shakeMag = 0;       // screen-shake magnitude

// GUN GAME aim-down-sights state (per-weapon zoom + sight overlays).
let adsBlend = 0;       // 0..1 how aimed-in we are with the current gun-game weapon
let aimSensMult = 1;    // (legacy) mouse-sensitivity multiplier from ADS zoom — superseded by zoom-scaling
let scopedHighZoom = false;   // true while looking through a high-zoom optic (scope) — gates OPT.sensScope
let ggSwayClock = 0;    // breath-sway phase for the 8x sniper scope
let rdParX = 0, rdParY = 0;   // red-dot reticle parallax offset (px), lags fast turns then re-centers
const GG_BREATH_MAX = 3;      // seconds of steady "held breath" available on the heavy sniper scope
let ggBreath = GG_BREATH_MAX, ggBreathHeld = false;
// Karambit viewmodel animation: equip flourish, swing arc, idle bob.
let karEquipT = 0, karEquipDur = 0.7, karSwingT = 0, karSwingDir = 1, karBob = 0, karInspectT = 0, karInspectDur = 1, karInspectClock = 0;
// Per-shot cycle animation (bolt/pump) state.
let ggCycleT = 0, ggCycleDur = 0, ggCycleStyle = '';
function ggStartCycle(style, dur) { ggCycleStyle = style; ggCycleDur = dur; ggCycleT = dur; }
// Viewmodel pose during a reload (drives a distinct animation per reload style).
function applyReloadPose(style, p) {
  const g = gunMesh; if (!g) return;
  const s = Math.sin(Math.max(0, Math.min(1, p)) * Math.PI);   // 0 -> 1 -> 0 hump
  g.position.set(0.32, -0.28, -0.6); g.rotation.x = 0; g.rotation.z = 0;
  switch (style) {
    case 'belt':     g.position.y = -0.28 - 0.42 * s; g.rotation.z = 0.45 * Math.sin(p * Math.PI * 3); g.rotation.x = 0.3 * s; break; // open cover, feed belt
    case 'bolt':     g.position.z = -0.6 + 0.22 * Math.sin(p * Math.PI * 2); g.rotation.z = 0.18 * s; break;                          // work the bolt
    case 'shell':    g.position.z = -0.6 + 0.16 * s; g.position.y = -0.28 - 0.10 * s; break;                                          // thumb a shell in
    case 'single':   g.position.z = -0.6 + 0.26 * s; g.position.y = -0.28 - 0.16 * s; g.rotation.x = 0.25 * s; break;                 // draw + nock a bolt
    case 'break':    g.rotation.x = 0.95 * s; g.position.y = -0.28 - 0.12 * s; break;                                                 // break-action open
    case 'rpg':      g.position.y = -0.28 - 0.40 * s; g.rotation.z = -0.30 * s; break;                                                // shoulder a new rocket
    case 'cylinder': g.rotation.z = -0.70 * s; g.position.x = 0.32 - 0.12 * s; break;                                                 // swing the cylinder out
    case 'regen':    g.position.y = -0.28 - 0.05 * s; break;                                                                          // knives regen (subtle)
    default:         g.position.y = -0.28 - 0.32 * s; g.rotation.x = 0.40 * s; break;                                                 // 'mag' swap dip
  }
}
function applyCyclePose(style, p) {
  const g = gunMesh; if (!g) return;
  const s = Math.sin(Math.max(0, Math.min(1, p)) * Math.PI);
  if (style === 'bolt') { g.position.z = -0.6 + 0.12 * s; g.rotation.z = 0.25 * s; }
  else { g.position.z = -0.6 + 0.16 * s; }    // pump
}

// True only when we should be visually scoped right now (FFA sniper).
function isScoping() {
  return aiming && currentWeaponKey === 'sniper' && scopePunch <= 0 && player.alive;
}
// GUN GAME: the equipped weapon's ADS config, or null if it can't aim down sights.
// EVERY sight raises the gun to centre (~150ms). `kind` selects the reticle/overlay:
//   'iron'                = model sights, no overlay; 'dot'/'minidot' = tiny dot, clean view;
//   'holo'                = EOTech reticle, clean view; 'scope' (+style) = black-bordered scope.
// `fov` is the FOV multiplier while sighted; `sway` is breath drift (scopes only).
// A weapon "uses the gun-game feature set" (custom view model, sights, per-weapon move-speed,
// reload poses, projectiles, akimbo) when it has a baseModel — i.e. the gg ladder weapons,
// karambit, and the RC launcher. The plain pistol/smg/shotgun/sniper + loot specials don't.
// In FFA the player's main weapon is one of these too, so the same look & feel applies in BOTH
// modes; only progression/level logic stays gun-game-only.
function ggWeapon(key) { const w = WEAPONS[key || currentWeaponKey]; return !!(w && w.baseModel); }
// The ADS anchor for a weapon (iron / clear optic / scope) — its tuned table value, or a generic default.
function ggAnchorForDefault(key) {
  if (GG_IRON[key])   return GG_IRON[key].ads;
  if (GG_REDDOT[key]) return GG_REDDOT[key].ads;
  if (GG_SCOPE[key])  return GG_SCOPE[key].ads;
  return { x: 0, y: -0.16, z: -0.40 };
}
function ggAdsInfo() {
  const k = currentWeaponKey, w = WEAPONS[k];
  if (!w || w.noads || w.melee) return null;
  const sid = effSightId(k);   // (PART 2) customizable weapon: ADS info comes from the chosen sight
  if (sid && ATT_SIGHTS[sid]) {
    const s = ATT_SIGHTS[sid], anchor = ggAnchorForDefault(k);
    if (s.kind === 'scope') return { key: k, kind: 'scope', style: s.style, anchor, fov: s.fov, sway: s.sway || 0 };
    return { key: k, kind: s.kind, anchor, fov: s.fov, sway: 0 };
  }
  if (GG_IRON[k])   return { key: k, kind: 'iron',                 anchor: GG_IRON[k].ads,   fov: 0.85, sway: 0 };
  if (GG_REDDOT[k]) return { key: k, kind: GG_REDDOT[k].style,     anchor: GG_REDDOT[k].ads, fov: 0.85, sway: 0 };
  if (GG_SCOPE[k])  return { key: k, kind: 'scope', style: GG_SCOPE[k].style, anchor: GG_SCOPE[k].ads, fov: GG_SCOPE[k].fov, sway: GG_SCOPE[k].sway || 0 };
  return null;
}
// The ADS anchor for any sight weapon (iron / clear optic / scope), or null if it can't ADS.
function ggAnchorFor(key) {
  if (isCustomizable(key) && !WEAPONS[key].noads) return ggAnchorForDefault(key);
  if (GG_IRON[key])   return GG_IRON[key].ads;
  if (GG_REDDOT[key]) return GG_REDDOT[key].ads;
  if (GG_SCOPE[key])  return GG_SCOPE[key].ads;
  return null;
}
// True while actually scoped through the heavy sniper (so SHIFT holds breath, not slide).
function ggHeavyScopedNow() {
  const i = ggAdsInfo();
  return !!(i && i.kind === 'scope' && i.style === 'heavy' && aiming && player.alive);
}
// Javelin digital scope HUD: range = distance to whatever the centre is pointing at.
function updateJavelinHud() {
  const origin = camera.getWorldPosition(new THREE.Vector3());
  const dir = camera.getWorldDirection(new THREE.Vector3());
  const ray = new THREE.Raycaster(origin, dir, 0, 600);
  const hits = ray.intersectObjects(colliders.concat(botMeshes()), false);
  const rng = hits.length ? hits[0].distance : null;
  const locked = !!(hits.length && hits[0].object.userData && hits[0].object.userData.bot);
  el('javRng').textContent = 'RNG: ' + (rng != null ? String(Math.round(rng * 2)).padStart(4, '0') + 'm' : '----m');
  el('javLock').textContent = locked ? 'LOCK' : 'SCAN';
  el('javLock').style.color = locked ? '#ff5b5b' : '#9dffb0';
}

/* --- THERMAL scope heat signatures (line-of-sight; walls block them) --- */
const _thBlobs = [];                                 // pooled DOM heat-blob elements
function thermalBlobPool() {
  if (_thBlobs.length) return _thBlobs;
  const host = el('thermalBlobs');
  for (let i = 0; i < 16; i++) { const d = document.createElement('div'); d.className = 'blob'; host.appendChild(d); _thBlobs.push(d); }
  return _thBlobs;
}
function hideThermalBlobs() { for (const b of _thBlobs) b.style.display = 'none'; }
// Draw a hot blob for each living bot / remote player that has a CLEAR line of sight to the scope.
function updateThermal() {
  const pool = thermalBlobPool();
  const camPos = camera.getWorldPosition(new THREE.Vector3());
  const W = window.innerWidth, H = window.innerHeight;
  const ents = [];
  for (const bot of bots) if (bot.alive) ents.push({ pos: bot.pos, h: 1.8 });
  if (NET.active) NET.players.forEach(rp => { if (rp.alive) ents.push({ pos: rp.pos, h: 1.8 * (1 - 0.4 * (rp.cr || 0)) }); });
  let idx = 0;
  for (const e of ents) {
    if (idx >= pool.length) break;
    const chest = new THREE.Vector3(e.pos.x, e.pos.y + e.h * 0.55, e.pos.z);
    const toE = chest.clone().sub(camPos), dist = toE.length(); toE.normalize();
    if (dist > 1.2) {                                          // skip self-overlap; check occlusion
      const ray = new THREE.Raycaster(camPos, toE, 0, dist - 0.4);
      if (ray.intersectObjects(colliders, false).length) continue;   // wall / structure blocks heat
    }
    const p = chest.clone().project(camera);
    if (p.z > 1) continue;                                     // behind the camera
    const head = new THREE.Vector3(e.pos.x, e.pos.y + e.h, e.pos.z).project(camera);
    const feet = new THREE.Vector3(e.pos.x, e.pos.y, e.pos.z).project(camera);
    const pxH = Math.max(12, Math.abs(feet.y - head.y) * 0.5 * H * 1.15), pxW = pxH * 0.5;
    const bl = pool[idx++];
    bl.style.display = 'block';
    bl.style.left = ((p.x * 0.5 + 0.5) * W) + 'px';
    bl.style.top = ((-p.y * 0.5 + 0.5) * H) + 'px';
    bl.style.width = pxW + 'px'; bl.style.height = pxH + 'px';
  }
  for (let i = idx; i < pool.length; i++) pool[i].style.display = 'none';
}

const smoothstep = (t) => { t = Math.max(0, Math.min(1, t)); return t * t * (3 - 2 * t); };   // ease-in-out
// Lerp the held weapon between its hip-fire rest and its per-weapon ADS anchor by `e` (0..1).
function applyRaiseAdsPose(key, e) {
  const a = ggAnchorFor(key); const g = gunMesh; if (!a || !g) return;
  g.position.x = 0.32 + (a.x  - 0.32 ) * e;
  g.position.y = -0.28 + (a.y - (-0.28)) * e;
  g.position.z = -0.6  + (a.z - (-0.6 )) * e;
  g.rotation.x = (a.rx || 0) * e;
  g.rotation.y = 0.04 + ((a.ry || 0) - 0.04) * e;
  g.rotation.z = (a.rz || 0) * e;
}
// Show the right sight reticle / scope overlay / reload bar for the current gun-game weapon.
// (Called every frame AFTER the FFA scope-overlay block so it can override it.)
function updateSights() {
  const akimbo = el('akimboCH'), rl = el('reloadWrap'), legacy = el('ggSights');
  const clear = el('redDotSight'), dmr = el('dmrScope'), jav = el('javelinScope'), scope = el('scopeOverlay');
  akimbo.style.display = 'none';
  legacy.style.opacity = 0; legacy.querySelectorAll('.ret').forEach(r => r.classList.remove('on'));
  if (!ggWeapon()) { clear.style.opacity = 0; dmr.style.opacity = 0; jav.style.opacity = 0; el('thermalScope').style.opacity = 0; renderer.domElement.style.filter = ''; hideThermalBlobs(); rl.style.display = 'none'; return; }

  const w = WEAPONS[currentWeaponKey], ws = weaponState[currentWeaponKey], info = ggAdsInfo();
  const b = adsBlend, kind = info ? info.kind : null;
  const isDot = kind === 'dot' || kind === 'minidot', isHolo = kind === 'holo', isScope = kind === 'scope';
  const sStyle = isScope ? info.style : null;

  // Clear reticle (red dot / mini dot / holo) — floats on an unobstructed view, NO border.
  clear.style.opacity = (isDot || isHolo) ? b : 0;
  el('redDotDot').style.display = isDot ? 'block' : 'none';
  el('redDotDot').classList.toggle('mini', kind === 'minidot');
  el('ggHolo').style.display = isHolo ? 'block' : 'none';
  // Hide the chunky 3D on-glass dot once aiming so it can't swamp the 1px DOM reticle.
  if (gunMesh && gunMesh.userData.opticDot) gunMesh.userData.opticDot.visible = (b < 0.35);
  // One-time verification of the actual rendered dot size (see PART 1).
  if ((isDot || isHolo) && b > 0.6 && !window._rdLogged) {
    window._rdLogged = true;
    const dEl = isHolo ? document.querySelector('#ggHolo .cdot') : el('redDotDot');
    const r = dEl.getBoundingClientRect();
    console.log('[red-dot reticle] rendered core size:', r.width + 'px ×', r.height + 'px', '(target 1px + bloom)');
  }
  if (isDot && b > 0.01) {                                // tiny parallax lag on the dot
    rdParX *= 0.82; rdParY *= 0.82;
    el('redDotDot').style.transform = `translate(calc(-50% + ${rdParX.toFixed(1)}px), calc(-50% + ${rdParY.toFixed(1)}px))`;
  } else { rdParX = rdParY = 0; }

  // Scopes — circular/rect black-bordered overlays (the only sights that occlude the view).
  dmr.style.opacity = (sStyle === 'dmr') ? b : 0;
  jav.style.opacity = (sStyle === 'javelin') ? b : 0;
  if (sStyle === 'heavy') scope.style.opacity = b;        // reuse the big sniper scope overlay
  // THERMAL (DMR): black-border scope + cold monochrome world filter + hot heat blobs.
  const th = el('thermalScope');
  th.style.opacity = (sStyle === 'thermal') ? b : 0;
  const thermalOn = (sStyle === 'thermal' && b > 0.4);
  renderer.domElement.style.filter = thermalOn ? 'grayscale(1) brightness(0.5) sepia(1) hue-rotate(168deg) saturate(1.7) contrast(1.12)' : '';
  if (sStyle === 'thermal' && b > 0.05) updateThermal(); else hideThermalBlobs();
  if (gunMesh) gunMesh.visible = isScope ? (b < 0.6) : true;   // gun hides once you're looking down the scope
  el('hud').style.opacity = isScope ? (1 - 0.35 * b) : 1;
  if (sStyle === 'javelin' && b > 0.05) updateJavelinHud();

  // Crosshair: scopes hide it; iron/dot/holo fade it out as you ADS; melee hides it; else show.
  let cross = 1;
  if (w && w.melee) cross = 0;
  else if (isScope) cross = 0;
  else if (info) cross = 1 - b;
  el('crosshair').style.opacity = cross;

  // Reload progress bar
  if (ws && ws.reloading > 0 && w && w.rstyle !== 'none') {
    rl.style.display = 'block';
    const tot = ws.reloadTotal || w.reload || 1;
    el('reloadBar').style.width = Math.max(0, Math.min(1, 1 - ws.reloading / tot)) * 100 + '%';
  } else rl.style.display = 'none';
}
// Kick off a short screen shake (used by the launch pad).
function addShake(mag, time) { shakeMag = Math.max(shakeMag, mag); shakeTime = Math.max(shakeTime, time); }

function startSlide() {
  if (!player.onGround || player.sliding || player.crouching || player.diving) return;
  // boost forward in look direction, lower the camera
  const fwd = horizontalForward();
  player.vel.x = fwd.x * MOVE.slideSpeed;
  player.vel.z = fwd.z * MOVE.slideSpeed;
  player.sliding = true; player.slideTimer = MOVE.slideTime;
}

/* ============================================================================
   5b. CROUCH + DIVE (all modes)
   ============================================================================ */
// Is there room to stand up? (no solid in the band between crouch-head and stand-head)
function canStand() {
  const r = MOVE.radius, headStand = player.pos.y + MOVE.eyeHeight + 0.15, headCrouch = player.pos.y + MOVE.crouchEye;
  for (const s of solids) {
    if (s.min.y < headStand && s.max.y > headCrouch &&
        player.pos.x > s.min.x - r && player.pos.x < s.max.x + r &&
        player.pos.z > s.min.z - r && player.pos.z < s.max.z + r) return false;
  }
  return true;
}
// Nearest ladder within the (generous) interact cylinder, or null. The zone spans the FULL
// ladder height with a ~2-unit radius so you can grab from the base or anywhere along it.
function nearestLadder() {
  for (const L of ladders) {
    if (Math.hypot(player.pos.x - L.x, player.pos.z - L.z) <= 2.0 && player.pos.y >= L.bottom - 1.0 && player.pos.y <= L.top + 0.8) return L;
  }
  return null;
}
// E pressed near a ladder: grab it (snap to the ladder line; climb with W/S, drop with Space/E).
function tryGrabLadder() {
  if (!gameState.running || !player.alive || player.diving || rcActive || cigSmoking) return;
  if (player.onLadder) {
    const Lc = player.ladder;
    // Passing a mid-platform? E steps OFF onto it (toward the tower centre) instead of dropping in place.
    if (Lc && Lc.midY != null && Math.abs(player.pos.y - Lc.midY) < 1.1) {
      player.pos.set(Lc.cx, Lc.midY, Lc.cz); player.onLadder = false; player.ladder = null; player.onGround = true; sfxLand(player.pos, 0.7);
      console.log('[ladder] stepped onto MID platform at y=' + Lc.midY.toFixed(2)); return;
    }
    player.onLadder = false; player.ladder = null; console.log('[ladder] E pressed -> detached at y=' + player.pos.y.toFixed(2)); return;   // E elsewhere disengages
  }
  const L = nearestLadder();
  console.log('[ladder] E pressed, near ladder=' + !!L + (L ? ' dist=' + Math.hypot(player.pos.x - L.x, player.pos.z - L.z).toFixed(2) : ''));
  if (!L) return;
  player.onLadder = true; player.ladder = L;
  player.pos.x = L.x; player.pos.z = L.z;
  player.pos.y = Math.max(L.bottom + 0.05, Math.min(L.top - 0.2, player.pos.y));   // attach at the closest height (off the very ends)
  player.vel.set(0, 0, 0); player.sliding = false; player.crouching = false; aiming = false;
  player._ladderLogT = 0;
  console.log('[ladder] ATTACHED — climbing mode start at y=' + player.pos.y.toFixed(2) + ' (W=up, S=down, Space/E=off)');
}
// Show/hide the "Press E to climb" prompt while standing in a ladder's interact zone.
let _nearLadderPrev = false;
function updateLadderPrompt() {
  const p = el('ladderPrompt'); if (!p) return;
  const near = !!(gameState.running && player.alive && !player.onLadder && !player.diving && !rcActive && !cigSmoking && nearestLadder());
  if (near && !_nearLadderPrev) console.log('[ladder] entered interact zone (press E to climb)');
  _nearLadderPrev = near;
  p.style.display = near ? 'block' : 'none';
}
// C pressed: dive if sprinting fast enough. Otherwise crouch is purely HOLD-based and is
// resolved every frame in updateMovement (crouched while C is held), so there's nothing to do here.
function crouchKey() {
  if (!player.alive || player.diving) return;
  const spd = Math.hypot(player.vel.x, player.vel.z);
  const runNow = MOVE.groundSpeed * Math.max(0.4, ggSpeedMult()) * (minigunSteady ? 0 : 1);   // weapon's max WALK/RUN speed (minigun steady stance roots you)
  if (player.onGround && player.diveRecover <= 0 && spd >= MOVE.diveTrigger * runNow && !(WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].minigun)) startDive();   // minigun is too heavy to dive — just crouches
}
function startDive() {
  cigCancel();                                     // diving cancels a cigar in progress
  const spd = Math.hypot(player.vel.x, player.vel.z);
  let dx = player.vel.x, dz = player.vel.z;
  if (spd < 0.01) { const f = horizontalForward(); dx = f.x; dz = f.z; }
  else { dx /= spd; dz /= spd; }
  const boost = Math.max(spd * MOVE.diveBoost, MOVE.maxSpeed * 1.1);
  player.vel.x = dx * boost; player.vel.z = dz * boost; player.vel.y = MOVE.diveUp;
  player.diving = true; player.diveAir = false; player.diveTime = MOVE.diveTime;
  player.onGround = false; player.sliding = false; player.crouching = false;
  aiming = false;                                  // a dive forces you out of ADS (re-ADS after landing)
  sfxDive(player.pos);                             // quick whoosh
}
function endDive() {
  player.diving = false; player.diveAir = false; player.diveTime = 0;
  player.crouching = true;                          // land crouched
  player.diveRecover = MOVE.diveRecover;            // brief no-dive/no-slide window
  player.vel.x *= 0.3; player.vel.z *= 0.3;         // shed most forward momentum on landing
  sfxLand(player.pos, 0.9);                         // body thump on landing
}

// Forward/right vectors on the XZ plane, derived straight from `yaw` so that
// recoil/shake (which nudge camera.rotation) never contaminate movement.
// At yaw 0 the camera looks down -Z, so forward = (-sin yaw, 0, -cos yaw).
function horizontalForward() {
  return new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
}
// right = forward × up  (so D strafes to the player's RIGHT). The previous
// version returned the negated vector, which swapped A and D — fixed here.
function horizontalRight() {
  const f = horizontalForward();
  return new THREE.Vector3(-f.z, 0, f.x);
}

// Classic acceleration (gives strafe-jump / bhop feel naturally).
function accelerate(wishDir, wishSpeed, accel, dt) {
  const current = player.vel.x * wishDir.x + player.vel.z * wishDir.z;
  const add = wishSpeed - current;
  if (add <= 0) return;
  const accelSpeed = Math.min(accel * dt * wishSpeed, add);
  player.vel.x += wishDir.x * accelSpeed;
  player.vel.z += wishDir.z * accelSpeed;
}

// GUN GAME: per-weapon run-speed multiplier while equipped (karambit = 110%).
function ggSpeedMult() {
  const w = WEAPONS[currentWeaponKey];
  return (w && w.speed) ? w.speed : 1;     // per-weapon move-speed (both modes); karambit is 1.10
}

function updateMovement(dt) {
  if (!player.alive) return;
  if (BR.active && BR.phase === 'drop') { brUpdateDrop(dt); return; }   // BATTLE ROYALE: plane ride + freefall + parachute drives the player itself
  if (brZip) { brUpdateZip(dt); return; }   // BATTLE ROYALE: riding a zip line
  if (paused) { player.vel.x = 0; player.vel.z = 0; return; }   // pause/settings menu open: stand still (game keeps running for others)

  // Piloting an RC missile: the body stands still (fully shootable). Keep its camera pinned
  // so the picture-in-picture still shows the body's view, but take no movement input.
  if (rcActive) {
    player.vel.set(0, 0, 0);
    camera.position.set(player.pos.x, player.pos.y + player.eye, player.pos.z);
    camera.rotation.order = 'YXZ'; camera.rotation.y = yaw; camera.rotation.x = pitch;
    if (camera.fov !== DEFAULT_FOV) { camera.fov = DEFAULT_FOV; camera.updateProjectionMatrix(); }
    return;
  }

  // Climbing a ladder: pinned to the ladder line, W/S move up/down, Space drops off. No normal
  // physics (you can't fire/ADS/grenade while climbing — handled at the input sites).
  if (player.onLadder) {
    const L = player.ladder;
    if (IM.down('jump') && !player.jumpHeld) {               // jump off the ladder
      player.onLadder = false; player.ladder = null; player.jumpHeld = true;
      player.vel.set(-L.outX * 3.5, MOVE.jumpVel * 0.55, -L.outZ * 3.5); player.onGround = false;
      // fall through to normal movement this frame with the hop velocity
    } else {
      player.jumpHeld = IM.down('jump');
      let cv = 0; if (IM.down('moveForward')) cv += LADDER_SPEED; if (IM.down('moveBackward')) cv -= LADDER_SPEED;   // left/right do nothing (no sidestep)
      player.pos.y += cv * dt; player.pos.x = L.x; player.pos.z = L.z; player.vel.set(0, 0, 0);
      // Hand-on-rung tap each ~0.55 units climbed.
      if (cv !== 0) { player._ladTap = (player._ladTap || 0) + Math.abs(cv) * dt; if (player._ladTap >= 0.55) { player._ladTap = 0; sfxLadderTap(player.pos.clone().setY(player.pos.y + 1)); } }
      // Auto step-off, gated by climb DIRECTION so grabbing at the very bottom/top doesn't instantly
      // detach: climbing UP into the top -> step onto the platform; climbing DOWN to the base -> step off.
      if (cv > 0 && player.pos.y >= L.top - 0.15) { player.pos.y = L.top; player.pos.x = L.cx; player.pos.z = L.cz; player.onLadder = false; player.ladder = null; player.onGround = true; sfxLand(player.pos, 0.7); console.log('[ladder] reached TOP -> stepped onto platform at y=' + L.top.toFixed(2)); }
      else if (cv < 0 && player.pos.y <= L.bottom + 0.05) { player.pos.y = L.bottom; player.pos.x = L.x + L.outX * 0.9; player.pos.z = L.z + L.outZ * 0.9; player.onLadder = false; player.ladder = null; player.onGround = true; sfxLand(player.pos, 0.7); console.log('[ladder] reached BOTTOM -> stepped onto the ground'); }
      else { player.pos.y = Math.max(L.bottom, Math.min(L.top, player.pos.y)); }   // clamp onto the ladder while attached
      // Diagnostic: log the climb height a few times a second (not every frame).
      player._ladderLogT = (player._ladderLogT || 0) - dt;
      if (player.onLadder && cv !== 0 && player._ladderLogT <= 0) { console.log('[ladder] climbing y=' + player.pos.y.toFixed(2) + ' (' + (cv > 0 ? 'up' : 'down') + ')'); player._ladderLogT = 0.2; }
      player.crouching = false; player.crouchBlend = 0;
      player.eye += (MOVE.eyeHeight - player.eye) * Math.min(1, dt * 14);
      recoilPitch += (0 - recoilPitch) * Math.min(1, dt * 10); recoilYaw += (0 - recoilYaw) * Math.min(1, dt * 10);
      camera.position.set(player.pos.x, player.pos.y + player.eye, player.pos.z);
      camera.rotation.order = 'YXZ'; camera.rotation.y = yaw + recoilYaw; camera.rotation.x = pitch + recoilPitch;
      if (camera.fov !== DEFAULT_FOV) { camera.fov = DEFAULT_FOV; camera.updateProjectionMatrix(); }
      return;
    }
  }

  // --- GUN GAME aim-down-sights state (computed up-front so move speed can use it) ---
  // Every gun-game sight raises the weapon to centre; reloading interrupts ADS. Move 70%
  // and sensitivity 60% while ADS'd (any sight). Scopes additionally zoom + sway.
  const ggAds = ggAdsInfo();
  const ggWs = weaponState[currentWeaponKey];
  const reloadingNow = !!(ggWs && ggWs.reloading > 0);
  const ggAdsActive = !!(ggAds && aiming && player.alive && !reloadingNow);
  const adsScopedHeavy = !!(ggAdsActive && ggAds.kind === 'scope' && ggAds.style === 'heavy');

  // --- Crouch / dive bookkeeping ---
  if (player.diveRecover > 0) player.diveRecover -= dt;
  if (player.impulseT > 0) player.impulseT -= dt;          // window where the impulse velocity isn't speed-clamped
  if (player.impulseGrace > 0) player.impulseGrace -= dt;  // window where impulse-fall damage is suppressed
  if (player.diving) player.diveTime -= dt;
  // Crouch is HOLD-based: crouched while C is held. The brief post-dive recovery keeps you
  // crouched (so a dive lands low), then you auto-stand unless C is still held. A low ceiling
  // forces you to stay crouched until you move clear (prevents clipping).
  if (!player.diving) {
    player.crouching = (player.diveRecover > 0) ? true : IM.down('crouch');
    if (!player.crouching && player.crouchBlend > 0.05 && !canStand()) player.crouching = true;
  }
  // Smooth crouch amount (drives eye height, body height, and the networked hitbox). ~150ms.
  const crouchTarget = (player.crouching || player.diving) ? 1 : 0;
  player.crouchBlend += (crouchTarget - player.crouchBlend) * Math.min(1, dt * 14);
  if (player.crouchBlend < 0.001) player.crouchBlend = 0;
  const crouchedNow = player.crouching && !player.diving;

  // Movement: scoped slow (FFA) × per-weapon mult × 70% ADS × 50% crouched (not while diving) × 80% smoking.
  const moveScale = (1 - scopeBlend * (1 - SCOPE.moveMult)) * ggSpeedMult()
                  * (ggAdsActive ? 0.70 : 1) * (crouchedNow ? MOVE.crouchSpeed : 1) * (cigSmoking ? 0.80 : 1) * (saberBlocking ? 0.70 : 1) * (brMapOpen ? 0.18 : 1);   // BR: walk slowly with the map open
  const effGroundSpeed = MOVE.groundSpeed * moveScale;
  const effMaxSpeed = MOVE.maxSpeed * moveScale;
  if (player.launchCd > 0) player.launchCd -= dt;

  // Desired direction from WASD (ignored while the inventory menu is open — pointer is unlocked).
  const f = horizontalForward(), r = horizontalRight();
  let wx = 0, wz = 0;
  if (!invOpen) {
    if (kbDown('moveForward'))  { wx += f.x; wz += f.z; }   // keyboard (digital)
    if (kbDown('moveBackward')) { wx -= f.x; wz -= f.z; }
    if (kbDown('moveRight'))    { wx += r.x; wz += r.z; }
    if (kbDown('moveLeft'))     { wx -= r.x; wz -= r.z; }
    if (GP.active && (GP.mvX || GP.mvY)) { wx += r.x * GP.mvX - f.x * GP.mvY; wz += r.z * GP.mvX - f.z * GP.mvY; }   // gamepad left stick (analog 360°)
  }
  const wishDir = new THREE.Vector3(wx, 0, wz);
  const hasInput = wishDir.lengthSq() > 0;
  if (hasInput) wishDir.normalize();

  // Slide timer
  if (player.sliding) {
    player.slideTimer -= dt;
    if (player.slideTimer <= 0 || !player.onGround) player.sliding = false;
  }

  // Jump (with double jump). Bunny hop: jumping skips this frame's friction.
  let jumpedThisFrame = false;
  const wantJump = IM.down('jump');
  if (wantJump && !player.jumpHeld && !player.crouching && !player.diving) {   // jump disabled while crouched / diving
    // Lightsaber "force jump": ~2.5x height + 4s fall-damage immunity (stacks with pads/impulse/dive).
    const saberJump = (currentWeaponKey === 'saber');
    const jv = (saberJump ? MOVE.jumpVel * 2.5 : MOVE.jumpVel) * ((WEAPONS[currentWeaponKey] && WEAPONS[currentWeaponKey].minigun) ? 0.8 : 1);   // minigun's weight cuts jump height 20%
    let jumped = false;
    if (player.onGround) { player.vel.y = jv; player.jumps = 1; jumpedThisFrame = true; player.sliding = false; jumped = true; }
    else if (player.jumps < 2) { player.vel.y = jv; player.jumps++; jumpedThisFrame = true; jumped = true; }
    if (jumped) {
      if (saberJump) { player.impulseGrace = Math.max(player.impulseGrace, 4.0); spawnForceRing(player.pos); sfxForceJump(player.pos); }
      else sfxJump(player.pos);
    }
  }
  player.jumpHeld = wantJump;

  if (player.onGround && !jumpedThisFrame) {
    // Ground friction (reduced while sliding)
    const speed = Math.hypot(player.vel.x, player.vel.z);
    if (speed > 0) {
      const fric = player.sliding ? MOVE.friction * 0.15 : MOVE.friction;
      const drop = speed * fric * dt;
      const scale = Math.max(speed - drop, 0) / speed;
      player.vel.x *= scale; player.vel.z *= scale;
    }
    if (!player.sliding) accelerate(wishDir, hasInput ? effGroundSpeed : 0, MOVE.groundAccel, dt);
  } else {
    // Air control — small wish speed lets skilled strafing keep/build speed (subtle bhop)
    accelerate(wishDir, MOVE.airSpeed, MOVE.airAccel, dt);
  }

  // Hard speed cap so bunny hopping never spirals out of control (dive burst is exempt).
  const hs = Math.hypot(player.vel.x, player.vel.z);
  if (hs > effMaxSpeed && !player.launchCd && !player.diving && player.impulseT <= 0) {   // don't clamp launch-pad / dive / impulse momentum
    const s = effMaxSpeed / hs;
    player.vel.x *= s; player.vel.z *= s;
  }

  // Gravity + integrate (remember the pre-move position for swept collision below)
  const px0 = player.pos.x, py0 = player.pos.y, pz0 = player.pos.z;
  player.vel.y -= MOVE.gravity * dt;
  player.pos.x += player.vel.x * dt;
  player.pos.z += player.vel.z * dt;
  player.pos.y += player.vel.y * dt;

  // Keep inside the active map's boundary (Nuketown arena, or the Paradise Island region in BR)
  clampToMap(player.pos, 1.2);
  // BR out-of-bounds: stepping into the ocean (off the island) drains HP until you head back inland.
  if (activeMap === 'paradise' && island && gameMode === 'br' && gameState.running && player.alive) {
    if (Math.hypot(player.pos.x - island.cx, player.pos.z - island.cz) > island.R) {
      player._waterT = (player._waterT || 0) + dt;
      if (player._waterT >= 1) { player._waterT -= 1; hurtPlayer(5, null); }   // ~5 HP/sec (Section 2)
    } else player._waterT = 0;
  }

  // --- SWEPT (continuous) horizontal collision for FAST movement (sprint / dive / impulse-launch).
  // A big per-frame step can skip past a thin wall before resolveHorizontal sees an overlap, so we
  // raycast from the previous position to the new one and stop at the first solid surface hit. ---
  const horizSpeed = Math.hypot(player.vel.x, player.vel.z);
  if (horizSpeed > MOVE.maxSpeed * 0.85 || player.impulseT > 0 || player.diving) {
    const dx = player.pos.x - px0, dz = player.pos.z - pz0, moveLen = Math.hypot(dx, dz);
    if (moveLen > 0.05) {
      const dir = new THREE.Vector3(dx / moveLen, 0, dz / moveLen);
      const from = new THREE.Vector3(px0, player.pos.y + 0.6, pz0);   // sweep at knee/chest height
      const ray = new THREE.Raycaster(from, dir, 0, moveLen + MOVE.radius);
      const hits = ray.intersectObjects(colliders, false);
      if (hits.length) {
        const stop = Math.max(0, hits[0].distance - MOVE.radius - 0.1);
        player.pos.x = px0 + dir.x * stop; player.pos.z = pz0 + dir.z * stop;
        let n = hits[0].face ? hits[0].face.normal.clone().transformDirection(hits[0].object.matrixWorld) : dir.clone().negate();
        n.y = 0; if (n.lengthSq() > 1e-4) n.normalize(); else n.copy(dir).negate();
        const vd = player.vel.x * n.x + player.vel.z * n.z;
        if (vd < 0) { player.vel.x -= vd * n.x; player.vel.z -= vd * n.z; }   // cancel velocity into the wall
        if (player.diving) { player.vel.x *= 0.2; player.vel.z *= 0.2; endDive(); }
      }
    }
  }
  // --- Upward CEILING check: moving up fast (impulse / launch) shouldn't punch through a slab/roof. ---
  if (player.vel.y > 0) {
    const headPrev = py0 + 1.7, headNew = player.pos.y + 1.7;
    for (const s of solids) {
      if (player.pos.x > s.min.x && player.pos.x < s.max.x && player.pos.z > s.min.z && player.pos.z < s.max.z &&
          s.min.y >= headPrev - 0.02 && s.min.y <= headNew) { player.pos.y = s.min.y - 1.7; player.vel.y = 0; break; }
    }
  }

  // Horizontal collisions (walls/crates). Crouching/diving uses a shorter body so you
  // can move under low cover. A dive that slams a wall cancels into a crouch.
  const ix = player.pos.x, iz = player.pos.z;
  const bodyH = player.diving ? MOVE.diveEye : (MOVE.eyeHeight - (MOVE.eyeHeight - MOVE.crouchEye) * player.crouchBlend);
  resolveHorizontal(player.pos, bodyH, py0);
  if (player.diving && Math.hypot(player.pos.x - ix, player.pos.z - iz) > 0.2) {
    player.vel.x = 0; player.vel.z = 0; endDive();    // dove into a wall -> drop crouched
  }

  // Ground / standing
  const wasAir = !player.onGround;
  let gh = groundHeightAt(player.pos.x, player.pos.z, player.pos.y);
  // --- SWEPT DOWNWARD landing (continuous vertical collision). A fast fall — off a tower or roof,
  // a dive, an impulse/boost-pad arc, a scooter launch — can drop the feet from above a thin floor
  // slab to well below its top in a SINGLE frame, skipping past groundHeightAt's STEP (0.7) window,
  // so the floor is never "found" and the player phases straight through it (often through several
  // floors to the ground). Re-scan solids for any whose top the feet crossed downward this frame
  // (feet were on/above it last frame at py0, below it now) and land on the HIGHEST such surface.
  // This is independent of STEP, so it catches every floor/roof/deck regardless of fall speed;
  // groundHeightAt still handles step-ups and ramps as before. ---
  if (player.vel.y < 0) {
    if (window.__colDebug && player.vel.y < -22) {   // Part 9: high-speed vertical movement trace (throttled ~5/s)
      player._fastFallLogT = (player._fastFallLogT || 0) - dt;
      if (player._fastFallLogT <= 0) { player._fastFallLogT = 0.2; console.log('[collision] fast fall @(' + player.pos.x.toFixed(1) + ',' + player.pos.y.toFixed(1) + ',' + player.pos.z.toFixed(1) + ') vy=' + player.vel.y.toFixed(1) + ' — sweeping floors'); }
    }
    for (const s of solids) {
      const top = s.max.y;
      if (top > gh && py0 >= top - 0.02 && player.pos.y < top &&
          player.pos.x > s.min.x && player.pos.x < s.max.x &&
          player.pos.z > s.min.z && player.pos.z < s.max.z) {
        gh = top;
        if (window.__colDebug) console.log('[collision] swept-land top=' + top.toFixed(2) + ' caught fast fall: py0=' + py0.toFixed(2) + ' newY=' + player.pos.y.toFixed(2) + ' vy=' + player.vel.y.toFixed(1) + ' @(' + player.pos.x.toFixed(1) + ',' + player.pos.z.toFixed(1) + ')');
      }
    }
    // PHASE-THROUGH diagnostic (Part 9): feet started above a solid's top and ended below its BOTTOM
    // while horizontally inside it, yet we did NOT land on it -> a genuine tunnel-through. Should never
    // fire now that swept-land is in place; logged (behind __colDebug) to flag any surface still slipping.
    if (window.__colDebug) {
      for (const s of solids) {
        if (py0 >= s.max.y - 0.02 && player.pos.y + 0.05 < s.min.y && gh < s.max.y &&
            player.pos.x > s.min.x && player.pos.x < s.max.x && player.pos.z > s.min.z && player.pos.z < s.max.z) {
          console.log('[collision] PHASE-THROUGH DETECTED @(' + player.pos.x.toFixed(1) + ',' + player.pos.y.toFixed(1) + ',' + player.pos.z.toFixed(1) + ') through solid top=' + s.max.y.toFixed(2) + ' bot=' + s.min.y.toFixed(2) + ' vy=' + player.vel.y.toFixed(1));
        }
      }
    }
  }
  if (player.pos.y <= gh) {
    if (wasAir && player.vel.y < -6 && !player.diving) sfxLand(player.pos, Math.min(1.3, -player.vel.y / 13));   // thud scales with fall speed
    player.pos.y = gh;
    if (player.vel.y < 0) player.vel.y = 0;
    player.onGround = true;
    player.jumps = 0;
    // Footstep cadence: step roughly every `stride` units travelled on the ground (quieter when crouched).
    const sp = Math.hypot(player.vel.x, player.vel.z);
    if (sp > 1.6 && !player.sliding) {
      const stride = player.crouching ? 1.7 : (sp > MOVE.groundSpeed * 0.85 ? 2.6 : 2.0);
      player._stepD = (player._stepD || 0) + sp * dt;
      if (player._stepD >= stride) { player._stepD = 0; sfxFootstep(player.pos, player.crouching ? 0.5 : (sp > MOVE.groundSpeed * 0.85 ? 1 : 0.7)); }
    } else player._stepD = 1.4;   // primed so the first step after you start moving plays promptly
  } else {
    player.onGround = false;
  }
  // Dive: mark airborne once we leave the ground, then land (crouched) when we touch down again.
  if (player.diving) {
    if (!player.onGround) player.diveAir = true;
    else if (player.diveAir || player.diveTime < -0.05) endDive();
  }

  // Launch pads (improvement #2): standing on a pad flings you straight up.
  // Horizontal velocity is preserved, so you can fly forward + up. No fall damage.
  if (player.launchCd <= 0) {
    for (const pad of launchPads) {
      if (player.pos.x > pad.minX && player.pos.x < pad.maxX &&
          player.pos.z > pad.minZ && player.pos.z < pad.maxZ &&
          player.pos.y <= pad.top + 0.5) {
        player.vel.y = LAUNCH.impulse;     // strong upward impulse (tunable in LAUNCH config)
        player.onGround = false;
        player.jumps = 1;                  // allow a double-jump at the apex for trick shots
        player.sliding = false;
        player.launchCd = LAUNCH.cooldown;
        addShake(0.05, 0.3);               // satisfying boost feel
        el('boostFlash').style.opacity = 0.9;
        setTimeout(() => el('boostFlash').style.opacity = 0, 130);
        break;
      }
    }
  }

  // Place camera at a smoothly-blended eye height (dive < slide < crouch < stand). ~150ms.
  const eyeTarget = player.diving ? MOVE.diveEye
                  : player.sliding ? MOVE.slideEye
                  : player.crouching ? MOVE.crouchEye : MOVE.eyeHeight;
  player.eye += (eyeTarget - player.eye) * Math.min(1, dt * 14);
  camera.position.set(player.pos.x, player.pos.y + player.eye, player.pos.z);
  // Forward camera tilt during a dive (eases back to neutral on landing).
  player.diveTilt += ((player.diving ? -MOVE.diveTilt : 0) - player.diveTilt) * Math.min(1, dt * 12);

  // Blend the FFA sniper scope amount toward its target (smooth scope in/out)
  const scopeTarget = isScoping() ? 1 : 0;
  scopeBlend += (scopeTarget - scopeBlend) * Math.min(1, dt * SCOPE.blendSpeed);
  if (scopeBlend < 0.001) scopeBlend = 0;

  // Blend the gun-game ADS amount (drives model raise, FOV, overlays). ~150ms in/out.
  adsBlend += ((ggAdsActive ? 1 : 0) - adsBlend) * Math.min(1, dt * 13);
  if (adsBlend < 0.001) adsBlend = 0;
  // Sensitivity is zoom-scaled live in the mousemove handler; just flag high-zoom optics here so the
  // separate Scope-sensitivity multiplier can apply on top (scopes = thermal/heavy/javelin + FFA sniper).
  aimSensMult = ggAdsActive ? 0.60 : 1;   // (legacy, unused by the new formula)
  scopedHighZoom = (ggAdsActive && ggAds.kind === 'scope') || !!scopeTarget;

  // Hold-breath (heavy sniper): SHIFT steadies the scope for ~3s, then must recover ~3s.
  if (adsScopedHeavy && sprintDown() && ggBreath > 0) { ggBreathHeld = true; ggBreath = Math.max(0, ggBreath - dt); }
  else { ggBreathHeld = false; ggBreath = Math.min(GG_BREATH_MAX, ggBreath + dt); }

  // Apply look + recoil (+ screen shake)
  recoilPitch += (0 - recoilPitch) * Math.min(1, dt * 10);   // recover recoil smoothly
  recoilYaw   += (0 - recoilYaw)   * Math.min(1, dt * 10);
  let shakeX = 0, shakeY = 0;
  if (shakeTime > 0) {
    shakeX = (Math.random() - 0.5) * shakeMag;
    shakeY = (Math.random() - 0.5) * shakeMag;
  }
  camera.rotation.order = 'YXZ';
  camera.rotation.y = yaw + recoilYaw + shakeX;
  camera.rotation.x = pitch + recoilPitch + shakeY + player.diveTilt;   // dive tips the view forward
  // Breath sway while scoped (DMR subtle, heavy sniper pronounced; suppressed while holding breath).
  if (ggAdsActive && ggAds.sway > 0 && adsBlend > 0.01 && !(adsScopedHeavy && ggBreathHeld)) {
    ggSwayClock += dt;
    const sw = ggAds.sway * adsBlend;
    camera.rotation.y += Math.sin(ggSwayClock * 0.8) * 0.006 * sw;
    camera.rotation.x += Math.sin(ggSwayClock * 1.5 + 1) * 0.004 * sw;
  }

  // Smooth FOV: gun-game-style sights use each sight's own FOV multiplier (both modes);
  // the legacy FFA sniper scope / generic ADS only apply to non-gg weapons.
  let targetFov = DEFAULT_FOV;
  if (ggAdsActive) targetFov = DEFAULT_FOV * ggAds.fov;
  else if (scopeTarget) targetFov = SCOPE.fov;
  else if (aiming) targetFov = ADS_FOV;
  camera.fov += (targetFov - camera.fov) * Math.min(1, dt * SCOPE.blendSpeed);
  camera.updateProjectionMatrix();

  // Subtle HUD crouch/dive indicator
  const ci = el('crouchInd');
  ci.style.opacity = (player.crouching || player.diving) ? 1 : 0;
  ci.textContent = player.diving ? '▼ DIVING' : '▼ CROUCHED';
}

/* ============================================================================
   6. WEAPONS — viewmodel, hitscan, recoil/spread, reload, switching
   ============================================================================ */
let currentWeaponKey = "pistol";
const weaponState = {};   // per-weapon: ammo (in mag), cooldown, reloading, reserve
// Base weapons have infinite reserve; specials start empty (granted on loot pickup).
ALL_KEYS.forEach(k => {
  const special = WEAPONS[k].special;
  weaponState[k] = { ammo: special ? 0 : WEAPONS[k].mag, cooldown: 0, reloading: 0,
                     reserve: special ? 0 : Infinity };
});
// Gun-game ladder weapons: full mag, infinite reserve (reload always tops up; no pickups).
GUNGAME_LADDER.forEach(k => {
  weaponState[k] = { ammo: WEAPONS[k].mag, cooldown: 0, reloading: 0, reserve: Infinity };
});
// FFA-only inventory weapons get the same infinite-reserve treatment (reload always tops up).
FFA_ONLY_WEAPONS.forEach(k => {
  weaponState[k] = { ammo: WEAPONS[k].mag, cooldown: 0, reloading: 0, reserve: Infinity };
});
weaponState[KARAMBIT_KEY] = { ammo: 1, cooldown: 0, reloading: 0, reserve: Infinity };   // permanent gun-game melee
weaponState.saber = { ammo: 1, cooldown: 0, reloading: 0, reserve: Infinity };           // 3-kill scorestreak melee
weaponState.flame = { ammo: 1, cooldown: 0, reloading: 0, reserve: Infinity };           // 4-kill scorestreak (fuel tracked separately)
weaponState.rcrl = { ammo: 0, cooldown: 0, reloading: 0, reserve: 0 };                    // RC launcher: granted (1) on the 5-kill scorestreak
let currentSpread = 0;
let playerFlashTimer = 0;   // hides the viewmodel muzzle flash shortly after firing

// --- View-model: a chunky low-poly gun anchored to the camera (lower-right) ---
const viewModel = new THREE.Group();
camera.add(viewModel);
scene.add(camera);
let gunMesh = null, gunMuzzle = null, gunFlash = null;

// Add simple but readable iron sights to a weapon group: a rear notch (two uprights
// with a gap) near the eye and a smaller front post/bead near the muzzle so it nests
// inside the notch when sighted. `cfg` comes from GG_IRON.
function addIronSights(g, cfg) {
  const metal = flatMat(0x0a0a0a), topY = cfg.sy, rh = 0.10;
  [-0.036, 0.036].forEach(x => {                           // rear notch uprights (gap ~0.05 between them)
    const m = new THREE.Mesh(new THREE.BoxGeometry(0.022, rh, 0.03), metal);
    m.position.set(x, topY - rh / 2, cfg.rearZ); g.add(m);
  });
  const base = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.022, 0.04), metal);
  base.position.set(0, topY - rh, cfg.rearZ); g.add(base);  // rear sight base
  if (cfg.bead) {                                           // shotgun bead: single small front dot
    const b = new THREE.Mesh(new THREE.SphereGeometry(0.022, 8, 6), flatMat(0xffcf3a));
    b.position.set(0, topY - 0.01, cfg.frontZ); g.add(b);
  } else {                                                  // front post (thinner than the rear gap) + hood ears
    const fh = 0.10;
    const f = new THREE.Mesh(new THREE.BoxGeometry(0.014, fh, 0.022), metal);
    f.position.set(0, topY - fh / 2, cfg.frontZ); g.add(f);
    [-0.032, 0.032].forEach(x => {
      const e = new THREE.Mesh(new THREE.BoxGeometry(0.013, fh * 0.85, 0.02), metal);
      e.position.set(x, topY - fh * 0.45, cfg.frontZ); g.add(e);
    });
  }
  if (cfg.ladder) {                                         // grenade-launcher arc ladder above the rear
    for (let i = 0; i < 3; i++) {
      const t = new THREE.Mesh(new THREE.BoxGeometry(0.06 - 0.012 * i, 0.012, 0.02), metal);
      t.position.set(0, topY + 0.05 + i * 0.045, cfg.rearZ - 0.02); g.add(t);
    }
  }
}

// Mount an optic ON the weapon (visible even at hipfire). Shape depends on cfg.style:
//   'dot'    = square red-dot housing,  'holo' = wide flat EOTech housing,
//   'minidot'= tiny slide-mounted RMR.  The crisp aiming reticle is the DOM overlay;
// this is just the physical attachment. `cfg` from GG_REDDOT.
function addRedDotOptic(g, cfg) {
  const dark = flatMat(0x0c0c0c), y = cfg.sy, z = cfg.optZ || 0, style = cfg.style || 'dot';
  // housing dimensions per style: [width, height, depth, frame thickness, glass tint]
  let gw = 0.14, gh = 0.14, gd = 0.11, t = 0.022, riserW = 0.10, riserD = 0.16, glassTint = 0x0c241a;
  if (style === 'holo')    { gw = 0.22; gh = 0.13; gd = 0.16; t = 0.020; riserW = 0.18; riserD = 0.18; }   // wide + flat
  if (style === 'minidot') { gw = 0.075; gh = 0.085; gd = 0.07; t = 0.014; riserW = 0.06; riserD = 0.09; } // tiny RMR
  const halfW = gw / 2, halfH = gh / 2;
  const base = new THREE.Mesh(new THREE.BoxGeometry(riserW, 0.06, riserD), dark);   // mount riser
  base.position.set(0, y - halfH - 0.02, z); g.add(base);
  const edge = (w, h, px, py) => { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, gd), dark); m.position.set(px, y + py, z); g.add(m); };
  edge(gw, t, 0, halfH); edge(gw, t, 0, -halfH); edge(t, gh, -halfW, 0); edge(t, gh, halfW, 0);   // housing frame
  const glass = new THREE.Mesh(new THREE.BoxGeometry(gw - 2 * t, gh - 2 * t, 0.012),
    new THREE.MeshBasicMaterial({ color: glassTint, transparent: true, opacity: 0.30 }));
  glass.position.set(0, y, z); g.add(glass);                                       // faintly tinted glass
  // Faint on-glass 3D dot — ONLY for hipfire flavour. It's hidden once you ADS so it can't
  // dominate the centred view; the crisp aim point is the 1px DOM #redDotDot. (Kept tiny.)
  const dot = new THREE.Mesh(new THREE.SphereGeometry(0.0035, 8, 6),
    new THREE.MeshBasicMaterial({ color: 0xff2222 }));
  dot.position.set(0, y, z + 0.006); g.add(dot);
  g.userData.opticDot = dot;
}

// Shared weapon geometry — used by the first-person viewmodel AND the third-person models other
// players see. Returns { g, muzzleZ }. Includes iron sights, red dot, and saber/akimbo userData.
function buildWeaponMesh(key, variant, cfg) {
  const w = WEAPONS[key];
  const model = w.baseModel || key;   // gun-game weapons borrow an existing silhouette
  const g = new THREE.Group();
  const body = (x,y,z,sx,sy,sz,c, emissive) => {
    const mat = emissive ? new THREE.MeshLambertMaterial({ color: c, emissive: c, emissiveIntensity: 0.8, flatShading: true })
                         : flatMat(c);
    const m = new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz), mat);
    m.position.set(x,y,z); g.add(m); return m;
  };
  let muzzleZ = -0.45;   // forward barrel tip (in gun-local space) per weapon
  // Distinct silhouette per class (gun-game weapons pick one via baseModel)
  if (model === 'pistol') {
    body(0,0,-0.05,0.10,0.10,0.40,w.color);     // slide
    body(0,-0.14,0.10,0.09,0.20,0.12,0x222222); // grip
    muzzleZ = -0.28;
  } else if (model === 'smg') {
    body(0,0,-0.10,0.10,0.12,0.55,w.color);
    body(0,-0.16,0.12,0.08,0.22,0.10,0x222222);
    body(0,-0.06,0.18,0.07,0.10,0.22,0x333333); // mag
    muzzleZ = -0.40;
  } else if (model === 'shotgun') {
    body(0,0,-0.15,0.13,0.13,0.75,w.color);
    body(0,-0.05,-0.15,0.10,0.08,0.78,0x5a3010);// pump
    body(0,-0.15,0.22,0.10,0.18,0.16,0x3a1f0a); // stock/grip
    muzzleZ = -0.55;
  } else if (model === 'sniper') {
    body(0,0,-0.20,0.09,0.09,0.95,w.color);
    body(0,0.09,-0.30,0.06,0.06,0.30,0x111111); // scope
    body(0,-0.15,0.20,0.09,0.20,0.14,0x222222); // grip
    muzzleZ = -0.70;
  } else if (model === 'rocket') {
    body(0,0,-0.15,0.20,0.20,0.95,w.color);     // chunky tube
    body(0,0.04,-0.62,0.26,0.26,0.12,0x222222); // muzzle ring
    body(0,-0.10,0.18,0.10,0.22,0.16,0x222222); // grip
    body(0,0.16,-0.10,0.06,0.06,0.40,0x111111); // sight rail
    muzzleZ = -0.70;
  } else if (model === 'laser') {
    body(0,0,-0.12,0.10,0.12,0.70,0x2a2a33);    // sleek body
    body(0,0.02,-0.50,0.07,0.07,0.30,0xff2222, true); // glowing red emitter
    body(0,-0.13,0.14,0.08,0.20,0.12,0x1a1a22); // grip
    muzzleZ = -0.66;
  } else if (model === 'deagle') {
    body(0,0,-0.06,0.16,0.15,0.52,w.color, true); // OVERSIZED slide (hand cannon)
    body(0,-0.16,0.12,0.11,0.24,0.14,0x3a2e00);    // chunky grip
    muzzleZ = -0.34;
  } else if (model === 'lmg') {
    body(0,0,-0.18,0.16,0.18,1.05,w.color);        // big receiver
    body(0,0.0,-0.55,0.07,0.07,0.55,0x111111);     // long barrel
    body(0,-0.22,0.06,0.22,0.20,0.34,0x2a2a2a);    // ammo box / belt drum
    body(0.18,-0.20,0.10,0.05,0.05,0.30,0xcaa15a); // visible belt feed
    body(0,-0.18,0.26,0.10,0.20,0.14,0x222222);    // grip
    muzzleZ = -0.78;
  } else if (model === 'ar') {
    body(0,0,-0.12,0.11,0.13,0.78,w.color);        // receiver
    body(0,0.02,-0.52,0.05,0.05,0.40,0x111111);    // barrel
    body(0,-0.07,0.20,0.07,0.12,0.24,0x333333);    // mag
    body(0,-0.05,0.40,0.10,0.16,0.16,0x222222);    // stock
    muzzleZ = -0.66;
  } else if (model === 'battle') {
    body(0,0,-0.14,0.12,0.14,0.92,w.color);        // long heavy receiver
    body(0,0.10,-0.34,0.05,0.05,0.34,0x111111);    // optic rail
    body(0,-0.08,0.22,0.07,0.14,0.26,0x333333);    // mag
    body(0,-0.04,0.44,0.11,0.17,0.18,0x222222);    // stock
    muzzleZ = -0.72;
  } else if (model === 'carbine') {
    body(0,0,-0.10,0.10,0.12,0.66,w.color);        // compact receiver
    body(0,0.01,-0.46,0.05,0.05,0.34,0x111111);    // barrel
    body(0,-0.07,0.16,0.07,0.12,0.20,0x333333);    // mag
    body(0,-0.03,0.34,0.09,0.14,0.14,0x222222);    // stock
    muzzleZ = -0.60;
  } else if (model === 'pumpsg') {
    body(0,0,-0.16,0.13,0.13,0.82,w.color);        // receiver/barrel
    body(0,-0.07,-0.18,0.11,0.09,0.40,0x5a3010);   // FOREGRIP SLIDE (pump)
    body(0,-0.16,0.24,0.10,0.18,0.16,0x3a1f0a);    // stock
    muzzleZ = -0.58;
  } else if (model === 'autosg') {
    body(0,0,-0.12,0.14,0.14,0.62,w.color);        // shorter receiver
    body(0,0.02,-0.40,0.06,0.06,0.34,0x111111);    // barrel
    body(0,-0.08,0.16,0.09,0.16,0.18,0x333333);    // box mag
    body(0,-0.14,0.30,0.09,0.16,0.14,0x222222);    // grip
    muzzleZ = -0.52;
  } else if (model === 'dmr') {
    body(0,0,-0.16,0.10,0.11,0.96,w.color);        // long thin receiver
    body(0,0.10,-0.26,0.07,0.08,0.34,0x111111);    // ACOG-ish optic
    body(0,-0.07,0.22,0.06,0.12,0.22,0x333333);    // mag
    body(0,-0.04,0.42,0.10,0.15,0.16,0x222222);    // stock
    muzzleZ = -0.74;
  } else if (model === 'crossbow') {
    body(0,0,-0.10,0.06,0.06,0.70,w.color);        // rail/stock
    body(0,0,-0.42,0.62,0.04,0.06,0x3a2a1a);       // LIMBS (wide crossbar)
    body(0,0.02,-0.30,0.03,0.03,0.40,0xdddddd);    // loaded bolt
    body(0,-0.12,0.18,0.07,0.16,0.12,0x222222);    // grip
    muzzleZ = -0.60;
  } else if (model === 'gl') {
    body(0,0,-0.10,0.20,0.20,0.52,w.color);        // STUBBY thick barrel
    body(0,0.0,-0.40,0.22,0.22,0.10,0x222222);     // fat muzzle
    body(0,-0.16,0.16,0.10,0.20,0.16,0x222222);    // grip
    body(0,0.14,-0.04,0.05,0.05,0.30,0x111111);    // arc sight rail
    muzzleZ = -0.46;
  } else if (model === 'rpg') {
    body(0,0,-0.10,0.22,0.22,1.10,w.color);        // long shoulder TUBE
    body(0,0.05,-0.66,0.30,0.30,0.12,0x222222);    // muzzle cone
    body(0,0.20,0.30,0.30,0.10,0.10,0x3a3a3a);     // rear venturi
    body(0,-0.18,0.16,0.10,0.22,0.16,0x222222);    // grip
    muzzleZ = -0.78;
  } else if (model === 'mpistol') {
    body(0,0,-0.06,0.10,0.11,0.46,w.color);        // slide
    body(0,-0.10,0.14,0.07,0.16,0.22,0x333333);    // extended mag
    body(0,0.0,-0.30,0.04,0.04,0.16,0x111111);     // stubby barrel
    muzzleZ = -0.32;
  } else if (model === 'revolver') {
    body(0,0,-0.06,0.09,0.10,0.46,w.color);        // frame/barrel
    body(0,-0.02,0.04,0.15,0.15,0.16,0x6a6a6a);    // CYLINDER (fat, visible)
    body(0,-0.16,0.12,0.09,0.20,0.12,0x2a1a0a);    // wood grip
    muzzleZ = -0.30;
  } else if (model === 'tactical') {
    // High-end tactical pistol: slim matte-black slide (slimmer than the 9mm + Desert Eagle),
    // threaded barrel, with a slide-mounted RMR mini red dot (added by addRedDotOptic on top).
    body(0,0.0,-0.05,0.085,0.10,0.46,0x202028);    // slim slide (dark gunmetal)
    body(0,-0.05,-0.05,0.075,0.05,0.42,0x14141a);  // frame rail under the slide
    body(0,-0.15,0.11,0.075,0.20,0.12,0x101015);   // grip
    body(0,0.0,-0.30,0.034,0.034,0.14,0x0c0c0c);   // threaded barrel tip
    body(0,0.075,0.02,0.05,0.03,0.12,0x0a0a0e);    // RMR mounting plate on the slide
    muzzleZ = -0.32;
  } else if (model === 'akimbo') {
    // Two pistols held in opposite hands: far apart across the screen, angled inward,
    // each with its own muzzle anchor + flash for independent fire/recoil.
    const mkPistol = () => {
      const p = new THREE.Group();
      const pb = (x, y, z, sx, sy, sz, c) => { const m = new THREE.Mesh(new THREE.BoxGeometry(sx, sy, sz), flatMat(c)); m.position.set(x, y, z); p.add(m); return m; };
      pb(0, 0, -0.05, 0.09, 0.10, 0.38, w.color);     // slide
      pb(0, -0.13, 0.10, 0.08, 0.18, 0.11, 0x222222); // grip
      const mz = new THREE.Object3D(); mz.position.set(0, 0, -0.28); p.add(mz);
      const fl = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.18, 0.10), new THREE.MeshBasicMaterial({ color: 0xffe27a, transparent: true, opacity: 0.95 }));
      fl.position.set(0, 0, -0.32); fl.visible = false; p.add(fl);
