    const inner = new THREE.Mesh(new THREE.ConeGeometry(0.22, 0.6, 8), new THREE.MeshBasicMaterial({ color: 0xffe24a, transparent: true, opacity: 0.95 })); inner.position.set(x, 1.85, z); scene.add(inner);
    mapFlames.push({ flame, inner, pos: new THREE.Vector3(x, 1.7, z), t: Math.random() * 2, smokeT: Math.random() * 2 });
