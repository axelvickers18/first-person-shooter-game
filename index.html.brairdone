function cancelKillcam() { killcam.active = false; killcam.waiting = false; const ui = el('killcamUI'); if (ui) ui.classList.remove('on'); const f = el('killcamFade'); if (f) f.style.opacity = '0'; if (gunMesh) gunMesh.visible = true; _kcEnd(); }
